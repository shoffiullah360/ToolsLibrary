---
// src/components/CompressorEditorial.astro
import type { CompressorEditorial } from '../data/compressorEditorials';
import ToolIcon from './ToolIcon.astro';

interface Props {
  editorial: CompressorEditorial;
}

const { editorial } = Astro.props;
const { article } = editorial;
---

<section class="border-t border-slate-200/90 dark:border-slate-800 bg-white dark:bg-slate-950 py-14 sm:py-16">
  <div class="max-w-4xl mx-auto px-4 py-8 text-slate-300 leading-relaxed space-y-6">
    {article.sections.map((section, idx) => (
      <div>
        {idx === 0 ? (
          <h2 class="text-2xl font-bold text-white mt-10 mb-4 first:mt-0">
            {section.h2 || article.h2}
          </h2>
        ) : section.h2 ? (
          <h2 class="text-2xl font-bold text-white mt-10 mb-4">
            {section.h2}
          </h2>
        ) : (
          <h3 class="text-xl font-semibold text-slate-100 mt-6 mb-3">
            {section.h3 || section.h2}
          </h3>
        )}

        {section.paragraphs.map((p) => (
          <p class="text-base text-slate-300 leading-7 mb-4">
            {p}
          </p>
        ))}

        {section.checklist && section.checklist.length > 0 && (
          <ul class="list-disc list-inside space-y-2 text-slate-300 my-4">
            {section.checklist.map((item) => (
              <li>{item}</li>
            ))}
          </ul>
        )}

        {section.paragraphsAfter && section.paragraphsAfter.length > 0 && (
          section.paragraphsAfter.map((p) => (
            <p class="text-base text-slate-300 leading-7 mb-4">
              {p}
            </p>
          ))
        )}

        {section.takeaway && (
          <div class="p-4 rounded-xl bg-slate-900/40 border border-slate-800/80 text-sm text-slate-300 flex items-start gap-3 my-4">
            <ToolIcon name="zap" class="w-4 h-4 text-blue-400 shrink-0 mt-0.5" />
            <div>
              <strong class="font-semibold text-white">{section.takeaway.title}:</strong> {section.takeaway.text}
            </div>
          </div>
        )}
      </div>
    ))}
  </div>
</section>
