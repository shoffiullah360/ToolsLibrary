---
interface Props {
  class?: string;
}

const { class: className = '' } = Astro.props;

const tools = [
  { name: 'Image Resizer', href: '/tools/image-resizer' },
  { name: 'Image Compressor', href: '/tools/image-compressor' },
  { name: 'Image Cropper', href: '/tools/image-cropper' },
  { name: 'Image Converter', href: '/tools/image-converter' },
  { name: 'Image Optimizer', href: '/tools/image-optimizer' },
];

const company = [
  { name: 'About', href: '/about' },
  { name: 'Contact', href: '/contact' },
  { name: 'Privacy Policy', href: '/privacy-policy' },
  { name: 'Terms of Service', href: '/terms' },
];

const resources = [
  { name: 'Image Size Guide', href: '/tools/image-resizer#size-guide' },
  { name: 'FAQ', href: '/#faq-section' },
  { name: 'Sitemap', href: '/sitemap-index.xml' },
];
---

<footer class={`w-full border-t border-slate-200 dark:border-slate-800/80 bg-slate-50/50 dark:bg-slate-900/60 transition-colors duration-200 ${className}`}>
  <!-- Main Footer Content -->
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-12 lg:py-16">
    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-4 gap-8 lg:gap-10">
      
      <!-- Brand Section (Left / Full width on mobile) -->
      <div class="space-y-4">
        <a href="/" class="flex items-center gap-2.5 group">
          <div class="w-8 h-8 rounded-lg bg-slate-900 dark:bg-white text-white dark:text-slate-900 flex items-center justify-center font-mono font-bold text-sm shadow-xs group-hover:scale-105 transition-transform">
            <svg class="w-4 h-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5">
              <polygon points="12 2 2 7 12 12 22 7 12 2"></polygon>
              <polyline points="2 17 12 22 22 17"></polyline>
              <polyline points="2 12 12 17 22 12"></polyline>
            </svg>
          </div>
          <span class="text-lg font-bold tracking-tight text-slate-900 dark:text-white">
            OmniTools
          </span>
        </a>
        
        <p class="text-sm leading-relaxed text-slate-600 dark:text-slate-400">
          Free online client-side image tools. Fast, secure, and private with zero server uploads.
        </p>

        <!-- Privacy Status Badge -->
        <div class="inline-flex items-center gap-2 px-3 py-1.5 rounded-full bg-white dark:bg-slate-800 border border-slate-200 dark:border-slate-700/80 text-xs font-mono text-slate-600 dark:text-slate-300 shadow-2xs">
          <span class="flex h-2 w-2 relative">
            <span class="animate-ping absolute inline-flex h-full w-full rounded-full bg-emerald-400 opacity-75"></span>
            <span class="relative inline-flex rounded-full h-2 w-2 bg-emerald-500"></span>
          </span>
          <span>100% Client-Side Active</span>
        </div>
      </div>

      <!-- Column 1: Tools -->
      <div>
        <h3 class="text-xs font-semibold uppercase tracking-wider text-slate-900 dark:text-slate-100 mb-4">
          Tools
        </h3>
        <ul class="space-y-2.5 text-sm">
          {tools.map((tool) => (
            <li>
              <a
                href={tool.href}
                class="text-slate-600 hover:text-slate-900 dark:text-slate-400 dark:hover:text-white transition-colors block"
              >
                {tool.name}
              </a>
            </li>
          ))}
        </ul>
      </div>

      <!-- Column 2: Company -->
      <div>
        <h3 class="text-xs font-semibold uppercase tracking-wider text-slate-900 dark:text-slate-100 mb-4">
          Company
        </h3>
        <ul class="space-y-2.5 text-sm">
          {company.map((item) => (
            <li>
              <a
                href={item.href}
                class="text-slate-600 hover:text-slate-900 dark:text-slate-400 dark:hover:text-white transition-colors block"
              >
                {item.name}
              </a>
            </li>
          ))}
        </ul>
      </div>

      <!-- Column 3: Resources -->
      <div>
        <h3 class="text-xs font-semibold uppercase tracking-wider text-slate-900 dark:text-slate-100 mb-4">
          Resources
        </h3>
        <ul class="space-y-2.5 text-sm">
          {resources.map((item) => (
            <li>
              <a
                href={item.href}
                class="text-slate-600 hover:text-slate-900 dark:text-slate-400 dark:hover:text-white transition-colors block"
              >
                {item.name}
              </a>
            </li>
          ))}
        </ul>
      </div>

    </div>

    <!-- Bottom Bar -->
    <div class="mt-12 pt-8 border-t border-slate-200 dark:border-slate-800/80 text-center text-xs text-slate-500 dark:text-slate-400">
      <p>&copy; 2026 OmniTools. All rights reserved.</p>
    </div>
  </div>
</footer>
