---
import { TOOLS } from '../data/tools';
import ToolIcon from './ToolIcon.astro';

const socialSlugMap: Record<string, string> = {
  'Facebook Specs & Resizer': '/facebook-cover-photo-resizer',
  'YouTube Specs & Resizer': '/youtube-banner-resizer',
  'Instagram Specs & Resizer': '/resize-image-for-instagram',
  'TikTok Specs & Resizer': '/tiktok-story-resizer',
  'LinkedIn Specs & Resizer': '/linkedin-banner-resizer',
  'X (Twitter) Specs & Resizer': '/twitter-header-resizer',
  'Pinterest Specs & Resizer': '/pinterest-pin-resizer',
  'WhatsApp Specs & Resizer': '/whatsapp-dp-resizer',
  'Tumblr Specs & Resizer': '/tumblr-banner-resizer'
};

const imageTools = TOOLS.filter((t) => t.category === 'Image Tools').map((t) => ({
  ...t,
  href: socialSlugMap[t.title] || t.href
}));
const devTools = TOOLS.filter((t) => t.category === 'Developer Tools');
---

<header class="sticky top-0 z-50 w-full border-b border-slate-200/80 dark:border-slate-800/80 bg-white/80 dark:bg-slate-900/80 backdrop-blur-md transition-colors duration-200">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 h-16 flex items-center justify-between gap-4">
    
    <!-- Brand Logo -->
    <div class="flex items-center gap-6">
      <a href="/" class="flex items-center gap-2.5 group">
        <div class="w-8 h-8 rounded-lg bg-slate-900 dark:bg-white text-white dark:text-slate-900 flex items-center justify-center font-mono font-bold text-sm shadow-sm group-hover:scale-105 transition-transform">
          <svg class="w-4 h-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5">
            <polygon points="12 2 2 7 12 12 22 7 12 2"></polygon>
            <polyline points="2 17 12 22 22 17"></polyline>
            <polyline points="2 12 12 17 22 12"></polyline>
          </svg>
        </div>
        <div class="flex flex-col">
          <span class="text-base font-bold tracking-tight text-slate-900 dark:text-white flex items-center gap-1.5">
            OmniTools
            <span class="text-[10px] font-mono uppercase px-1.5 py-0.2 rounded bg-blue-500/10 text-blue-600 dark:text-blue-400 border border-blue-500/20 font-semibold">v1.0</span>
          </span>
        </div>
      </a>

      <!-- Desktop Navigation -->
      <nav class="hidden md:flex items-center gap-1">
        
        <!-- 1. All Tools Mega-Menu (Opens on hover or click) -->
        <div class="relative group" id="mega-menu-container">
          <button
            type="button"
            id="mega-menu-btn"
            class="flex items-center gap-1.5 px-3 py-1.5 text-sm font-medium text-slate-600 dark:text-slate-300 hover:text-slate-900 dark:hover:text-white rounded-md hover:bg-slate-100 dark:hover:bg-slate-800/60 transition-colors"
            aria-expanded="false"
          >
            <span>All Tools</span>
            <svg class="w-4 h-4 text-slate-400 transition-transform duration-200 group-hover:rotate-180 group-[.is-open]:rotate-180" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
              <path stroke-linecap="round" stroke-linejoin="round" d="M19 9l-7 7-7-7" />
            </svg>
          </button>

          <!-- Invisible bridge wrapper for Mega Menu -->
          <div
            id="mega-menu-dropdown-wrapper"
            class="absolute top-full left-0 pt-2 opacity-0 invisible translate-y-1 group-hover:opacity-100 group-hover:visible group-hover:translate-y-0 group-[.is-open]:opacity-100 group-[.is-open]:visible group-[.is-open]:translate-y-0 transition-all duration-200 pointer-events-none group-hover:pointer-events-auto group-[.is-open]:pointer-events-auto z-50"
          >
            <div
              id="mega-menu-dropdown"
              class="w-[780px] -ml-16 p-6 rounded-2xl border border-slate-200 dark:border-slate-800 bg-white dark:bg-slate-900 shadow-2xl"
            >
              <div class="grid grid-cols-2 gap-8">
                
                <!-- Category 1: Image Tools (all 22 image tools & social media resizers) -->
                <div class="space-y-3">
                  <div class="flex items-center justify-between pb-2.5 border-b border-slate-100 dark:border-slate-800">
                    <div class="flex items-center gap-2">
                      <div class="w-6 h-6 rounded-md bg-blue-500/10 text-blue-600 dark:text-blue-400 flex items-center justify-center">
                        <ToolIcon name="image" class="w-3.5 h-3.5" />
                      </div>
                      <span class="text-xs font-mono uppercase tracking-wider font-semibold text-slate-900 dark:text-white">
                        Image Tools ({imageTools.length})
                      </span>
                    </div>
                    <a href="#image-tools-section" class="text-xs text-blue-600 dark:text-blue-400 hover:underline font-medium">
                      View section &rarr;
                    </a>
                  </div>
                  <div class="grid grid-cols-1 gap-1 max-h-[420px] overflow-y-auto pr-1">
                    {imageTools.map((tool) => (
                      <a
                        href={tool.href}
                        class="flex items-center gap-3 p-1.5 rounded-xl hover:bg-slate-100 dark:hover:bg-slate-800/80 transition-colors group/item"
                      >
                        <div class="w-9 h-9 rounded-xl flex items-center justify-center bg-slate-100 dark:bg-slate-800 text-blue-600 dark:text-blue-400 group-hover/item:bg-blue-50 dark:group-hover/item:bg-blue-950/40 transition-colors shrink-0">
                          <ToolIcon name={tool.icon} class="w-4 h-4" />
                        </div>
                        <span class="text-sm font-medium text-slate-800 dark:text-slate-100 group-hover/item:text-blue-600 dark:group-hover/item:text-blue-400 transition-colors truncate">
                          {tool.title}
                        </span>
                      </a>
                    ))}
                  </div>
                </div>

                <!-- Category 2: Developer Tools (all 16 developer tools) -->
                <div class="space-y-3">
                  <div class="flex items-center justify-between pb-2.5 border-b border-slate-100 dark:border-slate-800">
                    <div class="flex items-center gap-2">
                      <div class="w-6 h-6 rounded-md bg-emerald-500/10 text-emerald-600 dark:text-emerald-400 flex items-center justify-center">
                        <ToolIcon name="code" class="w-3.5 h-3.5" />
                      </div>
                      <span class="text-xs font-mono uppercase tracking-wider font-semibold text-slate-900 dark:text-white">
                        Developer Tools ({devTools.length})
                      </span>
                    </div>
                    <a href="#dev-tools-section" class="text-xs text-emerald-600 dark:text-emerald-400 hover:underline font-medium">
                      View section &rarr;
                    </a>
                  </div>
                  <div class="grid grid-cols-1 gap-1 max-h-[420px] overflow-y-auto pr-1">
                    {devTools.map((tool) => (
                      <a
                        href={tool.href}
                        class="flex items-center gap-3 p-1.5 rounded-xl hover:bg-slate-100 dark:hover:bg-slate-800/80 transition-colors group/item"
                      >
                        <div class="w-9 h-9 rounded-xl flex items-center justify-center bg-slate-100 dark:bg-slate-800 text-emerald-600 dark:text-emerald-400 group-hover/item:bg-emerald-50 dark:group-hover/item:bg-emerald-950/40 transition-colors shrink-0">
                          <ToolIcon name={tool.icon} class="w-4 h-4" />
                        </div>
                        <span class="text-sm font-medium text-slate-800 dark:text-slate-100 group-hover/item:text-emerald-600 dark:group-hover/item:text-emerald-400 transition-colors truncate">
                          {tool.title}
                        </span>
                      </a>
                    ))}
                  </div>
                </div>

              </div>
            </div>
          </div>
        </div>

        <!-- 2. Image Tools Independent Dropdown (3-column floating card) -->
        <div class="relative group" id="image-tools-menu-container">
          <a
            href="#image-tools-section"
            class="flex items-center gap-1 px-3 py-1.5 text-sm font-medium text-slate-600 dark:text-slate-300 hover:text-slate-900 dark:hover:text-white rounded-md hover:bg-slate-100 dark:hover:bg-slate-800/60 transition-colors"
          >
            <span>Image Tools</span>
            <svg class="w-4 h-4 text-slate-400 transition-transform duration-200 group-hover:rotate-180" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
              <path stroke-linecap="round" stroke-linejoin="round" d="M19 9l-7 7-7-7" />
            </svg>
          </a>

          <!-- Invisible bridge wrapper -->
          <div
            class="absolute top-full left-0 pt-2 opacity-0 invisible translate-y-1 group-hover:opacity-100 group-hover:visible group-hover:translate-y-0 transition-all duration-200 pointer-events-none group-hover:pointer-events-auto z-50"
          >
            <div
              class="w-[750px] -ml-28 p-5 rounded-2xl border border-slate-200 dark:border-slate-800 bg-white dark:bg-slate-900 shadow-2xl"
            >
              <div class="flex items-center justify-between pb-3 mb-3 border-b border-slate-100 dark:border-slate-800">
                <div class="flex items-center gap-2">
                  <div class="w-6 h-6 rounded-md bg-blue-500/10 text-blue-600 dark:text-blue-400 flex items-center justify-center">
                    <ToolIcon name="image" class="w-3.5 h-3.5" />
                  </div>
                  <span class="text-xs font-mono uppercase tracking-wider font-semibold text-slate-900 dark:text-white">
                    Image Tools ({imageTools.length})
                  </span>
                </div>
                <a href="#image-tools-section" class="text-xs text-blue-600 dark:text-blue-400 hover:underline font-medium">
                  View all in section &rarr;
                </a>
              </div>

              <div class="grid grid-cols-3 gap-1 max-h-[460px] overflow-y-auto pr-1">
                {imageTools.map((tool) => (
                  <a
                    href={tool.href}
                    class="flex items-center gap-3 p-1.5 rounded-xl hover:bg-slate-100 dark:hover:bg-slate-800/80 transition-colors group/item"
                  >
                    <div class="w-9 h-9 rounded-xl flex items-center justify-center bg-slate-100 dark:bg-slate-800 text-blue-600 dark:text-blue-400 group-hover/item:bg-blue-50 dark:group-hover/item:bg-blue-950/40 transition-colors shrink-0">
                      <ToolIcon name={tool.icon} class="w-4 h-4" />
                    </div>
                    <span class="text-sm font-medium text-slate-800 dark:text-slate-100 group-hover/item:text-blue-600 dark:group-hover/item:text-blue-400 transition-colors truncate">
                      {tool.title}
                    </span>
                  </a>
                ))}
              </div>
            </div>
          </div>
        </div>

        <!-- 3. Developer Tools Independent Dropdown (2-column floating card) -->
        <div class="relative group" id="dev-tools-menu-container">
          <a
            href="#dev-tools-section"
            class="flex items-center gap-1 px-3 py-1.5 text-sm font-medium text-slate-600 dark:text-slate-300 hover:text-slate-900 dark:hover:text-white rounded-md hover:bg-slate-100 dark:hover:bg-slate-800/60 transition-colors"
          >
            <span>Developer Tools</span>
            <svg class="w-4 h-4 text-slate-400 transition-transform duration-200 group-hover:rotate-180" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
              <path stroke-linecap="round" stroke-linejoin="round" d="M19 9l-7 7-7-7" />
            </svg>
          </a>

          <!-- Invisible bridge wrapper -->
          <div
            class="absolute top-full left-0 pt-2 opacity-0 invisible translate-y-1 group-hover:opacity-100 group-hover:visible group-hover:translate-y-0 transition-all duration-200 pointer-events-none group-hover:pointer-events-auto z-50"
          >
            <div
              class="w-[540px] -ml-24 p-5 rounded-2xl border border-slate-200 dark:border-slate-800 bg-white dark:bg-slate-900 shadow-2xl"
            >
              <div class="flex items-center justify-between pb-3 mb-3 border-b border-slate-100 dark:border-slate-800">
                <div class="flex items-center gap-2">
                  <div class="w-6 h-6 rounded-md bg-emerald-500/10 text-emerald-600 dark:text-emerald-400 flex items-center justify-center">
                    <ToolIcon name="code" class="w-3.5 h-3.5" />
                  </div>
                  <span class="text-xs font-mono uppercase tracking-wider font-semibold text-slate-900 dark:text-white">
                    Developer Tools ({devTools.length})
                  </span>
                </div>
                <a href="#dev-tools-section" class="text-xs text-emerald-600 dark:text-emerald-400 hover:underline font-medium">
                  View all in section &rarr;
                </a>
              </div>

              <div class="grid grid-cols-2 gap-1 max-h-[460px] overflow-y-auto pr-1">
                {devTools.map((tool) => (
                  <a
                    href={tool.href}
                    class="flex items-center gap-3 p-1.5 rounded-xl hover:bg-slate-100 dark:hover:bg-slate-800/80 transition-colors group/item"
                  >
                    <div class="w-9 h-9 rounded-xl flex items-center justify-center bg-slate-100 dark:bg-slate-800 text-emerald-600 dark:text-emerald-400 group-hover/item:bg-emerald-50 dark:group-hover/item:bg-emerald-950/40 transition-colors shrink-0">
                      <ToolIcon name={tool.icon} class="w-4 h-4" />
                    </div>
                    <span class="text-sm font-medium text-slate-800 dark:text-slate-100 group-hover/item:text-emerald-600 dark:group-hover/item:text-emerald-400 transition-colors truncate">
                      {tool.title}
                    </span>
                  </a>
                ))}
              </div>
            </div>
          </div>
        </div>

      </nav>
    </div>

    <!-- Right Controls: Quick Search Trigger & Theme Toggle -->
    <div class="flex items-center gap-2.5">
      <!-- Search Trigger Input / Button -->
      <button
        type="button"
        id="nav-search-trigger"
        class="flex items-center gap-3 px-3 py-1.5 text-xs text-slate-500 dark:text-slate-400 bg-slate-100 dark:bg-slate-800/80 hover:bg-slate-200/70 dark:hover:bg-slate-700/60 rounded-lg border border-slate-200/80 dark:border-slate-700/80 transition-all cursor-pointer w-36 sm:w-52"
        aria-label="Search tools"
      >
        <span class="flex items-center gap-1.5">
          <ToolIcon name="search" class="w-3.5 h-3.5 text-slate-400" />
          <span>Search tools...</span>
        </span>
        <kbd class="hidden sm:inline-flex items-center gap-0.5 px-1.5 py-0.5 text-[10px] font-mono text-slate-500 dark:text-slate-400 bg-white dark:bg-slate-900 rounded border border-slate-200 dark:border-slate-700 ml-auto shadow-xs">
          ⌘K
        </kbd>
      </button>

      <!-- Eye-Comfort Theme Switcher (Soft Light / Soft Dark) -->
      <button
        type="button"
        id="theme-toggle"
        class="p-2 text-slate-600 dark:text-slate-300 hover:text-slate-900 dark:hover:text-white rounded-lg hover:bg-slate-100 dark:hover:bg-slate-800/60 border border-slate-200/60 dark:border-slate-800 transition-colors"
        aria-label="Toggle eye-comfort theme"
      >
        <!-- Sun Icon (shown in dark mode) -->
        <svg id="theme-sun-icon" class="w-4 h-4 hidden dark:block text-amber-400" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
          <circle cx="12" cy="12" r="5"></circle>
          <line x1="12" y1="1" x2="12" y2="3"></line>
          <line x1="12" y1="21" x2="12" y2="23"></line>
          <line x1="4.22" y1="4.22" x2="5.64" y2="5.64"></line>
          <line x1="18.36" y1="18.36" x2="19.78" y2="19.78"></line>
          <line x1="1" y1="12" x2="3" y2="12"></line>
          <line x1="21" y1="12" x2="23" y2="12"></line>
          <line x1="4.22" y1="19.78" x2="5.64" y2="18.36"></line>
          <line x1="18.36" y1="5.64" x2="19.78" y2="4.22"></line>
        </svg>
        <!-- Moon Icon (shown in light mode) -->
        <svg id="theme-moon-icon" class="w-4 h-4 block dark:hidden text-slate-700" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
          <path d="M21 12.79A9 9 0 1 1 11.21 3 7 7 0 0 0 21 12.79z"></path>
        </svg>
      </button>

      <!-- Mobile Hamburger Button -->
      <button
        type="button"
        id="mobile-menu-btn"
        class="md:hidden p-2 text-slate-600 dark:text-slate-300 hover:text-slate-900 dark:hover:text-white rounded-lg hover:bg-slate-100 dark:hover:bg-slate-800 transition-colors"
        aria-label="Toggle mobile menu"
      >
        <svg class="w-5 h-5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
          <path stroke-linecap="round" stroke-linejoin="round" d="M4 6h16M4 12h16M4 18h16" />
        </svg>
      </button>
    </div>

  </div>

  <!-- Mobile Drawer Menu -->
  <div
    id="mobile-menu"
    class="hidden md:hidden border-t border-slate-200 dark:border-slate-800 bg-white/95 dark:bg-slate-900/95 backdrop-blur-md px-4 pt-3 pb-6 space-y-4 max-h-[80vh] overflow-y-auto"
  >
    <div class="space-y-1">
      <div class="text-[11px] font-mono uppercase tracking-wider font-semibold text-slate-400 dark:text-slate-500 px-2 py-1">
        Navigation
      </div>
      <a href="#image-tools-section" class="block px-3 py-2 text-sm font-medium rounded-lg hover:bg-slate-100 dark:hover:bg-slate-800 text-slate-800 dark:text-slate-200">
        Image Tools ({imageTools.length})
      </a>
      <a href="#dev-tools-section" class="block px-3 py-2 text-sm font-medium rounded-lg hover:bg-slate-100 dark:hover:bg-slate-800 text-slate-800 dark:text-slate-200">
        Developer Tools ({devTools.length})
      </a>
    </div>

    <!-- Mobile Tools List Accordion -->
    <div class="space-y-2 pt-2 border-t border-slate-100 dark:border-slate-800">
      <div class="text-[11px] font-mono uppercase tracking-wider font-semibold text-slate-400 dark:text-slate-500 px-2">
        Browse All Categories
      </div>
      
      <details class="group/mob">
        <summary class="flex items-center justify-between px-3 py-2 text-xs font-semibold text-slate-700 dark:text-slate-300 rounded-lg hover:bg-slate-100 dark:hover:bg-slate-800 cursor-pointer list-none">
          <span>Image Tools ({imageTools.length})</span>
          <span class="transition group-open/mob:rotate-180">&darr;</span>
        </summary>
        <div class="grid grid-cols-1 gap-1 pl-4 mt-1 border-l-2 border-slate-100 dark:border-slate-800">
          {imageTools.map((t) => (
            <a href={t.href} class="text-xs text-slate-600 dark:text-slate-400 hover:text-blue-600 py-1.5 flex items-center gap-2">
              <ToolIcon name={t.icon} class="w-3.5 h-3.5 text-slate-400" />
              <span>{t.title}</span>
            </a>
          ))}
        </div>
      </details>

      <details class="group/mob">
        <summary class="flex items-center justify-between px-3 py-2 text-xs font-semibold text-slate-700 dark:text-slate-300 rounded-lg hover:bg-slate-100 dark:hover:bg-slate-800 cursor-pointer list-none">
          <span>Developer Tools ({devTools.length})</span>
          <span class="transition group-open/mob:rotate-180">&darr;</span>
        </summary>
        <div class="grid grid-cols-1 gap-1 pl-4 mt-1 border-l-2 border-slate-100 dark:border-slate-800">
          {devTools.map((t) => (
            <a href={t.href} class="text-xs text-slate-600 dark:text-slate-400 hover:text-emerald-600 py-1.5 flex items-center gap-2">
              <ToolIcon name={t.icon} class="w-3.5 h-3.5 text-slate-400" />
              <span>{t.title}</span>
            </a>
          ))}
        </div>
      </details>
    </div>
  </div>
</header>

<script>
  // Mega Menu Click Toggle & Dismissal
  const megaMenuBtn = document.getElementById('mega-menu-btn');
  const megaMenuContainer = document.getElementById('mega-menu-container');

  megaMenuBtn?.addEventListener('click', (e) => {
    e.stopPropagation();
    const isOpen = megaMenuContainer?.classList.toggle('is-open');
    megaMenuBtn.setAttribute('aria-expanded', isOpen ? 'true' : 'false');
  });

  document.addEventListener('click', (e) => {
    if (!megaMenuContainer?.contains(e.target as Node)) {
      megaMenuContainer?.classList.remove('is-open');
      megaMenuBtn?.setAttribute('aria-expanded', 'false');
    }
  });

  megaMenuContainer?.querySelectorAll('a').forEach((link) => {
    link.addEventListener('click', () => {
      megaMenuContainer?.classList.remove('is-open');
      megaMenuBtn?.setAttribute('aria-expanded', 'false');
    });
  });

  // Theme Toggle Script
  const themeToggle = document.getElementById('theme-toggle');
  
  function updateTheme(isDark: boolean) {
    if (isDark) {
      document.documentElement.classList.add('dark');
      localStorage.setItem('theme', 'dark');
    } else {
      document.documentElement.classList.remove('dark');
      localStorage.setItem('theme', 'light');
    }
  }

  themeToggle?.addEventListener('click', () => {
    const isDark = document.documentElement.classList.contains('dark');
    updateTheme(!isDark);
  });

  // Mobile Menu Toggle
  const mobileMenuBtn = document.getElementById('mobile-menu-btn');
  const mobileMenu = document.getElementById('mobile-menu');

  mobileMenuBtn?.addEventListener('click', () => {
    mobileMenu?.classList.toggle('hidden');
  });

  // Search trigger focus
  const searchTrigger = document.getElementById('nav-search-trigger');
  searchTrigger?.addEventListener('click', () => {
    const mainSearchInput = document.getElementById('main-search-input') as HTMLInputElement | null;
    if (mainSearchInput) {
      mainSearchInput.focus();
      mainSearchInput.scrollIntoView({ behavior: 'smooth', block: 'center' });
    }
  });

  // Global Keyboard Shortcut: ⌘K or / to focus search
  window.addEventListener('keydown', (e) => {
    if ((e.key === 'k' && (e.metaKey || e.ctrlKey)) || (e.key === '/' && document.activeElement?.tagName !== 'INPUT' && document.activeElement?.tagName !== 'TEXTAREA')) {
      e.preventDefault();
      const mainSearchInput = document.getElementById('main-search-input') as HTMLInputElement | null;
      if (mainSearchInput) {
        mainSearchInput.focus();
        mainSearchInput.scrollIntoView({ behavior: 'smooth', block: 'center' });
      }
    }
  });
</script>
