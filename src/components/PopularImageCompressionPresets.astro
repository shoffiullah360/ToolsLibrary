---
// src/components/PopularImageCompressionPresets.astro
import { COMPRESS_PRESETS, IMAGE_COMPRESSOR_PRESETS, type CompressPreset } from '../data/compressPresets';

interface Props {
  presets?: CompressPreset[];
}

const { presets = IMAGE_COMPRESSOR_PRESETS } = Astro.props;
---

<section class="border-t border-slate-200/90 dark:border-slate-800 bg-white dark:bg-slate-950/40 py-14 sm:py-18">
  <div class="max-w-6xl mx-auto px-4 sm:px-6 lg:px-8">
    <div class="text-center max-w-2xl mx-auto mb-10">
      <h2 class="text-2xl sm:text-3xl font-bold tracking-tight text-slate-900 dark:text-white">
        Popular Image Compression Presets
      </h2>
      <p class="mt-2 text-sm sm:text-base text-slate-600 dark:text-slate-400">
        Direct compression configurations pre-configured for speed, exact byte limits, and local privacy.
      </p>
    </div>

    <div class="grid grid-cols-1 sm:grid-cols-2 md:grid-cols-3 lg:grid-cols-4 gap-4">
      {presets.map((preset) => (
        <a
          href={`/${preset.slug}/`}
          class="group p-3 sm:p-4 rounded-xl border border-slate-200 dark:border-slate-800 bg-white dark:bg-slate-900/60 hover:border-blue-500 dark:hover:border-blue-500 hover:shadow-sm transition-all flex flex-col justify-between"
        >
          <div>
            <h3 class="text-xs sm:text-sm font-semibold text-slate-900 dark:text-slate-100 group-hover:text-blue-600 dark:group-hover:text-blue-400 transition-colors leading-snug">
              {preset.title}
            </h3>
            <p class="mt-1.5 text-[11px] sm:text-xs text-slate-500 dark:text-slate-400 line-clamp-2 leading-relaxed">
              {preset.introDescription || preset.metaDescription}
            </p>
          </div>
          <span class="mt-3 text-[11px] sm:text-xs font-semibold text-blue-600 dark:text-blue-400 inline-flex items-center gap-1 group-hover:translate-x-0.5 transition-transform">
            Compress now &rarr;
          </span>
        </a>
      ))}
    </div>
  </div>
</section>
