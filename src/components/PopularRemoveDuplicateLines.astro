---
// src/components/PopularRemoveDuplicateLines.astro
import { DUPLICATE_LINES_PRESETS, type DuplicateLinesPreset } from '../data/duplicateLinesPresets';

interface Props {
  currentSlug?: string;
}

const { currentSlug = '' } = Astro.props;
---

<section class="border-t border-slate-200/90 dark:border-slate-800 bg-white dark:bg-slate-950/40 py-14 sm:py-18 font-sans">
  <div class="max-w-6xl mx-auto px-4 sm:px-6 lg:px-8">
    <div class="text-center max-w-2xl mx-auto mb-10">
      <h2 class="text-2xl sm:text-3xl font-bold tracking-tight text-slate-900 dark:text-white">
        Popular Duplicate Line Remover Presets
      </h2>
      <p class="mt-2 text-sm sm:text-base text-slate-600 dark:text-slate-400">
        Direct text deduplication workflows pre-configured for code editors, CLI shells, spreadsheets, and developer tools.
      </p>
    </div>

    <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-4">
      {DUPLICATE_LINES_PRESETS.map((preset: DuplicateLinesPreset) => {
        const isCurrent = preset.slug === currentSlug;
        return (
          <a
            href={`/${preset.slug}/`}
            class="group bg-slate-900/60 border border-slate-800/80 hover:border-slate-700 hover:bg-slate-900/90 rounded-xl p-4 transition-colors duration-200 outline-none focus:outline-none focus:ring-0 flex flex-col justify-between"
          >
            <div>
              <div class="flex items-center justify-between gap-2 mb-1">
                <span class="inline-block text-[11px] font-semibold text-emerald-400">
                  {preset.clusterTitle}
                </span>
                {isCurrent && (
                  <span class="inline-flex items-center gap-1.5 px-2 py-0.5 rounded-full text-[10px] font-medium bg-emerald-950/60 text-emerald-400 border border-emerald-800/40">
                    <span class="w-1.5 h-1.5 rounded-full bg-emerald-400"></span>
                    Active
                  </span>
                )}
              </div>
              <h3 class="text-sm font-semibold text-slate-200 group-hover:text-white transition-colors leading-snug">
                {preset.name}
              </h3>
              <p class="mt-1.5 text-xs text-slate-400 font-normal line-clamp-2 leading-relaxed">
                {preset.subtitle}
              </p>
            </div>
            <div class="mt-3 pt-2.5 border-t border-slate-800/60 flex items-center justify-between text-xs">
              {isCurrent ? (
                <span class="inline-flex items-center gap-1.5 text-xs font-medium text-emerald-400">
                  <span class="w-1.5 h-1.5 rounded-full bg-emerald-400"></span>
                  Current Preset
                </span>
              ) : (
                <span class="text-xs font-medium text-slate-400 group-hover:text-emerald-400 transition-colors inline-flex items-center gap-1">
                  <span>Remove duplicates</span>
                  <span class="group-hover:translate-x-0.5 transition-transform">&rarr;</span>
                </span>
              )}
            </div>
          </a>
        );
      })}
    </div>
  </div>
</section>
