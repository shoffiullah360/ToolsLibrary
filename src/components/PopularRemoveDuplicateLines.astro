---
// src/components/PopularRemoveDuplicateLines.astro
import { DUPLICATE_LINES_PRESETS, type DuplicateLinesPreset } from '../data/duplicateLinesPresets';

interface Props {
  currentSlug?: string;
}

const { currentSlug = '' } = Astro.props;
---

<section class="border-t border-slate-200/90 dark:border-slate-800 bg-white dark:bg-slate-950/40 py-14 sm:py-18 font-sans">
  <div class="max-w-6xl mx-auto px-4 sm:px-6 lg:px-8">
    <div class="text-center max-w-2xl mx-auto mb-10">
      <h2 class="text-2xl sm:text-3xl font-bold tracking-tight text-slate-900 dark:text-white">
        Popular Duplicate Line Remover Presets
      </h2>
      <p class="mt-2 text-sm sm:text-base text-slate-600 dark:text-slate-400">
        Direct text deduplication workflows pre-configured for code editors, CLI shells, spreadsheets, and developer tools.
      </p>
    </div>

    <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-3.5">
      {DUPLICATE_LINES_PRESETS.map((preset: DuplicateLinesPreset) => {
        const isCurrent = preset.slug === currentSlug;
        return (
          <a
            href={`/remove-duplicate-lines/${preset.slug}/`}
            class={`group p-3.5 sm:p-4 rounded-xl border transition-all duration-200 flex flex-col justify-between ${
              isCurrent
                ? 'border-emerald-500 bg-emerald-50/20 dark:bg-emerald-950/20'
                : 'border-slate-200 dark:border-slate-800 bg-white dark:bg-slate-900/60 hover:border-emerald-500 dark:hover:border-emerald-500 hover:shadow-sm'
            }`}
          >
            <div>
              <span class="inline-block text-[11px] font-semibold text-emerald-600 dark:text-emerald-400 mb-1">
                {preset.clusterTitle}
              </span>
              <h3 class="text-sm font-semibold text-slate-900 dark:text-slate-200 group-hover:text-emerald-600 dark:group-hover:text-emerald-400 transition-colors leading-snug">
                {preset.name}
              </h3>
              <p class="mt-1.5 text-xs text-slate-500 dark:text-slate-400 font-normal line-clamp-2 leading-relaxed">
                {preset.subtitle}
              </p>
            </div>
            <span class="mt-3 text-xs font-semibold text-emerald-600 dark:text-emerald-400 inline-flex items-center gap-1 group-hover:translate-x-0.5 transition-transform">
              {isCurrent ? 'Current preset ✓' : 'Remove duplicates →'}
            </span>
          </a>
        );
      })}
    </div>
  </div>
</section>
