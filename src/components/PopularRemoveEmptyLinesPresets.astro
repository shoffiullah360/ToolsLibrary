---
// src/components/PopularRemoveEmptyLinesPresets.astro
import { REMOVE_EMPTY_LINES_PRESETS, type RemoveEmptyLinesPreset } from '../data/removeEmptyLinesPresets';

interface Props {
  currentSlug?: string;
}

const { currentSlug = '' } = Astro.props;

// Group presets by cluster
const clusters = [
  { id: 'how-to', name: 'Direct How-To Question Guides' },
  { id: 'desktop-editors', name: 'Desktop Editors & Word Processors' },
  { id: 'ide-developer', name: 'IDEs & Developer Editors' },
  { id: 'spreadsheets-csv', name: 'Spreadsheets & CSV Data' },
  { id: 'code-payloads', name: 'Code Sanitization & Payloads' },
  { id: 'advanced-regex', name: 'Advanced Behavioral & Regex Modes' }
];
---

<section class="border-t border-slate-200/90 dark:border-slate-800 bg-white dark:bg-slate-950/60 py-14 sm:py-20">
  <div class="max-w-6xl mx-auto px-4 sm:px-6 lg:px-8">
    <div class="text-center max-w-3xl mx-auto mb-12">
      <div class="inline-flex items-center gap-1.5 px-3 py-1 rounded-full text-xs font-semibold bg-emerald-500/10 text-emerald-400 border border-emerald-500/20 mb-3">
        <span>35 Verified Configurations</span>
      </div>
      <h2 class="text-2xl sm:text-3xl font-bold tracking-tight text-slate-900 dark:text-white">
        Popular Presets & Targeted Tool Guides
      </h2>
      <p class="mt-2 text-sm sm:text-base text-slate-600 dark:text-slate-400">
        Direct workflows pre-configured for code editors, office software, spreadsheet tables, and programming strings.
      </p>
    </div>

    <div class="space-y-10">
      {clusters.map((cluster) => {
        const presetsInCluster = REMOVE_EMPTY_LINES_PRESETS.filter((p) => p.cluster === cluster.id);
        return (
          <div>
            <div class="flex items-center gap-2 mb-4 pb-2 border-b border-slate-200 dark:border-slate-800/80">
              <span class="w-2 h-2 rounded-full bg-emerald-500"></span>
              <h3 class="text-sm sm:text-base font-bold text-slate-900 dark:text-slate-200 uppercase tracking-wider">
                {cluster.name}
              </h3>
              <span class="text-xs text-slate-400 ml-auto font-mono">
                {presetsInCluster.length} presets
              </span>
            </div>

            <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-3.5 sm:gap-4">
              {presetsInCluster.map((preset) => {
                const isActive = preset.slug === currentSlug;
                return (
                  <a
                    href={`/tools/remove-empty-lines/${preset.slug}/`}
                    class={`group p-4 rounded-xl border transition-all flex flex-col justify-between ${
                      isActive
                        ? 'border-emerald-500 bg-emerald-950/20 shadow-sm ring-1 ring-emerald-500/30'
                        : 'border-slate-200 dark:border-slate-800 bg-slate-50/60 dark:bg-slate-900/40 hover:border-emerald-500/80 dark:hover:border-emerald-500/80 hover:bg-white dark:hover:bg-slate-900/90 shadow-2xs hover:shadow-sm'
                    }`}
                  >
                    <div>
                      <div class="flex items-center justify-between gap-2 mb-2">
                        <span class="text-[11px] font-mono uppercase tracking-wider px-2 py-0.5 rounded bg-slate-200/70 dark:bg-slate-800 text-slate-700 dark:text-slate-300">
                          {preset.primaryQuery ? preset.primaryQuery.split(' ')[0].toUpperCase() : 'PRESET'}
                        </span>
                        {isActive && (
                          <span class="text-[10px] font-bold uppercase tracking-wider px-1.5 py-0.5 rounded bg-emerald-500 text-slate-950">
                            Current
                          </span>
                        )}
                      </div>
                      <h4 class="text-sm font-semibold text-slate-900 dark:text-slate-100 group-hover:text-emerald-500 dark:group-hover:text-emerald-400 transition-colors leading-snug">
                        {preset.h1}
                      </h4>
                      <p class="mt-1.5 text-xs text-slate-600 dark:text-slate-400 line-clamp-2 leading-relaxed">
                        {preset.subtitle}
                      </p>
                    </div>

                    <div class="mt-4 pt-2.5 border-t border-slate-200/80 dark:border-slate-800/80 flex items-center justify-between text-xs font-medium text-emerald-600 dark:text-emerald-400 group-hover:translate-x-0.5 transition-transform">
                      <span>Open Preset Guide</span>
                      <span>&rarr;</span>
                    </div>
                  </a>
                );
              })}
            </div>
          </div>
        );
      })}
    </div>
  </div>
</section>
