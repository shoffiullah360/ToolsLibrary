---
// src/components/PopularRemoveLineBreaks.astro
import { removeLineBreaksPresets, type RemoveLineBreaksPreset } from '../data/removeLineBreaksPresets';

interface Props {
  currentSlug?: string;
}

const { currentSlug = '' } = Astro.props;

// Approved curated list of 40 high-value slugs
const APPROVED_40_SLUGS = new Set([
  "remove-line-breaks-in-excel",
  "how-to-remove-line-breaks-in-excel",
  "excel-remove-line-breaks-in-cell",
  "remove-line-breaks-in-excel-formula",
  "remove-line-breaks-excel-mac",
  "remove-line-breaks-google-sheets",
  "remove-line-breaks-airtable",
  "remove-line-breaks-csv",
  "remove-line-breaks-libreoffice-calc",
  "how-to-remove-line-breaks-in-word",
  "remove-line-breaks-in-word",
  "word-remove-line-breaks",
  "remove-line-breaks-google-docs",
  "how-to-remove-line-breaks-in-google-docs",
  "remove-line-breaks-apple-pages",
  "remove-line-breaks-scrivener",
  "remove-line-breaks-pdf",
  "remove-line-breaks-from-pdf-text",
  "python-remove-line-breaks-from-string",
  "remove-line-breaks-javascript",
  "remove-line-breaks-typescript",
  "remove-line-breaks-php",
  "remove-line-breaks-java",
  "remove-line-breaks-csharp",
  "remove-line-breaks-sql",
  "remove-line-breaks-mysql",
  "remove-line-breaks-postgresql",
  "remove-line-breaks-sqlite",
  "remove-line-breaks-json",
  "remove-line-breaks-xml",
  "remove-line-breaks-yaml",
  "remove-line-breaks-markdown",
  "remove-line-breaks-html",
  "remove-line-breaks-latex",
  "notepad-plus-plus-remove-line-breaks",
  "remove-line-breaks-vs-code",
  "remove-line-breaks-sublime-text",
  "remove-line-breaks-vim",
  "regex-remove-line-breaks",
  "remove-line-breaks-notion"
]);

// Filter and guarantee strictly only the 40 approved presets are rendered
const displayPresets: RemoveLineBreaksPreset[] = removeLineBreaksPresets.filter(
  (preset: RemoveLineBreaksPreset) => APPROVED_40_SLUGS.has(preset.slug)
);
---

<section class="border-t border-slate-200/90 dark:border-slate-800 bg-white dark:bg-slate-950/40 py-14 sm:py-18">
  <div class="max-w-6xl mx-auto px-4 sm:px-6 lg:px-8">
    <div class="text-center max-w-2xl mx-auto mb-10">
      <h2 class="text-2xl sm:text-3xl font-bold tracking-tight text-slate-900 dark:text-white">
        Popular Line Break Removal Presets
      </h2>
      <p class="mt-2 text-sm sm:text-base text-slate-600 dark:text-slate-400">
        Direct text cleaning workflows pre-configured for code editors, word processors, spreadsheets, and developer tools.
      </p>
    </div>

    <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-3.5">
      {displayPresets.map((preset: RemoveLineBreaksPreset) => {
        const isCurrent = preset.slug === currentSlug;
        return (
          <a
            href={`/${preset.slug}/`}
            class={`group p-3.5 sm:p-4 rounded-xl border transition-all duration-200 flex flex-col justify-between ${
              isCurrent 
                ? 'border-emerald-500 bg-emerald-50/20 dark:bg-emerald-950/20' 
                : 'border-slate-200 dark:border-slate-800 bg-white dark:bg-slate-900/60 hover:border-emerald-500 dark:hover:border-emerald-500 hover:shadow-sm'
            }`}
          >
            <div>
              <span class="inline-block text-[11px] font-semibold text-emerald-600 dark:text-emerald-400 mb-1">
                {preset.category || 'Preset'}
              </span>
              <h3 class="text-sm font-semibold text-slate-900 dark:text-slate-200 group-hover:text-emerald-600 dark:group-hover:text-emerald-400 transition-colors leading-snug">
                {preset.name}
              </h3>
              <p class="mt-1.5 text-xs text-slate-500 dark:text-slate-400 font-normal line-clamp-2 leading-relaxed">
                {preset.heroSubtitle}
              </p>
            </div>
            <span class="mt-3 text-xs font-semibold text-emerald-600 dark:text-emerald-400 inline-flex items-center gap-1 group-hover:translate-x-0.5 transition-transform">
              {isCurrent ? 'Current preset ✓' : 'Remove breaks →'}
            </span>
          </a>
        );
      })}
    </div>
  </div>
</section>
