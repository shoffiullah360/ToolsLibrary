---
// src/components/RemoveDuplicateLinesPresetView.astro
import ToolIcon from './ToolIcon.astro';
import PopularRemoveDuplicateLines from './PopularRemoveDuplicateLines.astro';
import type { DuplicateLinesPreset } from '../data/duplicateLinesPresets';

interface Props {
  preset: DuplicateLinesPreset;
}

const { preset } = Astro.props;
---

<div class="bg-slate-50 text-slate-900 dark:bg-slate-950 dark:text-slate-100 min-h-screen">
  
  <!-- 2. Hero Section (H1 exact keyword target, Subtitle strictly 20-25 words) -->
  <section class="relative pt-10 pb-6 sm:pt-14 sm:pb-8 overflow-hidden font-sans">
    <div class="hero-mesh-bg" aria-hidden="true"></div>

    <div class="relative max-w-5xl mx-auto px-4 sm:px-6 lg:px-8 text-center font-sans">
      <!-- Breadcrumbs -->
      <nav aria-label="Breadcrumb" class="mb-5 flex justify-center">
        <ol class="inline-flex items-center space-x-1.5 md:space-x-2 text-xs font-medium text-slate-500 dark:text-slate-400">
          <li class="inline-flex items-center">
            <a href="/" class="hover:text-emerald-600 dark:hover:text-emerald-400 transition-colors">Home</a>
          </li>
          <li>
            <div class="flex items-center">
              <svg class="w-3 h-3 text-slate-400 mx-1" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7" />
              </svg>
              <a href="/#text-tools-section" class="hover:text-emerald-600 dark:hover:text-emerald-400 transition-colors">Text &amp; Formatting</a>
            </div>
          </li>
          <li>
            <div class="flex items-center">
              <svg class="w-3 h-3 text-slate-400 mx-1" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7" />
              </svg>
              <a href="/remove-duplicate-lines/" class="hover:text-emerald-600 dark:hover:text-emerald-400 transition-colors">Remove Duplicate Lines</a>
            </div>
          </li>
          <li aria-current="page">
            <div class="flex items-center">
              <svg class="w-3 h-3 text-slate-400 mx-1" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7" />
              </svg>
              <span class="text-slate-900 dark:text-white font-semibold truncate max-w-[200px] sm:max-w-none">{preset.name || preset.h1}</span>
            </div>
          </li>
        </ol>
      </nav>

      <!-- H1 Title -->
      <h1 class="text-3xl sm:text-4xl md:text-5xl font-bold tracking-tight text-slate-900 dark:text-white leading-tight font-sans">
        {preset.h1}
      </h1>

      <!-- Subtitle (strictly 20-25 words) -->
      <p class="mt-3 sm:mt-4 text-base sm:text-lg text-slate-600 dark:text-slate-400 max-w-3xl mx-auto leading-relaxed font-sans">
        {preset.subtitle}
      </p>
    </div>
  </section>

  <!-- 3. Interactive Workspace Studio (Dual editor with glowing pill toggles, line counts, duplicate badge) -->
  <section class="max-w-6xl mx-auto px-4 sm:px-6 lg:px-8 pb-8 font-sans">
    <div class="rounded-2xl border border-slate-300 dark:border-slate-800 bg-white dark:bg-slate-900 shadow-xl overflow-hidden transition-colors">
      
      <!-- Top Options & Controls Bar -->
      <div class="p-5 sm:p-6 border-b border-slate-200 dark:border-slate-800 bg-slate-50/80 dark:bg-slate-900/90 space-y-4">
        
        <!-- Row 1: Mode Switcher & Action Buttons -->
        <div class="flex flex-col xl:flex-row xl:items-center justify-between gap-4">
          <div class="flex flex-col sm:flex-row sm:items-center gap-2.5">
            <span class="text-xs font-semibold text-slate-500 dark:text-slate-400 uppercase tracking-wider font-sans shrink-0">
              Extraction Mode:
            </span>
            <div class="inline-flex p-1 rounded-xl bg-slate-200/70 dark:bg-slate-950/80 border border-slate-300 dark:border-slate-800 gap-1 overflow-x-auto max-w-full">
              <button
                type="button"
                class={`mode-pill-btn px-3 py-1.5 text-xs rounded-lg font-medium transition-all cursor-pointer whitespace-nowrap ${preset.options.mode === 'unique' ? 'bg-emerald-600 text-white shadow-xs font-semibold' : 'text-slate-700 dark:text-slate-300 hover:text-slate-900 dark:hover:text-white hover:bg-slate-300/50 dark:hover:bg-slate-800/60'}`}
                data-mode="unique"
              >
                Unique Lines
              </button>
              <button
                type="button"
                class={`mode-pill-btn px-3 py-1.5 text-xs rounded-lg font-medium transition-all cursor-pointer whitespace-nowrap ${preset.options.mode === 'duplicates-only' ? 'bg-emerald-600 text-white shadow-xs font-semibold' : 'text-slate-700 dark:text-slate-300 hover:text-slate-900 dark:hover:text-white hover:bg-slate-300/50 dark:hover:bg-slate-800/60'}`}
                data-mode="duplicates-only"
              >
                Duplicates Only
              </button>
              <button
                type="button"
                class={`mode-pill-btn px-3 py-1.5 text-xs rounded-lg font-medium transition-all cursor-pointer whitespace-nowrap ${preset.options.mode === 'completely-unique' ? 'bg-emerald-600 text-white shadow-xs font-semibold' : 'text-slate-700 dark:text-slate-300 hover:text-slate-900 dark:hover:text-white hover:bg-slate-300/50 dark:hover:bg-slate-800/60'}`}
                data-mode="completely-unique"
              >
                Completely Unique
              </button>
              <button
                type="button"
                class={`mode-pill-btn px-3 py-1.5 text-xs rounded-lg font-medium transition-all cursor-pointer whitespace-nowrap ${preset.options.mode === 'count-occurrences' ? 'bg-emerald-600 text-white shadow-xs font-semibold' : 'text-slate-700 dark:text-slate-300 hover:text-slate-900 dark:hover:text-white hover:bg-slate-300/50 dark:hover:bg-slate-800/60'}`}
                data-mode="count-occurrences"
              >
                Count Occurrences
              </button>
            </div>
          </div>

          <!-- Action Buttons -->
          <div class="flex items-center gap-2.5 shrink-0 self-start xl:self-auto">
            <button
              type="button"
              id="btn-sample"
              class="px-3.5 py-2 text-xs font-semibold rounded-lg border border-slate-300 dark:border-slate-700 bg-white dark:bg-slate-800/80 text-slate-700 dark:text-slate-300 hover:bg-slate-100 dark:hover:bg-slate-800 hover:text-slate-900 dark:hover:text-white transition-colors cursor-pointer shadow-2xs font-sans"
            >
              Load Sample
            </button>
            <button
              type="button"
              id="btn-dedupe"
              class="px-5 py-2 text-xs sm:text-sm font-semibold rounded-lg bg-emerald-600 hover:bg-emerald-500 text-white shadow-lg shadow-emerald-600/20 active:scale-95 transition-all flex items-center gap-2 cursor-pointer font-sans"
            >
              <ToolIcon name="list-filter" class="w-4 h-4 text-white" />
              <span>Remove Duplicates</span>
            </button>
          </div>
        </div>

        <!-- Row 2: Glowing Pill Checkboxes & Sort -->
        <div class="pt-3 border-t border-slate-200/80 dark:border-slate-800/80 flex flex-col lg:flex-row lg:items-center justify-between gap-4">
          <div class="flex flex-wrap items-center gap-2 sm:gap-2.5">
            <label class="group inline-flex items-center gap-2 px-3 py-1.5 rounded-lg border border-slate-200 dark:border-slate-800 bg-white/70 dark:bg-slate-950/50 text-slate-700 dark:text-slate-300 hover:border-emerald-500/50 dark:hover:border-emerald-500/50 transition-all cursor-pointer text-xs font-sans select-none has-[:checked]:border-emerald-500/60 has-[:checked]:bg-emerald-50 dark:has-[:checked]:bg-emerald-950/30 has-[:checked]:text-emerald-700 dark:has-[:checked]:text-emerald-300 has-[:checked]:shadow-xs">
              <input
                type="checkbox"
                id="opt-case-sensitive"
                checked={preset.options.caseSensitive}
                class="w-3.5 h-3.5 rounded text-emerald-600 focus:ring-emerald-500 dark:bg-slate-800 border-slate-300 dark:border-slate-700 cursor-pointer accent-emerald-600"
              />
              <span class="font-medium">Case-sensitive comparison (<span class="font-mono text-[11px]">Aa ≠ aa</span>)</span>
            </label>

            <label class="group inline-flex items-center gap-2 px-3 py-1.5 rounded-lg border border-slate-200 dark:border-slate-800 bg-white/70 dark:bg-slate-950/50 text-slate-700 dark:text-slate-300 hover:border-emerald-500/50 dark:hover:border-emerald-500/50 transition-all cursor-pointer text-xs font-sans select-none has-[:checked]:border-emerald-500/60 has-[:checked]:bg-emerald-50 dark:has-[:checked]:bg-emerald-950/30 has-[:checked]:text-emerald-700 dark:has-[:checked]:text-emerald-300 has-[:checked]:shadow-xs">
              <input
                type="checkbox"
                id="opt-trim-lines"
                checked={preset.options.trimLines}
                class="w-3.5 h-3.5 rounded text-emerald-600 focus:ring-emerald-500 dark:bg-slate-800 border-slate-300 dark:border-slate-700 cursor-pointer accent-emerald-600"
              />
              <span class="font-medium">Trim edge whitespace</span>
            </label>

            <label class="group inline-flex items-center gap-2 px-3 py-1.5 rounded-lg border border-slate-200 dark:border-slate-800 bg-white/70 dark:bg-slate-950/50 text-slate-700 dark:text-slate-300 hover:border-emerald-500/50 dark:hover:border-emerald-500/50 transition-all cursor-pointer text-xs font-sans select-none has-[:checked]:border-emerald-500/60 has-[:checked]:bg-emerald-50 dark:has-[:checked]:bg-emerald-950/30 has-[:checked]:text-emerald-700 dark:has-[:checked]:text-emerald-300 has-[:checked]:shadow-xs">
              <input
                type="checkbox"
                id="opt-empty-lines"
                checked={preset.options.emptyLines}
                class="w-3.5 h-3.5 rounded text-emerald-600 focus:ring-emerald-500 dark:bg-slate-800 border-slate-300 dark:border-slate-700 cursor-pointer accent-emerald-600"
              />
              <span class="font-medium">Remove empty / blank lines</span>
            </label>

            <label class="group inline-flex items-center gap-2 px-3 py-1.5 rounded-lg border border-slate-200 dark:border-slate-800 bg-white/70 dark:bg-slate-950/50 text-slate-700 dark:text-slate-300 hover:border-emerald-500/50 dark:hover:border-emerald-500/50 transition-all cursor-pointer text-xs font-sans select-none has-[:checked]:border-emerald-500/60 has-[:checked]:bg-emerald-50 dark:has-[:checked]:bg-emerald-950/30 has-[:checked]:text-emerald-700 dark:has-[:checked]:text-emerald-300 has-[:checked]:shadow-xs">
              <input
                type="checkbox"
                id="opt-ignore-punctuation"
                checked={preset.options.ignorePunctuation}
                class="w-3.5 h-3.5 rounded text-emerald-600 focus:ring-emerald-500 dark:bg-slate-800 border-slate-300 dark:border-slate-700 cursor-pointer accent-emerald-600"
              />
              <span class="font-medium">Ignore punctuation & symbols</span>
            </label>
          </div>

          <div class="flex items-center gap-2 shrink-0">
            <span class="text-xs font-semibold text-slate-500 dark:text-slate-400 uppercase tracking-wider font-sans">
              Sort:
            </span>
            <select
              id="select-sort"
              class="px-3 py-1.5 text-xs font-medium rounded-lg border border-slate-300 dark:border-slate-700 bg-white dark:bg-slate-800 text-slate-800 dark:text-slate-200 focus:outline-none focus:ring-2 focus:ring-emerald-500/30 focus:border-emerald-500 transition cursor-pointer font-sans"
            >
              <option value="original" selected={preset.options.sort === 'original'}>Original Order (Input Flow)</option>
              <option value="alpha-asc" selected={preset.options.sort === 'alpha-asc'}>Alphabetical (A → Z)</option>
              <option value="alpha-desc" selected={preset.options.sort === 'alpha-desc'}>Reverse Alphabetical (Z → A)</option>
              <option value="length-asc" selected={preset.options.sort === 'length-asc'}>Length (Shortest First)</option>
              <option value="freq-desc" selected={preset.options.sort === 'freq-desc'}>Frequency (Most Repeated First)</option>
            </select>
          </div>
        </div>

        <!-- Row 3: Delimiter Joiner -->
        <div class="pt-3 border-t border-slate-200/80 dark:border-slate-800/80 flex flex-wrap items-center gap-3">
          <span class="text-xs font-semibold text-slate-500 dark:text-slate-400 uppercase tracking-wider font-sans shrink-0">
            Output Delimiter:
          </span>
          <div class="flex flex-wrap items-center gap-3 text-xs sm:text-sm font-sans">
            <label class="inline-flex items-center gap-1.5 cursor-pointer text-slate-700 dark:text-slate-300 hover:text-slate-900 dark:hover:text-white transition-colors">
              <input
                type="radio"
                name="delimiter-mode"
                value="newline"
                checked={preset.options.delimiter === 'newline'}
                class="w-4 h-4 text-emerald-600 focus:ring-emerald-500 dark:bg-slate-800 border-slate-300 dark:border-slate-700 cursor-pointer accent-emerald-600"
              />
              <span class="font-medium">Newline (<span class="font-mono text-[11px]">\n</span>)</span>
            </label>

            <label class="inline-flex items-center gap-1.5 cursor-pointer text-slate-700 dark:text-slate-300 hover:text-slate-900 dark:hover:text-white transition-colors">
              <input
                type="radio"
                name="delimiter-mode"
                value="comma"
                checked={preset.options.delimiter === 'comma'}
                class="w-4 h-4 text-emerald-600 focus:ring-emerald-500 dark:bg-slate-800 border-slate-300 dark:border-slate-700 cursor-pointer accent-emerald-600"
              />
              <span class="font-medium">Comma (<span class="font-mono text-[11px]">, </span>) [CSV]</span>
            </label>

            <label class="inline-flex items-center gap-1.5 cursor-pointer text-slate-700 dark:text-slate-300 hover:text-slate-900 dark:hover:text-white transition-colors">
              <input
                type="radio"
                name="delimiter-mode"
                value="semicolon"
                checked={preset.options.delimiter === 'semicolon'}
                class="w-4 h-4 text-emerald-600 focus:ring-emerald-500 dark:bg-slate-800 border-slate-300 dark:border-slate-700 cursor-pointer accent-emerald-600"
              />
              <span class="font-medium">Semicolon (<span class="font-mono text-[11px] font-semibold">; </span>)</span>
            </label>

            <div class="inline-flex items-center gap-1.5">
              <label class="inline-flex items-center gap-1.5 cursor-pointer text-slate-700 dark:text-slate-300 hover:text-slate-900 dark:hover:text-white transition-colors">
                <input
                  type="radio"
                  name="delimiter-mode"
                  value="custom"
                  id="mode-custom-delimiter-radio"
                  checked={preset.options.delimiter === 'custom'}
                  class="w-4 h-4 text-emerald-600 focus:ring-emerald-500 dark:bg-slate-800 border-slate-300 dark:border-slate-700 cursor-pointer accent-emerald-600"
                />
                <span class="font-medium">Custom:</span>
              </label>
              <input
                type="text"
                id="input-custom-delimiter"
                placeholder="e.g. | or \t"
                value={preset.options.customDelimiter || ""}
                class="w-24 px-2 py-1 text-xs font-mono rounded-lg border border-slate-300 dark:border-slate-700 bg-white dark:bg-slate-800 text-slate-900 dark:text-white focus:outline-none focus:ring-2 focus:ring-emerald-500/30 focus:border-emerald-500 transition"
              />
            </div>
          </div>
        </div>

      </div>

      <!-- Dual Textarea Studio -->
      <div class="grid grid-cols-1 lg:grid-cols-2 divide-y lg:divide-y-0 lg:divide-x divide-slate-200 dark:divide-slate-800">
        
        <!-- Left: Input Area -->
        <div class="p-4 sm:p-5 flex flex-col space-y-3 bg-slate-50/40 dark:bg-slate-900/40">
          <div class="flex items-center justify-between">
            <span class="text-xs font-semibold uppercase tracking-wider text-slate-500 dark:text-slate-400 font-sans">
              Input Text
            </span>
            <div class="flex items-center gap-2 font-sans">
              <button
                type="button"
                id="btn-paste"
                class="px-2.5 py-1 text-xs font-medium rounded-lg border border-slate-300 dark:border-slate-700 bg-white dark:bg-slate-800 text-slate-700 dark:text-slate-300 hover:text-slate-900 dark:hover:text-white transition-colors flex items-center gap-1.5 cursor-pointer shadow-xs"
                title="Paste from clipboard"
              >
                <svg class="w-3.5 h-3.5 text-slate-400" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                  <path stroke-linecap="round" stroke-linejoin="round" d="M9 5H7a2 2 0 00-2 2v12a2 2 0 002 2h10a2 2 0 002-2V7a2 2 0 00-2-2h-2M9 5a2 2 0 002 2h2a2 2 0 002-2M9 5a2 2 0 012-2h2a2 2 0 012 2" />
                </svg>
                <span>Paste</span>
              </button>
              <button
                type="button"
                id="btn-clear"
                class="px-2.5 py-1 text-xs font-medium rounded-lg border border-slate-300 dark:border-slate-700 bg-white dark:bg-slate-800 hover:bg-rose-50 dark:hover:bg-rose-950/40 hover:border-rose-300 dark:hover:border-rose-800 text-slate-700 dark:text-slate-300 hover:text-rose-600 dark:hover:text-rose-400 transition-colors flex items-center gap-1.5 cursor-pointer shadow-xs"
                title="Clear input text"
              >
                <svg class="w-3.5 h-3.5 text-slate-400" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                  <path stroke-linecap="round" stroke-linejoin="round" d="M19 7l-.867 12.142A2 2 0 0116.138 21H7.862a2 2 0 01-1.995-1.858L5 7m5 4v6m4-6v6m1-10V4a1 1 0 00-1-1h-4a1 1 0 00-1 1v3M4 7h16" />
                </svg>
                <span>Clear</span>
              </button>
            </div>
          </div>

          <textarea
            id="input-text"
            rows="14"
            placeholder="Paste your text list here, or click 'Load Sample'..."
            class="w-full p-4 rounded-xl border border-slate-300 dark:border-slate-800 bg-white dark:bg-slate-950 font-sans text-slate-800 dark:text-slate-200 text-sm leading-relaxed placeholder:text-slate-400 focus:outline-none focus:ring-2 focus:ring-emerald-500/30 focus:border-emerald-500 transition resize-y min-h-[340px]"
            spellcheck="false"
          ></textarea>

          <!-- Input Stats Strip -->
          <div class="pt-2 px-1 flex items-center justify-between text-xs text-slate-500 dark:text-slate-400 font-sans">
            <div class="flex items-center gap-1.5 sm:gap-2">
              <span><strong id="stat-input-lines" class="font-semibold text-slate-800 dark:text-slate-200">0</strong> Lines</span>
              <span class="text-slate-300 dark:text-slate-700">·</span>
              <span><strong id="stat-input-chars" class="font-semibold text-slate-800 dark:text-slate-200">0</strong> Chars</span>
              <span class="text-slate-300 dark:text-slate-700">·</span>
              <span><strong id="stat-input-words" class="font-semibold text-slate-800 dark:text-slate-200">0</strong> Words</span>
            </div>
          </div>
        </div>

        <!-- Right: Output Area -->
        <div class="p-4 sm:p-5 flex flex-col space-y-3 bg-slate-50/40 dark:bg-slate-900/40">
          <div class="flex items-center justify-between">
            <div class="flex items-center gap-2">
              <span class="text-xs font-semibold uppercase tracking-wider text-slate-500 dark:text-slate-400 font-sans">
                Cleaned Result
              </span>
              <span
                id="status-duplicates-badge"
                class="bg-emerald-500/10 text-emerald-600 dark:text-emerald-400 border border-emerald-500/20 text-xs px-2.5 py-0.5 rounded-full font-medium font-sans"
              >
                0 duplicates removed
              </span>
            </div>

            <div class="flex items-center gap-2 font-sans">
              <button
                type="button"
                id="btn-copy"
                class="px-3 py-1 text-xs font-semibold rounded-lg bg-emerald-600 hover:bg-emerald-500 text-white transition-colors flex items-center gap-1.5 cursor-pointer shadow-xs"
                title="Copy cleaned result"
              >
                <svg id="copy-icon-idle" class="w-3.5 h-3.5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                  <rect x="9" y="9" width="13" height="13" rx="2" ry="2"></rect>
                  <path d="M5 15H4a2 2 0 01-2-2V4a2 2 0 012-2h9a2 2 0 012 2v1"></path>
                </svg>
                <svg id="copy-icon-success" class="w-3.5 h-3.5 hidden text-white" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                  <polyline points="20 6 9 17 4 12"></polyline>
                </svg>
                <span id="copy-btn-text">Copy</span>
              </button>

              <button
                type="button"
                id="btn-download"
                class="px-2.5 py-1 text-xs font-medium rounded-lg border border-slate-300 dark:border-slate-700 bg-white dark:bg-slate-800 text-slate-700 dark:text-slate-300 hover:text-slate-900 dark:hover:text-white transition-colors flex items-center gap-1.5 cursor-pointer shadow-xs"
                title="Download as .txt"
              >
                <svg class="w-3.5 h-3.5 text-slate-400" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                  <path stroke-linecap="round" stroke-linejoin="round" d="M4 16v1a3 3 0 003 3h10a3 3 0 003-3v-1m-4-4l-4 4m0 0l-4-4m4 4V4" />
                </svg>
                <span>Download .txt</span>
              </button>
            </div>
          </div>

          <textarea
            id="output-text"
            rows="14"
            placeholder="Deduplicated results will appear here in real time..."
            class="w-full p-4 rounded-xl border border-slate-300 dark:border-slate-800 bg-white dark:bg-slate-950 font-sans text-slate-800 dark:text-slate-200 text-sm leading-relaxed placeholder:text-slate-400 focus:outline-none focus:ring-2 focus:ring-emerald-500/30 focus:border-emerald-500 transition resize-y min-h-[340px]"
            spellcheck="false"
          ></textarea>

          <!-- Output Stats Strip -->
          <div class="pt-2 px-1 flex items-center justify-between text-xs text-slate-500 dark:text-slate-400 font-sans">
            <div class="flex items-center gap-1.5 sm:gap-2">
              <span><strong id="stat-output-lines" class="font-semibold text-slate-800 dark:text-slate-200">0</strong> Lines</span>
              <span class="text-slate-300 dark:text-slate-700">·</span>
              <span><strong id="stat-output-chars" class="font-semibold text-slate-800 dark:text-slate-200">0</strong> Chars</span>
              <span class="text-slate-300 dark:text-slate-700">·</span>
              <span><strong id="stat-output-words" class="font-semibold text-slate-800 dark:text-slate-200">0</strong> Words</span>
            </div>
            <div class="text-emerald-600 dark:text-emerald-400 font-medium text-xs flex items-center gap-1">
              <span>Saved:</span>
              <span id="stat-reduction-pct">0%</span>
            </div>
          </div>
        </div>

      </div>
    </div>
  </section>

  <!-- 4. Bottom Intent Card (Glassmorphism slate-900/60 container, 50-60 words specific intent) -->
  <section class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8 pb-12 font-sans">
