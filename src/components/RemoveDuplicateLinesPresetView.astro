<!-- Interactive Client-Side Workspace Script -->
<script is:inline define:vars={{ initialSample: preset.sampleText, defaultOptions: preset.options }}>
  (function () {
    const inputText = document.getElementById('input-text');
    const outputText = document.getElementById('output-text');
    const optCaseSensitive = document.getElementById('opt-case-sensitive');
    const optTrimLines = document.getElementById('opt-trim-lines');
    const optEmptyLines = document.getElementById('opt-empty-lines');
    const optIgnorePunctuation = document.getElementById('opt-ignore-punctuation');
    const selectSort = document.getElementById('select-sort');
    const btnDedupe = document.getElementById('btn-dedupe');
    const btnSample = document.getElementById('btn-sample');
    const btnPaste = document.getElementById('btn-paste');
    const btnClear = document.getElementById('btn-clear');
    const btnCopy = document.getElementById('btn-copy');
    const btnDownload = document.getElementById('btn-download');

    const copyBtnText = document.getElementById('copy-btn-text');
    const copyIconIdle = document.getElementById('copy-icon-idle');
    const copyIconSuccess = document.getElementById('copy-icon-success');

    const statInputChars = document.getElementById('stat-input-chars');
    const statInputWords = document.getElementById('stat-input-words');
    const statInputLines = document.getElementById('stat-input-lines');

    const statOutputChars = document.getElementById('stat-output-chars');
    const statOutputLines = document.getElementById('stat-output-lines');
    const statOutputWords = document.getElementById('stat-output-words');
    const statReductionPct = document.getElementById('stat-reduction-pct');
    const statusDuplicatesBadge = document.getElementById('status-duplicates-badge');

    const modeButtons = document.querySelectorAll('.mode-pill-btn');
    const delimiterRadios = document.querySelectorAll('input[name="delimiter-mode"]');
    const inputCustomDelimiter = document.getElementById('input-custom-delimiter');
    const modeCustomRadio = document.getElementById('mode-custom-delimiter-radio');

    let currentMode = defaultOptions.mode || 'unique';

    // Extraction Mode pill switching
    modeButtons.forEach((btn) => {
      btn.addEventListener('click', () => {
        modeButtons.forEach((b) => {
          b.classList.remove('bg-emerald-600', 'text-white', 'shadow-xs', 'font-semibold');
          b.classList.add('text-slate-700', 'dark:text-slate-300');
        });
        btn.classList.remove('text-slate-700', 'dark:text-slate-300');
        btn.classList.add('bg-emerald-600', 'text-white', 'shadow-xs', 'font-semibold');
        currentMode = btn.getAttribute('data-mode') || 'unique';
        processDeduplication();
      });
    });

    function getSelectedDelimiter() {
      let selected = 'newline';
      delimiterRadios.forEach((r) => {
        if (r.checked) selected = r.value;
      });
      if (selected === 'comma') return ', ';
      if (selected === 'semicolon') return '; ';
      if (selected === 'custom') {
        const val = inputCustomDelimiter ? inputCustomDelimiter.value : '';
        return val.replace(/\\n/g, '\n').replace(/\\t/g, '\t');
      }
      return '\n';
    }

    if (inputCustomDelimiter) {
      inputCustomDelimiter.addEventListener('focus', () => {
        if (modeCustomRadio) modeCustomRadio.checked = true;
      });
      inputCustomDelimiter.addEventListener('input', () => {
        if (modeCustomRadio) modeCustomRadio.checked = true;
        processDeduplication();
      });
    }

    delimiterRadios.forEach((r) => {
      r.addEventListener('change', processDeduplication);
    });

    function countWords(str) {
      if (!str) return 0;
      return (str.trim().match(/\S+/g) || []).length;
    }

    function countLines(str) {
      if (!str) return 0;
      return str.split(/\r?\n/).length;
    }

    function processDeduplication() {
      const rawText = inputText ? inputText.value : '';
      if (!rawText) {
        if (outputText) outputText.value = '';
        updateStats('', '');
        return;
      }

      const caseSensitive = optCaseSensitive ? optCaseSensitive.checked : true;
      const trimLines = optTrimLines ? optTrimLines.checked : true;
      const removeEmpty = optEmptyLines ? optEmptyLines.checked : true;
      const ignorePunct = optIgnorePunctuation ? optIgnorePunctuation.checked : false;
      const sortMode = selectSort ? selectSort.value : 'original';
      const delimiter = getSelectedDelimiter();

      const rawLines = rawText.split(/\r?\n/);
      
      const lineMap = new Map();
      const firstEncountered = [];

      for (let i = 0; i < rawLines.length; i++) {
        let line = rawLines[i];
        if (trimLines) line = line.trim();
        if (removeEmpty && !line) continue;

        let key = caseSensitive ? line : line.toLowerCase();
        if (ignorePunct) {
          key = key.replace(/[^\p{L}\p{N}\s]/gu, '');
        }

        if (!lineMap.has(key)) {
          lineMap.set(key, { original: line, count: 1, firstIndex: i });
          firstEncountered.push(key);
        } else {
          lineMap.get(key).count += 1;
        }
      }

      let resultLines = [];

      if (currentMode === 'unique') {
        resultLines = firstEncountered.map((k) => lineMap.get(k).original);
      } else if (currentMode === 'duplicates-only') {
        resultLines = firstEncountered
          .filter((k) => lineMap.get(k).count > 1)
          .map((k) => lineMap.get(k).original);
      } else if (currentMode === 'completely-unique') {
        resultLines = firstEncountered
          .filter((k) => lineMap.get(k).count === 1)
          .map((k) => lineMap.get(k).original);
      } else if (currentMode === 'count-occurrences') {
        resultLines = firstEncountered.map((k) => {
          const entry = lineMap.get(k);
          return `[${entry.count}x] ${entry.original}`;
        });
      }

      // Sorting
      if (sortMode === 'alpha-asc') {
        resultLines.sort((a, b) => a.localeCompare(b, undefined, { numeric: true, sensitivity: 'base' }));
      } else if (sortMode === 'alpha-desc') {
        resultLines.sort((a, b) => b.localeCompare(a, undefined, { numeric: true, sensitivity: 'base' }));
      } else if (sortMode === 'length-asc') {
        resultLines.sort((a, b) => a.length - b.length || a.localeCompare(b));
      } else if (sortMode === 'freq-desc') {
        resultLines.sort((a, b) => {
          const keyA = caseSensitive ? a : a.toLowerCase();
          const keyB = caseSensitive ? b : b.toLowerCase();
          const countA = lineMap.get(keyA) ? lineMap.get(keyA).count : 1;
          const countB = lineMap.get(keyB) ? lineMap.get(keyB).count : 1;
          return countB - countA || a.localeCompare(b);
        });
      }

      const finalOutput = resultLines.join(delimiter);
      if (outputText) outputText.value = finalOutput;
      updateStats(rawText, finalOutput, rawLines.length, resultLines.length);
    }

    function updateStats(inStr, outStr, inLinesCount, outLinesCount) {
      const inChars = inStr ? inStr.length : 0;
      const inWords = countWords(inStr);
      const inLines = inLinesCount !== undefined ? inLinesCount : (inStr ? countLines(inStr) : 0);

      const outChars = outStr ? outStr.length : 0;
      const outWords = countWords(outStr);
      const outLines = outLinesCount !== undefined ? outLinesCount : (outStr ? countLines(outStr) : 0);

      const saved = Math.max(0, inLines - outLines);
      const pct = inLines > 0 ? Math.round((saved / inLines) * 100) : 0;

      if (statInputLines) statInputLines.textContent = inLines.toLocaleString();
      if (statInputChars) statInputChars.textContent = inChars.toLocaleString();
      if (statInputWords) statInputWords.textContent = inWords.toLocaleString();

      if (statOutputLines) statOutputLines.textContent = outLines.toLocaleString();
      if (statOutputChars) statOutputChars.textContent = outChars.toLocaleString();
      if (statOutputWords) statOutputWords.textContent = outWords.toLocaleString();

      if (statReductionPct) statReductionPct.textContent = `${pct}% Saved`;
      if (statusDuplicatesBadge) {
        statusDuplicatesBadge.textContent = `${saved.toLocaleString()} duplicates removed`;
      }
    }

    // Event listeners
    if (inputText) {
      inputText.addEventListener('input', processDeduplication);
    }
    if (optCaseSensitive) optCaseSensitive.addEventListener('change', processDeduplication);
    if (optTrimLines) optTrimLines.addEventListener('change', processDeduplication);
    if (optEmptyLines) optEmptyLines.addEventListener('change', processDeduplication);
    if (optIgnorePunctuation) optIgnorePunctuation.addEventListener('change', processDeduplication);
    if (selectSort) selectSort.addEventListener('change', processDeduplication);
    if (btnDedupe) btnDedupe.addEventListener('click', processDeduplication);

    if (btnSample && inputText) {
      btnSample.addEventListener('click', () => {
        inputText.value = initialSample || "";
        processDeduplication();
      });
    }

    if (btnClear && inputText && outputText) {
      btnClear.addEventListener('click', () => {
        inputText.value = '';
        outputText.value = '';
        updateStats('', '');
        inputText.focus();
      });
    }

    if (btnPaste && inputText) {
      btnPaste.addEventListener('click', async () => {
        try {
          const text = await navigator.clipboard.readText();
          if (text) {
            inputText.value = text;
            processDeduplication();
          }
        } catch {
          inputText.focus();
        }
      });
    }

    if (btnCopy && outputText) {
      btnCopy.addEventListener('click', async () => {
        const text = outputText.value;
        if (!text) return;
        try {
          await navigator.clipboard.writeText(text);
          if (copyIconIdle && copyIconSuccess && copyBtnText) {
            copyIconIdle.classList.add('hidden');
            copyIconSuccess.classList.remove('hidden');
            copyBtnText.textContent = 'Copied!';
            setTimeout(() => {
              copyIconIdle.classList.remove('hidden');
              copyIconSuccess.classList.add('hidden');
              copyBtnText.textContent = 'Copy';
            }, 2000);
          }
        } catch {
          outputText.select();
          document.execCommand('copy');
        }
      });
    }

    if (btnDownload && outputText) {
      btnDownload.addEventListener('click', () => {
        const text = outputText.value;
        if (!text) return;
        const blob = new Blob([text], { type: 'text/plain;charset=utf-8' });
        const url = URL.createObjectURL(blob);
        const a = document.createElement('a');
        a.href = url;
        a.download = 'cleaned-unique-lines.txt';
        document.body.appendChild(a);
        a.click();
        document.body.removeChild(a);
        URL.revokeObjectURL(url);
      });
    }

    // Initial run if preset sample is present
    if (inputText && initialSample) {
      inputText.value = initialSample;
      processDeduplication();
    }
  })();
</script>
