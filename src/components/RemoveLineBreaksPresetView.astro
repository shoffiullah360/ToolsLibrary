  <!-- [11] High-Intent FAQ Accordion (5-6 targeted People-Also-Ask queries) -->
  <section class="border-t border-slate-200/90 dark:border-slate-800 bg-slate-50/50 dark:bg-slate-900/40 py-16 sm:py-24">
    <div class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8">
      
      <div class="text-center mb-12">
        <h2 class="text-2xl sm:text-3xl font-bold tracking-tight text-slate-900 dark:text-white">
          Frequently Asked Questions
        </h2>
        <p class="mt-2 text-sm sm:text-base text-slate-600 dark:text-slate-400">
          Targeted answers for {preset.h1}.
        </p>
      </div>

      <!-- Semantic FAQ List -->
      <div class="space-y-4">
        {preset.faqs.map((faq) => (
          <details class="group rounded-2xl border border-slate-300 dark:border-slate-800 bg-white dark:bg-slate-900 p-5 transition-all duration-150 shadow-sm hover:shadow-md hover:border-emerald-500 open:shadow-md">
            <summary class="flex items-center justify-between font-semibold text-sm sm:text-base text-slate-900 dark:text-white cursor-pointer list-none select-none">
