        <a
          href="/remove-line-breaks/"
          class="inline-flex items-center gap-2 px-4 py-2 rounded-xl border border-emerald-500/40 bg-emerald-50/20 dark:bg-emerald-950/30 text-xs font-medium text-emerald-700 dark:text-emerald-300 shadow-sm hover:shadow-md hover:border-emerald-500 transition-all duration-150"
        >
          <ToolIcon name="wrap-text" class="w-4 h-4 text-emerald-500" />
          <span>Main Remove Line Breaks Tool</span>
        </a>
      </div>
    </div>
  </section>
</div>

<!-- Client-Side Interactive Script -->
<script is:inline define:vars={{ initialSample: preset.sampleInput, defaultReplaceWith: preset.config.replaceWith, defaultCustomDelimiter: preset.config.customDelimiter || '', defaultPreserveParagraphs: preset.config.preserveParagraphs, defaultTrimLines: preset.config.trimLines !== false, defaultFixHyphens: preset.config.fixHyphens === true, defaultWrapQuotes: preset.config.wrapQuotes || 'none' }}>
  (function () {
    const inputText = document.getElementById('preset-input-text');
    const outputText = document.getElementById('preset-output-text');
    const radioModes = document.querySelectorAll('input[name="preset-replace-mode"]');
    const customDelimiterInput = document.getElementById('preset-custom-delimiter');
    const customRadio = document.getElementById('preset-mode-custom-radio');
    const optPreserveParagraphs = document.getElementById('preset-opt-preserve-paragraphs');
    const optTrimLines = document.getElementById('preset-opt-trim-lines');
    const optFixHyphens = document.getElementById('preset-opt-fix-hyphens');
    const optWrapQuotes = document.getElementById('preset-opt-wrap-quotes');

    const btnStrip = document.getElementById('preset-btn-strip');
    const btnSample = document.getElementById('preset-btn-sample');
    const btnPaste = document.getElementById('preset-btn-paste');
    const btnClear = document.getElementById('preset-btn-clear');
    const btnCopy = document.getElementById('preset-btn-copy');
    const btnDownload = document.getElementById('preset-btn-download');

    const copyBtnText = document.getElementById('preset-copy-btn-text');
    const copyIconIdle = document.getElementById('preset-copy-icon-idle');
    const copyIconSuccess = document.getElementById('preset-copy-icon-success');

    const statInputChars = document.getElementById('preset-stat-input-chars');
    const statInputWords = document.getElementById('preset-stat-input-words');
    const statInputLines = document.getElementById('preset-stat-input-lines');

    const statOutputChars = document.getElementById('preset-stat-output-chars');
    const statOutputLines = document.getElementById('preset-stat-output-lines');
    const statOutputWords = document.getElementById('preset-stat-output-words');
    const statBreaksSaved = document.getElementById('preset-stat-breaks-saved');
    const statReductionPct = document.getElementById('preset-stat-reduction-pct');
    const statusBreaksRemoved = document.getElementById('preset-status-breaks-removed');

    function countWords(str) {
      if (!str) return 0;
      return (str.trim().match(/\S+/g) || []).length;
    }

    function countLines(str) {
      if (!str) return 0;
      return str.split(/\r\n|\r|\n/).length;
    }

    function getSelectedMode() {
      for (const r of radioModes) {
        if (r.checked) return r.value;
      }
      return 'space';
    }

    function getDelimiter() {
      const mode = getSelectedMode();
      if (mode === 'comma') return ', ';
      if (mode === 'semicolon') return '; ';
      if (mode === 'none') return '';
      if (mode === 'custom') {
        const val = customDelimiterInput ? customDelimiterInput.value : '';
        if (val === '\\n') return '\n';
        if (val === '\\r\\n') return '\r\n';
        return val;
      }
      return ' ';
    }

    function processLinesBlock(lines, trimLines, fixHyphens, wrapQuotes, delimiter) {
      // Step B: Trim line whitespace
      let processed = lines.map(function (line) {
        return trimLines ? line.trim() : line;
      });

      // Filter empty lines in this chunk
      processed = processed.filter(function (line) {
        return line.length > 0;
      });

      // Step C: Auto-fix hyphenated PDF breaks
      if (fixHyphens) {
        const rejoined = [];
        for (let i = 0; i < processed.length; i++) {
          let current = processed[i];
          while (i < processed.length - 1 && /(\w+)-\s*$/.test(current)) {
            const next = processed[i + 1];
            current = current.replace(/-\s*$/, '') + next;
            i++;
          }
          rejoined.push(current);
        }
        processed = rejoined;
      }

      // Step D: Wrap in quotes
      if (wrapQuotes === 'single') {
        processed = processed.map(function (line) {
          return line.length > 0 ? "'" + line + "'" : line;
        });
      } else if (wrapQuotes === 'double') {
        processed = processed.map(function (line) {
          return line.length > 0 ? '"' + line + '"' : line;
        });
      }

      // Step E: Join lines with delimiter
      return processed.join(delimiter);
    }

    function cleanLineBreaks(text) {
      if (!text) {
        return { result: '', breaksRemoved: 0, inputLines: 0, outputLines: 0 };
      }

      const delimiter = getDelimiter();
      const preserveParas = optPreserveParagraphs ? optPreserveParagraphs.checked : false;
      const trimLines = optTrimLines ? optTrimLines.checked : true;
      const fixHyphens = optFixHyphens ? optFixHyphens.checked : false;
      const wrapQuotes = optWrapQuotes ? optWrapQuotes.value : 'none';

      // Count initial breaks
      const totalInitialBreaks = (text.match(/\r\n|\r|\n/g) || []).length;
      const inputLineCount = totalInitialBreaks + 1;

      let result = '';

      if (preserveParas) {
        // Step E: Preserve paragraph breaks (\n\n logic)
        const paragraphs = text.split(/(?:\r?\n\s*){2,}/);
        const cleanedParagraphs = paragraphs
          .map(function (para) {
            // Step A: Split text into lines
            const lines = para.split(/\r\n|\r|\n/);
            return processLinesBlock(lines, trimLines, fixHyphens, wrapQuotes, delimiter);
          })
          .filter(function (p) {
            return p.length > 0;
          });
        result = cleanedParagraphs.join('\n\n');
      } else {
        // Step A: Split text into lines
        const lines = text.split(/\r\n|\r|\n/);
        result = processLinesBlock(lines, trimLines, fixHyphens, wrapQuotes, delimiter);
      }

      const resultBreaks = (result.match(/\r\n|\r|\n/g) || []).length;
      const breaksRemoved = Math.max(0, totalInitialBreaks - resultBreaks);
      const outputLineCount = result ? resultBreaks + 1 : 0;

      return {
        result: result,
        breaksRemoved: breaksRemoved,
        inputLines: inputLineCount,
        outputLines: outputLineCount
      };
    }

    function updateStats() {
      const inputVal = inputText ? inputText.value : '';
      const inChars = inputVal.length;
      const inWords = countWords(inputVal);
      const inLines = inputVal ? countLines(inputVal) : 0;

      if (statInputChars) statInputChars.textContent = inChars.toLocaleString();
      if (statInputWords) statInputWords.textContent = inWords.toLocaleString();
      if (statInputLines) statInputLines.textContent = inLines.toLocaleString();

      if (!inputVal) {
        if (outputText) outputText.value = '';
        if (statOutputChars) statOutputChars.textContent = '0';
        if (statOutputWords) statOutputWords.textContent = '0';
        if (statOutputLines) statOutputLines.textContent = '0';
        if (statBreaksSaved) statBreaksSaved.textContent = '0';
        if (statReductionPct) statReductionPct.textContent = '(0% Saved)';
        if (statusBreaksRemoved) statusBreaksRemoved.textContent = '0 breaks removed';
        return;
      }

      const res = cleanLineBreaks(inputVal);
      if (outputText) outputText.value = res.result;

      // Step F: Update real-time counter metrics accurately
      const outChars = res.result.length;
      const outWords = countWords(res.result);
      const outLines = res.outputLines;

      if (statOutputChars) statOutputChars.textContent = outChars.toLocaleString();
      if (statOutputWords) statOutputWords.textContent = outWords.toLocaleString();
      if (statOutputLines) statOutputLines.textContent = outLines.toLocaleString();

      const saved = res.breaksRemoved;
      const savedPct = inLines > 1 ? Math.max(0, Math.round((saved / (inLines - 1)) * 100)) : 0;

      if (statBreaksSaved) statBreaksSaved.textContent = saved.toLocaleString();
      if (statReductionPct) statReductionPct.textContent = '(' + savedPct + '% Saved)';
      if (statusBreaksRemoved) {
        statusBreaksRemoved.textContent = saved + (saved === 1 ? ' break removed' : ' breaks removed');
      }
    }

    // Event listeners
    if (inputText) {
      inputText.addEventListener('input', updateStats);
    }

    radioModes.forEach(function (r) {
      r.addEventListener('change', updateStats);
    });

    if (customDelimiterInput) {
      customDelimiterInput.addEventListener('input', function () {
        if (customRadio) customRadio.checked = true;
        updateStats();
      });
      customDelimiterInput.addEventListener('focus', function () {
        if (customRadio) customRadio.checked = true;
        updateStats();
      });
    }

    if (optPreserveParagraphs) {
      optPreserveParagraphs.addEventListener('change', updateStats);
    }

    if (optTrimLines) {
      optTrimLines.addEventListener('change', updateStats);
    }

    if (optFixHyphens) {
      optFixHyphens.addEventListener('change', updateStats);
    }

    if (optWrapQuotes) {
      optWrapQuotes.addEventListener('change', updateStats);
    }

    if (btnStrip) {
      btnStrip.addEventListener('click', updateStats);
    }

    if (btnSample) {
      btnSample.addEventListener('click', function () {
        if (inputText) {
          inputText.value = initialSample || '';
          radioModes.forEach(function (r) {
            r.checked = r.value === defaultReplaceWith;
          });
          if (customDelimiterInput) {
            customDelimiterInput.value = defaultCustomDelimiter;
          }
          if (optPreserveParagraphs) {
            optPreserveParagraphs.checked = defaultPreserveParagraphs;
          }
          if (optTrimLines) {
            optTrimLines.checked = defaultTrimLines;
          }
          if (optFixHyphens) {
            optFixHyphens.checked = defaultFixHyphens;
          }
          if (optWrapQuotes) {
            optWrapQuotes.value = defaultWrapQuotes;
          }
          updateStats();
        }
      });
    }

    if (btnPaste) {
      btnPaste.addEventListener('click', async function () {
        try {
          const clipText = await navigator.clipboard.readText();
          if (inputText) {
            inputText.value = clipText;
            updateStats();
          }
        } catch (err) {
          if (inputText) {
            inputText.focus();
          }
        }
      });
    }

    if (btnClear) {
      btnClear.addEventListener('click', function () {
        if (inputText) inputText.value = '';
        if (outputText) outputText.value = '';
        updateStats();
      });
    }

    if (btnCopy) {
      btnCopy.addEventListener('click', async function () {
        if (!outputText || !outputText.value) return;
        try {
          await navigator.clipboard.writeText(outputText.value);
          if (copyBtnText) copyBtnText.textContent = 'Copied!';
          if (copyIconIdle) copyIconIdle.classList.add('hidden');
          if (copyIconSuccess) copyIconSuccess.classList.remove('hidden');

          setTimeout(function () {
            if (copyBtnText) copyBtnText.textContent = 'Copy';
            if (copyIconIdle) copyIconIdle.classList.remove('hidden');
            if (copyIconSuccess) copyIconSuccess.classList.add('hidden');
          }, 2000);
        } catch (err) {
          outputText.select();
          document.execCommand('copy');
        }
      });
    }

    if (btnDownload) {
      btnDownload.addEventListener('click', function () {
        if (!outputText || !outputText.value) return;
        const blob = new Blob([outputText.value], { type: 'text/plain;charset=utf-8' });
        const url = URL.createObjectURL(blob);
        const a = document.createElement('a');
        a.href = url;
        a.download = 'cleaned-text.txt';
        document.body.appendChild(a);
        a.click();
        document.body.removeChild(a);
        URL.revokeObjectURL(url);
      });
    }

    // Initialize metrics on page load
    updateStats();
  })();
</script>
