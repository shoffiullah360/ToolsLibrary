  <section class="border-t border-slate-200/90 dark:border-slate-800 bg-white dark:bg-slate-950 py-12 sm:py-16">
    <div class="max-w-5xl mx-auto px-4 sm:px-6 lg:px-8 text-center">
      <h3 class="text-lg font-semibold text-slate-900 dark:text-white mb-6">
        Explore Related Text &amp; Formatting Tools
      </h3>
      <div class="flex flex-wrap justify-center gap-3">
        <a
          href="/remove-empty-lines/"
          class="inline-flex items-center gap-2 px-4 py-2 rounded-xl border border-slate-300 dark:border-slate-800 bg-white dark:bg-slate-900 text-xs font-medium text-slate-700 dark:text-slate-300 shadow-sm hover:shadow-md hover:border-emerald-500 dark:hover:border-emerald-500 transition-all duration-150"
        >
