        <a
          href="/tools/find-and-replace-text/"
          class="inline-flex items-center gap-2 px-4 py-2 rounded-xl border border-slate-300 dark:border-slate-800 bg-white dark:bg-slate-900 text-xs font-medium text-slate-700 dark:text-slate-300 shadow-sm hover:shadow-md hover:border-emerald-500 dark:hover:border-emerald-500 transition-all duration-150"
        >
          <ToolIcon name="replace" class="w-4 h-4 text-emerald-500" />
          <span>Find &amp; Replace Text</span>
