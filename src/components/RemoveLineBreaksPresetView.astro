---
// src/components/RemoveLineBreaksPresetView.astro
import ToolIcon from './ToolIcon.astro';
import PopularRemoveLineBreaks from './PopularRemoveLineBreaks.astro';
import type { RemoveLineBreaksPreset } from '../data/removeLineBreaksPresets';

interface Props {
  preset: RemoveLineBreaksPreset;
}

const { preset } = Astro.props;
---

<div class="bg-slate-50 text-slate-900 dark:bg-slate-950 dark:text-slate-100 min-h-screen">
  <!-- 1. Hero Header Section -->
  <section class="relative pt-10 pb-6 sm:pt-14 sm:pb-8 overflow-hidden">
    <div class="hero-mesh-bg" aria-hidden="true"></div>

    <div class="relative max-w-5xl mx-auto px-4 sm:px-6 lg:px-8 text-center">
      <!-- [1] Breadcrumbs: Home > Text & Formatting > Remove Line Breaks > [Preset Name] -->
      <nav aria-label="Breadcrumb" class="mb-5 flex justify-center">
        <ol class="inline-flex items-center space-x-1.5 md:space-x-2 text-xs font-medium text-slate-500 dark:text-slate-400">
          <li class="inline-flex items-center">
            <a href="/" class="hover:text-emerald-600 dark:hover:text-emerald-400 transition-colors">Home</a>
          </li>
          <li>
            <div class="flex items-center">
              <svg class="w-3 h-3 text-slate-400 mx-1" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7" />
              </svg>
              <a href="/#text-tools-section" class="hover:text-emerald-600 dark:hover:text-emerald-400 transition-colors">Text &amp; Formatting</a>
            </div>
          </li>
          <li>
            <div class="flex items-center">
              <svg class="w-3 h-3 text-slate-400 mx-1" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7" />
              </svg>
              <a href="/remove-line-breaks/" class="hover:text-emerald-600 dark:hover:text-emerald-400 transition-colors">Remove Line Breaks</a>
            </div>
          </li>
          <li aria-current="page">
            <div class="flex items-center">
              <svg class="w-3 h-3 text-slate-400 mx-1" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7" />
              </svg>
              <span class="text-slate-900 dark:text-white font-semibold truncate max-w-[200px] sm:max-w-none">{preset.name || preset.h1}</span>
            </div>
          </li>
        </ol>
      </nav>

      <!-- [2] Hero Section: Front-loaded Target Keyword H1 + Search Intent Subtitle -->
      <h1 class="text-3xl sm:text-4xl md:text-5xl font-bold tracking-tight text-slate-900 dark:text-white leading-tight">
        {preset.h1}
      </h1>

      <p class="mt-3 sm:mt-4 text-base sm:text-lg text-slate-600 dark:text-slate-400 max-w-2xl mx-auto leading-relaxed">
        {preset.heroSubtitle}
      </p>
    </div>
  </section>

  <!-- [3] Interactive Tool Workspace -->
  <section class="max-w-6xl mx-auto px-4 sm:px-6 lg:px-8 pb-10">
    <!-- Emerald Options Toolbar -->
    <div class="bg-slate-900/60 border border-slate-800/80 rounded-xl p-3 sm:p-4 mb-4 flex flex-col gap-3 shadow-xs">
      
      <!-- Top Row: Radio Replacement Modes & Action buttons -->
      <div class="flex flex-wrap items-center justify-between gap-3">
        <div class="flex flex-wrap items-center gap-x-5 gap-y-2.5">
          <span class="text-xs font-semibold text-slate-400 uppercase tracking-wider">
            Replace With:
          </span>

          <label class="inline-flex items-center gap-1.5 cursor-pointer text-xs sm:text-sm font-medium text-slate-300 hover:text-white transition-colors select-none">
            <input
              type="radio"
              name="preset-replace-mode"
              value="space"
              checked={preset.config.replaceWith === 'space'}
              class="w-4 h-4 text-emerald-500 focus:ring-emerald-500/30 dark:bg-slate-800 border-slate-700 cursor-pointer accent-emerald-500"
            />
            <span>Space</span>
          </label>

          <label class="inline-flex items-center gap-1.5 cursor-pointer text-xs sm:text-sm font-medium text-slate-300 hover:text-white transition-colors select-none">
            <input
              type="radio"
              name="preset-replace-mode"
              value="comma"
              checked={preset.config.replaceWith === 'comma'}
              class="w-4 h-4 text-emerald-500 focus:ring-emerald-500/30 dark:bg-slate-800 border-slate-700 cursor-pointer accent-emerald-500"
            />
            <span>Comma (,)</span>
          </label>

          <label class="inline-flex items-center gap-1.5 cursor-pointer text-xs sm:text-sm font-medium text-slate-300 hover:text-white transition-colors select-none">
            <input
              type="radio"
              name="preset-replace-mode"
              value="semicolon"
              checked={preset.config.replaceWith === 'semicolon'}
              class="w-4 h-4 text-emerald-500 focus:ring-emerald-500/30 dark:bg-slate-800 border-slate-700 cursor-pointer accent-emerald-500"
            />
            <span>Semicolon (;)</span>
          </label>

          <label class="inline-flex items-center gap-1.5 cursor-pointer text-xs sm:text-sm font-medium text-slate-300 hover:text-white transition-colors select-none">
            <input
              type="radio"
              name="preset-replace-mode"
              value="none"
              checked={preset.config.replaceWith === 'none'}
              class="w-4 h-4 text-emerald-500 focus:ring-emerald-500/30 dark:bg-slate-800 border-slate-700 cursor-pointer accent-emerald-500"
            />
            <span>No space</span>
          </label>

          <label class="inline-flex items-center gap-1.5 cursor-pointer text-xs sm:text-sm font-medium text-slate-300 hover:text-white transition-colors select-none">
            <input
              type="radio"
              name="preset-replace-mode"
              value="custom"
              checked={preset.config.replaceWith === 'custom'}
              id="preset-mode-custom-radio"
              class="w-4 h-4 text-emerald-500 focus:ring-emerald-500/30 dark:bg-slate-800 border-slate-700 cursor-pointer accent-emerald-500"
            />
            <span>Custom:</span>
          </label>

          <input
            type="text"
            id="preset-custom-delimiter"
            value={preset.config.customDelimiter || ''}
            placeholder="e.g. ; or | "
            class="w-24 px-2 py-1 text-xs font-mono rounded-lg border border-slate-700 bg-slate-800 text-slate-200 focus:outline-none focus:ring-2 focus:ring-emerald-500/30 focus:border-emerald-500 transition"
          />
        </div>

        <!-- Action Buttons -->
        <div class="flex items-center gap-2.5 shrink-0">
          <button
            type="button"
            id="preset-btn-sample"
            class="bg-slate-800 hover:bg-slate-700 text-slate-300 text-xs px-3 py-2 rounded-lg font-medium transition cursor-pointer"
          >
            Load Sample
          </button>
          <button
            type="button"
            id="preset-btn-strip"
            class="bg-emerald-600 hover:bg-emerald-500 active:bg-emerald-700 text-white shadow-sm shadow-emerald-900/20 font-medium px-4 py-2 rounded-lg text-xs sm:text-sm transition flex items-center gap-2 cursor-pointer"
          >
            <ToolIcon name="wrap-text" class="w-4 h-4" />
            <span>Remove Line Breaks</span>
          </button>
        </div>
      </div>

      <!-- Bottom Row: Secondary Controls (Checkboxes & Quote Wrap) -->
      <div class="pt-2.5 border-t border-slate-800/80 flex flex-wrap items-center justify-between gap-3 sm:gap-4">
        <div class="flex flex-wrap items-center gap-x-5 gap-y-2">
          <!-- Preserve paragraph breaks -->
          <label class="inline-flex items-center gap-2 cursor-pointer text-xs sm:text-sm font-medium text-slate-300 hover:text-white transition-colors select-none">
            <input
              type="checkbox"
              id="preset-opt-preserve-paragraphs"
              checked={preset.config.preserveParagraphs}
              class="w-4 h-4 rounded border-slate-700 bg-slate-800 text-emerald-500 focus:ring-emerald-500/30 focus:ring-2 cursor-pointer accent-emerald-500"
            />
            <span>Preserve paragraph breaks</span>
          </label>

          <!-- Trim line whitespace (Default: TRUE) -->
          <label class="inline-flex items-center gap-2 cursor-pointer text-xs sm:text-sm font-medium text-slate-300 hover:text-white transition-colors select-none">
            <input
              type="checkbox"
              id="preset-opt-trim-lines"
              checked={preset.config.trimLines !== false}
              class="w-4 h-4 rounded border-slate-700 bg-slate-800 text-emerald-500 focus:ring-emerald-500/30 focus:ring-2 cursor-pointer accent-emerald-500"
            />
            <span>Trim line whitespace</span>
          </label>

          <!-- Auto-fix hyphenated PDF breaks (Default: FALSE) -->
          <label class="inline-flex items-center gap-2 cursor-pointer text-xs sm:text-sm font-medium text-slate-300 hover:text-white transition-colors select-none">
            <input
              type="checkbox"
              id="preset-opt-fix-hyphens"
              checked={preset.config.fixHyphens === true}
              class="w-4 h-4 rounded border-slate-700 bg-slate-800 text-emerald-500 focus:ring-emerald-500/30 focus:ring-2 cursor-pointer accent-emerald-500"
            />
            <span>Auto-fix hyphenated PDF breaks</span>
          </label>
        </div>

        <!-- Wrap in quotes -->
        <div class="inline-flex items-center gap-2">
          <span class="text-xs font-semibold text-slate-400 uppercase tracking-wider">
            Wrap in quotes:
          </span>
          <select
            id="preset-opt-wrap-quotes"
            class="px-2.5 py-1 text-xs font-medium rounded-lg border border-slate-700 bg-slate-800 text-slate-200 focus:outline-none focus:ring-2 focus:ring-emerald-500/30 focus:border-emerald-500 transition cursor-pointer"
          >
            <option value="none" selected={!preset.config.wrapQuotes || preset.config.wrapQuotes === 'none'}>None</option>
            <option value="single" selected={preset.config.wrapQuotes === 'single'}>Single ('')</option>
            <option value="double" selected={preset.config.wrapQuotes === 'double'}>Double ("")</option>
          </select>
        </div>
      </div>
    </div>

    <!-- Dual Textarea Studio Box -->
    <div class="rounded-2xl border border-slate-800/80 bg-slate-900/60 shadow-sm overflow-hidden">
      <div class="grid grid-cols-1 lg:grid-cols-2 divide-y lg:divide-y-0 lg:divide-x divide-slate-800/80">
        
        <!-- Left: Input Area -->
        <div class="p-4 sm:p-5 flex flex-col space-y-3 bg-slate-900/40">
          <div class="flex items-center justify-between">
            <span class="text-xs font-semibold uppercase tracking-wider text-slate-400">
              Input Text
            </span>
            
            <div class="flex items-center gap-2">
              <button
                type="button"
                id="preset-btn-paste"
                class="px-2.5 py-1 text-xs font-medium rounded-lg border border-slate-700/80 bg-slate-800/70 hover:bg-slate-700 text-slate-300 hover:text-white transition-colors flex items-center gap-1.5 cursor-pointer shadow-xs"
                title="Paste from clipboard"
              >
                <svg class="w-3.5 h-3.5 text-slate-400" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                  <path stroke-linecap="round" stroke-linejoin="round" d="M9 5H7a2 2 0 00-2 2v12a2 2 0 002 2h10a2 2 0 002-2V7a2 2 0 00-2-2h-2M9 5a2 2 0 002 2h2a2 2 0 002-2M9 5a2 2 0 012-2h2a2 2 0 012 2" />
                </svg>
                <span>Paste</span>
              </button>
              <button
                type="button"
                id="preset-btn-clear"
                class="px-2.5 py-1 text-xs font-medium rounded-lg border border-slate-700/80 bg-slate-800/70 hover:bg-rose-950/40 hover:border-rose-800/60 text-slate-300 hover:text-rose-400 transition-colors flex items-center gap-1.5 cursor-pointer shadow-xs"
                title="Clear input text"
              >
                <svg class="w-3.5 h-3.5 text-slate-400" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                  <path stroke-linecap="round" stroke-linejoin="round" d="M19 7l-.867 12.142A2 2 0 0116.138 21H7.862a2 2 0 01-1.995-1.858L5 7m5 4v6m4-6v6m1-10V4a1 1 0 00-1-1h-4a1 1 0 00-1 1v3M4 7h16" />
                </svg>
                <span>Clear</span>
              </button>
            </div>
          </div>

          <textarea
            id="preset-input-text"
            rows="14"
            placeholder="Paste or type your text here, or click 'Load Sample' to test..."
            class="w-full p-4 rounded-xl border border-slate-800/80 bg-slate-950/70 font-sans text-slate-200 text-sm sm:text-base leading-relaxed tracking-normal placeholder:text-slate-500 focus:outline-none focus:ring-2 focus:ring-emerald-500/30 focus:border-emerald-500 transition resize-y min-h-[340px]"
            spellcheck="false"
          ></textarea>

          <!-- Input Live Footer Strip -->
          <div class="pt-2 px-1 flex items-center justify-between text-xs text-slate-400 font-sans">
            <div class="flex items-center gap-1.5 sm:gap-2">
              <span><strong id="preset-stat-input-lines" class="font-medium text-slate-200">0</strong> Lines</span>
              <span class="text-slate-600">·</span>
              <span><strong id="preset-stat-input-chars" class="font-medium text-slate-200">0</strong> Chars</span>
              <span class="text-slate-600">·</span>
              <span><strong id="preset-stat-input-words" class="font-medium text-slate-200">0</strong> Words</span>
            </div>
          </div>
        </div>

        <!-- Right: Output Area -->
        <div class="p-4 sm:p-5 flex flex-col space-y-3 bg-slate-900/40">
          <div class="flex items-center justify-between">
            <div class="flex items-center gap-2 sm:gap-2.5">
              <span class="text-xs font-semibold uppercase tracking-wider text-slate-400">
                Cleaned Result
              </span>
              <span
                id="preset-status-breaks-removed"
                class="bg-emerald-500/10 text-emerald-400 border border-emerald-500/20 text-xs px-2 py-0.5 rounded-full font-medium"
              >
                0 breaks removed
              </span>
            </div>

            <div class="flex items-center gap-2">
              <button
                type="button"
                id="preset-btn-copy"
                class="px-3 py-1 text-xs font-semibold rounded-lg bg-slate-800 hover:bg-slate-700 text-slate-200 border border-slate-700/60 transition-colors flex items-center gap-1.5 cursor-pointer shadow-xs"
                title="Copy cleaned text to clipboard"
              >
                <svg id="preset-copy-icon-idle" class="w-3.5 h-3.5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                  <rect x="9" y="9" width="13" height="13" rx="2" ry="2"></rect>
                  <path d="M5 15H4a2 2 0 01-2-2V4a2 2 0 012-2h9a2 2 0 012 2v1"></path>
                </svg>
                <svg id="preset-copy-icon-success" class="w-3.5 h-3.5 hidden text-emerald-300" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                  <polyline points="20 6 9 17 4 12"></polyline>
                </svg>
                <span id="preset-copy-btn-text">Copy</span>
              </button>

              <button
                type="button"
                id="preset-btn-download"
                class="px-2.5 py-1 text-xs font-medium rounded-lg border border-slate-700/80 bg-slate-800/70 hover:bg-slate-700 text-slate-300 hover:text-white transition-colors flex items-center gap-1.5 cursor-pointer shadow-xs"
                title="Download cleaned text as .txt file"
              >
                <svg class="w-3.5 h-3.5 text-slate-400" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                  <path stroke-linecap="round" stroke-linejoin="round" d="M4 16v1a3 3 0 003 3h10a3 3 0 003-3v-1m-4-4l-4 4m0 0l-4-4m4 4V4" />
                </svg>
                <span>Download .txt</span>
              </button>
            </div>
          </div>

          <textarea
            id="preset-output-text"
            rows="14"
            placeholder="Your joined, single-line text without line breaks will appear here..."
            class="w-full p-4 rounded-xl border border-slate-800/80 bg-slate-950/70 font-sans text-slate-200 text-sm sm:text-base leading-relaxed tracking-normal placeholder:text-slate-500 focus:outline-none focus:ring-2 focus:ring-emerald-500/30 focus:border-emerald-500 transition resize-y min-h-[340px]"
            spellcheck="false"
          ></textarea>

          <!-- Output Live Footer Strip -->
          <div class="pt-2 px-1 flex items-center justify-between text-xs text-slate-400 font-sans">
            <div class="flex items-center gap-1.5 sm:gap-2">
              <span><strong id="preset-stat-output-lines" class="font-medium text-slate-200">0</strong> Lines</span>
              <span class="text-slate-600">·</span>
              <span><strong id="preset-stat-output-chars" class="font-medium text-slate-200">0</strong> Chars</span>
              <span class="text-slate-600">·</span>
              <span><strong id="preset-stat-output-words" class="font-medium text-slate-200">0</strong> Words</span>
            </div>
            <div class="text-emerald-400 font-medium text-xs flex items-center gap-1">
              <span>Removed:</span>
              <span id="preset-stat-breaks-saved">0</span>
              <span>Breaks</span>
              <span id="preset-stat-reduction-pct">(0% Saved)</span>
            </div>
          </div>
        </div>

      </div>
    </div>
  </section>

  <!-- [4] Intent Highlight Card: 50-70 word practical summary immediately below workspace -->
  <section class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8 pb-12">
    <div class="bg-white dark:bg-slate-900/60 border border-slate-200 dark:border-slate-800 rounded-xl p-5 md:p-6 text-slate-700 dark:text-slate-300 text-sm md:text-base leading-relaxed shadow-sm">
      <p>{preset.intentDescription}</p>
    </div>
  </section>

  <!-- [5] 3-Step "How to Use" Guide: Step 1 (Paste/Upload) -> Step 2 (Choose Delimiter/Mode) -> Step 3 (Export/Copy) -->
  <section class="border-t border-slate-200/90 dark:border-slate-800 bg-slate-50/50 dark:bg-slate-900/40 py-16 sm:py-20">
    <div class="max-w-5xl mx-auto px-4 sm:px-6 lg:px-8">
      
      <div class="text-center max-w-2xl mx-auto mb-12">
        <h2 class="text-2xl sm:text-3xl font-bold tracking-tight text-slate-900 dark:text-white">
          How to Remove Line Breaks in 3 Simple Steps
        </h2>
        <p class="mt-2 text-sm sm:text-base text-slate-600 dark:text-slate-400">
          Clean messy gaps, strip hidden carriage returns, and join lines in seconds.
        </p>
      </div>

      <div class="grid grid-cols-1 md:grid-cols-3 gap-6 sm:gap-8">
        <!-- Step 1 -->
        <div class="p-6 rounded-2xl border border-slate-300 dark:border-slate-800 bg-white dark:bg-slate-900 shadow-sm hover:shadow-md hover:border-emerald-500 transition-all duration-150">
          <div class="w-10 h-10 rounded-xl bg-emerald-50 dark:bg-emerald-950/40 text-emerald-600 dark:text-emerald-400 flex items-center justify-center font-bold font-mono text-sm mb-4 border border-emerald-100 dark:border-emerald-900/50">
            01
          </div>
          <h3 class="text-base font-semibold text-slate-900 dark:text-white mb-2">
            Paste or Load Text
          </h3>
          <p class="text-sm text-slate-600 dark:text-slate-400 leading-relaxed">
            Copy text from your document, PDF, code file, or spreadsheet and paste it into the input box using <kbd class="px-1.5 py-0.5 text-xs font-mono bg-slate-100 dark:bg-slate-800 rounded border border-slate-200 dark:border-slate-700">Ctrl+V</kbd> or click <strong>Load Sample</strong>.
          </p>
        </div>

        <!-- Step 2 -->
        <div class="p-6 rounded-2xl border border-slate-300 dark:border-slate-800 bg-white dark:bg-slate-900 shadow-sm hover:shadow-md hover:border-emerald-500 transition-all duration-150">
          <div class="w-10 h-10 rounded-xl bg-emerald-50 dark:bg-emerald-950/40 text-emerald-600 dark:text-emerald-400 flex items-center justify-center font-bold font-mono text-sm mb-4 border border-emerald-100 dark:border-emerald-900/50">
            02
          </div>
          <h3 class="text-base font-semibold text-slate-900 dark:text-white mb-2">
            Select Delimiter or Paragraph Rule
          </h3>
          <p class="text-sm text-slate-600 dark:text-slate-400 leading-relaxed">
            Choose whether to replace breaks with spaces, commas, no space, or custom symbols. Enable paragraph preservation to maintain section gaps.
          </p>
        </div>

        <!-- Step 3 -->
        <div class="p-6 rounded-2xl border border-slate-300 dark:border-slate-800 bg-white dark:bg-slate-900 shadow-sm hover:shadow-md hover:border-emerald-500 transition-all duration-150">
          <div class="w-10 h-10 rounded-xl bg-emerald-50 dark:bg-emerald-950/40 text-emerald-600 dark:text-emerald-400 flex items-center justify-center font-bold font-mono text-sm mb-4 border border-emerald-100 dark:border-emerald-900/50">
            03
          </div>
          <h3 class="text-base font-semibold text-slate-900 dark:text-white mb-2">
            Copy or Download Result
          </h3>
          <p class="text-sm text-slate-600 dark:text-slate-400 leading-relaxed">
            Review live line and break reductions, then click <strong>Copy</strong> to copy to your clipboard or download as a clean <strong>.txt</strong> file with one click.
          </p>
        </div>
      </div>

    </div>
  </section>

  <!-- [6] 6-Card Feature Grid: Zero latency, Client-Side, Preserves formatting, etc. -->
  <section class="border-t border-slate-200/90 dark:border-slate-800 bg-white dark:bg-slate-950 py-16 sm:py-20">
    <div class="max-w-6xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="text-center max-w-2xl mx-auto mb-12">
        <h2 class="text-2xl sm:text-3xl font-bold tracking-tight text-slate-900 dark:text-white">
          Why Choose FastToolVerse
        </h2>
        <p class="mt-2 text-sm sm:text-base text-slate-600 dark:text-slate-400">
          Engineered for developer precision, zero latency, and uncompromising client-side privacy.
        </p>
      </div>

      <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-5">
        <!-- Card 1 -->
        <div class="p-6 rounded-2xl border border-slate-200 dark:border-slate-800 bg-slate-50/50 dark:bg-slate-900/40">
          <div class="w-10 h-10 rounded-xl bg-emerald-50 dark:bg-emerald-950/50 text-emerald-600 dark:text-emerald-400 flex items-center justify-center mb-4 border border-emerald-100 dark:border-emerald-900/50">
            <ToolIcon name="shield-check" class="w-5 h-5" />
          </div>
          <h3 class="text-base font-semibold text-slate-900 dark:text-white mb-2">
            100% Client-Side Privacy
          </h3>
          <p class="text-xs sm:text-sm text-slate-600 dark:text-slate-400 leading-relaxed">
            All regex replacements and line merges execute strictly inside your local browser memory sandbox. Zero bytes are ever sent to any remote server.
          </p>
        </div>

        <!-- Card 2 -->
        <div class="p-6 rounded-2xl border border-slate-200 dark:border-slate-800 bg-slate-50/50 dark:bg-slate-900/40">
          <div class="w-10 h-10 rounded-xl bg-emerald-50 dark:bg-emerald-950/50 text-emerald-600 dark:text-emerald-400 flex items-center justify-center mb-4 border border-emerald-100 dark:border-emerald-900/50">
