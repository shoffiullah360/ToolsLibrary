---
import type { Tool } from '../data/tools';
import ToolIcon from './ToolIcon.astro';

interface Props {
  tool: Tool;
}

const { tool } = Astro.props;
---

<a
  href={tool.href}
  class="tool-card group relative flex flex-col p-6 rounded-2xl border border-slate-300 dark:border-slate-800 bg-white dark:bg-slate-800/80 shadow-sm hover:shadow-md hover:border-blue-600 dark:hover:border-blue-500 hover:bg-slate-50/50 dark:hover:bg-slate-800 transition-all duration-150 hover:-translate-y-0.5 overflow-hidden"
  data-tool-card
  data-tool-id={tool.id}
  data-category={tool.category.toLowerCase()}
  data-group={tool.group.toLowerCase()}
  data-title={tool.title.toLowerCase()}
  data-keywords={tool.keywords.join(' ').toLowerCase()}
  data-tags={tool.tags.join(' ').toLowerCase()}
  data-badge={tool.badge ? tool.badge.toLowerCase() : ''}
>
  <div class="flex items-center justify-center w-11 h-11 rounded-xl bg-slate-100 dark:bg-slate-700/60 text-slate-800 dark:text-slate-100 group-hover:bg-blue-600 group-hover:text-white dark:group-hover:bg-blue-500 transition-colors duration-200 shrink-0 mb-4">
    <ToolIcon name={tool.icon} class="w-5 h-5" />
  </div>

  <h3 class="text-lg font-semibold text-slate-900 dark:text-slate-100 tracking-tight group-hover:text-blue-600 dark:group-hover:text-blue-400 transition-colors duration-150 mb-2">
    {tool.title}
  </h3>

  <p class="text-sm leading-relaxed text-slate-600 dark:text-slate-400 line-clamp-2">
    {tool.description}
  </p>
</a>
