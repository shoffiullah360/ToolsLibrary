---
import ToolIcon from '../ToolIcon.astro';

interface Props {
  initialText?: string;
  class?: string;
}

const { initialText = "", class: className = "" } = Astro.props;
---

<div class={`rounded-2xl border border-slate-300 dark:border-slate-800 bg-white dark:bg-slate-900 shadow-xl overflow-hidden transition-colors ${className}`}>
  
  <!-- Top Options & Controls Bar -->
  <div class="p-5 sm:p-6 border-b border-slate-200 dark:border-slate-800 bg-slate-50/80 dark:bg-slate-900/90 space-y-4">
    
    <!-- Row 1: Filter & Extraction Mode (Segmented Pill Switcher) & Action Buttons -->
    <div class="flex flex-col xl:flex-row xl:items-center justify-between gap-4">
      <div class="flex flex-col sm:flex-row sm:items-center gap-2.5">
        <span class="text-xs font-semibold text-slate-500 dark:text-slate-400 uppercase tracking-wider font-sans shrink-0">
          Extraction Mode:
        </span>
        <div class="inline-flex p-1 rounded-xl bg-slate-200/70 dark:bg-slate-950/80 border border-slate-300 dark:border-slate-800 gap-1 overflow-x-auto max-w-full">
          <button
            type="button"
            class="mode-pill-btn px-3 py-1.5 text-xs rounded-lg font-medium transition-all cursor-pointer whitespace-nowrap bg-emerald-600 text-white shadow-xs font-semibold"
            data-mode="unique"
          >
            Unique Lines
          </button>
          <button
            type="button"
            class="mode-pill-btn px-3 py-1.5 text-xs rounded-lg font-medium transition-all cursor-pointer whitespace-nowrap text-slate-700 dark:text-slate-300 hover:text-slate-900 dark:hover:text-white hover:bg-slate-300/50 dark:hover:bg-slate-800/60"
            data-mode="duplicates-only"
          >
            Duplicates Only
          </button>
          <button
            type="button"
            class="mode-pill-btn px-3 py-1.5 text-xs rounded-lg font-medium transition-all cursor-pointer whitespace-nowrap text-slate-700 dark:text-slate-300 hover:text-slate-900 dark:hover:text-white hover:bg-slate-300/50 dark:hover:bg-slate-800/60"
            data-mode="completely-unique"
          >
            Completely Unique
          </button>
          <button
            type="button"
            class="mode-pill-btn px-3 py-1.5 text-xs rounded-lg font-medium transition-all cursor-pointer whitespace-nowrap text-slate-700 dark:text-slate-300 hover:text-slate-900 dark:hover:text-white hover:bg-slate-300/50 dark:hover:bg-slate-800/60"
            data-mode="count-occurrences"
          >
            Count Occurrences
          </button>
        </div>
      </div>

      <!-- Action Buttons -->
      <div class="flex items-center gap-2.5 shrink-0 self-start xl:self-auto">
        <button
          type="button"
          id="btn-sample"
          class="px-3.5 py-2 text-xs font-semibold rounded-lg border border-slate-300 dark:border-slate-700 bg-white dark:bg-slate-800/80 text-slate-700 dark:text-slate-300 hover:bg-slate-100 dark:hover:bg-slate-800 hover:text-slate-900 dark:hover:text-white transition-colors cursor-pointer shadow-2xs font-sans"
        >
          Load Sample
        </button>
        <button
          type="button"
          id="btn-dedupe"
          class="px-5 py-2 text-xs sm:text-sm font-semibold rounded-lg bg-emerald-600 hover:bg-emerald-500 text-white shadow-lg shadow-emerald-600/20 active:scale-95 transition-all flex items-center gap-2 cursor-pointer font-sans"
        >
          <ToolIcon name="list-filter" class="w-4 h-4 text-white" />
          <span>Remove Duplicates</span>
        </button>
      </div>
    </div>

    <!-- Row 2: Cleaning & Matching Toggles (Glowing Pill Checkboxes) + Sorting Selector -->
    <div class="pt-3 border-t border-slate-200/80 dark:border-slate-800/80 flex flex-col lg:flex-row lg:items-center justify-between gap-4">
      
      <!-- Toggles Grid/Flex -->
      <div class="flex flex-wrap items-center gap-2 sm:gap-2.5">
        <label class="group inline-flex items-center gap-2 px-3 py-1.5 rounded-lg border border-slate-200 dark:border-slate-800 bg-white/70 dark:bg-slate-950/50 text-slate-700 dark:text-slate-300 hover:border-emerald-500/50 dark:hover:border-emerald-500/50 transition-all cursor-pointer text-xs font-sans select-none has-[:checked]:border-emerald-500/60 has-[:checked]:bg-emerald-50 dark:has-[:checked]:bg-emerald-950/30 has-[:checked]:text-emerald-700 dark:has-[:checked]:text-emerald-300 has-[:checked]:shadow-xs">
          <input
            type="checkbox"
            id="opt-case-sensitive"
            checked
            class="w-3.5 h-3.5 rounded text-emerald-600 focus:ring-emerald-500 dark:bg-slate-800 border-slate-300 dark:border-slate-700 cursor-pointer accent-emerald-600"
          />
          <span class="font-medium">Case-sensitive comparison (<span class="font-mono text-[11px]">Aa ≠ aa</span>)</span>
        </label>

        <label class="group inline-flex items-center gap-2 px-3 py-1.5 rounded-lg border border-slate-200 dark:border-slate-800 bg-white/70 dark:bg-slate-950/50 text-slate-700 dark:text-slate-300 hover:border-emerald-500/50 dark:hover:border-emerald-500/50 transition-all cursor-pointer text-xs font-sans select-none has-[:checked]:border-emerald-500/60 has-[:checked]:bg-emerald-50 dark:has-[:checked]:bg-emerald-950/30 has-[:checked]:text-emerald-700 dark:has-[:checked]:text-emerald-300 has-[:checked]:shadow-xs">
          <input
            type="checkbox"
            id="opt-trim-lines"
            checked
            class="w-3.5 h-3.5 rounded text-emerald-600 focus:ring-emerald-500 dark:bg-slate-800 border-slate-300 dark:border-slate-700 cursor-pointer accent-emerald-600"
          />
          <span class="font-medium">Trim edge whitespace</span>
        </label>

        <label class="group inline-flex items-center gap-2 px-3 py-1.5 rounded-lg border border-slate-200 dark:border-slate-800 bg-white/70 dark:bg-slate-950/50 text-slate-700 dark:text-slate-300 hover:border-emerald-500/50 dark:hover:border-emerald-500/50 transition-all cursor-pointer text-xs font-sans select-none has-[:checked]:border-emerald-500/60 has-[:checked]:bg-emerald-50 dark:has-[:checked]:bg-emerald-950/30 has-[:checked]:text-emerald-700 dark:has-[:checked]:text-emerald-300 has-[:checked]:shadow-xs">
          <input
            type="checkbox"
            id="opt-empty-lines"
            class="w-3.5 h-3.5 rounded text-emerald-600 focus:ring-emerald-500 dark:bg-slate-800 border-slate-300 dark:border-slate-700 cursor-pointer accent-emerald-600"
          />
          <span class="font-medium">Remove empty / blank lines</span>
        </label>

        <label class="group inline-flex items-center gap-2 px-3 py-1.5 rounded-lg border border-slate-200 dark:border-slate-800 bg-white/70 dark:bg-slate-950/50 text-slate-700 dark:text-slate-300 hover:border-emerald-500/50 dark:hover:border-emerald-500/50 transition-all cursor-pointer text-xs font-sans select-none has-[:checked]:border-emerald-500/60 has-[:checked]:bg-emerald-50 dark:has-[:checked]:bg-emerald-950/30 has-[:checked]:text-emerald-700 dark:has-[:checked]:text-emerald-300 has-[:checked]:shadow-xs">
          <input
            type="checkbox"
            id="opt-ignore-punctuation"
            class="w-3.5 h-3.5 rounded text-emerald-600 focus:ring-emerald-500 dark:bg-slate-800 border-slate-300 dark:border-slate-700 cursor-pointer accent-emerald-600"
          />
          <span class="font-medium">Ignore punctuation & symbols</span>
        </label>
      </div>

      <!-- Sorting Selector -->
      <div class="flex items-center gap-2 shrink-0">
        <span class="text-xs font-semibold text-slate-500 dark:text-slate-400 uppercase tracking-wider font-sans">
          Sort:
        </span>
        <select
          id="select-sort"
          class="px-3 py-1.5 text-xs font-medium rounded-lg border border-slate-300 dark:border-slate-700 bg-white dark:bg-slate-800 text-slate-800 dark:text-slate-200 focus:outline-none focus:ring-2 focus:ring-emerald-500/30 focus:border-emerald-500 transition cursor-pointer font-sans"
        >
          <option value="original">Original Order (Input Flow)</option>
          <option value="alpha-asc">Alphabetical (A → Z)</option>
          <option value="alpha-desc">Reverse Alphabetical (Z → A)</option>
          <option value="length-asc">Length (Shortest First)</option>
          <option value="freq-desc">Frequency (Most Repeated First)</option>
        </select>
      </div>
    </div>

    <!-- Row 3: Quick Delimiter Joiner -->
    <div class="pt-3 border-t border-slate-200/80 dark:border-slate-800/80 flex flex-wrap items-center gap-3">
      <span class="text-xs font-semibold text-slate-500 dark:text-slate-400 uppercase tracking-wider font-sans shrink-0">
        Output Delimiter:
      </span>
      
      <div class="flex flex-wrap items-center gap-3 text-xs sm:text-sm font-sans">
        <label class="inline-flex items-center gap-1.5 cursor-pointer text-slate-700 dark:text-slate-300 hover:text-slate-900 dark:hover:text-white transition-colors">
          <input
            type="radio"
            name="delimiter-mode"
            value="newline"
            checked
            class="w-4 h-4 text-emerald-600 focus:ring-emerald-500 dark:bg-slate-800 border-slate-300 dark:border-slate-700 cursor-pointer accent-emerald-600"
          />
          <span class="font-medium">Newline (<span class="font-mono text-[11px]">\n</span>)</span>
        </label>

        <label class="inline-flex items-center gap-1.5 cursor-pointer text-slate-700 dark:text-slate-300 hover:text-slate-900 dark:hover:text-white transition-colors">
          <input
            type="radio"
            name="delimiter-mode"
            value="comma"
            class="w-4 h-4 text-emerald-600 focus:ring-emerald-500 dark:bg-slate-800 border-slate-300 dark:border-slate-700 cursor-pointer accent-emerald-600"
          />
          <span class="font-medium">Comma (<span class="font-mono text-[11px]">, </span>) [CSV]</span>
        </label>

        <label class="inline-flex items-center gap-1.5 cursor-pointer text-slate-700 dark:text-slate-300 hover:text-slate-900 dark:hover:text-white transition-colors">
          <input
            type="radio"
            name="delimiter-mode"
            value="semicolon"
            class="w-4 h-4 text-emerald-600 focus:ring-emerald-500 dark:bg-slate-800 border-slate-300 dark:border-slate-700 cursor-pointer accent-emerald-600"
          />
          <span class="font-medium">Semicolon (<span class="font-mono text-[11px] font-semibold">; </span>)</span>
        </label>

        <div class="inline-flex items-center gap-1.5">
          <label class="inline-flex items-center gap-1.5 cursor-pointer text-slate-700 dark:text-slate-300 hover:text-slate-900 dark:hover:text-white transition-colors">
            <input
              type="radio"
              name="delimiter-mode"
              value="custom"
              id="mode-custom-delimiter-radio"
              class="w-4 h-4 text-emerald-600 focus:ring-emerald-500 dark:bg-slate-800 border-slate-300 dark:border-slate-700 cursor-pointer accent-emerald-600"
            />
            <span class="font-medium">Custom:</span>
          </label>
          <input
            type="text"
            id="input-custom-delimiter"
            placeholder="e.g. | or \t"
            class="w-24 px-2 py-1 text-xs font-mono rounded-lg border border-slate-300 dark:border-slate-700 bg-white dark:bg-slate-800 text-slate-900 dark:text-white focus:outline-none focus:ring-2 focus:ring-emerald-500/30 focus:border-emerald-500 transition"
          />
        </div>
      </div>
    </div>

  </div>

  <!-- Dual Textarea Layout -->
  <div class="grid grid-cols-1 lg:grid-cols-2 divide-y lg:divide-y-0 lg:divide-x divide-slate-200 dark:divide-slate-800">
    
    <!-- Left: Input Area -->
    <div class="p-5 sm:p-6 flex flex-col space-y-3 bg-white dark:bg-slate-900">
      <div class="flex items-center justify-between">
        <div class="flex items-center gap-2">
          <span class="text-xs uppercase tracking-wider font-semibold text-slate-500 dark:text-slate-400 font-sans">
            Input Text
          </span>
          <span id="badge-input-ready" class="text-[11px] font-medium px-2 py-0.5 rounded-full bg-slate-100 dark:bg-slate-800 text-slate-600 dark:text-slate-400 font-sans">
            Live Processing
          </span>
        </div>
        
        <div class="flex items-center gap-2">
          <button
            type="button"
            id="btn-paste"
            class="px-2.5 py-1 text-xs font-medium rounded-md border border-slate-200 dark:border-slate-700/80 hover:bg-slate-100 dark:hover:bg-slate-800 text-slate-700 dark:text-slate-300 transition-colors flex items-center gap-1.5 cursor-pointer font-sans"
            title="Paste from clipboard"
          >
            <svg class="w-3.5 h-3.5 text-slate-500 dark:text-slate-400" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
              <path stroke-linecap="round" stroke-linejoin="round" d="M9 5H7a2 2 0 00-2 2v12a2 2 0 002 2h10a2 2 0 002-2V7a2 2 0 00-2-2h-2M9 5a2 2 0 002 2h2a2 2 0 002-2M9 5a2 2 0 012-2h2a2 2 0 012 2" />
            </svg>
            <span>Paste</span>
          </button>
          <button
            type="button"
            id="btn-clear"
            class="px-2.5 py-1 text-xs font-medium rounded-md border border-slate-200 dark:border-slate-700/80 hover:bg-rose-50 dark:hover:bg-rose-950/40 text-slate-600 hover:text-rose-600 dark:text-slate-400 dark:hover:text-rose-400 transition-colors cursor-pointer font-sans"
            title="Clear input text"
          >
            Clear
          </button>
        </div>
      </div>

      <textarea
        id="input-text"
        rows="15"
        placeholder="Paste or type your list here (emails, keywords, URLs, CSV records, SKUs)... Duplicates will be eliminated instantly in real time."
        class="w-full p-4 rounded-xl border border-slate-200 dark:border-slate-800 bg-slate-50/50 dark:bg-slate-950/60 text-slate-900 dark:text-slate-100 font-mono text-sm leading-relaxed tracking-normal font-normal placeholder:text-slate-400 dark:placeholder:text-slate-600 focus:outline-none focus:ring-2 focus:ring-emerald-500/30 focus:border-emerald-500 transition resize-y min-h-[360px]"
        spellcheck="false"
      >{initialText}</textarea>

      <!-- Input Live Counters -->
      <div class="flex items-center justify-between text-xs text-slate-500 dark:text-slate-400 pt-1 font-sans">
        <div class="flex items-center gap-3">
          <span>Lines: <strong id="stat-input-lines" class="text-slate-800 dark:text-slate-200 font-mono font-medium">0</strong></span>
          <span>Chars: <strong id="stat-input-chars" class="text-slate-800 dark:text-slate-200 font-mono font-medium">0</strong></span>
          <span>Words: <strong id="stat-input-words" class="text-slate-800 dark:text-slate-200 font-mono font-medium">0</strong></span>
        </div>
        <div class="text-[11px] text-slate-400 dark:text-slate-500 font-sans">
          Input buffer
        </div>
      </div>
    </div>

    <!-- Right: Output Area -->
    <div class="p-5 sm:p-6 flex flex-col space-y-3 bg-white dark:bg-slate-900">
      <div class="flex items-center justify-between">
        <div class="flex items-center gap-2">
          <span class="text-xs uppercase tracking-wider font-semibold text-emerald-600 dark:text-emerald-400 font-sans">
            Cleaned Result
          </span>
          <span
            id="status-duplicates-removed"
            class="text-[11px] font-semibold px-2.5 py-0.5 rounded-full bg-emerald-50 dark:bg-emerald-950/60 text-emerald-700 dark:text-emerald-400 border border-emerald-200 dark:border-emerald-500/30 shadow-[0_0_12px_rgba(16,185,129,0.15)] font-sans"
          >
            0 duplicate lines removed
          </span>
        </div>

        <div class="flex items-center gap-2">
          <button
            type="button"
            id="btn-copy"
            class="px-3.5 py-1 text-xs font-semibold rounded-md bg-emerald-600 hover:bg-emerald-500 text-white transition-colors flex items-center gap-1.5 cursor-pointer shadow-sm active:scale-95 font-sans"
            title="Copy unique lines to clipboard"
          >
            <svg id="copy-icon-idle" class="w-3.5 h-3.5 text-white" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
              <rect x="9" y="9" width="13" height="13" rx="2" ry="2"></rect>
              <path d="M5 15H4a2 2 0 01-2-2V4a2 2 0 012-2h9a2 2 0 012 2v1"></path>
            </svg>
            <svg id="copy-icon-success" class="w-3.5 h-3.5 hidden text-white" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5">
              <polyline points="20 6 9 17 4 12"></polyline>
            </svg>
            <span id="copy-btn-text">Copy Result</span>
          </button>

          <button
            type="button"
            id="btn-download"
            class="px-2.5 py-1 text-xs font-medium rounded-md border border-slate-200 dark:border-slate-700/80 hover:bg-slate-100 dark:hover:bg-slate-800 text-slate-700 dark:text-slate-300 transition-colors flex items-center gap-1.5 cursor-pointer font-sans"
            title="Download unique lines as text file"
          >
            <svg class="w-3.5 h-3.5 text-slate-500 dark:text-slate-400" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
              <path stroke-linecap="round" stroke-linejoin="round" d="M4 16v1a3 3 0 003 3h10a3 3 0 003-3v-1m-4-4l-4 4m0 0l-4-4m4 4V4" />
            </svg>
            <span>.txt</span>
          </button>
        </div>
      </div>

      <textarea
        id="output-text"
        rows="15"
        placeholder="Your deduplicated list will appear here automatically..."
        class="w-full p-4 rounded-xl border border-slate-200 dark:border-slate-800 bg-slate-50/50 dark:bg-slate-950/60 text-slate-900 dark:text-slate-100 font-mono text-sm leading-relaxed tracking-normal font-normal placeholder:text-slate-400 dark:placeholder:text-slate-600 focus:outline-none focus:ring-2 focus:ring-emerald-500/30 focus:border-emerald-500 transition resize-y min-h-[360px]"
        spellcheck="false"
      ></textarea>

      <!-- Output Live Counters -->
      <div class="flex items-center justify-between text-xs text-slate-500 dark:text-slate-400 pt-1 font-sans">
        <div class="flex items-center gap-3">
          <span>Lines: <strong id="stat-output-lines" class="text-slate-800 dark:text-slate-200 font-mono font-medium">0</strong></span>
          <span>Chars: <strong id="stat-output-chars" class="text-slate-800 dark:text-slate-200 font-mono font-medium">0</strong></span>
          <span>Duplicates: <strong id="stat-duplicates-saved" class="text-emerald-600 dark:text-emerald-400 font-mono font-medium">0</strong></span>
        </div>
        <div id="stat-reduction-pct" class="text-[11px] font-semibold text-emerald-600 dark:text-emerald-400 font-sans">
          0% reduction
        </div>
      </div>
    </div>

  </div>

  <!-- Live Reduction & Data Hygiene Bar -->
  <div class="p-4 sm:p-5 border-t border-slate-200 dark:border-slate-800 bg-slate-50/70 dark:bg-slate-950/60">
    <div class="flex items-center justify-between text-xs font-sans mb-2">
      <span class="font-medium text-slate-700 dark:text-slate-300 flex items-center gap-2">
        <span class="w-2 h-2 rounded-full bg-emerald-500 animate-pulse"></span>
        <span>Data Hygiene & Line Compression:</span>
        <strong id="reduction-summary-label" class="text-emerald-600 dark:text-emerald-400 font-semibold font-mono">0% Saved</strong>
      </span>
      <span id="reduction-details-text" class="text-[11px] text-slate-500 dark:text-slate-400 font-mono">
        0 duplicates purged • 0 unique entries retained
      </span>
    </div>
    
    <!-- Progress Indicator Bar -->
    <div class="w-full h-2 rounded-full bg-slate-200 dark:bg-slate-800/80 overflow-hidden">
      <div
        id="reduction-progress-bar"
        class="h-full bg-gradient-to-r from-emerald-500 via-teal-400 to-cyan-400 transition-all duration-300 rounded-full"
        style="width: 0%"
      ></div>
    </div>
  </div>

</div>

<!-- Client-Side JavaScript Logic -->
<script is:inline>
  (function () {
    const inputText = document.getElementById('input-text');
    const outputText = document.getElementById('output-text');
    
    // Toggles
    const optCaseSensitive = document.getElementById('opt-case-sensitive');
    const optTrimLines = document.getElementById('opt-trim-lines');
    const optEmptyLines = document.getElementById('opt-empty-lines');
    const optIgnorePunctuation = document.getElementById('opt-ignore-punctuation');
    const selectSort = document.getElementById('select-sort');
    
    // Delimiter Radios & Custom input
    const delimiterRadios = document.querySelectorAll('input[name="delimiter-mode"]');
    const inputCustomDelimiter = document.getElementById('input-custom-delimiter');
    const customDelimiterRadio = document.getElementById('mode-custom-delimiter-radio');
    
    // Mode Pills
    const modePillButtons = document.querySelectorAll('.mode-pill-btn');
    let currentMode = 'unique'; // 'unique' | 'duplicates-only' | 'completely-unique' | 'count-occurrences'
    
    // Action Buttons
    const btnDedupe = document.getElementById('btn-dedupe');
    const btnSample = document.getElementById('btn-sample');
    const btnPaste = document.getElementById('btn-paste');
    const btnClear = document.getElementById('btn-clear');
    const btnCopy = document.getElementById('btn-copy');
    const btnDownload = document.getElementById('btn-download');

    const copyBtnText = document.getElementById('copy-btn-text');
    const copyIconIdle = document.getElementById('copy-icon-idle');
    const copyIconSuccess = document.getElementById('copy-icon-success');

    // Counters
    const statInputChars = document.getElementById('stat-input-chars');
    const statInputWords = document.getElementById('stat-input-words');
    const statInputLines = document.getElementById('stat-input-lines');

    const statOutputChars = document.getElementById('stat-output-chars');
    const statOutputLines = document.getElementById('stat-output-lines');
    const statDuplicatesSaved = document.getElementById('stat-duplicates-saved');
    const statReductionPct = document.getElementById('stat-reduction-pct');
    const statusDuplicatesRemoved = document.getElementById('status-duplicates-removed');

    // Bottom Live Bar
    const reductionSummaryLabel = document.getElementById('reduction-summary-label');
    const reductionDetailsText = document.getElementById('reduction-details-text');
    const reductionProgressBar = document.getElementById('reduction-progress-bar');

    function countWords(str) {
      if (!str || !str.trim()) return 0;
      return str.trim().split(/\s+/).length;
    }

    function countLines(str) {
      if (!str) return 0;
      return str.split(/\r?\n/).length;
    }

    function getSelectedDelimiter() {
      let selected = 'newline';
      for (let i = 0; i < delimiterRadios.length; i++) {
        if (delimiterRadios[i].checked) {
          selected = delimiterRadios[i].value;
          break;
        }
      }

      if (selected === 'comma') {
        return ', ';
      } else if (selected === 'semicolon') {
        return '; ';
      } else if (selected === 'custom') {
        return (inputCustomDelimiter && inputCustomDelimiter.value) ? inputCustomDelimiter.value : '\n';
      }
      return '\n';
    }

    // High-performance O(N) Hash Set deduplication & filtering logic
    function deduplicate(text) {
      if (!text) {
        return {
          result: '',
          duplicatesRemoved: 0,
          originalLines: 0,
          outputLines: 0,
          reductionPct: 0
        };
      }

      const rawLines = text.split(/\r?\n/);
      const isCaseSensitive = optCaseSensitive ? optCaseSensitive.checked : true;
      const isTrimLines = optTrimLines ? optTrimLines.checked : true;
      const isRemoveEmpty = optEmptyLines ? optEmptyLines.checked : false;
      const isIgnorePunct = optIgnorePunctuation ? optIgnorePunctuation.checked : false;
      const sortOrder = selectSort ? selectSort.value : 'original';
      const delimiter = getSelectedDelimiter();

      // Step 1: Pre-process lines and collect frequency map
      const keyMap = new Map();
      let processedLinesCount = 0;

      for (let i = 0; i < rawLines.length; i++) {
        let line = rawLines[i];

        if (isTrimLines) {
          line = line.trim();
        }

        if (isRemoveEmpty && line === '') {
          continue;
        }

        processedLinesCount++;

        // Compute comparison key
        let key = isCaseSensitive ? line : line.toLowerCase();
        if (isIgnorePunct) {
          // Normalize out punctuation and symbols
          key = key.replace(/[^\p{L}\p{N}\s]/gu, '');
        }

        if (keyMap.has(key)) {
          const entry = keyMap.get(key);
          entry.count++;
        } else {
          keyMap.set(key, {
            original: line,
            key: key,
            firstIndex: i,
            count: 1
          });
        }
      }

      // Step 2: Filter candidate entries based on extraction mode
      let candidateEntries = Array.from(keyMap.values());

      if (currentMode === 'duplicates-only') {
        // Only lines that appeared 2 or more times
        candidateEntries = candidateEntries.filter(function (e) {
          return e.count >= 2;
        });
      } else if (currentMode === 'completely-unique') {
        // Only lines that appeared exactly once
        candidateEntries = candidateEntries.filter(function (e) {
          return e.count === 1;
        });
      }

      // Step 3: Sorting
      if (sortOrder === 'alpha-asc') {
        candidateEntries.sort(function (a, b) {
          return a.original.localeCompare(b.original, undefined, {
            numeric: true,
            sensitivity: isCaseSensitive ? 'case' : 'base'
          });
        });
      } else if (sortOrder === 'alpha-desc') {
        candidateEntries.sort(function (a, b) {
          return b.original.localeCompare(a.original, undefined, {
            numeric: true,
            sensitivity: isCaseSensitive ? 'case' : 'base'
          });
        });
      } else if (sortOrder === 'length-asc') {
        candidateEntries.sort(function (a, b) {
          return a.original.length - b.original.length || a.firstIndex - b.firstIndex;
        });
      } else if (sortOrder === 'freq-desc') {
        candidateEntries.sort(function (a, b) {
          return b.count - a.count || a.firstIndex - b.firstIndex;
        });
      } else {
        // Original Order (Preserve input flow)
        candidateEntries.sort(function (a, b) {
          return a.firstIndex - b.firstIndex;
        });
      }

      // Step 4: Map entries to final lines
      const outputLinesArray = candidateEntries.map(function (e) {
        if (currentMode === 'count-occurrences') {
          return e.original + ' [x' + e.count + ']';
        }
        return e.original;
      });

      // Step 5: Join with selected delimiter
      const result = outputLinesArray.join(delimiter);

      // Duplicates removed computation
      const duplicatesCount = Math.max(0, processedLinesCount - outputLinesArray.length);
      const pct = processedLinesCount > 0 ? Math.max(0, Math.round((duplicatesCount / processedLinesCount) * 100)) : 0;

      return {
        result: result,
        duplicatesRemoved: duplicatesCount,
        originalLines: processedLinesCount,
        outputLines: outputLinesArray.length,
        reductionPct: pct
      };
    }

    function update() {
      const raw = inputText ? (inputText.value || '') : '';
      const dedupeResult = deduplicate(raw);
      
      if (outputText) {
        outputText.value = dedupeResult.result;
      }

      // Input Stats
      const inChars = raw.length;
      const inWords = countWords(raw);
      const inLines = raw ? countLines(raw) : 0;

      if (statInputChars) statInputChars.textContent = inChars.toLocaleString();
      if (statInputWords) statInputWords.textContent = inWords.toLocaleString();
      if (statInputLines) statInputLines.textContent = inLines.toLocaleString();

      // Output Stats
      const outChars = dedupeResult.result.length;
      const outLines = dedupeResult.result ? dedupeResult.outputLines : 0;

      if (statOutputChars) statOutputChars.textContent = outChars.toLocaleString();
      if (statOutputLines) statOutputLines.textContent = outLines.toLocaleString();

      const dupesRemoved = dedupeResult.duplicatesRemoved;
      if (statDuplicatesSaved) statDuplicatesSaved.textContent = dupesRemoved.toLocaleString();

      const pct = dedupeResult.reductionPct;
      if (statReductionPct) statReductionPct.textContent = pct + '% reduction';

      if (statusDuplicatesRemoved) {
        statusDuplicatesRemoved.textContent =
          dupesRemoved.toLocaleString() + ' duplicate ' + (dupesRemoved === 1 ? 'line' : 'lines') + ' removed';
      }

      // Live Reduction Bar
      if (reductionSummaryLabel) {
        reductionSummaryLabel.textContent = pct + '% Reduced';
      }
      if (reductionDetailsText) {
        reductionDetailsText.textContent =
          dupesRemoved.toLocaleString() + ' duplicates purged • ' + outLines.toLocaleString() + ' entries retained';
      }
      if (reductionProgressBar) {
        reductionProgressBar.style.width = Math.min(100, Math.max(0, pct)) + '%';
      }
    }

    // Debounce helper
    let timeoutId;
    function debouncedUpdate() {
      clearTimeout(timeoutId);
      timeoutId = setTimeout(update, 40);
    }

    // Mode Pill Switcher click handlers
    modePillButtons.forEach(function (btn) {
      btn.addEventListener('click', function () {
        const mode = btn.getAttribute('data-mode');
        if (!mode) return;
        currentMode = mode;

        // Update Pill UI styles
        modePillButtons.forEach(function (b) {
          if (b === btn) {
            b.className = 'mode-pill-btn px-3 py-1.5 text-xs rounded-lg font-medium transition-all cursor-pointer whitespace-nowrap bg-emerald-600 text-white shadow-xs font-semibold';
          } else {
            b.className = 'mode-pill-btn px-3 py-1.5 text-xs rounded-lg font-medium transition-all cursor-pointer whitespace-nowrap text-slate-700 dark:text-slate-300 hover:text-slate-900 dark:hover:text-white hover:bg-slate-300/50 dark:hover:bg-slate-800/60';
          }
        });

        update();
      });
    });

    // Delimiter Listeners
    delimiterRadios.forEach(function (radio) {
      radio.addEventListener('change', update);
    });

    if (inputCustomDelimiter) {
      inputCustomDelimiter.addEventListener('input', function () {
        if (customDelimiterRadio) {
          customDelimiterRadio.checked = true;
        }
        update();
      });
      inputCustomDelimiter.addEventListener('focus', function () {
        if (customDelimiterRadio) {
          customDelimiterRadio.checked = true;
        }
        update();
      });
    }

    // Toggles and Select Listeners
    inputText?.addEventListener('input', debouncedUpdate);
    optCaseSensitive?.addEventListener('change', update);
    optTrimLines?.addEventListener('change', update);
    optEmptyLines?.addEventListener('change', update);
    optIgnorePunctuation?.addEventListener('change', update);
    selectSort?.addEventListener('change', update);
    btnDedupe?.addEventListener('click', update);

    // Sample Text
    btnSample?.addEventListener('click', function () {
      if (!inputText) return;
      inputText.value =
        'Apple\nBanana\nOrange\nApple\nbanana\nGrape\nOrange\n  Watermelon  \nWatermelon\nMango\nGrape\nBanana\nPeach';
      if (selectSort) selectSort.value = 'original';
      update();
    });

    // Clear
    btnClear?.addEventListener('click', function () {
      if (!inputText || !outputText) return;
      inputText.value = '';
      outputText.value = '';
      update();
      inputText.focus();
    });

    // Paste from Clipboard
    btnPaste?.addEventListener('click', async function () {
      if (!inputText) return;
      try {
        if (navigator.clipboard && navigator.clipboard.readText) {
          const clipText = await navigator.clipboard.readText();
          if (clipText) {
            inputText.value = clipText;
            update();
          }
        } else {
          inputText.focus();
          inputText.select();
        }
      } catch (err) {
        inputText.focus();
      }
    });

    // Copy to Clipboard
    btnCopy?.addEventListener('click', async function () {
      if (!outputText) return;
      const textToCopy = outputText.value;
      if (!textToCopy) return;

      try {
        if (navigator.clipboard && navigator.clipboard.writeText) {
          await navigator.clipboard.writeText(textToCopy);
        } else {
          outputText.select();
          document.execCommand('copy');
        }

        if (copyBtnText) copyBtnText.textContent = 'Copied!';
        if (copyIconIdle) copyIconIdle.classList.add('hidden');
        if (copyIconSuccess) copyIconSuccess.classList.remove('hidden');

        setTimeout(function () {
          if (copyBtnText) copyBtnText.textContent = 'Copy Result';
          if (copyIconIdle) copyIconIdle.classList.remove('hidden');
          if (copyIconSuccess) copyIconSuccess.classList.add('hidden');
        }, 2000);
      } catch (err) {
        outputText.select();
      }
    });

    // Download .txt file
    btnDownload?.addEventListener('click', function () {
      if (!outputText) return;
      const content = outputText.value;
      if (!content) return;

      const blob = new Blob([content], { type: 'text/plain;charset=utf-8' });
      const url = URL.createObjectURL(blob);
      const a = document.createElement('a');
      a.href = url;
      a.download = 'unique-lines.txt';
      document.body.appendChild(a);
      a.click();
      document.body.removeChild(a);
      URL.revokeObjectURL(url);
    });

    // Preset Data map
    const presetMap = {
      'preset-email-list': {
        options: { caseSensitive: false, trimLines: true, emptyLines: true, ignorePunct: false, sort: 'alpha-asc', mode: 'unique', delimiter: 'newline' },
        sample: 'contact@company.com\nMARKETING@COMPANY.COM\ncontact@company.com\nsales@enterprise.net\nmarketing@company.com\n  alex.wong@startup.io  \nalex.wong@startup.io\ninfo@domain.org\nsales@enterprise.net\nsupport@domain.org'
      },
      'preset-keywords': {
        options: { caseSensitive: false, trimLines: true, emptyLines: true, ignorePunct: false, sort: 'original', mode: 'unique', delimiter: 'newline' },
        sample: 'free online text cleaner\nbest duplicate line remover\nfree online text cleaner\nremove duplicate lines online\nFREE ONLINE TEXT CLEANER\ntext deduplication tool\nbest duplicate line remover\nclean duplicate lists'
      },
      'preset-case-insensitive': {
        options: { caseSensitive: false, trimLines: true, emptyLines: false, ignorePunct: false, sort: 'original', mode: 'unique', delimiter: 'newline' },
        sample: 'JavaScript\njavascript\nJAVASCRIPT\nTypeScript\ntypescript\nPython\npython\nPYTHON\nRust\nrust'
      },
      'preset-urls': {
        options: { caseSensitive: true, trimLines: true, emptyLines: true, ignorePunct: false, sort: 'original', mode: 'unique', delimiter: 'newline' },
        sample: 'https://fasttoolverse.com/image-resizer/\nhttps://fasttoolverse.com/remove-extra-spaces/\nhttps://fasttoolverse.com/remove-duplicate-lines/\nhttps://fasttoolverse.com/image-resizer/\nhttps://fasttoolverse.com/remove-extra-spaces/\nhttps://fasttoolverse.com/sort-text-lines/'
      },
      'preset-sort-dedupe': {
        options: { caseSensitive: false, trimLines: true, emptyLines: true, ignorePunct: false, sort: 'alpha-asc', mode: 'unique', delimiter: 'newline' },
        sample: 'Zebra\nBanana\nApple\nOrange\nBanana\nApple\nGrape\nWatermelon\nOrange\nMango'
      },
      'preset-csv-column': {
        options: { caseSensitive: true, trimLines: true, emptyLines: true, ignorePunct: false, sort: 'original', mode: 'unique', delimiter: 'comma' },
        sample: 'SKU-8921-XL\nSKU-4412-SM\nSKU-8921-XL\nSKU-1093-MD\nSKU-4412-SM\nSKU-7721-LG\nSKU-1093-MD\nSKU-9901-XL'
      }
    };

    // Attach listener for preset buttons
    const presetButtons = document.querySelectorAll('.preset-card-btn');
    presetButtons.forEach(function (btn) {
      btn.addEventListener('click', function () {
        const id = btn.getAttribute('data-preset');
        const data = presetMap[id];
        if (!data) return;

        if (optCaseSensitive) optCaseSensitive.checked = data.options.caseSensitive;
        if (optTrimLines) optTrimLines.checked = data.options.trimLines;
        if (optEmptyLines) optEmptyLines.checked = data.options.emptyLines;
        if (optIgnorePunctuation) optIgnorePunctuation.checked = !!data.options.ignorePunct;
        if (selectSort && data.options.sort) selectSort.value = data.options.sort;

        // Delimiter
        if (data.options.delimiter) {
          delimiterRadios.forEach(function (r) {
            r.checked = (r.value === data.options.delimiter);
          });
        }

        // Mode
        if (data.options.mode) {
          currentMode = data.options.mode;
          modePillButtons.forEach(function (b) {
            if (b.getAttribute('data-mode') === currentMode) {
              b.className = 'mode-pill-btn px-3 py-1.5 text-xs rounded-lg font-medium transition-all cursor-pointer whitespace-nowrap bg-emerald-600 text-white shadow-xs font-semibold';
            } else {
              b.className = 'mode-pill-btn px-3 py-1.5 text-xs rounded-lg font-medium transition-all cursor-pointer whitespace-nowrap text-slate-700 dark:text-slate-300 hover:text-slate-900 dark:hover:text-white hover:bg-slate-300/50 dark:hover:bg-slate-800/60';
            }
          });
        }

        if (data.sample && inputText) {
          inputText.value = data.sample;
        }

        update();

        // Smooth scroll to editor
        if (inputText) {
          inputText.scrollIntoView({ behavior: 'smooth', block: 'center' });
        }
      });
    });

    // Initial calculation
    update();
  })();
</script>
