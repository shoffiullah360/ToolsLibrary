                  href="/tools/image-resizer"
                  id="cta-image-resizer-btn"
                  class="group mt-3 inline-flex items-center justify-center gap-2 px-4 py-2.5 rounded-xl bg-indigo-600 hover:bg-indigo-700 dark:bg-indigo-500 dark:hover:bg-indigo-600 text-white font-semibold text-xs shadow-sm hover:shadow-md hover:-translate-y-0.5 transition-all duration-200 active:scale-95 focus:outline-none focus:ring-2 focus:ring-indigo-500 focus:ring-offset-2 dark:focus:ring-offset-slate-900"
                >
                  <span>Open in Image Resizer</span>
                  <span aria-hidden="true" class="transition-transform duration-200 group-hover:translate-x-0.5 font-bold">→</span>
