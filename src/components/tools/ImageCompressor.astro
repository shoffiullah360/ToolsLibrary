<!-- Client-Side JavaScript Logic: 100% In-Browser Compression Engine -->
<script>
  import JSZip from 'jszip';

  interface QueueItem {
    id: string;
    file: File;
    name: string;
    originalSize: number;
    originalUrl: string;
    img: HTMLImageElement;
    origWidth: number;
    origHeight: number;
    width: number;
    height: number;
    compressedBlob: Blob | null;
    compressedUrl: string | null;
    compressedSize: number;
    outputMime: string;
    reductionPercent: number;
    processingTime: number;
  }

  function initImageCompressor() {
    const root = document.getElementById('image-compressor-root');
    if (!root || root.dataset.initialized === 'true') return;
    root.dataset.initialized = 'true';

    // Preset Props from dataset
    const presetTargetKb = root.dataset.presetKb ? parseFloat(root.dataset.presetKb) : null;
    const presetQuality = root.dataset.presetQuality ? parseInt(root.dataset.presetQuality, 10) : 75;
    const presetFormat = root.dataset.presetFormat || 'auto';
    const presetMaxWidth = root.dataset.presetMaxWidth ? parseInt(root.dataset.presetMaxWidth, 10) : null;
    const presetMaxHeight = root.dataset.presetMaxHeight ? parseInt(root.dataset.presetMaxHeight, 10) : null;
    const presetLockAspect = root.dataset.presetAspectRatio !== 'false';

    // State Variables
    let queue: QueueItem[] = [];
    let activeId: string | null = null;
    let qualityPercent = presetQuality;
    let targetKb: number | null = presetTargetKb;
    let targetSizeUnit: 'KB' | 'MB' = 'KB';
    let outputFormat: string = presetFormat; // 'auto', 'image/jpeg', 'image/png', 'image/webp'
    let lockAspectRatio = presetLockAspect;
    let stripExif = true;
    let viewMode: 'split' | 'side' = 'split';
    let splitSliderPercent = 50;
    let isSplitSliderDragging = false;
    let compressionDebounceTimer: ReturnType<typeof setTimeout> | null = null;

    // DOM Elements
    const dropzoneView = document.getElementById('dropzone-view');
    const editorView = document.getElementById('editor-view');
    const dropzone = document.getElementById('dropzone');
    const imageInput = document.getElementById('imageInput') as HTMLInputElement | null;
    const selectBtn = document.getElementById('selectBtn');
    const uploadAnotherBtn = document.getElementById('upload-another-btn');
    const clearAllBtn = document.getElementById('clear-all-btn');
    const queueStrip = document.getElementById('queue-strip');
    const queueCounter = document.getElementById('queue-counter');

    // Details Bar
    const sourceFilename = document.getElementById('source-filename');
    const sourceSpecs = document.getElementById('source-specs');

    // Left Column Preview Elements
    const previewDimPill = document.getElementById('preview-dim-pill');
    const previewSizePill = document.getElementById('preview-size-pill');
    const previewSavingsPill = document.getElementById('preview-savings-pill');
    const splitSliderContainer = document.getElementById('split-slider-container');
    const previewOriginalImg = document.getElementById('preview-original-img') as HTMLImageElement | null;
    const previewCompressedImg = document.getElementById('preview-compressed-img') as HTMLImageElement | null;
    const splitCompressedWrapper = document.getElementById('split-compressed-wrapper');
    const splitHandle = document.getElementById('split-handle');
    const sliderOrigSize = document.getElementById('slider-orig-size');
    const sliderCompSize = document.getElementById('slider-comp-size');
    const sideBySideContainer = document.getElementById('side-by-side-container');
    const sideOrigImg = document.getElementById('side-orig-img') as HTMLImageElement | null;
    const sideCompImg = document.getElementById('side-comp-img') as HTMLImageElement | null;
    const sideOrigSize = document.getElementById('side-orig-size');
    const sideCompSize = document.getElementById('side-comp-size');
    const canvasLoading = document.getElementById('canvas-loading');
    const compressionTime = document.getElementById('compression-time');
    const viewModeSplitBtn = document.getElementById('view-mode-split');
    const viewModeSideBtn = document.getElementById('view-mode-side');

    // Tab Buttons & Panes
    const tabBtnCompress = document.getElementById('tab-btn-compress');
    const tabBtnExport = document.getElementById('tab-btn-export');
    const tabPaneCompress = document.getElementById('tab-pane-compress');
    const tabPaneExport = document.getElementById('tab-pane-export');

    // Tab 1: Compression Controls
    const savingsBadge = document.getElementById('savings-badge');
    const summaryOrigSize = document.getElementById('summary-orig-size');
    const summaryCompSize = document.getElementById('summary-comp-size');
    const savingsProgressBar = document.getElementById('savings-progress-bar');
    const enableTargetSize = document.getElementById('enable-target-size') as HTMLInputElement | null;
    const targetSizeControls = document.getElementById('target-size-controls');
    const inputTargetSize = document.getElementById('input-target-size') as HTMLInputElement | null;
    const sizeUnitKb = document.getElementById('size-unit-kb');
    const sizeUnitMb = document.getElementById('size-unit-mb');
    const kbPresetPills = document.querySelectorAll('.kb-preset-pill');
    const qualitySlider = document.getElementById('quality-slider') as HTMLInputElement | null;
    const qualityValDisplay = document.getElementById('quality-val-display');
    const qualityPills = document.querySelectorAll('.quality-pill');

    // Tab 2: Output & Dimensions
    const formatBadgePreview = document.getElementById('format-badge-preview');
    const formatPills = document.querySelectorAll('.format-pill');
    const formatInfoText = document.getElementById('format-info-text');
    const dimWidthInput = document.getElementById('dim-width-input') as HTMLInputElement | null;
    const dimHeightInput = document.getElementById('dim-height-input') as HTMLInputElement | null;
    const aspectLockBtn = document.getElementById('aspect-lock-btn');
    const lockIconLocked = document.getElementById('lock-icon-locked');
    const lockIconUnlocked = document.getElementById('lock-icon-unlocked');
    const dimPresetPills = document.querySelectorAll('.dim-preset-pill');
    const dimResetBtn = document.getElementById('dim-reset-btn');
    const optStripExif = document.getElementById('opt-strip-exif') as HTMLInputElement | null;

    // Download Card
    const downloadSingleBtn = document.getElementById('download-single-btn');
    const downloadBtnLabel = document.getElementById('download-btn-label');
    const downloadBatchZipBtn = document.getElementById('download-batch-zip-btn');
    const btnBatchCount = document.getElementById('btn-batch-count');
    const summaryMetaRes = document.getElementById('summary-meta-res');
    const summaryMetaFormat = document.getElementById('summary-meta-format');
    const summaryMetaSize = document.getElementById('summary-meta-size');

    // Utilities
    function formatBytes(bytes: number, decimals = 1): string {
      if (bytes === 0) return '0 B';
      const k = 1024;
      const dm = decimals < 0 ? 0 : decimals;
      const sizes = ['B', 'KB', 'MB', 'GB'];
      const i = Math.floor(Math.log(bytes) / Math.log(k));
      return parseFloat((bytes / Math.pow(k, i)).toFixed(dm)) + ' ' + sizes[i];
    }

    // Helper: Update Format Pill styling
    function updateFormatPillStyles(fmt: string) {
      formatPills.forEach(pill => {
        const pFmt = pill.getAttribute('data-format');
        const isActive = (fmt === 'image/jpeg' && pFmt === 'jpeg') ||
                         (fmt === 'image/png' && pFmt === 'png') ||
                         (fmt === 'image/webp' && pFmt === 'webp') ||
                         (fmt === 'auto' && pFmt === 'auto');
        if (isActive) {
          pill.className = 'format-pill py-2 rounded-xl text-xs font-semibold border-2 border-blue-500 bg-blue-50/50 dark:bg-blue-950/30 text-blue-600 dark:text-blue-400 transition cursor-pointer';
        } else {
          pill.className = 'format-pill py-2 rounded-xl text-xs font-semibold border border-slate-200 dark:border-slate-700 hover:border-blue-500 text-slate-700 dark:text-slate-300 transition cursor-pointer';
        }
      });
      if (formatBadgePreview) {
        formatBadgePreview.textContent = fmt === 'image/jpeg' ? 'JPG' : fmt === 'image/png' ? 'PNG' : fmt === 'image/webp' ? 'WEBP' : 'AUTO';
      }
      if (formatInfoText) {
        if (fmt === 'image/webp') {
          formatInfoText.textContent = 'WebP: Modern format offering 25–35% smaller file size than JPG.';
        } else if (fmt === 'image/jpeg') {
          formatInfoText.textContent = 'JPG: Standard format accepted by all portals and admissions.';
        } else if (fmt === 'image/png') {
          formatInfoText.textContent = 'PNG: Preserves transparent backgrounds with lossless clarity.';
        } else {
          formatInfoText.textContent = 'Auto: Retains original format of uploaded image.';
        }
      }
    }

    // Initialize Presets
    if (presetTargetKb) {
      if (enableTargetSize) enableTargetSize.checked = true;
      if (targetSizeControls) {
        targetSizeControls.classList.remove('opacity-50', 'pointer-events-none');
      }
      if (inputTargetSize) inputTargetSize.value = String(presetTargetKb);
    }
    updateFormatPillStyles(outputFormat);

    // Tab Switching
    function setTab(tab: 'compress' | 'export') {
      if (!tabBtnCompress || !tabBtnExport || !tabPaneCompress || !tabPaneExport) return;
      if (tab === 'compress') {
        tabBtnCompress.className = 'flex-1 py-2 text-xs font-semibold rounded-lg transition-all duration-200 cursor-pointer bg-white dark:bg-slate-700 text-slate-900 dark:text-white shadow-sm';
        tabBtnExport.className = 'flex-1 py-2 text-xs font-semibold rounded-lg transition-all duration-200 cursor-pointer text-slate-500 dark:text-slate-400 hover:text-slate-800 dark:hover:text-slate-200';
        tabPaneCompress.classList.remove('hidden');
        tabPaneExport.classList.add('hidden');
      } else {
        tabBtnExport.className = 'flex-1 py-2 text-xs font-semibold rounded-lg transition-all duration-200 cursor-pointer bg-white dark:bg-slate-700 text-slate-900 dark:text-white shadow-sm';
        tabBtnCompress.className = 'flex-1 py-2 text-xs font-semibold rounded-lg transition-all duration-200 cursor-pointer text-slate-500 dark:text-slate-400 hover:text-slate-800 dark:hover:text-slate-200';
        tabPaneExport.classList.remove('hidden');
        tabPaneCompress.classList.add('hidden');
      }
    }

    tabBtnCompress?.addEventListener('click', () => setTab('compress'));
    tabBtnExport?.addEventListener('click', () => setTab('export'));

    // Upload & Dropzone Handling
    selectBtn?.addEventListener('click', () => imageInput?.click());
    dropzone?.addEventListener('click', () => imageInput?.click());
    uploadAnotherBtn?.addEventListener('click', () => imageInput?.click());

    ['dragenter', 'dragover'].forEach(eventName => {
      dropzone?.addEventListener(eventName, (e) => {
        e.preventDefault();
        e.stopPropagation();
        dropzone.classList.add('border-blue-500', 'bg-blue-50/30', 'dark:bg-blue-950/20');
      });
    });

    ['dragleave', 'drop'].forEach(eventName => {
      dropzone?.addEventListener(eventName, (e) => {
        e.preventDefault();
        e.stopPropagation();
        dropzone.classList.remove('border-blue-500', 'bg-blue-50/30', 'dark:bg-blue-950/20');
      });
    });

    dropzone?.addEventListener('drop', (e) => {
      const dt = (e as DragEvent).dataTransfer;
      if (dt && dt.files && dt.files.length > 0) {
        handleFiles(dt.files);
      }
    });

    imageInput?.addEventListener('change', () => {
      if (imageInput.files && imageInput.files.length > 0) {
        handleFiles(imageInput.files);
        imageInput.value = '';
      }
    });

    window.addEventListener('paste', (e: ClipboardEvent) => {
      const items = e.clipboardData?.items;
      if (!items) return;
      const files: File[] = [];
      for (let i = 0; i < items.length; i++) {
        if (items[i].type.startsWith('image/')) {
          const file = items[i].getAsFile();
          if (file) files.push(file);
        }
      }
      if (files.length > 0) {
        const dt = new DataTransfer();
        files.forEach(f => dt.items.add(f));
        handleFiles(dt.files);
      }
    });

    clearAllBtn?.addEventListener('click', () => {
      queue.forEach(item => {
        URL.revokeObjectURL(item.originalUrl);
        if (item.compressedUrl) URL.revokeObjectURL(item.compressedUrl);
      });
      queue = [];
      activeId = null;
      dropzoneView?.classList.remove('hidden');
      editorView?.classList.add('hidden');
    });

    // File Ingestion Pipeline
    async function handleFiles(fileList: FileList) {
      const allowed = Array.from(fileList).filter(f => f.type.startsWith('image/'));
      if (allowed.length === 0) return;

      const remainingSlots = Math.max(0, 15 - queue.length);
      const toAdd = allowed.slice(0, remainingSlots);

      for (const file of toAdd) {
        const id = 'img_' + Math.random().toString(36).substring(2, 9);
        const originalUrl = URL.createObjectURL(file);
        const img = new Image();

        await new Promise<void>((resolve) => {
          img.onload = () => resolve();
          img.onerror = () => resolve();
          img.src = originalUrl;
        });

        let targetW = img.naturalWidth || 800;
        let targetH = img.naturalHeight || 600;

        if (presetMaxWidth && targetW > presetMaxWidth) {
          const ratio = presetMaxWidth / targetW;
          targetW = presetMaxWidth;
          targetH = Math.round(targetH * ratio);
        }
        if (presetMaxHeight && targetH > presetMaxHeight) {
          const ratio = presetMaxHeight / targetH;
          targetH = presetMaxHeight;
          targetW = Math.round(targetW * ratio);
        }

        queue.push({
          id,
          file,
          name: file.name,
          originalSize: file.size,
          originalUrl,
          img,
          origWidth: img.naturalWidth || 800,
          origHeight: img.naturalHeight || 600,
          width: targetW,
          height: targetH,
          compressedBlob: null,
          compressedUrl: null,
          compressedSize: file.size,
          outputMime: outputFormat === 'auto' ? file.type : outputFormat,
          reductionPercent: 0,
          processingTime: 0
        });
      }

      if (!activeId && queue.length > 0) {
        activeId = queue[0].id;
      }

      dropzoneView?.classList.add('hidden');
      editorView?.classList.remove('hidden');

      renderQueueStrip();
      loadActiveImage();
      triggerCompressionAll();
    }

    function renderQueueStrip() {
      if (!queueStrip || !queueCounter) return;
      queueCounter.textContent = `${queue.length}/15`;

      if (downloadBatchZipBtn && btnBatchCount) {
        if (queue.length > 1) {
          downloadBatchZipBtn.classList.remove('hidden');
          btnBatchCount.textContent = `Download All as ZIP (${queue.length} files)`;
        } else {
          downloadBatchZipBtn.classList.add('hidden');
        }
      }

      queueStrip.innerHTML = '';
      queue.forEach(item => {
        const card = document.createElement('div');
        const isActive = item.id === activeId;
        card.className = `relative shrink-0 w-16 h-16 sm:w-20 sm:h-20 rounded-xl overflow-hidden border-2 cursor-pointer transition-all duration-200 group flex items-center justify-center bg-slate-100 dark:bg-slate-800 ${
          isActive
            ? 'border-blue-500 ring-2 ring-blue-500/20 shadow-md scale-102'
            : 'border-slate-200 dark:border-slate-700 hover:border-slate-400 opacity-75 hover:opacity-100'
        }`;

        const img = document.createElement('img');
        img.src = item.originalUrl;
        img.className = 'w-full h-full object-cover';
        img.alt = item.name;
        card.appendChild(img);

        // Delete button
        const delBtn = document.createElement('button');
        delBtn.type = 'button';
        delBtn.className = 'absolute top-1 right-1 w-4 h-4 rounded-full bg-slate-900/80 text-white flex items-center justify-center opacity-0 group-hover:opacity-100 hover:bg-rose-600 transition text-[10px] cursor-pointer';
        delBtn.innerHTML = '&times;';
        delBtn.onclick = (e) => {
          e.stopPropagation();
          deleteQueueItem(item.id);
        };
        card.appendChild(delBtn);

        // Savings tag if compressed
        if (item.reductionPercent > 0) {
          const tag = document.createElement('span');
          tag.className = 'absolute bottom-1 right-1 px-1 py-0.2 bg-emerald-600/90 text-white text-[9px] font-mono font-bold rounded';
          tag.textContent = `-${item.reductionPercent}%`;
          card.appendChild(tag);
        }

        card.addEventListener('click', () => {
          activeId = item.id;
          renderQueueStrip();
          loadActiveImage();
        });

        queueStrip.appendChild(card);
      });
    }

    function deleteQueueItem(id: string) {
      const idx = queue.findIndex(q => q.id === id);
      if (idx !== -1) {
        URL.revokeObjectURL(queue[idx].originalUrl);
        if (queue[idx].compressedUrl) URL.revokeObjectURL(queue[idx].compressedUrl);
        queue.splice(idx, 1);
      }

      if (queue.length === 0) {
        activeId = null;
        dropzoneView?.classList.remove('hidden');
        editorView?.classList.add('hidden');
      } else {
        if (activeId === id) {
          activeId = queue[0].id;
        }
        renderQueueStrip();
        loadActiveImage();
      }
    }

    function loadActiveImage() {
      const item = queue.find(q => q.id === activeId);
      if (!item) return;

      if (sourceFilename) sourceFilename.textContent = item.name;
      if (sourceSpecs) {
        sourceSpecs.textContent = `Original: ${item.origWidth} × ${item.origHeight} px • ${formatBytes(item.originalSize)}`;
      }

      if (dimWidthInput) dimWidthInput.value = String(item.width);
      if (dimHeightInput) dimHeightInput.value = String(item.height);

      if (previewOriginalImg) previewOriginalImg.src = item.originalUrl;
      if (sideOrigImg) sideOrigImg.src = item.originalUrl;
      if (sliderOrigSize) sliderOrigSize.textContent = formatBytes(item.originalSize);
      if (sideOrigSize) sideOrigSize.textContent = formatBytes(item.originalSize);
      if (summaryOrigSize) summaryOrigSize.textContent = `Orig: ${formatBytes(item.originalSize)}`;

      if (item.compressedUrl) {
        updateCompressedDisplay(item);
      } else {
        triggerCompression();
      }
    }

    // Compression Core Engine
    function triggerCompression() {
      if (compressionDebounceTimer) clearTimeout(compressionDebounceTimer);
      compressionDebounceTimer = setTimeout(() => {
        const item = queue.find(q => q.id === activeId);
        if (item) compressItem(item);
      }, 60);
    }

    function triggerCompressionAll() {
      queue.forEach(item => compressItem(item));
    }

    async function compressItem(item: QueueItem) {
      if (canvasLoading) canvasLoading.classList.remove('hidden');
      const startTime = performance.now();

      const canvas = document.createElement('canvas');
      canvas.width = item.width;
      canvas.height = item.height;
      const ctx = canvas.getContext('2d');
      if (!ctx) return;

      ctx.imageSmoothingEnabled = true;
      ctx.imageSmoothingQuality = 'high';
      ctx.drawImage(item.img, 0, 0, item.width, item.height);

      let targetMime = outputFormat === 'auto' ? item.file.type : outputFormat;
      if (!['image/jpeg', 'image/png', 'image/webp'].includes(targetMime)) {
        targetMime = 'image/jpeg';
      }

      let finalBlob: Blob | null = null;
      let effectiveQuality = qualityPercent / 100;

      const isTargetSizeActive = enableTargetSize?.checked && targetKb && targetKb > 0;
      const targetBytes = isTargetSizeActive
        ? (targetSizeUnit === 'MB' ? targetKb * 1024 * 1024 : targetKb * 1024)
        : null;

      if (isTargetSizeActive && targetBytes) {
        // Binary search algorithm (up to 7 iterations)
        let minQ = 0.05;
        let maxQ = 0.98;
        let bestBlob: Blob | null = null;

        for (let iter = 0; iter < 7; iter++) {
          const testQ = (minQ + maxQ) / 2;
          const candidateBlob = await new Promise<Blob | null>(res => canvas.toBlob(res, targetMime, testQ));
          if (!candidateBlob) break;

          bestBlob = candidateBlob;
          if (candidateBlob.size <= targetBytes) {
            minQ = testQ; // can we get better quality while still under target?
          } else {
            maxQ = testQ; // too large, lower quality
          }
        }

        // If still oversized at lowest quality, proportionally downsample resolution
        if (bestBlob && bestBlob.size > targetBytes) {
          let scaleFactor = Math.sqrt(targetBytes / bestBlob.size) * 0.95;
          const downscaledCanvas = document.createElement('canvas');
          downscaledCanvas.width = Math.max(32, Math.round(item.width * scaleFactor));
          downscaledCanvas.height = Math.max(32, Math.round(item.height * scaleFactor));
          const downCtx = downscaledCanvas.getContext('2d');
          if (downCtx) {
            downCtx.imageSmoothingEnabled = true;
            downCtx.imageSmoothingQuality = 'high';
            downCtx.drawImage(canvas, 0, 0, downscaledCanvas.width, downscaledCanvas.height);
            const secondaryBlob = await new Promise<Blob | null>(res => downscaledCanvas.toBlob(res, targetMime, 0.70));
            if (secondaryBlob) {
              bestBlob = secondaryBlob;
              item.width = downscaledCanvas.width;
              item.height = downscaledCanvas.height;
              if (dimWidthInput) dimWidthInput.value = String(item.width);
              if (dimHeightInput) dimHeightInput.value = String(item.height);
            }
          }
        }

        finalBlob = bestBlob;
      } else {
        // Direct Quality slider encoding
        finalBlob = await new Promise<Blob | null>(res => canvas.toBlob(res, targetMime, effectiveQuality));
      }

      const elapsed = ((performance.now() - startTime) / 1000).toFixed(2);
      if (canvasLoading) canvasLoading.classList.add('hidden');

      if (!finalBlob) return;

      if (item.compressedUrl) URL.revokeObjectURL(item.compressedUrl);
      item.compressedBlob = finalBlob;
      item.compressedUrl = URL.createObjectURL(finalBlob);
      item.compressedSize = finalBlob.size;
      item.outputMime = targetMime;
      item.processingTime = parseFloat(elapsed);
      item.reductionPercent = Math.max(0, Math.round(((item.originalSize - finalBlob.size) / item.originalSize) * 100));

      if (item.id === activeId) {
        updateCompressedDisplay(item);
      }
      renderQueueStrip();
    }

    function updateCompressedDisplay(item: QueueItem) {
      if (!item.compressedUrl) return;

      if (previewCompressedImg) previewCompressedImg.src = item.compressedUrl;
      if (sideCompImg) sideCompImg.src = item.compressedUrl;

      const compSizeText = formatBytes(item.compressedSize);
      if (sliderCompSize) sliderCompSize.textContent = compSizeText;
      if (sideCompSize) sideCompSize.textContent = compSizeText;
      if (summaryCompSize) summaryCompSize.textContent = `Comp: ${compSizeText}`;
      if (previewSizePill) previewSizePill.textContent = `Est. ~${compSizeText}`;

      if (previewDimPill) {
        previewDimPill.textContent = `${item.width} × ${item.height} px`;
      }

      const savedBytes = Math.max(0, item.originalSize - item.compressedSize);
      const isSmaller = item.compressedSize <= item.originalSize;
      const pct = item.reductionPercent;

      if (previewSavingsPill) {
        if (isSmaller && pct > 0) {
          previewSavingsPill.textContent = `-${pct}%`;
          previewSavingsPill.classList.remove('hidden');
        } else {
          previewSavingsPill.classList.add('hidden');
        }
      }

      if (savingsBadge) {
        if (isSmaller && pct > 0) {
          savingsBadge.textContent = `-${pct}% (${formatBytes(savedBytes)} Saved)`;
          savingsBadge.className = 'px-2 py-0.5 rounded-full font-mono text-[11px] font-bold bg-emerald-100 dark:bg-emerald-950/60 text-emerald-600 dark:text-emerald-400 border border-emerald-200 dark:border-emerald-800';
        } else {
          savingsBadge.textContent = `No size reduction`;
          savingsBadge.className = 'px-2 py-0.5 rounded-full font-mono text-[11px] font-bold bg-slate-100 dark:bg-slate-800 text-slate-500 border border-slate-200 dark:border-slate-700';
        }
      }

      if (savingsProgressBar) {
        const ratio = Math.min(100, Math.max(5, (item.compressedSize / item.originalSize) * 100));
        savingsProgressBar.style.width = `${ratio}%`;
      }

      if (compressionTime) {
        compressionTime.textContent = `${item.processingTime}s`;
      }

      if (summaryMetaRes) summaryMetaRes.textContent = `${item.width} × ${item.height} px`;
      if (summaryMetaFormat) {
        const ext = item.outputMime.replace('image/', '').toUpperCase();
        summaryMetaFormat.textContent = `FORMAT: ${ext}`;
      }
      if (summaryMetaSize) {
        summaryMetaSize.textContent = isSmaller ? `SAVINGS: -${pct}%` : `SIZE: ${compSizeText}`;
      }

      if (downloadBtnLabel) {
        downloadBtnLabel.textContent = `Download Compressed (${compSizeText})`;
      }
    }

    // Split Comparison Slider Drag Logic (With pointer capture and safe clip-path)
    function updateSplitSlider(clientX: number) {
      if (!splitSliderContainer || !splitCompressedWrapper || !splitHandle) return;
      const rect = splitSliderContainer.getBoundingClientRect();
      const x = Math.max(0, Math.min(clientX - rect.left, rect.width));
      splitSliderPercent = (x / rect.width) * 100;
      splitCompressedWrapper.style.clipPath = `inset(0 ${100 - splitSliderPercent}% 0 0)`;
      splitCompressedWrapper.style.setProperty('-webkit-clip-path', `inset(0 ${100 - splitSliderPercent}% 0 0)`);
      splitHandle.style.left = `${splitSliderPercent}%`;
    }

    splitSliderContainer?.addEventListener('pointerdown', (e) => {
      isSplitSliderDragging = true;
      splitSliderContainer.setPointerCapture(e.pointerId);
      updateSplitSlider(e.clientX);
    });

    splitSliderContainer?.addEventListener('pointermove', (e) => {
      if (isSplitSliderDragging) {
        updateSplitSlider(e.clientX);
      }
    });

    const stopSliderDrag = (e: PointerEvent) => {
      if (isSplitSliderDragging) {
        isSplitSliderDragging = false;
        try {
          splitSliderContainer?.releasePointerCapture(e.pointerId);
        } catch (_) {}
      }
    };

    splitSliderContainer?.addEventListener('pointerup', stopSliderDrag);
    splitSliderContainer?.addEventListener('pointercancel', stopSliderDrag);

    // View Mode Toggle (Split vs Side-by-Side)
    function setViewMode(mode: 'split' | 'side') {
      viewMode = mode;
      if (mode === 'split') {
        splitSliderContainer?.classList.remove('hidden');
        sideBySideContainer?.classList.add('hidden');
        if (viewModeSplitBtn) {
          viewModeSplitBtn.className = 'inline-flex items-center gap-1 px-2.5 py-1.5 rounded-lg bg-blue-50 dark:bg-blue-950/40 text-blue-600 dark:text-blue-400 font-semibold border border-blue-100 dark:border-blue-900/50 transition cursor-pointer active:scale-95';
        }
        if (viewModeSideBtn) {
          viewModeSideBtn.className = 'inline-flex items-center gap-1 px-2.5 py-1.5 rounded-lg text-slate-700 dark:text-slate-300 hover:bg-slate-100 dark:hover:bg-slate-800 font-medium transition cursor-pointer active:scale-95';
        }
      } else {
        splitSliderContainer?.classList.add('hidden');
        sideBySideContainer?.classList.remove('hidden');
        if (viewModeSideBtn) {
          viewModeSideBtn.className = 'inline-flex items-center gap-1 px-2.5 py-1.5 rounded-lg bg-blue-50 dark:bg-blue-950/40 text-blue-600 dark:text-blue-400 font-semibold border border-blue-100 dark:border-blue-900/50 transition cursor-pointer active:scale-95';
        }
        if (viewModeSplitBtn) {
          viewModeSplitBtn.className = 'inline-flex items-center gap-1 px-2.5 py-1.5 rounded-lg text-slate-700 dark:text-slate-300 hover:bg-slate-100 dark:hover:bg-slate-800 font-medium transition cursor-pointer active:scale-95';
        }
      }
    }

    viewModeSplitBtn?.addEventListener('click', () => setViewMode('split'));
    viewModeSideBtn?.addEventListener('click', () => setViewMode('side'));

    // Controls Binding: Quality Slider
    qualitySlider?.addEventListener('input', () => {
      qualityPercent = parseInt(qualitySlider.value, 10);
      const level = qualityPercent > 85 ? 'Maximum' : qualityPercent > 70 ? 'Balanced' : qualityPercent > 40 ? 'Medium' : 'Low';
      if (qualityValDisplay) qualityValDisplay.textContent = `${qualityPercent}% (${level})`;
      triggerCompression();
    });

    qualityPills.forEach(pill => {
      pill.addEventListener('click', () => {
        const q = parseInt(pill.getAttribute('data-quality') || '75', 10);
        qualityPercent = q;
        if (qualitySlider) qualitySlider.value = String(q);
        const level = q > 85 ? 'Maximum' : q > 70 ? 'Balanced' : q > 40 ? 'Medium' : 'Low';
        if (qualityValDisplay) qualityValDisplay.textContent = `${q}% (${level})`;
        triggerCompression();
      });
    });

    // Controls Binding: Target Max Size Checkbox & Input
    enableTargetSize?.addEventListener('change', () => {
      if (enableTargetSize.checked) {
        targetSizeControls?.classList.remove('opacity-50', 'pointer-events-none');
        if (inputTargetSize && (!inputTargetSize.value || inputTargetSize.value === '0')) {
          inputTargetSize.value = '50';
          targetKb = 50;
        } else if (inputTargetSize) {
          targetKb = parseFloat(inputTargetSize.value) || 50;
        }
      } else {
        targetSizeControls?.classList.add('opacity-50', 'pointer-events-none');
        targetKb = null;
      }
      triggerCompression();
    });

    inputTargetSize?.addEventListener('input', () => {
      const val = parseFloat(inputTargetSize.value);
      targetKb = isNaN(val) ? null : val;
      triggerCompression();
    });

    sizeUnitKb?.addEventListener('click', () => {
      targetSizeUnit = 'KB';
      sizeUnitKb.className = 'px-2.5 py-1.5 rounded-md bg-white dark:bg-slate-800 text-slate-900 dark:text-white font-semibold cursor-pointer shadow-xs';
      if (sizeUnitMb) sizeUnitMb.className = 'px-2.5 py-1.5 rounded-md text-slate-600 dark:text-slate-400 cursor-pointer';
      triggerCompression();
    });

    sizeUnitMb?.addEventListener('click', () => {
      targetSizeUnit = 'MB';
      if (sizeUnitMb) sizeUnitMb.className = 'px-2.5 py-1.5 rounded-md bg-white dark:bg-slate-800 text-slate-900 dark:text-white font-semibold cursor-pointer shadow-xs';
      if (sizeUnitKb) sizeUnitKb.className = 'px-2.5 py-1.5 rounded-md text-slate-600 dark:text-slate-400 cursor-pointer';
      triggerCompression();
    });

    kbPresetPills.forEach(pill => {
      pill.addEventListener('click', () => {
        const kb = parseFloat(pill.getAttribute('data-kb') || '50');
        if (enableTargetSize) enableTargetSize.checked = true;
        targetSizeControls?.classList.remove('opacity-50', 'pointer-events-none');
        targetSizeUnit = 'KB';
        if (sizeUnitKb) sizeUnitKb.className = 'px-2.5 py-1.5 rounded-md bg-white dark:bg-slate-800 text-slate-900 dark:text-white font-semibold cursor-pointer shadow-xs';
        if (sizeUnitMb) sizeUnitMb.className = 'px-2.5 py-1.5 rounded-md text-slate-600 dark:text-slate-400 cursor-pointer';
        if (inputTargetSize) inputTargetSize.value = String(kb);
        targetKb = kb;
        triggerCompression();
      });
    });

    // Controls Binding: Output Format
    formatPills.forEach(pill => {
      pill.addEventListener('click', () => {
        const fmt = pill.getAttribute('data-format') || 'auto';
        outputFormat = fmt === 'jpeg' ? 'image/jpeg' : fmt === 'png' ? 'image/png' : fmt === 'webp' ? 'image/webp' : 'auto';
        updateFormatPillStyles(outputFormat);
        triggerCompression();
      });
    });

    // Controls Binding: Dimension inputs & aspect ratio
    aspectLockBtn?.addEventListener('click', () => {
      lockAspectRatio = !lockAspectRatio;
      if (lockAspectRatio) {
        aspectLockBtn.className = 'p-2.5 rounded-xl border border-slate-200 dark:border-slate-700 bg-blue-50 dark:bg-blue-950/40 text-blue-600 dark:text-blue-400 hover:border-blue-400 transition cursor-pointer';
        lockIconLocked?.classList.remove('hidden');
        lockIconUnlocked?.classList.add('hidden');
      } else {
        aspectLockBtn.className = 'p-2.5 rounded-xl border border-slate-200 dark:border-slate-700 bg-white dark:bg-slate-800 text-slate-400 hover:border-slate-400 transition cursor-pointer';
        lockIconLocked?.classList.add('hidden');
        lockIconUnlocked?.classList.remove('hidden');
      }
    });

    dimWidthInput?.addEventListener('input', () => {
      const item = queue.find(q => q.id === activeId);
      if (!item) return;
      const w = parseInt(dimWidthInput.value, 10);
      if (isNaN(w) || w <= 0) return;
      item.width = w;
      if (lockAspectRatio && item.origWidth > 0) {
        const ratio = item.origHeight / item.origWidth;
        item.height = Math.round(w * ratio);
        if (dimHeightInput) dimHeightInput.value = String(item.height);
      }
      triggerCompression();
    });

    dimHeightInput?.addEventListener('input', () => {
      const item = queue.find(q => q.id === activeId);
      if (!item) return;
      const h = parseInt(dimHeightInput.value, 10);
      if (isNaN(h) || h <= 0) return;
      item.height = h;
      if (lockAspectRatio && item.origHeight > 0) {
        const ratio = item.origWidth / item.origHeight;
        item.width = Math.round(h * ratio);
        if (dimWidthInput) dimWidthInput.value = String(item.width);
      }
      triggerCompression();
    });

    dimPresetPills.forEach(pill => {
      pill.addEventListener('click', () => {
        const item = queue.find(q => q.id === activeId);
        if (!item) return;
        const scale = parseFloat(pill.getAttribute('data-scale') || '1');
        item.width = Math.max(32, Math.round(item.origWidth * scale));
        item.height = Math.max(32, Math.round(item.origHeight * scale));
        if (dimWidthInput) dimWidthInput.value = String(item.width);
        if (dimHeightInput) dimHeightInput.value = String(item.height);
        triggerCompression();
      });
    });

    dimResetBtn?.addEventListener('click', () => {
      const item = queue.find(q => q.id === activeId);
      if (!item) return;
      item.width = item.origWidth;
      item.height = item.origHeight;
      if (dimWidthInput) dimWidthInput.value = String(item.width);
      if (dimHeightInput) dimHeightInput.value = String(item.height);
      triggerCompression();
    });

    optStripExif?.addEventListener('change', () => {
      stripExif = optStripExif.checked;
      triggerCompression();
    });

    // Single Download Action
    downloadSingleBtn?.addEventListener('click', () => {
      const item = queue.find(q => q.id === activeId);
      if (!item || !item.compressedBlob) return;

      const ext = item.outputMime === 'image/webp' ? '.webp' : item.outputMime === 'image/png' ? '.png' : '.jpg';
      const cleanName = item.name.replace(/\.[^/.]+$/, '');
      const downloadName = `${cleanName}-compressed${ext}`;

      const link = document.createElement('a');
      link.href = item.compressedUrl || URL.createObjectURL(item.compressedBlob);
      link.download = downloadName;
      document.body.appendChild(link);
      link.click();
      document.body.removeChild(link);
    });

    // Batch Download (ZIP) Action
    downloadBatchZipBtn?.addEventListener('click', async () => {
      if (queue.length === 0) return;
      const zip = new JSZip();
      const folder = zip.folder('compressed-images') || zip;

      const originalText = downloadBatchZipBtn.innerHTML;
      downloadBatchZipBtn.textContent = 'Generating ZIP...';

      for (let i = 0; i < queue.length; i++) {
        const item = queue[i];
        if (!item.compressedBlob) {
          await compressItem(item);
        }
        if (item.compressedBlob) {
          const ext = item.outputMime === 'image/webp' ? '.webp' : item.outputMime === 'image/png' ? '.png' : '.jpg';
          const cleanName = item.name.replace(/\.[^/.]+$/, '');
          folder.file(`${cleanName}-compressed${ext}`, item.compressedBlob);
        }
      }

      const zipBlob = await zip.generateAsync({ type: 'blob' });
      const link = document.createElement('a');
      link.href = URL.createObjectURL(zipBlob);
      link.download = 'fasttoolverse-compressed-images.zip';
      document.body.appendChild(link);
      link.click();
      document.body.removeChild(link);

      downloadBatchZipBtn.innerHTML = originalText;
    });

    // Handle Quick Preset Application from page cards
    document.querySelectorAll('.quick-preset-apply').forEach(btn => {
      btn.addEventListener('click', (e) => {
        e.preventDefault();
        const target = btn as HTMLElement;
        const kb = target.dataset.kb;
        const quality = target.dataset.quality;
        const fmt = target.dataset.format;

        if (kb && enableTargetSize && inputTargetSize) {
          enableTargetSize.checked = true;
          targetSizeControls?.classList.remove('opacity-50', 'pointer-events-none');
          inputTargetSize.value = kb;
          targetKb = parseFloat(kb);
        }

        if (quality && qualitySlider) {
          qualitySlider.value = quality;
          qualityPercent = parseInt(quality, 10);
        }

        if (fmt) {
          outputFormat = fmt;
          updateFormatPillStyles(fmt);
        }

        triggerCompression();

        // Scroll to editor workspace
        const workspace = document.getElementById('tool-workspace');
        if (workspace) {
          workspace.scrollIntoView({ behavior: 'smooth' });
        }
      });
    });
  }

  // Initialize on both DOMContentLoaded and astro:page-load (View Transitions support)
  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', initImageCompressor);
  } else {
    initImageCompressor();
  }
  document.addEventListener('astro:page-load', initImageCompressor);
</script>
