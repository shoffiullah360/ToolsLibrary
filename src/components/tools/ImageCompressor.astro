---
import ToolIcon from '../ToolIcon.astro';

interface Props {
  targetKb?: number;
  qualityPercent?: number;
  format?: 'auto' | 'png' | 'jpeg' | 'webp';
  maxWidth?: number;
  maxHeight?: number;
  maintainAspectRatio?: boolean;
}

const {
  targetKb,
  qualityPercent,
  format = 'auto',
  maxWidth,
  maxHeight,
  maintainAspectRatio = true
} = Astro.props;

const initialFormat = format === 'jpeg' ? 'image/jpeg' : format === 'png' ? 'image/png' : format === 'webp' ? 'image/webp' : 'auto';
const initialQuality = qualityPercent !== undefined ? qualityPercent : 75;
---

<!-- Interactive Studio Container -->
<section id="tool-workspace" class="max-w-6xl mx-auto px-4 sm:px-6 lg:px-8 pb-16 sm:pb-24 scroll-mt-20">
  <div
    id="image-compressor-root"
    class="w-full"
    data-preset-kb={targetKb !== undefined ? String(targetKb) : ""}
    data-preset-quality={qualityPercent !== undefined ? String(qualityPercent) : ""}
    data-preset-format={initialFormat}
    data-preset-max-width={maxWidth !== undefined ? String(maxWidth) : ""}
    data-preset-max-height={maxHeight !== undefined ? String(maxHeight) : ""}
    data-preset-aspect-ratio={maintainAspectRatio ? "true" : "false"}
  >

    <!-- INITIAL STATE: Drag & Drop Zone -->
    <div id="dropzone-view" class="transition-all duration-300">
      <div
        id="dropzone"
        class="relative group rounded-3xl border-2 border-dashed border-slate-300 dark:border-slate-700 hover:border-blue-500 dark:hover:border-blue-400 bg-white/70 dark:bg-slate-900/50 backdrop-blur-sm px-6 py-8 sm:px-10 sm:py-9 text-center cursor-pointer transition-all duration-200 hover:shadow-xl hover:shadow-blue-500/5 hover:-translate-y-0.5"
      >
        <input
          type="file"
          id="imageInput"
          class="hidden"
          accept="image/jpeg,image/png,image/webp,image/avif"
          multiple
        />

        <div class="max-w-lg mx-auto flex flex-col items-center">
          <!-- Batch Queue Pill -->
          <div class="inline-flex items-center gap-1.5 px-3 py-0.5 rounded-full text-xs font-semibold bg-blue-50 dark:bg-blue-950/40 text-blue-600 dark:text-blue-400 border border-blue-100 dark:border-blue-900/50 mb-3 shadow-2xs">
            <svg class="w-3.5 h-3.5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
              <path stroke-linecap="round" stroke-linejoin="round" d="M6 6.878V6a2.25 2.25 0 012.25-2.25h7.5A2.25 2.25 0 0118 6v.878m-12 0c.235-.083.487-.128.75-.128h10.5c.263 0 .515.045.75.128m-12 0A2.25 2.25 0 004.5 9v.878m13.5-3A2.25 2.25 0 0119.5 9v.878m-15 0a2.246 2.246 0 00-.75.128m16.5 0c-.235-.083-.487-.128-.75-.128m-15 0A2.25 2.25 0 003 12v6.75A2.25 2.25 0 005.25 21h13.5A2.25 2.25 0 0021 18.75V12a2.25 2.25 0 00-1.5-2.122" />
            </svg>
            <span>Batch Queue: Up to 15 Images</span>
          </div>

          <!-- Minimalist Icon -->
          <div class="w-12 h-12 rounded-xl bg-blue-50 dark:bg-blue-950/40 text-blue-600 dark:text-blue-400 flex items-center justify-center mb-3 group-hover:scale-110 transition-transform duration-200 shadow-sm border border-blue-100 dark:border-blue-900/50">
            <svg class="w-6 h-6" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.75">
              <path stroke-linecap="round" stroke-linejoin="round" d="M3 16.5v2.25A2.25 2.25 0 005.25 21h13.5A2.25 2.25 0 0021 18.75V16.5m-13.5-9L12 3m0 0l4.5 4.5M12 3v13.5" />
            </svg>
          </div>

          <!-- Headline & CTA -->
          <h3 class="text-lg sm:text-xl font-semibold text-slate-900 dark:text-white tracking-tight">
            <span class="sm:hidden">Tap to select photos or drag & drop</span>
            <span class="hidden sm:inline">Upload your images (up to 15)</span>
          </h3>
          <p class="mt-1 text-xs sm:text-sm text-slate-500 dark:text-slate-400">
            Supports JPG, PNG, WebP & AVIF. <span class="hidden sm:inline">Paste from clipboard </span><span class="hidden sm:inline-block">(<kbd class="px-1.5 py-0.5 text-xs font-mono bg-slate-100 dark:bg-slate-800 rounded border border-slate-200 dark:border-slate-700">Ctrl+V</kbd>)</span>
          </p>

          <!-- Primary Action Button -->
          <div class="mt-4 flex items-center justify-center">
            <button
              type="button"
              id="selectBtn"
              class="px-6 py-2.5 rounded-full bg-slate-900 hover:bg-slate-800 dark:bg-white dark:hover:bg-slate-100 text-white dark:text-slate-900 font-medium text-xs sm:text-sm transition-all shadow-md hover:shadow-lg active:scale-95 cursor-pointer"
            >
              Select Images (1–15)
            </button>
          </div>

          <!-- Privacy & Security Note -->
          <div class="mt-5 pt-3.5 border-t border-slate-200/70 dark:border-slate-800/80 w-full flex items-center justify-center">
            <div class="inline-flex items-center justify-center gap-1.5 font-medium text-emerald-600 dark:text-emerald-400 text-xs whitespace-nowrap">
              <svg class="w-3.5 h-3.5 shrink-0" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                <path stroke-linecap="round" stroke-linejoin="round" d="M9 12.75L11.25 15 15 9.75m-3-7.036A11.959 11.959 0 013.598 6 11.99 11.99 0 003 9.749c0 5.592 3.824 10.29 9 11.623 5.176-1.332 9-6.03 9-11.622 0-1.31-.21-2.571-.598-3.751h-.152c-3.196 0-6.1-1.248-8.25-3.285z" />
              </svg>
              <span>Images never leave your browser (100% Client-Side)</span>
            </div>
          </div>
        </div>
      </div>
    </div>

    <!-- ACTIVE STATE: Compression Workspace -->
    <div id="editor-view" class="hidden space-y-6">

      <!-- Top Queue Tray (Up to 15 items) -->
      <div class="rounded-2xl border border-slate-200/80 dark:border-slate-800 bg-white/80 dark:bg-slate-900/80 backdrop-blur-sm p-4 shadow-xs">
        <div class="flex items-center justify-between mb-3 px-1">
          <div class="flex items-center gap-2">
            <span class="text-xs font-semibold uppercase tracking-wider text-slate-500 dark:text-slate-400">
              Image Queue (<span id="queue-counter" class="font-mono font-bold text-blue-600 dark:text-blue-400">1/15</span>)
            </span>
            <span class="hidden sm:inline-block text-[11px] text-slate-400 font-normal">
              • Select an image to preview and adjust
            </span>
          </div>

          <div class="flex items-center gap-2">
            <button
              type="button"
              id="add-more-btn"
              class="inline-flex items-center gap-1 px-3 py-1 rounded-lg text-xs font-medium bg-slate-100 dark:bg-slate-800 hover:bg-slate-200 dark:hover:bg-slate-700 text-slate-700 dark:text-slate-200 transition cursor-pointer"
            >
              <span>+ Add More</span>
            </button>
            <button
              type="button"
              id="clear-all-btn"
              class="text-xs text-rose-500 hover:text-rose-600 dark:hover:text-rose-400 font-medium transition cursor-pointer px-2 py-1"
            >
              Clear All
            </button>
          </div>
        </div>

        <!-- Horizontal Scrollable Thumbnail Cards -->
        <div id="queue-strip" class="flex items-center gap-3 overflow-x-auto pb-2 pt-1 px-1 scroll-smooth">
          <!-- Dynamic thumbnails injected by JavaScript -->
        </div>
      </div>

      <!-- Main Studio Grid: Split Screen Comparison (Left) & Controls (Right) -->
      <div class="grid grid-cols-1 lg:grid-cols-12 gap-6">

        <!-- Left Column: Interactive Comparison Viewer (7 cols) -->
        <div class="lg:col-span-7 flex flex-col gap-4">
          
          <!-- Comparison Card -->
          <div class="rounded-2xl border border-slate-200/80 dark:border-slate-800 bg-white dark:bg-slate-900/60 p-4 sm:p-5 shadow-sm flex flex-col h-full">
            
            <!-- Viewer Header & Reduction Banner -->
            <div class="flex flex-wrap items-center justify-between gap-3 pb-3 border-b border-slate-100 dark:border-slate-800">
              <div class="min-w-0">
                <h4 id="active-filename" class="text-sm font-semibold text-slate-900 dark:text-white truncate max-w-xs sm:max-w-sm">
                  photo.jpg
                </h4>
                <p id="active-specs" class="text-xs text-slate-500 dark:text-slate-400 font-mono mt-0.5">
                  Original: 1920 × 1080 px • 240 KB
                </p>
              </div>

              <!-- Reduction Pill Badge -->
              <div id="reduction-badge" class="inline-flex items-center gap-1.5 px-3 py-1 rounded-full text-xs font-bold bg-emerald-50 dark:bg-emerald-950/60 text-emerald-600 dark:text-emerald-400 border border-emerald-200 dark:border-emerald-900/50 shadow-2xs">
                <span id="reduction-text">Saved 68% • 240 KB → 76 KB</span>
              </div>
            </div>

            <!-- Comparison Mode Toggle Buttons -->
            <div class="flex items-center justify-between py-2.5">
              <span class="text-xs font-medium text-slate-500 dark:text-slate-400">
                Comparison Mode:
              </span>
              <div class="inline-flex p-0.5 rounded-lg bg-slate-100 dark:bg-slate-800 border border-slate-200 dark:border-slate-700 text-xs font-medium">
                <button
                  type="button"
                  id="view-mode-split"
                  class="px-2.5 py-1 rounded-md bg-white dark:bg-slate-900 text-blue-600 dark:text-blue-400 shadow-2xs font-semibold cursor-pointer transition"
                >
                  Split Slider
                </button>
                <button
                  type="button"
                  id="view-mode-side"
                  class="px-2.5 py-1 rounded-md text-slate-600 dark:text-slate-400 hover:text-slate-900 dark:hover:text-white cursor-pointer transition"
                >
                  Side-by-Side
                </button>
              </div>
            </div>

            <!-- Stage 1: Interactive Draggable Split-Screen Slider -->
            <div
              id="split-slider-container"
              class="relative w-full max-h-[360px] h-[340px] sm:h-[360px] flex items-center justify-center overflow-hidden rounded-xl bg-slate-900/60 select-none border border-slate-200/80 dark:border-slate-800/80 touch-none cursor-ew-resize"
            >
              <!-- Original Image (Base Layer) -->
              <img
                id="preview-original-img"
                class="absolute inset-0 w-full h-full object-contain pointer-events-none select-none"
                alt="Original Image"
              />
              <span class="absolute top-3 right-3 px-2 py-0.5 text-[10px] font-bold uppercase tracking-wider bg-slate-900/80 text-white rounded backdrop-blur-xs z-10 pointer-events-none select-none shadow-xs">
                Original (<span id="slider-orig-size">240 KB</span>)
              </span>

              <!-- Compressed Image (Overlay Layer clipped by divider) -->
              <div
                id="split-compressed-wrapper"
                class="absolute inset-0 w-full h-full overflow-hidden pointer-events-none select-none"
                style="clip-path: inset(0 50% 0 0); -webkit-clip-path: inset(0 50% 0 0);"
              >
                <img
                  id="preview-compressed-img"
                  class="absolute inset-0 w-full h-full object-contain pointer-events-none select-none"
                  alt="Compressed Image"
                />
                <span class="absolute top-3 left-3 px-2 py-0.5 text-[10px] font-bold uppercase tracking-wider bg-blue-600/90 text-white rounded backdrop-blur-xs z-10 pointer-events-none select-none shadow-xs">
                  Compressed (<span id="slider-comp-size">76 KB</span>)
                </span>
              </div>

              <!-- Draggable Divider Line & Handle -->
              <div
                id="split-handle"
                class="absolute top-0 bottom-0 w-0.5 bg-white cursor-ew-resize z-20 shadow-[0_0_10px_rgba(0,0,0,0.5)] touch-none flex items-center justify-center pointer-events-none"
                style="left: 50%; transform: translateX(-50%);"
              >
                <div class="w-7 h-7 rounded-full bg-white dark:bg-slate-900 text-slate-800 dark:text-white border-2 border-blue-500 shadow-md flex items-center justify-center text-[10px] font-bold select-none pointer-events-auto cursor-ew-resize">
                  ◂▸
                </div>
              </div>

              <!-- Processing Overlay Spinner -->
              <div
                id="compression-spinner"
                class="hidden absolute inset-0 bg-slate-900/50 backdrop-blur-2xs z-30 flex flex-col items-center justify-center text-white text-xs gap-2"
              >
                <div class="w-8 h-8 border-3 border-white/20 border-t-blue-500 rounded-full animate-spin"></div>
                <span class="font-medium font-mono" id="spinner-status">Running binary quantization...</span>
              </div>
            </div>

            <!-- Stage 2: Side-by-Side Dual View (Hidden by default) -->
            <div id="side-by-side-container" class="hidden grid grid-cols-2 gap-3 w-full max-h-[360px] h-[340px] sm:h-[360px] overflow-hidden rounded-xl">
              <!-- Card 1: Original -->
              <div class="relative rounded-xl border border-slate-200 dark:border-slate-800 bg-slate-100 dark:bg-slate-950 overflow-hidden flex flex-col">
                <div class="p-2 border-b border-slate-200 dark:border-slate-800 flex items-center justify-between text-[11px] font-semibold text-slate-700 dark:text-slate-300">
                  <span>Original</span>
                  <span id="side-orig-size" class="font-mono text-slate-500">240 KB</span>
                </div>
                <div class="relative flex-1 p-2 flex items-center justify-center">
                  <img id="side-orig-img" class="max-w-full max-h-full object-contain" alt="Original" />
                </div>
              </div>

              <!-- Card 2: Compressed -->
              <div class="relative rounded-xl border border-blue-200 dark:border-blue-900/60 bg-blue-50/20 dark:bg-blue-950/20 overflow-hidden flex flex-col">
                <div class="p-2 border-b border-blue-100 dark:border-blue-900/50 flex items-center justify-between text-[11px] font-semibold text-blue-700 dark:text-blue-300">
                  <span>Compressed</span>
                  <span id="side-comp-size" class="font-mono font-bold text-emerald-600 dark:text-emerald-400">76 KB</span>
                </div>
                <div class="relative flex-1 p-2 flex items-center justify-center">
                  <img id="side-comp-img" class="max-w-full max-h-full object-contain" alt="Compressed" />
                </div>
              </div>
            </div>

            <!-- Slider Helper Instructions -->
            <div class="mt-3 flex items-center justify-between text-[11px] text-slate-500 dark:text-slate-400">
              <span class="flex items-center gap-1">
                <ToolIcon name="info" class="w-3.5 h-3.5 text-blue-500 shrink-0" />
                Drag the center divider to inspect fine photographic details and edge sharpness.
              </span>
              <span id="compression-time" class="font-mono text-[10px] text-slate-400">0.08s</span>
            </div>

          </div>

        </div>

        <!-- Right Column: Compression Controls Deck (5 cols) -->
        <div class="lg:col-span-5 flex flex-col gap-4">

          <!-- Control Box -->
          <div class="rounded-2xl border border-slate-200/80 dark:border-slate-800 bg-white dark:bg-slate-900/60 p-5 shadow-sm space-y-5">
            
            <!-- SECTION 1: Compression Quality (Visual Slider) -->
            <div class="space-y-3">
              <div class="flex items-center justify-between">
                <label for="quality-range" class="text-xs font-bold text-slate-800 dark:text-slate-200 flex items-center gap-1.5">
                  <ToolIcon name="scale" class="w-3.5 h-3.5 text-blue-500" />
                  <span>Compression Quality:</span>
                </label>
                <span id="quality-val-badge" class="px-2 py-0.5 rounded text-xs font-bold font-mono bg-blue-50 dark:bg-blue-950/60 text-blue-600 dark:text-blue-400 border border-blue-200 dark:border-blue-900/50">
                  {initialQuality}% - {initialQuality > 85 ? 'Maximum' : initialQuality > 65 ? 'High' : 'Balanced'}
                </span>
              </div>

              <div class="space-y-1.5">
                <input
                  type="range"
                  id="quality-range"
                  min="1"
                  max="100"
                  value={initialQuality}
                  step="1"
                  class="w-full h-2 bg-slate-200 dark:bg-slate-700 rounded-lg appearance-none cursor-pointer accent-blue-600"
                />
                <div class="flex justify-between text-[10px] font-mono text-slate-400 px-0.5">
                  <span>1% (Smallest Size)</span>
                  <span>50%</span>
                  <span>100% (Best Quality)</span>
                </div>
              </div>

              <!-- Quick Presets Pills (Quality) -->
              <div class="flex flex-wrap gap-1.5 pt-0.5">
                <button
                  type="button"
                  class="quality-preset-btn px-2.5 py-1 rounded-lg text-xs font-medium bg-slate-100 dark:bg-slate-800 hover:bg-blue-50 dark:hover:bg-blue-950/40 hover:text-blue-600 text-slate-700 dark:text-slate-300 border border-slate-200 dark:border-slate-700 transition cursor-pointer"
                  data-q="35"
                >
                  35% Aggressive
                </button>
                <button
                  type="button"
                  class="quality-preset-btn px-2.5 py-1 rounded-lg text-xs font-medium bg-slate-100 dark:bg-slate-800 hover:bg-blue-50 dark:hover:bg-blue-950/40 hover:text-blue-600 text-slate-700 dark:text-slate-300 border border-slate-200 dark:border-slate-700 transition cursor-pointer"
                  data-q="60"
                >
                  60% Balanced
                </button>
                <button
                  type="button"
                  class={`quality-preset-btn px-2.5 py-1 rounded-lg text-xs font-medium transition cursor-pointer ${
                    initialQuality === 75
                      ? 'bg-blue-50 dark:bg-blue-950/60 text-blue-600 dark:text-blue-400 border border-blue-200 dark:border-blue-900/50'
                      : 'bg-slate-100 dark:bg-slate-800 hover:bg-blue-50 dark:hover:bg-blue-950/40 hover:text-blue-600 text-slate-700 dark:text-slate-300 border border-slate-200 dark:border-slate-700'
                  }`}
                  data-q="75"
                >
                  75% High
                </button>
                <button
                  type="button"
                  class="quality-preset-btn px-2.5 py-1 rounded-lg text-xs font-medium bg-slate-100 dark:bg-slate-800 hover:bg-blue-50 dark:hover:bg-blue-950/40 hover:text-blue-600 text-slate-700 dark:text-slate-300 border border-slate-200 dark:border-slate-700 transition cursor-pointer"
                  data-q="92"
                >
                  92% Maximum
                </button>
              </div>
            </div>

            <!-- SECTION 2: Target File Size Limit (Optional Exact KB) -->
            <div class="pt-4 border-t border-slate-200/80 dark:border-slate-800 space-y-3">
              <div>
                <div class="flex items-center justify-between mb-1.5">
                  <label for="target-kb-input" class="text-xs font-bold text-slate-800 dark:text-slate-200 flex items-center gap-1.5">
                    <ToolIcon name="binary" class="w-3.5 h-3.5 text-blue-500" />
                    <span>Target Max File Size (Optional):</span>
                  </label>
                  <span class="text-[11px] font-mono text-blue-600 dark:text-blue-400">Strict Cap &le;</span>
                </div>

                <div class="relative rounded-xl border border-slate-300 dark:border-slate-700 focus-within:border-blue-500 dark:focus-within:border-blue-500 focus-within:ring-2 focus-within:ring-blue-500/20 bg-white dark:bg-slate-900/90 transition overflow-hidden">
                  <input
                    type="number"
                    id="target-kb-input"
                    min="5"
                    max="10000"
                    step="5"
                    value={targetKb !== undefined ? targetKb : ""}
                    class="w-full py-2.5 pl-4 pr-14 text-sm font-semibold font-mono text-slate-900 dark:text-slate-100 bg-transparent border-none focus:outline-hidden"
                    placeholder="e.g. 50"
                  />
                  <div class="absolute inset-y-0 right-0 pr-3.5 flex items-center pointer-events-none text-xs font-bold text-slate-400">
                    KB
                  </div>
                </div>
              </div>

              <!-- Quick Pills: 20 KB, 50 KB, 100 KB, 200 KB, 500 KB -->
              <div>
                <span class="block text-[11px] font-medium text-slate-500 dark:text-slate-400 mb-1.5">
                  Quick Standard Presets:
                </span>
                <div class="flex flex-wrap gap-1.5">
                  {[20, 50, 100, 200, 500].map((kb) => (
                    <button
                      type="button"
                      class={`preset-pill px-2.5 py-1 rounded-lg text-xs font-semibold transition cursor-pointer border ${
                        targetKb === kb
                          ? 'bg-blue-50 dark:bg-blue-950/60 text-blue-600 dark:text-blue-400 border-blue-200 dark:border-blue-900/50'
                          : 'bg-slate-100 dark:bg-slate-800 hover:bg-blue-50 dark:hover:bg-blue-950/40 hover:text-blue-600 text-slate-700 dark:text-slate-300 border-slate-200 dark:border-slate-700'
                      }`}
                      data-kb={kb}
                    >
                      {kb} KB
                    </button>
                  ))}
                </div>
              </div>

              <!-- Checkbox: Adaptive Dimension Scaling -->
              <div class="p-3 rounded-xl bg-slate-50 dark:bg-slate-950/50 border border-slate-200/80 dark:border-slate-800">
                <label class="flex items-start gap-2.5 cursor-pointer">
                  <input
                    type="checkbox"
                    id="opt-allow-downscale"
                    checked
                    class="w-4 h-4 rounded text-blue-600 border-slate-300 dark:border-slate-700 focus:ring-blue-500 mt-0.5 cursor-pointer"
                  />
                  <div class="text-xs">
                    <span class="font-semibold text-slate-800 dark:text-slate-200">Adaptive Dimension Scaling</span>
                    <p class="text-slate-500 dark:text-slate-400 mt-0.5 leading-relaxed text-[11px]">
                      Guarantees strict KB limits for large photos by proportionally downscaling pixel dimensions when compression alone cannot fit.
                    </p>
                  </div>
                </label>
              </div>
            </div>

            <!-- SECTION: Image Dimensions (Resolution) -->
            <div class="pt-4 border-t border-slate-200/80 dark:border-slate-800 space-y-3">
              <div class="flex items-center justify-between mb-1.5">
                <label class="text-xs font-bold text-slate-800 dark:text-slate-200 flex items-center gap-1.5">
                  <ToolIcon name="maximize-2" class="w-3.5 h-3.5 text-blue-500" />
                  <span>Image Dimensions (Resolution)</span>
                </label>
                <span id="current-res-badge" class="text-[11px] font-mono font-semibold text-blue-600 dark:text-blue-400">
                  {maxWidth && maxHeight ? `${maxWidth} × ${maxHeight} px` : '-- × -- px'}
                </span>
              </div>

              <!-- Width & Height Inputs Grid -->
              <div class="grid grid-cols-2 gap-3">
                <div>
                  <label for="dim-width-input" class="block text-[11px] font-medium text-slate-600 dark:text-slate-400 mb-1">
                    Width (px)
                  </label>
                  <div class="relative rounded-xl border border-slate-300 dark:border-slate-700 focus-within:border-blue-500 dark:focus-within:border-blue-500 focus-within:ring-2 focus-within:ring-blue-500/20 bg-white dark:bg-slate-900/90 transition overflow-hidden">
                    <input
                      type="number"
                      id="dim-width-input"
                      min="1"
                      max="10000"
                      step="1"
                      value={maxWidth !== undefined ? maxWidth : ""}
                      class="w-full py-2.5 pl-3.5 pr-10 text-xs font-semibold font-mono text-slate-900 dark:text-slate-100 bg-transparent border-none focus:outline-hidden"
                      placeholder="Width"
                    />
                    <div class="absolute inset-y-0 right-0 pr-3 flex items-center pointer-events-none text-[11px] font-bold text-slate-400">
                      px
                    </div>
                  </div>
                </div>

                <div>
                  <label for="dim-height-input" class="block text-[11px] font-medium text-slate-600 dark:text-slate-400 mb-1">
                    Height (px)
                  </label>
