        </div>

      </div>

    </div>

  </div>
</section>

<!-- Client-Side JavaScript Logic: 100% In-Browser Compression Engine -->
<script>
  import JSZip from 'jszip';

  interface QueueItem {
    id: string;
    file: File;
    name: string;
    originalSize: number;
    originalUrl: string;
    img: HTMLImageElement;
    origWidth: number;
    origHeight: number;
    width: number;
    height: number;
    compressedBlob: Blob | null;
    compressedUrl: string | null;
    compressedSize: number;
    outputMime: string;
    reductionPercent: number;
    processingTime: number;
  }

  // App State
  let queue: QueueItem[] = [];
  let activeIndex = 0;
  let targetKbValue: number | null = null;
  let qualityValue = 75; // 1-100
  let outputFormat = 'auto'; // 'auto' | 'image/jpeg' | 'image/webp' | 'image/png'
  let stripExif = true;
  let allowDownscale = true;
  let isSplitSliderDragging = false;
  let splitSliderPercent = 50;
  let isCompressing = false;

  // DOM Elements
  const rootEl = document.getElementById('image-compressor-root');
  const dropzoneView = document.getElementById('dropzone-view');
  const dropzone = document.getElementById('dropzone');
  const imageInput = document.getElementById('imageInput') as HTMLInputElement;
  const selectBtn = document.getElementById('selectBtn');
  const editorView = document.getElementById('editor-view');
  const queueCounter = document.getElementById('queue-counter');
  const queueStrip = document.getElementById('queue-strip');
  const addMoreBtn = document.getElementById('add-more-btn');
  const clearAllBtn = document.getElementById('clear-all-btn');

  // Preview elements
  const activeFilename = document.getElementById('active-filename');
  const activeSpecs = document.getElementById('active-specs');
  const reductionBadge = document.getElementById('reduction-badge');
  const reductionText = document.getElementById('reduction-text');
  const viewModeSplit = document.getElementById('view-mode-split');
  const viewModeSide = document.getElementById('view-mode-side');
  const splitSliderContainer = document.getElementById('split-slider-container');
  const sideBySideContainer = document.getElementById('side-by-side-container');
  const previewOriginalImg = document.getElementById('preview-original-img') as HTMLImageElement;
  const previewCompressedImg = document.getElementById('preview-compressed-img') as HTMLImageElement;
  const splitCompressedWrapper = document.getElementById('split-compressed-wrapper');
  const splitHandle = document.getElementById('split-handle');
  const sliderOrigSize = document.getElementById('slider-orig-size');
  const sliderCompSize = document.getElementById('slider-comp-size');
  const sideOrigSize = document.getElementById('side-orig-size');
  const sideCompSize = document.getElementById('side-comp-size');
  const sideOrigImg = document.getElementById('side-orig-img') as HTMLImageElement;
  const sideCompImg = document.getElementById('side-comp-img') as HTMLImageElement;
  const compressionSpinner = document.getElementById('compression-spinner');
  const spinnerStatus = document.getElementById('spinner-status');
  const compressionTime = document.getElementById('compression-time');

  // Controls elements
  const targetKbInput = document.getElementById('target-kb-input') as HTMLInputElement;
  const qualityRange = document.getElementById('quality-range') as HTMLInputElement;
  const qualityValBadge = document.getElementById('quality-val-badge');
  const optAllowDownscale = document.getElementById('opt-allow-downscale') as HTMLInputElement;
  const optStripExif = document.getElementById('opt-strip-exif') as HTMLInputElement;
  const formatSelect = document.getElementById('format-select') as HTMLSelectElement;
  const downloadSingleBtn = document.getElementById('download-single-btn');
  const downloadBatchZipBtn = document.getElementById('download-batch-zip-btn');
  const btnSingleSize = document.getElementById('btn-single-size');
  const btnBatchCount = document.getElementById('btn-batch-count');

  // Dimension Controls elements
  const dimWidthInput = document.getElementById('dim-width-input') as HTMLInputElement;
  const dimHeightInput = document.getElementById('dim-height-input') as HTMLInputElement;
  const optAspectRatio = document.getElementById('opt-aspect-ratio') as HTMLInputElement;
  const currentResBadge = document.getElementById('current-res-badge');
  const dimResetBtn = document.getElementById('dim-reset-btn');

  // Utility: Format bytes
  function formatBytes(bytes: number, decimals = 1): string {
    if (bytes === 0) return '0 B';
    const k = 1024;
    const dm = decimals < 0 ? 0 : decimals;
    const sizes = ['B', 'KB', 'MB', 'GB'];
    const i = Math.floor(Math.log(bytes) / Math.log(k));
    return parseFloat((bytes / Math.pow(k, i)).toFixed(dm)) + ' ' + sizes[i];
  }

  // Load Image File to HTMLImageElement
  function loadImage(file: File): Promise<{ img: HTMLImageElement; url: string; width: number; height: number }> {
    return new Promise((resolve, reject) => {
      const url = URL.createObjectURL(file);
      const img = new Image();
      img.onload = () => {
        resolve({ img, url, width: img.naturalWidth, height: img.naturalHeight });
      };
      img.onerror = () => {
        URL.revokeObjectURL(url);
        reject(new Error('Failed to load image'));
      };
      img.src = url;
    });
  }

  // Determine Destination MIME Type
  function getEffectiveMime(fileMime: string, chosenFormat: string): string {
    if (chosenFormat !== 'auto') {
      return chosenFormat;
    }
    if (fileMime === 'image/png') return 'image/png';
    if (fileMime === 'image/webp') return 'image/webp';
    return 'image/jpeg';
  }

  // Canvas toBlob Promise Wrapper
  function canvasToBlob(canvas: HTMLCanvasElement, mime: string, quality?: number): Promise<Blob> {
    return new Promise((resolve, reject) => {
      canvas.toBlob(
        (blob) => {
          if (blob) resolve(blob);
          else reject(new Error('Canvas toBlob returned null'));
        },
        mime,
        quality
      );
    });
  }

  // Core Compression Function
  async function compressQueueItem(item: QueueItem): Promise<{ calculatedQuality?: number }> {
    const startTime = performance.now();
    const targetMime = getEffectiveMime(item.file.type, outputFormat);

    async function encodeAt(scale: number, q: number): Promise<Blob> {
      const canvas = document.createElement('canvas');
      const curW = Math.max(16, Math.round(item.width * scale));
      const curH = Math.max(16, Math.round(item.height * scale));
      canvas.width = curW;
      canvas.height = curH;
      const ctx = canvas.getContext('2d');
      if (!ctx) throw new Error('Could not get 2d context');

      ctx.imageSmoothingEnabled = true;
      ctx.imageSmoothingQuality = 'high';

      if (targetMime === 'image/jpeg') {
        ctx.fillStyle = '#ffffff';
        ctx.fillRect(0, 0, curW, curH);
      } else {
        ctx.clearRect(0, 0, curW, curH);
      }

      ctx.drawImage(item.img, 0, 0, curW, curH);
      return await canvasToBlob(canvas, targetMime, q);
    }

    let finalBlob: Blob;
    let calculatedQuality: number | undefined;

    if (targetKbValue && targetKbValue > 0) {
      const targetBytes = targetKbValue * 1024;
      
      if (targetMime === 'image/png') {
        let scale = 1.0;
        let blob = await encodeAt(scale, 1.0);
        let bestScale = 1.0;
        if (blob.size > targetBytes && allowDownscale) {
          let minScale = 0.1;
          let maxScale = 1.0;
          for (let iter = 0; iter < 6; iter++) {
            const midScale = (minScale + maxScale) / 2;
            const testBlob = await encodeAt(midScale, 1.0);
            if (testBlob.size <= targetBytes) {
              blob = testBlob;
              bestScale = midScale;
              minScale = midScale;
            } else {
              maxScale = midScale;
            }
          }
        }
        finalBlob = blob;
        if (bestScale >= 1.0) {
          calculatedQuality = 95;
        } else if (bestScale >= 0.85) {
          calculatedQuality = Math.round(70 + ((bestScale - 0.85) / (1.0 - 0.85)) * 24);
        } else if (bestScale >= 0.70) {
          calculatedQuality = Math.round(40 + ((bestScale - 0.70) / (0.85 - 0.70)) * 29);
        } else {
          calculatedQuality = Math.max(1, Math.round(10 + (bestScale / 0.70) * 29));
        }
      } else {
        let minQ = 0.05;
        let maxQ = 0.98;
        let bestBlob: Blob | null = null;
        let bestQ = 0.5;
        let currentScale = 1.0;

        for (let iter = 0; iter < 6; iter++) {
          const midQ = (minQ + maxQ) / 2;
          const candidateBlob = await encodeAt(currentScale, midQ);

          if (candidateBlob.size <= targetBytes) {
            bestBlob = candidateBlob;
            bestQ = midQ;
            minQ = midQ;
          } else {
            maxQ = midQ;
          }
        }

        if ((!bestBlob || bestBlob.size > targetBytes) && allowDownscale) {
          let minScale = 0.15;
          let maxScale = 1.0;
          let scaledBestBlob: Blob | null = null;

          for (let scaleIter = 0; scaleIter < 5; scaleIter++) {
            const midScale = (minScale + maxScale) / 2;
            const candidateBlob = await encodeAt(midScale, 0.45);

            if (candidateBlob.size <= targetBytes) {
              scaledBestBlob = candidateBlob;
              minScale = midScale;
            } else {
              maxScale = midScale;
            }
          }

          if (scaledBestBlob) {
            finalBlob = scaledBestBlob;
            bestQ = 0.45;
          } else {
            finalBlob = bestBlob || (await encodeAt(currentScale, minQ));
          }
        } else {
          finalBlob = bestBlob || (await encodeAt(currentScale, minQ));
        }

        calculatedQuality = Math.round(bestQ * 100);
      }
    } else {
      if (targetMime === 'image/png') {
        finalBlob = await encodeAt(1.0, 1.0);
      } else {
        const qualityRatio = Math.max(0.01, Math.min(1.0, qualityValue / 100));
        finalBlob = await encodeAt(1.0, qualityRatio);
      }
    }

    const endTime = performance.now();
    const duration = ((endTime - startTime) / 1000).toFixed(2);

    if (item.compressedUrl) {
      URL.revokeObjectURL(item.compressedUrl);
    }

    item.compressedBlob = finalBlob;
    item.compressedSize = finalBlob.size;
    item.compressedUrl = URL.createObjectURL(finalBlob);
    item.processingTime = parseFloat(duration);

    const savedBytes = item.originalSize - item.compressedSize;
    item.reductionPercent = Math.round((savedBytes / item.originalSize) * 100);

    return { calculatedQuality };
  }

  // Update UI Elements with active image
  function updateActivePreview() {
    if (queue.length === 0 || !queue[activeIndex]) return;

    const item = queue[activeIndex];
    if (!item) return;

    if (activeFilename) activeFilename.textContent = item.name;
    if (activeSpecs) {
      if (item.width !== item.origWidth || item.height !== item.origHeight) {
        activeSpecs.textContent = `Original: ${item.origWidth} × ${item.origHeight} px • Target: ${item.width} × ${item.height} px • ${formatBytes(item.originalSize)}`;
      } else {
        activeSpecs.textContent = `Original: ${item.origWidth} × ${item.origHeight} px • ${formatBytes(item.originalSize)}`;
      }
    }

    if (dimWidthInput && document.activeElement !== dimWidthInput) {
      dimWidthInput.value = String(item.width);
    }
    if (dimHeightInput && document.activeElement !== dimHeightInput) {
      dimHeightInput.value = String(item.height);
    }
    if (currentResBadge) {
      currentResBadge.textContent = `${item.width} × ${item.height} px`;
    }

    if (reductionBadge && reductionText) {
      const isPositive = item.reductionPercent > 0;
      reductionBadge.className = isPositive
        ? "inline-flex items-center gap-1.5 px-3 py-1 rounded-full text-xs font-bold bg-emerald-50 dark:bg-emerald-950/60 text-emerald-600 dark:text-emerald-400 border border-emerald-200 dark:border-emerald-900/50 shadow-2xs"
        : "inline-flex items-center gap-1.5 px-3 py-1 rounded-full text-xs font-bold bg-slate-100 dark:bg-slate-800 text-slate-600 dark:text-slate-400 border border-slate-200 dark:border-slate-700 shadow-2xs";

      reductionText.textContent = isPositive
        ? `Saved ${item.reductionPercent}% • ${formatBytes(item.originalSize)} → ${formatBytes(item.compressedSize)}`
        : `${formatBytes(item.originalSize)} → ${formatBytes(item.compressedSize)}`;
    }

    if (previewOriginalImg) previewOriginalImg.src = item.originalUrl;
    if (previewCompressedImg && item.compressedUrl) previewCompressedImg.src = item.compressedUrl;
    if (sliderOrigSize) sliderOrigSize.textContent = formatBytes(item.originalSize);
    if (sliderCompSize) sliderCompSize.textContent = formatBytes(item.compressedSize);

    if (sideOrigImg) sideOrigImg.src = item.originalUrl;
    if (sideCompImg && item.compressedUrl) sideCompImg.src = item.compressedUrl;
    if (sideOrigSize) sideOrigSize.textContent = formatBytes(item.originalSize);
    if (sideCompSize) sideCompSize.textContent = formatBytes(item.compressedSize);

    if (compressionTime) compressionTime.textContent = `${item.processingTime}s`;
    if (btnSingleSize) btnSingleSize.textContent = formatBytes(item.compressedSize);
    if (btnBatchCount) {
      const totalCompressed = queue.reduce((acc, curr) => acc + (curr.compressedSize || curr.originalSize), 0);
      btnBatchCount.textContent = `${queue.length} file${queue.length > 1 ? 's' : ''} • ${formatBytes(totalCompressed)}`;
    }

    renderQueueStrip();
  }

  // Render Horizontal Queue Strip
  function renderQueueStrip() {
    if (!queueStrip) return;
    queueStrip.innerHTML = '';

    if (queueCounter) {
      queueCounter.textContent = `${queue.length > 0 ? activeIndex + 1 : 0}/${queue.length}`;
    }

    queue.forEach((item, idx) => {
      const card = document.createElement('div');
      const isActive = idx === activeIndex;
      card.className = `relative shrink-0 w-28 sm:w-32 rounded-xl p-2 cursor-pointer transition-all border ${
        isActive
          ? 'bg-blue-50/80 dark:bg-blue-950/40 border-blue-500 shadow-xs ring-2 ring-blue-500/20'
          : 'bg-white dark:bg-slate-900 border-slate-200 dark:border-slate-800 hover:border-slate-300 dark:hover:border-slate-700'
      }`;

      card.innerHTML = `
        <div class="relative w-full h-16 rounded-lg overflow-hidden bg-slate-100 dark:bg-slate-800 flex items-center justify-center mb-1.5">
          <img src="${item.originalUrl}" class="w-full h-full object-cover" alt="${item.name}" />
          ${
            item.compressedSize > 0
              ? `<span class="absolute bottom-1 right-1 text-[9px] font-mono font-bold bg-slate-900/80 text-white px-1.5 py-0.5 rounded backdrop-blur-2xs">${formatBytes(item.compressedSize)}</span>`
              : ''
          }
        </div>
        <div class="flex items-center justify-between text-[11px]">
          <span class="truncate font-medium text-slate-800 dark:text-slate-200 max-w-[70px]">${item.name}</span>
          <button type="button" class="btn-remove-item text-slate-400 hover:text-rose-500 dark:hover:text-rose-400 transition" data-idx="${idx}" title="Remove image">
            &times;
          </button>
        </div>
      `;

      card.addEventListener('click', (e) => {
        const target = e.target as HTMLElement;
        if (target.classList.contains('btn-remove-item') || target.closest('.btn-remove-item')) {
          e.stopPropagation();
          removeItem(idx);
          return;
        }
        activeIndex = idx;
        updateActivePreview();
      });

      queueStrip.appendChild(card);
    });
  }

  function removeItem(index: number) {
    if (index >= 0 && index < queue.length) {
      const [removed] = queue.splice(index, 1);
      if (removed.originalUrl) URL.revokeObjectURL(removed.originalUrl);
      if (removed.compressedUrl) URL.revokeObjectURL(removed.compressedUrl);
    }

    if (queue.length === 0) {
      if (editorView) editorView.classList.add('hidden');
      if (dropzoneView) dropzoneView.classList.remove('hidden');
      activeIndex = 0;
    } else {
      if (activeIndex >= queue.length) {
        activeIndex = queue.length - 1;
      }
      updateActivePreview();
    }
  }

  let needsRecompress = false;

  async function triggerCompression(showLoader = true) {
    if (queue.length === 0) return;
    if (isCompressing) {
      needsRecompress = true;
      return;
    }
    isCompressing = true;

    if (showLoader && compressionSpinner) {
      compressionSpinner.classList.remove('hidden');
      if (spinnerStatus) {
        spinnerStatus.textContent = targetKbValue ? 'Running binary quantization...' : 'Re-encoding canvas quality...';
      }
    }

    try {
      do {
        needsRecompress = false;
        const activeItem = queue[activeIndex];
        if (activeItem) {
          const res = await compressQueueItem(activeItem);
          if (targetKbValue && res && res.calculatedQuality !== undefined) {
            qualityValue = res.calculatedQuality;
            if (qualityRange) qualityRange.value = String(qualityValue);
            updateQualityBadge(qualityValue);
            updateQualityPills(qualityValue);
          }
          updateActivePreview();
        }

        const others = queue.filter((_, idx) => idx !== activeIndex);
        if (others.length > 0) {
          await Promise.all(others.map((item) => compressQueueItem(item)));
          renderQueueStrip();
        }
      } while (needsRecompress);
    } catch (err) {
      console.error('Compression failed:', err);
    } finally {
      isCompressing = false;
      if (compressionSpinner) {
        compressionSpinner.classList.add('hidden');
      }
    }
  }

  async function handleFiles(files: FileList | File[]) {
    const rawFiles = Array.from(files).filter((f) =>
      ['image/jpeg', 'image/jpg', 'image/png', 'image/webp', 'image/avif'].includes(f.type)
    );

    if (rawFiles.length === 0) return;

    const availableSlots = 15 - queue.length;
    if (availableSlots <= 0) {
      alert('Batch queue is full (maximum 15 images allowed).');
      return;
    }

    const filesToLoad = rawFiles.slice(0, availableSlots);

    const presetW = dimWidthInput && dimWidthInput.value ? parseInt(dimWidthInput.value, 10) : 0;
    const presetH = dimHeightInput && dimHeightInput.value ? parseInt(dimHeightInput.value, 10) : 0;

    for (const file of filesToLoad) {
      try {
        const { img, url, width, height } = await loadImage(file);
        let initW = width;
        let initH = height;

        if (presetW > 0 && presetH > 0) {
          initW = presetW;
          initH = presetH;
        } else if (presetW > 0) {
          initW = presetW;
          initH = Math.round((height / width) * presetW);
        } else if (presetH > 0) {
          initH = presetH;
          initW = Math.round((width / height) * presetH);
        }

        const item: QueueItem = {
          id: Math.random().toString(36).substring(2, 9),
          file,
          name: file.name,
          originalSize: file.size,
          originalUrl: url,
          img,
          origWidth: width,
          origHeight: height,
          width: initW,
          height: initH,
          compressedBlob: null,
          compressedUrl: null,
          compressedSize: 0,
          outputMime: file.type,
          reductionPercent: 0,
          processingTime: 0
        };
        queue.push(item);
      } catch (e) {
        console.error('Failed to load file:', file.name, e);
      }
    }

    if (queue.length > 0) {
      if (dropzoneView) dropzoneView.classList.add('hidden');
      if (editorView) editorView.classList.remove('hidden');
      await triggerCompression();
    }
  }

  if (dropzone) {
    ['dragenter', 'dragover'].forEach((eventName) => {
      dropzone.addEventListener(eventName, (e) => {
        e.preventDefault();
        e.stopPropagation();
        dropzone.classList.add('border-blue-500', 'scale-[1.01]');
      });
    });

    ['dragleave', 'drop'].forEach((eventName) => {
      dropzone.addEventListener(eventName, (e) => {
        e.preventDefault();
        e.stopPropagation();
        dropzone.classList.remove('border-blue-500', 'scale-[1.01]');
      });
    });

    dropzone.addEventListener('drop', (e) => {
      if (e.dataTransfer && e.dataTransfer.files && e.dataTransfer.files.length > 0) {
        handleFiles(e.dataTransfer.files);
      }
    });
  }

  dropzone?.addEventListener('click', () => imageInput?.click());
  selectBtn?.addEventListener('click', (e) => {
    e.stopPropagation();
    imageInput?.click();
  });
  addMoreBtn?.addEventListener('click', () => imageInput?.click());

  imageInput?.addEventListener('change', () => {
    if (imageInput.files && imageInput.files.length > 0) {
      handleFiles(imageInput.files);
      imageInput.value = '';
    }
  });

  window.addEventListener('paste', (e: ClipboardEvent) => {
    if (e.clipboardData && e.clipboardData.files && e.clipboardData.files.length > 0) {
      handleFiles(e.clipboardData.files);
    }
  });

  clearAllBtn?.addEventListener('click', () => {
    queue.forEach((item) => {
      if (item.originalUrl) URL.revokeObjectURL(item.originalUrl);
      if (item.compressedUrl) URL.revokeObjectURL(item.compressedUrl);
    });
    queue = [];
    activeIndex = 0;
    if (editorView) editorView.classList.add('hidden');
    if (dropzoneView) dropzoneView.classList.remove('hidden');
    if (dimWidthInput) dimWidthInput.value = '';
    if (dimHeightInput) dimHeightInput.value = '';
    if (currentResBadge) currentResBadge.textContent = '-- × -- px';
  });

  function updateQualityBadge(val: number) {
    if (!qualityValBadge) return;
    let label = 'Balanced';
    if (val >= 90) label = 'Maximum';
    else if (val >= 70) label = 'High';
    else if (val <= 35) label = 'Aggressive';
    qualityValBadge.textContent = `${val}% - ${label}`;
  }

  function updateQualityPills(val: number) {
    document.querySelectorAll('.quality-preset-btn').forEach((btn) => {
      const q = parseInt(btn.getAttribute('data-q') || '0', 10);
      if (q === val && !targetKbValue) {
        btn.className = "quality-preset-btn px-2.5 py-1 rounded-lg text-xs font-medium bg-blue-50 dark:bg-blue-950/60 text-blue-600 dark:text-blue-400 border border-blue-200 dark:border-blue-900/50 transition cursor-pointer";
      } else {
        btn.className = "quality-preset-btn px-2.5 py-1 rounded-lg text-xs font-medium bg-slate-100 dark:bg-slate-800 hover:bg-blue-50 dark:hover:bg-blue-950/40 hover:text-blue-600 text-slate-700 dark:text-slate-300 border border-slate-200 dark:border-slate-700 transition cursor-pointer";
      }
    });
  }

  function updateKbPills(val: number | null) {
    document.querySelectorAll('.preset-pill').forEach((btn) => {
      const kb = parseInt(btn.getAttribute('data-kb') || '0', 10);
      if (val && kb === val) {
        btn.className = "preset-pill px-2.5 py-1 rounded-lg text-xs font-semibold bg-blue-50 dark:bg-blue-950/60 text-blue-600 dark:text-blue-400 border border-blue-200 dark:border-blue-900/50 transition cursor-pointer";
      } else {
        btn.className = "preset-pill px-2.5 py-1 rounded-lg text-xs font-semibold bg-slate-100 dark:bg-slate-800 hover:bg-blue-50 dark:hover:bg-blue-950/40 hover:text-blue-600 text-slate-700 dark:text-slate-300 border border-slate-200 dark:border-slate-700 transition cursor-pointer";
      }
    });
  }

  qualityRange?.addEventListener('input', () => {
    targetKbValue = null;
    if (targetKbInput) targetKbInput.value = '';
    updateKbPills(null);

    qualityValue = parseInt(qualityRange.value, 10);
    updateQualityBadge(qualityValue);
    updateQualityPills(qualityValue);
    triggerCompression(false);
  });

  document.querySelectorAll('.quality-preset-btn').forEach((btn) => {
    btn.addEventListener('click', () => {
      const q = parseInt(btn.getAttribute('data-q') || '75', 10);
      targetKbValue = null;
      if (targetKbInput) targetKbInput.value = '';
      updateKbPills(null);

      qualityValue = q;
      if (qualityRange) qualityRange.value = String(q);
      updateQualityBadge(q);
      updateQualityPills(q);
      triggerCompression();
    });
  });

  targetKbInput?.addEventListener('input', () => {
    const raw = targetKbInput.value.trim();
    if (raw === '') {
      targetKbValue = null;
      updateKbPills(null);
    } else {
      const val = parseInt(raw, 10);
      if (!isNaN(val) && val > 0) {
        targetKbValue = val;
        updateKbPills(val);
      }
    }
    triggerCompression();
  });

  document.querySelectorAll('.preset-pill').forEach((btn) => {
    btn.addEventListener('click', () => {
      const kb = parseInt(btn.getAttribute('data-kb') || '50', 10);
      targetKbValue = kb;
      if (targetKbInput) targetKbInput.value = String(kb);
      updateKbPills(kb);
      triggerCompression();
    });
  });

  optAllowDownscale?.addEventListener('change', () => {
    allowDownscale = optAllowDownscale.checked;
    if (targetKbValue) {
      triggerCompression();
    }
  });

  formatSelect?.addEventListener('change', () => {
    outputFormat = formatSelect.value;
    triggerCompression();
  });

  optStripExif?.addEventListener('change', () => {
    stripExif = optStripExif.checked;
    triggerCompression();
  });

  function handleWidthChange(recompress: boolean = true) {
    if (queue.length === 0 || !queue[activeIndex]) return;
    const item = queue[activeIndex];
    const val = parseInt(dimWidthInput.value, 10);
    if (isNaN(val) || val <= 0) return;

    item.width = val;
    if (optAspectRatio?.checked && item.origWidth > 0) {
      const ratio = item.origHeight / item.origWidth;
      const computedH = Math.max(1, Math.round(val * ratio));
      item.height = computedH;
      if (dimHeightInput) dimHeightInput.value = String(computedH);
    }

    if (currentResBadge) {
      currentResBadge.textContent = `${item.width} × ${item.height} px`;
    }

    if (recompress) {
      triggerCompression();
    }
  }

  function handleHeightChange(recompress: boolean = true) {
    if (queue.length === 0 || !queue[activeIndex]) return;
    const item = queue[activeIndex];
    const val = parseInt(dimHeightInput.value, 10);
    if (isNaN(val) || val <= 0) return;

    item.height = val;
    if (optAspectRatio?.checked && item.origHeight > 0) {
      const ratio = item.origWidth / item.origHeight;
      const computedW = Math.max(1, Math.round(val * ratio));
      item.width = computedW;
      if (dimWidthInput) dimWidthInput.value = String(computedW);
    }

    if (currentResBadge) {
      currentResBadge.textContent = `${item.width} × ${item.height} px`;
    }

    if (recompress) {
      triggerCompression();
    }
  }

  dimWidthInput?.addEventListener('input', () => handleWidthChange(false));
  dimWidthInput?.addEventListener('change', () => handleWidthChange(true));
  dimHeightInput?.addEventListener('input', () => handleHeightChange(false));
  dimHeightInput?.addEventListener('change', () => handleHeightChange(true));

  document.querySelectorAll('.dim-preset-btn').forEach((btn) => {
    btn.addEventListener('click', () => {
      if (queue.length === 0 || !queue[activeIndex]) return;
      const targetW = parseInt(btn.getAttribute('data-width') || '1280', 10);
      const item = queue[activeIndex];
      item.width = targetW;
      if (optAspectRatio?.checked && item.origWidth > 0) {
        const ratio = item.origHeight / item.origWidth;
        item.height = Math.max(1, Math.round(targetW * ratio));
      }
      if (dimWidthInput) dimWidthInput.value = String(item.width);
      if (dimHeightInput) dimHeightInput.value = String(item.height);
      if (currentResBadge) currentResBadge.textContent = `${item.width} × ${item.height} px`;
      triggerCompression();
    });
  });

  dimResetBtn?.addEventListener('click', () => {
    if (queue.length === 0 || !queue[activeIndex]) return;
    const item = queue[activeIndex];
    item.width = item.origWidth;
    item.height = item.origHeight;
    if (dimWidthInput) dimWidthInput.value = String(item.width);
    if (dimHeightInput) dimHeightInput.value = String(item.height);
    if (currentResBadge) currentResBadge.textContent = `${item.width} × ${item.height} px`;
    triggerCompression();
  });

  function updateSplitSlider(clientX: number) {
    if (!splitSliderContainer || !splitCompressedWrapper || !splitHandle) return;
    const rect = splitSliderContainer.getBoundingClientRect();
    const x = Math.max(0, Math.min(clientX - rect.left, rect.width));
    splitSliderPercent = (x / rect.width) * 100;
    splitCompressedWrapper.style.clipPath = `inset(0 ${100 - splitSliderPercent}% 0 0)`;
    splitCompressedWrapper.style.setProperty('-webkit-clip-path', `inset(0 ${100 - splitSliderPercent}% 0 0)`);
    splitHandle.style.left = `${splitSliderPercent}%`;
  }

  splitSliderContainer?.addEventListener('pointerdown', (e) => {
    isSplitSliderDragging = true;
    splitSliderContainer.setPointerCapture(e.pointerId);
    updateSplitSlider(e.clientX);
  });

  splitSliderContainer?.addEventListener('pointermove', (e) => {
    if (isSplitSliderDragging) {
      updateSplitSlider(e.clientX);
    }
  });

  const stopSliderDrag = (e: PointerEvent) => {
    if (isSplitSliderDragging) {
      isSplitSliderDragging = false;
      try {
        splitSliderContainer?.releasePointerCapture(e.pointerId);
      } catch (_) {}
    }
  };

  splitSliderContainer?.addEventListener('pointerup', stopSliderDrag);
  splitSliderContainer?.addEventListener('pointercancel', stopSliderDrag);

  viewModeSplit?.addEventListener('click', () => {
    viewModeSplit.className = "px-2.5 py-1 rounded-md bg-white dark:bg-slate-900 text-blue-600 dark:text-blue-400 shadow-2xs font-semibold cursor-pointer transition";
    if (viewModeSide) {
      viewModeSide.className = "px-2.5 py-1 rounded-md text-slate-600 dark:text-slate-400 hover:text-slate-900 dark:hover:text-white cursor-pointer transition";
    }
    splitSliderContainer?.classList.remove('hidden');
    sideBySideContainer?.classList.add('hidden');
  });

  viewModeSide?.addEventListener('click', () => {
    viewModeSide.className = "px-2.5 py-1 rounded-md bg-white dark:bg-slate-900 text-blue-600 dark:text-blue-400 shadow-2xs font-semibold cursor-pointer transition";
    if (viewModeSplit) {
      viewModeSplit.className = "px-2.5 py-1 rounded-md text-slate-600 dark:text-slate-400 hover:text-slate-900 dark:hover:text-white cursor-pointer transition";
    }
    splitSliderContainer?.classList.add('hidden');
    sideBySideContainer?.classList.remove('hidden');
    sideBySideContainer?.classList.add('grid');
  });

  function downloadBlob(blob: Blob, filename: string) {
    const link = document.createElement('a');
    link.href = URL.createObjectURL(blob);
    link.download = filename;
    document.body.appendChild(link);
    link.click();
    document.body.removeChild(link);
    setTimeout(() => URL.revokeObjectURL(link.href), 1000);
  }

  downloadSingleBtn?.addEventListener('click', () => {
    if (queue.length === 0 || !queue[activeIndex]) return;
    const item = queue[activeIndex];
    if (!item.compressedBlob) return;

    let ext = 'jpg';
    const targetMime = getEffectiveMime(item.file.type, outputFormat);
    if (targetMime === 'image/png') ext = 'png';
    else if (targetMime === 'image/webp') ext = 'webp';

    const baseName = item.name.replace(/\.[^/.]+$/, '');
    const outName = `${baseName}-compressed.${ext}`;
    downloadBlob(item.compressedBlob, outName);
  });

  downloadBatchZipBtn?.addEventListener('click', async () => {
    if (queue.length === 0) return;
    try {
      const zip = new JSZip();
      for (let i = 0; i < queue.length; i++) {
        const item = queue[i];
        if (!item.compressedBlob) {
          await compressQueueItem(item);
        }
        if (item.compressedBlob) {
          let ext = 'jpg';
          const targetMime = getEffectiveMime(item.file.type, outputFormat);
          if (targetMime === 'image/png') ext = 'png';
          else if (targetMime === 'image/webp') ext = 'webp';

          const baseName = item.name.replace(/\.[^/.]+$/, '');
          const filename = `${baseName}-${i + 1}.${ext}`;
          zip.file(filename, item.compressedBlob);
        }
      }

      const zipBlob = await zip.generateAsync({ type: 'blob' });
      downloadBlob(zipBlob, 'fasttoolverse-compressed-images.zip');
    } catch (err) {
      console.error('Batch ZIP creation failed:', err);
      alert('Failed to generate ZIP archive. You can download individual images.');
    }
  });

  // Initialize preset settings from container data attributes
  if (rootEl) {
    const pKb = rootEl.getAttribute('data-preset-kb');
    if (pKb && pKb.trim() !== '') {
      const parsedKb = parseInt(pKb, 10);
      if (!isNaN(parsedKb) && parsedKb > 0) {
        targetKbValue = parsedKb;
        if (targetKbInput) targetKbInput.value = String(parsedKb);
        updateKbPills(parsedKb);
      }
    }
    const pQ = rootEl.getAttribute('data-preset-quality');
    if (pQ && pQ.trim() !== '') {
      const parsedQ = parseInt(pQ, 10);
      if (!isNaN(parsedQ) && parsedQ > 0) {
        qualityValue = parsedQ;
        if (qualityRange) qualityRange.value = String(parsedQ);
        updateQualityBadge(parsedQ);
        updateQualityPills(parsedQ);
      }
    }
    const pFmt = rootEl.getAttribute('data-preset-format');
    if (pFmt && pFmt !== 'auto') {
      outputFormat = pFmt;
      if (formatSelect) formatSelect.value = pFmt;
    }
    const pW = rootEl.getAttribute('data-preset-max-width');
    if (pW && pW.trim() !== '') {
      const parsedW = parseInt(pW, 10);
      if (!isNaN(parsedW) && parsedW > 0 && dimWidthInput) {
        dimWidthInput.value = String(parsedW);
      }
    }
    const pH = rootEl.getAttribute('data-preset-max-height');
    if (pH && pH.trim() !== '') {
      const parsedH = parseInt(pH, 10);
      if (!isNaN(parsedH) && parsedH > 0 && dimHeightInput) {
        dimHeightInput.value = String(parsedH);
      }
    }
    const pRatio = rootEl.getAttribute('data-preset-aspect-ratio');
    if (pRatio === 'false' && optAspectRatio) {
      optAspectRatio.checked = false;
    }
  }

  // Quick Preset card listeners on page (if present)
  document.querySelectorAll('.quick-preset-apply').forEach((btn) => {
    btn.addEventListener('click', () => {
      const kb = btn.getAttribute('data-kb');
      const q = btn.getAttribute('data-quality');
      const fmt = btn.getAttribute('data-format');

      if (kb) {
        const val = parseInt(kb, 10);
        targetKbValue = val;
        if (targetKbInput) targetKbInput.value = kb;
        updateKbPills(val);
      } else if (q) {
        targetKbValue = null;
        if (targetKbInput) targetKbInput.value = '';
        updateKbPills(null);
        qualityValue = parseInt(q, 10);
        if (qualityRange) qualityRange.value = q;
        updateQualityBadge(qualityValue);
        updateQualityPills(qualityValue);
      }

      if (fmt && formatSelect) {
        outputFormat = fmt;
        formatSelect.value = fmt;
      }

      const el = document.getElementById('tool-workspace');
      if (el) {
        el.scrollIntoView({ behavior: 'smooth' });
      }

      if (queue.length === 0 && imageInput) {
        setTimeout(() => imageInput.click(), 400);
      } else if (queue.length > 0) {
        triggerCompression();
      }
    });
  });
</script>
