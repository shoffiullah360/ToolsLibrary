---
import ToolIcon from '../ToolIcon.astro';

interface Props {
  targetKb?: number;
  qualityPercent?: number;
  format?: 'auto' | 'png' | 'jpeg' | 'webp';
  maxWidth?: number;
  maxHeight?: number;
  maintainAspectRatio?: boolean;
}

const {
  targetKb,
  qualityPercent,
  format = 'auto',
  maxWidth,
  maxHeight,
  maintainAspectRatio = true
} = Astro.props;

const initialFormat = format === 'jpeg' ? 'image/jpeg' : format === 'png' ? 'image/png' : format === 'webp' ? 'image/webp' : 'auto';
const initialQuality = qualityPercent !== undefined ? qualityPercent : 75;
---

<div
  id="image-compressor-root"
  class="w-full max-w-6xl mx-auto"
  data-preset-kb={targetKb !== undefined ? String(targetKb) : ""}
  data-preset-quality={qualityPercent !== undefined ? String(qualityPercent) : ""}
  data-preset-format={initialFormat}
  data-preset-max-width={maxWidth !== undefined ? String(maxWidth) : ""}
  data-preset-max-height={maxHeight !== undefined ? String(maxHeight) : ""}
  data-preset-aspect-ratio={maintainAspectRatio ? "true" : "false"}
>
  <!-- INITIAL STATE: Drag & Drop Zone (Matching Image Resizer Design) -->
  <div id="dropzone-view" class="transition-all duration-300">
    <div
      id="dropzone"
      class="relative group rounded-3xl border-2 border-dashed border-slate-300 dark:border-slate-700 hover:border-blue-500 dark:hover:border-blue-400 bg-white/70 dark:bg-slate-900/50 backdrop-blur-sm px-6 py-8 sm:px-10 sm:py-9 text-center cursor-pointer transition-all duration-200 hover:shadow-xl hover:shadow-blue-500/5 hover:-translate-y-0.5"
    >
      <input
        type="file"
        id="imageInput"
        class="hidden"
        accept="image/jpeg,image/png,image/webp,image/avif"
        multiple
      />

      <div class="max-w-lg mx-auto flex flex-col items-center">
        <!-- Batch Queue Pill -->
        <div class="inline-flex items-center gap-1.5 px-3 py-0.5 rounded-full text-xs font-semibold bg-blue-50 dark:bg-blue-950/40 text-blue-600 dark:text-blue-400 border border-blue-100 dark:border-blue-900/50 mb-3 shadow-2xs">
          <svg class="w-3.5 h-3.5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
            <path stroke-linecap="round" stroke-linejoin="round" d="M6 6.878V6a2.25 2.25 0 012.25-2.25h7.5A2.25 2.25 0 0118 6v.878m-12 0c.235-.083.487-.128.75-.128h10.5c.263 0 .515.045.75.128m-12 0A2.25 2.25 0 004.5 9v.878m13.5-3A2.25 2.25 0 0119.5 9v.878m-15 0a2.246 2.246 0 00-.75.128m16.5 0c-.235-.083-.487-.128-.75-.128m-15 0A2.25 2.25 0 003 12v6.75A2.25 2.25 0 005.25 21h13.5A2.25 2.25 0 0021 18.75V12a2.25 2.25 0 00-1.5-2.122" />
          </svg>
          <span>Batch Queue: Up to 15 Images</span>
        </div>

        <!-- Minimalist Icon -->
        <div class="w-12 h-12 rounded-xl bg-blue-50 dark:bg-blue-950/40 text-blue-600 dark:text-blue-400 flex items-center justify-center mb-3 group-hover:scale-110 transition-transform duration-200 shadow-sm border border-blue-100 dark:border-blue-900/50">
          <svg class="w-6 h-6" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.75">
            <path stroke-linecap="round" stroke-linejoin="round" d="M3 16.5v2.25A2.25 2.25 0 005.25 21h13.5A2.25 2.25 0 0021 18.75V16.5m-13.5-9L12 3m0 0l4.5 4.5M12 3v13.5" />
          </svg>
        </div>

        <!-- Headline & CTA -->
        <h3 class="text-lg sm:text-xl font-semibold text-slate-900 dark:text-white tracking-tight">
          <span class="sm:hidden">Tap to select photos or drag & drop</span>
          <span class="hidden sm:inline">Upload your images (up to 15)</span>
        </h3>
        <p class="mt-1 text-xs sm:text-sm text-slate-500 dark:text-slate-400">
          Supports JPG, PNG, WebP & AVIF. <span class="hidden sm:inline">Paste from clipboard </span><span class="hidden sm:inline-block">(<kbd class="px-1.5 py-0.5 text-xs font-mono bg-slate-100 dark:bg-slate-800 rounded border border-slate-200 dark:border-slate-700">Ctrl+V</kbd>)</span>
        </p>

        <!-- Primary Action Button -->
        <div class="mt-4 flex items-center justify-center">
          <button
            type="button"
            id="selectBtn"
            class="px-6 py-2.5 rounded-full bg-slate-900 hover:bg-slate-800 dark:bg-white dark:hover:bg-slate-100 text-white dark:text-slate-900 font-medium text-xs sm:text-sm transition-all shadow-md hover:shadow-lg active:scale-95 cursor-pointer"
          >
            Select Images (1–15)
          </button>
        </div>

        <!-- Privacy & Security Note -->
        <div class="mt-5 pt-3.5 border-t border-slate-200/70 dark:border-slate-800/80 w-full flex items-center justify-center">
          <div class="inline-flex items-center justify-center gap-1.5 font-medium text-emerald-600 dark:text-emerald-400 text-xs whitespace-nowrap">
            <svg class="w-3.5 h-3.5 shrink-0" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
              <path stroke-linecap="round" stroke-linejoin="round" d="M9 12.75L11.25 15 15 9.75m-3-7.036A11.959 11.959 0 013.598 6 11.99 11.99 0 003 9.749c0 5.592 3.824 10.29 9 11.623 5.176-1.332 9-6.03 9-11.622 0-1.31-.21-2.571-.598-3.751h-.152c-3.196 0-6.1-1.248-8.25-3.285z" />
            </svg>
            <span>Images never leave your browser (100% Client-Side)</span>
          </div>
        </div>
      </div>
    </div>
  </div>

  <!-- ACTIVE STATE: Two-Column Studio Layout -->
  <div id="editor-view" class="hidden">
    <!-- Top Thumbnail Strip (Batch Queue Up to 15 Images) -->
    <div class="mb-5 rounded-2xl border border-slate-200 dark:border-slate-800 bg-white/80 dark:bg-slate-900/80 backdrop-blur-sm p-3.5 shadow-xs">
      <div class="flex items-center justify-between mb-2.5 px-1">
        <div class="flex items-center gap-2">
          <span class="text-xs font-semibold uppercase tracking-wider text-slate-500 dark:text-slate-400">
            Upload your images (<span id="queue-counter" class="font-mono font-bold text-blue-600 dark:text-blue-400">1/15</span>)
          </span>
          <span class="hidden sm:inline-block text-[11px] text-slate-400 font-normal">
            • Click any card to edit image
          </span>
        </div>

        <div class="flex items-center gap-2">
          <button
            type="button"
            id="clear-all-btn"
            class="text-xs text-rose-500 hover:text-rose-600 dark:hover:text-rose-400 font-medium transition cursor-pointer"
          >
            Clear All
          </button>
        </div>
      </div>

      <!-- Horizontal Scrollable Thumbnail Strip -->
      <div id="queue-strip" class="flex items-center gap-2.5 overflow-x-auto pb-1.5 pt-0.5 px-0.5 no-scrollbar scroll-smooth">
        <!-- Rendered dynamically -->
      </div>
    </div>

    <!-- Active Image Details Bar -->
    <div class="mb-4 flex flex-wrap items-center justify-between gap-3">
      <div class="flex items-center gap-2.5 min-w-0">
        <span class="inline-flex items-center justify-center w-7 h-7 rounded-lg bg-blue-500/10 text-blue-600 dark:text-blue-400 text-xs font-semibold">
          IMG
        </span>
        <div class="min-w-0">
          <p id="source-filename" class="text-sm font-semibold text-slate-800 dark:text-slate-200 truncate max-w-[220px] sm:max-w-md">
            image.jpg
          </p>
          <p id="source-specs" class="text-xs text-slate-500 dark:text-slate-400 font-mono">
            Original: 1920 × 1080 px • 2.4 MB
          </p>
        </div>
      </div>

      <div class="flex items-center gap-2">
        <button
          type="button"
          id="upload-another-btn"
          class="inline-flex items-center gap-1.5 px-3 py-1.5 rounded-lg border border-slate-200 dark:border-slate-700 bg-white dark:bg-slate-800 text-xs font-medium text-slate-700 dark:text-slate-300 hover:bg-slate-50 dark:hover:bg-slate-700 transition cursor-pointer"
        >
          <svg class="w-3.5 h-3.5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
            <path stroke-linecap="round" stroke-linejoin="round" d="M12 4.5v15m7.5-7.5h-15" />
          </svg>
          Add Images
        </button>
      </div>
    </div>

    <!-- 2-Column Grid (Left: Preview & Comparison, Right: Controls & Download) -->
    <div class="grid grid-cols-1 lg:grid-cols-12 gap-6 lg:gap-8 items-start">
      
      <!-- LEFT COLUMN: Preview Canvas + Interactive Comparison (7 Cols) -->
      <div class="lg:col-span-7 flex flex-col gap-4">
        <div
          id="preview-stage-container"
          class="relative max-h-[260px] sm:max-h-[380px] h-[260px] sm:h-[380px] w-full flex items-center justify-center overflow-hidden rounded-xl sm:rounded-2xl border border-slate-200 dark:border-slate-800 bg-slate-100 dark:bg-slate-900/90 p-2 sm:p-4 shadow-sm group select-none"
        >
          <!-- Transparent checkerboard background -->
          <div
            class="absolute inset-0 opacity-40 dark:opacity-20 pointer-events-none"
            style="background-image: linear-gradient(45deg, #cbd5e1 25%, transparent 25%), linear-gradient(-45deg, #cbd5e1 25%, transparent 25%), linear-gradient(45deg, transparent 75%, #cbd5e1 75%), linear-gradient(-45deg, transparent 75%, #cbd5e1 75%); background-size: 16px 16px; background-position: 0 0, 0 8px, 8px -8px, -8px 0;"
          ></div>

          <!-- Status Overlays -->
          <div class="absolute top-2 left-2 sm:top-3 sm:left-3 z-25 flex items-center gap-1.5 pointer-events-none">
            <span id="preview-dim-pill" class="px-2 py-0.5 sm:px-2.5 sm:py-1 rounded-full text-[11px] sm:text-xs font-mono font-medium bg-slate-900/80 text-white backdrop-blur-md shadow-sm">
              1920 × 1080 px
            </span>
          </div>

          <div class="absolute top-2 right-2 sm:top-3 sm:right-3 z-25 flex items-center gap-1.5 pointer-events-none">
            <span id="preview-size-pill" class="px-2 py-0.5 sm:px-2.5 sm:py-1 rounded-full text-[11px] sm:text-xs font-mono font-medium bg-blue-600/90 text-white backdrop-blur-md shadow-sm">
              Est. ~150 KB
            </span>
            <span id="preview-savings-pill" class="px-2 py-0.5 sm:px-2.5 sm:py-1 rounded-full text-[11px] sm:text-xs font-mono font-bold bg-emerald-600 text-white shadow-sm">
              -60%
            </span>
          </div>

          <!-- Mode 1: Split Slider Comparison View (Active by default) -->
          <div
            id="split-slider-container"
            class="relative w-full h-full flex items-center justify-center overflow-hidden rounded-lg sm:rounded-xl touch-none select-none cursor-ew-resize z-10"
          >
            <!-- Original Image (Base Layer) -->
            <img
              id="preview-original-img"
              class="absolute inset-0 w-full h-full object-contain pointer-events-none select-none"
              alt="Original photo"
            />
            <span class="absolute bottom-2.5 right-2.5 px-2 py-0.5 text-[10px] font-bold uppercase tracking-wider bg-slate-900/80 text-white rounded backdrop-blur-xs z-15 pointer-events-none shadow-xs">
              Original (<span id="slider-orig-size">--</span>)
            </span>

            <!-- Compressed Image (Overlay Layer clipped by divider) -->
            <div
              id="split-compressed-wrapper"
              class="absolute inset-0 w-full h-full overflow-hidden pointer-events-none select-none"
              style="clip-path: inset(0 50% 0 0); -webkit-clip-path: inset(0 50% 0 0);"
            >
              <img
                id="preview-compressed-img"
                class="absolute inset-0 w-full h-full object-contain pointer-events-none select-none"
                alt="Compressed photo"
              />
              <span class="absolute bottom-2.5 left-2.5 px-2 py-0.5 text-[10px] font-bold uppercase tracking-wider bg-blue-600/90 text-white rounded backdrop-blur-xs z-15 pointer-events-none shadow-xs">
                Compressed (<span id="slider-comp-size">--</span>)
              </span>
            </div>

            <!-- Draggable Divider Line & Handle -->
            <div
              id="split-handle"
              class="absolute top-0 bottom-0 w-0.5 bg-white cursor-ew-resize z-20 shadow-[0_0_10px_rgba(0,0,0,0.5)] touch-none flex items-center justify-center pointer-events-none"
              style="left: 50%; transform: translateX(-50%);"
            >
              <div class="w-7 h-7 rounded-full bg-white dark:bg-slate-900 text-slate-800 dark:text-white border-2 border-blue-500 shadow-md flex items-center justify-center text-[10px] font-bold select-none pointer-events-auto cursor-ew-resize">
                ◂▸
              </div>
            </div>
          </div>

          <!-- Mode 2: Side-by-Side Dual View (Hidden by default) -->
          <div id="side-by-side-container" class="hidden grid grid-cols-2 gap-2.5 w-full h-full overflow-hidden z-10">
            <!-- Card 1: Original -->
            <div class="relative rounded-lg border border-slate-200 dark:border-slate-800 bg-white dark:bg-slate-950 overflow-hidden flex flex-col">
              <div class="p-1.5 border-b border-slate-200 dark:border-slate-800 flex items-center justify-between text-[10px] font-semibold text-slate-600 dark:text-slate-400">
                <span>Original</span>
                <span id="side-orig-size" class="font-mono text-slate-500">--</span>
              </div>
              <div class="relative flex-1 p-1 flex items-center justify-center overflow-hidden">
                <img id="side-orig-img" class="max-w-full max-h-full object-contain" alt="Original" />
              </div>
            </div>

            <!-- Card 2: Compressed -->
            <div class="relative rounded-lg border border-blue-200 dark:border-blue-900/60 bg-blue-50/20 dark:bg-blue-950/20 overflow-hidden flex flex-col">
              <div class="p-1.5 border-b border-blue-100 dark:border-blue-900/50 flex items-center justify-between text-[10px] font-semibold text-blue-600 dark:text-blue-400">
                <span>Compressed</span>
                <span id="side-comp-size" class="font-mono font-bold text-emerald-600 dark:text-emerald-400">--</span>
              </div>
              <div class="relative flex-1 p-1 flex items-center justify-center overflow-hidden">
                <img id="side-comp-img" class="max-w-full max-h-full object-contain" alt="Compressed" />
              </div>
            </div>
          </div>

          <!-- Processing Indicator Spinner -->
          <div id="canvas-loading" class="hidden absolute inset-0 z-30 bg-slate-900/40 backdrop-blur-[2px] flex items-center justify-center">
            <div class="flex items-center gap-2 px-4 py-2 rounded-xl bg-slate-900/90 text-white text-xs font-medium shadow-lg">
              <svg class="animate-spin h-4 w-4 text-blue-400" fill="none" viewBox="0 0 24 24">
                <circle class="opacity-25" cx="12" cy="12" r="10" stroke="currentColor" stroke-width="4"></circle>
                <path class="opacity-75" fill="currentColor" d="M4 12a8 8 0 018-8v8H4z"></path>
              </svg>
              <span id="canvas-loading-text">Optimizing Quality...</span>
            </div>
          </div>
        </div>

        <!-- Inline Toolbar (Mode switcher & timing) -->
        <div class="flex items-center justify-between px-3 py-2.5 rounded-xl border border-slate-200 dark:border-slate-800 bg-white/80 dark:bg-slate-900/80 backdrop-blur-sm text-xs">
          <div class="flex items-center gap-1.5 sm:gap-2">
            <span class="text-slate-400 font-medium mr-1 hidden sm:inline">Compare:</span>
            
            <button
              type="button"
              id="view-mode-split"
              class="inline-flex items-center gap-1 px-2.5 py-1.5 rounded-lg bg-blue-50 dark:bg-blue-950/40 text-blue-600 dark:text-blue-400 font-semibold border border-blue-100 dark:border-blue-900/50 transition cursor-pointer active:scale-95"
            >
              <span>Split Slider</span>
            </button>

            <button
              type="button"
              id="view-mode-side"
              class="inline-flex items-center gap-1 px-2.5 py-1.5 rounded-lg text-slate-700 dark:text-slate-300 hover:bg-slate-100 dark:hover:bg-slate-800 font-medium transition cursor-pointer active:scale-95"
            >
              <span>Side-by-Side</span>
            </button>
          </div>

          <div class="flex items-center gap-1.5 text-slate-500 dark:text-slate-400 font-mono text-[11px]">
            <span>Latency:</span>
            <span id="compression-time" class="text-blue-600 dark:text-blue-400 font-semibold">0.05s</span>
          </div>
        </div>
      </div>

      <!-- RIGHT COLUMN: Settings Card (Tabs) + Download Action (5 Cols) -->
      <div class="lg:col-span-5 flex flex-col gap-4 pb-20 sm:pb-0">
        
        <!-- Tabbed Settings Card -->
        <div class="rounded-2xl border border-slate-200 dark:border-slate-800 bg-white dark:bg-slate-900 p-5 sm:p-6 shadow-sm">
          
          <!-- Segmented Tabs Header -->
          <div class="flex p-1 bg-slate-100 dark:bg-slate-800/80 rounded-xl mb-5">
            <button
              type="button"
              id="tab-btn-compress"
              class="flex-1 py-2 text-xs font-semibold rounded-lg transition-all duration-200 cursor-pointer bg-white dark:bg-slate-700 text-slate-900 dark:text-white shadow-sm"
            >
              1. Compression Settings
            </button>
            <button
              type="button"
              id="tab-btn-export"
              class="flex-1 py-2 text-xs font-semibold rounded-lg transition-all duration-200 cursor-pointer text-slate-500 dark:text-slate-400 hover:text-slate-800 dark:hover:text-slate-200"
            >
              2. Output & Dimensions
            </button>
          </div>

          <!-- TAB 1: COMPRESSION SETTINGS -->
          <div id="tab-pane-compress" class="space-y-5">
            
            <!-- Live Savings Indicator Box -->
            <div class="p-3.5 rounded-xl border border-blue-100 dark:border-blue-900/40 bg-blue-50/50 dark:bg-blue-950/20">
              <div class="flex items-center justify-between text-xs">
                <span class="font-medium text-slate-600 dark:text-slate-400">File Size Savings:</span>
                <span id="savings-badge" class="px-2 py-0.5 rounded-full font-mono text-[11px] font-bold bg-emerald-100 dark:bg-emerald-950/60 text-emerald-600 dark:text-emerald-400 border border-emerald-200 dark:border-emerald-800">
                  -0% (0 KB Saved)
                </span>
              </div>
              <div class="mt-2 flex items-center justify-between text-xs font-mono">
                <span id="summary-orig-size" class="text-slate-500 dark:text-slate-400">Orig: 0 KB</span>
                <span class="text-slate-400 dark:text-slate-500">→</span>
                <span id="summary-comp-size" class="font-bold text-blue-600 dark:text-blue-400">Comp: 0 KB</span>
              </div>
              <!-- Progress / Savings meter bar -->
              <div class="mt-2.5 w-full bg-slate-200 dark:bg-slate-800 h-1.5 rounded-full overflow-hidden">
                <div id="savings-progress-bar" class="bg-gradient-to-r from-blue-500 to-emerald-500 h-full rounded-full transition-all duration-300" style="width: 100%;"></div>
              </div>
            </div>

            <!-- Target Max File Size (Strict KB Target) -->
            <div class="rounded-xl border border-slate-200 dark:border-slate-800 bg-slate-50/60 dark:bg-slate-800/40 p-3.5">
              <div class="flex items-center justify-between">
                <div class="flex items-center gap-2">
                  <input
                    type="checkbox"
                    id="enable-target-size"
                    class="w-4 h-4 rounded text-blue-600 focus:ring-blue-500 border-slate-300 dark:border-slate-700 cursor-pointer"
                  />
                  <label for="enable-target-size" class="text-xs font-semibold text-slate-800 dark:text-slate-200 cursor-pointer">
                    Target Max File Size
                  </label>
                </div>
                <span class="text-[11px] font-mono text-blue-600 dark:text-blue-400 font-medium">Precision Compression</span>
              </div>

              <div id="target-size-controls" class="opacity-50 pointer-events-none transition-opacity mt-3">
                <div class="flex items-center gap-2">
                  <div class="flex-1 relative">
                    <input
                      type="number"
                      id="input-target-size"
                      step="1"
                      min="1"
                      class="w-full px-3 py-2 rounded-lg border border-slate-200 dark:border-slate-700 bg-white dark:bg-slate-800 text-slate-900 dark:text-white font-mono text-sm focus:outline-none focus:ring-2 focus:ring-blue-500/30"
                      placeholder="50"
                    />
                  </div>

                  <!-- Unit switch [KB / MB] -->
                  <div class="flex p-0.5 bg-slate-200 dark:bg-slate-700 rounded-lg text-xs font-medium">
                    <button type="button" id="size-unit-kb" class="px-2.5 py-1.5 rounded-md bg-white dark:bg-slate-800 text-slate-900 dark:text-white font-semibold cursor-pointer shadow-xs">KB</button>
                    <button type="button" id="size-unit-mb" class="px-2.5 py-1.5 rounded-md text-slate-600 dark:text-slate-400 cursor-pointer">MB</button>
                  </div>
                </div>

                <!-- Quick Target KB Pills -->
                <div class="mt-2.5 flex flex-wrap gap-1.5">
                  <button type="button" class="kb-preset-pill px-2 py-0.5 rounded text-[11px] font-mono font-medium border border-slate-200 dark:border-slate-700 bg-white dark:bg-slate-800 text-slate-700 dark:text-slate-300 hover:border-blue-500 transition cursor-pointer" data-kb="10">10 KB</button>
                  <button type="button" class="kb-preset-pill px-2 py-0.5 rounded text-[11px] font-mono font-medium border border-slate-200 dark:border-slate-700 bg-white dark:bg-slate-800 text-slate-700 dark:text-slate-300 hover:border-blue-500 transition cursor-pointer" data-kb="20">20 KB</button>
                  <button type="button" class="kb-preset-pill px-2 py-0.5 rounded text-[11px] font-mono font-medium border border-slate-200 dark:border-slate-700 bg-white dark:bg-slate-800 text-slate-700 dark:text-slate-300 hover:border-blue-500 transition cursor-pointer" data-kb="50">50 KB</button>
                  <button type="button" class="kb-preset-pill px-2 py-0.5 rounded text-[11px] font-mono font-medium border border-slate-200 dark:border-slate-700 bg-white dark:bg-slate-800 text-slate-700 dark:text-slate-300 hover:border-blue-500 transition cursor-pointer" data-kb="100">100 KB</button>
                  <button type="button" class="kb-preset-pill px-2 py-0.5 rounded text-[11px] font-mono font-medium border border-slate-200 dark:border-slate-700 bg-white dark:bg-slate-800 text-slate-700 dark:text-slate-300 hover:border-blue-500 transition cursor-pointer" data-kb="200">200 KB</button>
                  <button type="button" class="kb-preset-pill px-2 py-0.5 rounded text-[11px] font-mono font-medium border border-slate-200 dark:border-slate-700 bg-white dark:bg-slate-800 text-slate-700 dark:text-slate-300 hover:border-blue-500 transition cursor-pointer" data-kb="500">500 KB</button>
                  <button type="button" class="kb-preset-pill px-2 py-0.5 rounded text-[11px] font-mono font-medium border border-slate-200 dark:border-slate-700 bg-white dark:bg-slate-800 text-slate-700 dark:text-slate-300 hover:border-blue-500 transition cursor-pointer" data-kb="1000">1 MB</button>
                </div>

                <p class="text-[11px] text-slate-500 dark:text-slate-400 mt-2 leading-relaxed">
                  Dynamic client-side binary search will compress quality and dimensions to stay strictly under this limit.
                </p>
              </div>
            </div>

            <!-- Quality Slider (Visual Compression Level) -->
            <div id="quality-slider-container">
