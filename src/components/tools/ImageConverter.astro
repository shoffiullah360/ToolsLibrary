---
import ToolIcon from '../ToolIcon.astro';

interface Props {
  initialTargetFormat?: 'webp' | 'avif' | 'jpeg' | 'png' | 'gif' | 'bmp' | 'ico' | 'pdf';
}

const { initialTargetFormat = 'webp' } = Astro.props;
---

<div id="image-converter-root" class="w-full max-w-6xl mx-auto" data-initial-format={initialTargetFormat}>
  <!-- 1. INITIAL STATE: Drag & Drop Zone -->
  <div id="converter-dropzone-view" class="transition-all duration-300">
    <div
      id="converter-dropzone"
      class="relative group rounded-3xl border-2 border-dashed border-slate-300 dark:border-slate-700 hover:border-blue-500 dark:hover:border-blue-400 bg-white/70 dark:bg-slate-900/50 backdrop-blur-sm px-6 py-10 sm:px-10 sm:py-12 text-center cursor-pointer transition-all duration-200 hover:shadow-xl hover:shadow-blue-500/5 hover:-translate-y-0.5"
    >
      <input
        type="file"
        id="converterFileInput"
        class="hidden"
        accept="image/jpeg,image/png,image/webp,image/avif,image/svg+xml,image/bmp,image/gif,image/x-icon,image/vnd.microsoft.icon,image/tiff,.jpg,.jpeg,.png,.webp,.avif,.svg,.bmp,.gif,.ico,.tif,.tiff"
        multiple
      />

      <div class="max-w-xl mx-auto flex flex-col items-center">
        <!-- Badge -->
        <div class="inline-flex items-center gap-1.5 px-3 py-1 rounded-full text-xs font-semibold bg-blue-50 dark:bg-blue-950/40 text-blue-600 dark:text-blue-400 border border-blue-100 dark:border-blue-900/50 mb-4 shadow-2xs">
          <ToolIcon name="repeat" class="w-3.5 h-3.5" />
          <span>Universal Client-Side Converter • Batch Ready</span>
        </div>

        <!-- Center Icon -->
        <div class="w-14 h-14 rounded-2xl bg-gradient-to-tr from-blue-600 to-indigo-600 text-white flex items-center justify-center mb-4 group-hover:scale-105 transition-transform duration-200 shadow-md shadow-blue-500/20">
          <svg class="w-7 h-7" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
            <path stroke-linecap="round" stroke-linejoin="round" d="M7 16a4 4 0 01-.88-7.903A5 5 0 1115.9 6L16 6a5 5 0 011 9.9M15 13l-3-3m0 0l-3 3m3-3v12" />
          </svg>
        </div>

        <!-- Headline & Subtitle -->
        <h2 class="text-xl sm:text-2xl font-bold text-slate-900 dark:text-white tracking-tight">
          Drop your images here, or browse files
        </h2>
        <p class="mt-2 text-xs sm:text-sm text-slate-500 dark:text-slate-400 leading-relaxed max-w-md">
          Supports <span class="font-semibold text-slate-700 dark:text-slate-300">JPG, PNG, WebP, AVIF, SVG, BMP, GIF, ICO & TIFF</span>. Or paste directly with <kbd class="px-1.5 py-0.5 text-xs font-mono bg-slate-100 dark:bg-slate-800 rounded border border-slate-200 dark:border-slate-700">Ctrl+V</kbd>.
        </p>

        <!-- CTA Button -->
        <div class="mt-5 flex flex-wrap items-center justify-center gap-3">
          <button
            type="button"
            id="converterSelectBtn"
            class="px-7 py-3 rounded-full bg-slate-900 hover:bg-slate-800 dark:bg-white dark:hover:bg-slate-100 text-white dark:text-slate-900 font-semibold text-sm transition-all shadow-md hover:shadow-lg active:scale-95 cursor-pointer flex items-center gap-2"
          >
            <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
              <path stroke-linecap="round" stroke-linejoin="round" d="M12 4.5v15m7.5-7.5h-15" />
            </svg>
            <span>Choose Images (Batch Mode)</span>
          </button>
        </div>

        <!-- Format Badges Strip -->
        <div class="mt-6 flex flex-wrap items-center justify-center gap-1.5 text-[11px] text-slate-500 dark:text-slate-400 font-mono">
          <span class="px-2 py-0.5 rounded bg-slate-100 dark:bg-slate-800 font-medium">JPG</span>
          <span class="px-2 py-0.5 rounded bg-slate-100 dark:bg-slate-800 font-medium">PNG</span>
          <span class="px-2 py-0.5 rounded bg-blue-50 dark:bg-blue-950/40 text-blue-600 dark:text-blue-400 font-medium">WEBP</span>
          <span class="px-2 py-0.5 rounded bg-purple-50 dark:bg-purple-950/40 text-purple-600 dark:text-purple-400 font-medium">AVIF</span>
          <span class="px-2 py-0.5 rounded bg-slate-100 dark:bg-slate-800 font-medium">SVG</span>
          <span class="px-2 py-0.5 rounded bg-slate-100 dark:bg-slate-800 font-medium">BMP</span>
          <span class="px-2 py-0.5 rounded bg-slate-100 dark:bg-slate-800 font-medium">GIF</span>
          <span class="px-2 py-0.5 rounded bg-slate-100 dark:bg-slate-800 font-medium">ICO</span>
          <span class="px-2 py-0.5 rounded bg-slate-100 dark:bg-slate-800 font-medium">TIFF</span>
          <span class="text-slate-400 dark:text-slate-500">→</span>
          <span class="px-2 py-0.5 rounded bg-rose-50 dark:bg-rose-950/40 text-rose-600 dark:text-rose-400 font-bold">PDF</span>
        </div>

        <!-- Privacy & Security Guarantee -->
        <div class="mt-6 pt-4 border-t border-slate-200/70 dark:border-slate-800/80 w-full flex items-center justify-center">
          <div class="inline-flex items-center gap-1.5 font-medium text-emerald-600 dark:text-emerald-400 text-xs">
            <ToolIcon name="shield-check" class="w-4 h-4" />
            <span>100% In-Browser Privacy • Zero Server Uploads • No 10MB Limits</span>
          </div>
        </div>
      </div>
    </div>
  </div>

  <!-- 2. ACTIVE STATE: Converter Workspace & Batch Queue -->
  <div id="converter-workspace" class="hidden space-y-6">
    <!-- Top Action Bar -->
    <div class="rounded-2xl border border-slate-200 dark:border-slate-800 bg-white dark:bg-slate-900 p-4 sm:p-5 shadow-xs">
      <div class="flex flex-col lg:flex-row lg:items-center justify-between gap-4">
        <!-- Left: Queue Counter & Add More -->
        <div class="flex items-center gap-3">
          <div class="flex items-center gap-2">
            <span class="inline-flex items-center justify-center w-8 h-8 rounded-xl bg-blue-500/10 text-blue-600 dark:text-blue-400 font-bold text-sm">
              <ToolIcon name="repeat" class="w-4 h-4" />
            </span>
            <div>
              <div class="flex items-center gap-2">
                <span class="text-sm font-bold text-slate-900 dark:text-white">Batch Queue</span>
                <span id="queue-count-badge" class="px-2 py-0.5 rounded-full text-xs font-semibold bg-blue-100 dark:bg-blue-900/60 text-blue-700 dark:text-blue-300 font-mono">
                  0 files
                </span>
              </div>
              <p class="text-xs text-slate-500 dark:text-slate-400">All conversions run locally in browser memory</p>
            </div>
          </div>
        </div>

        <!-- Right: Global Format Selector & Global Actions -->
        <div class="flex flex-wrap items-center gap-2.5">
          <!-- Convert All To Dropdown / Segmented -->
          <div class="relative inline-flex items-center gap-2 bg-slate-100 dark:bg-slate-800/80 p-1 rounded-xl border border-slate-200 dark:border-slate-700">
            <span class="text-xs font-semibold text-slate-600 dark:text-slate-300 pl-2">Convert all to:</span>
            <div class="relative">
              <select
                id="global-format-select"
                class="appearance-none bg-white dark:bg-slate-900 text-slate-900 dark:text-white font-bold text-xs py-1.5 pl-3 pr-8 rounded-lg border border-slate-200 dark:border-slate-700 focus:outline-hidden focus:ring-2 focus:ring-blue-500 cursor-pointer shadow-2xs"
              >
                <optgroup label="Modern Web">
                  <option value="webp" selected>WebP (Best Compression)</option>
                  <option value="avif">AVIF (Next-Gen)</option>
                </optgroup>
                <optgroup label="Universal Formats">
                  <option value="jpeg">JPG / JPEG (Universal)</option>
                  <option value="png">PNG (Lossless Alpha)</option>
                  <option value="gif">GIF (Web Graphics)</option>
                  <option value="bmp">BMP (Bitmap)</option>
                  <option value="ico">ICO (Windows & Favicon)</option>
                </optgroup>
                <optgroup label="Document Export">
                  <option value="pdf">PDF (Document / Multi-page)</option>
                </optgroup>
              </select>
              <div class="pointer-events-none absolute inset-y-0 right-0 flex items-center px-2 text-slate-500">
                <svg class="w-3.5 h-3.5" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7" /></svg>
              </div>
            </div>
          </div>

          <!-- Add More Button -->
          <button
            type="button"
            id="add-more-files-btn"
            class="inline-flex items-center gap-1.5 px-3 py-2 rounded-xl border border-slate-200 dark:border-slate-700 bg-white dark:bg-slate-800 text-xs font-semibold text-slate-700 dark:text-slate-300 hover:bg-slate-50 dark:hover:bg-slate-700 transition cursor-pointer shadow-2xs"
          >
            <svg class="w-3.5 h-3.5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M12 4.5v15m7.5-7.5h-15" /></svg>
            <span>Add More</span>
          </button>

          <!-- Clear All -->
          <button
            type="button"
            id="clear-all-queue-btn"
            class="inline-flex items-center gap-1 px-2.5 py-2 rounded-xl text-xs font-medium text-rose-600 dark:text-rose-400 hover:bg-rose-50 dark:hover:bg-rose-950/40 transition cursor-pointer"
          >
            <span>Clear All</span>
          </button>
        </div>
      </div>

      <!-- Action Buttons Row -->
      <div class="mt-4 pt-4 border-t border-slate-100 dark:border-slate-800 flex flex-wrap items-center justify-between gap-3">
        <div class="flex items-center gap-2">
          <!-- Convert All CTA -->
          <button
            type="button"
            id="convert-all-btn"
            class="inline-flex items-center gap-2 px-5 py-2.5 rounded-xl bg-blue-600 hover:bg-blue-700 text-white font-semibold text-xs sm:text-sm shadow-md shadow-blue-500/20 active:scale-95 transition-all cursor-pointer"
          >
            <ToolIcon name="zap" class="w-4 h-4" />
            <span id="convert-all-text">Convert All Images</span>
          </button>

          <!-- Auto-convert toggle -->
          <label class="hidden sm:inline-flex items-center gap-2 text-xs text-slate-600 dark:text-slate-400 select-none cursor-pointer ml-2">
            <input type="checkbox" id="auto-convert-toggle" checked class="w-4 h-4 text-blue-600 rounded border-slate-300 dark:border-slate-700 focus:ring-blue-500" />
            <span>Auto-convert on file upload</span>
          </label>
        </div>

        <div class="flex flex-wrap items-center gap-2">
          <!-- Multi-Page PDF Download (shown when multiple items or PDF selected) -->
          <button
            type="button"
            id="download-multi-pdf-btn"
            class="hidden inline-flex items-center gap-2 px-4 py-2.5 rounded-xl border border-rose-300 dark:border-rose-900/60 bg-rose-50 dark:bg-rose-950/40 text-rose-700 dark:text-rose-300 font-semibold text-xs hover:bg-rose-100 dark:hover:bg-rose-900/40 transition shadow-2xs cursor-pointer"
          >
            <ToolIcon name="file-text" class="w-4 h-4 text-rose-600 dark:text-rose-400" />
            <span>Combine All into 1 PDF</span>
          </button>

          <!-- Download All as ZIP CTA -->
          <button
            type="button"
            id="download-zip-btn"
            class="inline-flex items-center gap-2 px-5 py-2.5 rounded-xl bg-slate-900 hover:bg-slate-800 dark:bg-white dark:hover:bg-slate-100 text-white dark:text-slate-900 font-semibold text-xs sm:text-sm shadow-sm active:scale-95 transition-all cursor-pointer disabled:opacity-50 disabled:cursor-not-allowed"
          >
            <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
              <path stroke-linecap="round" stroke-linejoin="round" d="M3 16.5v2.25A2.25 2.25 0 005.25 21h13.5A2.25 2.25 0 0021 18.75V16.5M16.5 12L12 16.5m0 0L7.5 12m4.5 4.5V3" />
            </svg>
            <span id="download-zip-text">Download All as ZIP</span>
          </button>
        </div>
      </div>
    </div>

    <!-- 3. ADVANCED OPTIONS DRAWER (Collapsible Accordion) -->
    <div class="rounded-2xl border border-slate-200 dark:border-slate-800 bg-white dark:bg-slate-900 shadow-xs overflow-hidden transition-all duration-200">
      <button
        type="button"
        id="advanced-drawer-toggle"
        class="w-full px-5 py-4 flex items-center justify-between text-left hover:bg-slate-50 dark:hover:bg-slate-800/40 transition-colors cursor-pointer select-none"
        aria-expanded="false"
      >
        <div class="flex items-center gap-3">
          <div class="w-8 h-8 rounded-lg bg-indigo-50 dark:bg-indigo-950/40 text-indigo-600 dark:text-indigo-400 flex items-center justify-center border border-indigo-100 dark:border-indigo-900/40">
            <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
              <path stroke-linecap="round" stroke-linejoin="round" d="M10.5 6h9.75M10.5 6a1.5 1.5 0 11-3 0m3 0a1.5 1.5 0 10-3 0M3.75 6H7.5m3 12h9.75m-9.75 0a1.5 1.5 0 01-3 0m3 0a1.5 1.5 0 00-3 0m-3.75 0H7.5m9-6h3.75m-3.75 0a1.5 1.5 0 01-3 0m3 0a1.5 1.5 0 00-3 0m-9.75 0h9.75" />
            </svg>
          </div>
          <div>
            <div class="flex items-center gap-2">
              <span class="text-sm font-bold text-slate-900 dark:text-white">Advanced Options</span>
              <span id="drawer-summary-pill" class="px-2 py-0.5 text-[10px] font-semibold bg-slate-100 dark:bg-slate-800 text-slate-600 dark:text-slate-400 rounded-full">
                90% Quality • White Alpha Fill • Stripped EXIF
              </span>
            </div>
            <p class="text-xs text-slate-500 dark:text-slate-400">Quality compression, transparency fill, grayscale, and dimensions</p>
          </div>
        </div>

        <div class="flex items-center gap-2 text-slate-400">
          <span class="text-xs font-medium text-blue-600 dark:text-blue-400 sm:inline hidden" id="drawer-toggle-label">Customize</span>
          <svg id="drawer-chevron" class="w-4 h-4 transform transition-transform duration-200" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5">
            <path stroke-linecap="round" stroke-linejoin="round" d="M19.5 8.25l-7.5 7.5-7.5-7.5" />
          </svg>
        </div>
      </button>

      <!-- Accordion Body -->
      <div id="advanced-drawer-body" class="hidden px-5 pb-6 pt-2 border-t border-slate-100 dark:border-slate-800/80">
        <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6 pt-3">
          
          <!-- Option 1: Quality Slider -->
          <div class="space-y-3 p-4 rounded-xl bg-slate-50 dark:bg-slate-800/40 border border-slate-200/80 dark:border-slate-700/60">
            <div class="flex items-center justify-between">
              <label for="quality-range" class="text-xs font-bold text-slate-800 dark:text-slate-200">
                Quality Slider
              </label>
              <span id="quality-display-badge" class="px-2 py-0.5 rounded text-xs font-mono font-bold bg-blue-100 dark:bg-blue-900/60 text-blue-700 dark:text-blue-300">
                90%
              </span>
            </div>
            <input
              type="range"
              id="quality-range"
              min="10"
              max="100"
              value="90"
              step="1"
              class="w-full accent-blue-600 cursor-pointer"
            />
            <div class="flex justify-between text-[10px] text-slate-400 font-mono">
              <span>10% (Smallest)</span>
              <span>90% (Standard)</span>
              <span>100% (Max)</span>
            </div>
            <p class="text-[11px] text-slate-500 dark:text-slate-400 leading-tight">
              Calibrates quantization for WebP, JPG, AVIF & PDF. PNG/BMP/ICO outputs remain lossless.
            </p>
          </div>

          <!-- Option 2: Smart Transparency Fill -->
          <div class="space-y-3 p-4 rounded-xl bg-slate-50 dark:bg-slate-800/40 border border-slate-200/80 dark:border-slate-700/60">
            <div class="flex items-center justify-between">
              <label class="text-xs font-bold text-slate-800 dark:text-slate-200">
                Transparency Fill (Alpha)
              </label>
              <div class="flex items-center gap-1.5">
                <input
                  type="color"
                  id="transparency-color-picker"
                  value="#FFFFFF"
                  class="w-6 h-6 rounded cursor-pointer border border-slate-300 dark:border-slate-600 bg-transparent p-0"
                />
                <span id="color-hex-label" class="text-xs font-mono text-slate-600 dark:text-slate-400">#FFFFFF</span>
              </div>
            </div>
            <!-- Quick Color Presets -->
            <div class="flex items-center gap-1.5 pt-1">
              <button type="button" class="color-preset-btn px-2 py-1 text-[10px] font-medium rounded border border-slate-200 dark:border-slate-700 bg-white dark:bg-slate-900 text-slate-700 dark:text-slate-300 hover:border-blue-500 cursor-pointer" data-color="#FFFFFF">White</button>
              <button type="button" class="color-preset-btn px-2 py-1 text-[10px] font-medium rounded border border-slate-200 dark:border-slate-700 bg-slate-100 dark:bg-slate-800 text-slate-700 dark:text-slate-300 hover:border-blue-500 cursor-pointer" data-color="#F1F5F9">Light Gray</button>
              <button type="button" class="color-preset-btn px-2 py-1 text-[10px] font-medium rounded border border-slate-200 dark:border-slate-700 bg-slate-900 text-white hover:border-blue-500 cursor-pointer" data-color="#0F172A">Dark Slate</button>
              <button type="button" class="color-preset-btn px-2 py-1 text-[10px] font-medium rounded border border-slate-200 dark:border-slate-700 bg-black text-white hover:border-blue-500 cursor-pointer" data-color="#000000">Black</button>
            </div>
            <p class="text-[11px] text-slate-500 dark:text-slate-400 leading-tight">
              Fills transparent regions when converting transparent PNG/WebP/SVG to JPG or BMP.
            </p>
          </div>

          <!-- Option 3: Grayscale & EXIF -->
          <div class="space-y-4 p-4 rounded-xl bg-slate-50 dark:bg-slate-800/40 border border-slate-200/80 dark:border-slate-700/60">
            <!-- Grayscale Switch -->
            <div class="flex items-center justify-between">
              <div>
                <label for="grayscale-toggle" class="text-xs font-bold text-slate-800 dark:text-slate-200 cursor-pointer">
                  Grayscale (B&W)
                </label>
                <p class="text-[11px] text-slate-500 dark:text-slate-400">1-click black & white canvas filter</p>
              </div>
              <input
                type="checkbox"
                id="grayscale-toggle"
                class="w-4 h-4 text-blue-600 rounded border-slate-300 dark:border-slate-600 focus:ring-blue-500 cursor-pointer"
              />
            </div>

            <!-- Strip EXIF Checkbox -->
            <div class="pt-2 border-t border-slate-200/60 dark:border-slate-700/60 flex items-center justify-between">
              <div>
                <label for="strip-exif-toggle" class="text-xs font-bold text-slate-800 dark:text-slate-200 cursor-pointer">
                  Strip EXIF Metadata
                </label>
                <p class="text-[11px] text-slate-500 dark:text-slate-400">Removes camera GPS, model, and date info</p>
              </div>
              <input
                type="checkbox"
                id="strip-exif-toggle"
                checked
                class="w-4 h-4 text-blue-600 rounded border-slate-300 dark:border-slate-600 focus:ring-blue-500 cursor-pointer"
              />
            </div>
          </div>

          <!-- Option 4: Resize on Convert (Full Span on lg) -->
          <div class="md:col-span-2 lg:col-span-3 p-4 rounded-xl bg-slate-50 dark:bg-slate-800/40 border border-slate-200/80 dark:border-slate-700/60">
            <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-3 mb-3">
              <div>
                <span class="text-xs font-bold text-slate-800 dark:text-slate-200">Resize On Convert</span>
                <p class="text-[11px] text-slate-500 dark:text-slate-400">Downscale or set custom pixel dimensions concurrently with format conversion</p>
              </div>

              <!-- Resize Mode Selector -->
              <div class="inline-flex rounded-lg p-0.5 bg-slate-200/70 dark:bg-slate-700/60 text-xs font-medium">
                <button type="button" class="resize-mode-tab px-3 py-1 rounded-md text-slate-700 dark:text-slate-300 bg-white dark:bg-slate-900 shadow-2xs font-semibold cursor-pointer" data-mode="original">
                  Keep Original
                </button>
                <button type="button" class="resize-mode-tab px-3 py-1 rounded-md text-slate-600 dark:text-slate-400 hover:text-slate-900 dark:hover:text-white cursor-pointer" data-mode="percentage">
                  Scale %
                </button>
                <button type="button" class="resize-mode-tab px-3 py-1 rounded-md text-slate-600 dark:text-slate-400 hover:text-slate-900 dark:hover:text-white cursor-pointer" data-mode="custom">
                  Custom Px
                </button>
              </div>
            </div>

            <!-- Percentage Mode Controls -->
            <div id="resize-percentage-panel" class="hidden flex items-center gap-2 pt-2 border-t border-slate-200/60 dark:border-slate-700/60">
              <span class="text-xs font-medium text-slate-600 dark:text-slate-400">Downscale to:</span>
              <button type="button" class="scale-preset-btn px-3 py-1 rounded-lg text-xs font-semibold border border-slate-200 dark:border-slate-700 bg-white dark:bg-slate-900 hover:border-blue-500 text-slate-700 dark:text-slate-300 cursor-pointer" data-scale="0.75">75%</button>
              <button type="button" class="scale-preset-btn px-3 py-1 rounded-lg text-xs font-semibold border border-slate-200 dark:border-slate-700 bg-white dark:bg-slate-900 hover:border-blue-500 text-slate-700 dark:text-slate-300 cursor-pointer" data-scale="0.5">50%</button>
              <button type="button" class="scale-preset-btn px-3 py-1 rounded-lg text-xs font-semibold border border-slate-200 dark:border-slate-700 bg-white dark:bg-slate-900 hover:border-blue-500 text-slate-700 dark:text-slate-300 cursor-pointer" data-scale="0.25">25%</button>
              <span id="current-scale-label" class="text-xs font-mono text-blue-600 dark:text-blue-400 font-bold ml-2">75%</span>
            </div>

            <!-- Custom Dimensions Mode Controls -->
            <div id="resize-custom-panel" class="hidden flex flex-wrap items-center gap-3 pt-2 border-t border-slate-200/60 dark:border-slate-700/60">
              <div class="flex items-center gap-1.5">
                <label for="custom-width-input" class="text-xs font-medium text-slate-600 dark:text-slate-400">Width:</label>
                <input
                  type="number"
                  id="custom-width-input"
                  placeholder="e.g. 1920"
                  class="w-24 px-2.5 py-1 text-xs font-mono rounded-lg border border-slate-200 dark:border-slate-700 bg-white dark:bg-slate-900 text-slate-900 dark:text-white"
                />
                <span class="text-xs text-slate-400">px</span>
              </div>

              <!-- Aspect Ratio Lock Button -->
              <button
                type="button"
                id="aspect-ratio-lock-btn"
