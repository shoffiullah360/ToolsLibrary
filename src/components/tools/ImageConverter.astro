<!-- CLIENT-SIDE CONVERSION SCRIPT -->
<script>
  import JSZip from 'jszip';

  // Format mappings & metadata
  const EXT_MAP: Record<string, string> = {
    webp: '.webp',
    avif: '.avif',
    jpeg: '.jpg',
    png: '.png',
    gif: '.gif',
    bmp: '.bmp',
    ico: '.ico',
    pdf: '.pdf'
  };

  const MIME_MAP: Record<string, string> = {
    webp: 'image/webp',
    avif: 'image/avif',
    jpeg: 'image/jpeg',
    png: 'image/png',
    gif: 'image/gif',
    bmp: 'image/bmp',
    ico: 'image/x-icon',
    pdf: 'application/pdf'
  };

  interface QueueItem {
    id: string;
    file: File;
    name: string;
    originalSize: number;
    originalFormat: string;
    targetFormat: string;
    width: number;
    height: number;
    aspectRatio: number;
    sourceCanvas: HTMLCanvasElement;
    convertedBlob: Blob | null;
    convertedUrl: string | null;
    convertedSize: number | null;
    status: 'pending' | 'converting' | 'done' | 'error';
    errorMessage?: string;
  }

  // Pure JS BMP Encoder (24-bit uncompressed BMP)
  function canvasToBmpBlob(canvas: HTMLCanvasElement): Blob {
    const ctx = canvas.getContext('2d')!;
    const imgData = ctx.getImageData(0, 0, canvas.width, canvas.height);
    const { width, height, data } = imgData;
    const extraBytes = (4 - ((width * 3) % 4)) % 4;
    const rowSize = width * 3 + extraBytes;
    const imageSize = rowSize * height;
    const fileSize = 54 + imageSize;
    const buffer = new ArrayBuffer(fileSize);
    const view = new DataView(buffer);

    // BITMAPFILEHEADER (14 bytes)
    view.setUint16(0, 0x4D42, false); // 'BM'
    view.setUint32(2, fileSize, true);
    view.setUint16(6, 0, true);
    view.setUint16(8, 0, true);
    view.setUint32(10, 54, true); // Data offset

    // BITMAPINFOHEADER (40 bytes)
    view.setUint32(14, 40, true);
    view.setInt32(18, width, true);
    view.setInt32(22, height, true); // Bottom-up
    view.setUint16(26, 1, true); // Planes
    view.setUint16(28, 24, true); // 24-bit BGR
    view.setUint32(30, 0, true); // BI_RGB
    view.setUint32(34, imageSize, true);
    view.setInt32(38, 2835, true); // 72 DPI
    view.setInt32(42, 2835, true);
    view.setUint32(46, 0, true);
    view.setUint32(50, 0, true);

    const bytes = new Uint8Array(buffer);
    let pos = 54;
    for (let y = height - 1; y >= 0; y--) {
      for (let x = 0; x < width; x++) {
        const idx = (y * width + x) * 4;
        bytes[pos++] = data[idx + 2]; // B
        bytes[pos++] = data[idx + 1]; // G
        bytes[pos++] = data[idx];     // R
      }
      for (let p = 0; p < extraBytes; p++) {
        bytes[pos++] = 0;
      }
    }
    return new Blob([buffer], { type: 'image/bmp' });
  }

  // Pure JS ICO Encoder (Standard PNG payload container)
  async function canvasToIcoBlob(canvas: HTMLCanvasElement): Promise<Blob> {
    const pngBlob = await new Promise<Blob>((res) => canvas.toBlob((b) => res(b!), 'image/png'));
    const pngBuffer = await pngBlob.arrayBuffer();
    const pngBytes = new Uint8Array(pngBuffer);

    const width = canvas.width > 256 ? 256 : canvas.width;
    const height = canvas.height > 256 ? 256 : canvas.height;

    // ICONDIR (6 bytes) + ICONDIRENTRY (16 bytes)
    const header = new ArrayBuffer(22);
    const view = new DataView(header);
    view.setUint16(0, 0, true);
    view.setUint16(2, 1, true); // Type 1 = Icon
    view.setUint16(4, 1, true); // 1 Image

    view.setUint8(6, width === 256 ? 0 : width);
    view.setUint8(7, height === 256 ? 0 : height);
    view.setUint8(8, 0); // Palette count
    view.setUint8(9, 0); // Reserved
    view.setUint16(10, 1, true); // Color planes
    view.setUint16(12, 32, true); // 32 bits
    view.setUint32(14, pngBytes.byteLength, true); // Size
    view.setUint32(18, 22, true); // Offset

    return new Blob([header, pngBytes], { type: 'image/x-icon' });
  }

  // Pure JS Static GIF89a Encoder
  function canvasToGifBlob(canvas: HTMLCanvasElement): Blob {
    const ctx = canvas.getContext('2d')!;
    const imgData = ctx.getImageData(0, 0, canvas.width, canvas.height);
    const { width, height, data } = imgData;

    // Standard 3-3-2 bit uniform color palette (256 colors)
    const palette = new Uint8Array(256 * 3);
    for (let i = 0; i < 256; i++) {
      const r = ((i >> 5) & 0x07) * 36;
      const g = ((i >> 2) & 0x07) * 36;
      const b = (i & 0x03) * 85;
      palette[i * 3] = r;
      palette[i * 3 + 1] = g;
      palette[i * 3 + 2] = b;
    }

    // Map each pixel to closest palette index
    const indexedPixels = new Uint8Array(width * height);
    for (let i = 0; i < indexedPixels.length; i++) {
      const idx = i * 4;
      const r = data[idx];
      const g = data[idx + 1];
      const b = data[idx + 2];
      indexedPixels[i] = ((r & 0xE0) | ((g & 0xE0) >> 3) | (b >> 6));
    }

    // Assemble GIF89a header & descriptors
    const chunks: Uint8Array[] = [];

    // Header & Logical Screen Descriptor (13 bytes)
    const lsd = new Uint8Array([
      0x47, 0x49, 0x46, 0x38, 0x39, 0x61, // GIF89a
      width & 0xFF, (width >> 8) & 0xFF,
      height & 0xFF, (height >> 8) & 0xFF,
      0xF7, // Global Color Table Flag (1), 8 bits/pixel (256 colors)
      0x00, // Background color index
      0x00  // Pixel aspect ratio
    ]);
    chunks.push(lsd);
    chunks.push(palette);

    // Graphic Control Extension (8 bytes)
    const gce = new Uint8Array([
      0x21, 0xF9, 0x04, 0x00, 0x00, 0x00, 0x00, 0x00
    ]);
    chunks.push(gce);

    // Image Descriptor (10 bytes)
    const id = new Uint8Array([
      0x2C, 0x00, 0x00, 0x00, 0x00,
      width & 0xFF, (width >> 8) & 0xFF,
      height & 0xFF, (height >> 8) & 0xFF,
      0x00
    ]);
    chunks.push(id);

    // LZW Raster Data: Minimum Code Size = 8
    chunks.push(new Uint8Array([0x08]));

    // Simple uncompressed/clear-code sub-blocks
    // For universal compatibility, write indexed pixels in blocks of up to 254 bytes
    let offset = 0;
    while (offset < indexedPixels.length) {
      const blockSize = Math.min(254, indexedPixels.length - offset);
      const block = new Uint8Array(blockSize + 1);
      block[0] = blockSize;
      block.set(indexedPixels.subarray(offset, offset + blockSize), 1);
      chunks.push(block);
      offset += blockSize;
    }

    // Block Terminator (0x00) & GIF Trailer (0x3B)
    chunks.push(new Uint8Array([0x00, 0x3B]));

    return new Blob(chunks as unknown as BlobPart[], { type: 'image/gif' });
  }

  // Pure JS PDF 1.4 Document Generator (Single or Multi-Page)
  async function generatePdfBlobFromCanvases(canvases: HTMLCanvasElement[], quality: number = 0.92): Promise<Blob> {
    const images = await Promise.all(
      canvases.map(async (c) => {
        const flatCanvas = document.createElement('canvas');
        flatCanvas.width = c.width;
        flatCanvas.height = c.height;
        const fctx = flatCanvas.getContext('2d')!;
        fctx.fillStyle = '#FFFFFF';
        fctx.fillRect(0, 0, c.width, c.height);
        fctx.drawImage(c, 0, 0);

        const blob = await new Promise<Blob>((res) => flatCanvas.toBlob((b) => res(b!), 'image/jpeg', quality));
        const buffer = await blob.arrayBuffer();
        return {
          bytes: new Uint8Array(buffer),
          width: c.width,
          height: c.height
        };
      })
    );

    const encoder = new TextEncoder();
    const chunks: (Uint8Array | string)[] = [];
    const offsets: number[] = [];
    let currentOffset = 0;

    function writeString(str: string) {
      const encoded = encoder.encode(str);
      chunks.push(encoded);
      currentOffset += encoded.byteLength;
    }

    function writeBytes(bytes: Uint8Array) {
      chunks.push(bytes);
      currentOffset += bytes.byteLength;
    }

    writeString('%PDF-1.4\n%\xE2\xE3\xCF\xD3\n');

    const numPages = images.length;
    const totalObjs = 2 + numPages * 3;
    const pageObjIds: number[] = [];

    for (let i = 0; i < numPages; i++) {
      pageObjIds.push(3 * i + 3);
    }

    // Obj 1: Catalog
    offsets[1] = currentOffset;
    writeString(`1 0 obj\n<< /Type /Catalog /Pages 2 0 R >>\nendobj\n`);

    // Obj 2: Pages
    offsets[2] = currentOffset;
    const kidsStr = pageObjIds.map((id) => `${id} 0 R`).join(' ');
    writeString(`2 0 obj\n<< /Type /Pages /Kids [ ${kidsStr} ] /Count ${numPages} >>\nendobj\n`);

    for (let i = 0; i < numPages; i++) {
      const img = images[i];
      const pageId = 3 * i + 3;
      const imgId = 3 * i + 4;
      const contentId = 3 * i + 5;
      const w = img.width;
      const h = img.height;

      // Page Object
      offsets[pageId] = currentOffset;
      writeString(
        `${pageId} 0 obj\n<< /Type /Page /Parent 2 0 R /MediaBox [ 0 0 ${w} ${h} ] /Resources << /XObject << /Im1 ${imgId} 0 R >> >> /Contents ${contentId} 0 R >>\nendobj\n`
      );

      // Image XObject
      offsets[imgId] = currentOffset;
      const imgHeader = `${imgId} 0 obj\n<< /Type /XObject /Subtype /Image /Width ${w} /Height ${h} /ColorSpace /DeviceRGB /BitsPerComponent 8 /Filter /DCTDecode /Length ${img.bytes.byteLength} >>\nstream\n`;
      writeString(imgHeader);
      writeBytes(img.bytes);
      writeString('\nendstream\nendobj\n');

      // Contents Stream
      offsets[contentId] = currentOffset;
      const contentStr = `q\n${w} 0 0 ${h} 0 0 cm\n/Im1 Do\nQ\n`;
      const contentEncoded = encoder.encode(contentStr);
      writeString(`${contentId} 0 obj\n<< /Length ${contentEncoded.byteLength} >>\nstream\n${contentStr}endstream\nendobj\n`);
    }

    // Cross-reference table
    const xrefOffset = currentOffset;
    writeString(`xref\n0 ${totalObjs + 1}\n0000000000 65535 f \r\n`);
    for (let i = 1; i <= totalObjs; i++) {
      const off = offsets[i] || 0;
      const padded = String(off).padStart(10, '0');
      writeString(`${padded} 00000 n \r\n`);
    }

    // Trailer
    writeString(`trailer\n<< /Size ${totalObjs + 1} /Root 1 0 R >>\nstartxref\n${xrefOffset}\n%%EOF\n`);

    return new Blob(chunks as unknown as BlobPart[], { type: 'application/pdf' });
  }

  // Pure JS Baseline TIFF Parser Fallback
  async function parseTiffFallback(file: File): Promise<HTMLCanvasElement> {
    const buffer = await file.arrayBuffer();
    const view = new DataView(buffer);
    const isLittleEndian = view.getUint16(0) === 0x4949;

    const ifdOffset = view.getUint32(4, isLittleEndian);
    const numEntries = view.getUint16(ifdOffset, isLittleEndian);

    let width = 0;
    let height = 0;
    let stripOffset = 0;
    let stripBytes = 0;

    for (let i = 0; i < numEntries; i++) {
      const entryPos = ifdOffset + 2 + i * 12;
      const tag = view.getUint16(entryPos, isLittleEndian);
      const val = view.getUint32(entryPos + 8, isLittleEndian);

      if (tag === 256) width = val;
      else if (tag === 257) height = val;
      else if (tag === 273) stripOffset = val;
      else if (tag === 279) stripBytes = val;
    }

    if (!width || !height) throw new Error('Could not parse TIFF dimensions');

    const canvas = document.createElement('canvas');
    canvas.width = width;
    canvas.height = height;
    const ctx = canvas.getContext('2d')!;
    const imgData = ctx.createImageData(width, height);

    // Read uncompressed RGB or Grayscale bytes
    const rawData = new Uint8Array(buffer, stripOffset, Math.min(stripBytes || buffer.byteLength - stripOffset, buffer.byteLength - stripOffset));
    let srcPos = 0;
    for (let i = 0; i < width * height; i++) {
      const dstPos = i * 4;
      if (srcPos < rawData.length - 2) {
        imgData.data[dstPos] = rawData[srcPos++];
        imgData.data[dstPos + 1] = rawData[srcPos++];
        imgData.data[dstPos + 2] = rawData[srcPos++];
        imgData.data[dstPos + 3] = 255;
      }
    }
    ctx.putImageData(imgData, 0, 0);
    return canvas;
  }

  // Main Component Controller
  document.addEventListener('DOMContentLoaded', () => {
    const root = document.getElementById('image-converter-root');
    if (!root) return;

    let queue: QueueItem[] = [];
    let globalTargetFormat = (root.getAttribute('data-initial-format') || 'webp').toLowerCase();

    // DOM References
    const dropzoneView = document.getElementById('converter-dropzone-view');
    const dropzone = document.getElementById('converter-dropzone');
    const fileInput = document.getElementById('converterFileInput') as HTMLInputElement;
    const selectBtn = document.getElementById('converterSelectBtn');
    const workspace = document.getElementById('converter-workspace');
    const queueList = document.getElementById('queue-items-list');
    const queueCountBadge = document.getElementById('queue-count-badge');
    const queueCountSub = document.getElementById('queue-count-sub');
    const globalFormatSelect = document.getElementById('global-format-select') as HTMLSelectElement;
    const addMoreBtn = document.getElementById('add-more-files-btn');
    const clearAllBtn = document.getElementById('clear-all-queue-btn');
    const convertAllBtn = document.getElementById('convert-all-btn');
    const convertAllText = document.getElementById('convert-all-text');
    const downloadZipBtn = document.getElementById('download-zip-btn') as HTMLButtonElement;
    const downloadZipText = document.getElementById('download-zip-text');
    const downloadMultiPdfBtn = document.getElementById('download-multi-pdf-btn');
    const autoConvertToggle = document.getElementById('auto-convert-toggle') as HTMLInputElement;

    // Advanced Drawer DOM
    const drawerToggle = document.getElementById('advanced-drawer-toggle');
    const drawerBody = document.getElementById('advanced-drawer-body');
    const drawerChevron = document.getElementById('drawer-chevron');
    const drawerSummaryPill = document.getElementById('drawer-summary-pill');
    const qualityRange = document.getElementById('quality-range') as HTMLInputElement;
    const qualityDisplayBadge = document.getElementById('quality-display-badge');
    const transparencyColorPicker = document.getElementById('transparency-color-picker') as HTMLInputElement;
    const colorHexLabel = document.getElementById('color-hex-label');
    const grayscaleToggle = document.getElementById('grayscale-toggle') as HTMLInputElement;
    const stripExifToggle = document.getElementById('strip-exif-toggle') as HTMLInputElement;

    // Resize controls
    const resizeModeTabs = document.querySelectorAll('.resize-mode-tab');
    const resizePercentagePanel = document.getElementById('resize-percentage-panel');
    const resizeCustomPanel = document.getElementById('resize-custom-panel');
    const scalePresetBtns = document.querySelectorAll('.scale-preset-btn');
    const currentScaleLabel = document.getElementById('current-scale-label');
    const customWidthInput = document.getElementById('custom-width-input') as HTMLInputElement;
    const customHeightInput = document.getElementById('custom-height-input') as HTMLInputElement;
    const aspectRatioLockBtn = document.getElementById('aspect-ratio-lock-btn');

    let currentResizeMode: 'original' | 'percentage' | 'custom' = 'original';
    let currentScale = 0.75;
    let isAspectRatioLocked = true;
    let customWidth = 0;
    let customHeight = 0;

    // Preview Modal DOM
    const previewModal = document.getElementById('preview-modal') as HTMLDialogElement;
    const modalCloseBtn = document.getElementById('modal-close-btn');
    const modalPreviewImg = document.getElementById('modal-preview-img') as HTMLImageElement;
    const modalTitle = document.getElementById('modal-title');
    const modalFormatBadge = document.getElementById('modal-format-badge');
    const modalSpecsLabel = document.getElementById('modal-specs-label');
    const modalDownloadBtn = document.getElementById('modal-download-btn');
    let activeModalItem: QueueItem | null = null;

    // Format file size helper
    function formatBytes(bytes: number): string {
      if (bytes === 0) return '0 B';
      const k = 1024;
      const sizes = ['B', 'KB', 'MB', 'GB'];
      const i = Math.floor(Math.log(bytes) / Math.log(k));
      return `${parseFloat((bytes / Math.pow(k, i)).toFixed(1))} ${sizes[i]}`;
    }

    // Detect format from file
    function detectFormat(file: File): string {
      const ext = file.name.split('.').pop()?.toUpperCase() || '';
      if (file.type.includes('png')) return 'PNG';
      if (file.type.includes('jpeg') || file.type.includes('jpg')) return 'JPG';
      if (file.type.includes('webp')) return 'WEBP';
      if (file.type.includes('avif')) return 'AVIF';
      if (file.type.includes('svg')) return 'SVG';
      if (file.type.includes('bmp')) return 'BMP';
      if (file.type.includes('gif')) return 'GIF';
      if (file.type.includes('icon') || file.type.includes('ico')) return 'ICO';
      if (file.type.includes('tiff') || ext === 'TIF' || ext === 'TIFF') return 'TIFF';
      return ext || 'IMG';
    }

    // Decode File into HTMLCanvasElement
    async function decodeImageToCanvas(file: File): Promise<{ canvas: HTMLCanvasElement; width: number; height: number }> {
      // 1. Try standard browser image element or createImageBitmap
      try {
        if (file.type.includes('tiff') || file.name.match(/\.tiff?$/i)) {
          try {
            return await parseTiffFallback(file).then(c => ({ canvas: c, width: c.width, height: c.height }));
          } catch {
            // fallback to standard image
          }
        }

        const url = URL.createObjectURL(file);
        const img = new Image();
        img.src = url;
        await new Promise((resolve, reject) => {
          img.onload = resolve;
          img.onerror = reject;
        });

        const width = img.naturalWidth || img.width || 1200;
        const height = img.naturalHeight || img.height || 800;

        const canvas = document.createElement('canvas');
        canvas.width = width;
        canvas.height = height;
        const ctx = canvas.getContext('2d')!;
        ctx.drawImage(img, 0, 0);

        URL.revokeObjectURL(url);
        return { canvas, width, height };
      } catch (err) {
        throw new Error(`Failed to decode image: ${(err as Error).message}`);
      }
    }

    // Render converted canvas applying resize, grayscale, transparency fill
    function renderConvertedCanvas(item: QueueItem): HTMLCanvasElement {
      let targetW = item.width;
      let targetH = item.height;

      if (currentResizeMode === 'percentage') {
        targetW = Math.max(1, Math.round(item.width * currentScale));
        targetH = Math.max(1, Math.round(item.height * currentScale));
      } else if (currentResizeMode === 'custom' && customWidth > 0 && customHeight > 0) {
        targetW = customWidth;
        targetH = customHeight;
      }

      const canvas = document.createElement('canvas');
      canvas.width = targetW;
      canvas.height = targetH;
      const ctx = canvas.getContext('2d')!;

      // Handle Transparency Fill for formats without alpha (JPG / BMP)
      const isOpaqueTarget = item.targetFormat === 'jpeg' || item.targetFormat === 'bmp';
      if (isOpaqueTarget) {
        ctx.fillStyle = transparencyColorPicker.value || '#FFFFFF';
        ctx.fillRect(0, 0, targetW, targetH);
      }

      // Handle Grayscale mode
      if (grayscaleToggle.checked) {
        ctx.filter = 'grayscale(100%)';
      }

      // Draw source image scaled
      ctx.drawImage(item.sourceCanvas, 0, 0, targetW, targetH);

      // Grayscale luminance fallback if ctx.filter unsupported
      if (grayscaleToggle.checked) {
        const imgData = ctx.getImageData(0, 0, targetW, targetH);
        const d = imgData.data;
        for (let i = 0; i < d.length; i += 4) {
          const luma = 0.299 * d[i] + 0.587 * d[i + 1] + 0.114 * d[i + 2];
          d[i] = luma;
          d[i + 1] = luma;
          d[i + 2] = luma;
        }
        ctx.putImageData(imgData, 0, 0);
      }

      return canvas;
    }

    // Convert Canvas to Output Format Blob
    async function convertCanvasToTargetBlob(canvas: HTMLCanvasElement, targetFormat: string, qualityVal: number): Promise<Blob> {
      const qualityFactor = qualityVal / 100;

      switch (targetFormat) {
        case 'webp':
          return new Promise((res) => canvas.toBlob((b) => res(b!), 'image/webp', qualityFactor));
        case 'avif':
          return new Promise((res) => {
            canvas.toBlob((blob) => {
              if (blob && blob.type === 'image/avif') {
                res(blob);
              } else {
                // High-efficiency WebP fallback if browser lacks AVIF canvas encoder
                canvas.toBlob((webBlob) => res(webBlob || blob!), 'image/webp', qualityFactor);
              }
            }, 'image/avif', qualityFactor);
          });
        case 'jpeg':
          return new Promise((res) => canvas.toBlob((b) => res(b!), 'image/jpeg', qualityFactor));
        case 'png':
          return new Promise((res) => canvas.toBlob((b) => res(b!), 'image/png'));
        case 'bmp':
          return canvasToBmpBlob(canvas);
        case 'ico':
          return await canvasToIcoBlob(canvas);
        case 'gif':
          return canvasToGifBlob(canvas);
        case 'pdf':
          return await generatePdfBlobFromCanvases([canvas], qualityFactor);
        default:
          return new Promise((res) => canvas.toBlob((b) => res(b!), 'image/webp', qualityFactor));
      }
    }

    // Convert a single item
    async function convertQueueItem(item: QueueItem): Promise<void> {
      item.status = 'converting';
      renderQueueUI();

      try {
        const processedCanvas = renderConvertedCanvas(item);
        const qualityVal = parseInt(qualityRange.value, 10) || 90;

        const blob = await convertCanvasToTargetBlob(processedCanvas, item.targetFormat, qualityVal);
        item.convertedBlob = blob;
        item.convertedSize = blob.size;

        if (item.convertedUrl) URL.revokeObjectURL(item.convertedUrl);
        item.convertedUrl = URL.createObjectURL(blob);
        item.status = 'done';
      } catch (err) {
        item.status = 'error';
        item.errorMessage = (err as Error).message;
      }
      renderQueueUI();
    }

    // Convert all items in queue
    async function convertAllQueue(): Promise<void> {
      if (queue.length === 0) return;
      convertAllBtn?.setAttribute('disabled', 'true');
      if (convertAllText) convertAllText.textContent = 'Converting...';

      for (const item of queue) {
        await convertQueueItem(item);
      }

      convertAllBtn?.removeAttribute('disabled');
      if (convertAllText) convertAllText.textContent = 'Convert All Images';
      updateBatchActionsUI();
    }

    // Add Files into Queue
    async function addFilesToQueue(files: FileList | File[]): Promise<void> {
      if (!files || files.length === 0) return;

      dropzoneView?.classList.add('hidden');
      workspace?.classList.remove('hidden');

      for (let i = 0; i < files.length; i++) {
        const file = files[i];
        const id = `${Date.now()}-${Math.random().toString(36).substring(2, 9)}`;

        try {
          const { canvas, width, height } = await decodeImageToCanvas(file);
          const newItem: QueueItem = {
            id,
            file,
            name: file.name,
            originalSize: file.size,
            originalFormat: detectFormat(file),
            targetFormat: globalTargetFormat,
            width,
            height,
            aspectRatio: width / height,
            sourceCanvas: canvas,
            convertedBlob: null,
            convertedUrl: null,
            convertedSize: null,
            status: 'pending'
          };

          // If custom dimensions empty, default to first image
          if (customWidth === 0 && customHeight === 0) {
            customWidth = width;
            customHeight = height;
            if (customWidthInput) customWidthInput.value = String(width);
            if (customHeightInput) customHeightInput.value = String(height);
          }

          queue.push(newItem);
        } catch (err) {
          console.error('Error adding file to converter queue:', err);
        }
      }

      renderQueueUI();

      if (autoConvertToggle.checked) {
        await convertAllQueue();
      }
    }

