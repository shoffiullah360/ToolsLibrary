            <div class="flex items-center gap-2">
              <span class="text-xs text-slate-400 font-bold">TO:</span>
              <select class="item-format-select appearance-none bg-slate-100 dark:bg-slate-800 text-slate-900 dark:text-white font-bold text-xs py-1.5 pl-3 pr-7 rounded-lg border border-slate-200 dark:border-slate-700 cursor-pointer" data-id="${item.id}">
                <option value="webp" ${item.targetFormat === 'webp' ? 'selected' : ''}>WEBP</option>
                <option value="avif" ${item.targetFormat === 'avif' ? 'selected' : ''}>AVIF</option>
                <option value="jpeg" ${item.targetFormat === 'jpeg' ? 'selected' : ''}>JPG</option>
                <option value="png" ${item.targetFormat === 'png' ? 'selected' : ''}>PNG</option>
                <option value="gif" ${item.targetFormat === 'gif' ? 'selected' : ''}>GIF</option>
                <option value="bmp" ${item.targetFormat === 'bmp' ? 'selected' : ''}>BMP</option>
                <option value="ico" ${item.targetFormat === 'ico' ? 'selected' : ''}>ICO</option>
                <option value="pdf" ${item.targetFormat === 'pdf' ? 'selected' : ''}>PDF</option>
              </select>
            </div>

            <!-- Status -->
            <div class="min-w-[90px] text-right">
              ${statusHtml}
            </div>

            <!-- Action buttons: Download & Remove -->
            <div class="flex items-center gap-1.5">
              ${item.status === 'done' && item.convertedBlob ? `
                <button type="button" class="download-single-btn inline-flex items-center gap-1.5 px-3 py-1.5 rounded-lg bg-blue-600 hover:bg-blue-700 text-white font-semibold text-xs transition cursor-pointer shadow-2xs" data-id="${item.id}">
                  <svg class="w-3.5 h-3.5" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 16v1a3 3 0 003 3h10a3 3 0 003-3v-1m-4-4l-4 4m0 0l-4-4m4 4V4" /></svg>
                  <span>Download</span>
                </button>
              ` : `
                <button type="button" class="convert-single-btn px-3 py-1.5 rounded-lg border border-slate-200 dark:border-slate-700 bg-white dark:bg-slate-800 text-slate-700 dark:text-slate-300 font-medium text-xs hover:bg-slate-50 dark:hover:bg-slate-700 transition cursor-pointer" data-id="${item.id}">
                  Convert
                </button>
              `}

              <!-- Remove file -->
              <button type="button" class="remove-item-btn p-1.5 rounded-lg text-slate-400 hover:text-rose-500 hover:bg-slate-100 dark:hover:bg-slate-800 transition cursor-pointer" data-id="${item.id}" title="Remove file">
                <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12" /></svg>
              </button>
            </div>
          </div>
        `;

        queueList.appendChild(card);
      });

      attachQueueItemEvents();
      updateBatchActionsUI();
    }

    // Attach dynamic events for queue list
    function attachQueueItemEvents(): void {
      // Single Download
      document.querySelectorAll('.download-single-btn').forEach((btn) => {
        btn.addEventListener('click', () => {
          const id = (btn as HTMLElement).getAttribute('data-id');
          const item = queue.find((i) => i.id === id);
          if (item && item.convertedBlob) {
            triggerFileDownload(item);
          }
        });
      });

      // Single Convert
      document.querySelectorAll('.convert-single-btn').forEach((btn) => {
        btn.addEventListener('click', async () => {
          const id = (btn as HTMLElement).getAttribute('data-id');
          const item = queue.find((i) => i.id === id);
          if (item) {
            await convertQueueItem(item);
          }
        });
      });

      // Item Format Change
      document.querySelectorAll('.item-format-select').forEach((sel) => {
        sel.addEventListener('change', async (e) => {
          const id = (sel as HTMLElement).getAttribute('data-id');
          const item = queue.find((i) => i.id === id);
          if (item) {
            item.targetFormat = (e.target as HTMLSelectElement).value;
            await convertQueueItem(item);
          }
        });
      });

      // Remove single item
      document.querySelectorAll('.remove-item-btn').forEach((btn) => {
        btn.addEventListener('click', () => {
          const id = (btn as HTMLElement).getAttribute('data-id');
          const index = queue.findIndex((i) => i.id === id);
          if (index !== -1) {
            if (queue[index].convertedUrl) URL.revokeObjectURL(queue[index].convertedUrl!);
            queue.splice(index, 1);
            renderQueueUI();
          }
        });
      });

      // Inspect Modal
      document.querySelectorAll('.inspect-btn').forEach((btn) => {
        btn.addEventListener('click', () => {
          const id = (btn as HTMLElement).getAttribute('data-id');
          const item = queue.find((i) => i.id === id);
          if (item) openInspectModal(item);
        });
      });
    }

    // Open Inspect Modal
    function openInspectModal(item: QueueItem): void {
      activeModalItem = item;
      if (!previewModal) return;

      modalTitle!.textContent = item.name;
      modalFormatBadge!.textContent = item.targetFormat.toUpperCase();
      modalPreviewImg.src = item.convertedUrl || item.sourceCanvas.toDataURL('image/jpeg', 0.9);
      modalSpecsLabel!.textContent = `${item.width} × ${item.height} px • Original: ${formatBytes(item.originalSize)} ${item.convertedSize ? `• Converted: ${formatBytes(item.convertedSize)}` : ''}`;

      previewModal.showModal();
    }

    modalCloseBtn?.addEventListener('click', () => {
      previewModal?.close();
    });

    modalDownloadBtn?.addEventListener('click', () => {
      if (activeModalItem) {
        if (!activeModalItem.convertedBlob) {
          convertQueueItem(activeModalItem).then(() => {
            triggerFileDownload(activeModalItem!);
          });
        } else {
          triggerFileDownload(activeModalItem);
        }
      }
    });

    // Trigger individual download
    function triggerFileDownload(item: QueueItem): void {
      if (!item.convertedBlob) return;
      const ext = EXT_MAP[item.targetFormat] || '.webp';
      const cleanName = item.name.replace(/\.[^/.]+$/, '');
      const filename = `${cleanName}-converted${ext}`;

      const link = document.createElement('a');
      link.href = item.convertedUrl || URL.createObjectURL(item.convertedBlob);
      link.download = filename;
      document.body.appendChild(link);
      link.click();
      document.body.removeChild(link);
    }

    // Update Batch Actions & ZIP / Multi-page PDF UI
    function updateBatchActionsUI(): void {
      const anyDone = queue.some((i) => i.status === 'done' && i.convertedBlob);
      const allDone = queue.length > 0 && queue.every((i) => i.status === 'done' && i.convertedBlob);

      if (downloadZipBtn) {
        downloadZipBtn.disabled = queue.length === 0;
        if (downloadZipText) {
          downloadZipText.textContent = `Download All as ZIP (${queue.length})`;
        }
      }

      // Show Multi-Page PDF button if 2+ files are queued
      if (downloadMultiPdfBtn) {
        if (queue.length > 1) {
          downloadMultiPdfBtn.classList.remove('hidden');
        } else {
          downloadMultiPdfBtn.classList.add('hidden');
        }
      }
    }

    // Global Format Selector Change
    globalFormatSelect?.addEventListener('change', async (e) => {
      globalTargetFormat = (e.target as HTMLSelectElement).value;
      for (const item of queue) {
        item.targetFormat = globalTargetFormat;
      }
      renderQueueUI();
      if (autoConvertToggle.checked) {
        await convertAllQueue();
      }
    });

    // Advanced Drawer Toggle
    drawerToggle?.addEventListener('click', () => {
      const isHidden = drawerBody?.classList.contains('hidden');
      if (isHidden) {
        drawerBody?.classList.remove('hidden');
        drawerChevron?.classList.add('rotate-180');
        drawerToggle.setAttribute('aria-expanded', 'true');
      } else {
        drawerBody?.classList.add('hidden');
        drawerChevron?.classList.remove('rotate-180');
        drawerToggle.setAttribute('aria-expanded', 'false');
      }
    });

    // Quality Range Slider
    qualityRange?.addEventListener('input', () => {
      const val = qualityRange.value;
      if (qualityDisplayBadge) qualityDisplayBadge.textContent = `${val}%`;
      updateDrawerSummary();
    });

    qualityRange?.addEventListener('change', async () => {
      if (autoConvertToggle.checked && queue.length > 0) {
        await convertAllQueue();
      }
    });

    // Transparency Fill Color Picker
    transparencyColorPicker?.addEventListener('input', () => {
      const hex = transparencyColorPicker.value.toUpperCase();
      if (colorHexLabel) colorHexLabel.textContent = hex;
      updateDrawerSummary();
    });

    transparencyColorPicker?.addEventListener('change', async () => {
      if (autoConvertToggle.checked && queue.length > 0) {
        await convertAllQueue();
      }
    });

    // Transparency Quick Color Presets
    document.querySelectorAll('.color-preset-btn').forEach((btn) => {
      btn.addEventListener('click', async () => {
        const color = (btn as HTMLElement).getAttribute('data-color') || '#FFFFFF';
        if (transparencyColorPicker) transparencyColorPicker.value = color;
        if (colorHexLabel) colorHexLabel.textContent = color.toUpperCase();
        updateDrawerSummary();
        if (autoConvertToggle.checked && queue.length > 0) {
          await convertAllQueue();
        }
      });
    });

    // Grayscale Switch
    grayscaleToggle?.addEventListener('change', async () => {
      updateDrawerSummary();
      if (autoConvertToggle.checked && queue.length > 0) {
        await convertAllQueue();
      }
    });

    // Strip EXIF
    stripExifToggle?.addEventListener('change', () => {
      updateDrawerSummary();
    });

    // Resize Mode Tabs
    resizeModeTabs.forEach((tab) => {
      tab.addEventListener('click', async () => {
        resizeModeTabs.forEach((t) => {
          t.classList.remove('bg-white', 'dark:bg-slate-900', 'font-semibold', 'shadow-2xs');
          t.classList.add('text-slate-600', 'dark:text-slate-400');
        });
        tab.classList.add('bg-white', 'dark:bg-slate-900', 'font-semibold', 'shadow-2xs');
        tab.classList.remove('text-slate-600', 'dark:text-slate-400');

        currentResizeMode = (tab as HTMLElement).getAttribute('data-mode') as 'original' | 'percentage' | 'custom';
        if (currentResizeMode === 'original') {
          resizePercentagePanel?.classList.add('hidden');
          resizeCustomPanel?.classList.add('hidden');
        } else if (currentResizeMode === 'percentage') {
          resizePercentagePanel?.classList.remove('hidden');
          resizeCustomPanel?.classList.add('hidden');
        } else if (currentResizeMode === 'custom') {
          resizePercentagePanel?.classList.add('hidden');
          resizeCustomPanel?.classList.remove('hidden');
        }

        updateDrawerSummary();
        if (autoConvertToggle.checked && queue.length > 0) {
          await convertAllQueue();
        }
      });
    });

    // Scale Preset Buttons (75%, 50%, 25%)
    scalePresetBtns.forEach((btn) => {
      btn.addEventListener('click', async () => {
        scalePresetBtns.forEach((b) => b.classList.remove('border-blue-500', 'bg-blue-50', 'text-blue-600'));
        btn.classList.add('border-blue-500', 'bg-blue-50', 'text-blue-600');

        currentScale = parseFloat((btn as HTMLElement).getAttribute('data-scale') || '0.75');
        if (currentScaleLabel) currentScaleLabel.textContent = `${Math.round(currentScale * 100)}%`;

        updateDrawerSummary();
        if (autoConvertToggle.checked && queue.length > 0) {
          await convertAllQueue();
        }
      });
    });

    // Aspect Ratio Lock Toggle
    aspectRatioLockBtn?.addEventListener('click', () => {
      isAspectRatioLocked = !isAspectRatioLocked;
      if (isAspectRatioLocked) {
        aspectRatioLockBtn.classList.add('border-blue-500/50', 'bg-blue-50', 'text-blue-600');
        aspectRatioLockBtn.classList.remove('border-slate-300', 'text-slate-500');
        aspectRatioLockBtn.innerHTML = `
          <svg class="w-3.5 h-3.5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M13.828 10.172a4 4 0 00-5.656 0l-4 4a4 4 0 105.656 5.656l1.102-1.101m-.758-4.899a4 4 0 005.656 0l4-4a4 4 0 00-5.656-5.656l-1.1 1.1" /></svg>
          <span>Ratio Locked</span>
        `;
      } else {
        aspectRatioLockBtn.classList.remove('border-blue-500/50', 'bg-blue-50', 'text-blue-600');
        aspectRatioLockBtn.classList.add('border-slate-300', 'text-slate-500');
        aspectRatioLockBtn.innerHTML = `
          <svg class="w-3.5 h-3.5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M12 15v2m-6 4h12a2 2 0 002-2v-6a2 2 0 00-2-2H6a2 2 0 00-2 2v6a2 2 0 002 2zm10-10V7a4 4 0 00-8 0v4h8z" /></svg>
          <span>Ratio Unlocked</span>
        `;
      }
    });

    // Custom Width Input
    customWidthInput?.addEventListener('input', () => {
      const w = parseInt(customWidthInput.value, 10);
      if (w > 0) {
        customWidth = w;
        if (isAspectRatioLocked && queue.length > 0) {
          const ratio = queue[0].aspectRatio || 1;
          customHeight = Math.round(w / ratio);
          if (customHeightInput) customHeightInput.value = String(customHeight);
        }
      }
    });

    // Custom Height Input
    customHeightInput?.addEventListener('input', () => {
      const h = parseInt(customHeightInput.value, 10);
      if (h > 0) {
        customHeight = h;
        if (isAspectRatioLocked && queue.length > 0) {
          const ratio = queue[0].aspectRatio || 1;
          customWidth = Math.round(h * ratio);
          if (customWidthInput) customWidthInput.value = String(customWidth);
        }
      }
    });

    // Update Drawer Summary Badge
    function updateDrawerSummary(): void {
      if (!drawerSummaryPill) return;
      const parts = [`${qualityRange.value}% Quality`];
      if (grayscaleToggle.checked) parts.push('B&W Mode');
      if (currentResizeMode === 'percentage') parts.push(`${Math.round(currentScale * 100)}% Scaled`);
      if (currentResizeMode === 'custom') parts.push(`${customWidth}×${customHeight}px`);
      parts.push(transparencyColorPicker.value.toUpperCase());
      drawerSummaryPill.textContent = parts.join(' • ');
    }

    // Convert All Button Action
    convertAllBtn?.addEventListener('click', async () => {
      await convertAllQueue();
    });

    // Batch Download as ZIP
    downloadZipBtn?.addEventListener('click', async () => {
      if (queue.length === 0) return;
      const originalText = downloadZipBtn.innerHTML;
      downloadZipBtn.textContent = 'Packing ZIP...';

      // Ensure all items are converted
      for (const item of queue) {
        if (!item.convertedBlob) {
          await convertQueueItem(item);
        }
      }

      const zip = new JSZip();
      const folder = zip.folder('fasttoolverse-converted') || zip;

      queue.forEach((item) => {
        if (item.convertedBlob) {
          const ext = EXT_MAP[item.targetFormat] || '.webp';
          const cleanName = item.name.replace(/\.[^/.]+$/, '');
          folder.file(`${cleanName}${ext}`, item.convertedBlob);
        }
      });

      const zipBlob = await zip.generateAsync({ type: 'blob' });
      const link = document.createElement('a');
      link.href = URL.createObjectURL(zipBlob);
      link.download = 'fasttoolverse-converted-images.zip';
      document.body.appendChild(link);
      link.click();
      document.body.removeChild(link);

      downloadZipBtn.innerHTML = originalText;
    });

    // Multi-Page PDF Download Action
    downloadMultiPdfBtn?.addEventListener('click', async () => {
      if (queue.length === 0) return;
      const originalText = downloadMultiPdfBtn.innerHTML;
      downloadMultiPdfBtn.textContent = 'Generating PDF...';

      const canvases = queue.map((item) => renderConvertedCanvas(item));
      const qualityVal = parseInt(qualityRange.value, 10) || 90;
      const pdfBlob = await generatePdfBlobFromCanvases(canvases, qualityVal / 100);

      const link = document.createElement('a');
      link.href = URL.createObjectURL(pdfBlob);
      link.download = 'fasttoolverse-converted-multipage.pdf';
      document.body.appendChild(link);
      link.click();
      document.body.removeChild(link);

      downloadMultiPdfBtn.innerHTML = originalText;
    });

    // Clear All Queue
    clearAllBtn?.addEventListener('click', () => {
      queue.forEach((item) => {
        if (item.convertedUrl) URL.revokeObjectURL(item.convertedUrl);
      });
      queue = [];
      renderQueueUI();
    });

    // Add More Files Button
    addMoreBtn?.addEventListener('click', () => {
      fileInput.click();
    });

    // Select Files Button
    selectBtn?.addEventListener('click', () => {
      fileInput.click();
    });

    // File Input Change
    fileInput?.addEventListener('change', (e) => {
      const files = (e.target as HTMLInputElement).files;
      if (files) {
        addFilesToQueue(files);
      }
      fileInput.value = '';
    });

    // Drag and Drop Handling
    ['dragenter', 'dragover'].forEach((eventName) => {
      dropzone?.addEventListener(eventName, (e) => {
        e.preventDefault();
        e.stopPropagation();
        dropzone.classList.add('border-blue-500', 'bg-blue-50/20', 'dark:bg-blue-950/20');
      });
      workspace?.addEventListener(eventName, (e) => {
        e.preventDefault();
        e.stopPropagation();
      });
    });

    ['dragleave', 'drop'].forEach((eventName) => {
      dropzone?.addEventListener(eventName, (e) => {
        e.preventDefault();
        e.stopPropagation();
        dropzone.classList.remove('border-blue-500', 'bg-blue-50/20', 'dark:bg-blue-950/20');
      });
    });

    dropzone?.addEventListener('drop', (e) => {
      e.preventDefault();
      const files = e.dataTransfer?.files;
      if (files) addFilesToQueue(files);
    });

    workspace?.addEventListener('drop', (e) => {
      e.preventDefault();
      const files = e.dataTransfer?.files;
      if (files) addFilesToQueue(files);
    });

    // Global Paste Listener (Ctrl+V)
    window.addEventListener('paste', (e: ClipboardEvent) => {
      const items = e.clipboardData?.items;
      if (!items) return;

      const pastedFiles: File[] = [];
      for (let i = 0; i < items.length; i++) {
        if (items[i].type.indexOf('image') !== -1) {
          const file = items[i].getAsFile();
          if (file) pastedFiles.push(file);
        }
      }

      if (pastedFiles.length > 0) {
        addFilesToQueue(pastedFiles);
      }
    });
  });
</script>
