    sizeUnitMbBtn?.addEventListener('click', () => {
      targetSizeUnit = 'MB';
      if (sizeUnitKbBtn && sizeUnitMbBtn) {
        sizeUnitMbBtn.className = 'px-2.5 py-1.5 rounded-md bg-white dark:bg-slate-800 text-slate-900 dark:text-white font-semibold cursor-pointer shadow-xs';
        sizeUnitKbBtn.className = 'px-2.5 py-1.5 rounded-md text-slate-600 dark:text-slate-400 cursor-pointer';
      }
      triggerRender();
    });

    switchToWebpBtn?.addEventListener('click', (e) => {
      e.preventDefault();
      e.stopPropagation();
      setFormat('webp');
      triggerRender();
    });

    switchToJpgBtn?.addEventListener('click', (e) => {
      e.preventDefault();
      e.stopPropagation();
      setFormat('jpg');
      triggerRender();
    });

    qualitySlider?.addEventListener('input', () => {
      if (!qualitySlider) return;
      const val = parseInt(qualitySlider.value, 10);
      quality = val / 100;
      if (qualityValDisplay) {
        qualityValDisplay.textContent = `${val}% ${val >= 90 ? '(High)' : val >= 70 ? '(Good)' : '(Compact)'}`;
      }
      triggerRender();
    });

    downloadBtn?.addEventListener('click', () => downloadResizedImage());
    batchDownloadBtn?.addEventListener('click', () => downloadAllZip());
  }

  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', initImageResizer);
  } else {
    initImageResizer();
  }
  document.addEventListener('astro:page-load', initImageResizer);
</script>
