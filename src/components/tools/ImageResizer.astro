    }

    const targetSizeKBProp = parseFloat(root.dataset.targetSizeKb || '');
    if (!isNaN(targetSizeKBProp) && targetSizeKBProp > 0) {
      isTargetSizeActive = true;
      if (enableTargetSize) enableTargetSize.checked = true;
      targetSizeValue = targetSizeKBProp;
      if (inputTargetSize) inputTargetSize.value = targetSizeKBProp.toString();
      updateTargetSizeControlsUI();
    }

    // Global Event Listeners
    browseBtn.addEventListener('click', (e) => {
      e.stopPropagation();
      const input = (document.getElementById('imageInput') || fileInput) as HTMLInputElement | null;
      input?.click();
    });

    dropArea.addEventListener('click', (e) => {
      if (e.target === browseBtn || browseBtn.contains(e.target as Node)) {
        return;
      }
      const input = (document.getElementById('imageInput') || fileInput) as HTMLInputElement | null;
      input?.click();
    });

    fileInput.addEventListener('change', (e) => {
      const target = e.target as HTMLInputElement;
      if (target.files && target.files.length > 0) {
        loadFiles(target.files);
        fileInput.value = '';
      }
