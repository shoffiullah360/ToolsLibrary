        targetPxH = h;
        if (imageQueue[activeQueueIndex]) {
          imageQueue[activeQueueIndex].targetW = targetPxW;
          imageQueue[activeQueueIndex].targetH = targetPxH;
          imageQueue[activeQueueIndex].fitBg = 'transparent';
        }
        syncInputsFromPx();

        // 3. Keep Aspect Ratio lock active
        isAspectLocked = true;
        updateLockUI();

        // 4. Switch Resize Mode to Fit (Keep bounds) to prevent clipping/cropping
        resizeMode = 'fit';
        updateResizeModeUI();

        // 5. Set Padding Background strictly to Transparent by default
        setFitBg('transparent');

        // 6. Trigger instant canvas re-render and recalculate estimated file size badge
        if (renderDebounceTimer !== null) {
          window.clearTimeout(renderDebounceTimer);
          renderDebounceTimer = null;
        }
        renderCanvas();
      }
    });

    // Fit Background Fill Selector Listeners
    fitBgButtons.forEach(btn => {
