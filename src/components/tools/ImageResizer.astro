---
interface Props {
  initialWidth?: number;
  initialHeight?: number;
  initialUnit?: 'px' | 'inch' | 'cm' | 'mm' | '%';
  targetSizeKB?: number;
  initialFormat?: 'auto' | 'jpg' | 'png' | 'webp' | 'avif' | 'pdf' | 'ico';
}

const {
  initialWidth,
  initialHeight,
  initialUnit = 'px',
  targetSizeKB,
  initialFormat = 'jpg'
} = Astro.props;
---

<div
  id="image-resizer-root"
  class="w-full max-w-6xl mx-auto"
  data-initial-width={initialWidth || ''}
  data-initial-height={initialHeight || ''}
  data-initial-unit={initialUnit}
  data-target-size-kb={targetSizeKB || ''}
  data-initial-format={initialFormat}
>
  <!-- INITIAL STATE: Minimalist Drag & Drop Zone -->
  <div id="dropzone-view" class="transition-all duration-300">
    <div
      id="dropzone"
      class="relative group rounded-3xl border-2 border-dashed border-slate-300 dark:border-slate-700 hover:border-blue-500 dark:hover:border-blue-400 bg-white/70 dark:bg-slate-900/50 backdrop-blur-sm px-6 py-8 sm:px-10 sm:py-9 text-center cursor-pointer transition-all duration-200 hover:shadow-xl hover:shadow-blue-500/5 hover:-translate-y-0.5"
    >
      <input
        type="file"
        id="imageInput"
        class="hidden"
        accept="image/jpeg,image/png,image/webp,image/gif,image/heic,.heic,.heif,image/bmp"
        multiple
      />

      <div class="max-w-lg mx-auto flex flex-col items-center">
        <!-- Batch Queue Pill -->
        <div class="inline-flex items-center gap-1.5 px-3 py-0.5 rounded-full text-xs font-semibold bg-blue-50 dark:bg-blue-950/40 text-blue-600 dark:text-blue-400 border border-blue-100 dark:border-blue-900/50 mb-3 shadow-2xs">
          <svg class="w-3.5 h-3.5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
            <path stroke-linecap="round" stroke-linejoin="round" d="M6 6.878V6a2.25 2.25 0 012.25-2.25h7.5A2.25 2.25 0 0118 6v.878m-12 0c.235-.083.487-.128.75-.128h10.5c.263 0 .515.045.75.128m-12 0A2.25 2.25 0 004.5 9v.878m13.5-3A2.25 2.25 0 0119.5 9v.878m-15 0a2.246 2.246 0 00-.75.128m16.5 0c-.235-.083-.487-.128-.75-.128m-15 0A2.25 2.25 0 003 12v6.75A2.25 2.25 0 005.25 21h13.5A2.25 2.25 0 0021 18.75V12a2.25 2.25 0 00-1.5-2.122" />
          </svg>
          <span>Batch Queue: Up to 15 Images</span>
        </div>

        <!-- Minimalist Icon -->
        <div class="w-12 h-12 rounded-xl bg-blue-50 dark:bg-blue-950/40 text-blue-600 dark:text-blue-400 flex items-center justify-center mb-3 group-hover:scale-110 transition-transform duration-200 shadow-sm border border-blue-100 dark:border-blue-900/50">
          <svg class="w-6 h-6" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.75">
            <path stroke-linecap="round" stroke-linejoin="round" d="M3 16.5v2.25A2.25 2.25 0 005.25 21h13.5A2.25 2.25 0 0021 18.75V16.5m-13.5-9L12 3m0 0l4.5 4.5M12 3v13.5" />
          </svg>
        </div>

        <!-- Headline & CTA -->
        <h3 class="text-lg sm:text-xl font-semibold text-slate-900 dark:text-white tracking-tight">
          Upload your images (up to 15)
        </h3>
        <p class="mt-1 text-xs sm:text-sm text-slate-500 dark:text-slate-400">
          Supports JPG, PNG, WebP, AVIF, PDF & ICO. Paste from clipboard (<kbd class="px-1.5 py-0.5 text-xs font-mono bg-slate-100 dark:bg-slate-800 rounded border border-slate-200 dark:border-slate-700">Ctrl+V</kbd>)
        </p>

        <!-- Primary Action Button -->
        <div class="mt-4 flex items-center justify-center">
          <button
            type="button"
            id="selectBtn"
            class="px-6 py-2.5 rounded-full bg-slate-900 hover:bg-slate-800 dark:bg-white dark:hover:bg-slate-100 text-white dark:text-slate-900 font-medium text-xs sm:text-sm transition-all shadow-md hover:shadow-lg active:scale-95 cursor-pointer"
          >
            Select Images (1–15)
          </button>
        </div>

        <!-- Privacy & Security Note -->
        <div class="mt-5 pt-3.5 border-t border-slate-200/70 dark:border-slate-800/80 w-full flex items-center justify-center">
          <div class="inline-flex items-center justify-center gap-1.5 font-medium text-emerald-600 dark:text-emerald-400 text-xs whitespace-nowrap">
            <svg class="w-3.5 h-3.5 shrink-0" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
              <path stroke-linecap="round" stroke-linejoin="round" d="M9 12.75L11.25 15 15 9.75m-3-7.036A11.959 11.959 0 013.598 6 11.99 11.99 0 003 9.749c0 5.592 3.824 10.29 9 11.623 5.176-1.332 9-6.03 9-11.622 0-1.31-.21-2.571-.598-3.751h-.152c-3.196 0-6.1-1.248-8.25-3.285z" />
            </svg>
            <span>Images never leave your browser (100% Client-Side)</span>
          </div>
        </div>
      </div>
    </div>
  </div>

  <!-- ACTIVE STATE: Two-Column Studio Layout -->
  <div id="editor-view" class="hidden">
    <!-- Top Thumbnail Strip (Batch Queue Up to 15 Images) -->
    <div class="mb-5 rounded-2xl border border-slate-200 dark:border-slate-800 bg-white/80 dark:bg-slate-900/80 backdrop-blur-sm p-3.5 shadow-xs">
      <div class="flex items-center justify-between mb-2.5 px-1">
        <div class="flex items-center gap-2">
          <span class="text-xs font-semibold uppercase tracking-wider text-slate-500 dark:text-slate-400">
            Upload your images (<span id="queue-counter" class="font-mono font-bold text-blue-600 dark:text-blue-400">1/15</span>)
          </span>
          <span class="hidden sm:inline-block text-[11px] text-slate-400 font-normal">
            • Click any card to edit image
          </span>
        </div>

        <div class="flex items-center gap-2">
          <button
            type="button"
            id="clear-all-btn"
            class="text-xs text-rose-500 hover:text-rose-600 dark:hover:text-rose-400 font-medium transition cursor-pointer"
          >
            Clear All
          </button>
        </div>
      </div>

      <!-- Horizontal Scrollable Thumbnail Strip -->
      <div id="queue-strip" class="flex items-center gap-2.5 overflow-x-auto pb-1.5 pt-0.5 px-0.5 no-scrollbar scroll-smooth">
        <!-- Rendered dynamically -->
      </div>
    </div>

    <!-- Active Image Details Bar -->
    <div class="mb-4 flex flex-wrap items-center justify-between gap-3">
      <div class="flex items-center gap-2.5 min-w-0">
        <span class="inline-flex items-center justify-center w-7 h-7 rounded-lg bg-blue-500/10 text-blue-600 dark:text-blue-400 text-xs font-semibold">
          IMG
        </span>
        <div class="min-w-0">
          <p id="source-filename" class="text-sm font-semibold text-slate-800 dark:text-slate-200 truncate max-w-[220px] sm:max-w-md">
            image.jpg
          </p>
          <p id="source-specs" class="text-xs text-slate-500 dark:text-slate-400 font-mono">
            Original: 1920 × 1080 px • 2.4 MB
          </p>
        </div>
      </div>

      <div class="flex items-center gap-2">
        <button
          type="button"
          id="upload-another-btn"
          class="inline-flex items-center gap-1.5 px-3 py-1.5 rounded-lg border border-slate-200 dark:border-slate-700 bg-white dark:bg-slate-800 text-xs font-medium text-slate-700 dark:text-slate-300 hover:bg-slate-50 dark:hover:bg-slate-700 transition cursor-pointer"
        >
          <svg class="w-3.5 h-3.5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
            <path stroke-linecap="round" stroke-linejoin="round" d="M12 4.5v15m7.5-7.5h-15" />
          </svg>
          Add Images
        </button>
      </div>
    </div>

    <!-- 2-Column Grid -->
    <div class="grid grid-cols-1 lg:grid-cols-12 gap-6 lg:gap-8 items-start">
      
      <!-- LEFT COLUMN: Canvas Preview + Transform Bar (7 Cols) -->
      <div class="lg:col-span-7 flex flex-col gap-4">
        <div id="preview-canvas-container" class="relative rounded-2xl border border-slate-200 dark:border-slate-800 bg-slate-100 dark:bg-slate-900/90 overflow-hidden min-h-[380px] sm:min-h-[440px] flex items-center justify-center p-4 shadow-sm group select-none">
          
          <!-- Transparent checkerboard background -->
          <div class="absolute inset-0 opacity-40 dark:opacity-20 pointer-events-none" style="background-image: linear-gradient(45deg, #cbd5e1 25%, transparent 25%), linear-gradient(-45deg, #cbd5e1 25%, transparent 25%), linear-gradient(45deg, transparent 75%, #cbd5e1 75%), linear-gradient(-45deg, transparent 75%, #cbd5e1 75%); background-size: 16px 16px; background-position: 0 0, 0 8px, 8px -8px, -8px 0;"></div>

          <!-- Real Preview Canvas -->
          <canvas
            id="preview-canvas"
            class="max-w-full max-h-[420px] object-contain rounded-lg shadow-md transition-transform relative z-10"
          ></canvas>

          <!-- Status Overlays -->
          <div class="absolute top-3 left-3 z-20 flex items-center gap-1.5 pointer-events-none">
            <span id="preview-dim-pill" class="px-2.5 py-1 rounded-full text-xs font-mono font-medium bg-slate-900/80 text-white backdrop-blur-md shadow-sm">
              1920 × 1080 px
            </span>
          </div>

          <div class="absolute top-3 right-3 z-20 flex items-center gap-1.5 pointer-events-none">
            <span id="preview-size-pill" class="px-2.5 py-1 rounded-full text-xs font-mono font-medium bg-blue-600/90 text-white backdrop-blur-md shadow-sm">
              Est. ~150 KB
            </span>
            <span id="preview-savings-pill" class="hidden px-2 py-1 rounded-full text-xs font-mono font-bold bg-emerald-600 text-white shadow-sm">
              -60%
            </span>
          </div>

          <!-- Processing Indicator -->
          <div id="canvas-loading" class="hidden absolute inset-0 z-30 bg-slate-900/40 backdrop-blur-[2px] flex items-center justify-center">
            <div class="flex items-center gap-2 px-4 py-2 rounded-xl bg-slate-900/90 text-white text-xs font-medium shadow-lg">
              <svg class="animate-spin h-4 w-4 text-blue-400" fill="none" viewBox="0 0 24 24">
                <circle class="opacity-25" cx="12" cy="12" r="10" stroke="currentColor" stroke-width="4"></circle>
                <path class="opacity-75" fill="currentColor" d="M4 12a8 8 0 018-8v8H4z"></path>
              </svg>
              <span id="canvas-loading-text">Processing Canvas...</span>
            </div>
          </div>

          <!-- Inline Crop Interactive Overlay -->
          <div
            id="inline-crop-overlay"
            class="hidden absolute inset-0 z-25 overflow-hidden select-none pointer-events-auto touch-none"
          >
            <!-- Inline Floating Action Pill -->
            <div
              id="inline-crop-actions"
              class="absolute top-3 inset-x-0 mx-auto w-fit z-30 flex items-center gap-2 px-3 py-1.5 rounded-full bg-slate-900/95 dark:bg-slate-800/95 text-white backdrop-blur-md shadow-xl border border-slate-700/60 transition pointer-events-auto"
            >
              <span class="text-xs font-semibold text-slate-300 pr-1 flex items-center gap-1.5">
                <svg class="w-3.5 h-3.5 text-emerald-400" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                  <path stroke-linecap="round" stroke-linejoin="round" d="M7.5 3.75V16.5a2.25 2.25 0 002.25 2.25h12.75M3.75 7.5H16.5a2.25 2.25 0 012.25 2.25v12.75" />
                </svg>
                <span>Crop</span>
              </span>
              <div class="h-3.5 w-px bg-slate-700"></div>
              <button
                type="button"
                id="inline-crop-cancel-btn"
                class="px-2.5 py-1 rounded-full text-xs font-medium text-slate-300 hover:text-white hover:bg-slate-700/80 transition cursor-pointer active:scale-95"
              >
                Cancel
              </button>
              <button
                type="button"
                id="inline-crop-apply-btn"
                class="px-3 py-1 rounded-full text-xs font-semibold bg-emerald-600 hover:bg-emerald-500 active:bg-emerald-700 text-white shadow transition flex items-center gap-1 cursor-pointer active:scale-95"
              >
                <svg class="w-3.5 h-3.5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5">
                  <path stroke-linecap="round" stroke-linejoin="round" d="M4.5 12.75l6 6 9-13.5" />
                </svg>
                <span>Apply Crop</span>
              </button>
            </div>

            <!-- Draggable & Resizable Crop Box -->
            <div
              id="inline-crop-box"
              class="absolute border-2 border-emerald-400 bg-emerald-500/10 shadow-[0_0_0_9999px_rgba(15,23,42,0.6)] cursor-move touch-none"
              style="top: 0px; left: 0px; width: 100px; height: 100px;"
            >
              <!-- Dimensions badge (positioned inside bottom of box) -->
              <div
                id="inline-crop-dim-tag"
                class="absolute bottom-2 left-1/2 -translate-x-1/2 px-2 py-0.5 rounded bg-slate-900/85 text-white font-mono text-[10px] whitespace-nowrap shadow pointer-events-none backdrop-blur-sm"
              >
                0 × 0 px
              </div>

              <!-- 4 Corner Handles -->
              <div class="crop-handle absolute -top-2 -left-2 w-4 h-4 bg-white border-2 border-emerald-500 rounded-sm cursor-nwse-resize shadow-md" data-handle="nw"></div>
              <div class="crop-handle absolute -top-2 -right-2 w-4 h-4 bg-white border-2 border-emerald-500 rounded-sm cursor-nesw-resize shadow-md" data-handle="ne"></div>
              <div class="crop-handle absolute -bottom-2 -right-2 w-4 h-4 bg-white border-2 border-emerald-500 rounded-sm cursor-nwse-resize shadow-md" data-handle="se"></div>
              <div class="crop-handle absolute -bottom-2 -left-2 w-4 h-4 bg-white border-2 border-emerald-500 rounded-sm cursor-nesw-resize shadow-md" data-handle="sw"></div>

              <!-- 4 Edge Midpoint Handles -->
              <div class="crop-handle absolute -top-1.5 left-1/2 -translate-x-1/2 w-5 h-2.5 bg-white border-2 border-emerald-500 rounded-sm cursor-ns-resize shadow-md" data-handle="n"></div>
              <div class="crop-handle absolute -bottom-1.5 left-1/2 -translate-x-1/2 w-5 h-2.5 bg-white border-2 border-emerald-500 rounded-sm cursor-ns-resize shadow-md" data-handle="s"></div>
              <div class="crop-handle absolute top-1/2 -left-1.5 -translate-y-1/2 w-2.5 h-5 bg-white border-2 border-emerald-500 rounded-sm cursor-ew-resize shadow-md" data-handle="w"></div>
              <div class="crop-handle absolute top-1/2 -right-1.5 -translate-y-1/2 w-2.5 h-5 bg-white border-2 border-emerald-500 rounded-sm cursor-ew-resize shadow-md" data-handle="e"></div>

              <!-- Rule-of-thirds grid -->
              <div class="absolute inset-0 pointer-events-none grid grid-cols-3 grid-rows-3 opacity-25">
                <div class="border-r border-b border-white"></div>
                <div class="border-r border-b border-white"></div>
                <div class="border-b border-white"></div>
                <div class="border-r border-b border-white"></div>
                <div class="border-r border-b border-white"></div>
                <div class="border-b border-white"></div>
                <div class="border-r border-white"></div>
                <div class="border-r border-white"></div>
                <div></div>
              </div>
            </div>
          </div>
        </div>

        <!-- Inline Transform Toolbar -->
        <div class="flex items-center justify-between px-3 py-2.5 rounded-xl border border-slate-200 dark:border-slate-800 bg-white/80 dark:bg-slate-900/80 backdrop-blur-sm text-xs">
          <div class="flex items-center gap-1.5 sm:gap-2">
            <span class="text-slate-400 font-medium mr-1 hidden sm:inline">Transform:</span>
            
            <!-- Rotate 90° Button -->
            <button
              type="button"
              id="rotate-btn"
              class="inline-flex items-center gap-1.5 px-3 py-1.5 rounded-lg text-slate-700 dark:text-slate-300 hover:bg-slate-100 dark:hover:bg-slate-800 font-medium transition cursor-pointer active:scale-95"
              title="Rotate 90 degrees clockwise"
            >
              <svg class="w-4 h-4 text-blue-500" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                <polyline points="23 4 23 10 17 10"></polyline>
                <path d="M20.49 15a9 9 0 1 1-2.12-9.36L23 10"></path>
              </svg>
              <span>Rotate 90°</span>
            </button>

            <!-- Crop Button -->
            <button
              type="button"
              id="crop-btn"
              class="inline-flex items-center gap-1.5 px-3 py-1.5 rounded-lg text-slate-700 dark:text-slate-300 hover:bg-slate-100 dark:hover:bg-slate-800 font-medium transition cursor-pointer active:scale-95"
              title="Crop image"
            >
              <svg class="w-4 h-4 text-emerald-500" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                <path stroke-linecap="round" stroke-linejoin="round" d="M7.5 3.75V16.5a2.25 2.25 0 002.25 2.25h12.75M3.75 7.5H16.5a2.25 2.25 0 012.25 2.25v12.75" />
              </svg>
              <span>Crop</span>
            </button>

            <!-- Flip Horizontal Button -->
            <button
              type="button"
              id="flip-h-btn"
              class="inline-flex items-center gap-1.5 px-3 py-1.5 rounded-lg text-slate-700 dark:text-slate-300 hover:bg-slate-100 dark:hover:bg-slate-800 font-medium transition cursor-pointer active:scale-95"
              title="Flip Horizontally"
            >
              <svg class="w-4 h-4 text-cyan-500" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                <path stroke-linecap="round" stroke-linejoin="round" d="M7.5 21L3 16.5m0 0L7.5 12M3 16.5h13.5m0-13.5L21 7.5m0 0L16.5 12M21 7.5H7.5" />
              </svg>
              <span>Flip Horizontal</span>
            </button>
          </div>

          <!-- Reset Orientation Button -->
          <button
            type="button"
            id="reset-transforms-btn"
            class="text-slate-500 hover:text-slate-800 dark:hover:text-slate-200 transition cursor-pointer font-medium text-xs px-2.5 py-1.5 rounded-lg hover:bg-slate-100 dark:hover:bg-slate-800 flex items-center gap-1.5 active:scale-95"
            title="Reset transformations to original orientation"
          >
            <svg class="w-3.5 h-3.5 text-slate-400" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
              <path stroke-linecap="round" stroke-linejoin="round" d="M4 4v5h.582m15.356 2A8.001 8.001 0 004.582 9m0 0H9m11 11v-5h-.581m0 0a8.003 8.003 0 01-15.357-2m15.357 2H15" />
            </svg>
            <span>Reset Orientation</span>
          </button>
        </div>
      </div>

      <!-- RIGHT COLUMN: Settings Card (Tabs) + Download Action (5 Cols) -->
      <div class="lg:col-span-5 flex flex-col gap-4">
        
        <!-- Tabbed Settings Card -->
        <div class="rounded-2xl border border-slate-200 dark:border-slate-800 bg-white dark:bg-slate-900 p-5 sm:p-6 shadow-sm">
          
          <!-- Segmented Tabs Header -->
          <div class="flex p-1 bg-slate-100 dark:bg-slate-800/80 rounded-xl mb-5">
            <button
              type="button"
              id="tab-btn-resize"
              class="flex-1 py-2 text-xs font-semibold rounded-lg transition-all duration-200 cursor-pointer bg-white dark:bg-slate-700 text-slate-900 dark:text-white shadow-sm"
            >
              1. Resize Settings
            </button>
            <button
              type="button"
              id="tab-btn-export"
              class="flex-1 py-2 text-xs font-semibold rounded-lg transition-all duration-200 cursor-pointer text-slate-500 dark:text-slate-400 hover:text-slate-800 dark:hover:text-slate-200"
            >
              2. Export Settings
            </button>
          </div>

          <!-- TAB 1: RESIZE SETTINGS -->
          <div id="tab-pane-resize" class="space-y-5">
            
            <!-- Unit Selector -->
            <div>
              <div class="flex items-center justify-between mb-2">
                <label class="text-xs font-semibold uppercase tracking-wider text-slate-500 dark:text-slate-400">
                  Unit & Scale
                </label>
                <!-- DPI Toggle for Print/Passport -->
                <div class="flex items-center gap-1.5 text-xs">
                  <span class="text-slate-400">DPI:</span>
                  <button
                    type="button"
                    id="dpi-toggle-btn"
                    class="px-2 py-0.5 rounded text-[11px] font-mono font-medium border border-slate-200 dark:border-slate-700 bg-slate-50 dark:bg-slate-800 text-slate-700 dark:text-slate-300 hover:border-blue-500 transition cursor-pointer"
                    title="Toggle standard 96 DPI screen vs 300 DPI high-res print"
                  >
                    <span id="dpi-val">96 DPI</span> (Screen)
                  </button>
                </div>
              </div>

              <!-- Segmented Unit Pills [PX, INCH, CM, MM, %] -->
              <div class="grid grid-cols-5 gap-1 p-1 bg-slate-100 dark:bg-slate-800/80 rounded-xl text-center">
                <button type="button" class="unit-pill py-1.5 rounded-lg text-xs font-semibold transition cursor-pointer bg-white dark:bg-slate-700 text-blue-600 dark:text-blue-400 shadow-xs" data-unit="px">PX</button>
                <button type="button" class="unit-pill py-1.5 rounded-lg text-xs font-semibold transition cursor-pointer text-slate-600 dark:text-slate-300 hover:text-slate-900" data-unit="inch">INCH</button>
                <button type="button" class="unit-pill py-1.5 rounded-lg text-xs font-semibold transition cursor-pointer text-slate-600 dark:text-slate-300 hover:text-slate-900" data-unit="cm">CM</button>
                <button type="button" class="unit-pill py-1.5 rounded-lg text-xs font-semibold transition cursor-pointer text-slate-600 dark:text-slate-300 hover:text-slate-900" data-unit="mm">MM</button>
                <button type="button" class="unit-pill py-1.5 rounded-lg text-xs font-semibold transition cursor-pointer text-slate-600 dark:text-slate-300 hover:text-slate-900" data-unit="%">%</button>
              </div>
            </div>

            <!-- Dimension Inputs & Aspect Ratio Lock -->
            <div>
              <div class="flex items-center justify-between mb-2">
                <label class="text-xs font-semibold uppercase tracking-wider text-slate-500 dark:text-slate-400">
                  Dimensions
                </label>
                <span class="text-xs text-slate-400 font-mono">Live Sync</span>
              </div>

              <div class="flex items-center gap-2">
                <!-- Width Input -->
                <div class="flex-1 relative">
                  <div class="absolute inset-y-0 left-0 pl-3 flex items-center pointer-events-none text-slate-400 text-xs font-semibold">
                    W
                  </div>
                  <input
                    type="number"
                    id="input-width"
                    step="any"
                    min="1"
                    class="w-full pl-8 pr-10 py-2.5 rounded-xl border border-slate-200 dark:border-slate-700 bg-slate-50/50 dark:bg-slate-800/50 text-slate-900 dark:text-white font-mono text-sm focus:outline-none focus:ring-2 focus:ring-blue-500/30 focus:border-blue-500 transition"
                    placeholder="Width"
                  />
                  <span class="active-unit-label absolute inset-y-0 right-0 pr-3 flex items-center pointer-events-none text-slate-400 text-xs uppercase font-mono">
