          targetPxW = Math.round(35 * (300 / 25.4)); // ~413 px
          targetPxH = Math.round(45 * (300 / 25.4)); // ~531 px
          if (inputWidth) inputWidth.value = '35';
          if (inputHeight) inputHeight.value = '45';
        } else if (btn.dataset.presetScale) {
          const scale = parseFloat(btn.dataset.presetScale);
          targetPxW = Math.round(getEffectiveSourceWidth() * scale);
          targetPxH = Math.round(getEffectiveSourceHeight() * scale);
        } else if (btn.dataset.presetUnit === 'inch' && btn.dataset.presetInchVal) {
          changeUnit('inch');
          const inches = parseFloat(btn.dataset.presetInchVal);
          dpi = 300;
          if (dpiValDisplay) dpiValDisplay.textContent = '300 DPI';
          if (dpiToggleBtn) dpiToggleBtn.title = 'Switch to 96 DPI (Web/Screen)';
          targetPxW = Math.round(inches * 300);
          targetPxH = Math.round(inches * 300);
          if (inputWidth) inputWidth.value = inches.toString();
          if (inputHeight) inputHeight.value = inches.toString();
        } else if (btn.dataset.presetW && btn.dataset.presetH) {
          changeUnit('px');
          targetPxW = parseInt(btn.dataset.presetW, 10);
          targetPxH = parseInt(btn.dataset.presetH, 10);
        }
        if (imageQueue[activeQueueIndex]) {
          imageQueue[activeQueueIndex].targetW = targetPxW;
          imageQueue[activeQueueIndex].targetH = targetPxH;
          imageQueue[activeQueueIndex].fitBg = 'transparent';
        }
        syncInputsFromPx();

        // Keep Aspect Ratio lock active
        isAspectLocked = true;
        updateLockUI();

        // Switch Resize Mode to Fit (Keep bounds) to keep entire image 100% visible without cropping
        resizeMode = 'fit';
        updateResizeModeUI();

        // Set Padding Background strictly to Transparent by default
        setFitBg('transparent');

        if (renderDebounceTimer !== null) {
          window.clearTimeout(renderDebounceTimer);
          renderDebounceTimer = null;
        }
        renderCanvas();
      });
