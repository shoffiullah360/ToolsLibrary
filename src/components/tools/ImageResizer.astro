          <div class="flex items-center justify-between text-[11px] text-slate-500 dark:text-slate-400 px-1 font-mono">
            <span id="summary-meta-res">1920 × 1080 px</span>
            <span id="summary-meta-format">FORMAT: JPG</span>
            <span id="summary-meta-size">SIZE: ~150 KB</span>
          </div>
        </div>

      </div>

    </div>
  </div>


</div>

<script>
  import JSZip from 'jszip';

  // Queue Item Interface
  interface QueueItem {
    id: string;
    file: File;
    name: string;
    size: number;
    mimeType: string;
    img: HTMLImageElement;
    width: number;
    height: number;
    rotation: number;
    flipH: boolean;
    targetW: number;
    targetH: number;
    thumbDataUrl: string;
    fitBg?: 'transparent' | 'blur' | 'white' | 'black' | 'custom';
    fitCustomColor?: string;
  }

  type SupportedFormat = 'auto' | 'jpg' | 'png' | 'webp' | 'avif' | 'pdf' | 'ico';

  function initImageResizer() {
    const rootEl = document.getElementById('image-resizer-root') as HTMLElement | null;
    if (!rootEl) return;

    if (rootEl.dataset.initialized === 'true') return;
    rootEl.dataset.initialized = 'true';

    const root: HTMLElement = rootEl;

    // Elements
    const fileInputEl = (document.getElementById('imageInput') || document.getElementById('file-input')) as HTMLInputElement | null;
    const dropAreaEl = (document.getElementById('dropzone') || document.getElementById('drop-area')) as HTMLElement | null;
    const browseBtnEl = (document.getElementById('selectBtn') || document.getElementById('browse-btn')) as HTMLButtonElement | null;
    const dropzoneViewEl = document.getElementById('dropzone-view') as HTMLElement | null;
    const editorViewEl = document.getElementById('editor-view') as HTMLElement | null;
    const previewCanvasContainerEl = document.getElementById('preview-canvas-container') as HTMLElement | null;
    const previewCanvasEl = document.getElementById('preview-canvas') as HTMLCanvasElement | null;
    const canvasCtxEl = previewCanvasEl?.getContext('2d') ?? null;

    if (!fileInputEl || !dropAreaEl || !browseBtnEl || !dropzoneViewEl || !editorViewEl || !previewCanvasContainerEl || !previewCanvasEl || !canvasCtxEl) {
      return;
    }

    const fileInput: HTMLInputElement = fileInputEl;
    const dropArea: HTMLElement = dropAreaEl;
    const browseBtn: HTMLButtonElement = browseBtnEl;
    const dropzoneView: HTMLElement = dropzoneViewEl;
    const editorView: HTMLElement = editorViewEl;
    const previewCanvasContainer: HTMLElement = previewCanvasContainerEl;
    const previewCanvas: HTMLCanvasElement = previewCanvasEl;
    const canvasCtx: CanvasRenderingContext2D = canvasCtxEl;

    // Top Bar Elements
    const queueCounter = document.getElementById('queue-counter') as HTMLElement | null;
    const clearAllBtn = document.getElementById('clear-all-btn') as HTMLButtonElement | null;
    const queueStrip = document.getElementById('queue-strip') as HTMLElement | null;
    const sourceFilename = document.getElementById('source-filename') as HTMLElement | null;
    const sourceSpecs = document.getElementById('source-specs') as HTMLElement | null;
    const uploadAnotherBtn = document.getElementById('upload-another-btn') as HTMLButtonElement | null;

    // Canvas Overlays
    const previewDimPill = document.getElementById('preview-dim-pill') as HTMLElement | null;
    const previewSizePill = document.getElementById('preview-size-pill') as HTMLElement | null;
    const previewSavingsPill = document.getElementById('preview-savings-pill') as HTMLElement | null;
    const canvasLoading = document.getElementById('canvas-loading') as HTMLElement | null;
    const canvasLoadingText = document.getElementById('canvas-loading-text') as HTMLElement | null;

    // Inline Crop Overlay
    const inlineCropOverlay = document.getElementById('inline-crop-overlay') as HTMLElement | null;
    const inlineCropBox = document.getElementById('inline-crop-box') as HTMLElement | null;
    const inlineCropDimTag = document.getElementById('inline-crop-dim-tag') as HTMLElement | null;
    const inlineCropApplyBtn = document.getElementById('inline-crop-apply-btn') as HTMLButtonElement | null;
    const inlineCropCancelBtn = document.getElementById('inline-crop-cancel-btn') as HTMLButtonElement | null;

    // Transform Bar
    const rotateBtn = document.getElementById('rotate-btn') as HTMLButtonElement | null;
    const cropBtn = document.getElementById('crop-btn') as HTMLButtonElement | null;
    const flipHBtn = document.getElementById('flip-h-btn') as HTMLButtonElement | null;
    const resetTransformsBtn = document.getElementById('reset-transforms-btn') as HTMLButtonElement | null;
    const downloadBtn = document.getElementById('download-btn') as HTMLButtonElement | null;
    const downloadBtnLabel = document.getElementById('download-btn-label') as HTMLElement | null;
    const batchDownloadBtn = document.getElementById('batch-download-btn') as HTMLButtonElement | null;
    const batchDownloadLabel = document.getElementById('batch-download-label') as HTMLElement | null;

    // Tabs
    const tabBtnResize = document.getElementById('tab-btn-resize') as HTMLButtonElement | null;
    const tabBtnExport = document.getElementById('tab-btn-export') as HTMLButtonElement | null;
    const tabPaneResize = document.getElementById('tab-pane-resize') as HTMLElement | null;
    const tabPaneExport = document.getElementById('tab-pane-export') as HTMLElement | null;

    // Resize Controls
    const inputWidth = document.getElementById('input-width') as HTMLInputElement | null;
    const inputHeight = document.getElementById('input-height') as HTMLInputElement | null;
    const lockAspectBtn = document.getElementById('lock-aspect-btn') as HTMLButtonElement | null;
    const lockIconLocked = document.getElementById('lock-icon-locked') as SVGElement | null;
    const lockIconUnlocked = document.getElementById('lock-icon-unlocked') as SVGElement | null;
    const unitButtons = root.querySelectorAll<HTMLButtonElement>('.unit-pill');
    const activeUnitLabels = root.querySelectorAll<HTMLElement>('.active-unit-label');
    const dpiToggleBtn = document.getElementById('dpi-toggle-btn') as HTMLButtonElement | null;
    const dpiValDisplay = document.getElementById('dpi-val') as HTMLElement | null;
    const resizeModeRadios = root.querySelectorAll<HTMLInputElement>('input[name="resize-mode"]');
    const modeHint = document.getElementById('mode-hint') as HTMLElement | null;
    const presetButtons = root.querySelectorAll<HTMLButtonElement>('.preset-btn');
    const socialPresetSelect = document.getElementById('social-preset-select') as HTMLSelectElement | null;

    // Canvas Background Controls
    const fitBgControls = document.getElementById('fit-bg-controls') as HTMLElement | null;
    const fitBgStatusLabel = document.getElementById('fit-bg-status-label') as HTMLElement | null;
    const fitBgButtons = root.querySelectorAll<HTMLElement>('.fit-bg-btn');
    const fitCustomColorInput = document.getElementById('fit-custom-color-input') as HTMLInputElement | null;
    const fitCustomColorPreview = document.getElementById('fit-custom-color-preview') as HTMLElement | null;

    // Export Controls
    const formatButtons = root.querySelectorAll<HTMLButtonElement>('.format-pill');
    const formatInfoText = document.getElementById('format-info-text') as HTMLElement | null;
    const formatBadgePreview = document.getElementById('format-badge-preview') as HTMLElement | null;
    const moreFormatBtn = document.getElementById('more-format-btn') as HTMLButtonElement | null;
    const moreFormatLabel = document.getElementById('more-format-label') as HTMLElement | null;
    const moreFormatArrow = document.getElementById('more-format-arrow') as HTMLElement | null;
    const moreFormatMenu = document.getElementById('more-format-menu') as HTMLElement | null;
    const moreFormatOptions = root.querySelectorAll<HTMLButtonElement>('.more-format-option');
    const enableTargetSize = document.getElementById('enable-target-size') as HTMLInputElement | null;
    const targetSizeControls = document.getElementById('target-size-controls') as HTMLElement | null;
    const inputTargetSize = document.getElementById('input-target-size') as HTMLInputElement | null;
    const sizeUnitKbBtn = document.getElementById('size-unit-kb') as HTMLButtonElement | null;
    const sizeUnitMbBtn = document.getElementById('size-unit-mb') as HTMLButtonElement | null;
    const pngSizeTip = document.getElementById('pngSizeTip') as HTMLElement | null;
    const switchToWebpBtn = document.getElementById('switchToWebpBtn') as HTMLButtonElement | null;
    const switchToJpgBtn = document.getElementById('switchToJpgBtn') as HTMLButtonElement | null;
    const targetUpscaleContainer = document.getElementById('target-upscale-container') as HTMLElement | null;
    const targetUpscaleMsg = document.getElementById('target-upscale-msg') as HTMLElement | null;
    const boostUpscaleBtn = document.getElementById('boost-upscale-btn') as HTMLButtonElement | null;
    const boostUpscaleBtnText = document.getElementById('boost-upscale-btn-text') as HTMLElement | null;
    const autoUpscaleToggle = document.getElementById('auto-upscale-toggle') as HTMLInputElement | null;
    const qualitySlider = document.getElementById('quality-slider') as HTMLInputElement | null;
    const qualityValDisplay = document.getElementById('quality-val-display') as HTMLElement | null;
    const qualitySliderContainer = document.getElementById('quality-slider-container') as HTMLElement | null;

    // Summary Meta
    const summaryMetaRes = document.getElementById('summary-meta-res') as HTMLElement | null;
    const summaryMetaFormat = document.getElementById('summary-meta-format') as HTMLElement | null;
    const summaryMetaSize = document.getElementById('summary-meta-size') as HTMLElement | null;

    // Queue State
    const MAX_QUEUE_SIZE = 15;
    const imageQueue: QueueItem[] = [];
    let activeQueueIndex = 0;

    // Active Item State
    let originalImage: HTMLImageElement | null = null;
    let originalFile: File | null = null;
    let originalWidth = 0;
    let originalHeight = 0;
    let originalSizeBytes = 0;
    let originalMimeType = 'image/jpeg';

    // Active Transformations
    let rotation = 0;
    let flipH = false;
    let isCropModeActive = false;
    let inlineCropRect = { x: 0, y: 0, w: 100, h: 100 };
    let inlineCropDragState: {
      action: 'move' | 'nw' | 'ne' | 'se' | 'sw' | 'n' | 's' | 'w' | 'e';
      startX: number;
      startY: number;
      rectStart: { x: number; y: number; w: number; h: number };
    } | null = null;


    // Dimension State
    let activeUnit: 'px' | 'inch' | 'cm' | 'mm' | '%' = 'px';
    let dpi = 96;
    let isAspectLocked = true;
    let resizeMode: 'fit' | 'fill' | 'stretch' = 'fit';
    let fitBg: 'transparent' | 'blur' | 'white' | 'black' | 'custom' = 'transparent';
    let fitCustomColor = '#3b82f6';
    let targetPxW = 0;
    let targetPxH = 0;

    // Export State
    let exportFormat: SupportedFormat = 'auto';
    let isTargetSizeActive = false;
    let targetSizeValue = 50;
    let targetSizeUnit: 'KB' | 'MB' = 'KB';
    let quality = 0.92;
    let autoUpscaleActive = false;
    let isUpscaling = false;
    let lastAutoUpscaleTime = 0;

    // Debounce & Cache
    let renderDebounceTimer: number | null = null;
    let lastBlob: Blob | null = null;

    // Format Bytes
    function formatBytes(bytes: number, decimals = 1): string {
      if (bytes === 0) return '0 Bytes';
      const k = 1024;
      const dm = decimals < 0 ? 0 : decimals;
      const sizes = ['Bytes', 'KB', 'MB', 'GB'];
      const i = Math.floor(Math.log(bytes) / Math.log(k));
      return parseFloat((bytes / Math.pow(k, i)).toFixed(dm)) + ' ' + sizes[i];
    }

    // Unit Conversion
    function getEffectiveSourceWidth(): number {
      const w = originalWidth || originalImage?.naturalWidth || imageQueue[activeQueueIndex]?.width || 1;
      const h = originalHeight || originalImage?.naturalHeight || imageQueue[activeQueueIndex]?.height || 1;
      return (rotation === 90 || rotation === 270) ? h : w;
    }

    function getEffectiveSourceHeight(): number {
      const w = originalWidth || originalImage?.naturalWidth || imageQueue[activeQueueIndex]?.width || 1;
      const h = originalHeight || originalImage?.naturalHeight || imageQueue[activeQueueIndex]?.height || 1;
      return (rotation === 90 || rotation === 270) ? w : h;
    }

    function convertFromPx(px: number, unit: 'px' | 'inch' | 'cm' | 'mm' | '%', originalRef: number): number {
      if (unit === 'px') return Math.round(px);
      if (unit === 'inch') return parseFloat((px / dpi).toFixed(2));
      if (unit === 'cm') return parseFloat((px / (dpi / 2.54)).toFixed(2));
      if (unit === 'mm') return parseFloat((px / (dpi / 25.4)).toFixed(1));
      if (unit === '%') return parseFloat(((px / (originalRef || 1)) * 100).toFixed(1));
      return px;
    }

    function convertToPx(val: number, unit: 'px' | 'inch' | 'cm' | 'mm' | '%', originalRef: number): number {
      if (unit === 'px') return Math.round(val);
      if (unit === 'inch') return Math.round(val * dpi);
      if (unit === 'cm') return Math.round(val * (dpi / 2.54));
      if (unit === 'mm') return Math.round(val * (dpi / 25.4));
      if (unit === '%') return Math.round((val / 100) * originalRef);
      return Math.round(val);
    }

    function syncInputsFromPx() {
      const srcW = getEffectiveSourceWidth();
      const srcH = getEffectiveSourceHeight();

      // Fallback check: Never let targetPxW/targetPxH remain 0 or NaN
      if (!targetPxW || isNaN(targetPxW) || targetPxW <= 0) {
        targetPxW = (imageQueue[activeQueueIndex]?.targetW && imageQueue[activeQueueIndex].targetW > 0)
          ? imageQueue[activeQueueIndex].targetW
          : srcW;
      }
      if (!targetPxH || isNaN(targetPxH) || targetPxH <= 0) {
        targetPxH = (imageQueue[activeQueueIndex]?.targetH && imageQueue[activeQueueIndex].targetH > 0)
          ? imageQueue[activeQueueIndex].targetH
          : srcH;
      }

      const dispW = convertFromPx(targetPxW, activeUnit, srcW);
      const dispH = convertFromPx(targetPxH, activeUnit, srcH);

      if (inputWidth) {
        inputWidth.value = (dispW > 0 ? dispW : convertFromPx(srcW, activeUnit, srcW)).toString();
      }
      if (inputHeight) {
        inputHeight.value = (dispH > 0 ? dispH : convertFromPx(srcH, activeUnit, srcH)).toString();
      }
    }

    function updateLockUI() {
      if (!lockIconLocked || !lockIconUnlocked || !lockAspectBtn) return;
      if (isAspectLocked) {
        lockIconLocked.classList.remove('hidden');
        lockIconUnlocked.classList.add('hidden');
        lockAspectBtn.classList.add('bg-blue-50', 'dark:bg-blue-950/40', 'text-blue-600', 'dark:text-blue-400');
        lockAspectBtn.classList.remove('text-slate-400');
        lockAspectBtn.title = 'Aspect Ratio Locked (Click to unlock)';
      } else {
        lockIconLocked.classList.add('hidden');
        lockIconUnlocked.classList.remove('hidden');
        lockAspectBtn.classList.remove('bg-blue-50', 'dark:bg-blue-950/40', 'text-blue-600', 'dark:text-blue-400');
        lockAspectBtn.classList.add('text-slate-400');
        lockAspectBtn.title = 'Aspect Ratio Unlocked (Click to lock)';
      }
    }

    function updateUnitUI() {
      unitButtons.forEach(btn => {
        if (btn.dataset.unit === activeUnit) {
          btn.className = 'unit-pill py-1.5 rounded-lg text-xs font-semibold transition cursor-pointer bg-white dark:bg-slate-700 text-blue-600 dark:text-blue-400 shadow-xs';
        } else {
          btn.className = 'unit-pill py-1.5 rounded-lg text-xs font-semibold transition cursor-pointer text-slate-600 dark:text-slate-300 hover:text-slate-900';
        }
      });

      activeUnitLabels.forEach(el => {
        el.textContent = activeUnit;
      });
    }

    function changeUnit(newUnit: 'px' | 'inch' | 'cm' | 'mm' | '%') {
      if (activeUnit === newUnit) return;
      activeUnit = newUnit;
      updateUnitUI();
      syncInputsFromPx();
    }

    function updateResizeModeUI() {
      const modeOptions = root.querySelectorAll('.mode-option');
      modeOptions.forEach(opt => {
        const radio = opt.querySelector('input') as HTMLInputElement;
        const textSpan = opt.querySelector('span:first-of-type') as HTMLElement;
        if (radio && radio.value === resizeMode) {
          opt.className = 'mode-option relative flex flex-col items-center p-2.5 rounded-xl border border-blue-500 bg-blue-50/50 dark:bg-blue-950/20 text-center cursor-pointer transition';
          if (textSpan) textSpan.className = 'text-xs font-semibold text-blue-600 dark:text-blue-400';
          radio.checked = true;
        } else {
          opt.className = 'mode-option relative flex flex-col items-center p-2.5 rounded-xl border border-slate-200 dark:border-slate-700 hover:border-slate-300 text-center cursor-pointer transition';
          if (textSpan) textSpan.className = 'text-xs font-semibold text-slate-700 dark:text-slate-300';
        }
      });

      if (modeHint) {
        if (resizeMode === 'fit') {
          modeHint.textContent = 'Keep ratio with clean bounds';
        } else if (resizeMode === 'fill') {
          modeHint.textContent = 'Fill target area & crop edges';
        } else {
          modeHint.textContent = 'Force exact dimensions';
        }
      }

      if (fitBgControls) {
        if (resizeMode === 'fit') {
          fitBgControls.classList.remove('hidden');
        } else {
          fitBgControls.classList.add('hidden');
        }
      }
    }

    function setFitBg(mode: 'transparent' | 'blur' | 'white' | 'black' | 'custom', color?: string) {
      fitBg = mode;
      if (color) fitCustomColor = color;
      if (mode === 'transparent' && exportFormat === 'jpg') {
        setFormat('png');
      }
      updateFitBgUI();
    }

    function updateFitBgUI() {
      fitBgButtons.forEach(btn => {
        const bg = btn.getAttribute('data-fit-bg');
        if (bg === fitBg) {
          btn.className = 'fit-bg-btn active relative flex flex-col items-center justify-center p-2 rounded-lg border text-center transition cursor-pointer text-xs font-medium border-blue-500 bg-blue-50/80 dark:bg-blue-950/40 text-blue-600 dark:text-blue-400 shadow-2xs ring-1 ring-blue-500/20';
        } else {
          btn.className = 'fit-bg-btn relative flex flex-col items-center justify-center p-2 rounded-lg border text-center transition cursor-pointer text-xs font-medium border-slate-200 dark:border-slate-700 hover:border-slate-300 dark:hover:border-slate-600 bg-white dark:bg-slate-800 text-slate-700 dark:text-slate-300';
        }
      });

      if (fitCustomColorPreview) {
        fitCustomColorPreview.style.backgroundColor = fitCustomColor;
      }
      if (fitCustomColorInput) {
        fitCustomColorInput.value = fitCustomColor;
      }

      if (fitBgStatusLabel) {
        if (fitBg === 'transparent') fitBgStatusLabel.textContent = 'Transparent';
        else if (fitBg === 'blur') fitBgStatusLabel.textContent = 'Blur (20px)';
        else if (fitBg === 'white') fitBgStatusLabel.textContent = 'White';
        else if (fitBg === 'black') fitBgStatusLabel.textContent = 'Black';
        else if (fitBg === 'custom') fitBgStatusLabel.textContent = `Custom (${fitCustomColor.toUpperCase()})`;
      }
    }

    // PDF Blob Generation
    function createPdfBlob(jpegBytes: Uint8Array, widthPx: number, heightPx: number, pdfDpi = 96): Blob {
      const ptW = Math.round(((widthPx * 72) / pdfDpi) * 100) / 100;
      const ptH = Math.round(((heightPx * 72) / pdfDpi) * 100) / 100;

      const enc = new TextEncoder();
      const parts: (Uint8Array | string)[] = [];
      const offsets: number[] = [0];
      let currentOffset = 0;

      function writeString(str: string) {
        const b = enc.encode(str);
        parts.push(b);
        currentOffset += b.length;
      }

      function writeBytes(b: Uint8Array) {
        parts.push(b);
        currentOffset += b.length;
      }

      writeString("%PDF-1.4\n%\xE2\xE3\xCF\xD3\n");

      // Obj 1: Catalog
      offsets.push(currentOffset);
      writeString("1 0 obj\n<< /Type /Catalog /Pages 2 0 R >>\nendobj\n");

      // Obj 2: Pages
      offsets.push(currentOffset);
      writeString("2 0 obj\n<< /Type /Pages /Kids [3 0 R] /Count 1 >>\nendobj\n");

      // Obj 3: Page
      offsets.push(currentOffset);
      writeString(
        `3 0 obj\n<< /Type /Page /Parent 2 0 R /MediaBox [0 0 ${ptW} ${ptH}] /Contents 4 0 R /Resources << /ProcSet [/PDF /ImageC] /XObject << /Im1 5 0 R >> >> >>\nendobj\n`
      );

      // Obj 4: Content Stream
      const contentStream = `q\n${ptW} 0 0 ${ptH} 0 0 cm\n/Im1 Do\nQ\n`;
      const contentBytes = enc.encode(contentStream);
      offsets.push(currentOffset);
      writeString(`4 0 obj\n<< /Length ${contentBytes.length} >>\nstream\n`);
      writeBytes(contentBytes);
      writeString("endstream\nendobj\n");

      // Obj 5: Image XObject
      offsets.push(currentOffset);
      writeString(
        `5 0 obj\n<< /Type /XObject /Subtype /Image /Width ${widthPx} /Height ${heightPx} /ColorSpace /DeviceRGB /BitsPerComponent 8 /Filter /DCTDecode /Length ${jpegBytes.length} >>\nstream\n`
      );
      writeBytes(jpegBytes);
      writeString("\nendstream\nendobj\n");

      // xref
      const xrefOffset = currentOffset;
      writeString("xref\n0 6\n0000000000 65535 f \r\n");
      for (let i = 1; i <= 5; i++) {
        const offStr = String(offsets[i]).padStart(10, '0');
        writeString(`${offStr} 00000 n \r\n`);
      }

      writeString(`trailer\n<< /Size 6 /Root 1 0 R >>\nstartxref\n${xrefOffset}\n%%EOF\n`);

      return new Blob(parts as unknown as BlobPart[], { type: 'application/pdf' });
    }

    // ICO Blob Generation
    async function createIcoBlob(sourceCanvas: HTMLCanvasElement): Promise<Blob> {
      const sizes = [16, 32, 48];
      const images: { width: number; height: number; bytes: Uint8Array }[] = [];

      for (const size of sizes) {
        const off = document.createElement('canvas');
        off.width = size;
        off.height = size;
        const ctx = off.getContext('2d');
        if (!ctx) continue;
        ctx.imageSmoothingEnabled = true;
        ctx.imageSmoothingQuality = 'high';
        ctx.drawImage(sourceCanvas, 0, 0, size, size);

        const b = await new Promise<Blob | null>((res) => off.toBlob(res, 'image/png'));
        if (!b) continue;
        const buf = await b.arrayBuffer();
        images.push({
          width: size,
          height: size,
          bytes: new Uint8Array(buf),
        });
      }

      const numImages = images.length;
      const headerSize = 6;
      const entrySize = 16;
      const offset = headerSize + entrySize * numImages;

      const totalSize = offset + images.reduce((acc, img) => acc + img.bytes.length, 0);
      const buffer = new Uint8Array(totalSize);
      const view = new DataView(buffer.buffer);

      view.setUint16(0, 0, true);
      view.setUint16(2, 1, true);
      view.setUint16(4, numImages, true);

      let entryOffset = headerSize;
      let dataOffset = offset;

      for (const img of images) {
        view.setUint8(entryOffset + 0, img.width === 256 ? 0 : img.width);
        view.setUint8(entryOffset + 1, img.height === 256 ? 0 : img.height);
        view.setUint8(entryOffset + 2, 0);
        view.setUint8(entryOffset + 3, 0);
        view.setUint16(entryOffset + 4, 1, true);
        view.setUint16(entryOffset + 6, 32, true);
        view.setUint32(entryOffset + 8, img.bytes.length, true);
        view.setUint32(entryOffset + 12, dataOffset, true);

        buffer.set(img.bytes, dataOffset);

        entryOffset += entrySize;
        dataOffset += img.bytes.length;
      }

      return new Blob([buffer], { type: 'image/x-icon' });
    }

    function setFormat(format: SupportedFormat) {
      exportFormat = format;

      const isMoreFormat = ['avif', 'pdf', 'ico'].includes(format);

      formatButtons.forEach(btn => {
        if (btn.dataset.format === format) {
          btn.className = 'format-pill py-2 rounded-xl text-xs font-semibold border-2 border-blue-500 bg-blue-50/50 dark:bg-blue-950/30 text-blue-600 dark:text-blue-400 transition cursor-pointer';
        } else {
          btn.className = 'format-pill py-2 rounded-xl text-xs font-semibold border border-slate-200 dark:border-slate-700 hover:border-blue-500 text-slate-700 dark:text-slate-300 transition cursor-pointer';
        }
      });

      if (moreFormatLabel) {
        if (isMoreFormat) {
          const names: Record<string, string> = { avif: 'AVIF (Selected)', pdf: 'PDF (Selected)', ico: 'ICO (Selected)' };
          moreFormatLabel.textContent = names[format] || 'More Formats';
        } else {
          moreFormatLabel.textContent = 'More Formats (AVIF, PDF, ICO...)';
        }
      }

      if (formatBadgePreview) {
        formatBadgePreview.textContent = format.toUpperCase();
      }

      if (formatInfoText) {
        if (format === 'auto') {
          formatInfoText.textContent = 'Preserves the original uploaded file format.';
        } else if (format === 'jpg') {
          formatInfoText.textContent = 'Standard photo compression with quality controls.';
        } else if (format === 'png') {
          formatInfoText.textContent = 'Lossless with transparent alpha background support.';
        } else if (format === 'webp') {
          formatInfoText.textContent = 'High-efficiency modern web standard (smaller than JPG/PNG).';
        } else if (format === 'avif') {
          formatInfoText.textContent = 'Maximum compression efficiency for next-gen browsers.';
        } else if (format === 'pdf') {
          formatInfoText.textContent = 'Embeds high-resolution image into a printable PDF page.';
        } else if (format === 'ico') {
          formatInfoText.textContent = 'Multi-resolution Windows icon & website favicon.';
        }
      }
      updatePngSizeTip();
    }

    function updatePngSizeTip() {
      const isPng = exportFormat === 'png' || (exportFormat === 'auto' && getTargetMimeType() === 'image/png');
      const shouldShow = isTargetSizeActive && isPng;
      if (pngSizeTip) {
        if (shouldShow) {
          pngSizeTip.classList.remove('hidden');
        } else {
          pngSizeTip.classList.add('hidden');
        }
      }
    }

    function updateTargetSizeControlsUI() {
      if (!targetSizeControls || !qualitySliderContainer) return;
      if (isTargetSizeActive) {
        targetSizeControls.classList.remove('opacity-50', 'pointer-events-none');
        qualitySliderContainer.classList.add('opacity-40', 'pointer-events-none');
        if (lastBlob) {
          updateUpscaleUI(lastBlob.size);
        }
      } else {
        targetSizeControls.classList.add('opacity-50', 'pointer-events-none');
        qualitySliderContainer.classList.remove('opacity-40', 'pointer-events-none');
        if (targetUpscaleContainer) {
          targetUpscaleContainer.classList.add('hidden');
        }
      }
      updatePngSizeTip();
    }

    function switchTab(tab: 'resize' | 'export') {
      if (tab === 'resize') {
        tabPaneResize?.classList.remove('hidden');
        tabPaneExport?.classList.add('hidden');
        tabBtnResize?.classList.add('bg-white', 'dark:bg-slate-700', 'text-slate-900', 'dark:text-white', 'shadow-sm');
        tabBtnResize?.classList.remove('text-slate-500', 'dark:text-slate-400');
        tabBtnExport?.classList.remove('bg-white', 'dark:bg-slate-700', 'text-slate-900', 'dark:text-white', 'shadow-sm');
        tabBtnExport?.classList.add('text-slate-500', 'dark:text-slate-400');
      } else {
        tabPaneResize?.classList.add('hidden');
        tabPaneExport?.classList.remove('hidden');
        tabBtnExport?.classList.add('bg-white', 'dark:bg-slate-700', 'text-slate-900', 'dark:text-white', 'shadow-sm');
        tabBtnExport?.classList.remove('text-slate-500', 'dark:text-slate-400');
        tabBtnResize?.classList.remove('bg-white', 'dark:bg-slate-700', 'text-slate-900', 'dark:text-white', 'shadow-sm');
        tabBtnResize?.classList.add('text-slate-500', 'dark:text-slate-400');
      }
    }

    function getTargetMimeType(): string {
      if (exportFormat === 'auto') {
        if (fitBg === 'transparent' && resizeMode === 'fit') {
          if (originalMimeType === 'image/png' || originalMimeType === 'image/webp' || originalMimeType === 'image/avif') {
            return originalMimeType;
          }
          return 'image/png';
        }
        return originalMimeType || 'image/jpeg';
      }
      if (exportFormat === 'jpg') return 'image/jpeg';
      if (exportFormat === 'png') return 'image/png';
      if (exportFormat === 'webp') return 'image/webp';
      if (exportFormat === 'avif') return 'image/avif';
      return 'image/jpeg';
    }

    function getExtensionForFormat(fmt: SupportedFormat, blobType: string): string {
      if (fmt === 'jpg') return 'jpg';
      if (fmt === 'png') return 'png';
      if (fmt === 'webp') return 'webp';
      if (fmt === 'avif') return blobType === 'image/avif' ? 'avif' : 'webp';
      if (fmt === 'pdf') return 'pdf';
      if (fmt === 'ico') return 'ico';
      const m = getTargetMimeType();
      return m === 'image/png' ? 'png' : m === 'image/webp' ? 'webp' : 'jpg';
    }

    async function binarySearchQuality(mime: string, targetBytes: number, canvas: HTMLCanvasElement = previewCanvas!): Promise<Blob> {
      if (!canvas) {
        return new Blob([], { type: mime });
      }

      // 1. STRICT PNG DIMENSION DOWNSCALING (UNDER TARGET KB)
      // Browsers ignore quality parameter for PNG (lossless), so we iteratively downscale canvas dimensions
      if (mime === 'image/png') {
        const origBlob = await new Promise<Blob | null>((res) => canvas.toBlob(res, 'image/png'));
        if (origBlob && origBlob.size <= targetBytes) {
          return origBlob;
        }

        let bestBlob: Blob | null = origBlob;
        const pngScaleFactors = [0.95, 0.85, 0.70, 0.55, 0.40, 0.25, 0.18, 0.12, 0.08, 0.05];

        for (const scale of pngScaleFactors) {
          const sW = Math.max(1, Math.round(canvas.width * scale));
          const sH = Math.max(1, Math.round(canvas.height * scale));
          const scaledCanvas = document.createElement('canvas');
          scaledCanvas.width = sW;
          scaledCanvas.height = sH;
          const sCtx = scaledCanvas.getContext('2d');
          if (!sCtx) continue;
          sCtx.imageSmoothingEnabled = true;
          sCtx.imageSmoothingQuality = 'high';
          sCtx.drawImage(canvas, 0, 0, sW, sH);

          const curBlob = await new Promise<Blob | null>((res) => scaledCanvas.toBlob(res, 'image/png'));
          if (curBlob) {
            bestBlob = curBlob;
            if (curBlob.size <= targetBytes) {
              return curBlob;
            }
          }
        }

        // Further downscale if still exceeding for micro target limits
        let extraScale = 0.04;
        while (extraScale > 0.005) {
          const sW = Math.max(1, Math.round(canvas.width * extraScale));
          const sH = Math.max(1, Math.round(canvas.height * extraScale));
          const scaledCanvas = document.createElement('canvas');
          scaledCanvas.width = sW;
          scaledCanvas.height = sH;
          const sCtx = scaledCanvas.getContext('2d');
          if (!sCtx) break;
          sCtx.imageSmoothingEnabled = true;
          sCtx.imageSmoothingQuality = 'high';
          sCtx.drawImage(canvas, 0, 0, sW, sH);

          const curBlob = await new Promise<Blob | null>((res) => scaledCanvas.toBlob(res, 'image/png'));
          if (curBlob) {
            bestBlob = curBlob;
            if (curBlob.size <= targetBytes) {
              return curBlob;
            }
          }
          extraScale *= 0.6;
        }

        return bestBlob || origBlob || new Blob([], { type: 'image/png' });
      }

      // 2. JPG / WebP / AVIF: Binary search on quality, and proportionally scale down dimensions if still exceeding
      const maxQBlob = await new Promise<Blob | null>((res) => canvas.toBlob(res, mime, 1.0));
      if (maxQBlob && maxQBlob.size <= targetBytes) {
        return maxQBlob;
      }

      const minQ = 0.02;
      const minQBlob = await new Promise<Blob | null>((res) => canvas.toBlob(res, mime, minQ));

      if (minQBlob && minQBlob.size <= targetBytes) {
        let low = minQ;
        let high = 1.0;
        let bestBlob: Blob = minQBlob;

        for (let step = 0; step < 8; step++) {
          const mid = (low + high) / 2;
          const b = await new Promise<Blob | null>((res) => canvas.toBlob(res, mime, mid));
          if (!b) break;

          if (b.size <= targetBytes) {
            bestBlob = b;
            low = mid;
          } else {
            high = mid;
          }
        }
        return bestBlob;
      }

      // Still exceeding at lowest quality: proportionally scale down canvas dimensions
      let bestScaledBlob: Blob | null = minQBlob;
      const lossyScales = [0.90, 0.80, 0.70, 0.60, 0.50, 0.40, 0.30, 0.20, 0.10, 0.05];

      for (const scale of lossyScales) {
        const sW = Math.max(1, Math.round(canvas.width * scale));
        const sH = Math.max(1, Math.round(canvas.height * scale));
        const scaledCanvas = document.createElement('canvas');
        scaledCanvas.width = sW;
        scaledCanvas.height = sH;
        const sCtx = scaledCanvas.getContext('2d');
        if (!sCtx) continue;
        sCtx.imageSmoothingEnabled = true;
        sCtx.imageSmoothingQuality = 'high';
        sCtx.drawImage(canvas, 0, 0, sW, sH);

        const testBlob = await new Promise<Blob | null>((res) => scaledCanvas.toBlob(res, mime, 0.05));
        if (testBlob) {
          bestScaledBlob = testBlob;
          if (testBlob.size <= targetBytes) {
            // Found canvas dimensions that can fit under targetBytes!
            // Run binary search on quality to maximize visual sharpness
            let sLow = 0.05;
            let sHigh = 0.95;
            let sBest: Blob = testBlob;

            for (let step = 0; step < 6; step++) {
              const mid = (sLow + sHigh) / 2;
              const b = await new Promise<Blob | null>((res) => scaledCanvas.toBlob(res, mime, mid));
              if (!b) break;
              if (b.size <= targetBytes) {
                sBest = b;
                sLow = mid;
              } else {
                sHigh = mid;
              }
            }
            return sBest;
          }
        }
      }

      return bestScaledBlob || minQBlob || maxQBlob || new Blob([], { type: mime });
    }

    async function computeExportBlob() {
      if (!originalImage || !previewCanvas) return;

      const mimeType = getTargetMimeType();
      let formatLabel = exportFormat.toUpperCase();
      if (exportFormat === 'auto') {
        formatLabel = mimeType === 'image/png' ? 'PNG' : mimeType === 'image/webp' ? 'WEBP' : 'JPG';
      }
      if (summaryMetaFormat) summaryMetaFormat.textContent = `FORMAT: ${formatLabel}`;

      let canvasToExport: HTMLCanvasElement = previewCanvas;
      const formatSupportsAlpha = exportFormat === 'png' || 
                                  exportFormat === 'webp' || 
                                  exportFormat === 'avif' || 
                                  exportFormat === 'ico' ||
                                  (exportFormat === 'auto' && (mimeType === 'image/png' || mimeType === 'image/webp' || mimeType === 'image/avif'));

      if (fitBg === 'transparent' && resizeMode === 'fit') {
        if (!formatSupportsAlpha) {
          // Format cannot physically represent transparency (e.g. JPG or PDF)
          const tempCanvas = document.createElement('canvas');
          tempCanvas.width = previewCanvas.width;
          tempCanvas.height = previewCanvas.height;
          const tempCtx = tempCanvas.getContext('2d');
          if (tempCtx) {
            tempCtx.fillStyle = '#ffffff';
            tempCtx.fillRect(0, 0, tempCanvas.width, tempCanvas.height);
            tempCtx.drawImage(previewCanvas, 0, 0);
            canvasToExport = tempCanvas;
          }
        } else {
          // Format supports transparency: strictly keep canvasToExport as previewCanvas without solid fill
          canvasToExport = previewCanvas;
        }
      }

      let blob: Blob | null = null;

      if (exportFormat === 'pdf') {
        let jpegBytes: Uint8Array | null = null;
        if (isTargetSizeActive) {
          const targetBytes = (targetSizeUnit === 'MB' ? targetSizeValue * 1024 * 1024 : targetSizeValue * 1024);
          const jpegTarget = Math.max(1024, targetBytes - 700);
          const jpegBlob = await binarySearchQuality('image/jpeg', jpegTarget, canvasToExport);
          jpegBytes = new Uint8Array(await jpegBlob.arrayBuffer());
        } else {
          const jpegBlob = await new Promise<Blob | null>((resolve) => {
            canvasToExport.toBlob((b) => resolve(b), 'image/jpeg', quality);
          });
          if (jpegBlob) {
            jpegBytes = new Uint8Array(await jpegBlob.arrayBuffer());
          }
        }
        if (jpegBytes) {
          blob = createPdfBlob(jpegBytes, canvasToExport.width, canvasToExport.height, dpi);
        }
      } else if (exportFormat === 'ico') {
        blob = await createIcoBlob(canvasToExport);
      } else if (exportFormat === 'avif') {
        if (isTargetSizeActive) {
          const targetBytes = (targetSizeUnit === 'MB' ? targetSizeValue * 1024 * 1024 : targetSizeValue * 1024);
          blob = await binarySearchQuality('image/avif', targetBytes, canvasToExport);
        } else {
          blob = await new Promise<Blob | null>((resolve) => {
            canvasToExport.toBlob((b) => resolve(b), 'image/avif', quality);
          });
        }
        if (!blob || blob.size === 0) {
          blob = await new Promise<Blob | null>((resolve) => {
            canvasToExport.toBlob((b) => resolve(b), 'image/webp', quality);
          });
        }
      } else {
        if (isTargetSizeActive) {
          const targetBytes = (targetSizeUnit === 'MB' ? targetSizeValue * 1024 * 1024 : targetSizeValue * 1024);
          blob = await binarySearchQuality(mimeType, targetBytes, canvasToExport);
        } else {
          blob = await new Promise<Blob | null>((resolve) => {
            canvasToExport.toBlob((b) => resolve(b), mimeType, quality);
          });
        }
      }

      lastBlob = blob;

      if (blob) {
        const estText = `Est. ~${formatBytes(blob.size)}`;
        if (previewSizePill) previewSizePill.textContent = estText;
        if (summaryMetaSize) summaryMetaSize.textContent = `SIZE: ${formatBytes(blob.size)}`;

        if (originalSizeBytes > 0 && previewSavingsPill) {
          const diff = originalSizeBytes - blob.size;
          const pct = Math.round((diff / originalSizeBytes) * 100);
          if (pct > 0) {
            previewSavingsPill.textContent = `-${pct}%`;
            previewSavingsPill.classList.remove('hidden');
          } else if (pct < 0) {
            previewSavingsPill.textContent = `+${Math.abs(pct)}%`;
            previewSavingsPill.classList.remove('hidden');
          } else {
            previewSavingsPill.classList.add('hidden');
          }
        }

        updateUpscaleUI(blob.size);
      }
    }

    function updateUpscaleUI(currentSize: number) {
      if (!targetUpscaleContainer || !targetUpscaleMsg || !boostUpscaleBtnText) return;

      if (!isTargetSizeActive) {
        targetUpscaleContainer.classList.add('hidden');
        return;
      }

      const targetBytes = (targetSizeUnit === 'MB' ? targetSizeValue * 1024 * 1024 : targetSizeValue * 1024);
      const targetStr = `${targetSizeValue} ${targetSizeUnit}`;

      // Show upscale suggestion when current blob size is less than 90% of target
      if (currentSize < 0.90 * targetBytes) {
        const currentStr = formatBytes(currentSize);
        targetUpscaleMsg.innerHTML = `Image is currently <strong class="text-blue-600 dark:text-blue-400 font-mono">${currentStr}</strong> (under ${targetStr} limit).`;
        boostUpscaleBtnText.textContent = `Boost to ~${targetStr}`;
        targetUpscaleContainer.classList.remove('hidden');

        // Auto-match if active and not already upscaling
        const now = Date.now();
        if (autoUpscaleActive && !isUpscaling && now - lastAutoUpscaleTime > 700) {
          lastAutoUpscaleTime = now;
          upscaleCanvasToTargetKB();
        }
      } else {
        targetUpscaleContainer.classList.add('hidden');
      }
    }

    async function upscaleCanvasToTargetKB(): Promise<boolean> {
      if (!originalImage || isUpscaling || !isTargetSizeActive) return false;

      const targetBytes = (targetSizeUnit === 'MB' ? targetSizeValue * 1024 * 1024 : targetSizeValue * 1024);
      if (targetBytes <= 0) return false;

      const effSrcW = getEffectiveSourceWidth();
      const effSrcH = getEffectiveSourceHeight();
      if (effSrcW <= 0 || effSrcH <= 0) return false;

      const baseW = targetPxW > 0 ? targetPxW : effSrcW;
      const baseH = targetPxH > 0 ? targetPxH : effSrcH;
      const ratio = baseH / baseW;

      isUpscaling = true;
      if (boostUpscaleBtnText) boostUpscaleBtnText.textContent = 'Matching...';
      if (boostUpscaleBtn) boostUpscaleBtn.disabled = true;

      try {
        const mimeType = getTargetMimeType();

        // Prepare oriented base buffer
        const buffer = document.createElement('canvas');
        buffer.width = effSrcW;
        buffer.height = effSrcH;
        const bCtx = buffer.getContext('2d');
        if (!bCtx) return false;

        bCtx.save();
        bCtx.translate(effSrcW / 2, effSrcH / 2);
        bCtx.rotate((rotation * Math.PI) / 180);
        if (flipH) bCtx.scale(-1, 1);
        bCtx.drawImage(originalImage, -originalWidth / 2, -originalHeight / 2);
        bCtx.restore();

        let currentSize = lastBlob ? lastBlob.size : 0;
        if (currentSize === 0) {
          const testCanvas = document.createElement('canvas');
          testCanvas.width = baseW;
          testCanvas.height = baseH;
          const tCtx = testCanvas.getContext('2d');
          if (tCtx) {
            tCtx.imageSmoothingEnabled = true;
            tCtx.imageSmoothingQuality = 'high';
            tCtx.drawImage(buffer, 0, 0, baseW, baseH);
            const b = await new Promise<Blob | null>((res) => testCanvas.toBlob(res, mimeType, 0.95));
            if (b) currentSize = b.size;
          }
        }

        if (currentSize >= 0.90 * targetBytes) {
          return true;
        }

        // Proportional step-by-step resolution upscale
        const areaMultiplier = targetBytes / Math.max(1024, currentSize);
        const estScale = Math.max(1.1, Math.sqrt(areaMultiplier));

        let lowScale = 1.0;
        let highScale = Math.min(10.0, Math.max(2.0, estScale * 1.5));
        let bestW = baseW;
        let bestH = baseH;

        const maxSteps = 8;
        for (let i = 0; i < maxSteps; i++) {
          const midScale = (lowScale + highScale) / 2;
          const testW = Math.max(1, Math.round(baseW * midScale));
          const testH = Math.max(1, Math.round(baseW * midScale * ratio));

          if (testW * testH > 36000000) {
            highScale = midScale;
            continue;
          }

          const offCanvas = document.createElement('canvas');
          offCanvas.width = testW;
          offCanvas.height = testH;
          const offCtx = offCanvas.getContext('2d');
          if (!offCtx) break;

          offCtx.imageSmoothingEnabled = true;
          offCtx.imageSmoothingQuality = 'high';
          offCtx.drawImage(buffer, 0, 0, testW, testH);

          const stepBlob = await new Promise<Blob | null>((res) => {
            if (mimeType === 'image/png') {
              offCanvas.toBlob(res, 'image/png');
            } else {
              offCanvas.toBlob(res, mimeType, 0.92);
            }
          });

          if (!stepBlob) break;

          const size = stepBlob.size;

          if (size >= 0.90 * targetBytes && size <= targetBytes) {
            bestW = testW;
            bestH = testH;
            break;
          }

          if (size < targetBytes) {
            bestW = testW;
            bestH = testH;
            lowScale = midScale;
          } else {
            highScale = midScale;
          }
        }

        if (bestW > 0 && bestH > 0 && (bestW !== targetPxW || bestH !== targetPxH)) {
          targetPxW = bestW;
          targetPxH = bestH;

          if (imageQueue[activeQueueIndex]) {
            imageQueue[activeQueueIndex].targetW = targetPxW;
            imageQueue[activeQueueIndex].targetH = targetPxH;
          }

          syncInputsFromPx();
          await renderCanvas();
          return true;
        }

        return false;
      } finally {
        isUpscaling = false;
        if (boostUpscaleBtnText) {
          const targetStr = `${targetSizeValue} ${targetSizeUnit}`;
          boostUpscaleBtnText.textContent = `Boost to ~${targetStr}`;
        }
        if (boostUpscaleBtn) {
          boostUpscaleBtn.disabled = false;
        }
      }
    }

    async function renderCanvas() {
      if (!originalImage || !previewCanvas || !canvasCtx) return;

      // Ensure original image dimensions are valid before drawing
      let natW = originalImage.naturalWidth || originalWidth;
      let natH = originalImage.naturalHeight || originalHeight;

      if (natW <= 0 || natH <= 0) {
        try {
          if ('decode' in originalImage) {
            await originalImage.decode();
          }
          natW = originalImage.naturalWidth || originalWidth;
          natH = originalImage.naturalHeight || originalHeight;
        } catch {
          // ignore
        }
      }

      // If still invalid, fallback to active item dimensions or abort before corrupting canvas
      if (natW <= 0 || natH <= 0) {
        const currentItem = imageQueue[activeQueueIndex];
        if (currentItem && currentItem.width > 0 && currentItem.height > 0) {
          natW = currentItem.width;
          natH = currentItem.height;
        } else {
          return;
        }
      }

      originalWidth = natW;
      originalHeight = natH;

      const effSrcW = getEffectiveSourceWidth();
      const effSrcH = getEffectiveSourceHeight();

      // Fallback check: Never allow 0 or NaN target dimensions
      if (!targetPxW || isNaN(targetPxW) || targetPxW <= 0) {
        targetPxW = effSrcW;
      }
      if (!targetPxH || isNaN(targetPxH) || targetPxH <= 0) {
        targetPxH = effSrcH;
      }

      const targetW = Math.max(1, Math.round(targetPxW));
      const targetH = Math.max(1, Math.round(targetPxH));

      previewCanvas.width = targetW;
      previewCanvas.height = targetH;

      if (previewDimPill) previewDimPill.textContent = `${targetW} × ${targetH} px`;
      if (summaryMetaRes) summaryMetaRes.textContent = `${targetW} × ${targetH} px`;

      // Step 1: Render oriented image to offscreen buffer
      const buffer = document.createElement('canvas');
      buffer.width = effSrcW;
      buffer.height = effSrcH;
      const bCtx = buffer.getContext('2d');
      if (!bCtx) return;

      bCtx.save();
      bCtx.translate(effSrcW / 2, effSrcH / 2);
      bCtx.rotate((rotation * Math.PI) / 180);
      if (flipH) {
        bCtx.scale(-1, 1);
      }
      bCtx.drawImage(originalImage, -originalWidth / 2, -originalHeight / 2);
      bCtx.restore();

      // Step 2: Draw onto preview canvas
      canvasCtx.clearRect(0, 0, targetW, targetH);

      if (resizeMode === 'fit') {
        const scale = Math.min(targetW / effSrcW, targetH / effSrcH);
        const drawW = effSrcW * scale;
        const drawH = effSrcH * scale;
        const dx = (targetW - drawW) / 2;
        const dy = (targetH - drawH) / 2;

        if (fitBg === 'blur') {
          canvasCtx.save();
          const bgScale = Math.max(targetW / effSrcW, targetH / effSrcH) * 1.12;
          const bgW = effSrcW * bgScale;
          const bgH = effSrcH * bgScale;
          const bgX = (targetW - bgW) / 2;
          const bgY = (targetH - bgH) / 2;
          canvasCtx.filter = 'blur(20px)';
          canvasCtx.drawImage(buffer, bgX, bgY, bgW, bgH);
          canvasCtx.restore();
        } else if (fitBg === 'white') {
          canvasCtx.fillStyle = '#ffffff';
          canvasCtx.fillRect(0, 0, targetW, targetH);
        } else if (fitBg === 'black') {
          canvasCtx.fillStyle = '#000000';
          canvasCtx.fillRect(0, 0, targetW, targetH);
        } else if (fitBg === 'custom') {
          canvasCtx.fillStyle = fitCustomColor || '#3b82f6';
          canvasCtx.fillRect(0, 0, targetW, targetH);
        }
        // When fitBg === 'transparent', canvasCtx.clearRect already cleared the canvas to pure transparent!

        canvasCtx.imageSmoothingEnabled = true;
        canvasCtx.imageSmoothingQuality = 'high';
        canvasCtx.drawImage(buffer, dx, dy, drawW, drawH);
      } else if (resizeMode === 'fill') {
        const scale = Math.max(targetW / effSrcW, targetH / effSrcH);
        const drawW = effSrcW * scale;
        const drawH = effSrcH * scale;
        const dx = (targetW - drawW) / 2;
        const dy = (targetH - drawH) / 2;

        canvasCtx.imageSmoothingEnabled = true;
        canvasCtx.imageSmoothingQuality = 'high';
        canvasCtx.drawImage(buffer, dx, dy, drawW, drawH);
      } else {
        canvasCtx.imageSmoothingEnabled = true;
        canvasCtx.imageSmoothingQuality = 'high';
        canvasCtx.drawImage(buffer, 0, 0, targetW, targetH);
      }

      await computeExportBlob();
    }

    function triggerRender() {
      if (renderDebounceTimer !== null) {
        window.clearTimeout(renderDebounceTimer);
      }
      renderDebounceTimer = window.setTimeout(() => {
        renderCanvas();
      }, 50);
    }

    function handleWidthInput() {
      if (!inputWidth) return;
      const val = parseFloat(inputWidth.value);
      if (isNaN(val) || val <= 0) return;

      if (socialPresetSelect) socialPresetSelect.value = '';

      const srcW = getEffectiveSourceWidth();
      const srcH = getEffectiveSourceHeight();
      const newPxW = convertToPx(val, activeUnit, srcW);

      if (isAspectLocked && srcW > 0) {
        const ratio = srcH / srcW;
        targetPxW = newPxW;
        targetPxH = Math.max(1, Math.round(newPxW * ratio));
        const dispH = convertFromPx(targetPxH, activeUnit, srcH);
        if (inputHeight) inputHeight.value = dispH.toString();
      } else {
        targetPxW = newPxW;
      }

      if (imageQueue[activeQueueIndex]) {
        if (targetPxW > 0 && !isNaN(targetPxW)) {
          imageQueue[activeQueueIndex].targetW = targetPxW;
        }
        if (targetPxH > 0 && !isNaN(targetPxH)) {
          imageQueue[activeQueueIndex].targetH = targetPxH;
        }
      }

      triggerRender();
    }

    function handleHeightInput() {
      if (!inputHeight) return;
      const val = parseFloat(inputHeight.value);
      if (isNaN(val) || val <= 0) return;

      if (socialPresetSelect) socialPresetSelect.value = '';

      const srcW = getEffectiveSourceWidth();
      const srcH = getEffectiveSourceHeight();
      const newPxH = convertToPx(val, activeUnit, srcH);

      if (isAspectLocked && srcH > 0) {
        const ratio = srcW / srcH;
        targetPxH = newPxH;
        targetPxW = Math.max(1, Math.round(newPxH * ratio));
        const dispW = convertFromPx(targetPxW, activeUnit, srcW);
        if (inputWidth) inputWidth.value = dispW.toString();
      } else {
        targetPxH = newPxH;
      }

      if (imageQueue[activeQueueIndex]) {
        if (targetPxW > 0 && !isNaN(targetPxW)) {
          imageQueue[activeQueueIndex].targetW = targetPxW;
        }
        if (targetPxH > 0 && !isNaN(targetPxH)) {
          imageQueue[activeQueueIndex].targetH = targetPxH;
        }
      }

      triggerRender();
    }

    // Queue Strip UI Rendering
    function updateQueueUI() {
      const count = imageQueue.length;
      if (queueCounter) {
        queueCounter.textContent = `${count}/${MAX_QUEUE_SIZE}`;
      }

      if (count > 1) {
        batchDownloadBtn?.classList.remove('hidden');
        if (batchDownloadLabel) {
          batchDownloadLabel.textContent = `Download All as ZIP (${count} Images)`;
        }
        if (downloadBtnLabel) {
          downloadBtnLabel.textContent = 'Download Current Image';
        }
      } else {
        batchDownloadBtn?.classList.add('hidden');
        if (downloadBtnLabel) {
          downloadBtnLabel.textContent = 'Download Resized Image';
        }
      }
    }

    function renderQueueStrip() {
      if (!queueStrip) return;
      queueStrip.innerHTML = '';

      imageQueue.forEach((item, index) => {
        const isActive = index === activeQueueIndex;

        const card = document.createElement('div');
        card.className = isActive
          ? 'relative group flex items-center gap-3 p-2.5 rounded-xl border-2 border-blue-500 bg-blue-50/70 dark:bg-blue-950/40 shrink-0 min-w-[200px] max-w-[220px] transition-all cursor-pointer shadow-xs'
          : 'relative group flex items-center gap-3 p-2.5 rounded-xl border border-slate-200 dark:border-slate-800 bg-white dark:bg-slate-900 hover:border-slate-300 dark:hover:border-slate-700 shrink-0 min-w-[200px] max-w-[220px] transition-all cursor-pointer shadow-2xs';

        // Thumbnail image
        const imgEl = document.createElement('img');
        imgEl.src = item.thumbDataUrl;
        imgEl.className = 'w-11 h-11 rounded-lg object-cover bg-slate-100 dark:bg-slate-800 shrink-0 border border-slate-200/80 dark:border-slate-700/80';
        imgEl.alt = item.name;

        // Meta Info
        const metaDiv = document.createElement('div');
        metaDiv.className = 'min-w-0 flex-1';

        const nameP = document.createElement('p');
        nameP.className = 'text-xs font-semibold text-slate-800 dark:text-slate-200 truncate';
        nameP.textContent = item.name;

        const dimP = document.createElement('p');
        dimP.className = 'text-[10px] text-slate-500 dark:text-slate-400 font-mono mt-0.5';
        dimP.textContent = `${item.targetW || item.width} × ${item.targetH || item.height} px`;

        const sizeP = document.createElement('p');
        sizeP.className = 'text-[10px] text-slate-400 dark:text-slate-500 font-mono';
        sizeP.textContent = formatBytes(item.size);

        metaDiv.appendChild(nameP);
        metaDiv.appendChild(dimP);
        metaDiv.appendChild(sizeP);

        // Remove Button
        const removeBtn = document.createElement('button');
        removeBtn.type = 'button';
        removeBtn.className = 'absolute -top-1.5 -right-1.5 w-5 h-5 rounded-full bg-rose-500 hover:bg-rose-600 text-white flex items-center justify-center text-[10px] font-bold shadow-sm transition-transform hover:scale-110 cursor-pointer opacity-90 group-hover:opacity-100';
        removeBtn.title = 'Remove this image from queue';
        removeBtn.innerHTML = '&times;';
        removeBtn.addEventListener('click', (e) => {
          e.stopPropagation();
          removeQueueItem(index);
        });

        card.appendChild(imgEl);
        card.appendChild(metaDiv);
        card.appendChild(removeBtn);

        card.addEventListener('click', () => {
          selectQueueItem(index);
        });

        queueStrip.appendChild(card);
      });

      // Append "+ Add Image" Card if < 15
      if (imageQueue.length < MAX_QUEUE_SIZE) {
        const addCard = document.createElement('button');
        addCard.type = 'button';
        addCard.className = 'flex flex-col items-center justify-center min-w-[120px] h-[64px] rounded-xl border-2 border-dashed border-slate-300 dark:border-slate-700 hover:border-blue-500 hover:bg-blue-50/30 dark:hover:bg-blue-950/20 text-slate-500 dark:text-slate-400 hover:text-blue-600 dark:hover:text-blue-400 transition-all cursor-pointer shrink-0';
        addCard.innerHTML = `
          <div class="flex items-center gap-1.5 text-xs font-semibold">
            <svg class="w-3.5 h-3.5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5">
              <path stroke-linecap="round" stroke-linejoin="round" d="M12 4.5v15m7.5-7.5h-15" />
            </svg>
            <span>Add Image</span>
          </div>
          <span class="text-[10px] text-slate-400 font-mono mt-0.5">(${imageQueue.length}/${MAX_QUEUE_SIZE})</span>
        `;
        addCard.addEventListener('click', () => {
          fileInput?.click();
        });
        queueStrip.appendChild(addCard);
      }

      updateQueueUI();
    }

    async function selectQueueItem(index: number) {
      if (!imageQueue[index]) return;
      closeInlineCrop();

      // Save current edits back to active item only if dimensions are valid (> 0)
      if (imageQueue[activeQueueIndex]) {
        imageQueue[activeQueueIndex].rotation = rotation;
        imageQueue[activeQueueIndex].flipH = flipH;
        imageQueue[activeQueueIndex].fitBg = fitBg;
        imageQueue[activeQueueIndex].fitCustomColor = fitCustomColor;
        if (targetPxW > 0 && !isNaN(targetPxW)) {
          imageQueue[activeQueueIndex].targetW = targetPxW;
        }
        if (targetPxH > 0 && !isNaN(targetPxH)) {
          imageQueue[activeQueueIndex].targetH = targetPxH;
        }
      }

      activeQueueIndex = index;
      const item = imageQueue[index];

      // Asynchronous safety: Ensure item.img is decoded and natural dimensions exist
      if (item.img.naturalWidth === 0 || item.img.naturalHeight === 0) {
        try {
          if ('decode' in item.img) {
            await item.img.decode();
          }
        } catch {
          // ignore error
        }
      }

      // Safe width / height recovery
      const realW = Math.max(1, item.img.naturalWidth || item.width || 1);
      const realH = Math.max(1, item.img.naturalHeight || item.height || 1);
      item.width = realW;
      item.height = realH;

      originalImage = item.img;
      originalFile = item.file;
      originalWidth = realW;
      originalHeight = realH;
      originalSizeBytes = item.size;
      originalMimeType = item.mimeType;
      rotation = item.rotation;
      flipH = item.flipH;
      fitBg = item.fitBg || 'transparent';
      fitCustomColor = item.fitCustomColor || '#3b82f6';
      updateFitBgUI();

      const isSideways = (rotation === 90 || rotation === 270);
      const effW = isSideways ? realH : realW;
      const effH = isSideways ? realW : realH;

      // Fallback check: Never let targetPxW/targetPxH remain 0 or NaN
      if (!item.targetW || isNaN(item.targetW) || item.targetW <= 0) {
        item.targetW = effW;
      }
      if (!item.targetH || isNaN(item.targetH) || item.targetH <= 0) {
        item.targetH = effH;
      }

      targetPxW = item.targetW;
      targetPxH = item.targetH;

      if (sourceFilename) sourceFilename.textContent = item.name;
      if (sourceSpecs) {
        sourceSpecs.textContent = `Original: ${originalWidth} × ${originalHeight} px • ${formatBytes(item.size)}`;
      }

      syncInputsFromPx();
      renderQueueStrip();
      await renderCanvas();
    }

    async function removeQueueItem(index: number) {
      closeInlineCrop();
      imageQueue.splice(index, 1);

      if (imageQueue.length === 0) {
        resetToDropzone();
        return;
      }

      if (activeQueueIndex >= imageQueue.length) {
        activeQueueIndex = imageQueue.length - 1;
      } else if (index < activeQueueIndex) {
        activeQueueIndex = Math.max(0, activeQueueIndex - 1);
      }

      await selectQueueItem(activeQueueIndex);
    }

    function resetToDropzone() {
      closeInlineCrop();
      imageQueue.length = 0;
      activeQueueIndex = 0;
      originalImage = null;
      originalFile = null;
      fileInput.value = '';
      lastBlob = null;
      setFitBg('transparent');
      if (socialPresetSelect) socialPresetSelect.value = '';
      editorView.classList.add('hidden');
      dropzoneView.classList.remove('hidden');
    }

    function loadImageSafely(src: string): Promise<HTMLImageElement> {
      return new Promise((resolve, reject) => {
        const img = new Image();
        img.crossOrigin = 'anonymous';

        const finalize = async () => {
          try {
            if ('decode' in img) {
              await img.decode();
            }
          } catch (decodeErr) {
            console.warn('img.decode() warning, proceeding with loaded image:', decodeErr);
          }

          if (img.naturalWidth > 0 && img.naturalHeight > 0) {
            resolve(img);
          } else {
            let attempts = 0;
            const interval = setInterval(() => {
              attempts++;
              if (img.naturalWidth > 0 && img.naturalHeight > 0) {
                clearInterval(interval);
                resolve(img);
              } else if (attempts >= 10) {
                clearInterval(interval);
                if (img.width > 0 && img.height > 0) {
                  resolve(img);
                } else {
                  reject(new Error('Image failed to report natural dimensions'));
                }
              }
            }, 30);
          }
        };

        img.onload = () => {
          finalize();
        };

        img.onerror = (err) => {
          reject(err);
        };

        img.src = src;

        if (img.complete && img.naturalWidth > 0 && img.naturalHeight > 0) {
          finalize();
        }
      });
    }

    async function createQueueItem(file: File): Promise<QueueItem> {
      const dataUrl = await new Promise<string>((resolve, reject) => {
        const reader = new FileReader();
        reader.onload = (e) => {
          if (typeof e.target?.result === 'string') {
            resolve(e.target.result);
          } else {
            reject(new Error('Failed reading file to data URL'));
          }
        };
        reader.onerror = reject;
        reader.readAsDataURL(file);
      });

      const img = await loadImageSafely(dataUrl);
      const w = Math.max(1, img.naturalWidth || img.width || 1);
      const h = Math.max(1, img.naturalHeight || img.height || 1);

      // Generate thumbnail
      const thumbCanvas = document.createElement('canvas');
      const maxDim = 88;
      const scale = Math.min(maxDim / w, maxDim / h, 1);
      thumbCanvas.width = Math.max(1, Math.round(w * scale));
      thumbCanvas.height = Math.max(1, Math.round(h * scale));
      const tctx = thumbCanvas.getContext('2d');
      if (tctx) {
        tctx.drawImage(img, 0, 0, thumbCanvas.width, thumbCanvas.height);
      }
      const thumbDataUrl = thumbCanvas.toDataURL('image/jpeg', 0.7);

      // Initial target dimensions
      const initialW = parseFloat(root.dataset.initialWidth || '');
      const initialH = parseFloat(root.dataset.initialHeight || '');
      let targetW = w;
      let targetH = h;
      if (!isNaN(initialW) && initialW > 0) {
        targetW = convertToPx(initialW, activeUnit, w);
        if (!isNaN(initialH) && initialH > 0) {
          targetH = convertToPx(initialH, activeUnit, h);
        } else {
          targetH = Math.max(1, Math.round((targetW * h) / w));
        }
      }

      return {
        id: 'img_' + Math.random().toString(36).slice(2, 9),
        file,
        name: file.name,
        size: file.size,
        mimeType: file.type || 'image/jpeg',
        img,
        width: w,
        height: h,
        rotation: 0,
        flipH: false,
        targetW: Math.max(1, targetW),
        targetH: Math.max(1, targetH),
        thumbDataUrl,
        fitBg: 'transparent',
        fitCustomColor: '#3b82f6'
      };
    }

    async function loadFiles(files: FileList | File[]) {
      const fileList = Array.from(files).filter(f => f.type.startsWith('image/') || f.name.match(/\.(heic|heif|bmp)$/i));
      if (fileList.length === 0) return;

      const remainingCapacity = MAX_QUEUE_SIZE - imageQueue.length;
      if (remainingCapacity <= 0) {
        alert(`Maximum limit of ${MAX_QUEUE_SIZE} images reached.`);
        return;
      }

      const filesToProcess = fileList.slice(0, remainingCapacity);
      if (fileList.length > remainingCapacity) {
        alert(`Adding first ${remainingCapacity} images. (Limit: ${MAX_QUEUE_SIZE} images total)`);
      }

      if (canvasLoading) {
        if (canvasLoadingText) canvasLoadingText.textContent = 'Loading image queue...';
        canvasLoading.classList.remove('hidden');
      }

      const isFirstLoad = imageQueue.length === 0;
      const startIndex = imageQueue.length;
      for (const file of filesToProcess) {
        try {
          const item = await createQueueItem(file);
          imageQueue.push(item);
        } catch (e) {
          console.error('Failed decoding file', file.name, e);
        }
      }

      if (canvasLoading) {
        canvasLoading.classList.add('hidden');
        if (canvasLoadingText) canvasLoadingText.textContent = 'Processing Canvas...';
      }

      if (imageQueue.length > 0) {
        dropzoneView.classList.add('hidden');
        editorView.classList.remove('hidden');
        if (isFirstLoad && imageQueue[0]) {
          if (imageQueue[0].mimeType === 'image/png') {
            setFormat('png');
          } else if (imageQueue[0].mimeType === 'image/webp') {
            setFormat('webp');
          }
        }
        await selectQueueItem(startIndex < imageQueue.length ? startIndex : 0);
      }
    }

    async function downloadResizedImage() {
      if (renderDebounceTimer !== null) {
        window.clearTimeout(renderDebounceTimer);
        renderDebounceTimer = null;
      }
      await renderCanvas();
      if (!lastBlob) {
        await computeExportBlob();
      }
      if (!lastBlob) return;

      const ext = getExtensionForFormat(exportFormat, lastBlob.type);
      const origName = originalFile ? originalFile.name.replace(/\.[^/.]+$/, '') : 'image';
      const safeW = targetPxW > 0 ? targetPxW : getEffectiveSourceWidth();
      const safeH = targetPxH > 0 ? targetPxH : getEffectiveSourceHeight();
      const filename = `${origName}-${safeW}x${safeH}.${ext}`;

      const url = URL.createObjectURL(lastBlob);
      const a = document.createElement('a');
      a.href = url;
      a.download = filename;
      document.body.appendChild(a);
      a.click();
      document.body.removeChild(a);
      URL.revokeObjectURL(url);
    }

    // Render single item for batch ZIP export
    async function renderItemToBlob(item: QueueItem): Promise<Blob | null> {
      if (item.img.naturalWidth === 0 || item.img.naturalHeight === 0) {
        try {
          if ('decode' in item.img) {
            await item.img.decode();
          }
        } catch {
          // ignore
        }
      }
      const realW = Math.max(1, item.img.naturalWidth || item.width || 1);
      const realH = Math.max(1, item.img.naturalHeight || item.height || 1);
      item.width = realW;
      item.height = realH;

      const effW = (item.rotation === 90 || item.rotation === 270) ? realH : realW;
      const effH = (item.rotation === 90 || item.rotation === 270) ? realW : realH;

      const targetW = Math.max(1, Math.round(item.targetW && item.targetW > 0 ? item.targetW : effW));
      const targetH = Math.max(1, Math.round(item.targetH && item.targetH > 0 ? item.targetH : effH));

      const offCanvas = document.createElement('canvas');
      offCanvas.width = targetW;
      offCanvas.height = targetH;
      const ctx = offCanvas.getContext('2d');
      if (!ctx) return null;

      const buffer = document.createElement('canvas');
      buffer.width = effW;
      buffer.height = effH;
      const bCtx = buffer.getContext('2d');
      if (!bCtx) return null;

      bCtx.save();
      bCtx.translate(effW / 2, effH / 2);
      bCtx.rotate((item.rotation * Math.PI) / 180);
      if (item.flipH) bCtx.scale(-1, 1);
      bCtx.drawImage(item.img, -realW / 2, -realH / 2);
      bCtx.restore();

      ctx.clearRect(0, 0, targetW, targetH);

      const effectiveFitBg = item.fitBg || fitBg || 'transparent';
      const effectiveCustomColor = item.fitCustomColor || fitCustomColor || '#3b82f6';

      if (resizeMode === 'fit') {
        const scale = Math.min(targetW / effW, targetH / effH);
        const drawW = effW * scale;
        const drawH = effH * scale;
        const dx = (targetW - drawW) / 2;
        const dy = (targetH - drawH) / 2;

        if (effectiveFitBg === 'blur') {
          ctx.save();
          const bgScale = Math.max(targetW / effW, targetH / effH) * 1.12;
          const bgW = effW * bgScale;
          const bgH = effH * bgScale;
          const bgX = (targetW - bgW) / 2;
          const bgY = (targetH - bgH) / 2;
          ctx.filter = 'blur(20px)';
          ctx.drawImage(buffer, bgX, bgY, bgW, bgH);
          ctx.restore();
        } else if (effectiveFitBg === 'white') {
          ctx.fillStyle = '#ffffff';
          ctx.fillRect(0, 0, targetW, targetH);
        } else if (effectiveFitBg === 'black') {
          ctx.fillStyle = '#000000';
          ctx.fillRect(0, 0, targetW, targetH);
        } else if (effectiveFitBg === 'custom') {
          ctx.fillStyle = effectiveCustomColor;
          ctx.fillRect(0, 0, targetW, targetH);
        } else {
          // Transparent (Clear): Only fill with white if target format cannot physically support transparency (JPG or PDF)
          const itemMime = exportFormat === 'auto' ? (item.mimeType || 'image/jpeg') : getTargetMimeType();
          const itemSupportsAlpha = exportFormat === 'png' || exportFormat === 'webp' || exportFormat === 'avif' || exportFormat === 'ico' || (exportFormat === 'auto' && (itemMime === 'image/png' || itemMime === 'image/webp' || itemMime === 'image/avif'));
          if (!itemSupportsAlpha) {
            ctx.fillStyle = '#ffffff';
            ctx.fillRect(0, 0, targetW, targetH);
          }
        }
        ctx.imageSmoothingEnabled = true;
        ctx.imageSmoothingQuality = 'high';
        ctx.drawImage(buffer, dx, dy, drawW, drawH);
      } else if (resizeMode === 'fill') {
        const scale = Math.max(targetW / effW, targetH / effH);
        const drawW = effW * scale;
        const drawH = effH * scale;
        const dx = (targetW - drawW) / 2;
        const dy = (targetH - drawH) / 2;
        ctx.imageSmoothingEnabled = true;
        ctx.imageSmoothingQuality = 'high';
        ctx.drawImage(buffer, dx, dy, drawW, drawH);
      } else {
        ctx.imageSmoothingEnabled = true;
        ctx.imageSmoothingQuality = 'high';
        ctx.drawImage(buffer, 0, 0, targetW, targetH);
      }

      // Convert to blob
      let mime = getTargetMimeType();
      if (exportFormat === 'auto') {
        mime = item.mimeType || 'image/jpeg';
        if (effectiveFitBg === 'transparent' && resizeMode === 'fit' && (item.mimeType === 'image/jpeg' || !item.mimeType)) {
          mime = 'image/png';
        }
      }

      if (isTargetSizeActive) {
        const targetBytes = (targetSizeUnit === 'MB' ? targetSizeValue * 1024 * 1024 : targetSizeValue * 1024);
        if (exportFormat === 'pdf') {
          const jpegTarget = Math.max(1024, targetBytes - 700);
          const jBlob = await binarySearchQuality('image/jpeg', jpegTarget, offCanvas);
          const jBytes = new Uint8Array(await jBlob.arrayBuffer());
          return createPdfBlob(jBytes, targetW, targetH, dpi);
        } else if (exportFormat === 'ico') {
          return createIcoBlob(offCanvas);
        }
        return binarySearchQuality(mime, targetBytes, offCanvas);
      }

      if (exportFormat === 'pdf') {
        const jBlob = await new Promise<Blob | null>((res) => offCanvas.toBlob(res, 'image/jpeg', quality));
        if (jBlob) {
          const jBytes = new Uint8Array(await jBlob.arrayBuffer());
          return createPdfBlob(jBytes, targetW, targetH, dpi);
        }
      } else if (exportFormat === 'ico') {
        return createIcoBlob(offCanvas);
      }

      return new Promise<Blob | null>((resolve) => {
        offCanvas.toBlob(resolve, mime, quality);
      });
    }

    // Download All ZIP
    async function downloadAllZip() {
      if (imageQueue.length === 0) return;

      if (imageQueue[activeQueueIndex]) {
        imageQueue[activeQueueIndex].rotation = rotation;
        imageQueue[activeQueueIndex].flipH = flipH;
        if (targetPxW > 0 && !isNaN(targetPxW)) {
          imageQueue[activeQueueIndex].targetW = targetPxW;
        }
        if (targetPxH > 0 && !isNaN(targetPxH)) {
          imageQueue[activeQueueIndex].targetH = targetPxH;
        }
      }

      if (batchDownloadBtn) batchDownloadBtn.disabled = true;
      const originalLabel = batchDownloadLabel ? batchDownloadLabel.textContent : '';

      try {
        const zip = new JSZip();

        for (let i = 0; i < imageQueue.length; i++) {
          const item = imageQueue[i];
          if (batchDownloadLabel) {
            batchDownloadLabel.textContent = `Exporting ${i + 1}/${imageQueue.length}...`;
          }

          const blob = await renderItemToBlob(item);
          if (blob) {
            const ext = getExtensionForFormat(exportFormat, blob.type);
            const baseName = item.name.replace(/\.[^/.]+$/, '');
            const filename = `${baseName}-${item.targetW || item.width}x${item.targetH || item.height}.${ext}`;
            zip.file(filename, blob);
          }
        }

        if (batchDownloadLabel) {
          batchDownloadLabel.textContent = 'Generating ZIP bundle...';
        }

        const zipBlob = await zip.generateAsync({ type: 'blob' });
        const url = URL.createObjectURL(zipBlob);
        const a = document.createElement('a');
        a.href = url;
        a.download = `resized-images-bundle-${Date.now()}.zip`;
        document.body.appendChild(a);
        a.click();
        document.body.removeChild(a);
        URL.revokeObjectURL(url);
      } catch (err) {
        console.error('Batch ZIP failed', err);
        alert('Failed to generate ZIP. Please try downloading images individually.');
      } finally {
        if (batchDownloadBtn) batchDownloadBtn.disabled = false;
        if (batchDownloadLabel && originalLabel) {
          batchDownloadLabel.textContent = originalLabel;
        }
      }
    }

    // ==========================================
    // INLINE TRANSFORM & CROP CONTROLLERS
    // ==========================================
    function getCanvasContainerBounds() {
      if (!previewCanvas || !previewCanvasContainer) return null;
      const cRect = previewCanvas.getBoundingClientRect();
      const contRect = previewCanvasContainer.getBoundingClientRect();
      const minX = cRect.left - contRect.left;
      const minY = cRect.top - contRect.top;
      const w = cRect.width;
      const h = cRect.height;
      return {
        minX,
        minY,
        maxX: minX + w,
        maxY: minY + h,
        w,
        h,
        scaleX: previewCanvas.width / (w || 1),
        scaleY: previewCanvas.height / (h || 1),
      };
    }

    function updateInlineCropUI() {
      if (!inlineCropBox || !inlineCropOverlay) return;
      const bounds = getCanvasContainerBounds();
      if (!bounds || bounds.w <= 0 || bounds.h <= 0) return;

      const minSize = 24;
      inlineCropRect.w = Math.max(minSize, Math.min(inlineCropRect.w, bounds.w));
      inlineCropRect.h = Math.max(minSize, Math.min(inlineCropRect.h, bounds.h));
      inlineCropRect.x = Math.max(bounds.minX, Math.min(inlineCropRect.x, bounds.maxX - inlineCropRect.w));
      inlineCropRect.y = Math.max(bounds.minY, Math.min(inlineCropRect.y, bounds.maxY - inlineCropRect.h));

      inlineCropBox.style.left = `${inlineCropRect.x}px`;
      inlineCropBox.style.top = `${inlineCropRect.y}px`;
      inlineCropBox.style.width = `${inlineCropRect.w}px`;
      inlineCropBox.style.height = `${inlineCropRect.h}px`;

      if (inlineCropDimTag) {
        const pxW = Math.max(1, Math.round(inlineCropRect.w * bounds.scaleX));
        const pxH = Math.max(1, Math.round(inlineCropRect.h * bounds.scaleY));
        inlineCropDimTag.textContent = `${pxW} × ${pxH} px`;
      }
    }

    function startInlineCrop() {
      if (!originalImage || !previewCanvas || !inlineCropOverlay) return;
      const bounds = getCanvasContainerBounds();
      if (!bounds || bounds.w <= 0 || bounds.h <= 0) return;

      isCropModeActive = true;
      inlineCropOverlay.classList.remove('hidden');

      if (cropBtn) {
        cropBtn.classList.add('bg-emerald-500/15', 'text-emerald-600', 'dark:text-emerald-400', 'ring-1', 'ring-emerald-500/30');
      }

      // Initial crop box centered at 80% of canvas rendered dimensions
      const initW = Math.max(40, Math.round(bounds.w * 0.8));
      const initH = Math.max(40, Math.round(bounds.h * 0.8));
      const initX = Math.round(bounds.minX + (bounds.w - initW) / 2);
      const initY = Math.round(bounds.minY + (bounds.h - initH) / 2);

      inlineCropRect = { x: initX, y: initY, w: initW, h: initH };
      updateInlineCropUI();
    }

    function closeInlineCrop() {
      isCropModeActive = false;
      inlineCropDragState = null;
      if (inlineCropOverlay) {
        inlineCropOverlay.classList.add('hidden');
      }
      if (cropBtn) {
        cropBtn.classList.remove('bg-emerald-500/15', 'text-emerald-600', 'dark:text-emerald-400', 'ring-1', 'ring-emerald-500/30');
      }
    }

    async function applyInlineCrop() {
      if (!isCropModeActive || !originalImage || !previewCanvas) {
        closeInlineCrop();
        return;
      }

      const bounds = getCanvasContainerBounds();
      if (!bounds || bounds.w <= 0 || bounds.h <= 0) {
        closeInlineCrop();
        return;
      }

      // Calculate pixel coordinates on current previewCanvas
      const cropPxX = Math.max(0, Math.round((inlineCropRect.x - bounds.minX) * bounds.scaleX));
      const cropPxY = Math.max(0, Math.round((inlineCropRect.y - bounds.minY) * bounds.scaleY));
      const cropPxW = Math.max(1, Math.min(previewCanvas.width - cropPxX, Math.round(inlineCropRect.w * bounds.scaleX)));
      const cropPxH = Math.max(1, Math.min(previewCanvas.height - cropPxY, Math.round(inlineCropRect.h * bounds.scaleY)));

      if (cropPxW <= 1 || cropPxH <= 1) {
        closeInlineCrop();
        return;
      }

      const cropCanvas = document.createElement('canvas');
      cropCanvas.width = cropPxW;
      cropCanvas.height = cropPxH;
      const cCtx = cropCanvas.getContext('2d');
      if (!cCtx) {
        closeInlineCrop();
        return;
      }

      cCtx.drawImage(previewCanvas, cropPxX, cropPxY, cropPxW, cropPxH, 0, 0, cropPxW, cropPxH);
      const croppedDataUrl = cropCanvas.toDataURL(originalMimeType || 'image/png');

      try {
        const newImg = await loadImageSafely(croppedDataUrl);
        originalImage = newImg;
        originalWidth = cropPxW;
        originalHeight = cropPxH;
        rotation = 0;
        flipH = false;
        targetPxW = cropPxW;
        targetPxH = cropPxH;

        if (imageQueue[activeQueueIndex]) {
          imageQueue[activeQueueIndex].img = newImg;
          imageQueue[activeQueueIndex].width = cropPxW;
          imageQueue[activeQueueIndex].height = cropPxH;
          imageQueue[activeQueueIndex].rotation = 0;
          imageQueue[activeQueueIndex].flipH = false;
          imageQueue[activeQueueIndex].targetW = cropPxW;
          imageQueue[activeQueueIndex].targetH = cropPxH;
          imageQueue[activeQueueIndex].thumbDataUrl = croppedDataUrl;
        }

        if (sourceSpecs) {
          sourceSpecs.textContent = `Original: ${cropPxW} × ${cropPxH} px • ${formatBytes(originalSizeBytes)}`;
        }

        syncInputsFromPx();
        renderQueueStrip();
        await renderCanvas();
      } catch (err) {
        console.error('Failed to apply crop', err);
      } finally {
        closeInlineCrop();
      }
    }

    if (inlineCropOverlay && inlineCropBox) {
      inlineCropBox.addEventListener('pointerdown', (e: PointerEvent) => {
        e.preventDefault();
        e.stopPropagation();

        const target = e.target as HTMLElement;
        const handle = target.dataset.handle as any;
        const action = handle || 'move';

        inlineCropDragState = {
          action,
          startX: e.clientX,
          startY: e.clientY,
          rectStart: { ...inlineCropRect }
        };

        inlineCropOverlay.setPointerCapture(e.pointerId);
      });

      inlineCropOverlay.addEventListener('pointermove', (e: PointerEvent) => {
        if (!inlineCropDragState) return;
        const bounds = getCanvasContainerBounds();
        if (!bounds) return;

        const dx = e.clientX - inlineCropDragState.startX;
        const dy = e.clientY - inlineCropDragState.startY;
        const s = inlineCropDragState.rectStart;
        const minSize = 24;

        if (inlineCropDragState.action === 'move') {
          inlineCropRect.x = Math.max(bounds.minX, Math.min(s.x + dx, bounds.maxX - s.w));
          inlineCropRect.y = Math.max(bounds.minY, Math.min(s.y + dy, bounds.maxY - s.h));
        } else {
          let newX = s.x;
          let newY = s.y;
          let newW = s.w;
          let newH = s.h;

          // Horizontal adjustments
          if (inlineCropDragState.action.includes('e')) {
            newW = Math.max(minSize, Math.min(s.w + dx, bounds.maxX - s.x));
          } else if (inlineCropDragState.action.includes('w')) {
            const clampedX = Math.max(bounds.minX, Math.min(s.x + dx, s.x + s.w - minSize));
            newW = s.w + (s.x - clampedX);
            newX = clampedX;
          }

          // Vertical adjustments
          if (inlineCropDragState.action.includes('s')) {
            newH = Math.max(minSize, Math.min(s.h + dy, bounds.maxY - s.y));
          } else if (inlineCropDragState.action.includes('n')) {
            const clampedY = Math.max(bounds.minY, Math.min(s.y + dy, s.y + s.h - minSize));
            newH = s.h + (s.y - clampedY);
            newY = clampedY;
          }

          inlineCropRect.x = newX;
          inlineCropRect.y = newY;
          inlineCropRect.w = newW;
          inlineCropRect.h = newH;
        }

        updateInlineCropUI();
      });

      const endCropDrag = (e: PointerEvent) => {
        if (inlineCropDragState) {
          try {
            inlineCropOverlay.releasePointerCapture(e.pointerId);
          } catch {}
          inlineCropDragState = null;
        }
      };

      inlineCropOverlay.addEventListener('pointerup', endCropDrag);
      inlineCropOverlay.addEventListener('pointercancel', endCropDrag);
    }

    function rotateClockwise() {
      if (!originalImage) return;
      if (isCropModeActive) closeInlineCrop();
      rotation = (rotation + 90) % 360;

      // Swap target dimensions on 90°/270° orientation change
      const temp = targetPxW;
      targetPxW = targetPxH;
      targetPxH = temp;

      if (imageQueue[activeQueueIndex]) {
        imageQueue[activeQueueIndex].rotation = rotation;
        imageQueue[activeQueueIndex].targetW = targetPxW;
        imageQueue[activeQueueIndex].targetH = targetPxH;
      }

      syncInputsFromPx();
      renderQueueStrip();
      triggerRender();
    }

    function flipHorizontal() {
      if (!originalImage) return;
      if (isCropModeActive) closeInlineCrop();
      flipH = !flipH;

      if (imageQueue[activeQueueIndex]) {
        imageQueue[activeQueueIndex].flipH = flipH;
      }

      renderQueueStrip();
      triggerRender();
    }

    rotateBtn?.addEventListener('click', rotateClockwise);
    cropBtn?.addEventListener('click', () => {
      if (isCropModeActive) {
        closeInlineCrop();
      } else {
        startInlineCrop();
      }
    });
    flipHBtn?.addEventListener('click', flipHorizontal);
    inlineCropApplyBtn?.addEventListener('click', applyInlineCrop);
    inlineCropCancelBtn?.addEventListener('click', closeInlineCrop);

    window.addEventListener('resize', () => {
      if (isCropModeActive) {
