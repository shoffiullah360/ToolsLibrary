---
// src/components/tools/ResizerEditorial.astro
import ToolIcon from '../ToolIcon.astro';
import rawPagesData from '../../data/resizer-pages.json';

interface ResizerPage {
  slug: string;
  keyword: string;
  metaTitle: string;
  metaDescription: string;
  h1: string;
  badge?: string;
  targetTag?: string;
  category: "filesize" | "dimension" | "social" | "preset";
  introCopy?: string;
  introParagraph?: string;
  toolDescription?: string;
  preset: {
    unit?: "PX" | "CM" | "MM" | "INCH" | "%";
    width?: number;
    height?: number;
    dpi?: number;
    targetMinSize?: number;
    targetSize?: number;
    targetUnit?: "KB" | "MB";
    maxFileSize?: number;
    maxFileUnit?: "KB" | "MB";
    lockRatio?: boolean;
  };
  faqs: Array<{ q: string; a: string }>;
}

interface Props {
  presetTitle: string;
  currentSlug: string;
  presets?: ResizerPage[];
}

const { presetTitle, currentSlug, presets } = Astro.props;
const allPresets = (presets || (rawPagesData as unknown as ResizerPage[])).slice(0, 52);

function formatBadge(p: ResizerPage): string {
  if (p.badge) return p.badge;
  if (p.targetTag) return p.targetTag;
  if (p.preset?.width && p.preset?.height) {
    return `${p.preset.width} × ${p.preset.height} ${p.preset.unit || 'px'}`;
  }
  if (p.preset?.targetSize) {
    return `${p.preset.targetSize} ${p.preset.targetUnit || 'KB'}`;
  }
  return 'Verified Preset';
}

const steps = [
  {
    number: "01",
    title: "Select & Upload",
    desc: "Drag & drop up to 15 images into the workspace, select files from your device, or paste directly with Ctrl+V. Supports JPG, PNG, WebP, and AVIF."
  },
  {
    number: "02",
    title: "Calibrate Dimensions & Target",
    desc: "Preset auto-locks exact width, height, or KB boundary. Tweak dimensions, choose crop or fit mode, and set print DPI with instant preview."
  },
  {
    number: "03",
    title: "Instant Local Download",
    desc: "Render at full visual clarity and download in 1 click. Zero watermarks, zero quality compromise, and complete client-side data privacy."
  }
];

const featureHighlights = [
  {
    icon: "zap",
    color: "blue",
    title: "Lightning-Fast Resizing",
    desc: "Client-side multithreaded canvas scaling processes your images in milliseconds directly using your device CPU and WebAssembly, eliminating upload wait times."
  },
  {
    icon: "crop",
    color: "purple",
    title: "Precision Aspect Ratio Lock",
    desc: "Intelligent aspect ratio constraint locks proportional scaling or applies clean center-crops, preventing squishing or unnatural distortion."
  },
  {
    icon: "shield-check",
    color: "emerald",
    title: "100% In-Browser Privacy",
    desc: "Zero files uploaded to remote servers. All image encoding and resizing stays strictly confined to your private browser memory heap."
  },
  {
    icon: "maximize-2",
    color: "indigo",
    title: "High-DPI Retina Clarity",
    desc: "Advanced Lanczos and bicubic resampling algorithms preserve crisp typographic contours, sharp facial details, and authentic color fidelity."
  },
  {
    icon: "ruler",
    color: "amber",
    title: "Exact Metric & Pixel Calibration",
    desc: "Supports exact pixels (px), centimeters (cm), millimeters (mm), and target KB bounds at 300 DPI for foolproof passport and exam portal validation."
  },
  {
    icon: "file-text",
    color: "rose",
    title: "Universal Format Support",
    desc: "Effortlessly resize and convert across JPG, PNG, WebP, AVIF, PDF, and ICO formats while preserving 8-bit alpha transparency and rich color spaces."
  }
];

const comparisonRows = [
  {
    feature: "Target Accuracy",
    fastToolVerse: "Exact pixel dimensions & strict KB ceiling",
    cloudResizers: "Loose approximations & file bloat",
    desktopSoftware: "Precise but requires complex manual math"
  },
  {
    feature: "Privacy & Document Security",
    fastToolVerse: "100% Local sandbox (Zero uploads)",
    cloudResizers: "Uploaded to remote cloud databases",
    desktopSoftware: "Local, but risks file exposure via telemetry"
  },
  {
    feature: "Aspect Ratio Retention",
    fastToolVerse: "Intelligent aspect lock & smart auto-crop",
    cloudResizers: "Distorted scaling or forced blind cropping",
    desktopSoftware: "Manual canvas recalculation required"
  },
  {
    feature: "Speed & Accessibility",
    fastToolVerse: "Instant in-browser rendering with zero lag",
    cloudResizers: "Queue wait times & network upload lag",
    desktopSoftware: "Heavy gigabyte install & slow software launch"
  },
  {
    feature: "Batch Processing Cost",
    fastToolVerse: "Unlimited free batching with zero paywalls",
    cloudResizers: "Paywalled behind monthly subscriptions",
    desktopSoftware: "Expensive licenses ($50 to $240/year)"
  }
];
---

<!-- SECTION 1: 3-STEP WORKFLOW CARDS -->
<section class="border-t border-slate-200/90 dark:border-slate-800 bg-slate-100/60 dark:bg-slate-900/30 py-14 sm:py-16">
  <div class="max-w-5xl mx-auto px-4 sm:px-6 lg:px-8">
    <div class="text-center max-w-2xl mx-auto mb-10">
      <h2 class="text-2xl sm:text-3xl font-bold tracking-tight text-slate-900 dark:text-white">
        How to Use {presetTitle} in 3 Simple Steps
      </h2>
      <p class="mt-2 text-sm sm:text-base text-slate-600 dark:text-slate-400">
        Pre-configured, private, and effortless. Run in-browser resizing to exact dimensions and target boundaries in seconds.
      </p>
    </div>

    <div class="grid grid-cols-1 md:grid-cols-3 gap-6">
      {steps.map((step) => (
        <div class="p-6 rounded-2xl bg-white border border-slate-300 shadow-sm hover:shadow-md hover:border-blue-600 transition-all duration-150 dark:bg-slate-900/60 dark:border-slate-800 relative">
          <div class="w-10 h-10 rounded-xl bg-blue-50 dark:bg-blue-950/40 text-blue-600 dark:text-blue-400 flex items-center justify-center font-bold font-mono text-sm mb-4 border border-blue-100 dark:border-blue-900/50">
            {step.number}
          </div>
          <h3 class="text-base font-semibold text-slate-900 dark:text-white mb-2">
            {step.title}
          </h3>
          <p class="text-sm text-slate-600 dark:text-slate-400 leading-relaxed">
            {step.desc}
          </p>
        </div>
      ))}
    </div>
  </div>
</section>

<!-- SECTION 2: 6 FEATURE HIGHLIGHTS GRID -->
<section class="border-t border-slate-200/90 dark:border-slate-800 bg-slate-50 dark:bg-slate-950 py-14 sm:py-16">
  <div class="max-w-6xl mx-auto px-4 sm:px-6 lg:px-8">
    <div class="text-center mb-10">
      <h2 class="text-2xl sm:text-3xl font-bold tracking-tight text-slate-900 dark:text-white">
        Why Use Our Image Resizer for {presetTitle}?
      </h2>
      <p class="text-sm sm:text-base text-slate-600 dark:text-slate-400 mt-2 max-w-xl mx-auto">
        Precision client-side canvas algorithms guarantee exact dimensions, strict aspect ratios, and zero compression blur.
      </p>
    </div>

    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6">
      {featureHighlights.map((f) => (
        <div class="bg-white dark:bg-slate-900/60 border border-slate-200 dark:border-slate-800 rounded-xl p-6 shadow-sm hover:border-slate-300 dark:hover:border-slate-700 transition-colors">
          <div class="w-10 h-10 rounded-lg bg-slate-100 dark:bg-slate-800/80 border border-slate-200 dark:border-slate-700/60 flex items-center justify-center mb-4 text-slate-700 dark:text-slate-300">
            <ToolIcon name={f.icon} class="w-5 h-5 text-blue-500 dark:text-blue-400" />
          </div>
          <h3 class="text-base sm:text-lg font-semibold text-slate-900 dark:text-white mb-2">{f.title}</h3>
          <p class="text-slate-600 dark:text-slate-400 text-sm leading-relaxed">{f.desc}</p>
        </div>
      ))}
    </div>
  </div>
</section>

<!-- SECTION 3: COMPREHENSIVE POPULAR PRESETS GRID -->
<section class="border-t border-slate-200/90 dark:border-slate-800 bg-white dark:bg-slate-950/40 py-14 sm:py-18">
  <div class="max-w-6xl mx-auto px-4 sm:px-6 lg:px-8">
    <div class="text-center max-w-2xl mx-auto mb-10">
      <h2 class="text-2xl sm:text-3xl font-bold tracking-tight text-slate-900 dark:text-white">
        Popular Image Resizer Presets
      </h2>
      <p class="mt-2 text-sm sm:text-base text-slate-600 dark:text-slate-400">
        Direct resizing configurations pre-configured for dimensions, official requirements, and social ratios.
      </p>
    </div>

    <div class="grid grid-cols-1 sm:grid-cols-2 md:grid-cols-3 lg:grid-cols-4 gap-4">
      {allPresets.map((preset) => {
        const isCurrent = preset.slug === currentSlug;
        const badge = formatBadge(preset);
        return (
          <a
            href={`/${preset.slug}/`}
            class={`group p-3 sm:p-4 rounded-xl border transition-all flex flex-col justify-between ${
              isCurrent
                ? 'border-blue-600 bg-blue-50/40 dark:bg-blue-950/30 ring-2 ring-blue-500/20 shadow-sm'
                : 'border-slate-200 dark:border-slate-800 bg-white dark:bg-slate-900/60 hover:border-blue-500 dark:hover:border-blue-500 hover:shadow-sm'
            }`}
          >
            <div>
              <div class="flex items-center justify-between gap-1.5 mb-2">
                <span class="inline-block text-[10px] font-semibold px-2 py-0.5 rounded-full bg-blue-50 dark:bg-blue-950/60 text-blue-600 dark:text-blue-400 border border-blue-100 dark:border-blue-900/50">
                  {preset.category.toUpperCase()}
                </span>
                <span class="inline-flex items-center px-1.5 py-0.5 rounded font-mono text-[11px] font-medium bg-slate-100 dark:bg-slate-800 text-slate-700 dark:text-slate-300 border border-slate-200 dark:border-slate-700">
                  {badge}
                </span>
              </div>
              <h3 class="text-xs sm:text-sm font-semibold text-slate-900 dark:text-slate-100 group-hover:text-blue-600 dark:group-hover:text-blue-400 transition-colors leading-snug">
                {preset.h1}
              </h3>
              <p class="mt-1.5 text-[11px] sm:text-xs text-slate-500 dark:text-slate-400 line-clamp-2 leading-relaxed">
                {preset.introParagraph || preset.metaDescription}
              </p>
            </div>
            <div class="mt-3 pt-2.5 border-t border-slate-100 dark:border-slate-800/80 flex items-center justify-between text-[11px] sm:text-xs">
              {isCurrent ? (
                <span class="font-semibold text-blue-600 dark:text-blue-400 flex items-center gap-1.5">
                  <span class="w-1.5 h-1.5 rounded-full bg-blue-500 animate-pulse"></span>
                  Active Preset
                </span>
              ) : (
                <span class="font-semibold text-blue-600 dark:text-blue-400 inline-flex items-center gap-1 group-hover:translate-x-0.5 transition-transform">
                  Resize now &rarr;
                </span>
              )}
            </div>
          </a>
        );
      })}
    </div>
  </div>
</section>

<!-- SECTION 4: COMPARISON SPECIFICATION MATRIX TABLE -->
<section class="border-t border-slate-200/90 dark:border-slate-800 bg-slate-50 dark:bg-slate-950 py-14 sm:py-16">
  <div class="max-w-5xl mx-auto px-4 sm:px-6 lg:px-8">
    <div class="text-center mb-10 max-w-2xl mx-auto">
      <h2 class="text-2xl sm:text-3xl font-bold tracking-tight text-slate-900 dark:text-white">
        Why FastToolVerse is Better for {presetTitle}
      </h2>
      <p class="text-sm sm:text-base text-slate-600 dark:text-slate-400 mt-2">
        How our client-side resizing engine compares to cloud converters and cumbersome desktop graphic editors.
      </p>
    </div>

    <div class="overflow-x-auto rounded-2xl border border-slate-300 dark:border-slate-800 bg-white dark:bg-slate-900 shadow-sm">
      <table class="w-full text-left text-xs sm:text-sm">
        <thead class="bg-slate-100/80 dark:bg-slate-800/80 text-slate-700 dark:text-slate-300 font-semibold border-b border-slate-200 dark:border-slate-700">
          <tr>
            <th class="p-3.5 sm:p-4">Feature / Metric</th>
            <th class="p-3.5 sm:p-4 text-blue-600 dark:text-blue-400 font-bold">FastToolVerse Online Resizer</th>
            <th class="p-3.5 sm:p-4 text-slate-500 dark:text-slate-400">Cloud-Based Resizers</th>
            <th class="p-3.5 sm:p-4 text-slate-700 dark:text-slate-300">Desktop Offline Software</th>
          </tr>
        </thead>
        <tbody class="divide-y divide-slate-100 dark:divide-slate-800">
          {comparisonRows.map((row) => (
            <tr class="hover:bg-slate-50/60 dark:hover:bg-slate-800/40 transition-colors">
              <td class="p-3.5 sm:p-4 font-semibold text-slate-900 dark:text-white whitespace-nowrap">
                {row.feature}
              </td>
              <td class="p-3.5 sm:p-4 text-slate-700 dark:text-slate-200 text-xs">
                <div class="flex items-start gap-2">
                  <span class="inline-flex items-center justify-center w-4 h-4 rounded-full bg-emerald-100 dark:bg-emerald-950 text-emerald-600 dark:text-emerald-400 font-bold text-[10px] shrink-0 mt-0.5 border border-emerald-200 dark:border-emerald-800">✓</span>
                  <span class="font-medium">{row.fastToolVerse}</span>
                </div>
              </td>
              <td class="p-3.5 sm:p-4 text-slate-500 dark:text-slate-400 text-xs">
                <div class="flex items-start gap-2">
                  <span class="inline-flex items-center justify-center w-4 h-4 rounded-full bg-rose-100 dark:bg-rose-950 text-rose-600 dark:text-rose-400 font-bold text-[10px] shrink-0 mt-0.5 border border-rose-200 dark:border-rose-800">✕</span>
                  <span>{row.cloudResizers}</span>
                </div>
              </td>
              <td class="p-3.5 sm:p-4 text-slate-600 dark:text-slate-300 text-xs">
                <div class="flex items-start gap-2">
                  <span class="inline-flex items-center justify-center w-4 h-4 rounded-full bg-slate-200 dark:bg-slate-800 text-slate-600 dark:text-slate-400 font-bold text-[10px] shrink-0 mt-0.5 border border-slate-300 dark:border-slate-700">~</span>
                  <span>{row.desktopSoftware}</span>
                </div>
              </td>
            </tr>
          ))}
        </tbody>
      </table>
    </div>
  </div>
</section>

<!-- SECTION 5: 3 CORE ARCHITECTURE PILLARS -->
<section class="border-t border-slate-200/90 dark:border-slate-800 bg-slate-100/50 dark:bg-slate-900/20 py-12 sm:py-14">
  <div class="max-w-5xl mx-auto px-4 sm:px-6 lg:px-8">
    <div class="text-center max-w-2xl mx-auto mb-10">
      <div class="inline-flex items-center gap-1.5 px-3 py-1 rounded-full text-xs font-semibold bg-emerald-50 dark:bg-emerald-950/50 text-emerald-600 dark:text-emerald-400 border border-emerald-200 dark:border-emerald-900/50 mb-3 shadow-2xs">
        <ToolIcon name="shield-check" class="w-3.5 h-3.5" />
        <span>100% Client-Side Engine</span>
      </div>
      <h2 class="text-2xl sm:text-3xl font-bold tracking-tight text-slate-900 dark:text-white">
        Engineered for Privacy, Speed, and Dimension Accuracy
      </h2>
      <p class="text-xs sm:text-sm text-slate-500 dark:text-slate-400 mt-2">
        Hardware-accelerated HTML5 Canvas interpolation, mathematical aspect ratio constraint, and zero cloud data retention.
      </p>
    </div>

    <div class="grid grid-cols-1 md:grid-cols-3 gap-5">
      <div class="p-6 rounded-2xl bg-white dark:bg-slate-900/60 border border-slate-200 dark:border-slate-800 shadow-sm hover:shadow-md hover:border-blue-600 dark:hover:border-blue-500 transition-all duration-150 group">
        <div class="w-10 h-10 rounded-xl bg-emerald-500/10 text-emerald-600 dark:text-emerald-400 flex items-center justify-center mb-4 group-hover:scale-105 transition-transform border border-emerald-100 dark:border-emerald-900/50">
          <ToolIcon name="shield-check" class="w-5 h-5" />
        </div>
        <h3 class="text-base font-bold text-slate-900 dark:text-white mb-2">
          100% In-Browser Privacy
        </h3>
        <p class="text-xs sm:text-sm text-slate-600 dark:text-slate-400 leading-relaxed">
          Images are decoded, scaled, and re-encoded strictly inside your browser's private memory heap using HTML5 Canvas and WebAssembly. Zero bytes ever leave your device or touch an external server.
        </p>
      </div>

      <div class="p-6 rounded-2xl bg-white dark:bg-slate-900/60 border border-slate-200 dark:border-slate-800 shadow-sm hover:shadow-md hover:border-blue-600 dark:hover:border-blue-500 transition-all duration-150 group">
        <div class="w-10 h-10 rounded-xl bg-blue-500/10 text-blue-600 dark:text-blue-400 flex items-center justify-center mb-4 group-hover:scale-105 transition-transform border border-blue-100 dark:border-blue-900/50">
          <ToolIcon name="zap" class="w-5 h-5" />
        </div>
        <h3 class="text-base font-bold text-slate-900 dark:text-white mb-2">
          Instant Canvas Rendering
        </h3>
        <p class="text-xs sm:text-sm text-slate-600 dark:text-slate-400 leading-relaxed">
          Multi-threaded hardware acceleration renders pixel resamplings in milliseconds. Enjoy instantaneous output previews without network latency, upload queues, or bandwidth caps.
        </p>
      </div>

      <div class="p-6 rounded-2xl bg-white dark:bg-slate-900/60 border border-slate-200 dark:border-slate-800 shadow-sm hover:shadow-md hover:border-blue-600 dark:hover:border-blue-500 transition-all duration-150 group">
        <div class="w-10 h-10 rounded-xl bg-purple-500/10 text-purple-600 dark:text-purple-400 flex items-center justify-center mb-4 group-hover:scale-105 transition-transform border border-purple-100 dark:border-purple-900/50">
          <ToolIcon name="crop" class="w-5 h-5" />
        </div>
        <h3 class="text-base font-bold text-slate-900 dark:text-white mb-2">
          Exact Biometric Precision
        </h3>
        <p class="text-xs sm:text-sm text-slate-600 dark:text-slate-400 leading-relaxed">
          Mathematical resampling algorithms lock exact aspect ratios, centimeter-to-pixel conversions, and 300 DPI print metadata for 100% consular and portal acceptance.
        </p>
      </div>
    </div>
  </div>
</section>

<!-- SECTION 6: SECURITY & TRUST GRID (4 CARDS) -->
<section class="border-t border-slate-200/90 dark:border-slate-800 bg-slate-100/50 dark:bg-slate-900/20 py-12 sm:py-14">
  <div class="max-w-5xl mx-auto px-4 sm:px-6 lg:px-8">
    <div class="rounded-2xl border border-slate-200 dark:border-slate-800 bg-white dark:bg-slate-900/60 p-6 sm:p-8 shadow-sm">
      <div class="flex items-center gap-3.5 mb-4">
        <div class="w-10 h-10 rounded-xl bg-emerald-50 dark:bg-emerald-950/50 text-emerald-600 dark:text-emerald-400 flex items-center justify-center border border-emerald-100 dark:border-emerald-900/50 shrink-0">
          <ToolIcon name="shield-check" class="w-5 h-5" />
        </div>
        <div>
          <h2 class="text-xl sm:text-2xl font-bold tracking-tight text-slate-900 dark:text-white">
            Your Data & Local Privacy
          </h2>
          <p class="text-xs sm:text-sm text-slate-500 dark:text-slate-400 mt-0.5">
            Enterprise-grade client sandbox isolation with zero remote data retention.
          </p>
        </div>
      </div>

      <div class="grid grid-cols-1 md:grid-cols-2 gap-3.5 sm:gap-4 mt-6">
        <div class="p-4 rounded-xl bg-slate-50 dark:bg-slate-950/50 border border-slate-100 dark:border-slate-800/80">
          <div class="flex items-start gap-3">
            <span class="inline-flex items-center justify-center w-5 h-5 rounded-full bg-emerald-100 dark:bg-emerald-900/60 text-emerald-700 dark:text-emerald-300 font-bold text-xs shrink-0 mt-0.5">✓</span>
            <div>
              <h3 class="text-xs sm:text-sm font-semibold text-slate-900 dark:text-slate-100 mb-1">
                100% Client-Side In-Memory Processing
              </h3>
              <p class="text-xs sm:text-sm text-slate-600 dark:text-slate-400 leading-relaxed">
                Files are scaled strictly inside local browser memory via HTML5 Canvas and WebAssembly. Nothing is ever uploaded to cloud servers or stored in remote databases.
              </p>
            </div>
          </div>
        </div>

        <div class="p-4 rounded-xl bg-slate-50 dark:bg-slate-950/50 border border-slate-100 dark:border-slate-800/80">
          <div class="flex items-start gap-3">
            <span class="inline-flex items-center justify-center w-5 h-5 rounded-full bg-emerald-100 dark:bg-emerald-900/60 text-emerald-700 dark:text-emerald-300 font-bold text-xs shrink-0 mt-0.5">✓</span>
            <div>
              <h3 class="text-xs sm:text-sm font-semibold text-slate-900 dark:text-slate-100 mb-1">
                Local Memory Zero Leaks
              </h3>
              <p class="text-xs sm:text-sm text-slate-600 dark:text-slate-400 leading-relaxed">
                Allocated memory buffers are immediately purged by browser garbage collection the moment you clear your workspace or close the browser tab.
              </p>
            </div>
          </div>
        </div>

        <div class="p-4 rounded-xl bg-slate-50 dark:bg-slate-950/50 border border-slate-100 dark:border-slate-800/80">
          <div class="flex items-start gap-3">
            <span class="inline-flex items-center justify-center w-5 h-5 rounded-full bg-emerald-100 dark:bg-emerald-900/60 text-emerald-700 dark:text-emerald-300 font-bold text-xs shrink-0 mt-0.5">✓</span>
            <div>
              <h3 class="text-xs sm:text-sm font-semibold text-slate-900 dark:text-slate-100 mb-1">
                Offline Capable Resizing
              </h3>
              <p class="text-xs sm:text-sm text-slate-600 dark:text-slate-400 leading-relaxed">
                Once loaded, the client-side resizing engine functions entirely on your local machine—even without an active internet connection.
              </p>
            </div>
          </div>
        </div>

        <div class="p-4 rounded-xl bg-slate-50 dark:bg-slate-950/50 border border-slate-100 dark:border-slate-800/80">
          <div class="flex items-start gap-3">
            <span class="inline-flex items-center justify-center w-5 h-5 rounded-full bg-emerald-100 dark:bg-emerald-900/60 text-emerald-700 dark:text-emerald-300 font-bold text-xs shrink-0 mt-0.5">✓</span>
            <div>
              <h3 class="text-xs sm:text-sm font-semibold text-slate-900 dark:text-slate-100 mb-1">
                No Tracking or File Fingerprints
              </h3>
              <p class="text-xs sm:text-sm text-slate-600 dark:text-slate-400 leading-relaxed">
                Your photos are never cached, inspected, hashed, or utilized to train AI models. Your identity documents and personal imagery remain 100% private.
              </p>
            </div>
          </div>
        </div>
      </div>
    </div>
  </div>
</section>
