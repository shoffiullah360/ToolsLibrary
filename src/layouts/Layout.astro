---
import '../styles/global.css';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';

interface Props {
  title?: string;
  description?: string;
  canonicalUrl?: string;
  image?: string;
}

const {
  title = "FastToolVerse — Free Client-Side Developer & Image Tools",
  description = "Free, fast, and 100% private in-browser developer & image tools. Resize images, clean text, and format code with zero server uploads and zero latency.",
  canonicalUrl = new URL(Astro.url.pathname, Astro.site ?? "https://fasttoolverse.com").href,
  image = "/og-image.png"
} = Astro.props;

// Schema.org Structured Data
const jsonLd = {
  "@context": "https://schema.org",
  "@graph": [
    {
      "@type": "WebSite",
      "@id": "https://fasttoolverse.com/#website",
      "url": "https://fasttoolverse.com",
      "name": "FastToolVerse Suite",
      "description": description,
      "potentialAction": {
        "@type": "SearchAction",
        "target": "https://fasttoolverse.com/?q={search_term_string}",
        "query-input": "required name=search_term_string"
      }
    },
    {
      "@type": "SoftwareApplication",
      "name": "FastToolVerse Online Utilities",
      "operatingSystem": "All (Web Browser)",
      "applicationCategory": "UtilitiesApplication",
      "offers": {
        "@type": "Offer",
        "price": "0",
        "priceCurrency": "USD"
      },
      "featureList": [
        "Client-side image resizer and compressor",
        "Social media dimension specs (YouTube, Instagram, TikTok, LinkedIn)",
        "JSON formatter, validator and minifier",
        "Base64 and URL encoders/decoders",
        "UUID generator and Unix timestamp converter",
        "Zero server file uploads — 100% private WebAssembly processing"
      ]
    }
  ]
};
---

<!doctype html>
<html lang="en" class="dark scroll-smooth">
  <head>
    <!-- Google tag (gtag.js) -->
    <script async src="https://www.googletagmanager.com/gtag/js?id=G-35HK1V8TGX"></script>
    <script is:inline>
      window.dataLayer = window.dataLayer || [];
      function gtag(){dataLayer.push(arguments);}
      gtag('js', new Date());

      gtag('config', 'G-35HK1V8TGX');
    </script>

    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <link rel="icon" type="image/svg+xml" href="/logo-icon.svg" />
    <meta name="generator" content={Astro.generator} />

    <!-- Primary Meta Tags -->
    <title>{title}</title>
    <meta name="title" content={title} />
    <meta name="description" content={description} />
    <link rel="canonical" href={canonicalUrl} />
    <meta name="robots" content="index, follow, max-snippet:-1, max-image-preview:large, max-video-preview:-1" />

    <!-- Open Graph / Facebook -->
    <meta property="og:type" content="website" />
    <meta property="og:url" content={canonicalUrl} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={image} />
    <meta property="og:site_name" content="FastToolVerse" />

    <!-- Twitter -->
    <meta property="twitter:card" content="summary_large_image" />
    <meta property="twitter:url" content={canonicalUrl} />
    <meta property="twitter:title" content={title} />
    <meta property="twitter:description" content={description} />
    <meta property="twitter:image" content={image} />

    <!-- Google Fonts Preconnect & Inter + JetBrains Mono -->
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700&family=JetBrains+Mono:wght@400;500;600&display=swap"
      rel="stylesheet"
    />

    <!-- JSON-LD Schema -->
    <script type="application/ld+json" set:html={JSON.stringify(jsonLd)} />

    <!-- Anti-Flicker Theme Script (Instant Execution in Head) -->
    <script is:inline>
      (function () {
        const savedTheme = localStorage.getItem('theme');
        if (savedTheme === 'light') {
          document.documentElement.classList.remove('dark');
        } else {
          document.documentElement.classList.add('dark');
          if (!savedTheme) {
            localStorage.setItem('theme', 'dark');
          }
        }
      })();
    </script>
    <!-- Page-Specific Head Extensions -->
    <slot name="head" />
  </head>
  
  <body class="min-h-screen flex flex-col antialiased bg-slate-50 dark:bg-slate-950 text-slate-900 dark:text-slate-100 selection:bg-blue-500 selection:text-white">
    <Header />
    <main class="flex-1 bg-slate-50 dark:bg-slate-950">
      <slot />
    </main>
    <Footer />
  </body>
</html>
