          </p>
        </div>
        <a
          href="/tools/image-resizer"
          class="text-xs font-semibold text-blue-600 dark:text-blue-400 hover:text-blue-700 dark:hover:text-blue-300 transition-colors inline-flex items-center gap-1"
        >
          All Resizer Tools &rarr;
        </a>
      </div>

      <div class="grid grid-cols-2 sm:grid-cols-3 lg:grid-cols-4 gap-3.5">
        {otherCategoryPages.slice(0, 16).map((rel) => {
          const badge = formatBadge(rel);
          return (
            <a
              href={`/${rel.slug}`}
              class="group p-4 rounded-xl border border-slate-200 dark:border-slate-800 bg-white dark:bg-slate-900 hover:border-blue-500/50 hover:bg-blue-50/40 dark:hover:bg-blue-950/20 transition-all flex flex-col justify-between shadow-2xs"
