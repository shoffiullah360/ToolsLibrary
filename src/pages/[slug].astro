---
import Layout from '../layouts/Layout.astro';
import ImageResizer from '../components/tools/ImageResizer.astro';
import ImageCompressor from '../components/tools/ImageCompressor.astro';
import ImageConverter from '../components/tools/ImageConverter.astro';
import WhyUseImageConverter from '../components/WhyUseImageConverter.astro';
import SupportedImageFormats from '../components/SupportedImageFormats.astro';
import PopularImageConversionTools from '../components/PopularImageConversionTools.astro';
import ToolIcon from '../components/ToolIcon.astro';
import rawPagesData from '../data/resizer-pages.json';
import { COMPRESS_PRESETS, type CompressPreset } from '../data/compressPresets';
import { CONVERTER_PRESETS, type ConverterPreset } from '../data/converterPresets';
import { getPresetIntentDescription } from '../data/intentDescriptions';
import ConversionPrivacyBrief from '../components/ConversionPrivacyBrief.astro';
import ConversionEditorial from '../components/ConversionEditorial.astro';
import { getConverterEditorial } from '../data/converterEditorials';

interface ResizerPage {
  slug: string;
  keyword: string;
  metaTitle: string;
  metaDescription: string;
  h1: string;
  badge?: string;
  targetTag?: string;
  category: "filesize" | "dimension" | "social" | "preset";
  introCopy?: string;
  callout?: {
    badge?: string;
    title: string;
    description: string;
    link?: { href: string; text: string };
  };
  preset: {
    unit?: "PX" | "CM" | "MM" | "INCH" | "%";
    width?: number;
    height?: number;
    dpi?: number;
    targetMinSize?: number;
    targetSize?: number;
    targetUnit?: "KB" | "MB";
    maxFileSize?: number;
    maxFileUnit?: "KB" | "MB";
    lockRatio?: boolean;
  };
  faqs: Array<{ q: string; a: string }>;
}

const pagesData = rawPagesData as unknown as ResizerPage[];

export async function getStaticPaths() {
  const resizerPaths = (rawPagesData as unknown as ResizerPage[]).map((page) => ({
    params: { slug: page.slug },
    props: { type: 'resizer' as const, resizerPage: page, compressPreset: null, converterPreset: null }
  }));

  const compressPaths = COMPRESS_PRESETS.map((preset) => ({
    params: { slug: preset.slug },
    props: { type: 'compress' as const, resizerPage: null, compressPreset: preset, converterPreset: null }
  }));

  const converterPaths = CONVERTER_PRESETS.map((preset) => ({
    params: { slug: preset.slug },
    props: { type: 'converter' as const, resizerPage: null, compressPreset: null, converterPreset: preset }
  }));

  return [...resizerPaths, ...compressPaths, ...converterPaths];
}

type Props = 
  | { type: 'resizer'; resizerPage: ResizerPage; compressPreset: null; converterPreset: null }
  | { type: 'compress'; resizerPage: null; compressPreset: CompressPreset; converterPreset: null }
  | { type: 'converter'; resizerPage: null; compressPreset: null; converterPreset: ConverterPreset };

const props = Astro.props as Props;

// ==========================================
// RESIZER PAGE LOGIC (Preserved & Enhanced)
// ==========================================
function formatResizerBadge(p: { preset?: Partial<ResizerPage['preset']>; category?: string; badge?: string; targetTag?: string }): string {
  if (p.badge) return p.badge;
  if (p.targetTag) return p.targetTag;
  if (p.preset?.width && p.preset?.height) {
    return `${p.preset.width} × ${p.preset.height} ${p.preset.unit || 'px'}`;
  }
  if (p.preset?.targetSize) {
    return `${p.preset.targetSize} ${p.preset.targetUnit || 'KB'} Target`;
  }
  return 'Verified Preset';
}

const platformKeywords: Record<string, string> = {
  facebook: 'Facebook',
  instagram: 'Instagram',
  youtube: 'YouTube',
  tiktok: 'TikTok',
  linkedin: 'LinkedIn',
  whatsapp: 'WhatsApp',
  pinterest: 'Pinterest',
  discord: 'Discord'
};

let resizerCurrentBadge = '';
let isPlatform = false;
let platformName = '';
let platformSiblings: ResizerPage[] = [];
let categorySiblings: ResizerPage[] = [];
let otherCategoryPages: ResizerPage[] = [];
let resizerFeatures: string[] = [];
let resizerJsonLdWebPage: any = null;
let resizerJsonLdFaq: any = null;

if (props.type === 'resizer' && props.resizerPage) {
  const page = props.resizerPage;
  resizerCurrentBadge = formatResizerBadge(page);

  const detectedPlatformKey = Object.keys(platformKeywords).find(
    (k) => page.keyword.toLowerCase().includes(k) || page.slug.toLowerCase().includes(k)
  );
  isPlatform = Boolean(detectedPlatformKey);
  platformName = detectedPlatformKey ? platformKeywords[detectedPlatformKey] : '';

  platformSiblings = detectedPlatformKey
    ? pagesData.filter((p) => p.keyword.toLowerCase().includes(detectedPlatformKey) || p.slug.toLowerCase().includes(detectedPlatformKey))
    : [];

  categorySiblings = pagesData.filter(
    (p) => p.category === page.category && p.slug !== page.slug
  );

  otherCategoryPages = pagesData.filter(
    (p) => p.category !== page.category
  );

  const featuresByCategory: Record<string, string[]> = {
    filesize: [
      `Guaranteed under ${page.preset.targetSize || ''} ${page.preset.targetUnit || 'KB'} file weight with multi-pass quantization`,
      "Client-side execution — photos never leave your device sandbox",
      "Proportional dimension downscaling for lossless formats like PNG",
      "Compatible with official government exam, recruitment, and admission portals"
    ],
    dimension: [
      `Pixel-perfect ${page.preset.width} × ${page.preset.height} ${page.preset.unit || 'PX'} calibration`,
      page.preset.dpi ? `Calibrated for crisp ${page.preset.dpi} DPI print reproduction` : "Optimized for high-DPI retina display and edge clarity",
      "Zero distortion with flexible fit, center-crop, or stretch modes",
      "100% private in-browser resizing with instant export"
    ],
    social: [
      "Official canvas resolution calibrated for crisp social feed rendering",
      "Safe-area composition prevents accidental cropping by mobile overlays",
      "Fast batch queue processing for multi-image social carousels",
      "Zero compression blur, pure sRGB color fidelity, and no watermarks"
    ],
    preset: [
      "Pre-configured to meet strict official and biometric specifications",
      "Guaranteed compliance with pixel bounds and file size ceilings",
      "Zero server uploads — absolute privacy for personal IDs and documents",
      "Universal export in high-clarity JPG, PNG, and WebP"
    ]
  };

  resizerFeatures = featuresByCategory[page.category] || featuresByCategory.dimension;

  resizerJsonLdWebPage = {
    "@context": "https://schema.org",
    "@type": "WebPage",
    "name": page.metaTitle,
    "description": page.metaDescription,
    "url": `https://fasttoolverse.com/${page.slug}`
  };

  resizerJsonLdFaq = {
    "@context": "https://schema.org",
    "@type": "FAQPage",
    "mainEntity": page.faqs.map((f) => ({
      "@type": "Question",
      "name": f.q,
      "acceptedAnswer": {
        "@type": "Answer",
        "text": f.a
      }
    }))
  };
}

// ==========================================
// COMPRESSOR PAGE LOGIC (pSEO Engine)
// ==========================================
let compressCanonicalUrl = '';
let compressPageTitle = '';
let compressPageDescription = '';
let compressJsonLdSoftwareApp: any = null;
let compressJsonLdFaq: any = null;
let relatedPresetsList: CompressPreset[] = [];

if (props.type === 'compress' && props.compressPreset) {
  const preset = props.compressPreset;
  compressCanonicalUrl = `https://fasttoolverse.com/${preset.slug}`;
  compressPageTitle = preset.metaTitle;
  compressPageDescription = preset.metaDescription;

  compressJsonLdSoftwareApp = {
    "@context": "https://schema.org",
    "@type": "SoftwareApplication",
    "name": preset.title,
    "applicationCategory": "MultimediaApplication",
    "operatingSystem": "All (Web Browser)",
    "browserRequirements": "Requires JavaScript. Requires HTML5 Canvas support.",
    "offers": {
      "@type": "Offer",
      "price": "0",
      "priceCurrency": "USD"
    },
    "featureList": preset.features.map((f) => f.title)
  };

  compressJsonLdFaq = {
    "@context": "https://schema.org",
    "@type": "FAQPage",
    "mainEntity": preset.faqs.map((f) => ({
      "@type": "Question",
      "name": f.question,
      "acceptedAnswer": {
        "@type": "Answer",
        "text": f.answer
      }
    }))
  };

  // Find related presets matching relatedPresetSlugs
  const explicitRelated = COMPRESS_PRESETS.filter((p) =>
    preset.relatedPresetSlugs.includes(p.slug)
  );

  // Fill up to 4 if fewer specified
  const additionalRelated = COMPRESS_PRESETS.filter(
    (p) => p.slug !== preset.slug && !preset.relatedPresetSlugs.includes(p.slug)
  ).slice(0, Math.max(0, 4 - explicitRelated.length));

  relatedPresetsList = [...explicitRelated, ...additionalRelated];
}

// ==========================================
// CONVERTER PAGE LOGIC (7 pSEO Engine)
// ==========================================
let converterJsonLdSoftwareApp: any = null;
let converterJsonLdFaq: any = null;
let converterJsonLdBreadcrumbs: any = null;
let page: any = null;
let sourceFormat = '';
let targetFormat = '';

if (props.type === 'converter' && props.converterPreset) {
  const preset = props.converterPreset;
  page = preset;
  const canonical = `https://fasttoolverse.com/${preset.slug}/`;

  const slugParts = preset.slug.split('-to-');
  if (slugParts.length === 2) {
    sourceFormat = slugParts[0].toUpperCase();
    targetFormat = slugParts[1].replace(/-.*/, '').toUpperCase();
  } else {
    sourceFormat = 'IMAGE';
    targetFormat = (preset.preset.targetFormat || 'FORMAT').toUpperCase();
  }
  if (targetFormat === 'JPEG') targetFormat = 'JPG';
  if (sourceFormat === 'JPEG') sourceFormat = 'JPG';

  converterJsonLdBreadcrumbs = {
    "@context": "https://schema.org",
    "@type": "BreadcrumbList",
    "itemListElement": [
      {
        "@type": "ListItem",
        "position": 1,
        "name": "Home",
        "item": "https://fasttoolverse.com/"
      },
      {
        "@type": "ListItem",
        "position": 2,
        "name": "Image Converter",
        "item": "https://fasttoolverse.com/tools/image-converter/"
      },
      {
        "@type": "ListItem",
        "position": 3,
        "name": preset.title,
        "item": canonical
      }
    ]
  };

  converterJsonLdSoftwareApp = {
    "@context": "https://schema.org",
    "@type": "WebApplication",
    "name": `${preset.title} - FastToolVerse`,
    "url": canonical,
    "applicationCategory": "MultimediaApplication",
    "operatingSystem": "All (Web Browser)",
    "browserRequirements": "Requires JavaScript. Requires HTML5 Canvas support.",
    "offers": {
      "@type": "Offer",
      "price": "0",
      "priceCurrency": "USD"
    },
    "featureList": [
      "100% Client-Side In-Browser Conversion",
      "Zero Cloud Uploads - Complete Data Privacy",
      "Pre-configured Conversion Parameters",
      "Batch Queue Processing up to 15 Files",
      "Instant In-Memory File & ZIP Downloads"
    ]
  };

  converterJsonLdFaq = {
    "@context": "https://schema.org",
    "@type": "FAQPage",
    "mainEntity": preset.faqs.map((f) => ({
      "@type": "Question",
      "name": f.question,
      "acceptedAnswer": {
        "@type": "Answer",
        "text": f.answer
      }
    }))
  };
}

const canonicalUrl = props.type === 'converter'
  ? `https://fasttoolverse.com/${props.converterPreset.slug}/`
  : props.type === 'compress'
    ? `https://fasttoolverse.com/${props.compressPreset.slug}`
    : `https://fasttoolverse.com/${props.resizerPage.slug}`;

const pageTitle = props.type === 'converter'
  ? props.converterPreset.metaTitle
  : props.type === 'compress'
    ? props.compressPreset.metaTitle
    : props.resizerPage.metaTitle;

const pageDescription = props.type === 'converter'
  ? props.converterPreset.metaDescription
  : props.type === 'compress'
    ? props.compressPreset.metaDescription
    : props.resizerPage.metaDescription;

const intentDescription = getPresetIntentDescription(props);
const converterEditorial = props.type === 'converter' && props.converterPreset ? getConverterEditorial(props.converterPreset.slug) : null;
---

<Layout
  title={pageTitle}
  description={pageDescription}
  canonicalUrl={canonicalUrl}
>
  <Fragment slot="head">
    {props.type === 'converter' ? (
      <>
        <meta property="og:type" content="website" />
        <meta property="og:url" content={canonicalUrl} />
        <meta property="og:title" content={props.converterPreset.metaTitle} />
        <meta property="og:description" content={props.converterPreset.metaDescription} />
        <meta property="og:image" content="https://fasttoolverse.com/og-image-converter.png" />
        <meta name="twitter:card" content="summary_large_image" />
        <meta name="twitter:url" content={canonicalUrl} />
        <meta name="twitter:title" content={props.converterPreset.metaTitle} />
        <meta name="twitter:description" content={props.converterPreset.metaDescription} />
        <meta name="twitter:image" content="https://fasttoolverse.com/og-image-converter.png" />
        <script type="application/ld+json" set:html={JSON.stringify(converterJsonLdBreadcrumbs)} />
        <script type="application/ld+json" set:html={JSON.stringify(converterJsonLdSoftwareApp)} />
        <script type="application/ld+json" set:html={JSON.stringify(converterJsonLdFaq)} />
      </>
    ) : props.type === 'compress' ? (
      <>
        <script type="application/ld+json" set:html={JSON.stringify(compressJsonLdSoftwareApp)} />
        <script type="application/ld+json" set:html={JSON.stringify(compressJsonLdFaq)} />
      </>
    ) : (
      <>
        <script type="application/ld+json" set:html={JSON.stringify(resizerJsonLdWebPage)} />
        <script type="application/ld+json" set:html={JSON.stringify(resizerJsonLdFaq)} />
      </>
    )}
  </Fragment>

  {props.type === 'converter' ? (
    <div class="bg-slate-50 text-slate-900 dark:bg-slate-950 dark:text-slate-100 min-h-screen">
      <!-- Hero Header Section -->
      <section class="relative pt-8 pb-6 sm:pt-12 sm:pb-8 overflow-hidden">
        <div class="relative max-w-5xl mx-auto px-4 sm:px-6 lg:px-8 text-center">
          
          <!-- Breadcrumbs: Home -> Image Converter -> [Page Title] -->
          <nav aria-label="Breadcrumb" class="mb-5 flex justify-center">
            <ol class="inline-flex items-center space-x-1.5 md:space-x-2 text-xs font-medium text-slate-500 dark:text-slate-400">
              <li class="inline-flex items-center">
                <a href="/" class="hover:text-blue-600 dark:hover:text-blue-400 transition-colors">Home</a>
              </li>
              <li>
                <div class="flex items-center">
                  <svg class="w-3 h-3 text-slate-400 mx-1" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7" />
                  </svg>
                  <a href="/tools/image-converter/" class="hover:text-blue-600 dark:hover:text-blue-400 transition-colors">Image Converter</a>
                </div>
              </li>
              <li aria-current="page">
                <div class="flex items-center">
                  <svg class="w-3 h-3 text-slate-400 mx-1" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7" />
                  </svg>
                  <span class="text-slate-900 dark:text-white font-semibold truncate max-w-[200px] sm:max-w-none">{props.converterPreset.title}</span>
                </div>
              </li>
            </ol>
          </nav>

          <!-- Hero H1 Title -->
          <h1 class="text-3xl sm:text-4xl md:text-5xl font-bold tracking-tight text-slate-900 dark:text-white">
            {props.converterPreset.h1}
          </h1>

          <p class="text-slate-600 dark:text-slate-300 text-center max-w-2xl mx-auto mt-3 mb-8 text-sm md:text-base leading-relaxed">
            {props.converterPreset.heroSubtitle || page.heroSubtitle || `Convert ${sourceFormat} images to ${targetFormat} seamlessly in your browser with zero file uploads and preserved image quality.`}
          </p>

        </div>
      </section>

      <!-- Pre-Configured Interactive Workspace (Above-The-Fold Priority) -->
      <section id="tool-workspace" class="max-w-6xl mx-auto px-4 sm:px-6 lg:px-8 pb-16 sm:pb-24 scroll-mt-20">
        <ImageConverter
          initialTargetFormat={props.converterPreset.preset.targetFormat}
          accept={props.converterPreset.preset.accept}
          initialGrayscale={props.converterPreset.preset.grayscale}
          initialResizeMode={props.converterPreset.preset.resizeMode}
          initialWidth={props.converterPreset.preset.width}
          initialHeight={props.converterPreset.preset.height}
          initialMatteColor={props.converterPreset.preset.matteColor}
        />

        <div class="bg-white dark:bg-slate-900/60 border border-slate-200 dark:border-slate-800 rounded-xl p-5 md:p-6 text-slate-700 dark:text-slate-300 text-sm md:text-base leading-relaxed max-w-4xl mx-auto my-6 shadow-sm">
          <p>{intentDescription}</p>
        </div>
      </section>

      <!-- Cross-Link Banner to Image Resizer -->
      <section class="max-w-6xl mx-auto px-4 sm:px-6 lg:px-8 pb-14">
        <div class="rounded-2xl p-6 sm:p-8 bg-gradient-to-r from-blue-600 via-indigo-600 to-blue-700 text-white shadow-xl shadow-blue-500/10 flex flex-col sm:flex-row items-center justify-between gap-5 text-center sm:text-left">
          <div class="space-y-1.5">
            <h3 class="text-lg sm:text-xl font-bold tracking-tight text-white">
              Need custom physical dimensions, centimeters, millimeters, or 300 DPI?
            </h3>
            <p class="text-xs sm:text-sm text-blue-100 max-w-xl leading-relaxed">
              Use our companion Image Resizer to set exact centimeters (cm), millimeters (mm), inches, or passport photo standards.
            </p>
          </div>
          <a
            href="/tools/image-resizer/"
            class="inline-flex items-center justify-center gap-2 px-6 py-3 rounded-xl bg-white text-slate-900 hover:bg-blue-50 font-semibold text-xs sm:text-sm shadow-md hover:shadow-lg transition-all active:scale-95 shrink-0"
          >
            <span>Open Image Resizer</span>
            <span aria-hidden="true" class="text-base font-bold leading-none">&rarr;</span>
          </a>
        </div>
      </section>

      <!-- 1. Intent-Matched 3-Step Guide Section -->
      <section class="border-t border-slate-200/90 dark:border-slate-800 bg-slate-100/60 dark:bg-slate-900/30 py-14 sm:py-16">
        <div class="max-w-5xl mx-auto px-4 sm:px-6 lg:px-8">
          <div class="text-center max-w-2xl mx-auto mb-10">
            <h2 class="text-2xl sm:text-3xl font-bold tracking-tight text-slate-900 dark:text-white">
              How to Use {props.converterPreset.title} in 3 Simple Steps
            </h2>
            <p class="mt-2 text-sm sm:text-base text-slate-600 dark:text-slate-400">
              Pre-configured, private, and effortless. Run batch conversions right inside your browser in seconds.
            </p>
          </div>

          <div class="grid grid-cols-1 md:grid-cols-3 gap-6">
            {props.converterPreset.steps.map((step) => (
              <div class="p-6 rounded-2xl bg-white border border-slate-300 shadow-sm hover:shadow-md hover:border-blue-600 transition-all duration-150 dark:bg-slate-900/60 dark:border-slate-800 relative">
                <div class="w-10 h-10 rounded-xl bg-blue-50 dark:bg-blue-950/40 text-blue-600 dark:text-blue-400 flex items-center justify-center font-bold font-mono text-sm mb-4 border border-blue-100 dark:border-blue-900/50">
                  {step.stepNumber}
                </div>
                <h3 class="text-base font-semibold text-slate-900 dark:text-white mb-2">
                  {step.title}
                </h3>
                <p class="text-sm text-slate-600 dark:text-slate-400 leading-relaxed">
                  {step.desc}
                </p>
              </div>
            ))}
          </div>
        </div>
      </section>

      <WhyUseImageConverter />

      <SupportedImageFormats />

      <PopularImageConversionTools />

      <!-- 2. Structured Comparison / Specification Matrix -->
      <section class="border-t border-slate-200/90 dark:border-slate-800 bg-slate-50 dark:bg-slate-950 py-14 sm:py-16">
        <div class="max-w-5xl mx-auto px-4 sm:px-6 lg:px-8">
          <div class="text-center mb-10 max-w-2xl mx-auto">
            <h2 class="text-2xl sm:text-3xl font-bold tracking-tight text-slate-900 dark:text-white">
              {props.converterPreset.specMatrix.title}
            </h2>
            <p class="text-sm sm:text-base text-slate-600 dark:text-slate-400 mt-2">
              {props.converterPreset.specMatrix.subtitle}
            </p>
          </div>

          <div class="overflow-x-auto rounded-2xl border border-slate-300 dark:border-slate-800 bg-white dark:bg-slate-900 shadow-sm">
            <table class="w-full text-left text-xs sm:text-sm">
              <thead class="bg-slate-100/80 dark:bg-slate-800/80 text-slate-700 dark:text-slate-300 font-semibold border-b border-slate-200 dark:border-slate-700">
                <tr>
                  <th class="p-3.5 sm:p-4">{props.converterPreset.specMatrix.columns[0]}</th>
                  <th class="p-3.5 sm:p-4">{props.converterPreset.specMatrix.columns[1]}</th>
                  <th class="p-3.5 sm:p-4">{props.converterPreset.specMatrix.columns[2]}</th>
                  <th class="p-3.5 sm:p-4">Key Takeaway</th>
                </tr>
              </thead>
              <tbody class="divide-y divide-slate-100 dark:divide-slate-800">
                {props.converterPreset.specMatrix.rows.map((row) => (
                  <tr class="hover:bg-slate-50/60 dark:hover:bg-slate-800/40 transition-colors">
                    <td class="p-3.5 sm:p-4 font-semibold text-slate-900 dark:text-white whitespace-nowrap">
                      {row.parameter}
                    </td>
                    <td class="p-3.5 sm:p-4 text-slate-600 dark:text-slate-300 font-mono text-xs">
                      {row.sourceVal}
                    </td>
                    <td class="p-3.5 sm:p-4 text-blue-600 dark:text-blue-400 font-mono text-xs font-semibold">
                      {row.targetVal}
                    </td>
                    <td class="p-3.5 sm:p-4 text-slate-500 dark:text-slate-400 text-xs">
                      {row.notes || 'Standard compliant'}
                    </td>
                  </tr>
                ))}
              </tbody>
            </table>
          </div>
        </div>
      </section>

      <!-- NEW SECTION 1: "Your Data & Our Privacy" (Compact Trust Block: ~150-200 Words) -->
      <ConversionPrivacyBrief />

      <!-- NEW SECTION 2: Keyword-Targeted Practical Editorial Guide (Minimum 600+ Words Unique Content) -->
      {converterEditorial && (
        <ConversionEditorial editorial={converterEditorial} />
      )}

      <!-- 3. Contextual FAQ Section -->
      <section class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8 py-14 sm:py-16 border-t border-slate-200/90 dark:border-slate-800">
        <div class="text-center mb-10">
          <h2 class="text-2xl sm:text-3xl font-bold tracking-tight text-slate-900 dark:text-white">
            Frequently Asked Questions
          </h2>
          <p class="text-sm sm:text-base text-slate-600 dark:text-slate-400 mt-2">
            Technical answers to common questions about {props.converterPreset.title.toLowerCase()} and format processing.
          </p>
        </div>

        <div class="space-y-3.5">
          {props.converterPreset.faqs.map((faq) => (
            <details class="group rounded-2xl bg-white border border-slate-300 shadow-sm hover:shadow-md hover:border-blue-600 dark:bg-slate-900/60 dark:border-slate-800 overflow-hidden transition-all duration-150">
              <summary class="flex items-center justify-between p-4 sm:p-5 font-semibold text-sm sm:text-base text-slate-900 dark:text-white cursor-pointer select-none bg-slate-100/70 dark:bg-slate-800/60 transition-colors">
                <span>{faq.question}</span>
                <span class="ml-4 shrink-0 p-1 rounded-full text-slate-400 group-open:rotate-180 transition-transform duration-200">
