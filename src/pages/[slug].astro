---
import Layout from '../layouts/Layout.astro';
import ImageResizer from '../components/tools/ImageResizer.astro';
import ImageCompressor from '../components/tools/ImageCompressor.astro';
import ImageConverter from '../components/tools/ImageConverter.astro';
import WhyUseImageConverter from '../components/WhyUseImageConverter.astro';
import WhyUseImageCompressor from '../components/WhyUseImageCompressor.astro';
import SupportedImageFormats from '../components/SupportedImageFormats.astro';
import PopularImageConversionTools from '../components/PopularImageConversionTools.astro';
import PopularImageCompressionPresets from '../components/PopularImageCompressionPresets.astro';
import ToolIcon from '../components/ToolIcon.astro';
import rawPagesData from '../data/resizer-pages.json';
import { COMPRESS_PRESETS, IMAGE_COMPRESSOR_PRESETS, type CompressPreset } from '../data/compressPresets';
import { CONVERTER_PRESETS, type ConverterPreset } from '../data/converterPresets';
import { getPresetIntentDescription } from '../data/intentDescriptions';
import ConversionPrivacyBrief from '../components/ConversionPrivacyBrief.astro';
import ConversionEditorial from '../components/ConversionEditorial.astro';
import { getConverterEditorial } from '../data/converterEditorials';
import CompressorPrivacyBrief from '../components/CompressorPrivacyBrief.astro';
import CompressorDataPrivacy from '../components/CompressorDataPrivacy.astro';
import CompressorEditorial from '../components/CompressorEditorial.astro';
import { getCompressorEditorial } from '../data/compressorEditorials';
import RemoveEmptyLinesPresetView from '../components/RemoveEmptyLinesPresetView.astro';
import { REMOVE_EMPTY_LINES_PRESETS, type RemoveEmptyLinesPreset } from '../data/removeEmptyLinesPresets';
import RemoveLineBreaksPresetView from '../components/RemoveLineBreaksPresetView.astro';
import { removeLineBreaksPresets, type RemoveLineBreaksPreset } from '../data/removeLineBreaksPresets';
import RemoveDuplicateLinesPresetView from '../components/RemoveDuplicateLinesPresetView.astro';
import { DUPLICATE_LINES_PRESETS, type DuplicateLinesPreset } from '../data/duplicateLinesPresets';
import { TOOLS, TEXT_TOOLS, type Tool } from '../data/tools';

interface ResizerPage {
  slug: string;
  keyword: string;
  metaTitle: string;
  metaDescription: string;
  h1: string;
  badge?: string;
  targetTag?: string;
  category: "filesize" | "dimension" | "social" | "preset";
  introCopy?: string;
  callout?: {
    badge?: string;
    title: string;
    description: string;
    link?: { href: string; text: string };
  };
  preset: {
    unit?: "PX" | "CM" | "MM" | "INCH" | "%";
    width?: number;
    height?: number;
    dpi?: number;
    targetMinSize?: number;
    targetSize?: number;
    targetUnit?: "KB" | "MB";
    maxFileSize?: number;
    maxFileUnit?: "KB" | "MB";
    lockRatio?: boolean;
  };
  faqs: Array<{ q: string; a: string }>;
}

const pagesData = rawPagesData as unknown as ResizerPage[];

export interface PendingToolData {
  toolSlug: string;
  toolName: string;
  category: string;
  description: string;
  icon: string;
  tags: string[];
}

export async function getStaticPaths() {
  const resizerPaths = (rawPagesData as unknown as ResizerPage[]).map((page) => ({
    params: { slug: page.slug },
    props: { type: 'resizer' as const, resizerPage: page, compressPreset: null, converterPreset: null, emptyLinesPreset: null, lineBreaksPreset: null, duplicateLinesPreset: null, pendingTool: null }
  }));

  const compressPaths = COMPRESS_PRESETS.map((preset) => ({
    params: { slug: preset.slug },
    props: { type: 'compress' as const, resizerPage: null, compressPreset: preset, converterPreset: null, emptyLinesPreset: null, lineBreaksPreset: null, duplicateLinesPreset: null, pendingTool: null }
  }));

  const converterPaths = CONVERTER_PRESETS.map((preset) => ({
    params: { slug: preset.slug },
    props: { type: 'converter' as const, resizerPage: null, compressPreset: null, converterPreset: preset, emptyLinesPreset: null, lineBreaksPreset: null, duplicateLinesPreset: null, pendingTool: null }
  }));

  const emptyLinesPaths = REMOVE_EMPTY_LINES_PRESETS.map((preset) => ({
    params: { slug: preset.slug },
    props: { type: 'empty-lines' as const, resizerPage: null, compressPreset: null, converterPreset: null, emptyLinesPreset: preset, lineBreaksPreset: null, duplicateLinesPreset: null, pendingTool: null }
  }));

  const lineBreaksPaths = removeLineBreaksPresets.map((preset) => ({
    params: { slug: preset.slug },
    props: { type: 'line-breaks' as const, resizerPage: null, compressPreset: null, converterPreset: null, emptyLinesPreset: null, lineBreaksPreset: preset, duplicateLinesPreset: null, pendingTool: null }
  }));

  const duplicateLinesPaths = DUPLICATE_LINES_PRESETS.map((preset) => ({
    params: { slug: preset.slug },
    props: { type: 'duplicate-lines' as const, resizerPage: null, compressPreset: null, converterPreset: null, emptyLinesPreset: null, lineBreaksPreset: null, duplicateLinesPreset: preset, pendingTool: null }
  }));

  
    const acronyms: Record<string, string> = {
    json: 'JSON',
    jwt: 'JWT',
    uuid: 'UUID',
    url: 'URL',
    html: 'HTML',
    css: 'CSS',
    js: 'JS',
    exif: 'EXIF',
    rgb: 'RGB',
    hex: 'HEX',
    cmyk: 'CMYK',
    dpi: 'DPI',
    ppi: 'PPI',
    svg: 'SVG',
    png: 'PNG',
    jpg: 'JPG',
    jpeg: 'JPEG',
    webp: 'WebP',
    avif: 'AVIF',
    gif: 'GIF',
    dp: 'DP',
    qa: 'QA',
    bd: 'BD'
  };

  const specialTitles: Record<string, string> = {
    'passport-size-maker': 'Passport Size Maker',
    'passport-size': 'Passport Size Maker',
    'image-compressor': 'Image Compressor',
    'image-cropper': 'Image Cropper',
    'image-rotator': 'Image Rotator',
    'image-flipper': 'Image Flipper',
    'image-converter': 'Image Converter',
    'image-optimizer': 'Image Optimizer',
    'aspect-ratio-calculator': 'Aspect Ratio Calculator',
    'image-dimensions-calculator': 'Image Dimensions Calculator',
    'add-watermark': 'Add Watermark',
    'color-picker-from-image': 'Color Picker from Image',
    'json-formatter': 'JSON Formatter',
    'json-validator': 'JSON Validator',
    'json-minifier': 'JSON Minifier',
    'base64-encoder': 'Base64 Encoder',
    'base64-decoder': 'Base64 Decoder',
    'url-encoder': 'URL Encoder',
    'url-decoder': 'URL Decoder',
    'uuid-generator': 'UUID Generator',
    'timestamp-converter': 'Timestamp Converter',
    'unix-timestamp-converter': 'Unix Timestamp Converter',
    'regex-tester': 'Regex Tester',
    'jwt-decoder': 'JWT Decoder',
    'html-formatter': 'HTML Formatter',
    'css-minifier': 'CSS Minifier',
    'js-minifier': 'JS Minifier',
    'color-converter': 'Color Converter',
    'text-case-converter': 'Text Case Converter',
    'find-and-replace-text': 'Find & Replace Text',
    'add-prefix-suffix': 'Add Prefix & Suffix',
    'remove-special-characters': 'Remove Special Characters',
    'text-to-slug-converter': 'Text to Slug Converter'
  };

  function slugToTitle(slug: string): string {
    if (specialTitles[slug]) return specialTitles[slug];
    const cleanSlug = slug.replace(/\/+$/, '');
    const foundTool =
      TOOLS.find((t) => t.id === cleanSlug || t.href.replace(/^\/?(tools\/)?/, '').replace(/\/+$/, '') === cleanSlug) ||
      TEXT_TOOLS.find((t) => t.id === cleanSlug || t.href.replace(/^\/?(tools\/)?/, '').replace(/\/+$/, '') === cleanSlug);
    if (foundTool) return foundTool.title;

    return cleanSlug
      .split('-')
      .map((part) => acronyms[part.toLowerCase()] || (part.charAt(0).toUpperCase() + part.slice(1).toLowerCase()))
      .join(' ');
  }

  const pendingToolSlugs = [
    'image-cropper',
    'image-rotator',
    'image-flipper',
    'passport-size-maker',
    'passport-size',
    'image-optimizer',
    'aspect-ratio-calculator',
    'image-dimensions-calculator',
    'add-watermark',
    'exif-viewer',
    'color-picker-from-image',
    'youtube-image-resizer',
    'instagram-image-resizer',
    'facebook-image-resizer',
    'x-twitter-image-resizer',
    'linkedin-image-resizer',
    'pinterest-image-resizer',
    'tiktok-image-resizer',
    'whatsapp-image-resizer',
    'json-formatter',
    'json-validator',
    'json-minifier',
    'base64-encoder',
    'base64-decoder',
    'url-encoder',
    'url-decoder',
    'uuid-generator',
    'timestamp-converter',
    'unix-timestamp-converter',
    'regex-tester',
    'jwt-decoder',
    'html-formatter',
    'css-minifier',
    'js-minifier',
    'color-converter',
    'text-case-converter',
    'find-and-replace-text',
    'add-prefix-suffix',
    'remove-special-characters',
    'text-to-slug-converter'
  ];

  const pendingPaths = pendingToolSlugs.map((slug) => {
    const matchedTool =
      TOOLS.find((t) => t.id === slug || t.href.replace(/^\/?(tools\/)?/, '').replace(/\/+$/, '') === slug) ||
      (TEXT_TOOLS.find((t) => t.id === slug || t.href.replace(/^\/?(tools\/)?/, '').replace(/\/+$/, '') === slug) as unknown as Tool | undefined);

    const title = slugToTitle(slug);
    const category = matchedTool?.category || (slug.includes('image') || slug.includes('photo') ? 'Image Tools' : 'Developer Tools');
    const description =
      matchedTool?.description ||
      `Fast, private, client-side ${title} with zero server uploads and instant hardware-accelerated processing in your web browser.`;
    const icon = matchedTool?.icon || (category === 'Image Tools' ? 'image' : 'code');
    const tags = matchedTool?.tags || ['Client-Side', 'Zero Upload', 'Fast Engine'];

    return {
      params: { slug },
      props: {
        type: 'pending-tool' as const,
        resizerPage: null,
        compressPreset: null,
        converterPreset: null,
        emptyLinesPreset: null,
        lineBreaksPreset: null,
        duplicateLinesPreset: null,
        pendingTool: {
          toolSlug: slug,
          toolName: title,
          category,
          description,
          icon,
          tags
        }
      }
    };
  });

  return [...resizerPaths, ...compressPaths, ...converterPaths, ...emptyLinesPaths, ...lineBreaksPaths, ...duplicateLinesPaths, ...pendingPaths];

}

type Props = 
  | { type: 'resizer'; resizerPage: ResizerPage; compressPreset: null; converterPreset: null; emptyLinesPreset: null; lineBreaksPreset: null; duplicateLinesPreset: null; pendingTool: null }
  | { type: 'compress'; resizerPage: null; compressPreset: CompressPreset; converterPreset: null; emptyLinesPreset: null; lineBreaksPreset: null; duplicateLinesPreset: null; pendingTool: null }
  | { type: 'converter'; resizerPage: null; compressPreset: null; converterPreset: ConverterPreset; emptyLinesPreset: null; lineBreaksPreset: null; duplicateLinesPreset: null; pendingTool: null }
  | { type: 'empty-lines'; resizerPage: null; compressPreset: null; converterPreset: null; emptyLinesPreset: RemoveEmptyLinesPreset; lineBreaksPreset: null; duplicateLinesPreset: null; pendingTool: null }
  | { type: 'line-breaks'; resizerPage: null; compressPreset: null; converterPreset: null; emptyLinesPreset: null; lineBreaksPreset: RemoveLineBreaksPreset; duplicateLinesPreset: null; pendingTool: null }
  | { type: 'duplicate-lines'; resizerPage: null; compressPreset: null; converterPreset: null; emptyLinesPreset: null; lineBreaksPreset: null; duplicateLinesPreset: DuplicateLinesPreset; pendingTool: null }
  | { type: 'pending-tool'; resizerPage: null; compressPreset: null; converterPreset: null; emptyLinesPreset: null; lineBreaksPreset: null; duplicateLinesPreset: null; pendingTool: PendingToolData };

const props = Astro.props as Props;

// ==========================================
// RESIZER PAGE LOGIC (Preserved & Enhanced)
// ==========================================
function formatResizerBadge(p: { preset?: Partial<ResizerPage['preset']>; category?: string; badge?: string; targetTag?: string }): string {
  if (p.badge) return p.badge;
  if (p.targetTag) return p.targetTag;
  if (p.preset?.width && p.preset?.height) {
    return `${p.preset.width} × ${p.preset.height} ${p.preset.unit || 'px'}`;
  }
  if (p.preset?.targetSize) {
    return `${p.preset.targetSize} ${p.preset.targetUnit || 'KB'} Target`;
  }
  return 'Verified Preset';
}

const platformKeywords: Record<string, string> = {
  facebook: 'Facebook',
  instagram: 'Instagram',
  youtube: 'YouTube',
  tiktok: 'TikTok',
  linkedin: 'LinkedIn',
  whatsapp: 'WhatsApp',
  pinterest: 'Pinterest',
  discord: 'Discord'
};

let resizerCurrentBadge = '';
let isPlatform = false;
let platformName = '';
let platformSiblings: ResizerPage[] = [];
let categorySiblings: ResizerPage[] = [];
let otherCategoryPages: ResizerPage[] = [];
let resizerFeatures: string[] = [];
let resizerJsonLdWebPage: any = null;
let resizerJsonLdFaq: any = null;

if (props.type === 'resizer' && props.resizerPage) {
  const page = props.resizerPage;
  resizerCurrentBadge = formatResizerBadge(page);

  const detectedPlatformKey = Object.keys(platformKeywords).find(
    (k) => page.keyword.toLowerCase().includes(k) || page.slug.toLowerCase().includes(k)
  );
  isPlatform = Boolean(detectedPlatformKey);
  platformName = detectedPlatformKey ? platformKeywords[detectedPlatformKey] : '';

  platformSiblings = detectedPlatformKey
    ? pagesData.filter((p) => p.keyword.toLowerCase().includes(detectedPlatformKey) || p.slug.toLowerCase().includes(detectedPlatformKey))
    : [];

  categorySiblings = pagesData.filter(
    (p) => p.category === page.category && p.slug !== page.slug
  );

  otherCategoryPages = pagesData.filter(
    (p) => p.category !== page.category
  );

  const featuresByCategory: Record<string, string[]> = {
    filesize: [
      `Guaranteed under ${page.preset.targetSize || ''} ${page.preset.targetUnit || 'KB'} file weight with multi-pass quantization`,
      "Client-side execution — photos never leave your device sandbox",
      "Proportional dimension downscaling for lossless formats like PNG",
      "Compatible with official government exam, recruitment, and admission portals"
    ],
    dimension: [
      `Pixel-perfect ${page.preset.width} × ${page.preset.height} ${page.preset.unit || 'PX'} calibration`,
      page.preset.dpi ? `Calibrated for crisp ${page.preset.dpi} DPI print reproduction` : "Optimized for high-DPI retina display and edge clarity",
      "Zero distortion with flexible fit, center-crop, or stretch modes",
      "100% private in-browser resizing with instant export"
    ],
    social: [
      "Official canvas resolution calibrated for crisp social feed rendering",
      "Safe-area composition prevents accidental cropping by mobile overlays",
      "Fast batch queue processing for multi-image social carousels",
      "Zero compression blur, pure sRGB color fidelity, and no watermarks"
    ],
    preset: [
      "Pre-configured to meet strict official and biometric specifications",
      "Guaranteed compliance with pixel bounds and file size ceilings",
      "Zero server uploads — absolute privacy for personal IDs and documents",
      "Universal export in high-clarity JPG, PNG, and WebP"
    ]
  };

  resizerFeatures = featuresByCategory[page.category] || featuresByCategory.dimension;

  resizerJsonLdWebPage = {
    "@context": "https://schema.org",
    "@type": "WebPage",
    "name": page.metaTitle,
    "description": page.metaDescription,
    "url": `https://fasttoolverse.com/${page.slug}/`
  };

  resizerJsonLdFaq = {
    "@context": "https://schema.org",
    "@type": "FAQPage",
    "mainEntity": page.faqs.map((f) => ({
      "@type": "Question",
      "name": f.q,
      "acceptedAnswer": {
        "@type": "Answer",
        "text": f.a
      }
    }))
  };
}

// ==========================================
// COMPRESSOR PAGE LOGIC (pSEO Engine)
// ==========================================
let compressCanonicalUrl = '';
let compressPageTitle = '';
let compressPageDescription = '';
let compressJsonLdSoftwareApp: any = null;
let compressJsonLdFaq: any = null;
let compressJsonLdBreadcrumbs: any = null;
let compressEditorial: any = null;
let relatedPresetsList: CompressPreset[] = [];

if (props.type === 'compress' && props.compressPreset) {
  const preset = props.compressPreset;
  compressCanonicalUrl = `https://fasttoolverse.com/${preset.slug}/`;
  compressPageTitle = preset.metaTitle;
  compressPageDescription = preset.metaDescription;
  compressEditorial = getCompressorEditorial(preset.slug);

  compressJsonLdBreadcrumbs = {
    "@context": "https://schema.org",
    "@type": "BreadcrumbList",
    "itemListElement": [
      {
        "@type": "ListItem",
        "position": 1,
        "name": "Home",
        "item": "https://fasttoolverse.com/"
      },
      {
        "@type": "ListItem",
        "position": 2,
        "name": "Image Compressor",
        "item": "https://fasttoolverse.com/image-compressor/"
      },
      {
        "@type": "ListItem",
        "position": 3,
        "name": preset.title,
        "item": compressCanonicalUrl
      }
    ]
  };

  compressJsonLdSoftwareApp = {
    "@context": "https://schema.org",
    "@type": "SoftwareApplication",
    "name": preset.title,
    "applicationCategory": "MultimediaApplication",
    "operatingSystem": "All (Web Browser)",
    "browserRequirements": "Requires JavaScript. Requires HTML5 Canvas support.",
    "offers": {
      "@type": "Offer",
      "price": "0",
      "priceCurrency": "USD"
    },
    "featureList": (compressEditorial?.features || preset.features).map((f: any) => f.title)
  };

  compressJsonLdFaq = {
    "@context": "https://schema.org",
    "@type": "FAQPage",
    "mainEntity": (compressEditorial?.faqs || preset.faqs).map((f: any) => ({
      "@type": "Question",
      "name": f.question,
      "acceptedAnswer": {
        "@type": "Answer",
        "text": f.answer
      }
    }))
  };

  // Provide all presets for presets section
  relatedPresetsList = COMPRESS_PRESETS;
}

// ==========================================
// CONVERTER PAGE LOGIC (7 pSEO Engine)
// ==========================================
let converterJsonLdSoftwareApp: any = null;
let converterJsonLdFaq: any = null;
let converterJsonLdBreadcrumbs: any = null;
let page: any = null;
let sourceFormat = '';
let targetFormat = '';

if (props.type === 'converter' && props.converterPreset) {
  const preset = props.converterPreset;
  page = preset;
  const canonical = `https://fasttoolverse.com/${preset.slug}/`;

  const slugParts = preset.slug.split('-to-');
  if (slugParts.length === 2) {
    sourceFormat = slugParts[0].toUpperCase();
    targetFormat = slugParts[1].replace(/-.*/, '').toUpperCase();
  } else {
    sourceFormat = 'IMAGE';
    targetFormat = (preset.preset.targetFormat || 'FORMAT').toUpperCase();
  }
  if (targetFormat === 'JPEG') targetFormat = 'JPG';
  if (sourceFormat === 'JPEG') sourceFormat = 'JPG';

  converterJsonLdBreadcrumbs = {
    "@context": "https://schema.org",
    "@type": "BreadcrumbList",
    "itemListElement": [
      {
        "@type": "ListItem",
        "position": 1,
        "name": "Home",
        "item": "https://fasttoolverse.com/"
      },
      {
        "@type": "ListItem",
        "position": 2,
        "name": "Image Converter",
        "item": "https://fasttoolverse.com/image-converter/"
      },
      {
        "@type": "ListItem",
        "position": 3,
        "name": preset.title,
        "item": canonical
      }
    ]
  };

  converterJsonLdSoftwareApp = {
    "@context": "https://schema.org",
    "@type": "WebApplication",
    "name": `${preset.title} - FastToolVerse`,
    "url": canonical,
    "applicationCategory": "MultimediaApplication",
    "operatingSystem": "All (Web Browser)",
    "browserRequirements": "Requires JavaScript. Requires HTML5 Canvas support.",
    "offers": {
      "@type": "Offer",
      "price": "0",
      "priceCurrency": "USD"
    },
    "featureList": [
      "100% Client-Side In-Browser Conversion",
      "Zero Cloud Uploads - Complete Data Privacy",
      "Pre-configured Conversion Parameters",
      "Batch Queue Processing up to 15 Files",
      "Instant In-Memory File & ZIP Downloads"
    ]
  };

  converterJsonLdFaq = {
    "@context": "https://schema.org",
    "@type": "FAQPage",
    "mainEntity": preset.faqs.map((f) => ({
      "@type": "Question",
      "name": f.question,
      "acceptedAnswer": {
        "@type": "Answer",
        "text": f.answer
      }
    }))
  };
}

// ==========================================
// REMOVE EMPTY LINES PAGE LOGIC (35 pSEO Engine)
// ==========================================
let emptyLinesJsonLdSoftwareApp: any = null;
let emptyLinesJsonLdFaq: any = null;
let emptyLinesJsonLdBreadcrumbs: any = null;

if (props.type === 'empty-lines' && props.emptyLinesPreset) {
  const preset = props.emptyLinesPreset;
  const canonical = `https://fasttoolverse.com/${preset.slug}/`;

  emptyLinesJsonLdBreadcrumbs = {
    "@context": "https://schema.org",
    "@type": "BreadcrumbList",
    "itemListElement": [
      {
        "@type": "ListItem",
        "position": 1,
        "name": "Home",
        "item": "https://fasttoolverse.com/"
      },
      {
        "@type": "ListItem",
        "position": 2,
        "name": "Text & Formatting",
        "item": "https://fasttoolverse.com/#text-tools-section"
      },
      {
        "@type": "ListItem",
        "position": 3,
        "name": "Remove Empty Lines",
        "item": "https://fasttoolverse.com/remove-empty-lines/"
      },
      {
        "@type": "ListItem",
        "position": 4,
        "name": preset.name || preset.h1,
        "item": canonical
      }
    ]
  };

  emptyLinesJsonLdSoftwareApp = {
    "@context": "https://schema.org",
    "@type": "SoftwareApplication",
    "name": `${preset.name || preset.h1} - FastToolVerse`,
    "applicationCategory": "UtilitiesApplication",
    "operatingSystem": "All (Web Browser)",
    "browserRequirements": "Requires JavaScript. Runs 100% client-side in browser RAM.",
    "offers": {
      "@type": "Offer",
      "price": "0",
