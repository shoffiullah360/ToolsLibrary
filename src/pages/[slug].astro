    },
    "featureList": [
      "100% in-browser text cleaning with zero server uploads",
      "Strip blank and empty lines instantly",
      "Delete whitespace-only lines containing spaces and tabs",
      "Collapse consecutive blank lines to a single blank line",
      "Trim leading and trailing empty lines from file boundaries",
      "Live line, character, and word count metric calculations",
      "One-click clipboard copy and clean .txt file export"
    ]
  };

  emptyLinesJsonLdFaq = {
    "@context": "https://schema.org",
    "@type": "FAQPage",
    "mainEntity": preset.faqs.map((f) => ({
      "@type": "Question",
      "name": f.question,
      "acceptedAnswer": {
        "@type": "Answer",
        "text": f.answer
      }
    }))
  };
}

let lineBreaksJsonLdSoftwareApp: any = null;
let lineBreaksJsonLdFaq: any = null;
let lineBreaksJsonLdBreadcrumbs: any = null;

if (props.type === 'line-breaks' && props.lineBreaksPreset) {
  const preset = props.lineBreaksPreset;
  const canonical = `https://fasttoolverse.com/${preset.slug}/`;

  lineBreaksJsonLdBreadcrumbs = {
    "@context": "https://schema.org",
    "@type": "BreadcrumbList",
    "itemListElement": [
      {
        "@type": "ListItem",
        "position": 1,
        "name": "Home",
        "item": "https://fasttoolverse.com/"
      },
      {
        "@type": "ListItem",
        "position": 2,
        "name": "Text & Formatting",
        "item": "https://fasttoolverse.com/#text-tools-section"
      },
      {
        "@type": "ListItem",
        "position": 3,
