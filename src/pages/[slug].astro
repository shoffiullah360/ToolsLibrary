                    <span class="inline-block text-[11px] font-mono font-medium text-blue-600 dark:text-blue-400 mb-1">
                      {badge}
                    </span>
                    <h3 class="text-xs sm:text-sm font-semibold text-slate-800 dark:text-slate-200 group-hover:text-blue-600 dark:group-hover:text-blue-400 transition-colors line-clamp-1">
                      {rel.h1}
                    </h3>
                  </div>
                  <span class="text-[11px] text-slate-500 dark:text-slate-400 mt-2.5 flex items-center gap-1 group-hover:translate-x-0.5 transition-transform">
                    Resize now &rarr;
                  </span>
                </a>
              );
            })}
          </div>
        </div>
      </section>
    </div>
  )}
</Layout>
