      <script is:inline define:vars={{ preset: props.resizerPage.preset }}>
        function applyPresetSettings() {
          if (!preset) return;

          if (preset.targetSize) {
            const enableTargetSize = document.getElementById('enable-target-size');
            const inputTargetSize = document.getElementById('input-target-size');
            const sizeUnitKbBtn = document.getElementById('size-unit-kb');
            const sizeUnitMbBtn = document.getElementById('size-unit-mb');

            if (enableTargetSize && !enableTargetSize.checked) {
              enableTargetSize.checked = true;
              enableTargetSize.dispatchEvent(new Event('change', { bubbles: true }));
            }
            if (inputTargetSize) {
              inputTargetSize.value = preset.targetSize.toString();
              inputTargetSize.dispatchEvent(new Event('input', { bubbles: true }));
            }
            if (preset.targetUnit === 'MB' && sizeUnitMbBtn) {
              sizeUnitMbBtn.click();
            } else if (sizeUnitKbBtn) {
              sizeUnitKbBtn.click();
            }
          }

          const slugRangeMatch = window.location.pathname.match(/(\d+)(?:kb|mb)-to-(\d+)(?:kb|mb)/i);
          const minVal = preset.targetMinSize || (slugRangeMatch ? parseInt(slugRangeMatch[1], 10) : null);
          if (minVal) {
            const root = document.getElementById('image-resizer-root');
            if (root) {
              root.dataset.targetMinSize = minVal.toString();
              root.dataset.targetMinSizeKb = minVal.toString();
            }
          }

          if (preset.unit) {
            const unitVal = preset.unit.toLowerCase();
            const unitBtn = document.querySelector(`.unit-pill[data-unit="${unitVal}"]`);
            if (unitBtn) {
              unitBtn.click();
            }
            if (['mm', 'cm', 'inch'].includes(unitVal) || preset.dpi) {
              const dpiToggleBtn = document.getElementById('dpi-toggle-btn');
              const dpiVal = document.getElementById('dpi-val');
              if (dpiToggleBtn && dpiVal && !dpiVal.textContent.includes('300')) {
                dpiToggleBtn.click();
              }
            }
          }

          if (preset.width !== null && preset.width !== undefined) {
            const inputWidth = document.getElementById('input-width');
            if (inputWidth) {
              inputWidth.value = preset.width.toString();
              inputWidth.dispatchEvent(new Event('input', { bubbles: true }));
            }
          }
          if (preset.height !== null && preset.height !== undefined) {
            const inputHeight = document.getElementById('input-height');
            if (inputHeight) {
              inputHeight.value = preset.height.toString();
              inputHeight.dispatchEvent(new Event('input', { bubbles: true }));
            }
          }

          if (preset.lockRatio === false) {
            const lockIconLocked = document.getElementById('lock-icon-locked');
            const lockAspectBtn = document.getElementById('lock-aspect-btn');
            if (lockAspectBtn && lockIconLocked && !lockIconLocked.classList.contains('hidden')) {
              lockAspectBtn.click();
            }
          }
        }

        if (document.readyState === 'loading') {
          document.addEventListener('DOMContentLoaded', applyPresetSettings);
        } else {
          applyPresetSettings();
        }
        document.addEventListener('astro:page-load', applyPresetSettings);
      </script>

