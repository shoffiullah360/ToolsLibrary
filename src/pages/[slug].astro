---
import Layout from '../layouts/Layout.astro';
import ImageResizer from '../components/tools/ImageResizer.astro';
import rawPagesData from '../data/resizer-pages.json';

interface ResizerPage {
  slug: string;
  keyword: string;
  metaTitle: string;
  metaDescription: string;
  h1: string;
  badge?: string;
  targetTag?: string;
  category: "filesize" | "dimension" | "social" | "preset";
  preset: {
    unit?: "PX" | "CM" | "MM" | "INCH" | "%";
    width?: number;
    height?: number;
    dpi?: number;
    targetMinSize?: number;
    targetSize?: number;
    targetUnit?: "KB" | "MB";
    maxFileSize?: number;
    maxFileUnit?: "KB" | "MB";
    lockRatio?: boolean;
  };
  faqs: Array<{ q: string; a: string }>;
}

const pagesData = rawPagesData as unknown as ResizerPage[];

export async function getStaticPaths() {
  return (rawPagesData as unknown as ResizerPage[]).map((page) => ({
    params: { slug: page.slug },
    props: { page }
  }));
}

const { page } = Astro.props as { page: ResizerPage };

const canonicalUrl = `https://toolslibrary.pages.dev/${page.slug}`;

// Helper badge formatter
function formatBadge(p: { preset?: Partial<ResizerPage['preset']>; category?: string; badge?: string; targetTag?: string }): string {
  if (p.badge) return p.badge;
  if (p.targetTag) return p.targetTag;
  if (p.preset?.width && p.preset?.height) {
    return `${p.preset.width} × ${p.preset.height} ${p.preset.unit || 'px'}`;
  }
  if (p.preset?.targetSize) {
    return `${p.preset.targetSize} ${p.preset.targetUnit || 'KB'} Target`;
  }
  return 'Verified Preset';
}

const currentBadge = formatBadge(page);

// Platform detection for social & app specs
const platformKeywords: Record<string, string> = {
  facebook: 'Facebook',
  instagram: 'Instagram',
  youtube: 'YouTube',
  tiktok: 'TikTok',
  linkedin: 'LinkedIn',
  whatsapp: 'WhatsApp',
  pinterest: 'Pinterest',
  discord: 'Discord'
};

const detectedPlatformKey = Object.keys(platformKeywords).find(
  (k) => page.keyword.toLowerCase().includes(k) || page.slug.toLowerCase().includes(k)
);
const isPlatform = Boolean(detectedPlatformKey);
const platformName = detectedPlatformKey ? platformKeywords[detectedPlatformKey] : '';

// Platform siblings (e.g. all Instagram or all YouTube presets)
const platformSiblings = detectedPlatformKey
  ? pagesData.filter((p) => p.keyword.toLowerCase().includes(detectedPlatformKey) || p.slug.toLowerCase().includes(detectedPlatformKey))
  : [];

// Category siblings
const categorySiblings = pagesData.filter(
  (p) => p.category === page.category && p.slug !== page.slug
);

// Other categories for smart cross-linking
const otherCategoryPages = pagesData.filter(
  (p) => p.category !== page.category
);

// Feature bullet points tailored to category
const featuresByCategory: Record<string, string[]> = {
  filesize: [
    `Guaranteed under ${page.preset.targetSize || ''} ${page.preset.targetUnit || 'KB'} file weight with multi-pass quantization`,
    "Client-side execution — photos never leave your device sandbox",
    "Proportional dimension downscaling for lossless formats like PNG",
    "Compatible with official government exam, recruitment, and admission portals"
  ],
  dimension: [
    `Pixel-perfect ${page.preset.width} × ${page.preset.height} ${page.preset.unit || 'PX'} calibration`,
    page.preset.dpi ? `Calibrated for crisp ${page.preset.dpi} DPI print reproduction` : "Optimized for high-DPI retina display and edge clarity",
    "Zero distortion with flexible fit, center-crop, or stretch modes",
    "100% private in-browser resizing with instant export"
  ],
  social: [
    "Official canvas resolution calibrated for crisp social feed rendering",
    "Safe-area composition prevents accidental cropping by mobile overlays",
    "Fast batch queue processing for multi-image social carousels",
    "Zero compression blur, pure sRGB color fidelity, and no watermarks"
  ],
  preset: [
    "Pre-configured to meet strict official and biometric specifications",
    "Guaranteed compliance with pixel bounds and file size ceilings",
    "Zero server uploads — absolute privacy for personal IDs and documents",
    "Universal export in high-clarity JPG, PNG, and WebP"
  ]
};

const features = featuresByCategory[page.category] || featuresByCategory.dimension;

// JSON-LD Schemas
const jsonLdWebPage = {
  "@context": "https://schema.org",
  "@type": "WebPage",
  "name": page.metaTitle,
  "description": page.metaDescription,
  "url": canonicalUrl
};

const jsonLdFaq = {
  "@context": "https://schema.org",
  "@type": "FAQPage",
  "mainEntity": page.faqs.map((f) => ({
    "@type": "Question",
    "name": f.q,
    "acceptedAnswer": {
      "@type": "Answer",
      "text": f.a
    }
  }))
};
---

<Layout
  title={page.metaTitle}
  description={page.metaDescription}
  canonicalUrl={canonicalUrl}
>
  <Fragment slot="head">
    <!-- Structured Data Schemas -->
    <script type="application/ld+json" set:html={JSON.stringify(jsonLdWebPage)} />
    <script type="application/ld+json" set:html={JSON.stringify(jsonLdFaq)} />
  </Fragment>

  <!-- Hero Header Section -->
  <section class="relative pt-8 pb-6 sm:pt-12 sm:pb-8 overflow-hidden">
    <div class="relative max-w-5xl mx-auto px-4 sm:px-6 lg:px-8 text-center">
      <!-- Breadcrumbs -->
      <nav aria-label="Breadcrumb" class="mb-5 flex justify-center">
        <ol class="inline-flex items-center space-x-1.5 md:space-x-2 text-xs font-medium text-slate-500 dark:text-slate-400">
          <li class="inline-flex items-center">
            <a href="/" class="hover:text-blue-600 dark:hover:text-blue-400 transition-colors">Home</a>
          </li>
          <li>
            <div class="flex items-center">
              <svg class="w-3 h-3 text-slate-400 mx-1" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7" />
              </svg>
              <a href="/tools/image-resizer" class="hover:text-blue-600 dark:hover:text-blue-400 transition-colors">Tools</a>
            </div>
          </li>
          <li aria-current="page">
            <div class="flex items-center">
              <svg class="w-3 h-3 text-slate-400 mx-1" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7" />
              </svg>
              <span class="text-slate-900 dark:text-white font-semibold truncate max-w-[200px] sm:max-w-none">{currentBadge}</span>
            </div>
          </li>
        </ol>
      </nav>

      <!-- Badge -->
      <div class="inline-flex items-center gap-1.5 px-3.5 py-1 rounded-full text-xs font-semibold bg-blue-50 dark:bg-blue-950/50 text-blue-600 dark:text-blue-400 border border-blue-200 dark:border-blue-900/50 mb-4 shadow-2xs">
        <span class="w-1.5 h-1.5 rounded-full bg-blue-500 animate-pulse"></span>
        <span>{currentBadge}</span>
      </div>

      <!-- H1 Headline (Verbatim Title Cased Keyword) -->
      <h1 class="text-3xl sm:text-4xl md:text-5xl font-bold tracking-tight text-slate-900 dark:text-white">
        {page.h1}
      </h1>

      <!-- Meta Description Subtitle -->
      <p class="mt-3 sm:mt-4 text-base sm:text-lg text-slate-600 dark:text-slate-400 max-w-2xl mx-auto leading-relaxed">
        {page.metaDescription}
      </p>
    </div>
  </section>

  <!-- Interactive Studio Container with Pre-configured Tool -->
  <section class="max-w-6xl mx-auto px-4 sm:px-6 lg:px-8 pb-12 sm:pb-16">
    <ImageResizer
      preset={page.preset}
      initialWidth={page.preset.width}
      initialHeight={page.preset.height}
      initialUnit={page.preset.unit?.toLowerCase() as any}
      width={page.preset.width}
      height={page.preset.height}
      unit={page.preset.unit as any}
      targetMinFileSize={page.preset.targetMinSize ?? (page.slug.match(/(\d+)(?:kb|mb)-to-(\d+)(?:kb|mb)/i) ? parseInt(page.slug.match(/(\d+)(?:kb|mb)-to-(\d+)(?:kb|mb)/i)![1], 10) : undefined)}
      targetMinSizeKB={page.preset.targetMinSize}
      targetMaxFileSize={page.preset.targetSize}
      targetUnit={page.preset.targetUnit || 'KB'}
      targetSizeKB={page.preset.targetUnit === 'MB' ? (page.preset.targetSize ? page.preset.targetSize * 1024 : undefined) : page.preset.targetSize}
      lockRatio={page.preset.lockRatio}
    />
  </section>

  <!-- Pre-configuration Inline Script for immediate DOM alignment -->
  <script is:inline define:vars={{ preset: page.preset }}>
    function applyPresetSettings() {
      if (!preset) return;

      // 1. Target Max File Size & Unit (KB / MB)
      if (preset.targetSize) {
        const enableTargetSize = document.getElementById('enable-target-size');
        const inputTargetSize = document.getElementById('input-target-size');
        const sizeUnitKbBtn = document.getElementById('size-unit-kb');
        const sizeUnitMbBtn = document.getElementById('size-unit-mb');

        if (enableTargetSize && !enableTargetSize.checked) {
          enableTargetSize.checked = true;
          enableTargetSize.dispatchEvent(new Event('change', { bubbles: true }));
        }
        if (inputTargetSize) {
          inputTargetSize.value = preset.targetSize.toString();
          inputTargetSize.dispatchEvent(new Event('input', { bubbles: true }));
        }
        if (preset.targetUnit === 'MB' && sizeUnitMbBtn) {
          sizeUnitMbBtn.click();
        } else if (sizeUnitKbBtn) {
          sizeUnitKbBtn.click();
        }
      }

      // Range Target Min Size configuration
      const slugRangeMatch = window.location.pathname.match(/(\d+)(?:kb|mb)-to-(\d+)(?:kb|mb)/i);
      const minVal = preset.targetMinSize || (slugRangeMatch ? parseInt(slugRangeMatch[1], 10) : null);
      if (minVal) {
        const root = document.getElementById('image-resizer-root');
        if (root) {
          root.dataset.targetMinSize = minVal.toString();
          root.dataset.targetMinSizeKb = minVal.toString();
        }
      }

      // 2. Measurement Unit & DPI
      if (preset.unit) {
        const unitVal = preset.unit.toLowerCase();
        const unitBtn = document.querySelector(`.unit-pill[data-unit="${unitVal}"]`);
        if (unitBtn) {
          unitBtn.click();
        }
        if (['mm', 'cm', 'inch'].includes(unitVal) || preset.dpi) {
          const dpiToggleBtn = document.getElementById('dpi-toggle-btn');
          const dpiVal = document.getElementById('dpi-val');
          if (dpiToggleBtn && dpiVal && !dpiVal.textContent.includes('300')) {
            dpiToggleBtn.click();
          }
        }
      }

      // 3. Width & Height
      if (preset.width !== null && preset.width !== undefined) {
        const inputWidth = document.getElementById('input-width');
        if (inputWidth) {
          inputWidth.value = preset.width.toString();
          inputWidth.dispatchEvent(new Event('input', { bubbles: true }));
        }
      }
      if (preset.height !== null && preset.height !== undefined) {
        const inputHeight = document.getElementById('input-height');
        if (inputHeight) {
          inputHeight.value = preset.height.toString();
          inputHeight.dispatchEvent(new Event('input', { bubbles: true }));
        }
      }

      // 4. Lock Aspect Ratio
      if (preset.lockRatio === false) {
        const lockIconLocked = document.getElementById('lock-icon-locked');
        const lockAspectBtn = document.getElementById('lock-aspect-btn');
        if (lockAspectBtn && lockIconLocked && !lockIconLocked.classList.contains('hidden')) {
          lockAspectBtn.click();
        }
      }
    }

    if (document.readyState === 'loading') {
      document.addEventListener('DOMContentLoaded', applyPresetSettings);
    } else {
      applyPresetSettings();
    }
    document.addEventListener('astro:page-load', applyPresetSettings);
  </script>

  <!-- 3-Step Guide Section -->
  <section class="border-t border-slate-200 dark:border-slate-800 bg-slate-50/50 dark:bg-slate-900/40 py-14 sm:py-16">
    <div class="max-w-5xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="text-center max-w-2xl mx-auto mb-10">
        <h2 class="text-2xl sm:text-3xl font-bold tracking-tight text-slate-900 dark:text-white">
          How to {page.h1} in 3 Simple Steps
        </h2>
        <p class="mt-2 text-sm sm:text-base text-slate-600 dark:text-slate-400">
          Fast, effortless, and private. Process high-resolution photos in your browser with zero cloud uploads.
        </p>
      </div>

      <div class="grid grid-cols-1 md:grid-cols-3 gap-6">
        <!-- Step 1 -->
        <div class="p-6 rounded-2xl border border-slate-200 dark:border-slate-800 bg-white dark:bg-slate-900 shadow-2xs relative">
          <div class="w-10 h-10 rounded-xl bg-blue-50 dark:bg-blue-950/40 text-blue-600 dark:text-blue-400 flex items-center justify-center font-bold font-mono text-sm mb-4 border border-blue-100 dark:border-blue-900/50">
            01
          </div>
          <h3 class="text-base font-semibold text-slate-900 dark:text-white mb-2">
            Upload or Drop Image
          </h3>
          <p class="text-sm text-slate-600 dark:text-slate-400 leading-relaxed">
            Drag and drop your file into the workspace, select from your device, or paste directly with <kbd class="px-1.5 py-0.5 text-xs font-mono bg-slate-100 dark:bg-slate-800 rounded border border-slate-200 dark:border-slate-700">Ctrl+V</kbd>.
          </p>
        </div>

        <!-- Step 2 -->
        <div class="p-6 rounded-2xl border border-slate-200 dark:border-slate-800 bg-white dark:bg-slate-900 shadow-2xs relative">
          <div class="w-10 h-10 rounded-xl bg-blue-50 dark:bg-blue-950/40 text-blue-600 dark:text-blue-400 flex items-center justify-center font-bold font-mono text-sm mb-4 border border-blue-100 dark:border-blue-900/50">
            02
          </div>
          <h3 class="text-base font-semibold text-slate-900 dark:text-white mb-2">
            Preset Automatically Calibrated
          </h3>
          <p class="text-sm text-slate-600 dark:text-slate-400 leading-relaxed">
            This tool is pre-configured for <strong>{currentBadge}</strong>. Tweak dimensions, toggle crop mode, or select your preferred export format.
          </p>
        </div>

        <!-- Step 3 -->
        <div class="p-6 rounded-2xl border border-slate-200 dark:border-slate-800 bg-white dark:bg-slate-900 shadow-2xs relative">
          <div class="w-10 h-10 rounded-xl bg-blue-50 dark:bg-blue-950/40 text-blue-600 dark:text-blue-400 flex items-center justify-center font-bold font-mono text-sm mb-4 border border-blue-100 dark:border-blue-900/50">
            03
          </div>
          <h3 class="text-base font-semibold text-slate-900 dark:text-white mb-2">
            Export & Download Instantly
          </h3>
          <p class="text-sm text-slate-600 dark:text-slate-400 leading-relaxed">
            Select JPG, PNG, or WebP. Download your compressed, perfectly resized image instantly with zero watermarks.
          </p>
        </div>
      </div>
    </div>
  </section>

  <!-- Smart Sibling Grid / Platform & Category Section -->
  <section class="border-t border-slate-200 dark:border-slate-800 bg-white dark:bg-slate-950/60 py-14 sm:py-16">
    <div class="max-w-6xl mx-auto px-4 sm:px-6 lg:px-8">
      {isPlatform && platformSiblings.length > 1 ? (
        <div>
          <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-2 mb-8">
            <div>
              <h2 class="text-2xl sm:text-3xl font-bold tracking-tight text-slate-900 dark:text-white">
                All Verified {platformName} Image Dimensions
              </h2>
              <p class="text-sm sm:text-base text-slate-500 dark:text-slate-400 mt-1">
                Switch between official sizes and aspect ratios for {platformName} in one click.
              </p>
            </div>
            <a
              href="/tools/image-resizer"
              class="text-xs font-semibold text-blue-600 dark:text-blue-400 hover:text-blue-700 dark:hover:text-blue-300 transition-colors inline-flex items-center gap-1 shrink-0"
            >
              All Resizer Presets
              <svg class="w-3.5 h-3.5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                <path stroke-linecap="round" stroke-linejoin="round" d="M13.5 4.5L21 12m0 0l-7.5 7.5M21 12H3" />
              </svg>
            </a>
          </div>

          <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-4">
            {platformSiblings.map((sib) => {
              const isCurrent = sib.slug === page.slug;
              const sibBadge = formatBadge(sib);
              return (
                <div
                  class={`group relative p-5 rounded-2xl border transition-all flex flex-col justify-between ${
                    isCurrent
                      ? 'border-blue-500 bg-blue-50/40 dark:bg-blue-950/30 ring-2 ring-blue-500/20 shadow-xs'
                      : 'border-slate-200 dark:border-slate-800 bg-white dark:bg-slate-900 hover:border-blue-500/50 hover:shadow-md'
                  }`}
                >
                  <div>
                    <div class="flex items-center justify-between gap-2 mb-2.5">
                      <span class="inline-block text-[11px] font-semibold px-2.5 py-0.5 rounded-full bg-blue-100 dark:bg-blue-900/60 text-blue-700 dark:text-blue-300">
                        {platformName}
                      </span>
                      <span class="inline-flex items-center px-2 py-0.5 rounded-md font-mono text-xs font-semibold bg-slate-100 dark:bg-slate-800 text-slate-700 dark:text-slate-300 border border-slate-200 dark:border-slate-700">
                        {sibBadge}
                      </span>
                    </div>
                    <h3 class="text-sm font-semibold text-slate-900 dark:text-white group-hover:text-blue-600 dark:group-hover:text-blue-400 transition-colors line-clamp-2 leading-snug">
                      {sib.h1}
                    </h3>
                  </div>
                  <div class="mt-4 pt-3 border-t border-slate-100 dark:border-slate-800/80 flex items-center justify-between text-xs">
                    {isCurrent ? (
                      <span class="font-semibold text-blue-600 dark:text-blue-400 flex items-center gap-1.5">
                        <span class="w-2 h-2 rounded-full bg-blue-500 animate-pulse"></span>
                        Current Preset
                      </span>
                    ) : (
                      <a
                        href={`/${sib.slug}`}
                        class="font-semibold text-blue-600 dark:text-blue-400 hover:text-blue-700 dark:hover:text-blue-300 inline-flex items-center gap-1 after:absolute after:inset-0"
                      >
                        Resize this format &rarr;
                      </a>
                    )}
                  </div>
                </div>
              );
            })}
          </div>
        </div>
      ) : (
        <div>
          <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-2 mb-8">
            <div>
              <h2 class="text-2xl sm:text-3xl font-bold tracking-tight text-slate-900 dark:text-white">
                Related {page.category === 'filesize' ? 'File Size Presets' : (page.category === 'dimension' ? 'Dimension Presets' : 'Popular Specifications')}
              </h2>
              <p class="text-sm sm:text-base text-slate-500 dark:text-slate-400 mt-1">
                Explore matching target limits, dimension standards, and official specifications.
              </p>
            </div>
            <a
              href="/tools/image-resizer"
              class="text-xs font-semibold text-blue-600 dark:text-blue-400 hover:text-blue-700 dark:hover:text-blue-300 transition-colors inline-flex items-center gap-1 shrink-0"
            >
              All Resizer Presets
              <svg class="w-3.5 h-3.5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                <path stroke-linecap="round" stroke-linejoin="round" d="M13.5 4.5L21 12m0 0l-7.5 7.5M21 12H3" />
              </svg>
            </a>
          </div>

          <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-4">
            {categorySiblings.slice(0, 16).map((rel) => {
              const relBadge = formatBadge(rel);
              return (
                <a
                  href={`/${rel.slug}`}
                  class="group relative p-5 rounded-2xl border border-slate-200 dark:border-slate-800 bg-white dark:bg-slate-900 hover:border-blue-500/50 hover:shadow-md transition-all flex flex-col justify-between"
                >
                  <div>
                    <div class="flex items-center justify-between gap-2 mb-2.5">
                      <span class="inline-block text-[11px] font-semibold px-2.5 py-0.5 rounded-full bg-blue-50 dark:bg-blue-950/60 text-blue-600 dark:text-blue-400 border border-blue-100 dark:border-blue-900/50">
                        {rel.category.toUpperCase()}
                      </span>
                      <span class="inline-flex items-center px-2 py-0.5 rounded-md font-mono text-xs font-semibold bg-slate-100 dark:bg-slate-800 text-slate-700 dark:text-slate-300 border border-slate-200 dark:border-slate-700">
                        {relBadge}
                      </span>
                    </div>
                    <h3 class="text-sm font-semibold text-slate-900 dark:text-white group-hover:text-blue-600 dark:group-hover:text-blue-400 transition-colors line-clamp-2 leading-snug">
                      {rel.h1}
                    </h3>
                  </div>
                  <div class="mt-4 pt-3 border-t border-slate-100 dark:border-slate-800/80 flex items-center justify-between text-xs">
                    <span class="font-semibold text-blue-600 dark:text-blue-400 inline-flex items-center gap-1 group-hover:translate-x-0.5 transition-transform">
                      Resize now &rarr;
                    </span>
                  </div>
                </a>
              );
            })}
          </div>
        </div>
      )}
    </div>
  </section>

  <!-- Features Grid -->
  <section class="border-t border-slate-200 dark:border-slate-800 bg-slate-50/50 dark:bg-slate-900/40 py-14 sm:py-16">
    <div class="max-w-5xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="text-center mb-9">
        <h2 class="text-2xl sm:text-3xl font-bold tracking-tight text-slate-900 dark:text-white">
          Why Choose Our {page.h1} Tool?
        </h2>
        <p class="text-sm sm:text-base text-slate-500 dark:text-slate-400 mt-2 max-w-xl mx-auto">
          Engineered with precision client-side algorithms for instantaneous processing, zero cloud uploads, and maximum visual fidelity.
        </p>
      </div>

      <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
        {features.map((feature) => (
          <div class="flex items-start gap-3.5 p-4 sm:p-5 rounded-2xl border border-slate-200 dark:border-slate-800 bg-white dark:bg-slate-900 shadow-2xs">
            <div class="w-6 h-6 rounded-lg bg-blue-50 dark:bg-blue-950/50 text-blue-600 dark:text-blue-400 flex items-center justify-center shrink-0 mt-0.5">
              <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5">
                <path stroke-linecap="round" stroke-linejoin="round" d="M4.5 12.75l6 6 9-13.5" />
              </svg>
            </div>
            <span class="text-sm font-medium text-slate-700 dark:text-slate-300 leading-snug">{feature}</span>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- FAQ Accordion Section -->
  <section class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8 py-14 sm:py-16 border-t border-slate-200 dark:border-slate-800">
    <div class="text-center mb-9">
      <h2 class="text-2xl sm:text-3xl font-bold tracking-tight text-slate-900 dark:text-white">
        Frequently Asked Questions
      </h2>
      <p class="text-sm sm:text-base text-slate-500 dark:text-slate-400 mt-2">
        Everything you need to know about {page.h1}.
      </p>
    </div>

    <div class="space-y-3.5">
      {page.faqs.map((item) => (
        <details class="group rounded-2xl border border-slate-200 dark:border-slate-800 bg-white dark:bg-slate-900 p-5 transition-all open:ring-1 open:ring-blue-500/20 shadow-2xs">
