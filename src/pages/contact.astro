---
import Layout from '../layouts/Layout.astro';
import ToolIcon from '../components/ToolIcon.astro';
---

<Layout
  title="Contact Us | ToolsLibrary"
  description="Have a question, feedback, or tool suggestion? Get in touch with the ToolsLibrary team. We respond within 24-48 business hours."
  canonicalUrl="https://fasttoolverse.com/contact"
>
  <div class="relative py-12 sm:py-16 lg:py-20 px-4 sm:px-6 lg:px-8 max-w-5xl mx-auto">
    <!-- Header Section -->
    <div class="mb-12 text-center max-w-2xl mx-auto space-y-4">
      <div class="inline-flex items-center gap-2 px-3 py-1 rounded-full bg-blue-50 dark:bg-blue-950/40 border border-blue-200 dark:border-blue-800 text-xs font-mono font-medium text-blue-700 dark:text-blue-400">
        <ToolIcon name="mail" class="w-3.5 h-3.5" />
        <span>Get in Touch</span>
      </div>
      <h1 class="text-3xl sm:text-4xl font-extrabold tracking-tight text-slate-900 dark:text-white">
        Contact ToolsLibrary Support
      </h1>
      <p class="text-slate-600 dark:text-slate-300 text-sm sm:text-base leading-relaxed">
        Have feedback, spotted a bug, or want to suggest a new client-side tool? We'd love to hear from you.
      </p>
    </div>

    <div class="grid grid-cols-1 lg:grid-cols-3 gap-8 items-start">
      
      <!-- Left Column: Contact Cards & Info -->
      <div class="space-y-6">
        
        <!-- Direct Support Card -->
        <div class="p-6 rounded-2xl bg-white dark:bg-slate-800/80 border border-slate-300 dark:border-slate-800 space-y-3 shadow-sm hover:shadow-md hover:border-blue-600 dark:hover:border-blue-500 transition-all duration-150">
          <div class="w-10 h-10 rounded-xl bg-blue-50 dark:bg-blue-950/50 text-blue-600 dark:text-blue-400 flex items-center justify-center">
            <ToolIcon name="mail" class="w-5 h-5" />
          </div>
          <h3 class="text-base font-bold text-slate-900 dark:text-white">Direct Email Support</h3>
          <p class="text-xs text-slate-500 dark:text-slate-400 leading-relaxed">
            Prefer using your own email client? Send your inquiries directly to:
          </p>
          <!--email_off-->
          <a
            href="mailto:support@toolslibrary.com"
            class="inline-block text-sm font-mono font-medium text-blue-600 dark:text-blue-400 hover:underline break-all"
          >
            support@toolslibrary.com
          </a>
          <!--/email_off-->
        </div>

        <!-- Response Time Card -->
        <div class="p-6 rounded-2xl bg-white dark:bg-slate-800/80 border border-slate-300 dark:border-slate-800 space-y-3 shadow-sm hover:shadow-md hover:border-blue-600 dark:hover:border-blue-500 transition-all duration-150">
          <div class="w-10 h-10 rounded-xl bg-emerald-50 dark:bg-emerald-950/50 text-emerald-600 dark:text-emerald-400 flex items-center justify-center">
            <ToolIcon name="clock" class="w-5 h-5" />
          </div>
          <h3 class="text-base font-bold text-slate-900 dark:text-white">Response Time</h3>
          <p class="text-xs sm:text-sm text-slate-600 dark:text-slate-400 leading-relaxed">
            Our support team reviews inquiries Monday through Friday. You can typically expect a detailed response within <strong>24&ndash;48 business hours</strong>.
          </p>
        </div>

        <!-- Quick Help Card -->
        <div class="p-6 rounded-2xl bg-white dark:bg-slate-900/60 border border-slate-300 dark:border-slate-800 space-y-3 shadow-sm">
          <h4 class="text-xs font-mono uppercase tracking-wider text-slate-500 dark:text-slate-400 font-semibold">
            Common Inquiries
          </h4>
          <ul class="space-y-2 text-xs sm:text-sm text-slate-600 dark:text-slate-300">
            <li>
              &bull; <a href="/privacy-policy" class="hover:text-blue-600 dark:hover:text-blue-400 hover:underline">How does client-side privacy work?</a>
            </li>
            <li>
              &bull; <a href="/terms" class="hover:text-blue-600 dark:hover:text-blue-400 hover:underline">Can I use resized images commercially?</a> (Yes!)
            </li>
            <li>
              &bull; <a href="/about" class="hover:text-blue-600 dark:hover:text-blue-400 hover:underline">Learn more about our mission</a>
            </li>
          </ul>
        </div>

      </div>

      <!-- Right Column: Contact Form -->
      <div class="lg:col-span-2 p-6 sm:p-8 rounded-3xl bg-white dark:bg-slate-800/90 border border-slate-300 dark:border-slate-800 shadow-sm">
        <h2 class="text-xl font-bold text-slate-900 dark:text-white mb-2">Send us a message</h2>
        <p class="text-sm text-slate-500 dark:text-slate-400 mb-6">
          Fill out the form below and our team will get back to you promptly.
        </p>

        <!-- Form Element -->
        <form id="contact-form" class="space-y-5">
          <!-- Name & Email Row -->
          <div class="grid grid-cols-1 sm:grid-cols-2 gap-5">
            <div>
              <label for="contact-name" class="block text-xs font-semibold text-slate-700 dark:text-slate-300 mb-1.5">
                Your Name <span class="text-red-500">*</span>
              </label>
              <input
                type="text"
                id="contact-name"
                name="name"
                required
                placeholder="Jane Doe"
                class="w-full px-4 py-2.5 rounded-xl border border-slate-200 dark:border-slate-700 bg-slate-50 dark:bg-slate-900 text-slate-900 dark:text-white placeholder:text-slate-400 text-sm focus:outline-hidden focus:ring-2 focus:ring-blue-500 focus:border-transparent transition-all"
              />
            </div>
            <div>
              <label for="contact-email" class="block text-xs font-semibold text-slate-700 dark:text-slate-300 mb-1.5">
                Your Email Address <span class="text-red-500">*</span>
              </label>
              <input
                type="email"
                id="contact-email"
                name="email"
                required
                placeholder="jane@example.com"
                class="w-full px-4 py-2.5 rounded-xl border border-slate-200 dark:border-slate-700 bg-slate-50 dark:bg-slate-900 text-slate-900 dark:text-white placeholder:text-slate-400 text-sm focus:outline-hidden focus:ring-2 focus:ring-blue-500 focus:border-transparent transition-all"
              />
            </div>
          </div>

          <!-- Subject -->
          <div>
            <label for="contact-subject" class="block text-xs font-semibold text-slate-700 dark:text-slate-300 mb-1.5">
              Subject <span class="text-red-500">*</span>
            </label>
            <input
              type="text"
              id="contact-subject"
              name="subject"
              required
              placeholder="e.g., Feature Request: WebP lossless compression preset"
              class="w-full px-4 py-2.5 rounded-xl border border-slate-200 dark:border-slate-700 bg-slate-50 dark:bg-slate-900 text-slate-900 dark:text-white placeholder:text-slate-400 text-sm focus:outline-hidden focus:ring-2 focus:ring-blue-500 focus:border-transparent transition-all"
            />
          </div>

          <!-- Message -->
          <div>
            <label for="contact-message" class="block text-xs font-semibold text-slate-700 dark:text-slate-300 mb-1.5">
              Message <span class="text-red-500">*</span>
            </label>
            <textarea
              id="contact-message"
              name="message"
              rows="5"
              required
              placeholder="Describe your question, request, or issue with as much detail as possible..."
              class="w-full px-4 py-3 rounded-xl border border-slate-200 dark:border-slate-700 bg-slate-50 dark:bg-slate-900 text-slate-900 dark:text-white placeholder:text-slate-400 text-sm focus:outline-hidden focus:ring-2 focus:ring-blue-500 focus:border-transparent transition-all resize-y"
            ></textarea>
          </div>

          <!-- Submission Feedback Box -->
          <div id="contact-status-success" class="hidden p-4 rounded-xl bg-emerald-50 dark:bg-emerald-950/50 border border-emerald-200 dark:border-emerald-800 text-emerald-800 dark:text-emerald-300 text-sm flex items-start gap-3">
            <ToolIcon name="check" class="w-5 h-5 text-emerald-500 shrink-0 mt-0.5" />
            <div>
              <div class="font-semibold">Message Received!</div>
              <p class="text-xs text-emerald-700 dark:text-emerald-400 mt-0.5">
                Thank you for reaching out. We have received your submission and will get back to you within 24&ndash;48 business hours.
              </p>
            </div>
          </div>

          <!-- Submit Button -->
          <div class="flex items-center justify-between pt-2">
            <span class="text-xs text-slate-400">All fields marked with * are required</span>
            <button
              type="submit"
              id="contact-submit-btn"
              class="inline-flex items-center gap-2 px-6 py-2.5 rounded-xl bg-blue-600 hover:bg-blue-700 text-white font-medium text-sm shadow-xs hover:shadow transition-all duration-200 cursor-pointer"
            >
              <span>Send Message</span>
              <ToolIcon name="arrow-right" class="w-4 h-4" />
            </button>
          </div>
        </form>
      </div>

    </div>
  </div>

  <script is:inline>
    document.addEventListener('DOMContentLoaded', () => {
      const form = document.getElementById('contact-form');
      const statusSuccess = document.getElementById('contact-status-success');
      const submitBtn = document.getElementById('contact-submit-btn');

      if (form && statusSuccess && submitBtn) {
        form.addEventListener('submit', (e) => {
          e.preventDefault();

          // Simple UX animation and confirmation
          submitBtn.setAttribute('disabled', 'true');
          submitBtn.classList.add('opacity-75', 'cursor-not-allowed');
          submitBtn.textContent = 'Sending...';

          setTimeout(() => {
            statusSuccess.classList.remove('hidden');
            form.reset();
            submitBtn.removeAttribute('disabled');
            submitBtn.classList.remove('opacity-75', 'cursor-not-allowed');
            submitBtn.innerHTML = `<span>Send Another Message</span>`;
          }, 600);
        });
      }
    });
  </script>
</Layout>
