---
// src/pages/remove-duplicate-lines/[slug].astro
import Layout from '../../layouts/Layout.astro';
import RemoveDuplicateLinesPresetView from '../../components/RemoveDuplicateLinesPresetView.astro';
import { DUPLICATE_LINES_PRESETS, type DuplicateLinesPreset } from '../../data/duplicateLinesPresets';

export async function getStaticPaths() {
  return DUPLICATE_LINES_PRESETS.map((preset) => ({
    params: { slug: preset.slug },
    props: { preset }
  }));
}

interface Props {
  preset: DuplicateLinesPreset;
}

const { preset } = Astro.props;

const canonicalUrl = `https://fasttoolverse.com/remove-duplicate-lines/${preset.slug}/`;
const ogImage = "https://fasttoolverse.com/og-image.png";

// Structured Data Schemas
const jsonLdBreadcrumbs = {
  "@context": "https://schema.org",
  "@type": "BreadcrumbList",
  "itemListElement": [
    {
      "@type": "ListItem",
      "position": 1,
      "name": "Home",
      "item": "https://fasttoolverse.com/"
    },
    {
      "@type": "ListItem",
      "position": 2,
      "name": "Text & Formatting",
      "item": "https://fasttoolverse.com/#text-tools-section"
    },
    {
      "@type": "ListItem",
      "position": 3,
      "name": "Remove Duplicate Lines",
      "item": "https://fasttoolverse.com/remove-duplicate-lines/"
    },
    {
      "@type": "ListItem",
      "position": 4,
      "name": preset.name || preset.h1,
      "item": canonicalUrl
    }
  ]
};

const jsonLdSoftwareApp = {
  "@context": "https://schema.org",
  "@type": "SoftwareApplication",
  "name": `${preset.name || preset.h1} - FastToolVerse`,
  "applicationCategory": "UtilitiesApplication",
  "operatingSystem": "All (Web Browser)",
  "browserRequirements": "Requires JavaScript. Runs 100% client-side in browser RAM.",
  "offers": {
    "@type": "Offer",
    "price": "0",
    "priceCurrency": "USD"
  },
  "featureList": [
    "100% in-browser text deduplication with zero server uploads",
    "Instant O(1) Hash Set duplicate line removal",
    "Multi-mode extraction: Unique lines, Duplicates only, Count occurrences",
    "Case-sensitive and case-insensitive comparison toggles",
    "Trim edge whitespace and ignore punctuation normalization",
    "Instant delimiter joiner for CSV commas, semicolons, and custom separators",
    "Live line, word, character, and duplicate removal counters",
    "1-click copy to clipboard and .txt file export"
  ]
};

const jsonLdFaq = {
  "@context": "https://schema.org",
  "@type": "FAQPage",
  "mainEntity": preset.faqs.map((f) => ({
    "@type": "Question",
    "name": f.question,
    "acceptedAnswer": {
      "@type": "Answer",
      "text": f.answer
    }
  }))
};
---

<Layout
  title={preset.metaTitle}
  description={preset.metaDescription}
  canonicalUrl={canonicalUrl}
  image={ogImage}
>
  <Fragment slot="head">
    <meta name="keywords" content={`${preset.primaryQuery}, remove duplicate lines, duplicate line remover, text deduplicator, delete duplicate lines, unique line extractor, clean duplicate lines, client side text tool`} />
    <meta property="og:type" content="website" />
    <meta property="og:url" content={canonicalUrl} />
    <meta property="og:title" content={preset.metaTitle} />
    <meta property="og:description" content={preset.metaDescription} />
    <meta property="og:image" content={ogImage} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:url" content={canonicalUrl} />
    <meta name="twitter:title" content={preset.metaTitle} />
    <meta name="twitter:description" content={preset.metaDescription} />
    <meta name="twitter:image" content={ogImage} />
    <script type="application/ld+json" set:html={JSON.stringify(jsonLdBreadcrumbs)} />
    <script type="application/ld+json" set:html={JSON.stringify(jsonLdSoftwareApp)} />
    <script type="application/ld+json" set:html={JSON.stringify(jsonLdFaq)} />
  </Fragment>

  <RemoveDuplicateLinesPresetView preset={preset} />
</Layout>
