---
import Layout from '../../layouts/Layout.astro';
import ToolIcon from '../../components/ToolIcon.astro';
import DuplicateLineRemover from '../../components/tools/DuplicateLineRemover.astro';
import PopularRemoveDuplicateLines from '../../components/PopularRemoveDuplicateLines.astro';

// FAQ Data for Schema and Accordion
const faqs = [
  {
    question: "How do I remove duplicate lines from a list online?",
    answer: "Paste or type your text list into the Input Text box. FastToolVerse automatically executes client-side Set-based deduplication in real time. It removes all recurring occurrences while preserving the original order of first appearance. You can toggle case sensitivity, whitespace trimming, or alphabetical sorting instantly."
  },
  {
    question: "Does this duplicate line remover upload my confidential data or email lists to a server?",
    answer: "No. FastToolVerse processes 100% of your text locally in your web browser using modern JavaScript hash sets. Your proprietary databases, customer email lists, API keys, and internal CSV files never touch any external server, network endpoint, or analytics tracker."
  },
  {
    question: "What is the difference between case-sensitive and case-insensitive deduplication?",
    answer: "When 'Case-sensitive comparison' is enabled, 'Apple' and 'apple' are treated as two distinct unique entries. When unchecked (case-insensitive mode), both variants are recognized as duplicates, and only the first encountered casing is preserved in your cleaned list."
  },
  {
    question: "How does the 'Trim whitespace before comparing' option work?",
    answer: "Often lines contain accidental leading spaces or trailing tabs (for example, '  user@domain.com  ' vs 'user@domain.com'). When this option is enabled, FastToolVerse strips extraneous edge spaces before comparing hash keys, ensuring visually identical lines are properly identified and deduplicated."
  },
  {
    question: "Can I sort the unique list alphabetically in A-Z order?",
    answer: "Yes. Simply select 'Alphabetical (A → Z)' in the sort selector. FastToolVerse will deduplicate your list and instantly arrange your catalog, keyword list, or subscriber list into natural alphabetical order."
  },
  {
    question: "How does this tool handle large lists with 50,000+ lines?",
    answer: "Because this tool utilizes native JavaScript Hash Sets with O(1) constant-time key lookups (yielding total O(N) linear time complexity), it can deduplicate lists containing tens of thousands of lines in mere milliseconds without crashing or freezing your browser tab."
  },
  {
    question: "How do I deduplicate email addresses or single-column CSV datasets?",
    answer: "Copy your single column from Microsoft Excel, Google Sheets, or a CSV export and paste it directly into the input box. Enable 'Trim whitespace before comparing' and disable 'Case-sensitive comparison' for emails, choose your desired delimiter, then click 'Copy Result' or download the sanitized list as a .txt file."
  },
  {
    question: "Does this duplicate remover work offline?",
    answer: "Yes. Once the web page is loaded, all JavaScript logic runs entirely in your local browser sandbox. You can disconnect from Wi-Fi or work in airplane mode, and the deduplication tool will continue operating without interruptions."
  }
];

// Schema.org SoftwareApplication
const jsonLdSoftwareApp = {
  "@context": "https://schema.org",
  "@type": "SoftwareApplication",
  "name": "Free Online Duplicate Line Remover & Text Cleaner",
  "applicationCategory": "UtilitiesApplication",
  "operatingSystem": "All (Web Browser)",
  "browserRequirements": "Requires JavaScript. Runs 100% client-side.",
  "offers": {
    "@type": "Offer",
    "price": "0",
    "priceCurrency": "USD"
  },
  "featureList": [
    "100% In-browser text deduplication privacy",
    "High-performance O(N) Set-based line deduplication",
    "Multi-tab extraction modes: Unique, Duplicates-only, Completely Unique, Frequency counter",
    "Case-sensitive and case-insensitive comparison modes",
    "Trim leading and trailing line whitespace before deduplication",
    "Strip empty and blank lines",
    "Ignore punctuation and symbols normalization",
    "Flexible sorting: Original, A-Z, Z-A, Length, and Frequency",
    "Instant 1-click delimiter joiner for CSV commas, semicolons, and custom separators",
    "Live line, word, character, and duplicate removal counters",
    "1-click copy to clipboard and .txt file export"
  ]
};

// Schema.org FAQPage
const jsonLdFaq = {
  "@context": "https://schema.org",
  "@type": "FAQPage",
  "mainEntity": faqs.map((f) => ({
    "@type": "Question",
    "name": f.question,
    "acceptedAnswer": {
      "@type": "Answer",
      "text": f.answer
    }
  }))
};

// Schema.org BreadcrumbList
const jsonLdBreadcrumb = {
  "@context": "https://schema.org",
  "@type": "BreadcrumbList",
  "itemListElement": [
    {
      "@type": "ListItem",
      "position": 1,
      "name": "Home",
      "item": "https://fasttoolverse.com/"
    },
    {
      "@type": "ListItem",
      "position": 2,
      "name": "Text & Formatting",
      "item": "https://fasttoolverse.com/#text-tools-section"
    },
    {
      "@type": "ListItem",
      "position": 3,
      "name": "Remove Duplicate Lines",
      "item": "https://fasttoolverse.com/remove-duplicate-lines/"
    }
  ]
};

const canonicalUrl = "https://fasttoolverse.com/remove-duplicate-lines/";
const pageTitle = "Remove Duplicate Lines Online - Fast Deduplicator";
const pageDescription = "Remove duplicate lines, purge repetitive text, and filter unique entries in real time. Fast, secure, and processed completely client-side in your web browser.";
const pageKeywords = "remove duplicate lines, duplicate line remover, text deduplicator, delete duplicate lines, unique line extractor, deduplicate list online, clean duplicate lines, remove duplicate text, csv deduplicate, client side text tool";
const ogImage = "https://fasttoolverse.com/og-image.png";


---

<Layout
  title={pageTitle}
  description={pageDescription}
  canonicalUrl={canonicalUrl}
  image={ogImage}
>
  <!-- Injected Head Elements: Twitter & JSON-LD Schemas -->
  <Fragment slot="head">
    <meta name="keywords" content={pageKeywords} />

    <!-- Open Graph tags -->
    <meta property="og:type" content="website" />
    <meta property="og:url" content={canonicalUrl} />
    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={pageDescription} />
    <meta property="og:image" content={ogImage} />

    <!-- Twitter Card -->
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:url" content={canonicalUrl} />
    <meta name="twitter:title" content={pageTitle} />
    <meta name="twitter:description" content={pageDescription} />
    <meta name="twitter:image" content={ogImage} />

    <!-- Structured Data Schemas -->
    <script type="application/ld+json" set:html={JSON.stringify(jsonLdSoftwareApp)} />
    <script type="application/ld+json" set:html={JSON.stringify(jsonLdFaq)} />
    <script type="application/ld+json" set:html={JSON.stringify(jsonLdBreadcrumb)} />
  </Fragment>

  <!-- Hero Header Section -->
  <section class="relative pt-10 pb-6 sm:pt-14 sm:pb-8 overflow-hidden">
    <div class="hero-mesh-bg" aria-hidden="true"></div>

    <div class="relative max-w-5xl mx-auto px-4 sm:px-6 lg:px-8 text-center font-sans">
      <!-- Breadcrumbs -->
      <nav aria-label="Breadcrumb" class="mb-5 flex justify-center">
        <ol class="inline-flex items-center space-x-1.5 md:space-x-2 text-xs font-medium text-slate-500 dark:text-slate-400">
          <li class="inline-flex items-center">
            <a href="/" class="hover:text-emerald-600 dark:hover:text-emerald-400 transition-colors">Home</a>
          </li>
          <li>
            <div class="flex items-center">
              <svg class="w-3 h-3 text-slate-400 mx-1" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7" />
              </svg>
              <a href="/#text-tools-section" class="hover:text-emerald-600 dark:hover:text-emerald-400 transition-colors">Text & Formatting</a>
            </div>
          </li>
          <li aria-current="page">
            <div class="flex items-center">
              <svg class="w-3 h-3 text-slate-400 mx-1" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7" />
              </svg>
              <span class="text-slate-900 dark:text-white font-semibold">Remove Duplicate Lines</span>
            </div>
          </li>
        </ol>
      </nav>

      <!-- Hero Title -->
      <h1 class="text-3xl sm:text-4xl md:text-5xl font-bold tracking-tight text-slate-900 dark:text-white leading-tight font-sans">
        Free Online Duplicate Line Remover & Text Cleaner
      </h1>

      <!-- Subtitle (Exactly 24 words) -->
      <p class="mt-3 sm:mt-4 text-base sm:text-lg text-slate-600 dark:text-slate-400 max-w-3xl mx-auto leading-relaxed font-sans">
        Instantly remove duplicate lines, purge repetitive text, and filter unique entries in real time. Fast, secure, and processed completely client-side in your web browser.
      </p>
    </div>
  </section>

  <!-- Interactive Studio Container -->
  <section class="max-w-6xl mx-auto px-4 sm:px-6 lg:px-8 pb-8">
    <DuplicateLineRemover />
  </section>

  <!-- Intent Card / Workspace SEO Description (50-60 Words: 52 words) -->
  <section class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8 pb-12 font-sans">
    <div class="max-w-4xl mx-auto p-4 md:p-5 rounded-2xl bg-slate-900/60 border border-slate-800 text-slate-300 text-sm md:text-base leading-relaxed text-center shadow-lg backdrop-blur-sm">
      <p>
        Duplicate lines often clutter datasets when merging <span class="text-emerald-400 font-medium">contact lists, keyword databases, crawl sitemaps, and spreadsheet exports</span>. This high-performance duplicate line remover purges repetitive rows, isolates unique entries, extracts recurring records, and formats output with <span class="text-emerald-400 font-medium">custom delimiters</span>. All text processing operates locally inside your browser sandbox, ensuring your confidential lists remain <span class="text-emerald-400 font-medium">100% private</span>.
      </p>
    </div>
  </section>

  <!-- 3-Step Guide Section -->
  <section class="border-t border-slate-200 dark:border-slate-800 bg-slate-50/50 dark:bg-slate-900/40 py-16 sm:py-20 font-sans">
    <div class="max-w-5xl mx-auto px-4 sm:px-6 lg:px-8">
      
      <div class="text-center max-w-2xl mx-auto mb-12">
        <h2 class="text-2xl sm:text-3xl font-bold tracking-tight text-slate-900 dark:text-white">
          How to Remove Duplicate Lines Online in 3 Simple Steps
        </h2>
        <p class="mt-2 text-sm sm:text-base text-slate-600 dark:text-slate-400">
          Clean messy data lists, purge repeated entries, and preserve unique rows in seconds.
        </p>
      </div>

      <div class="grid grid-cols-1 md:grid-cols-3 gap-6 sm:gap-8">
        
        <!-- Step 1 -->
        <div class="p-6 rounded-2xl border border-slate-300 dark:border-slate-800 bg-white dark:bg-slate-900 shadow-sm hover:shadow-md hover:border-emerald-500/60 dark:hover:border-emerald-500/60 transition-all duration-150 relative">
          <div class="w-10 h-10 rounded-xl bg-emerald-50 dark:bg-emerald-950/40 text-emerald-600 dark:text-emerald-400 flex items-center justify-center font-bold font-mono text-sm mb-4 border border-emerald-100 dark:border-emerald-900/50">
            01
          </div>
          <h3 class="text-base font-semibold text-slate-900 dark:text-white mb-2">
            Paste Your Text List
          </h3>
          <p class="text-sm text-slate-600 dark:text-slate-400 leading-relaxed">
            Copy emails, URLs, keywords, or CSV lines from spreadsheets and paste them directly into the input box using <kbd class="px-1.5 py-0.5 text-xs font-mono bg-slate-100 dark:bg-slate-800 rounded border border-slate-200 dark:border-slate-700">Ctrl+V</kbd> or the Paste button.
          </p>
        </div>

        <!-- Step 2 -->
        <div class="p-6 rounded-2xl border border-slate-300 dark:border-slate-800 bg-white dark:bg-slate-900 shadow-sm hover:shadow-md hover:border-emerald-500/60 dark:hover:border-emerald-500/60 transition-all duration-150 relative">
          <div class="w-10 h-10 rounded-xl bg-emerald-50 dark:bg-emerald-950/40 text-emerald-600 dark:text-emerald-400 flex items-center justify-center font-bold font-mono text-sm mb-4 border border-emerald-100 dark:border-emerald-900/50">
            02
          </div>
          <h3 class="text-base font-semibold text-slate-900 dark:text-white mb-2">
            Configure Deduplication Rules
          </h3>
          <p class="text-sm text-slate-600 dark:text-slate-400 leading-relaxed">
            Choose your extraction mode (unique, duplicates only, count occurrences), normalize edge whitespace, ignore symbols, or sort alphabetically in real time.
          </p>
        </div>

        <!-- Step 3 -->
        <div class="p-6 rounded-2xl border border-slate-300 dark:border-slate-800 bg-white dark:bg-slate-900 shadow-sm hover:shadow-md hover:border-emerald-500/60 dark:hover:border-emerald-500/60 transition-all duration-150 relative">
          <div class="w-10 h-10 rounded-xl bg-emerald-50 dark:bg-emerald-950/40 text-emerald-600 dark:text-emerald-400 flex items-center justify-center font-bold font-mono text-sm mb-4 border border-emerald-100 dark:border-emerald-900/50">
            03
          </div>
          <h3 class="text-base font-semibold text-slate-900 dark:text-white mb-2">
            Format, Copy, or Download
          </h3>
          <p class="text-sm text-slate-600 dark:text-slate-400 leading-relaxed">
            Reformat output with instant commas, semicolons, or custom delimiters, then click <strong>Copy Result</strong> or download as a sanitized <strong>.txt</strong> file.
          </p>
        </div>

      </div>

    </div>
  </section>

  <!-- Why Choose FastToolVerse 6-Card Feature Grid Section -->
  <section class="border-t border-slate-200 dark:border-slate-800 bg-white dark:bg-slate-950 py-16 sm:py-20 font-sans">
    <div class="max-w-6xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="text-center max-w-2xl mx-auto mb-12">
        <h2 class="text-2xl sm:text-3xl font-bold tracking-tight text-slate-900 dark:text-white">
          Why Choose FastToolVerse
        </h2>
        <p class="mt-2 text-sm sm:text-base text-slate-600 dark:text-slate-400">
          Built for developer precision, complete data privacy, and instantaneous text deduplication.
        </p>
      </div>

      <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-5">
        <!-- Card 1 -->
        <div class="bg-slate-900/60 border border-slate-800/80 rounded-xl p-6">
          <div class="w-10 h-10 rounded-xl bg-emerald-50 dark:bg-emerald-950/50 text-emerald-600 dark:text-emerald-400 flex items-center justify-center mb-4 border border-emerald-100 dark:border-emerald-900/50">
            <ToolIcon name="shield-check" class="w-5 h-5" />
          </div>
          <h3 class="text-base font-semibold text-slate-900 dark:text-white mb-2">
            100% Client-Side Privacy
          </h3>
          <p class="text-xs sm:text-sm text-slate-600 dark:text-slate-400 leading-relaxed">
            All hashing and text parsing execute strictly inside your local browser memory sandbox. Zero bytes ever travel to any cloud server.
          </p>
        </div>

        <!-- Card 2 -->
        <div class="bg-slate-900/60 border border-slate-800/80 rounded-xl p-6">
          <div class="w-10 h-10 rounded-xl bg-emerald-50 dark:bg-emerald-950/50 text-emerald-600 dark:text-emerald-400 flex items-center justify-center mb-4 border border-emerald-100 dark:border-emerald-900/50">
            <ToolIcon name="zap" class="w-5 h-5" />
          </div>
          <h3 class="text-base font-semibold text-slate-900 dark:text-white mb-2">
            Instant 0ms RAM Processing
          </h3>
          <p class="text-xs sm:text-sm text-slate-600 dark:text-slate-400 leading-relaxed">
            Linear O(N) Hash Sets execute in microseconds. Eliminates server queues, network delays, and tedious page reloads.
          </p>
        </div>

        <!-- Card 3 -->
        <div class="bg-slate-900/60 border border-slate-800/80 rounded-xl p-6">
          <div class="w-10 h-10 rounded-xl bg-emerald-50 dark:bg-emerald-950/50 text-emerald-600 dark:text-emerald-400 flex items-center justify-center mb-4 border border-emerald-100 dark:border-emerald-900/50">
            <ToolIcon name="crop" class="w-5 h-5" />
          </div>
          <h3 class="text-base font-semibold text-slate-900 dark:text-white mb-2">
            Zero File &amp; Line Limits
          </h3>
          <p class="text-xs sm:text-sm text-slate-600 dark:text-slate-400 leading-relaxed">
            Deduplicate 50,000+ line server logs, database exports, or email lists without encountering paywalls, line caps, or subscription tiers.
          </p>
        </div>

        <!-- Card 4 -->
        <div class="bg-slate-900/60 border border-slate-800/80 rounded-xl p-6">
          <div class="w-10 h-10 rounded-xl bg-emerald-50 dark:bg-emerald-950/50 text-emerald-600 dark:text-emerald-400 flex items-center justify-center mb-4 border border-emerald-100 dark:border-emerald-900/50">
            <ToolIcon name="search" class="w-5 h-5" />
          </div>
          <h3 class="text-base font-semibold text-slate-900 dark:text-white mb-2">
            Case &amp; Whitespace Normalization
          </h3>
          <p class="text-xs sm:text-sm text-slate-600 dark:text-slate-400 leading-relaxed">
            Normalizes accidental trailing spaces, tabs, and mixed capitalization before hashing, preventing false-positive duplicate retention.
          </p>
        </div>

        <!-- Card 5 -->
        <div class="bg-slate-900/60 border border-slate-800/80 rounded-xl p-6">
          <div class="w-10 h-10 rounded-xl bg-emerald-50 dark:bg-emerald-950/50 text-emerald-600 dark:text-emerald-400 flex items-center justify-center mb-4 border border-emerald-100 dark:border-emerald-900/50">
            <ToolIcon name="code" class="w-5 h-5" />
          </div>
          <h3 class="text-base font-semibold text-slate-900 dark:text-white mb-2">
            Indentation &amp; Order Retention
          </h3>
          <p class="text-xs sm:text-sm text-slate-600 dark:text-slate-400 leading-relaxed">
            Preserves chronological input flow by default. Retains exact indentation formatting for Python source code, YAML configurations, and JSON.
          </p>
        </div>

        <!-- Card 6 -->
        <div class="bg-slate-900/60 border border-slate-800/80 rounded-xl p-6">
          <div class="w-10 h-10 rounded-xl bg-emerald-50 dark:bg-emerald-950/50 text-emerald-600 dark:text-emerald-400 flex items-center justify-center mb-4 border border-emerald-100 dark:border-emerald-900/50">
            <ToolIcon name="globe" class="w-5 h-5" />
          </div>
          <h3 class="text-base font-semibold text-slate-900 dark:text-white mb-2">
            Free Forever &amp; Offline Ready
          </h3>
          <p class="text-xs sm:text-sm text-slate-600 dark:text-slate-400 leading-relaxed">
            No accounts, passwords, or cookies required. Load the tool once and continue deduplicating text even with your internet connection disabled.
          </p>
        </div>
      </div>
    </div>
  </section>

  <!-- Popular Presets Directory Grid -->
  <PopularRemoveDuplicateLines />

  <!-- Feature Comparison Table Section -->
  <section class="border-t border-slate-200 dark:border-slate-800 bg-slate-50/50 dark:bg-slate-950/60 py-16 sm:py-24 font-sans">
    <div class="max-w-5xl mx-auto px-4 sm:px-6 lg:px-8">
      
      <div class="text-center max-w-2xl mx-auto mb-12 sm:mb-16">
        <h2 class="text-2xl sm:text-3xl font-bold tracking-tight text-slate-900 dark:text-white">
          Why Choose FastToolVerse List Deduplicator vs Cloud Tools
        </h2>
        <p class="mt-2 text-sm sm:text-base text-slate-600 dark:text-slate-400">
          Compare the absolute privacy, zero-lag Set execution, and offline reliability of FastToolVerse against remote server-based text utilities.
        </p>
      </div>

      <!-- Comparison Card / Table -->
      <div class="overflow-hidden rounded-2xl border border-slate-300 dark:border-slate-800 bg-white dark:bg-slate-900 shadow-sm">
        
        <!-- Table Header -->
        <div class="grid grid-cols-12 border-b border-slate-200 dark:border-slate-800 bg-slate-100/70 dark:bg-slate-900/90 text-xs sm:text-sm font-semibold text-slate-700 dark:text-slate-300">
          <div class="col-span-4 p-4 sm:p-5 flex items-center">
            <span>Feature / Capability</span>
          </div>
          <div class="col-span-4 p-4 sm:p-5 bg-emerald-50/60 dark:bg-emerald-950/30 border-x border-emerald-100 dark:border-emerald-900/40 text-emerald-700 dark:text-emerald-300 flex items-center justify-between">
            <span class="font-bold flex items-center gap-1.5">
              FastToolVerse
              <span class="hidden sm:inline-block px-2 py-0.5 text-[11px] font-medium bg-emerald-600 text-white rounded-full">Recommended</span>
            </span>
            <span class="text-xs text-emerald-600 dark:text-emerald-400 font-normal hidden md:inline">This Tool</span>
          </div>
          <div class="col-span-4 p-4 sm:p-5 text-slate-500 dark:text-slate-400 flex items-center">
            <span>Cloud &amp; Server Tools</span>
          </div>
        </div>

        <!-- Row 1: Privacy -->
        <div class="grid grid-cols-12 border-b border-slate-200 dark:border-slate-800/80 transition-colors hover:bg-slate-50/50 dark:hover:bg-slate-800/30">
          <div class="col-span-12 sm:col-span-4 p-4 sm:p-5 flex flex-col justify-center">
            <span class="font-semibold text-sm text-slate-900 dark:text-white">Data Privacy &amp; Confidentiality</span>
            <span class="text-xs text-slate-500 dark:text-slate-400 mt-0.5">Where your lists are processed</span>
          </div>
          <div class="col-span-6 sm:col-span-4 p-4 sm:p-5 bg-emerald-50/30 dark:bg-emerald-950/15 border-r sm:border-x border-emerald-100 dark:border-emerald-900/30 flex items-start gap-2.5">
            <div class="w-5 h-5 rounded-full bg-emerald-100 dark:bg-emerald-950/60 text-emerald-600 dark:text-emerald-400 flex items-center justify-center shrink-0 mt-0.5">
              <svg class="w-3 h-3" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="3"><path stroke-linecap="round" stroke-linejoin="round" d="M4.5 12.75l6 6 9-13.5" /></svg>
            </div>
            <div>
              <p class="text-xs sm:text-sm font-semibold text-emerald-700 dark:text-emerald-400">100% Client-Side In Browser</p>
              <p class="text-xs text-slate-600 dark:text-slate-400 mt-0.5 leading-relaxed">JavaScript Hash Sets process data locally in RAM. Zero network transmissions, no server logs, complete confidentiality.</p>
            </div>
          </div>
          <div class="col-span-6 sm:col-span-4 p-4 sm:p-5 flex items-start gap-2.5">
            <div class="w-5 h-5 rounded-full bg-rose-100 dark:bg-rose-950/60 text-rose-600 dark:text-rose-400 flex items-center justify-center shrink-0 mt-0.5">
              <svg class="w-3 h-3" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="3"><path stroke-linecap="round" stroke-linejoin="round" d="M6 18L18 6M6 6l12 12" /></svg>
            </div>
            <div>
              <p class="text-xs sm:text-sm font-medium text-slate-700 dark:text-slate-300">Server Upload Risks</p>
              <p class="text-xs text-slate-500 dark:text-slate-400 mt-0.5 leading-relaxed">Sends emails, customer databases, and proprietary lists over HTTP POST to unknown remote web servers.</p>
            </div>
          </div>
        </div>

        <!-- Row 2: Latency & Speed -->
        <div class="grid grid-cols-12 border-b border-slate-200 dark:border-slate-800/80 transition-colors hover:bg-slate-50/50 dark:hover:bg-slate-800/30">
          <div class="col-span-12 sm:col-span-4 p-4 sm:p-5 flex flex-col justify-center">
            <span class="font-semibold text-sm text-slate-900 dark:text-white">Deduplication Latency</span>
            <span class="text-xs text-slate-500 dark:text-slate-400 mt-0.5">Execution speed on large files</span>
          </div>
