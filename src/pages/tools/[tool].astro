---
import Layout from '../../layouts/Layout.astro';
import ToolIcon from '../../components/ToolIcon.astro';
import { TOOLS, TEXT_TOOLS, type Tool, type TextTool } from '../../data/tools';

export interface Props {
  toolSlug: string;
  toolName: string;
  category: string;
  description: string;
  icon: string;
  tags: string[];
}

export async function getStaticPaths() {
  // 1. Identify static tool pages that are already built to avoid route collisions
  const staticFiles = import.meta.glob('./*.astro', { eager: true });
  const builtSlugs = new Set<string>(
    Object.keys(staticFiles)
      .map((path) => path.replace(/^\.\//, '').replace(/\.astro$/, ''))
      .filter((s) => !s.startsWith('[') && !s.endsWith(']'))
  );

  // Explicit safety fallback for known built pages
  builtSlugs.add('image-resizer');
  builtSlugs.add('remove-duplicate-lines');
  builtSlugs.add('remove-empty-lines');
  builtSlugs.add('remove-extra-spaces');
  builtSlugs.add('remove-line-breaks');
  builtSlugs.add('sort-text-lines');

  // 2. Acronym helper for clean slug-to-title conversion
  const acronyms: Record<string, string> = {
    json: 'JSON',
    jwt: 'JWT',
    uuid: 'UUID',
    url: 'URL',
    html: 'HTML',
    css: 'CSS',
    js: 'JS',
    exif: 'EXIF',
    rgb: 'RGB',
    hex: 'HEX',
    cmyk: 'CMYK',
    dpi: 'DPI',
    ppi: 'PPI',
    svg: 'SVG',
    png: 'PNG',
    jpg: 'JPG',
    jpeg: 'JPEG',
    webp: 'WebP',
    avif: 'AVIF',
    gif: 'GIF',
    dp: 'DP',
    qa: 'QA',
    bd: 'BD'
  };

  const specialTitles: Record<string, string> = {
    'passport-size-maker': 'Passport Size Maker',
    'passport-size': 'Passport Size Maker',
    'image-compressor': 'Image Compressor',
    'image-cropper': 'Image Cropper',
    'image-rotator': 'Image Rotator',
    'image-flipper': 'Image Flipper',
    'image-converter': 'Image Converter',
    'image-optimizer': 'Image Optimizer',
    'aspect-ratio-calculator': 'Aspect Ratio Calculator',
    'image-dimensions-calculator': 'Image Dimensions Calculator',
    'add-watermark': 'Add Watermark',
    'color-picker-from-image': 'Color Picker from Image',
    'json-formatter': 'JSON Formatter',
    'json-validator': 'JSON Validator',
    'json-minifier': 'JSON Minifier',
    'base64-encoder': 'Base64 Encoder',
    'base64-decoder': 'Base64 Decoder',
    'url-encoder': 'URL Encoder',
    'url-decoder': 'URL Decoder',
    'uuid-generator': 'UUID Generator',
    'timestamp-converter': 'Timestamp Converter',
    'unix-timestamp-converter': 'Unix Timestamp Converter',
    'regex-tester': 'Regex Tester',
    'jwt-decoder': 'JWT Decoder',
    'html-formatter': 'HTML Formatter',
    'css-minifier': 'CSS Minifier',
    'js-minifier': 'JS Minifier',
    'color-converter': 'Color Converter',
    'text-case-converter': 'Text Case Converter',
    'find-and-replace-text': 'Find & Replace Text',
    'add-prefix-suffix': 'Add Prefix & Suffix',
    'remove-special-characters': 'Remove Special Characters',
    'text-to-slug-converter': 'Text to Slug Converter'
  };

  function slugToTitle(slug: string): string {
    if (specialTitles[slug]) return specialTitles[slug];
    const cleanSlug = slug.replace(/\/+$/, '');
    const foundTool =
      TOOLS.find((t) => t.id === cleanSlug || t.href.replace(/^\/tools\//, '').replace(/\/+$/, '') === cleanSlug) ||
      TEXT_TOOLS.find((t) => t.id === cleanSlug || t.href.replace(/^\/tools\//, '').replace(/\/+$/, '') === cleanSlug);
    if (foundTool) return foundTool.title;

    return cleanSlug
      .split('-')
      .map((part) => acronyms[part.toLowerCase()] || (part.charAt(0).toUpperCase() + part.slice(1).toLowerCase()))
      .join(' ');
  }

  // 3. Collect all unique pending tool slugs from TOOLS, TEXT_TOOLS, and required routes
  const slugCandidates = new Set<string>();

  // Add all tools from data
  TOOLS.forEach((t) => {
    if (t.href.startsWith('/tools/')) {
      const slug = t.href.replace(/^\/tools\//, '').replace(/\/+$/, '');
      if (slug) slugCandidates.add(slug);
    }
    slugCandidates.add(t.id);
  });

  TEXT_TOOLS.forEach((t) => {
    if (t.href.startsWith('/tools/')) {
      const slug = t.href.replace(/^\/tools\//, '').replace(/\/+$/, '');
      if (slug) slugCandidates.add(slug);
    }
    slugCandidates.add(t.id);
  });

  // Explicitly ensure user-requested & pending routes are registered
  const pendingToolSlugs = [
    'image-compressor',
    'image-cropper',
    'image-rotator',
    'image-flipper',
    'passport-size-maker',
    'passport-size',
    'image-converter',
    'image-optimizer',
    'aspect-ratio-calculator',
    'image-dimensions-calculator',
    'add-watermark',
    'exif-viewer',
    'color-picker-from-image',
    'json-formatter',
    'json-validator',
    'json-minifier',
    'base64-encoder',
    'base64-decoder',
    'url-encoder',
    'url-decoder',
    'uuid-generator',
    'timestamp-converter',
    'unix-timestamp-converter',
    'regex-tester',
    'jwt-decoder',
    'html-formatter',
    'css-minifier',
    'js-minifier',
    'color-converter',
    'text-case-converter',
    'find-and-replace-text',
    'add-prefix-suffix',
    'remove-special-characters',
    'text-to-slug-converter'
  ];

  pendingToolSlugs.forEach((s) => slugCandidates.add(s));

  // 4. Filter out any already built tools to prevent route collision
  const targetSlugs = Array.from(slugCandidates).filter((slug) => !builtSlugs.has(slug));

  return targetSlugs.map((slug) => {
    const matchedTool =
      TOOLS.find((t) => t.id === slug || t.href.replace(/^\/tools\//, '').replace(/\/+$/, '') === slug) ||
      (TEXT_TOOLS.find((t) => t.id === slug || t.href.replace(/^\/tools\//, '').replace(/\/+$/, '') === slug) as unknown as Tool | undefined);

    const title = slugToTitle(slug);
    const category = matchedTool?.category || (slug.includes('image') || slug.includes('photo') ? 'Image Tools' : 'Developer Tools');
    const description =
      matchedTool?.description ||
      `Fast, private, client-side ${title} with zero server uploads and instant hardware-accelerated processing in your web browser.`;
    const icon = matchedTool?.icon || (category === 'Image Tools' ? 'image' : 'code');
    const tags = matchedTool?.tags || ['Client-Side', 'Zero Upload', 'Fast Engine'];

    return {
      params: { tool: slug },
      props: {
        toolSlug: slug,
        toolName: title,
        category,
        description,
        icon,
        tags
      }
    };
  });
}

const { toolSlug, toolName, category, description, icon, tags } = Astro.props as Props;

const pageTitle = `${toolName} - FastToolVerse Online Utility`;
const pageDescription = `Use the free, private, client-side ${toolName} on FastToolVerse. Zero server uploads, instant in-browser processing.`;
const canonicalUrl = `https://fasttoolverse.com/tools/${toolSlug}`;

// Schema.org SoftwareApplication structured data
const jsonLd = {
  "@context": "https://schema.org",
  "@graph": [
    {
      "@type": "SoftwareApplication",
      "name": toolName,
      "operatingSystem": "All (Web Browser)",
      "applicationCategory": "UtilitiesApplication",
      "url": canonicalUrl,
      "description": pageDescription,
      "offers": {
        "@type": "Offer",
        "price": "0",
        "priceCurrency": "USD"
      },
      "featureList": [
        "100% In-Browser Privacy — Zero server uploads",
        "Instant Zero-Latency Execution Engine",
        "Batch Processing Ready Presets"
      ]
    },
    {
      "@type": "BreadcrumbList",
      "itemListElement": [
        {
          "@type": "ListItem",
          "position": 1,
          "name": "Home",
          "item": "https://fasttoolverse.com"
        },
        {
          "@type": "ListItem",
          "position": 2,
          "name": "Tools",
          "item": "https://fasttoolverse.com/#all-tools"
        },
        {
          "@type": "ListItem",
          "position": 3,
          "name": toolName,
          "item": canonicalUrl
        }
      ]
    }
  ]
};
---

<Layout
  title={pageTitle}
  description={pageDescription}
  canonicalUrl={canonicalUrl}
>
  <script type="application/ld+json" set:html={JSON.stringify(jsonLd)} />

  <main class="relative min-h-[82vh] overflow-hidden pt-8 pb-20 sm:pt-14 sm:pb-24">
    <!-- Ambient Backdrop Mesh Glow -->
    <div class="hero-mesh-bg pointer-events-none" aria-hidden="true"></div>
    <div class="absolute inset-0 pointer-events-none -z-10 flex items-center justify-center">
      <div class="w-[600px] h-[600px] bg-blue-500/10 dark:bg-blue-600/10 rounded-full blur-3xl -translate-y-20"></div>
      <div class="w-[450px] h-[450px] bg-indigo-500/10 dark:bg-purple-600/10 rounded-full blur-3xl translate-x-28"></div>
    </div>

    <div class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8 text-center">
      <!-- Breadcrumb Navigation -->
      <nav class="flex items-center justify-center gap-2 text-xs font-mono text-slate-500 dark:text-slate-400 mb-6" aria-label="Breadcrumb">
        <a href="/" class="hover:text-slate-900 dark:hover:text-white transition-colors">Home</a>
        <span class="text-slate-300 dark:text-slate-600">/</span>
        <a href="/#all-tools" class="hover:text-slate-900 dark:hover:text-white transition-colors">{category}</a>
        <span class="text-slate-300 dark:text-slate-600">/</span>
        <span class="text-slate-700 dark:text-slate-200 font-semibold truncate max-w-[200px] sm:max-w-none">{toolName}</span>
      </nav>

      <!-- Coming Very Soon Eyebrow -->
      <div class="mb-3">
        <span class="text-amber-400 font-semibold tracking-wider uppercase text-sm sm:text-base">Coming Very Soon</span>
      </div>

      <!-- Main Heading & Tool Icon -->
      <div class="flex flex-col items-center justify-center gap-4 mb-4">
        <div class="w-14 h-14 sm:w-16 sm:h-16 rounded-2xl bg-gradient-to-br from-blue-500/10 via-indigo-500/10 to-purple-500/10 dark:from-blue-500/20 dark:to-purple-500/20 border border-blue-500/20 dark:border-blue-400/30 text-blue-600 dark:text-blue-400 flex items-center justify-center shadow-sm">
          <ToolIcon name={icon} class="w-7 h-7 sm:w-8 sm:h-8" />
        </div>
        <h1 class="text-3xl sm:text-4xl md:text-5xl font-extrabold tracking-tight text-slate-900 dark:text-white">
          {toolName} is Launching Soon
        </h1>
      </div>

      <!-- Subtitle -->
      <p class="text-base sm:text-lg text-slate-600 dark:text-slate-300 max-w-2xl mx-auto leading-relaxed mb-8">
        We are actively building this high-speed, 100% private browser tool. It will be available here very soon.
      </p>

      <!-- Fast Action CTAs Directly Below Heading -->
      <div class="flex flex-col sm:flex-row items-center justify-center gap-3.5 mb-14">
        <a
          href="/tools/image-resizer"
          class="w-full sm:w-auto inline-flex items-center justify-center gap-2 px-6 py-3.5 rounded-xl bg-blue-600 hover:bg-blue-700 text-white font-semibold text-sm sm:text-base shadow-sm hover:shadow transition-all duration-200"
        >
          <span>Use Free Image Resizer Now &rarr;</span>
        </a>
        <a
          href="/"
          class="w-full sm:w-auto inline-flex items-center justify-center gap-2 px-6 py-3.5 rounded-xl bg-white dark:bg-slate-800 border border-slate-200 dark:border-slate-700 text-slate-800 dark:text-slate-200 hover:bg-slate-100 dark:hover:bg-slate-700 font-medium text-sm sm:text-base transition-all duration-200"
        >
          <span>Back to Home</span>
        </a>
      </div>

      <!-- Expected Core Capabilities (Dynamic Grid of 3 Cards) -->
      <div class="grid grid-cols-1 md:grid-cols-3 gap-5 text-left mb-12">
        <!-- Card 1: 100% In-Browser Privacy -->
        <div class="p-6 rounded-2xl bg-white/70 dark:bg-slate-800/60 border border-slate-200/80 dark:border-slate-700/80 backdrop-blur-md shadow-xs hover:border-blue-500/50 dark:hover:border-blue-400/50 transition-all duration-200 group">
          <div class="w-10 h-10 rounded-xl bg-emerald-500/10 dark:bg-emerald-400/10 text-emerald-600 dark:text-emerald-400 flex items-center justify-center mb-4 group-hover:scale-105 transition-transform">
            <ToolIcon name="shield-check" class="w-5 h-5" />
          </div>
          <h3 class="text-base font-bold text-slate-900 dark:text-white mb-2">
            100% In-Browser Privacy
          </h3>
          <p class="text-sm text-slate-600 dark:text-slate-400 leading-relaxed">
            Client-side execution without external server calls. Your files and private data never touch remote servers.
          </p>
        </div>

        <!-- Card 2: Instant Zero-Latency Engine -->
        <div class="p-6 rounded-2xl bg-white/70 dark:bg-slate-800/60 border border-slate-200/80 dark:border-slate-700/80 backdrop-blur-md shadow-xs hover:border-blue-500/50 dark:hover:border-blue-400/50 transition-all duration-200 group">
          <div class="w-10 h-10 rounded-xl bg-blue-500/10 dark:bg-blue-400/10 text-blue-600 dark:text-blue-400 flex items-center justify-center mb-4 group-hover:scale-105 transition-transform">
            <ToolIcon name="zap" class="w-5 h-5" />
          </div>
          <h3 class="text-base font-bold text-slate-900 dark:text-white mb-2">
            Instant Zero-Latency Engine
          </h3>
          <p class="text-sm text-slate-600 dark:text-slate-400 leading-relaxed">
            Hardware-accelerated processing right inside your browser. Experience zero upload wait times or queuing bottlenecks.
          </p>
        </div>

        <!-- Card 3: Batch Processing Ready -->
        <div class="p-6 rounded-2xl bg-white/70 dark:bg-slate-800/60 border border-slate-200/80 dark:border-slate-700/80 backdrop-blur-md shadow-xs hover:border-blue-500/50 dark:hover:border-blue-400/50 transition-all duration-200 group">
          <div class="w-10 h-10 rounded-xl bg-purple-500/10 dark:bg-purple-400/10 text-purple-600 dark:text-purple-400 flex items-center justify-center mb-4 group-hover:scale-105 transition-transform">
            <ToolIcon name="repeat" class="w-5 h-5" />
          </div>
          <h3 class="text-base font-bold text-slate-900 dark:text-white mb-2">
            Batch Processing Ready
          </h3>
          <p class="text-sm text-slate-600 dark:text-slate-400 leading-relaxed">
            Pre-configured presets and high-throughput workflows. Designed to handle individual tasks and multi-file queues effortlessly.
          </p>
        </div>
      </div>

      <!-- Quick Links to Popular Presets -->
      <div class="p-6 sm:p-8 rounded-3xl bg-gradient-to-b from-slate-50 to-white dark:from-slate-800/80 dark:to-slate-900/90 border border-slate-200 dark:border-slate-700/80 shadow-md mb-10 text-center">
        <div class="text-xs font-mono uppercase tracking-wider text-slate-500 dark:text-slate-400 font-semibold mb-3">
          Popular Pre-Configured Presets
        </div>
          <div class="flex flex-wrap items-center justify-center gap-2">
            <a
              href="/resize-image-to-300x100"
              class="inline-flex items-center gap-1.5 px-3 py-1.5 rounded-lg bg-slate-100 dark:bg-slate-800 hover:bg-blue-50 dark:hover:bg-blue-950/40 text-slate-700 dark:text-slate-300 hover:text-blue-600 dark:hover:text-blue-400 border border-slate-200/80 dark:border-slate-700 text-xs font-medium transition-colors"
            >
              <span>300x100</span>
              <span class="text-slate-400">&rarr;</span>
            </a>
            <a
              href="/resize-image-to-20kb"
              class="inline-flex items-center gap-1.5 px-3 py-1.5 rounded-lg bg-slate-100 dark:bg-slate-800 hover:bg-blue-50 dark:hover:bg-blue-950/40 text-slate-700 dark:text-slate-300 hover:text-blue-600 dark:hover:text-blue-400 border border-slate-200/80 dark:border-slate-700 text-xs font-medium transition-colors"
            >
              <span>20KB Target</span>
              <span class="text-slate-400">&rarr;</span>
            </a>
            <a
              href="/passport-size-photo-2x2-inch"
              class="inline-flex items-center gap-1.5 px-3 py-1.5 rounded-lg bg-slate-100 dark:bg-slate-800 hover:bg-blue-50 dark:hover:bg-blue-950/40 text-slate-700 dark:text-slate-300 hover:text-blue-600 dark:hover:text-blue-400 border border-slate-200/80 dark:border-slate-700 text-xs font-medium transition-colors"
            >
              <span>Passport 2x2</span>
              <span class="text-slate-400">&rarr;</span>
            </a>
            <a
              href="/resize-image-to-50kb"
              class="inline-flex items-center gap-1.5 px-3 py-1.5 rounded-lg bg-slate-100 dark:bg-slate-800 hover:bg-blue-50 dark:hover:bg-blue-950/40 text-slate-700 dark:text-slate-300 hover:text-blue-600 dark:hover:text-blue-400 border border-slate-200/80 dark:border-slate-700 text-xs font-medium transition-colors"
            >
              <span>50KB Target</span>
              <span class="text-slate-400">&rarr;</span>
            </a>
            <a
              href="/resize-image-for-instagram-post"
              class="inline-flex items-center gap-1.5 px-3 py-1.5 rounded-lg bg-slate-100 dark:bg-slate-800 hover:bg-blue-50 dark:hover:bg-blue-950/40 text-slate-700 dark:text-slate-300 hover:text-blue-600 dark:hover:text-blue-400 border border-slate-200/80 dark:border-slate-700 text-xs font-medium transition-colors"
            >
              <span>Instagram Post</span>
              <span class="text-slate-400">&rarr;</span>
            </a>
            <a
              href="/image-resizer-for-youtube-banner"
              class="inline-flex items-center gap-1.5 px-3 py-1.5 rounded-lg bg-slate-100 dark:bg-slate-800 hover:bg-blue-50 dark:hover:bg-blue-950/40 text-slate-700 dark:text-slate-300 hover:text-blue-600 dark:hover:text-blue-400 border border-slate-200/80 dark:border-slate-700 text-xs font-medium transition-colors"
            >
              <span>YouTube Banner</span>
              <span class="text-slate-400">&rarr;</span>
            </a>
          </div>
        </div>

      <!-- Live Active Text & Utility Tools Grid -->
      <div class="text-left">
        <div class="flex items-center justify-between mb-4">
          <h3 class="text-sm font-mono uppercase tracking-wider font-semibold text-slate-800 dark:text-slate-200">
            Active Online Tools Ready Right Now
          </h3>
          <a href="/#all-tools" class="text-xs text-blue-600 dark:text-blue-400 hover:underline font-medium">
            View directory &rarr;
          </a>
        </div>
        <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-3">
          <a
            href="/tools/image-resizer"
            class="flex items-start gap-3 p-3.5 rounded-xl bg-white dark:bg-slate-800/70 border border-slate-200/80 dark:border-slate-700/80 hover:border-blue-500/50 dark:hover:border-blue-400/50 hover:shadow-xs transition-all group"
          >
            <div class="w-8 h-8 rounded-lg bg-blue-500/10 text-blue-600 dark:text-blue-400 flex items-center justify-center shrink-0 group-hover:scale-105 transition-transform">
              <ToolIcon name="maximize-2" class="w-4 h-4" />
            </div>
            <div class="min-w-0">
              <div class="text-sm font-semibold text-slate-900 dark:text-white group-hover:text-blue-600 dark:group-hover:text-blue-400 transition-colors">
                Image Resizer
              </div>
              <p class="text-xs text-slate-500 dark:text-slate-400 line-clamp-1">
                Resize, crop, and compress JPG, PNG, and WebP.
              </p>
            </div>
          </a>

          <a
            href="/tools/remove-extra-spaces"
            class="flex items-start gap-3 p-3.5 rounded-xl bg-white dark:bg-slate-800/70 border border-slate-200/80 dark:border-slate-700/80 hover:border-purple-500/50 dark:hover:border-purple-400/50 hover:shadow-xs transition-all group"
          >
            <div class="w-8 h-8 rounded-lg bg-purple-500/10 text-purple-600 dark:text-purple-400 flex items-center justify-center shrink-0 group-hover:scale-105 transition-transform">
              <ToolIcon name="space" class="w-4 h-4" />
            </div>
            <div class="min-w-0">
              <div class="text-sm font-semibold text-slate-900 dark:text-white group-hover:text-purple-600 dark:group-hover:text-purple-400 transition-colors">
                Remove Extra Spaces
              </div>
              <p class="text-xs text-slate-500 dark:text-slate-400 line-clamp-1">
                Strip consecutive spaces, tabs, and line margins.
              </p>
            </div>
          </a>

          <a
            href="/tools/remove-duplicate-lines"
            class="flex items-start gap-3 p-3.5 rounded-xl bg-white dark:bg-slate-800/70 border border-slate-200/80 dark:border-slate-700/80 hover:border-purple-500/50 dark:hover:border-purple-400/50 hover:shadow-xs transition-all group"
          >
            <div class="w-8 h-8 rounded-lg bg-purple-500/10 text-purple-600 dark:text-purple-400 flex items-center justify-center shrink-0 group-hover:scale-105 transition-transform">
              <ToolIcon name="list-filter" class="w-4 h-4" />
            </div>
            <div class="min-w-0">
              <div class="text-sm font-semibold text-slate-900 dark:text-white group-hover:text-purple-600 dark:group-hover:text-purple-400 transition-colors">
                Remove Duplicate Lines
              </div>
              <p class="text-xs text-slate-500 dark:text-slate-400 line-clamp-1">
                Deduplicate lines while keeping source line order.
              </p>
            </div>
          </a>

          <a
            href="/tools/remove-empty-lines"
            class="flex items-start gap-3 p-3.5 rounded-xl bg-white dark:bg-slate-800/70 border border-slate-200/80 dark:border-slate-700/80 hover:border-purple-500/50 dark:hover:border-purple-400/50 hover:shadow-xs transition-all group"
          >
            <div class="w-8 h-8 rounded-lg bg-purple-500/10 text-purple-600 dark:text-purple-400 flex items-center justify-center shrink-0 group-hover:scale-105 transition-transform">
              <ToolIcon name="list-x" class="w-4 h-4" />
            </div>
            <div class="min-w-0">
              <div class="text-sm font-semibold text-slate-900 dark:text-white group-hover:text-purple-600 dark:group-hover:text-purple-400 transition-colors">
                Remove Empty Lines
              </div>
              <p class="text-xs text-slate-500 dark:text-slate-400 line-clamp-1">
                Purge whitespace-only and blank lines instantly.
              </p>
            </div>
          </a>

          <a
            href="/tools/sort-text-lines"
            class="flex items-start gap-3 p-3.5 rounded-xl bg-white dark:bg-slate-800/70 border border-slate-200/80 dark:border-slate-700/80 hover:border-purple-500/50 dark:hover:border-purple-400/50 hover:shadow-xs transition-all group"
          >
            <div class="w-8 h-8 rounded-lg bg-purple-500/10 text-purple-600 dark:text-purple-400 flex items-center justify-center shrink-0 group-hover:scale-105 transition-transform">
              <ToolIcon name="arrow-up-down" class="w-4 h-4" />
            </div>
            <div class="min-w-0">
              <div class="text-sm font-semibold text-slate-900 dark:text-white group-hover:text-purple-600 dark:group-hover:text-purple-400 transition-colors">
                Sort Text Lines
              </div>
              <p class="text-xs text-slate-500 dark:text-slate-400 line-clamp-1">
                Sort alphabetical A-Z, reverse Z-A, and by length.
              </p>
            </div>
          </a>

          <a
            href="/tools/remove-line-breaks"
            class="flex items-start gap-3 p-3.5 rounded-xl bg-white dark:bg-slate-800/70 border border-slate-200/80 dark:border-slate-700/80 hover:border-purple-500/50 dark:hover:border-purple-400/50 hover:shadow-xs transition-all group"
          >
            <div class="w-8 h-8 rounded-lg bg-purple-500/10 text-purple-600 dark:text-purple-400 flex items-center justify-center shrink-0 group-hover:scale-105 transition-transform">
              <ToolIcon name="wrap-text" class="w-4 h-4" />
            </div>
            <div class="min-w-0">
              <div class="text-sm font-semibold text-slate-900 dark:text-white group-hover:text-purple-600 dark:group-hover:text-purple-400 transition-colors">
                Remove Line Breaks
              </div>
              <p class="text-xs text-slate-500 dark:text-slate-400 line-clamp-1">
                Merge lines into clean paragraphs or custom joins.
              </p>
            </div>
          </a>
        </div>
      </div>
    </div>
  </main>
</Layout>
