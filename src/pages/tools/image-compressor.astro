---
import Layout from '../../layouts/Layout.astro';
import ToolIcon from '../../components/ToolIcon.astro';
import ImageCompressor from '../../components/tools/ImageCompressor.astro';
import { COMPRESS_PRESETS } from '../../data/compressPresets';

// FAQ Content for Schema and UI (8 Technically Sound Questions)
const faqs = [
  {
    question: "How does the Target KB binary search convergence loop work?",
    answer: "Rather than guessing with trial-and-error visual sliders, our client-side binary search algorithm sets quality boundaries between 5% and 98%. In each pass, it encodes the canvas to a candidate blob in memory and measures the byte size against your target limit. If the file exceeds your boundary, it halves the search interval downwards; if smaller, it explores higher quality. If raw resolution is too dense for the requested kilobyte cap, it automatically downscales dimensions proportionally to ensure guaranteed portal compliance."
  },
  {
    question: "How to compress an image to an exact file size like 20 KB or 50 KB?",
    answer: "Enter your required size (e.g., 20 KB or 50 KB) in the Target Max File Size field, or click one of the quick KB presets. FastToolVerse initiates a client-side binary search loop that dynamically calculates the optimal quantization matrix in up to 7 iterative passes and synchronizes the quality slider automatically, guaranteeing your file stays strictly under the target threshold while retaining peak visual clarity."
  },
  {
    question: "What is the difference between lossy and lossless image compression?",
    answer: "Lossy compression (used in JPG and WebP) permanently discards high-frequency pixel data and color nuances imperceptible to human eyes using Discrete Cosine Transform (DCT) and chroma subsampling, achieving 60% to 90% size reductions. Lossless compression (used in PNG and lossless WebP) reorganizes data patterns via DEFLATE or predictive filtering without discarding any pixel data, maintaining 100% mathematical fidelity."
  },
  {
    question: "Does this tool upload or store my confidential photos on any server?",
    answer: "No. FastToolVerse operates under a strict zero-upload architecture. Your sensitive government identity cards, passport photos, academic transcripts, signatures, and personal photos never leave your device. All compression algorithms execute inside your local browser memory heap. The tool works seamlessly even if you disconnect your device from the internet."
  },
  {
    question: "How do I compress PNG images without losing transparent backgrounds?",
    answer: "PNG supports 8-bit alpha channels for transparency. When compressing PNGs, FastToolVerse preserves the transparent background channels. You can export in optimized PNG mode or convert to WebP, which supports transparent alpha channels while delivering 30% to 50% smaller file sizes than standard PNG."
  },
  {
    question: "Why do government job and passport portals require strict 20KB or 50KB limits?",
    answer: "Official government portals, exam boards, and visa registration systems handle millions of applicant submissions. Rigid file limits (typically 20KB to 50KB) conserve server storage, minimize database bandwidth, and ensure instantaneous loading across rural connections. FastToolVerse is calibrated specifically to satisfy these strict administrative limits."
  },
  {
    question: "Does compressing images strip EXIF metadata (GPS, camera model)?",
    answer: "Yes. By default, stripping EXIF metadata is enabled. Re-encoding through the HTML5 Canvas sandbox automatically removes embedded camera metadata, GPS coordinates, date stamps, and color management profiles, preserving your personal privacy and saving an additional 5 KB to 30 KB of overhead."
  },
  {
    question: "Can I compress multiple images simultaneously and download a ZIP file?",
    answer: "Yes. You can upload up to 15 images concurrently. FastToolVerse compresses each photo in parallel queues and provides instant single-file downloads or a 1-click 'Download All as ZIP' archive generated directly in your browser using client-side JSZip."
  }
];

// Schema.org WebApplication
const jsonLdSoftwareApp = {
  "@context": "https://schema.org",
  "@type": "WebApplication",
  "name": "Free Online Image Compressor & Exact KB Reducer",
  "url": "https://fasttoolverse.com/tools/image-compressor",
  "applicationCategory": "MultimediaApplication",
  "operatingSystem": "All (Web Browser)",
  "browserRequirements": "Requires JavaScript. Requires HTML5 Canvas support.",
  "offers": {
    "@type": "Offer",
    "price": "0",
    "priceCurrency": "USD"
  },
  "featureList": [
    "100% Client-Side Sandbox Privacy",
    "Target Exact File Size in KB (20KB, 50KB, 100KB, 200KB)",
    "Automated Binary Search Compression Loop",
    "Visual Quality Slider with Live Before/After Split Comparison",
    "Batch Compression up to 15 Files",
    "Export to JPG, PNG, and WebP",
    "Automated EXIF Metadata Stripping",
    "1-Click Batch ZIP Download"
  ]
};

// Schema.org FAQPage
const jsonLdFaq = {
  "@context": "https://schema.org",
  "@type": "FAQPage",
  "mainEntity": faqs.map((f) => ({
    "@type": "Question",
    "name": f.question,
    "acceptedAnswer": {
      "@type": "Answer",
      "text": f.answer
    }
  }))
};

const canonicalUrl = "https://fasttoolverse.com/tools/image-compressor";
const pageTitle = "Free Online Image Compressor & Exact KB Reducer | FastToolVerse";
const pageDescription = "Compress JPG, PNG, and WebP images by percentage or target exact file sizes (20 KB, 50 KB, 100 KB) with 100% in-browser privacy and zero server uploads.";
const pageKeywords = "image compressor, reduce image size in kb, compress image to 20kb, compress image to 50kb, compress image to 100kb, batch image compressor, client-side image compressor, online photo compressor, lossy lossless compressor, webp compressor, image kb reducer";
const ogImage = "https://fasttoolverse.com/og-image.png";
---

<Layout
  title={pageTitle}
  description={pageDescription}
  canonicalUrl={canonicalUrl}
  image={ogImage}
>
  <!-- Injected Head Elements: Twitter name tags & JSON-LD Schemas -->
  <Fragment slot="head">
    <meta name="keywords" content={pageKeywords} />

    <!-- Open Graph tags -->
    <meta property="og:type" content="website" />
    <meta property="og:url" content={canonicalUrl} />
    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={pageDescription} />
    <meta property="og:image" content={ogImage} />

    <!-- Twitter Card Name Standards -->
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:url" content={canonicalUrl} />
    <meta name="twitter:title" content={pageTitle} />
    <meta name="twitter:description" content={pageDescription} />
    <meta name="twitter:image" content={ogImage} />

    <!-- Structured Data Schemas -->
    <script type="application/ld+json" set:html={JSON.stringify(jsonLdSoftwareApp)} />
    <script type="application/ld+json" set:html={JSON.stringify(jsonLdFaq)} />
  </Fragment>

  <!-- 1. Hero Header Section -->
  <section class="relative pt-12 pb-6 sm:pt-16 sm:pb-8 overflow-hidden">
    <div class="hero-mesh-bg" aria-hidden="true"></div>

    <div class="relative max-w-5xl mx-auto px-4 sm:px-6 lg:px-8 text-center">
      <!-- Hero Title -->
      <h1 class="text-3xl sm:text-4xl md:text-5xl font-bold tracking-tight text-slate-900 dark:text-white">
        Free Online Image Compressor &amp; Exact KB Reducer
      </h1>

      <!-- Subtitle -->
      <p class="mt-3 sm:mt-4 text-base sm:text-lg text-slate-600 dark:text-slate-400 max-w-2xl mx-auto leading-relaxed">
        Compress JPG, PNG, and WebP images by percentage or target exact file sizes (20 KB, 50 KB, 100 KB) with 100% in-browser privacy.
      </p>
    </div>
  </section>

  <!-- 2. Interactive Studio Container -->
  <section id="tool-workspace" class="max-w-6xl mx-auto px-4 sm:px-6 lg:px-8 pb-16 sm:pb-24 scroll-mt-20">
    <ImageCompressor />

    <div class="bg-slate-900/60 border border-slate-800 rounded-xl p-5 md:p-6 text-slate-300 text-sm md:text-base leading-relaxed max-w-4xl mx-auto my-6">
      <p>
        Meet strict upload limits and rigid portal constraints with automated kilobyte optimization. When applying for government examinations, university admissions, or professional recruitment, file size caps like 20 KB, 50 KB, or 100 KB are non-negotiable. Our in-browser quantization engine uses iterative binary search convergence to compress your images to exact byte budgets while guarding against muddy gradients, pixelation, and text blurring—ensuring compliant submissions without cloud data exposure.
      </p>
    </div>
  </section>

  <!-- 3. 3-Step Guide Section -->
  <section class="border-t border-slate-200 dark:border-slate-800 bg-slate-50/50 dark:bg-slate-900/40 py-16 sm:py-20">
    <div class="max-w-5xl mx-auto px-4 sm:px-6 lg:px-8">
      
      <div class="text-center max-w-2xl mx-auto mb-12">
        <h2 class="text-2xl sm:text-3xl font-bold tracking-tight text-slate-900 dark:text-white">
          How to Compress Images to Target KB in 3 Steps
        </h2>
        <p class="mt-2 text-sm sm:text-base text-slate-600 dark:text-slate-400">
          Fast, effortless, and private. Hit exact kilobyte boundaries directly in your browser in seconds.
        </p>
      </div>

      <div class="grid grid-cols-1 md:grid-cols-3 gap-6 sm:gap-8">
        
        <!-- Step 1 -->
        <div class="p-6 rounded-2xl border border-slate-300 dark:border-slate-800 bg-white dark:bg-slate-900 shadow-sm hover:shadow-md hover:border-blue-600 transition-all duration-150 relative">
          <div class="w-10 h-10 rounded-xl bg-blue-50 dark:bg-blue-950/40 text-blue-600 dark:text-blue-400 flex items-center justify-center font-bold font-mono text-sm mb-4 border border-blue-100 dark:border-blue-900/50">
            01
          </div>
          <h3 class="text-base font-semibold text-slate-900 dark:text-white mb-2">
            Upload or Paste Photos
          </h3>
          <p class="text-sm text-slate-600 dark:text-slate-400 leading-relaxed">
            Drag and drop up to 15 JPG, PNG, WebP, or AVIF files, browse your local drive, or paste from clipboard using <kbd class="px-1.5 py-0.5 text-xs font-mono bg-slate-100 dark:bg-slate-800 rounded border border-slate-200 dark:border-slate-700">Ctrl+V</kbd>. Zero files ever leave your machine.
          </p>
        </div>

        <!-- Step 2 -->
        <div class="p-6 rounded-2xl border border-slate-300 dark:border-slate-800 bg-white dark:bg-slate-900 shadow-sm hover:shadow-md hover:border-blue-600 transition-all duration-150 relative">
          <div class="w-10 h-10 rounded-xl bg-blue-50 dark:bg-blue-950/40 text-blue-600 dark:text-blue-400 flex items-center justify-center font-bold font-mono text-sm mb-4 border border-blue-100 dark:border-blue-900/50">
            02
          </div>
          <h3 class="text-base font-semibold text-slate-900 dark:text-white mb-2">
            Set Target KB or Quality
          </h3>
          <p class="text-sm text-slate-600 dark:text-slate-400 leading-relaxed">
            Type your strict kilobyte cap (e.g., 20 KB, 50 KB, or 100 KB) for automated binary search convergence, or slide the quality percentage. Inspect the before/after split slider in real time.
          </p>
        </div>

        <!-- Step 3 -->
        <div class="p-6 rounded-2xl border border-slate-300 dark:border-slate-800 bg-white dark:bg-slate-900 shadow-sm hover:shadow-md hover:border-blue-600 transition-all duration-150 relative">
          <div class="w-10 h-10 rounded-xl bg-blue-50 dark:bg-blue-950/40 text-blue-600 dark:text-blue-400 flex items-center justify-center font-bold font-mono text-sm mb-4 border border-blue-100 dark:border-blue-900/50">
            03
          </div>
          <h3 class="text-base font-semibold text-slate-900 dark:text-white mb-2">
            Instant Download or ZIP
          </h3>
          <p class="text-sm text-slate-600 dark:text-slate-400 leading-relaxed">
            Download your compressed file with zero delay, or bundle all 15 images into an organized, client-side generated ZIP archive with no watermarks and no server latency.
          </p>
        </div>

      </div>

    </div>
  </section>

  <!-- 4. Unified Presets Grid Section (Matching Image Resizer 1:1) -->
  <section class="border-t border-slate-200 dark:border-slate-800 bg-white dark:bg-slate-950/40 py-16 sm:py-20">
    <div class="max-w-6xl mx-auto px-4 sm:px-6 lg:px-8">
      
      <!-- Section Header -->
      <div class="text-center max-w-2xl mx-auto mb-12">
        <h2 class="text-2xl sm:text-3xl font-bold tracking-tight text-slate-900 dark:text-white">
          Popular Image Compression Presets
        </h2>
        <p class="mt-2 text-sm sm:text-base text-slate-600 dark:text-slate-400">
          Instant 1-click compression configurations optimized for exact KB targets, dimensions, and formats.
        </p>
      </div>

      <!-- Responsive 4-Column Card Grid -->
      <div class="grid grid-cols-2 sm:grid-cols-2 md:grid-cols-3 lg:grid-cols-4 gap-2.5 sm:gap-4">
        {COMPRESS_PRESETS.map((p) => (
          <div class="group relative p-2.5 sm:p-4 rounded-xl sm:rounded-2xl border border-slate-300 dark:border-slate-800 bg-white dark:bg-slate-900/70 hover:border-blue-600 dark:hover:border-blue-500 hover:shadow-md transition-all duration-150 flex flex-col justify-between">
            <div>
              <h3 class="text-xs sm:text-sm font-semibold text-slate-900 dark:text-white group-hover:text-blue-600 dark:group-hover:text-blue-400 transition-colors line-clamp-2 leading-snug mb-2 sm:mb-4">
                {p.title}
              </h3>
            </div>
            <a
              href={`/${p.slug}`}
              class="text-[11px] sm:text-xs font-semibold text-blue-600 dark:text-blue-400 hover:text-blue-700 dark:hover:text-blue-300 inline-flex items-center gap-1 mt-auto after:absolute after:inset-0"
            >
              Compress now &rarr;
            </a>
          </div>
        ))}
      </div>

    </div>
  </section>

  <!-- 5. Feature Comparison Table: FastToolVerse vs TinyPNG & Cloud Services -->
  <section class="border-t border-slate-200 dark:border-slate-800 bg-white dark:bg-slate-950/60 py-16 sm:py-24">
    <div class="max-w-5xl mx-auto px-4 sm:px-6 lg:px-8">
      
      <div class="text-center max-w-2xl mx-auto mb-12 sm:mb-16">
        <h2 class="text-2xl sm:text-3xl font-bold tracking-tight text-slate-900 dark:text-white">
          Why Choose FastToolVerse vs TinyPNG &amp; Cloud Compressors
        </h2>
        <p class="mt-2 text-sm sm:text-base text-slate-600 dark:text-slate-400">
          Compare privacy, precision KB targeting, batch capacity, and speed against cloud alternatives.
        </p>
      </div>

      <!-- Modern Comparison Card / Table -->
      <div class="overflow-hidden rounded-2xl border border-slate-300 dark:border-slate-800 bg-white dark:bg-slate-900 shadow-sm">
        
        <!-- Table Header (Desktop & Mobile) -->
        <div class="grid grid-cols-12 border-b border-slate-200 dark:border-slate-800 bg-slate-100/70 dark:bg-slate-800/80 text-xs sm:text-sm font-semibold text-slate-900 dark:text-slate-200">
          <div class="col-span-12 sm:col-span-4 p-3 sm:p-5 flex items-center border-b sm:border-b-0 border-slate-200 dark:border-slate-800">
            <span>Capability / Benchmark</span>
          </div>
          <div class="col-span-6 sm:col-span-4 p-3 sm:p-5 bg-blue-50/80 dark:bg-blue-950/40 border-r sm:border-x border-slate-200 dark:border-slate-800 text-blue-700 dark:text-blue-300 flex items-center justify-between">
            <span class="font-bold flex items-center gap-1.5">
              FastToolVerse
              <span class="hidden sm:inline-block px-2 py-0.5 text-[11px] font-medium bg-blue-600 text-white rounded-full">Recommended</span>
            </span>
            <span class="text-xs text-blue-600 dark:text-blue-400 font-normal hidden md:inline">This Tool</span>
          </div>
          <div class="col-span-6 sm:col-span-4 p-3 sm:p-5 text-slate-600 dark:text-slate-400 flex items-center">
            <span>TinyPNG &amp; Cloud Services</span>
          </div>
        </div>

        <!-- Row 1: Privacy -->
        <div class="grid grid-cols-12 border-b border-slate-200 dark:border-slate-800 transition-colors hover:bg-slate-50/50 dark:hover:bg-slate-800/30">
          <div class="col-span-12 sm:col-span-4 p-3 sm:p-5 flex flex-col justify-center bg-slate-50/60 dark:bg-slate-800/30 sm:bg-transparent">
            <span class="font-semibold text-xs sm:text-sm text-slate-900 dark:text-white">Security &amp; Privacy</span>
            <span class="text-[11px] sm:text-xs text-slate-600 dark:text-slate-400 mt-0.5">Where media processing executes</span>
          </div>
          <div class="col-span-6 sm:col-span-4 p-3 sm:p-5 bg-blue-50/30 dark:bg-blue-950/15 border-r sm:border-x border-slate-200 dark:border-slate-800 flex items-start gap-2 sm:gap-2.5">
            <div class="w-5 h-5 rounded-full bg-emerald-100 dark:bg-emerald-950/80 text-emerald-600 dark:text-emerald-400 border border-emerald-300 dark:border-emerald-700 flex items-center justify-center shrink-0 mt-0.5 shadow-2xs">
              <svg class="w-3 h-3" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="3"><path stroke-linecap="round" stroke-linejoin="round" d="M4.5 12.75l6 6 9-13.5" /></svg>
            </div>
            <div class="min-w-0">
              <p class="text-xs sm:text-sm font-semibold text-emerald-700 dark:text-emerald-400">100% In-Browser Sandbox</p>
              <p class="text-[11px] sm:text-xs text-slate-600 dark:text-slate-400 mt-0.5 leading-relaxed">HTML5 Canvas engine. Zero server uploads, zero remote retention, 100% confidential.</p>
            </div>
          </div>
          <div class="col-span-6 sm:col-span-4 p-3 sm:p-5 flex items-start gap-2 sm:gap-2.5">
            <div class="w-5 h-5 rounded-full bg-rose-100 dark:bg-rose-950/80 text-rose-600 dark:text-rose-400 border border-rose-300 dark:border-rose-700 flex items-center justify-center shrink-0 mt-0.5 shadow-2xs">
              <svg class="w-3 h-3" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="3"><path stroke-linecap="round" stroke-linejoin="round" d="M6 18L18 6M6 6l12 12" /></svg>
            </div>
            <div class="min-w-0">
              <p class="text-xs sm:text-sm font-medium text-slate-700 dark:text-slate-300">Cloud Server Uploads</p>
              <p class="text-[11px] sm:text-xs text-slate-600 dark:text-slate-400 mt-0.5 leading-relaxed">Images streamed over public web to external server queues with unknown retention policies.</p>
            </div>
          </div>
        </div>

        <!-- Row 2: Target KB Reducer -->
        <div class="grid grid-cols-12 border-b border-slate-200 dark:border-slate-800 transition-colors hover:bg-slate-50/50 dark:hover:bg-slate-800/30">
          <div class="col-span-12 sm:col-span-4 p-3 sm:p-5 flex flex-col justify-center bg-slate-50/60 dark:bg-slate-800/30 sm:bg-transparent">
            <span class="font-semibold text-xs sm:text-sm text-slate-900 dark:text-white">Target Exact KB Mode</span>
            <span class="text-[11px] sm:text-xs text-slate-600 dark:text-slate-400 mt-0.5">Strict compliance for government forms</span>
          </div>
          <div class="col-span-6 sm:col-span-4 p-3 sm:p-5 bg-blue-50/30 dark:bg-blue-950/15 border-r sm:border-x border-slate-200 dark:border-slate-800 flex items-start gap-2 sm:gap-2.5">
            <div class="w-5 h-5 rounded-full bg-emerald-100 dark:bg-emerald-950/80 text-emerald-600 dark:text-emerald-400 border border-emerald-300 dark:border-emerald-700 flex items-center justify-center shrink-0 mt-0.5 shadow-2xs">
              <svg class="w-3 h-3" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="3"><path stroke-linecap="round" stroke-linejoin="round" d="M4.5 12.75l6 6 9-13.5" /></svg>
            </div>
            <div class="min-w-0">
              <p class="text-xs sm:text-sm font-semibold text-slate-900 dark:text-white">Binary Search Convergence</p>
              <p class="text-[11px] sm:text-xs text-slate-600 dark:text-slate-400 mt-0.5 leading-relaxed">Type 20 KB, 50 KB, or 100 KB. Algorithm converges quantization in milliseconds.</p>
            </div>
          </div>
          <div class="col-span-6 sm:col-span-4 p-3 sm:p-5 flex items-start gap-2 sm:gap-2.5">
            <div class="w-5 h-5 rounded-full bg-rose-100 dark:bg-rose-950/80 text-rose-600 dark:text-rose-400 border border-rose-300 dark:border-rose-700 flex items-center justify-center shrink-0 mt-0.5 shadow-2xs">
              <svg class="w-3 h-3" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="3"><path stroke-linecap="round" stroke-linejoin="round" d="M6 18L18 6M6 6l12 12" /></svg>
            </div>
            <div class="min-w-0">
              <p class="text-xs sm:text-sm font-medium text-slate-700 dark:text-slate-300">Unavailable / Trial &amp; Error</p>
              <p class="text-[11px] sm:text-xs text-slate-600 dark:text-slate-400 mt-0.5 leading-relaxed">Fixed automatic compression only. No way to mandate strict 20KB or 50KB limits.</p>
            </div>
          </div>
        </div>

        <!-- Row 3: Batch Limits & Paywalls -->
        <div class="grid grid-cols-12 border-b border-slate-200 dark:border-slate-800 transition-colors hover:bg-slate-50/50 dark:hover:bg-slate-800/30">
          <div class="col-span-12 sm:col-span-4 p-3 sm:p-5 flex flex-col justify-center bg-slate-50/60 dark:bg-slate-800/30 sm:bg-transparent">
            <span class="font-semibold text-xs sm:text-sm text-slate-900 dark:text-white">Batch Queue Limits</span>
            <span class="text-[11px] sm:text-xs text-slate-600 dark:text-slate-400 mt-0.5">Free concurrent processing allowance</span>
          </div>
          <div class="col-span-6 sm:col-span-4 p-3 sm:p-5 bg-blue-50/30 dark:bg-blue-950/15 border-r sm:border-x border-slate-200 dark:border-slate-800 flex items-start gap-2 sm:gap-2.5">
            <div class="w-5 h-5 rounded-full bg-emerald-100 dark:bg-emerald-950/80 text-emerald-600 dark:text-emerald-400 border border-emerald-300 dark:border-emerald-700 flex items-center justify-center shrink-0 mt-0.5 shadow-2xs">
              <svg class="w-3 h-3" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="3"><path stroke-linecap="round" stroke-linejoin="round" d="M4.5 12.75l6 6 9-13.5" /></svg>
            </div>
            <div class="min-w-0">
              <p class="text-xs sm:text-sm font-semibold text-slate-900 dark:text-white">Up to 15 Files Free</p>
              <p class="text-[11px] sm:text-xs text-slate-600 dark:text-slate-400 mt-0.5 leading-relaxed">Instant multi-threaded processing with individual or 1-click batch ZIP download.</p>
            </div>
          </div>
          <div class="col-span-6 sm:col-span-4 p-3 sm:p-5 flex items-start gap-2 sm:gap-2.5">
            <div class="w-5 h-5 rounded-full bg-rose-100 dark:bg-rose-950/80 text-rose-600 dark:text-rose-400 border border-rose-300 dark:border-rose-700 flex items-center justify-center shrink-0 mt-0.5 shadow-2xs">
              <svg class="w-3 h-3" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="3"><path stroke-linecap="round" stroke-linejoin="round" d="M6 18L18 6M6 6l12 12" /></svg>
            </div>
            <div class="min-w-0">
              <p class="text-xs sm:text-sm font-medium text-slate-700 dark:text-slate-300">Strict Rate Limits &amp; Subscriptions</p>
              <p class="text-[11px] sm:text-xs text-slate-600 dark:text-slate-400 mt-0.5 leading-relaxed">Limited to 5MB max, aggressive throttling, and recurring Pro paywalls.</p>
            </div>
          </div>
        </div>

        <!-- Row 4: Format Range -->
        <div class="grid grid-cols-12 transition-colors hover:bg-slate-50/50 dark:hover:bg-slate-800/30">
          <div class="col-span-12 sm:col-span-4 p-3 sm:p-5 flex flex-col justify-center bg-slate-50/60 dark:bg-slate-800/30 sm:bg-transparent">
            <span class="font-semibold text-xs sm:text-sm text-slate-900 dark:text-white">Format Range &amp; EXIF Control</span>
            <span class="text-[11px] sm:text-xs text-slate-600 dark:text-slate-400 mt-0.5">Modern web codecs &amp; metadata management</span>
          </div>
