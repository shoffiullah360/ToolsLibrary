              {faq.answer}
            </div>
          </details>
        ))}
      </div>

    </div>
  </section>

  <!-- 10. Related Tools Row (Matching Image Resizer - No Orphan Pills) -->
  <section class="border-t border-slate-200/90 dark:border-slate-800 bg-slate-50/80 dark:bg-slate-950/40 py-12 sm:py-16">
    <div class="max-w-5xl mx-auto px-4 sm:px-6 lg:px-8 text-center">
      <h3 class="text-lg font-semibold text-slate-900 dark:text-white mb-6">
        Explore Related Image Utilities
      </h3>
      <div class="flex flex-wrap justify-center gap-3">
        <a
          href="/tools/image-resizer"
          class="inline-flex items-center gap-2 px-4 py-2 rounded-xl border border-slate-300 dark:border-slate-800 bg-white dark:bg-slate-900 text-xs font-medium text-slate-700 dark:text-slate-300 hover:border-blue-600 hover:shadow-md transition-all duration-150 shadow-sm"
        >
          <ToolIcon name="maximize-2" class="w-4 h-4 text-blue-500" />
          <span>Image Resizer</span>
        </a>
        <a
          href="/tools/image-converter"
          class="inline-flex items-center gap-2 px-4 py-2 rounded-xl border border-slate-300 dark:border-slate-800 bg-white dark:bg-slate-900 text-xs font-medium text-slate-700 dark:text-slate-300 hover:border-blue-600 hover:shadow-md transition-all duration-150 shadow-sm"
        >
          <ToolIcon name="repeat" class="w-4 h-4 text-emerald-500" />
          <span>Image Converter</span>
        </a>
        <a
          href="/tools/image-cropper"
          class="inline-flex items-center gap-2 px-4 py-2 rounded-xl border border-slate-300 dark:border-slate-800 bg-white dark:bg-slate-900 text-xs font-medium text-slate-700 dark:text-slate-300 hover:border-blue-600 hover:shadow-md transition-all duration-150 shadow-sm"
        >
          <ToolIcon name="crop" class="w-4 h-4 text-purple-500" />
          <span>Image Cropper</span>
        </a>
        <a
          href="/tools/image-rotator"
          class="inline-flex items-center gap-2 px-4 py-2 rounded-xl border border-slate-300 dark:border-slate-800 bg-white dark:bg-slate-900 text-xs font-medium text-slate-700 dark:text-slate-300 hover:border-blue-600 hover:shadow-md transition-all duration-150 shadow-sm"
        >
          <ToolIcon name="rotate-cw" class="w-4 h-4 text-cyan-500" />
          <span>Image Rotator</span>
        </a>
      </div>
    </div>
  </section>

</Layout>
