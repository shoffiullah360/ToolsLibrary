---
import Layout from '../../layouts/Layout.astro';
import ToolIcon from '../../components/ToolIcon.astro';
import ImageCompressor from '../../components/tools/ImageCompressor.astro';
import { COMPRESS_PRESETS } from '../../data/compressPresets';

// FAQ Content for Schema and UI
const faqs = [
  {
    question: "How to compress an image to an exact file size like 20 KB or 50 KB?",
    answer: "Enter your required size (e.g., 20 KB or 50 KB) in the Target Max File Size field, or click one of the quick KB presets. FastToolVerse initiates a client-side binary search loop that dynamically calculates the optimal quantization matrix in up to 6 iterative passes and synchronizes the quality slider automatically, guaranteeing your file stays strictly under the target threshold while retaining peak visual clarity."
  },
  {
    question: "What is the difference between lossy and lossless image compression?",
    answer: "Lossy compression (used in JPG and WebP) permanently discards high-frequency pixel data and color nuances imperceptible to human eyes using Discrete Cosine Transform (DCT) and chroma subsampling, achieving 60% to 90% size reductions. Lossless compression (used in PNG and lossless WebP) reorganizes data patterns via DEFLATE or predictive filtering without discarding any pixel data, maintaining 100% mathematical fidelity."
  },
  {
    question: "How does 100% client-side compression work in the browser?",
    answer: "FastToolVerse utilizes modern HTML5 Canvas, OffscreenCanvas, and WebAssembly APIs built into your browser. When you drop an image, your computer's local CPU/GPU decodes, resamples, quantizes, and re-encodes the image in your browser's private memory heap. Zero bytes of image content or file paths are ever uploaded to cloud servers."
  },
  {
    question: "Does this tool upload or store my confidential photos on any server?",
    answer: "No. FastToolVerse operates under a strict zero-upload architecture. Your sensitive government identity cards, passport photos, academic transcripts, signatures, and personal photos never leave your device. The tool works seamlessly even if you disconnect your device from the internet."
  },
  {
    question: "How do I compress PNG images without losing transparent backgrounds?",
    answer: "PNG supports 8-bit alpha channels for transparency. When compressing PNGs, FastToolVerse preserves the transparent background channels. You can export in optimized PNG mode or convert to WebP, which supports transparent alpha channels while delivering 30% to 50% smaller file sizes than standard PNG."
  },
  {
    question: "Why do government job and passport portals require strict 20KB or 50KB limits?",
    answer: "Official government portals, exam boards, and visa registration systems handle millions of applicant submissions. Rigid file limits (typically 20KB to 50KB) conserve server storage, minimize database bandwidth, and ensure instantaneous loading across rural connections. FastToolVerse is calibrated specifically to satisfy these strict administrative limits."
  },
  {
    question: "How does the Target KB binary search convergence loop work?",
    answer: "Rather than guessing quality sliders, our binary search algorithm sets quality boundaries between 5% and 98%. In each iteration, it encodes the canvas to a candidate blob and evaluates byte size against your target. If the file is too large, it halves the search interval downwards; if smaller, it tests higher quality. If resolution is too large for the requested KB, it intelligently applies proportional downscaling to ensure compliance."
  },
  {
    question: "Does compressing images strip EXIF metadata (GPS, camera model)?",
    answer: "Yes. By default, stripping EXIF metadata is enabled. Re-encoding through the HTML5 Canvas sandbox automatically removes embedded camera metadata, GPS coordinates, date stamps, and color management profiles, preserving your personal privacy and saving an additional 5 KB to 30 KB of overhead."
  },
  {
    question: "Can I compress multiple images simultaneously and download a ZIP file?",
    answer: "Yes. You can upload up to 15 images concurrently. FastToolVerse compresses each photo in parallel queues and provides instant single-file downloads or a 1-click 'Download All as ZIP' archive generated directly in your browser using client-side JSZip."
  },
  {
    question: "Which image format offers the best compression: JPG, PNG, or WebP?",
    answer: "WebP is the modern champion, offering 25% to 35% smaller file sizes than JPG at equivalent perceptual quality, alongside full transparency support. JPG is best for legacy system compatibility (government forms), while PNG is recommended for screenshots, line art, and graphics requiring lossless pixel perfection."
  }
];

// Schema.org SoftwareApplication
const jsonLdSoftwareApp = {
  "@context": "https://schema.org",
  "@type": "SoftwareApplication",
  "name": "Free Online Image Compressor & Exact KB Reducer",
  "applicationCategory": "MultimediaApplication",
  "operatingSystem": "All (Web Browser)",
  "browserRequirements": "Requires JavaScript. Requires HTML5 Canvas support.",
  "offers": {
    "@type": "Offer",
    "price": "0",
    "priceCurrency": "USD"
  },
  "featureList": [
    "100% Client-Side Sandbox Privacy",
    "Target Exact File Size in KB (20KB, 50KB, 100KB, 200KB)",
    "Automated Binary Search Compression Loop",
    "Visual Quality Slider with Live Before/After Split Comparison",
    "Batch Compression up to 15 Files",
    "Export to JPG, PNG, and WebP",
    "Automated EXIF Metadata Stripping",
    "1-Click Batch ZIP Download"
  ]
};

// Schema.org FAQPage
const jsonLdFaq = {
  "@context": "https://schema.org",
  "@type": "FAQPage",
  "mainEntity": faqs.map((f) => ({
    "@type": "Question",
    "name": f.question,
    "acceptedAnswer": {
      "@type": "Answer",
      "text": f.answer
    }
  }))
};

const canonicalUrl = "https://fasttoolverse.com/tools/image-compressor";
const pageTitle = "Free Online Image Compressor & Exact KB Reducer | FastToolVerse";
const pageDescription = "Compress JPG, PNG, and WebP images by percentage or target exact file sizes (20 KB, 50 KB, 100 KB) with 100% in-browser privacy and zero server uploads.";
const pageKeywords = "image compressor, reduce image size in kb, compress image to 20kb, compress image to 50kb, compress image to 100kb, batch image compressor, client-side image compressor, online photo compressor, lossy lossless compressor, webp compressor, image kb reducer";
const ogImage = "https://fasttoolverse.com/og-image.png";

const presets = [
  {
    title: "Compress Image to 20 KB",
    badge: "Govt / Signatures",
    description: "Strict threshold for civil service portals, signature uploads, and state exam forms.",
    targetKb: 20,
    color: "blue",
    slug: "compress-image-to-20kb"
  },
  {
    title: "Compress Image to 50 KB",
    badge: "Admit Cards / Forms",
    description: "Ideal balance of facial clarity and compact weight for university and visa submissions.",
    targetKb: 50,
    color: "purple",
    slug: "compress-image-to-50kb"
  },
  {
    title: "Compress Image to 100 KB",
    badge: "E-Commerce / Web",
    description: "Optimal size for high-speed online catalogs, Shopify products, and blog heroes.",
    targetKb: 100,
    color: "emerald",
    slug: "compress-image-to-100kb"
  },
  {
    title: "Compress Image to 200 KB",
    badge: "Email Attachments",
    description: "Keep email attachments lightweight while retaining crisp desktop reproduction.",
    targetKb: 200,
    color: "amber",
    slug: "compress-image-to-200kb"
  },
  {
    title: "Compress PNG Losslessly",
    badge: "Alpha Transparency",
    description: "Optimized PNG encoding preserving transparent backgrounds, sharp lines, and vector logos.",
    format: "image/png",
    quality: 100,
    color: "cyan",
    slug: "reduce-png-size-without-losing-quality"
  },
  {
    title: "Batch WebP Converter & Compressor",
    badge: "Next-Gen Format",
    description: "Convert heavy JPGs or PNGs into lightweight modern WebP files with up to 80% savings.",
    format: "image/webp",
    quality: 75,
    color: "rose",
    slug: "webp-image-compressor-online"
  }
];
---

<Layout
  title={pageTitle}
  description={pageDescription}
  canonicalUrl={canonicalUrl}
  image={ogImage}
>
  <!-- Injected Head Elements: Twitter name tags & JSON-LD Schemas -->
  <Fragment slot="head">
    <meta name="keywords" content={pageKeywords} />

    <!-- Open Graph tags -->
    <meta property="og:type" content="website" />
    <meta property="og:url" content={canonicalUrl} />
    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={pageDescription} />
    <meta property="og:image" content={ogImage} />

    <!-- Twitter Card Name Standards -->
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:url" content={canonicalUrl} />
    <meta name="twitter:title" content={pageTitle} />
    <meta name="twitter:description" content={pageDescription} />
    <meta name="twitter:image" content={ogImage} />

    <!-- Structured Data Schemas -->
    <script type="application/ld+json" set:html={JSON.stringify(jsonLdSoftwareApp)} />
    <script type="application/ld+json" set:html={JSON.stringify(jsonLdFaq)} />
  </Fragment>

  <!-- Hero Header Section -->
  <section class="relative pt-12 pb-6 sm:pt-16 sm:pb-8 overflow-hidden">
    <div class="hero-mesh-bg" aria-hidden="true"></div>

    <div class="relative max-w-5xl mx-auto px-4 sm:px-6 lg:px-8 text-center">
      <!-- Privacy Badge -->
      <div class="inline-flex items-center gap-1.5 px-3 py-1 rounded-full text-xs font-semibold bg-blue-50 dark:bg-blue-950/50 text-blue-600 dark:text-blue-400 border border-blue-200 dark:border-blue-900/50 mb-3 shadow-2xs">
        <ToolIcon name="shield-check" class="w-3.5 h-3.5" />
        <span>100% In-Browser Privacy • Zero Server Uploads</span>
      </div>

      <!-- Hero Title -->
      <h1 class="text-3xl sm:text-4xl md:text-5xl font-bold tracking-tight text-slate-900 dark:text-white">
        Free Online Image Compressor & Exact KB Reducer
      </h1>

      <!-- Subtitle -->
      <p class="mt-3 sm:mt-4 text-base sm:text-lg text-slate-600 dark:text-slate-400 max-w-2xl mx-auto leading-relaxed">
        Compress JPG, PNG, and WebP images by percentage or target exact file sizes (20 KB, 50 KB, 100 KB) with 100% in-browser privacy and zero server uploads.
      </p>

      <!-- Value Propositions Pills -->
      <div class="mt-6 flex flex-wrap items-center justify-center gap-2 sm:gap-3 text-xs sm:text-sm font-medium text-slate-600 dark:text-slate-400">
        <div class="inline-flex items-center gap-1.5 px-3 py-1 rounded-lg bg-white/70 dark:bg-slate-900/60 border border-slate-200 dark:border-slate-800 shadow-2xs">
          <ToolIcon name="shield-check" class="w-4 h-4 text-emerald-500" />
          <span>100% Client-Side Sandbox</span>
        </div>
        <div class="inline-flex items-center gap-1.5 px-3 py-1 rounded-lg bg-white/70 dark:bg-slate-900/60 border border-slate-200 dark:border-slate-800 shadow-2xs">
          <ToolIcon name="zap" class="w-4 h-4 text-blue-500" />
          <span>Lossy & Lossless Quantization</span>
        </div>
        <div class="inline-flex items-center gap-1.5 px-3 py-1 rounded-lg bg-white/70 dark:bg-slate-900/60 border border-slate-200 dark:border-slate-800 shadow-2xs">
          <ToolIcon name="scale" class="w-4 h-4 text-purple-500" />
          <span>Batch Processing up to 15 Files</span>
        </div>
      </div>
    </div>
  </section>

  <!-- Interactive Studio Component -->
  <ImageCompressor />

  <!-- High-Intent Target Presets Grid -->
  <section class="border-t border-slate-200 dark:border-slate-800 bg-white dark:bg-slate-950/40 py-16 sm:py-20">
    <div class="max-w-6xl mx-auto px-4 sm:px-6 lg:px-8">
      
      <div class="text-center max-w-2xl mx-auto mb-12">
        <div class="inline-flex items-center gap-1.5 px-3 py-1 rounded-full text-xs font-semibold bg-blue-50 dark:bg-blue-950/50 text-blue-600 dark:text-blue-400 border border-blue-200 dark:border-blue-900/50 mb-3">
          <ToolIcon name="zap" class="w-3.5 h-3.5" />
          <span>Programmatic Presets</span>
        </div>
        <h2 class="text-2xl sm:text-3xl font-bold tracking-tight text-slate-900 dark:text-white">
          Popular Target Compression Presets
        </h2>
        <p class="mt-2 text-sm sm:text-base text-slate-600 dark:text-slate-400">
          Click any preset to preconfigure the tool workspace instantly for official forms, portals, and web standards.
        </p>
      </div>

      <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-4 sm:gap-6">
        {presets.map((preset) => (
          <div
            class="group p-5 rounded-2xl border border-slate-200 dark:border-slate-800 bg-white dark:bg-slate-900 hover:border-blue-500/50 dark:hover:border-blue-500/50 hover:shadow-md transition-all flex flex-col justify-between"
          >
            <div>
              <div class="flex items-center justify-between gap-2 mb-3">
                <span class="inline-block text-xs font-bold px-2.5 py-1 rounded-full bg-blue-50 dark:bg-blue-950/60 text-blue-600 dark:text-blue-400 border border-blue-100 dark:border-blue-900/50">
                  {preset.badge}
                </span>
                {preset.targetKb && (
                  <span class="text-xs font-mono font-bold text-slate-500 dark:text-slate-400">
                    &le; {preset.targetKb} KB
                  </span>
                )}
              </div>

              <h3 class="text-base font-semibold text-slate-900 dark:text-white group-hover:text-blue-600 dark:group-hover:text-blue-400 transition-colors">
                <a href={`/${preset.slug}`}>{preset.title}</a>
              </h3>
              <p class="mt-1.5 text-xs text-slate-600 dark:text-slate-400 leading-relaxed">
                {preset.description}
              </p>
            </div>

            <div class="mt-5 pt-3 border-t border-slate-100 dark:border-slate-800 flex items-center justify-between text-xs">
              <a
                href={`/${preset.slug}`}
                class="font-semibold text-slate-600 dark:text-slate-400 hover:text-blue-600 dark:hover:text-blue-400 inline-flex items-center gap-1"
              >
                Preset Page →
              </a>
              <button
                type="button"
                class="quick-preset-apply font-semibold text-blue-600 dark:text-blue-400 hover:text-blue-700 dark:hover:text-blue-300 inline-flex items-center gap-1 cursor-pointer"
                data-kb={preset.targetKb || ''}
                data-quality={preset.quality || ''}
                data-format={preset.format || ''}
              >
                Apply & Upload ↑
              </button>
            </div>
          </div>
        ))}
      </div>

      <!-- Complete 60 Presets Directory -->
      <div class="mt-16 pt-12 border-t border-slate-200 dark:border-slate-800">
        <div class="text-center max-w-2xl mx-auto mb-8">
          <h3 class="text-xl font-bold tracking-tight text-slate-900 dark:text-white">
            All 60 Target Compression & Format Presets
          </h3>
          <p class="text-xs sm:text-sm text-slate-500 dark:text-slate-400 mt-1">
            Explore our verified programmatic presets for exact government forms, admission portals, platforms, and formats.
          </p>
        </div>
        <div class="grid grid-cols-2 sm:grid-cols-3 md:grid-cols-4 lg:grid-cols-5 gap-2.5">
          {COMPRESS_PRESETS.map((p) => (
            <a
              href={`/${p.slug}`}
              class="p-2.5 rounded-xl border border-slate-200/80 dark:border-slate-800 bg-white dark:bg-slate-900/60 hover:border-blue-500 hover:bg-blue-50/50 dark:hover:bg-blue-950/20 transition-all text-xs font-medium text-slate-700 dark:text-slate-300 truncate shadow-2xs"
            >
              <span class="block text-[10px] text-blue-600 dark:text-blue-400 font-bold mb-0.5 truncate">{p.badge}</span>
              <span class="truncate block">{p.title}</span>
            </a>
          ))}
        </div>
      </div>

    </div>
  </section>

  <!-- 3-Step Guide Section -->
  <section class="border-t border-slate-200 dark:border-slate-800 bg-slate-50/50 dark:bg-slate-900/40 py-16 sm:py-20">
    <div class="max-w-5xl mx-auto px-4 sm:px-6 lg:px-8">
      
      <div class="text-center max-w-2xl mx-auto mb-12">
        <h2 class="text-2xl sm:text-3xl font-bold tracking-tight text-slate-900 dark:text-white">
          How to Compress Images to Target KB in 3 Steps
        </h2>
        <p class="mt-2 text-sm sm:text-base text-slate-600 dark:text-slate-400">
          Fast, effortless, and private. Hit exact kilobyte boundaries directly in your browser.
        </p>
      </div>

      <div class="grid grid-cols-1 md:grid-cols-3 gap-6 sm:gap-8">
        
        <!-- Step 1 -->
        <div class="p-6 rounded-2xl border border-slate-200 dark:border-slate-800 bg-white dark:bg-slate-900 shadow-xs relative">
          <div class="w-10 h-10 rounded-xl bg-blue-50 dark:bg-blue-950/40 text-blue-600 dark:text-blue-400 flex items-center justify-center font-bold font-mono text-sm mb-4 border border-blue-100 dark:border-blue-900/50">
            01
          </div>
          <h3 class="text-base font-semibold text-slate-900 dark:text-white mb-2">
            Upload or Paste Photos
          </h3>
          <p class="text-sm text-slate-600 dark:text-slate-400 leading-relaxed">
            Drag and drop up to 15 JPG, PNG, WebP, or AVIF files, browse your local drive, or paste from clipboard using <kbd class="px-1.5 py-0.5 text-xs font-mono bg-slate-100 dark:bg-slate-800 rounded border border-slate-200 dark:border-slate-700">Ctrl+V</kbd>.
          </p>
        </div>

        <!-- Step 2 -->
        <div class="p-6 rounded-2xl border border-slate-200 dark:border-slate-800 bg-white dark:bg-slate-900 shadow-xs relative">
          <div class="w-10 h-10 rounded-xl bg-blue-50 dark:bg-blue-950/40 text-blue-600 dark:text-blue-400 flex items-center justify-center font-bold font-mono text-sm mb-4 border border-blue-100 dark:border-blue-900/50">
            02
          </div>
          <h3 class="text-base font-semibold text-slate-900 dark:text-white mb-2">
            Set Target KB or Quality
          </h3>
          <p class="text-sm text-slate-600 dark:text-slate-400 leading-relaxed">
            Type your strict kilobyte cap (e.g., 20 KB or 50 KB) for automated binary search convergence, or slide the quality percentage. Inspect the before/after split slider in real time.
          </p>
        </div>

        <!-- Step 3 -->
        <div class="p-6 rounded-2xl border border-slate-200 dark:border-slate-800 bg-white dark:bg-slate-900 shadow-xs relative">
          <div class="w-10 h-10 rounded-xl bg-blue-50 dark:bg-blue-950/40 text-blue-600 dark:text-blue-400 flex items-center justify-center font-bold font-mono text-sm mb-4 border border-blue-100 dark:border-blue-900/50">
            03
          </div>
          <h3 class="text-base font-semibold text-slate-900 dark:text-white mb-2">
            Instant Download or ZIP
          </h3>
          <p class="text-sm text-slate-600 dark:text-slate-400 leading-relaxed">
            Download your compressed file with zero delay, or bundle all 15 images into an organized, client-side generated ZIP archive with no watermarks.
          </p>
        </div>

      </div>

    </div>
  </section>

  <!-- Feature Comparison Table: FastToolVerse vs TinyPNG & Cloud Compressors -->
  <section class="border-t border-slate-200 dark:border-slate-800 bg-white dark:bg-slate-950/60 py-16 sm:py-24">
    <div class="max-w-5xl mx-auto px-4 sm:px-6 lg:px-8">
      
      <div class="text-center max-w-2xl mx-auto mb-12 sm:mb-16">
        <div class="inline-flex items-center gap-1.5 px-3 py-1 rounded-full text-xs font-semibold bg-blue-50 dark:bg-blue-950/50 text-blue-600 dark:text-blue-400 border border-blue-200 dark:border-blue-900/50 mb-3">
          <ToolIcon name="zap" class="w-3.5 h-3.5" />
          <span>Feature Comparison</span>
        </div>
        <h2 class="text-2xl sm:text-3xl font-bold tracking-tight text-slate-900 dark:text-white">
          Why Choose FastToolVerse vs TinyPNG & Cloud Compressors
        </h2>
        <p class="mt-2 text-sm sm:text-base text-slate-600 dark:text-slate-400">
          Compare privacy, precision KB targeting, batch capacity, and speed against cloud alternatives.
        </p>
      </div>

      <!-- Comparison Matrix Table -->
      <div class="overflow-hidden rounded-2xl border border-slate-200 dark:border-slate-800 bg-white dark:bg-slate-900 shadow-xs">
        
        <!-- Table Header -->
        <div class="grid grid-cols-12 border-b border-slate-200 dark:border-slate-800 bg-slate-50/90 dark:bg-slate-900/90 text-xs sm:text-sm font-semibold text-slate-700 dark:text-slate-300">
          <div class="col-span-12 sm:col-span-4 p-3 sm:p-5 flex items-center border-b sm:border-b-0 border-slate-200 dark:border-slate-800">
            <span>Capability / Benchmark</span>
          </div>
          <div class="col-span-6 sm:col-span-4 p-3 sm:p-5 bg-blue-50/60 dark:bg-blue-950/30 border-r sm:border-x border-blue-100 dark:border-blue-900/40 text-blue-700 dark:text-blue-300 flex items-center justify-between">
            <span class="font-bold flex items-center gap-1.5">
              FastToolVerse
              <span class="hidden sm:inline-block px-2 py-0.5 text-[11px] font-medium bg-blue-600 text-white rounded-full">Recommended</span>
            </span>
            <span class="text-xs text-blue-600 dark:text-blue-400 font-normal hidden md:inline">This Tool</span>
          </div>
          <div class="col-span-6 sm:col-span-4 p-3 sm:p-5 text-slate-500 dark:text-slate-400 flex items-center">
            <span>TinyPNG & Cloud Services</span>
          </div>
        </div>

        <!-- Row 1: Privacy -->
        <div class="grid grid-cols-12 border-b border-slate-100 dark:border-slate-800/80 transition-colors hover:bg-slate-50/50 dark:hover:bg-slate-800/30">
          <div class="col-span-12 sm:col-span-4 p-3 sm:p-5 flex flex-col justify-center bg-slate-50/60 dark:bg-slate-800/30 sm:bg-transparent">
            <span class="font-semibold text-xs sm:text-sm text-slate-900 dark:text-white">Security & Privacy</span>
            <span class="text-[11px] sm:text-xs text-slate-500 dark:text-slate-400 mt-0.5">Where media processing executes</span>
          </div>
          <div class="col-span-6 sm:col-span-4 p-3 sm:p-5 bg-blue-50/30 dark:bg-blue-950/15 border-r sm:border-x border-blue-100 dark:border-blue-900/30 flex items-start gap-2 sm:gap-2.5">
            <div class="w-5 h-5 rounded-full bg-emerald-100 dark:bg-emerald-950/80 text-emerald-600 dark:text-emerald-400 border border-emerald-300 dark:border-emerald-700 flex items-center justify-center shrink-0 mt-0.5 shadow-2xs">
              <svg class="w-3 h-3" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="3"><path stroke-linecap="round" stroke-linejoin="round" d="M4.5 12.75l6 6 9-13.5" /></svg>
            </div>
            <div class="min-w-0">
              <p class="text-xs sm:text-sm font-semibold text-emerald-700 dark:text-emerald-400">100% In-Browser Sandbox</p>
              <p class="text-[11px] sm:text-xs text-slate-600 dark:text-slate-400 mt-0.5 leading-relaxed">HTML5 Canvas engine. Zero server uploads, zero remote retention, 100% confidential.</p>
            </div>
          </div>
          <div class="col-span-6 sm:col-span-4 p-3 sm:p-5 flex items-start gap-2 sm:gap-2.5">
            <div class="w-5 h-5 rounded-full bg-rose-100 dark:bg-rose-950/80 text-rose-600 dark:text-rose-400 border border-rose-300 dark:border-rose-700 flex items-center justify-center shrink-0 mt-0.5 shadow-2xs">
              <svg class="w-3 h-3" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="3"><path stroke-linecap="round" stroke-linejoin="round" d="M6 18L18 6M6 6l12 12" /></svg>
            </div>
            <div class="min-w-0">
              <p class="text-xs sm:text-sm font-medium text-slate-700 dark:text-slate-300">Cloud Server Uploads</p>
              <p class="text-[11px] sm:text-xs text-slate-500 dark:text-slate-400 mt-0.5 leading-relaxed">Images streamed over public web to external server queues with unknown retention policies.</p>
            </div>
          </div>
        </div>

        <!-- Row 2: Target KB Reducer -->
        <div class="grid grid-cols-12 border-b border-slate-100 dark:border-slate-800/80 transition-colors hover:bg-slate-50/50 dark:hover:bg-slate-800/30">
          <div class="col-span-12 sm:col-span-4 p-3 sm:p-5 flex flex-col justify-center bg-slate-50/60 dark:bg-slate-800/30 sm:bg-transparent">
            <span class="font-semibold text-xs sm:text-sm text-slate-900 dark:text-white">Target Exact KB Mode</span>
            <span class="text-[11px] sm:text-xs text-slate-500 dark:text-slate-400 mt-0.5">Strict compliance for government forms</span>
          </div>
