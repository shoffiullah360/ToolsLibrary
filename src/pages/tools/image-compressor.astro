---
import Layout from '../../layouts/Layout.astro';
import ToolIcon from '../../components/ToolIcon.astro';

// FAQ Content for Schema and UI
const faqs = [
  {
    question: "How to compress an image to an exact file size like 20 KB or 50 KB?",
    answer: "Switch to 'Target Exact File Size' mode, enter your required size (e.g., 20 KB or 50 KB), or click one of the quick presets. FastToolVerse initiates a client-side binary search loop that dynamically calculates the optimal quantization matrix in up to 6 iterative passes, guaranteeing your file stays strictly under the target threshold while retaining peak visual clarity."
  },
  {
    question: "What is the difference between lossy and lossless image compression?",
    answer: "Lossy compression (used in JPG and WebP) permanently discards high-frequency pixel data and color nuances imperceptible to human eyes using Discrete Cosine Transform (DCT) and chroma subsampling, achieving 60% to 90% size reductions. Lossless compression (used in PNG and lossless WebP) reorganizes data patterns via DEFLATE or predictive filtering without discarding any pixel data, maintaining 100% mathematical fidelity."
  },
  {
    question: "How does 100% client-side compression work in the browser?",
    answer: "FastToolVerse utilizes modern HTML5 Canvas, OffscreenCanvas, and WebAssembly APIs built into your browser. When you drop an image, your computer's local CPU/GPU decodes, resamples, quantizes, and re-encodes the image in your browser's private memory heap. Zero bytes of image content or file paths are ever uploaded to cloud servers."
  },
  {
    question: "Does this tool upload or store my confidential photos on any server?",
    answer: "No. FastToolVerse operates under a strict zero-upload architecture. Your sensitive government identity cards, passport photos, academic transcripts, signatures, and personal photos never leave your device. The tool works seamlessly even if you disconnect your device from the internet."
  },
  {
    question: "How do I compress PNG images without losing transparent backgrounds?",
    answer: "PNG supports 8-bit alpha channels for transparency. When compressing PNGs, FastToolVerse preserves the transparent background channels. You can export in optimized PNG mode or convert to WebP, which supports transparent alpha channels while delivering 30% to 50% smaller file sizes than standard PNG."
  },
  {
    question: "Why do government job and passport portals require strict 20KB or 50KB limits?",
    answer: "Official government portals, exam boards, and visa registration systems handle millions of applicant submissions. Rigid file limits (typically 20KB to 50KB) conserve server storage, minimize database bandwidth, and ensure instantaneous loading across rural connections. FastToolVerse is calibrated specifically to satisfy these strict administrative limits."
  },
  {
    question: "How does the Target KB binary search convergence loop work?",
    answer: "Rather than guessing quality sliders, our binary search algorithm sets quality boundaries between 5% and 98%. In each iteration, it encodes the canvas to a candidate blob and evaluates byte size against your target. If the file is too large, it halves the search interval downwards; if smaller, it tests higher quality. If resolution is too large for the requested KB, it intelligently applies proportional downscaling to ensure compliance."
  },
  {
    question: "Does compressing images strip EXIF metadata (GPS, camera model)?",
    answer: "Yes. By default, stripping EXIF metadata is enabled. Re-encoding through the HTML5 Canvas sandbox automatically removes embedded camera metadata, GPS coordinates, date stamps, and color management profiles, preserving your personal privacy and saving an additional 5 KB to 30 KB of overhead."
  },
  {
    question: "Can I compress multiple images simultaneously and download a ZIP file?",
    answer: "Yes. You can upload up to 15 images concurrently. FastToolVerse compresses each photo in parallel queues and provides instant single-file downloads or a 1-click 'Download All as ZIP' archive generated directly in your browser using client-side JSZip."
  },
  {
    question: "Which image format offers the best compression: JPG, PNG, or WebP?",
    answer: "WebP is the modern champion, offering 25% to 35% smaller file sizes than JPG at equivalent perceptual quality, alongside full transparency support. JPG is best for legacy system compatibility (government forms), while PNG is recommended for screenshots, line art, and graphics requiring lossless pixel perfection."
  }
];

// Schema.org SoftwareApplication
const jsonLdSoftwareApp = {
  "@context": "https://schema.org",
  "@type": "SoftwareApplication",
  "name": "Free Online Image Compressor & Exact KB Reducer",
  "applicationCategory": "MultimediaApplication",
  "operatingSystem": "All (Web Browser)",
  "browserRequirements": "Requires JavaScript. Requires HTML5 Canvas support.",
  "offers": {
    "@type": "Offer",
    "price": "0",
    "priceCurrency": "USD"
  },
  "featureList": [
    "100% Client-Side Sandbox Privacy",
    "Target Exact File Size in KB (20KB, 50KB, 100KB, 200KB)",
    "Automated Binary Search Compression Loop",
    "Visual Quality Slider with Live Before/After Split Comparison",
    "Batch Compression up to 15 Files",
    "Export to JPG, PNG, and WebP",
    "Automated EXIF Metadata Stripping",
    "1-Click Batch ZIP Download"
  ]
};

// Schema.org FAQPage
const jsonLdFaq = {
  "@context": "https://schema.org",
  "@type": "FAQPage",
  "mainEntity": faqs.map((f) => ({
    "@type": "Question",
    "name": f.question,
    "acceptedAnswer": {
      "@type": "Answer",
      "text": f.answer
    }
  }))
};

const canonicalUrl = "https://fasttoolverse.com/tools/image-compressor";
const pageTitle = "Free Online Image Compressor & Exact KB Reducer | FastToolVerse";
const pageDescription = "Compress JPG, PNG, and WebP images by percentage or target exact file sizes (20 KB, 50 KB, 100 KB) with 100% in-browser privacy and zero server uploads.";
const pageKeywords = "image compressor, reduce image size in kb, compress image to 20kb, compress image to 50kb, compress image to 100kb, batch image compressor, client-side image compressor, online photo compressor, lossy lossless compressor, webp compressor, image kb reducer";
const ogImage = "https://fasttoolverse.com/og-image.png";

const presets = [
  {
    title: "Compress Image to 20 KB",
    badge: "Govt / Signatures",
    description: "Strict threshold for civil service portals, signature uploads, and state exam forms.",
    targetKb: 20,
    mode: "target-kb",
    color: "blue"
  },
  {
    title: "Compress Image to 50 KB",
    badge: "Admit Cards / Forms",
    description: "Ideal balance of facial clarity and compact weight for university and visa submissions.",
    targetKb: 50,
    mode: "target-kb",
    color: "purple"
  },
  {
    title: "Compress Image to 100 KB",
    badge: "E-Commerce / Web",
    description: "Optimal size for high-speed online catalogs, Shopify products, and blog heroes.",
    targetKb: 100,
    mode: "target-kb",
    color: "emerald"
  },
  {
    title: "Compress Image to 200 KB",
    badge: "Email Attachments",
    description: "Keep email attachments lightweight while retaining crisp desktop reproduction.",
    targetKb: 200,
    mode: "target-kb",
    color: "amber"
  },
  {
    title: "Compress PNG Losslessly",
    badge: "Alpha Transparency",
    description: "Optimized PNG encoding preserving transparent backgrounds, sharp lines, and vector logos.",
    format: "image/png",
    quality: 100,
    mode: "quality",
    color: "cyan"
  },
  {
    title: "Batch WebP Converter & Compressor",
    badge: "Next-Gen Format",
    description: "Convert heavy JPGs or PNGs into lightweight modern WebP files with up to 80% savings.",
    format: "image/webp",
    quality: 75,
    mode: "quality",
    color: "rose"
  }
];
---

<Layout
  title={pageTitle}
  description={pageDescription}
  canonicalUrl={canonicalUrl}
  image={ogImage}
>
  <!-- Injected Head Elements: Twitter name tags & JSON-LD Schemas -->
  <Fragment slot="head">
    <meta name="keywords" content={pageKeywords} />

    <!-- Open Graph tags -->
    <meta property="og:type" content="website" />
    <meta property="og:url" content={canonicalUrl} />
    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={pageDescription} />
    <meta property="og:image" content={ogImage} />

    <!-- Twitter Card Name Standards -->
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:url" content={canonicalUrl} />
    <meta name="twitter:title" content={pageTitle} />
    <meta name="twitter:description" content={pageDescription} />
    <meta name="twitter:image" content={ogImage} />

    <!-- Structured Data Schemas -->
    <script type="application/ld+json" set:html={JSON.stringify(jsonLdSoftwareApp)} />
    <script type="application/ld+json" set:html={JSON.stringify(jsonLdFaq)} />
  </Fragment>

  <!-- Hero Header Section -->
  <section class="relative pt-12 pb-6 sm:pt-16 sm:pb-8 overflow-hidden">
    <div class="hero-mesh-bg" aria-hidden="true"></div>

    <div class="relative max-w-5xl mx-auto px-4 sm:px-6 lg:px-8 text-center">
      <!-- Privacy Badge -->
      <div class="inline-flex items-center gap-1.5 px-3 py-1 rounded-full text-xs font-semibold bg-blue-50 dark:bg-blue-950/50 text-blue-600 dark:text-blue-400 border border-blue-200 dark:border-blue-900/50 mb-3 shadow-2xs">
        <ToolIcon name="shield-check" class="w-3.5 h-3.5" />
        <span>100% In-Browser Privacy • Zero Server Uploads</span>
      </div>

      <!-- Hero Title -->
      <h1 class="text-3xl sm:text-4xl md:text-5xl font-bold tracking-tight text-slate-900 dark:text-white">
        Free Online Image Compressor & Exact KB Reducer
      </h1>

      <!-- Subtitle -->
      <p class="mt-3 sm:mt-4 text-base sm:text-lg text-slate-600 dark:text-slate-400 max-w-2xl mx-auto leading-relaxed">
        Compress JPG, PNG, and WebP images by percentage or target exact file sizes (20 KB, 50 KB, 100 KB) with 100% in-browser privacy and zero server uploads.
      </p>

      <!-- Value Propositions Pills -->
      <div class="mt-6 flex flex-wrap items-center justify-center gap-2 sm:gap-3 text-xs sm:text-sm font-medium text-slate-600 dark:text-slate-400">
        <div class="inline-flex items-center gap-1.5 px-3 py-1 rounded-lg bg-white/70 dark:bg-slate-900/60 border border-slate-200 dark:border-slate-800 shadow-2xs">
          <ToolIcon name="shield-check" class="w-4 h-4 text-emerald-500" />
          <span>100% Client-Side Sandbox</span>
        </div>
        <div class="inline-flex items-center gap-1.5 px-3 py-1 rounded-lg bg-white/70 dark:bg-slate-900/60 border border-slate-200 dark:border-slate-800 shadow-2xs">
          <ToolIcon name="zap" class="w-4 h-4 text-blue-500" />
          <span>Lossy & Lossless Quantization</span>
        </div>
        <div class="inline-flex items-center gap-1.5 px-3 py-1 rounded-lg bg-white/70 dark:bg-slate-900/60 border border-slate-200 dark:border-slate-800 shadow-2xs">
          <ToolIcon name="scale" class="w-4 h-4 text-purple-500" />
          <span>Batch Processing up to 15 Files</span>
        </div>
      </div>
    </div>
  </section>

  <!-- Interactive Studio Container -->
  <section id="tool-workspace" class="max-w-6xl mx-auto px-4 sm:px-6 lg:px-8 pb-16 sm:pb-24 scroll-mt-20">
    <div id="image-compressor-root" class="w-full">

      <!-- INITIAL STATE: Drag & Drop Zone -->
      <div id="dropzone-view" class="transition-all duration-300">
        <div
          id="dropzone"
          class="relative group rounded-3xl border-2 border-dashed border-slate-300 dark:border-slate-700 hover:border-blue-500 dark:hover:border-blue-400 bg-white/70 dark:bg-slate-900/50 backdrop-blur-sm px-6 py-10 sm:px-10 sm:py-14 text-center cursor-pointer transition-all duration-200 hover:shadow-xl hover:shadow-blue-500/5 hover:-translate-y-0.5"
        >
          <input
            type="file"
            id="imageInput"
            class="hidden"
            accept="image/jpeg,image/png,image/webp,image/avif"
            multiple
          />

          <div class="max-w-lg mx-auto flex flex-col items-center">
            <!-- Batch Queue Pill -->
            <div class="inline-flex items-center gap-1.5 px-3 py-0.5 rounded-full text-xs font-semibold bg-blue-50 dark:bg-blue-950/40 text-blue-600 dark:text-blue-400 border border-blue-100 dark:border-blue-900/50 mb-3 shadow-2xs">
              <svg class="w-3.5 h-3.5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                <path stroke-linecap="round" stroke-linejoin="round" d="M6 6.878V6a2.25 2.25 0 012.25-2.25h7.5A2.25 2.25 0 0118 6v.878m-12 0c.235-.083.487-.128.75-.128h10.5c.263 0 .515.045.75.128m-12 0A2.25 2.25 0 004.5 9v.878m13.5-3A2.25 2.25 0 0119.5 9v.878m-15 0a2.246 2.246 0 00-.75.128m16.5 0c-.235-.083-.487-.128-.75-.128m-15 0A2.25 2.25 0 003 12v6.75A2.25 2.25 0 005.25 21h13.5A2.25 2.25 0 0021 18.75V12a2.25 2.25 0 00-1.5-2.122" />
              </svg>
              <span>Batch Queue: Up to 15 Images</span>
            </div>

            <!-- Minimalist Icon -->
            <div class="w-14 h-14 rounded-2xl bg-blue-50 dark:bg-blue-950/40 text-blue-600 dark:text-blue-400 flex items-center justify-center mb-4 group-hover:scale-110 transition-transform duration-200 shadow-sm border border-blue-100 dark:border-blue-900/50">
              <ToolIcon name="minimize-2" class="w-7 h-7" />
            </div>

            <!-- Headline & CTA -->
            <h3 class="text-xl sm:text-2xl font-semibold text-slate-900 dark:text-white tracking-tight">
              <span class="sm:hidden">Tap to select photos or drop here</span>
              <span class="hidden sm:inline">Drop your images here (up to 15)</span>
            </h3>
            <p class="mt-2 text-xs sm:text-sm text-slate-500 dark:text-slate-400 max-w-sm">
              Supports JPG, PNG, WebP, and AVIF. Paste from clipboard (<kbd class="px-1.5 py-0.5 text-xs font-mono bg-slate-100 dark:bg-slate-800 rounded border border-slate-200 dark:border-slate-700">Ctrl+V</kbd>).
            </p>

            <!-- Primary Action Button -->
            <div class="mt-5 flex items-center justify-center">
              <button
                type="button"
                id="selectBtn"
                class="px-7 py-3 rounded-full bg-slate-900 hover:bg-slate-800 dark:bg-white dark:hover:bg-slate-100 text-white dark:text-slate-900 font-semibold text-sm transition-all shadow-md hover:shadow-lg active:scale-95 cursor-pointer"
              >
                Select Images (1–15)
              </button>
            </div>

            <!-- Privacy Guarantee Badge -->
            <div class="mt-6 pt-4 border-t border-slate-200/70 dark:border-slate-800/80 w-full flex items-center justify-center">
              <div class="inline-flex items-center justify-center gap-1.5 font-medium text-emerald-600 dark:text-emerald-400 text-xs">
                <ToolIcon name="shield-check" class="w-4 h-4 shrink-0" />
                <span>100% Client-Side Sandbox • Zero Server Network Calls</span>
              </div>
            </div>
          </div>
        </div>
      </div>

      <!-- ACTIVE STATE: Compression Workspace -->
      <div id="editor-view" class="hidden space-y-6">

        <!-- Top Queue Tray (Up to 15 items) -->
        <div class="rounded-2xl border border-slate-200 dark:border-slate-800 bg-white/80 dark:bg-slate-900/80 backdrop-blur-sm p-4 shadow-xs">
          <div class="flex items-center justify-between mb-3 px-1">
            <div class="flex items-center gap-2">
              <span class="text-xs font-semibold uppercase tracking-wider text-slate-500 dark:text-slate-400">
                Image Queue (<span id="queue-counter" class="font-mono font-bold text-blue-600 dark:text-blue-400">1/15</span>)
              </span>
              <span class="hidden sm:inline-block text-[11px] text-slate-400 font-normal">
                • Select an image to preview and adjust
              </span>
            </div>

            <div class="flex items-center gap-2">
              <button
                type="button"
                id="add-more-btn"
                class="inline-flex items-center gap-1 px-3 py-1 rounded-lg text-xs font-medium bg-slate-100 dark:bg-slate-800 hover:bg-slate-200 dark:hover:bg-slate-700 text-slate-700 dark:text-slate-200 transition cursor-pointer"
              >
                <span>+ Add More</span>
              </button>
              <button
                type="button"
                id="clear-all-btn"
                class="text-xs text-rose-500 hover:text-rose-600 dark:hover:text-rose-400 font-medium transition cursor-pointer px-2 py-1"
              >
                Clear All
              </button>
            </div>
          </div>

          <!-- Horizontal Scrollable Thumbnail Cards -->
          <div id="queue-strip" class="flex items-center gap-3 overflow-x-auto pb-2 pt-1 px-1 scroll-smooth">
            <!-- Dynamic thumbnails injected by JavaScript -->
          </div>
        </div>

        <!-- Main Studio Grid: Split Screen Comparison (Left) & Controls (Right) -->
        <div class="grid grid-cols-1 lg:grid-cols-12 gap-6">

          <!-- Left Column: Interactive Comparison Viewer (7 cols) -->
          <div class="lg:col-span-7 flex flex-col gap-4">
            
            <!-- Comparison Card -->
            <div class="rounded-2xl border border-slate-200 dark:border-slate-800 bg-white dark:bg-slate-900 p-4 sm:p-5 shadow-xs flex flex-col h-full">
              
              <!-- Viewer Header & Reduction Banner -->
              <div class="flex flex-wrap items-center justify-between gap-3 pb-3 border-b border-slate-100 dark:border-slate-800">
                <div class="min-w-0">
                  <h4 id="active-filename" class="text-sm font-semibold text-slate-900 dark:text-white truncate max-w-xs sm:max-w-sm">
                    photo.jpg
                  </h4>
                  <p id="active-specs" class="text-xs text-slate-500 dark:text-slate-400 font-mono mt-0.5">
                    Original: 1920 × 1080 px • 240 KB
                  </p>
                </div>

                <!-- Reduction Pill Badge -->
                <div id="reduction-badge" class="inline-flex items-center gap-1.5 px-3 py-1 rounded-full text-xs font-bold bg-emerald-50 dark:bg-emerald-950/60 text-emerald-600 dark:text-emerald-400 border border-emerald-200 dark:border-emerald-900/50 shadow-2xs">
                  <span id="reduction-text">Saved 68% • 240 KB → 76 KB</span>
                </div>
              </div>

              <!-- Comparison Mode Toggle Buttons -->
              <div class="flex items-center justify-between py-2.5">
                <span class="text-xs font-medium text-slate-500 dark:text-slate-400">
                  Comparison Mode:
                </span>
                <div class="inline-flex p-0.5 rounded-lg bg-slate-100 dark:bg-slate-800 border border-slate-200 dark:border-slate-700 text-xs font-medium">
                  <button
                    type="button"
                    id="view-mode-split"
                    class="px-2.5 py-1 rounded-md bg-white dark:bg-slate-900 text-blue-600 dark:text-blue-400 shadow-2xs font-semibold cursor-pointer transition"
                  >
                    Split Slider
                  </button>
                  <button
                    type="button"
                    id="view-mode-side"
                    class="px-2.5 py-1 rounded-md text-slate-600 dark:text-slate-400 hover:text-slate-900 dark:hover:text-white cursor-pointer transition"
                  >
                    Side-by-Side
                  </button>
                </div>
              </div>

              <!-- Stage 1: Interactive Draggable Split-Screen Slider -->
              <div
                id="split-slider-container"
                class="relative w-full max-h-[360px] h-[340px] sm:h-[360px] flex items-center justify-center overflow-hidden rounded-xl bg-slate-900/60 select-none border border-slate-200/80 dark:border-slate-800/80 touch-none cursor-ew-resize"
              >
                <!-- Original Image (Base Layer) -->
                <img
                  id="preview-original-img"
                  class="absolute inset-0 w-full h-full object-contain pointer-events-none select-none"
                  alt="Original Image"
                />
                <span class="absolute top-3 right-3 px-2 py-0.5 text-[10px] font-bold uppercase tracking-wider bg-slate-900/80 text-white rounded backdrop-blur-xs z-10 pointer-events-none select-none shadow-xs">
                  Original (<span id="slider-orig-size">240 KB</span>)
                </span>

                <!-- Compressed Image (Overlay Layer clipped by divider) -->
                <div
                  id="split-compressed-wrapper"
                  class="absolute inset-0 w-full h-full overflow-hidden pointer-events-none select-none"
                  style="clip-path: inset(0 50% 0 0); -webkit-clip-path: inset(0 50% 0 0);"
                >
                  <img
                    id="preview-compressed-img"
                    class="absolute inset-0 w-full h-full object-contain pointer-events-none select-none"
                    alt="Compressed Image"
                  />
                  <span class="absolute top-3 left-3 px-2 py-0.5 text-[10px] font-bold uppercase tracking-wider bg-blue-600/90 text-white rounded backdrop-blur-xs z-10 pointer-events-none select-none shadow-xs">
                    Compressed (<span id="slider-comp-size">76 KB</span>)
                  </span>
                </div>

                <!-- Draggable Divider Line & Handle -->
                <div
                  id="split-handle"
                  class="absolute top-0 bottom-0 w-0.5 bg-white cursor-ew-resize z-20 shadow-[0_0_10px_rgba(0,0,0,0.5)] touch-none flex items-center justify-center pointer-events-none"
                  style="left: 50%; transform: translateX(-50%);"
                >
                  <div class="w-7 h-7 rounded-full bg-white dark:bg-slate-900 text-slate-800 dark:text-white border-2 border-blue-500 shadow-md flex items-center justify-center text-[10px] font-bold select-none pointer-events-auto cursor-ew-resize">
                    ◂▸
                  </div>
                </div>

                <!-- Processing Overlay Spinner -->
                <div
                  id="compression-spinner"
                  class="hidden absolute inset-0 bg-slate-900/50 backdrop-blur-2xs z-30 flex flex-col items-center justify-center text-white text-xs gap-2"
                >
                  <div class="w-8 h-8 border-3 border-white/20 border-t-blue-500 rounded-full animate-spin"></div>
                  <span class="font-medium font-mono" id="spinner-status">Running binary quantization...</span>
                </div>
              </div>

              <!-- Stage 2: Side-by-Side Dual View (Hidden by default) -->
              <div id="side-by-side-container" class="hidden grid grid-cols-2 gap-3 w-full max-h-[360px] h-[340px] sm:h-[360px] overflow-hidden rounded-xl">
                <!-- Card 1: Original -->
                <div class="relative rounded-xl border border-slate-200 dark:border-slate-800 bg-slate-100 dark:bg-slate-950 overflow-hidden flex flex-col">
                  <div class="p-2 border-b border-slate-200 dark:border-slate-800 flex items-center justify-between text-[11px] font-semibold text-slate-700 dark:text-slate-300">
                    <span>Original</span>
                    <span id="side-orig-size" class="font-mono text-slate-500">240 KB</span>
                  </div>
                  <div class="relative flex-1 p-2 flex items-center justify-center">
                    <img id="side-orig-img" class="max-w-full max-h-full object-contain" alt="Original" />
                  </div>
                </div>

                <!-- Card 2: Compressed -->
                <div class="relative rounded-xl border border-blue-200 dark:border-blue-900/60 bg-blue-50/20 dark:bg-blue-950/20 overflow-hidden flex flex-col">
                  <div class="p-2 border-b border-blue-100 dark:border-blue-900/50 flex items-center justify-between text-[11px] font-semibold text-blue-700 dark:text-blue-300">
                    <span>Compressed</span>
                    <span id="side-comp-size" class="font-mono font-bold text-emerald-600 dark:text-emerald-400">76 KB</span>
                  </div>
                  <div class="relative flex-1 p-2 flex items-center justify-center">
                    <img id="side-comp-img" class="max-w-full max-h-full object-contain" alt="Compressed" />
                  </div>
                </div>
              </div>

              <!-- Slider Helper Instructions -->
              <div class="mt-3 flex items-center justify-between text-[11px] text-slate-500 dark:text-slate-400">
                <span class="flex items-center gap-1">
                  <ToolIcon name="info" class="w-3.5 h-3.5 text-blue-500 shrink-0" />
                  Drag the center divider to inspect fine photographic details and edge sharpness.
                </span>
                <span id="compression-time" class="font-mono text-[10px] text-slate-400">0.08s</span>
              </div>

            </div>

          </div>

          <!-- Right Column: Compression Controls Deck (5 cols) -->
          <div class="lg:col-span-5 flex flex-col gap-4">

            <!-- Control Box -->
            <div class="rounded-2xl border border-slate-200 dark:border-slate-800 bg-white dark:bg-slate-900 p-5 shadow-xs space-y-5">
              
              <!-- Mode Tabs: Mode A (Target KB) vs Mode B (Visual Quality) -->
              <div>
                <label class="block text-xs font-semibold uppercase tracking-wider text-slate-500 dark:text-slate-400 mb-2">
                  Compression Mode
                </label>
                <div class="grid grid-cols-2 p-1 rounded-xl bg-slate-100 dark:bg-slate-800 border border-slate-200 dark:border-slate-700 gap-1">
                  <button
                    type="button"
                    id="tab-mode-target-kb"
                    class="py-2 px-3 rounded-lg text-xs font-semibold bg-white dark:bg-slate-900 text-blue-600 dark:text-blue-400 shadow-2xs transition cursor-pointer flex items-center justify-center gap-1.5"
                  >
                    <ToolIcon name="binary" class="w-3.5 h-3.5" />
                    <span>Target Exact KB</span>
                  </button>
                  <button
                    type="button"
