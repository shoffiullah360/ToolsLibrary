                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7" />
              </svg>
              <a href="/tools/image-converter/" class="hover:text-blue-600 dark:hover:text-blue-400 transition-colors">Tools</a>
            </div>
          </li>
          <li aria-current="page">
            <div class="flex items-center">
              <svg class="w-3 h-3 text-slate-400 mx-1" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7" />
              </svg>
              <span class="text-slate-900 dark:text-white font-semibold">Image Converter</span>
            </div>
          </li>
        </ol>
      </nav>

      <!-- Hero Title -->
      <h1 class="text-3xl sm:text-4xl md:text-5xl font-bold tracking-tight text-slate-900 dark:text-white">
        Free Image Converter Online
      </h1>
    </div>
  </section>

  <!-- 2. Interactive Converter Dropzone & Queue (Above-the-fold) -->
  <section id="tool-workspace" class="max-w-6xl mx-auto px-4 sm:px-6 lg:px-8 pb-16 sm:pb-24 scroll-mt-20">
    <ImageConverter />

    <!-- Relocated Description Text Directly Under Upload Container -->
    <p class="mt-6 max-w-3xl mx-auto text-slate-600 dark:text-slate-300 text-center leading-relaxed text-sm md:text-base">
      Convert JPG, PNG, WebP, AVIF, SVG, BMP, GIF, ICO, and PDF in seconds without file size limits, server queues, or privacy risks.
    </p>

    <div class="bg-slate-900/60 border border-slate-800 rounded-xl p-5 md:p-6 text-slate-300 text-sm md:text-base leading-relaxed max-w-4xl mx-auto my-6">
      <p>
        Seamlessly execute lossless and lossy format migrations with dedicated alpha transparency handling and maximum compression efficiency. Convert legacy images to next-generation WebP or AVIF to drastically reduce web page weight, transcode camera captures to universally compatible JPEG, or export uncompressed PNG graphics with clean edge compositing. Every conversion runs directly in your local browser sandbox, preventing upload latency while ensuring sensitive documents and personal photos remain completely secure.
      </p>
    </div>
  </section>

  <!-- 3. SECTION: How to Convert Images Online in 3 Simple Steps -->
