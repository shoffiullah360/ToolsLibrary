const canonicalUrl = "https://fasttoolverse.com/tools/image-converter/";
const pageTitle = "Free Image Converter Online (JPG, PNG, WebP, AVIF, PDF) - FastToolVerse";
const pageDescription = "Convert images online for free with 100% privacy. Convert JPG, PNG, WebP, AVIF, and PDF in seconds without file size limits, server uploads, or quality loss.";
const pageKeywords = "image converter, free image converter, convert jpg to webp, convert png to jpg, convert image to pdf, avif converter, batch image converter, client side image converter, convertio alternative, transparent png to jpg, svg to png converter, multi page image to pdf";
