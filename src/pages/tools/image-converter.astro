    <!-- Open Graph tags -->
    <meta property="og:type" content="website" />
    <meta property="og:title" content="Free Image Converter Online - High Quality & Zero Uploads" />
    <meta property="og:description" content="Fast, free, and secure online image converter. Convert JPG, PNG, WebP, AVIF, HEIC to JPG, transparent PNGs, and compile JPG to PDF directly in your browser." />
    <meta property="og:url" content="https://fasttoolverse.com/tools/image-converter/" />
    <meta property="og:site_name" content="FastToolVerse" />
    <meta property="og:image" content="https://fasttoolverse.com/og-image-converter.png" />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content="FastToolVerse Online Image Converter" />

    <!-- Twitter Card -->
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content="Free Online Image Converter - FastToolVerse" />
    <meta name="twitter:description" content="Instant browser-native image conversion without file limits or privacy risks. Free image converter to JPG, PNG, WebP, and PDF." />
    <meta name="twitter:image" content="https://fasttoolverse.com/og-image-converter.png" />

    <!-- Structured Data Schemas -->
    <script type="application/ld+json" set:html={JSON.stringify(jsonLdSoftwareApp)} />
    <script type="application/ld+json" set:html={JSON.stringify(jsonLdFaq)} />
  </Fragment>


