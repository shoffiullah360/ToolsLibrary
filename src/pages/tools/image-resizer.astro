            <span class="inline-block px-2.5 py-1 rounded-full text-xs font-bold bg-purple-50 dark:bg-purple-950/50 text-purple-600 dark:text-purple-400 mb-1">Target &le; 50 KB</span>
            <p class="text-xs text-slate-500 dark:text-slate-400">Balanced clarity and lightness for digital resumes, ID cards, and user profiles.</p>
            <span class="text-xs font-semibold text-purple-600 dark:text-purple-400 mt-2 inline-flex items-center gap-1 group-hover:underline">
              Compress to 50KB &rarr;
            </span>
          </a>
          <a
            href="/compress-image-to-100kb"
            class="group p-4 rounded-xl border border-slate-200 dark:border-slate-800 bg-white dark:bg-slate-900 hover:border-emerald-500 shadow-2xs text-center transition block"
          >
            <span class="inline-block px-2.5 py-1 rounded-full text-xs font-bold bg-emerald-50 dark:bg-emerald-950/50 text-emerald-600 dark:text-emerald-400 mb-1">Target &le; 100 KB</span>
            <p class="text-xs text-slate-500 dark:text-slate-400">Standard for high-speed e-commerce product catalogs and responsive web heroes.</p>
            <span class="text-xs font-semibold text-emerald-600 dark:text-emerald-400 mt-2 inline-flex items-center gap-1 group-hover:underline">
              Compress to 100KB &rarr;
            </span>
          </a>
        </div>
        <p class="text-sm sm:text-base text-slate-600 dark:text-slate-300 leading-relaxed pt-2">
          Interactive real-time badges display live percentage reduction statistics directly in the interface, providing full transparency on before-and-after byte weights before you save the file.
        </p>
      </div>

    </div>
  </section>

  <!-- Bottom "Jump to Upload" CTA Banner -->
  <section class="max-w-4xl mx-auto px-4 sm:px-6 py-6 sm:py-8">
    <div class="rounded-2xl p-6 sm:p-8 bg-gradient-to-r from-blue-600 via-indigo-600 to-blue-700 text-white shadow-xl shadow-blue-500/10 flex flex-col sm:flex-row items-center justify-between gap-5 text-center sm:text-left">
      <div class="space-y-1">
        <h3 class="text-lg sm:text-xl font-bold tracking-tight text-white">
          Ready to resize images with zero latency?
        </h3>
        <p class="text-xs sm:text-sm text-blue-100 max-w-md">
          100% private, client-side HTML5 Canvas engine. No watermarks, no file limits, zero cloud uploads.
        </p>
      </div>
      <a
        href="#tool-workspace"
        class="inline-flex items-center justify-center gap-2 px-6 py-3 rounded-xl bg-white text-slate-900 hover:bg-blue-50 font-semibold text-xs sm:text-sm shadow-md hover:shadow-lg transition-all active:scale-95 shrink-0"
      >
        <span>Upload & Resize Now</span>
        <span aria-hidden="true" class="text-base font-bold leading-none">↑</span>
      </a>
    </div>
  </section>

  <!-- FAQ Section (SEO crawlable) -->
  <section class="py-16 sm:py-24">
    <div class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8">
      
      <div class="text-center mb-12">
        <h2 class="text-2xl sm:text-3xl font-bold tracking-tight text-slate-900 dark:text-white">
          Frequently Asked Questions
        </h2>
        <p class="mt-2 text-sm sm:text-base text-slate-600 dark:text-slate-400">
          Everything you need to know about image resizing, dimensions, and browser privacy.
        </p>
      </div>

      <!-- Semantic FAQ List -->
      <div class="space-y-4">
        {faqs.map((faq) => (
          <details class="group rounded-2xl border border-slate-200 dark:border-slate-800 bg-white dark:bg-slate-900 p-5 transition-all duration-200 open:shadow-xs">
            <summary class="flex items-center justify-between font-semibold text-sm sm:text-base text-slate-900 dark:text-white cursor-pointer list-none select-none">
              <span>{faq.question}</span>
              <span class="ml-4 flex-shrink-0 w-6 h-6 rounded-full bg-slate-100 dark:bg-slate-800 flex items-center justify-center text-slate-500 group-open:rotate-180 transition-transform duration-200">
                <svg class="w-3.5 h-3.5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5">
                  <path stroke-linecap="round" stroke-linejoin="round" d="M19.5 8.25l-7.5 7.5-7.5-7.5" />
                </svg>
              </span>
            </summary>
            <p class="mt-3 text-sm text-slate-600 dark:text-slate-400 leading-relaxed pt-2 border-t border-slate-100 dark:border-slate-800/80">
              {faq.answer}
            </p>
          </details>
        ))}
      </div>

    </div>
  </section>

  <!-- Related Tools Row -->
  <section class="border-t border-slate-200 dark:border-slate-800 bg-slate-50/50 dark:bg-slate-900/40 py-12 sm:py-16">
    <div class="max-w-5xl mx-auto px-4 sm:px-6 lg:px-8 text-center">
      <h3 class="text-lg font-semibold text-slate-900 dark:text-white mb-6">
        Explore Related Image Utilities
      </h3>
      <div class="flex flex-wrap justify-center gap-3">
        <a
          href="/tools/image-compressor"
          class="inline-flex items-center gap-2 px-4 py-2 rounded-xl border border-slate-200 dark:border-slate-800 bg-white dark:bg-slate-900 text-xs font-medium text-slate-700 dark:text-slate-300 hover:border-blue-500 transition shadow-2xs"
        >
          <ToolIcon name="minimize-2" class="w-4 h-4 text-blue-500" />
          <span>Image Compressor</span>
        </a>
        <a
          href="/tools/image-cropper"
          class="inline-flex items-center gap-2 px-4 py-2 rounded-xl border border-slate-200 dark:border-slate-800 bg-white dark:bg-slate-900 text-xs font-medium text-slate-700 dark:text-slate-300 hover:border-blue-500 transition shadow-2xs"
        >
          <ToolIcon name="crop" class="w-4 h-4 text-purple-500" />
          <span>Image Cropper</span>
        </a>
        <a
          href="/tools/image-rotator"
          class="inline-flex items-center gap-2 px-4 py-2 rounded-xl border border-slate-200 dark:border-slate-800 bg-white dark:bg-slate-900 text-xs font-medium text-slate-700 dark:text-slate-300 hover:border-blue-500 transition shadow-2xs"
        >
          <ToolIcon name="rotate-cw" class="w-4 h-4 text-emerald-500" />
          <span>Image Rotator</span>
        </a>
        <a
          href="/tools/image-flipper"
          class="inline-flex items-center gap-2 px-4 py-2 rounded-xl border border-slate-200 dark:border-slate-800 bg-white dark:bg-slate-900 text-xs font-medium text-slate-700 dark:text-slate-300 hover:border-blue-500 transition shadow-2xs"
        >
          <ToolIcon name="flip-horizontal" class="w-4 h-4 text-cyan-500" />
          <span>Image Flipper</span>
        </a>
      </div>
    </div>
  </section>

</Layout>

