---
import Layout from '../../layouts/Layout.astro';
import ImageResizer from '../../components/tools/ImageResizer.astro';
import ToolIcon from '../../components/ToolIcon.astro';
import pagesData from '../../data/resizer-pages.json';

// FAQ Content for Schema and UI
const faqs = [
  {
    question: "How to resize an image without losing quality?",
    answer: "To resize an image without losing quality, downscale proportionally while keeping the aspect ratio locked. FastToolVerse uses high-fidelity bicubic interpolation to preserve crisp lines, edge sharpness, and color fidelity. If changing proportions, use 'Fit' (adds padding) or 'Fill / Crop' rather than stretching to avoid distortion."
  },
  {
    question: "How can I resize a JPG image to 50kb?",
    answer: "Switch to the 'Export Settings' tab, check 'Target Max File Size', and enter 50 KB. Our client-side binary search algorithm automatically recalculates optimal JPEG compression quantization across 7 iterative passes in milliseconds, guaranteeing your file stays under 50KB while retaining maximum visual clarity."
  },
  {
    question: "How to change photo size to 4.5 * 3.5 cm?",
    answer: "Select 'cm' (centimeters) as your measurement unit in the dimensions tab, enter 3.5 cm for Width and 4.5 cm for Height (the standard passport and visa photo size), and set print resolution to 300 DPI. The tool automatically computes the exact pixel dimensions (413 × 531 px at 300 DPI) required for official submission."
  },
  {
    question: "How do I resize an image to 300x300 pixels?",
    answer: "Set your dimension unit to 'px' (pixels) and enter 300 in both the Width and Height inputs. If your original image is not 1:1 square, choose 'Fill / Crop' to cleanly center-crop the photo without distortion, or 'Fit' to preserve the entire image with clean borders."
  },
  {
    question: "How do I resize the KB of an image?",
    answer: "You can resize the KB (file weight) of an image by downscaling dimensions or adjusting compression quality. In FastToolVerse, navigate to 'Export Settings', enable 'Target Max File Size', and type your desired threshold (e.g., 20KB, 50KB, or 500KB). The browser dynamically optimizes image data to fit under that limit instantly, or lets you boost canvas resolution to proportionally match your target size if your uploaded photo is currently smaller."
  },
  {
    question: "What is a safe image resizer?",
    answer: "A safe image resizer processes photos entirely client-side on your local device without uploading them to remote cloud servers. FastToolVerse executes 100% inside your browser sandbox using HTML5 Canvas APIs, ensuring sensitive personal IDs, financial documents, and private photos never leave your computer."
  },
  {
    question: "How can I resize a PNG image?",
    answer: "Upload your PNG image, set your desired dimensions or percentage scale, and select 'PNG' under Export Format. FastToolVerse preserves 24-bit RGB colors and 8-bit alpha transparency channels, making it ideal for logos, digital signatures, icons, and graphics with transparent backgrounds."
  },
  {
    question: "How can you enlarge a small photo without pixelation?",
    answer: "When upscaling a small photo, pixelation occurs if pixels are simply stretched. FastToolVerse utilizes smooth multi-pass interpolation algorithms that intelligently interpolate intermediate color gradients between adjacent pixels. For best results, keep the aspect ratio locked and export in lossless PNG or WebP format."
  },
  {
    question: "How does batch image resizing work?",
    answer: "Batch resizing lets you upload up to 15 photos simultaneously. You configure your desired dimensions, scaling percentage, or target file size once, and FastToolVerse processes all files concurrently using parallel browser threads. You can then download the processed files individually or packed together in a single ZIP archive."
  },
  {
    question: "What is the difference between image resizing and image compression?",
    answer: "Image resizing changes the physical pixel dimensions (width and height) of a picture, which directly impacts screen and print size. Image compression reduces the digital file weight (KB/MB) by optimizing pixel color data and removing redundant metadata, often without altering pixel dimensions."
  },
  {
    question: "Can I resize photos on my phone?",
    answer: "Yes. FastToolVerse is fully responsive and optimized for mobile browsers on iOS (Safari, Chrome) and Android. You can upload photos directly from your smartphone camera roll, adjust dimensions or target KB, and save resized images directly to your mobile device with no app installation required."
  },
  {
    question: "Is this online image resizer completely free with no watermark?",
    answer: "Yes, FastToolVerse Image Resizer is 100% free with no registration, no subscription fees, no file limits, and absolutely no watermarks on your exported images. Every feature, including batch processing and precision KB targeting, is unrestricted."
  }
];

// Schema.org SoftwareApplication
const jsonLdSoftwareApp = {
  "@context": "https://schema.org",
  "@type": "SoftwareApplication",
  "name": "Free Online Image Resizer & Batch Converter",
  "applicationCategory": "MultimediaApplication",
  "operatingSystem": "All",
  "browserRequirements": "Requires JavaScript. Requires HTML5 Canvas support.",
  "offers": {
    "@type": "Offer",
    "price": "0",
    "priceCurrency": "USD"
  },
  "featureList": [
    "100% Client-side privacy",
    "Batch resize up to 15 images",
    "Export JPG, PNG, WebP, AVIF, PDF, ICO",
    "Direct inline Rotate, Flip, and Crop",
    "Verified Social Media & Platform Presets"
  ]
};

// Schema.org FAQPage
const jsonLdFaq = {
  "@context": "https://schema.org",
  "@type": "FAQPage",
  "mainEntity": faqs.map((f) => ({
    "@type": "Question",
    "name": f.question,
    "acceptedAnswer": {
      "@type": "Answer",
      "text": f.answer
    }
  }))
};

const canonicalUrl = "https://fasttoolverse.com/tools/image-resizer";
const pageTitle = "Free Online Image Resizer - Fast, Lossless & 100% Private | FastToolVerse";
const pageDescription = "Free online image resizer in pixels, cm, or inches. Batch resize, adjust DPI, and reduce image size in KB with zero quality loss. 100% private in-browser.";
const pageKeywords = "image resizer, batch image resizer, resize image without losing quality, reduce image size in kb, image resizer in pixels, lossless image resizer, image dpi resizer, high resolution image resizer, client-side private image tool";
const ogImage = "https://fasttoolverse.com/og-image.png";
---

<Layout
  title={pageTitle}
  description={pageDescription}
  canonicalUrl={canonicalUrl}
  image={ogImage}
>
  <!-- Injected Head Elements: Twitter name tags & JSON-LD Schemas -->
  <Fragment slot="head">
    <meta name="keywords" content={pageKeywords} />

    <!-- Open Graph tags -->
    <meta property="og:type" content="website" />
    <meta property="og:url" content={canonicalUrl} />
    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={pageDescription} />
    <meta property="og:image" content={ogImage} />

    <!-- Twitter Card Name Standards -->
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:url" content={canonicalUrl} />
    <meta name="twitter:title" content={pageTitle} />
    <meta name="twitter:description" content={pageDescription} />
    <meta name="twitter:image" content={ogImage} />

    <!-- Structured Data Schemas -->
    <script type="application/ld+json" set:html={JSON.stringify(jsonLdSoftwareApp)} />
    <script type="application/ld+json" set:html={JSON.stringify(jsonLdFaq)} />
  </Fragment>

  <!-- Hero Header Section -->
  <section class="relative pt-12 pb-6 sm:pt-16 sm:pb-8 overflow-hidden">
    <div class="hero-mesh-bg" aria-hidden="true"></div>

    <div class="relative max-w-5xl mx-auto px-4 sm:px-6 lg:px-8 text-center">
      <div class="inline-flex items-center gap-1.5 px-3 py-1 rounded-full text-xs font-semibold bg-blue-50 dark:bg-blue-950/50 text-blue-600 dark:text-blue-400 border border-blue-200 dark:border-blue-900/50 mb-3">
        <ToolIcon name="shield-check" class="w-3.5 h-3.5" />
        <span>100% In-Browser Privacy • Zero Server Uploads</span>
      </div>

      <!-- Minimalist Hero Title -->
      <h1 class="text-3xl sm:text-4xl md:text-5xl font-bold tracking-tight text-slate-900 dark:text-white">
        Free Online Image Resizer & Batch Converter
      </h1>

      <!-- Subtitle -->
      <p class="mt-3 sm:mt-4 text-base sm:text-lg text-slate-600 dark:text-slate-400 max-w-2xl mx-auto leading-relaxed">
        Resize, convert, crop, and optimize photos by exact pixel dimensions, physical units (in, cm, mm), or target file size (KB).
      </p>
    </div>
  </section>

  <!-- Interactive Studio Container -->
  <section id="tool-workspace" class="max-w-6xl mx-auto px-4 sm:px-6 lg:px-8 pb-16 sm:pb-24 scroll-mt-20">
    <ImageResizer />
  </section>

  <!-- 3-Step Guide Section -->
  <section class="border-t border-slate-200 dark:border-slate-800 bg-slate-50/50 dark:bg-slate-900/40 py-16 sm:py-20">
    <div class="max-w-5xl mx-auto px-4 sm:px-6 lg:px-8">
      
      <div class="text-center max-w-2xl mx-auto mb-12">
        <h2 class="text-2xl sm:text-3xl font-bold tracking-tight text-slate-900 dark:text-white">
          How to Resize Images Online in 3 Simple Steps
        </h2>
        <p class="mt-2 text-sm sm:text-base text-slate-600 dark:text-slate-400">
          Fast, effortless, and private. Process high-resolution photos in your browser in seconds.
        </p>
      </div>

      <div class="grid grid-cols-1 md:grid-cols-3 gap-6 sm:gap-8">
        
        <!-- Step 1 -->
        <div class="p-6 rounded-2xl border border-slate-200 dark:border-slate-800 bg-white dark:bg-slate-900 shadow-xs relative">
          <div class="w-10 h-10 rounded-xl bg-blue-50 dark:bg-blue-950/40 text-blue-600 dark:text-blue-400 flex items-center justify-center font-bold font-mono text-sm mb-4 border border-blue-100 dark:border-blue-900/50">
            01
          </div>
          <h3 class="text-base font-semibold text-slate-900 dark:text-white mb-2">
            Upload or Paste Images
          </h3>
          <p class="text-sm text-slate-600 dark:text-slate-400 leading-relaxed">
            Drag and drop up to 15 JPG, PNG, WebP, AVIF, PDF, or ICO files, browse your local drive, or paste directly from clipboard with <kbd class="px-1.5 py-0.5 text-xs font-mono bg-slate-100 dark:bg-slate-800 rounded border border-slate-200 dark:border-slate-700">Ctrl+V</kbd>.
          </p>
        </div>

        <!-- Step 2 -->
        <div class="p-6 rounded-2xl border border-slate-200 dark:border-slate-800 bg-white dark:bg-slate-900 shadow-xs relative">
          <div class="w-10 h-10 rounded-xl bg-blue-50 dark:bg-blue-950/40 text-blue-600 dark:text-blue-400 flex items-center justify-center font-bold font-mono text-sm mb-4 border border-blue-100 dark:border-blue-900/50">
            02
          </div>
          <h3 class="text-base font-semibold text-slate-900 dark:text-white mb-2">
            Set Dimensions & Units
          </h3>
          <p class="text-sm text-slate-600 dark:text-slate-400 leading-relaxed">
            Choose between PX, INCH, CM, MM, or %, or select one-click verified presets for Instagram, Facebook, YouTube, TikTok, LinkedIn, and more. Lock aspect ratios, select Fit (Keep bounds), or rotate and flip directly on the canvas.
          </p>
        </div>

        <!-- Step 3 -->
        <div class="p-6 rounded-2xl border border-slate-200 dark:border-slate-800 bg-white dark:bg-slate-900 shadow-xs relative">
          <div class="w-10 h-10 rounded-xl bg-blue-50 dark:bg-blue-950/40 text-blue-600 dark:text-blue-400 flex items-center justify-center font-bold font-mono text-sm mb-4 border border-blue-100 dark:border-blue-900/50">
            03
          </div>
          <h3 class="text-base font-semibold text-slate-900 dark:text-white mb-2">
            Export & Download
          </h3>
          <p class="text-sm text-slate-600 dark:text-slate-400 leading-relaxed">
            Select JPG, PNG, WebP, AVIF, PDF, or ICO. Target an exact file size limit (e.g. 50KB) or use the quality slider, then download instantly.
          </p>
        </div>

      </div>

    </div>
  </section>

  <!-- Other Popular Sizes & Formats Section -->
  <section class="border-t border-slate-200 dark:border-slate-800 bg-white dark:bg-slate-950/40 py-16 sm:py-20">
    <div class="max-w-6xl mx-auto px-4 sm:px-6 lg:px-8">
      
      <div class="text-center max-w-2xl mx-auto mb-12">
        <h2 class="text-2xl sm:text-3xl font-bold tracking-tight text-slate-900 dark:text-white">
          Other Popular Sizes & Formats
        </h2>
        <p class="mt-2 text-sm sm:text-base text-slate-600 dark:text-slate-400">
          Jump to other pre-configured photo dimensions, official requirements, and social media ratios.
        </p>
      </div>

      <div class="grid grid-cols-2 sm:grid-cols-2 md:grid-cols-3 lg:grid-cols-4 gap-2.5 sm:gap-4">
        {pagesData.map((page) => (
          <div class="group relative p-2.5 sm:p-4 rounded-xl sm:rounded-2xl border border-slate-200 dark:border-slate-800 bg-white dark:bg-slate-900/70 hover:border-blue-500/50 dark:hover:border-blue-500/50 hover:shadow-md transition-all flex flex-col justify-between">
            <div>
              <span class="inline-block text-[10px] sm:text-xs font-semibold px-2 py-0.5 sm:px-2.5 sm:py-1 rounded-full bg-blue-50 dark:bg-blue-950/60 text-blue-600 dark:text-blue-400 border border-blue-100 dark:border-blue-900/50 mb-1.5 sm:mb-3">
                {page.preset.targetSize ? `${page.preset.targetSize} ${page.preset.targetUnit || 'KB'} Target` : (page.preset.width ? `${page.preset.width} × ${page.preset.height} ${page.preset.unit || 'px'}` : page.category.toUpperCase())}
              </span>
              <h3 class="text-xs sm:text-sm font-semibold text-slate-900 dark:text-white group-hover:text-blue-600 dark:group-hover:text-blue-400 transition-colors line-clamp-2 leading-snug mb-2 sm:mb-4">
                {page.h1}
              </h3>
            </div>
            <a
              href={`/${page.slug}`}
              class="text-[11px] sm:text-xs font-semibold text-blue-600 dark:text-blue-400 hover:text-blue-700 dark:hover:text-blue-300 inline-flex items-center gap-1 mt-auto after:absolute after:inset-0"
            >
              Resize now →
            </a>
          </div>
        ))}
      </div>

    </div>
  </section>

  <!-- Comparison Matrix Section ("Why Choose FastToolVerse vs Others") -->
  <section class="border-t border-slate-200 dark:border-slate-800 bg-white dark:bg-slate-950/60 py-16 sm:py-24">
    <div class="max-w-5xl mx-auto px-4 sm:px-6 lg:px-8">
      
      <div class="text-center max-w-2xl mx-auto mb-12 sm:mb-16">
        <div class="inline-flex items-center gap-1.5 px-3 py-1 rounded-full text-xs font-semibold bg-blue-50 dark:bg-blue-950/50 text-blue-600 dark:text-blue-400 border border-blue-200 dark:border-blue-900/50 mb-3">
          <ToolIcon name="zap" class="w-3.5 h-3.5" />
          <span>Feature Comparison</span>
        </div>
        <h2 class="text-2xl sm:text-3xl font-bold tracking-tight text-slate-900 dark:text-white">
          Why Choose FastToolVerse vs Others
        </h2>
        <p class="mt-2 text-sm sm:text-base text-slate-600 dark:text-slate-400">
          Compare the privacy, batch speed, and format flexibility of FastToolVerse against traditional online converters.
        </p>
      </div>

      <!-- Modern PDF Guru Style Comparison Card / Table -->
      <div class="overflow-hidden rounded-2xl border border-slate-200 dark:border-slate-800 bg-white dark:bg-slate-900 shadow-xs">
        
        <!-- Table Header (Desktop & Mobile) -->
        <div class="grid grid-cols-12 border-b border-slate-200 dark:border-slate-800 bg-slate-50/90 dark:bg-slate-900/90 text-xs sm:text-sm font-semibold text-slate-700 dark:text-slate-300">
          <div class="col-span-12 sm:col-span-4 p-3 sm:p-5 flex items-center border-b sm:border-b-0 border-slate-200 dark:border-slate-800">
            <span>Feature / Capability</span>
          </div>
          <div class="col-span-6 sm:col-span-4 p-3 sm:p-5 bg-blue-50/60 dark:bg-blue-950/30 border-r sm:border-x border-blue-100 dark:border-blue-900/40 text-blue-700 dark:text-blue-300 flex items-center justify-between">
            <span class="font-bold flex items-center gap-1.5">
              FastToolVerse
              <span class="hidden sm:inline-block px-2 py-0.5 text-[11px] font-medium bg-blue-600 text-white rounded-full">Recommended</span>
            </span>
            <span class="text-xs text-blue-600 dark:text-blue-400 font-normal hidden md:inline">This Tool</span>
          </div>
          <div class="col-span-6 sm:col-span-4 p-3 sm:p-5 text-slate-500 dark:text-slate-400 flex items-center">
            <span>Other Resizers</span>
          </div>
        </div>

        <!-- Row 1: Privacy -->
        <div class="grid grid-cols-12 border-b border-slate-100 dark:border-slate-800/80 transition-colors hover:bg-slate-50/50 dark:hover:bg-slate-800/30">
          <div class="col-span-12 sm:col-span-4 p-3 sm:p-5 flex flex-col justify-center bg-slate-50/60 dark:bg-slate-800/30 sm:bg-transparent">
            <span class="font-semibold text-xs sm:text-sm text-slate-900 dark:text-white">Privacy & Security</span>
            <span class="text-[11px] sm:text-xs text-slate-500 dark:text-slate-400 mt-0.5">Where your images are processed</span>
          </div>
          <div class="col-span-6 sm:col-span-4 p-3 sm:p-5 bg-blue-50/30 dark:bg-blue-950/15 border-r sm:border-x border-blue-100 dark:border-blue-900/30 flex items-start gap-2 sm:gap-2.5">
            <div class="w-5 h-5 rounded-full bg-emerald-100 dark:bg-emerald-950/80 text-emerald-600 dark:text-emerald-400 border border-emerald-300 dark:border-emerald-700 flex items-center justify-center shrink-0 mt-0.5 shadow-2xs">
              <svg class="w-3 h-3" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="3"><path stroke-linecap="round" stroke-linejoin="round" d="M4.5 12.75l6 6 9-13.5" /></svg>
            </div>
            <div class="min-w-0">
              <p class="text-xs sm:text-sm font-semibold text-emerald-700 dark:text-emerald-400">100% In-Browser</p>
              <p class="text-[11px] sm:text-xs text-slate-600 dark:text-slate-400 mt-0.5 leading-relaxed">HTML5 Canvas engine. Zero server uploads, zero logs, images never leave your machine.</p>
            </div>
          </div>
          <div class="col-span-6 sm:col-span-4 p-3 sm:p-5 flex items-start gap-2 sm:gap-2.5">
            <div class="w-5 h-5 rounded-full bg-rose-100 dark:bg-rose-950/80 text-rose-600 dark:text-rose-400 border border-rose-300 dark:border-rose-700 flex items-center justify-center shrink-0 mt-0.5 shadow-2xs">
              <svg class="w-3 h-3" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="3"><path stroke-linecap="round" stroke-linejoin="round" d="M6 18L18 6M6 6l12 12" /></svg>
            </div>
            <div class="min-w-0">
              <p class="text-xs sm:text-sm font-medium text-slate-700 dark:text-slate-300">Server Uploads</p>
              <p class="text-[11px] sm:text-xs text-slate-500 dark:text-slate-400 mt-0.5 leading-relaxed">Photos uploaded to remote cloud queues with potential retention and privacy risks.</p>
            </div>
          </div>
        </div>

        <!-- Row 2: Batch Processing -->
        <div class="grid grid-cols-12 border-b border-slate-100 dark:border-slate-800/80 transition-colors hover:bg-slate-50/50 dark:hover:bg-slate-800/30">
          <div class="col-span-12 sm:col-span-4 p-3 sm:p-5 flex flex-col justify-center bg-slate-50/60 dark:bg-slate-800/30 sm:bg-transparent">
            <span class="font-semibold text-xs sm:text-sm text-slate-900 dark:text-white">Batch Processing</span>
            <span class="text-[11px] sm:text-xs text-slate-500 dark:text-slate-400 mt-0.5">Simultaneous image conversions</span>
          </div>
          <div class="col-span-6 sm:col-span-4 p-3 sm:p-5 bg-blue-50/30 dark:bg-blue-950/15 border-r sm:border-x border-blue-100 dark:border-blue-900/30 flex items-start gap-2 sm:gap-2.5">
            <div class="w-5 h-5 rounded-full bg-emerald-100 dark:bg-emerald-950/80 text-emerald-600 dark:text-emerald-400 border border-emerald-300 dark:border-emerald-700 flex items-center justify-center shrink-0 mt-0.5 shadow-2xs">
              <svg class="w-3 h-3" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="3"><path stroke-linecap="round" stroke-linejoin="round" d="M4.5 12.75l6 6 9-13.5" /></svg>
            </div>
            <div class="min-w-0">
              <p class="text-xs sm:text-sm font-semibold text-slate-900 dark:text-white">Up to 15 in Batch</p>
              <p class="text-[11px] sm:text-xs text-slate-600 dark:text-slate-400 mt-0.5 leading-relaxed">Instant multi-threaded browser execution with individual or batch ZIP downloads.</p>
            </div>
          </div>
          <div class="col-span-6 sm:col-span-4 p-3 sm:p-5 flex items-start gap-2 sm:gap-2.5">
            <div class="w-5 h-5 rounded-full bg-rose-100 dark:bg-rose-950/80 text-rose-600 dark:text-rose-400 border border-rose-300 dark:border-rose-700 flex items-center justify-center shrink-0 mt-0.5 shadow-2xs">
              <svg class="w-3 h-3" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="3"><path stroke-linecap="round" stroke-linejoin="round" d="M6 18L18 6M6 6l12 12" /></svg>
            </div>
            <div class="min-w-0">
              <p class="text-xs sm:text-sm font-medium text-slate-700 dark:text-slate-300">Limited to 1–3</p>
              <p class="text-[11px] sm:text-xs text-slate-500 dark:text-slate-400 mt-0.5 leading-relaxed">Throttled queues or batch resizing restricted behind paid subscriptions.</p>
            </div>
          </div>
        </div>

        <!-- Row 3: Intrusive Ads -->
        <div class="grid grid-cols-12 border-b border-slate-100 dark:border-slate-800/80 transition-colors hover:bg-slate-50/50 dark:hover:bg-slate-800/30">
          <div class="col-span-12 sm:col-span-4 p-3 sm:p-5 flex flex-col justify-center bg-slate-50/60 dark:bg-slate-800/30 sm:bg-transparent">
            <span class="font-semibold text-xs sm:text-sm text-slate-900 dark:text-white">Ad & User Experience</span>
            <span class="text-[11px] sm:text-xs text-slate-500 dark:text-slate-400 mt-0.5">Distraction-free interface vs clutter</span>
          </div>
          <div class="col-span-6 sm:col-span-4 p-3 sm:p-5 bg-blue-50/30 dark:bg-blue-950/15 border-r sm:border-x border-blue-100 dark:border-blue-900/30 flex items-start gap-2 sm:gap-2.5">
            <div class="w-5 h-5 rounded-full bg-emerald-100 dark:bg-emerald-950/80 text-emerald-600 dark:text-emerald-400 border border-emerald-300 dark:border-emerald-700 flex items-center justify-center shrink-0 mt-0.5 shadow-2xs">
              <svg class="w-3 h-3" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="3"><path stroke-linecap="round" stroke-linejoin="round" d="M4.5 12.75l6 6 9-13.5" /></svg>
            </div>
            <div class="min-w-0">
              <p class="text-xs sm:text-sm font-semibold text-slate-900 dark:text-white">Clean, Zero Popups</p>
              <p class="text-[11px] sm:text-xs text-slate-600 dark:text-slate-400 mt-0.5 leading-relaxed">No interstitial modals, zero banner takeovers, and no deceptive 'Download' traps.</p>
            </div>
          </div>
          <div class="col-span-6 sm:col-span-4 p-3 sm:p-5 flex items-start gap-2 sm:gap-2.5">
            <div class="w-5 h-5 rounded-full bg-rose-100 dark:bg-rose-950/80 text-rose-600 dark:text-rose-400 border border-rose-300 dark:border-rose-700 flex items-center justify-center shrink-0 mt-0.5 shadow-2xs">
              <svg class="w-3 h-3" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="3"><path stroke-linecap="round" stroke-linejoin="round" d="M6 18L18 6M6 6l12 12" /></svg>
            </div>
            <div class="min-w-0">
              <p class="text-xs sm:text-sm font-medium text-slate-700 dark:text-slate-300">Heavy Modal Ads</p>
              <p class="text-[11px] sm:text-xs text-slate-500 dark:text-slate-400 mt-0.5 leading-relaxed">Cluttered UI, video auto-plays, countdown delays, and confusing third-party banners.</p>
            </div>
          </div>
