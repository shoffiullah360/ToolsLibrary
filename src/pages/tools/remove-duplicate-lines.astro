<!-- Client-Side JavaScript Logic -->
<script is:inline>
  (function () {
    const inputText = document.getElementById('input-text');
    const outputText = document.getElementById('output-text');
    const optCaseSensitive = document.getElementById('opt-case-sensitive');
    const optTrimLines = document.getElementById('opt-trim-lines');
    const optEmptyLines = document.getElementById('opt-empty-lines');
    const optSortLines = document.getElementById('opt-sort-lines');
    const btnDedupe = document.getElementById('btn-dedupe');
    const btnSample = document.getElementById('btn-sample');
    const btnPaste = document.getElementById('btn-paste');
    const btnClear = document.getElementById('btn-clear');
    const btnCopy = document.getElementById('btn-copy');
    const btnDownload = document.getElementById('btn-download');

    const copyBtnText = document.getElementById('copy-btn-text');
    const copyIconIdle = document.getElementById('copy-icon-idle');
    const copyIconSuccess = document.getElementById('copy-icon-success');

    const statInputChars = document.getElementById('stat-input-chars');
    const statInputWords = document.getElementById('stat-input-words');
    const statInputLines = document.getElementById('stat-input-lines');

    const statOutputChars = document.getElementById('stat-output-chars');
    const statOutputLines = document.getElementById('stat-output-lines');
    const statDuplicatesSaved = document.getElementById('stat-duplicates-saved');
    const statReductionPct = document.getElementById('stat-reduction-pct');
    const statusDuplicatesRemoved = document.getElementById('status-duplicates-removed');

    const presetButtons = document.querySelectorAll('.preset-card-btn');

    // Preset Data map
    const presetMap = {
      'preset-email-list': {
        options: { caseSensitive: false, trimLines: true, emptyLines: true, sortLines: true },
        sample: 'contact@company.com\nMARKETING@COMPANY.COM\ncontact@company.com\nsales@enterprise.net\nmarketing@company.com\n  alex.wong@startup.io  \nalex.wong@startup.io\ninfo@domain.org\nsales@enterprise.net\nsupport@domain.org'
      },
      'preset-keywords': {
        options: { caseSensitive: false, trimLines: true, emptyLines: true, sortLines: false },
        sample: 'free online text cleaner\nbest duplicate line remover\nfree online text cleaner\nremove duplicate lines online\nFREE ONLINE TEXT CLEANER\ntext deduplication tool\nbest duplicate line remover\nclean duplicate lists'
      },
      'preset-case-insensitive': {
        options: { caseSensitive: false, trimLines: true, emptyLines: false, sortLines: false },
        sample: 'JavaScript\njavascript\nJAVASCRIPT\nTypeScript\ntypescript\nPython\npython\nPYTHON\nRust\nrust'
      },
      'preset-urls': {
        options: { caseSensitive: true, trimLines: true, emptyLines: true, sortLines: false },
        sample: 'https://fasttoolverse.com/tools/image-resizer\nhttps://fasttoolverse.com/tools/remove-extra-spaces\nhttps://fasttoolverse.com/tools/remove-duplicate-lines\nhttps://fasttoolverse.com/tools/image-resizer\nhttps://fasttoolverse.com/tools/remove-extra-spaces\nhttps://fasttoolverse.com/tools/text-case-converter'
      },
      'preset-sort-dedupe': {
        options: { caseSensitive: false, trimLines: true, emptyLines: true, sortLines: true },
        sample: 'Zebra\nBanana\nApple\nOrange\nBanana\nApple\nGrape\nWatermelon\nOrange\nMango'
      },
      'preset-csv-column': {
        options: { caseSensitive: true, trimLines: true, emptyLines: true, sortLines: false },
        sample: 'SKU-8921-XL\nSKU-4412-SM\nSKU-8921-XL\nSKU-1093-MD\nSKU-4412-SM\nSKU-7721-LG\nSKU-1093-MD\nSKU-9901-XL'
      }
    };

    function countWords(str) {
      if (!str || !str.trim()) return 0;
      return str.trim().split(/\s+/).length;
    }

    function countLines(str) {
      if (!str) return 0;
      return str.split(/\r?\n/).length;
    }

    // High-performance Set-based deduplication logic
    function deduplicate(text) {
      if (!text) {
        return {
          result: '',
          duplicatesRemoved: 0,
          originalLines: 0,
          outputLines: 0
        };
      }

      const lines = text.split(/\r?\n/);
      const isCaseSensitive = optCaseSensitive ? optCaseSensitive.checked : true;
      const isTrimLines = optTrimLines ? optTrimLines.checked : true;
      const isRemoveEmpty = optEmptyLines ? optEmptyLines.checked : false;
      const isSortLines = optSortLines ? optSortLines.checked : false;

      const seen = new Set();
      const resultLines = [];

      for (let i = 0; i < lines.length; i++) {
        let line = lines[i];

        if (isTrimLines) {
          line = line.trim();
        }

        if (isRemoveEmpty && line === '') {
          continue;
        }

        const key = isCaseSensitive ? line : line.toLowerCase();

        if (!seen.has(key)) {
          seen.add(key);
          resultLines.push(line);
        }
      }

      if (isSortLines) {
        resultLines.sort(function (a, b) {
          return a.localeCompare(b, undefined, {
            numeric: true,
            sensitivity: isCaseSensitive ? 'case' : 'base'
          });
        });
      }

      const totalRemoved = Math.max(0, lines.length - resultLines.length);

      return {
        result: resultLines.join('\n'),
        duplicatesRemoved: totalRemoved,
        originalLines: lines.length,
        outputLines: resultLines.length
      };
    }

    function update() {
      const raw = inputText.value || '';
      const dedupeResult = deduplicate(raw);
      outputText.value = dedupeResult.result;

      // Input Stats
      const inChars = raw.length;
      const inWords = countWords(raw);
      const inLines = raw ? countLines(raw) : 0;

      statInputChars.textContent = inChars.toLocaleString();
      statInputWords.textContent = inWords.toLocaleString();
      statInputLines.textContent = inLines.toLocaleString();

      // Output Stats
      const outChars = dedupeResult.result.length;
      const outLines = dedupeResult.result ? dedupeResult.outputLines : 0;

      statOutputChars.textContent = outChars.toLocaleString();
      statOutputLines.textContent = outLines.toLocaleString();

      const dupesRemoved = dedupeResult.duplicatesRemoved;
      statDuplicatesSaved.textContent = dupesRemoved.toLocaleString();

      const pct = inLines > 0 ? Math.max(0, Math.round((dupesRemoved / inLines) * 100)) : 0;
      statReductionPct.textContent = pct + '% reduction';

      statusDuplicatesRemoved.textContent =
        dupesRemoved.toLocaleString() + ' duplicate ' + (dupesRemoved === 1 ? 'line' : 'lines') + ' removed';
    }

    // Debounce helper for silky performance with large text
    let timeoutId;
    function debouncedUpdate() {
      clearTimeout(timeoutId);
      timeoutId = setTimeout(update, 50);
    }

    // Event Listeners
    inputText?.addEventListener('input', debouncedUpdate);
    optCaseSensitive?.addEventListener('change', update);
    optTrimLines?.addEventListener('change', update);
    optEmptyLines?.addEventListener('change', update);
    optSortLines?.addEventListener('change', update);
    btnDedupe?.addEventListener('click', update);

    // Sample Text
    btnSample?.addEventListener('click', function () {
      inputText.value =
        'Apple\nBanana\nOrange\nApple\nbanana\nGrape\nOrange\n  Watermelon  \nWatermelon\nMango\nGrape';
      update();
    });

    // Clear
    btnClear?.addEventListener('click', function () {
      inputText.value = '';
      outputText.value = '';
      update();
      inputText.focus();
    });

    // Paste from Clipboard
    btnPaste?.addEventListener('click', async function () {
      try {
        if (navigator.clipboard && navigator.clipboard.readText) {
          const clipText = await navigator.clipboard.readText();
          if (clipText) {
            inputText.value = clipText;
            update();
          }
        } else {
          inputText.focus();
          inputText.select();
        }
      } catch (err) {
        inputText.focus();
      }
    });

    // Copy to Clipboard
    btnCopy?.addEventListener('click', async function () {
      const textToCopy = outputText.value;
      if (!textToCopy) return;

      try {
        if (navigator.clipboard && navigator.clipboard.writeText) {
          await navigator.clipboard.writeText(textToCopy);
        } else {
          outputText.select();
          document.execCommand('copy');
        }

        copyBtnText.textContent = 'Copied!';
        copyIconIdle.classList.add('hidden');
        copyIconSuccess.classList.remove('hidden');

        setTimeout(function () {
          copyBtnText.textContent = 'Copy Result';
          copyIconIdle.classList.remove('hidden');
          copyIconSuccess.classList.add('hidden');
        }, 2000);
      } catch (err) {
        outputText.select();
      }
    });

    // Download .txt file
    btnDownload?.addEventListener('click', function () {
      const content = outputText.value;
      if (!content) return;

      const blob = new Blob([content], { type: 'text/plain;charset=utf-8' });
      const url = URL.createObjectURL(blob);
      const a = document.createElement('a');
      a.href = url;
      a.download = 'unique-lines.txt';
      document.body.appendChild(a);
      a.click();
      document.body.removeChild(a);
      URL.revokeObjectURL(url);
    });

    // Preset Buttons
    presetButtons.forEach(function (btn) {
      btn.addEventListener('click', function () {
        const id = btn.getAttribute('data-preset');
        const data = presetMap[id];
        if (!data) return;

        optCaseSensitive.checked = data.options.caseSensitive;
        optTrimLines.checked = data.options.trimLines;
        optEmptyLines.checked = data.options.emptyLines;
        optSortLines.checked = data.options.sortLines;

        if (data.sample) {
          inputText.value = data.sample;
        }

        update();

        // Scroll to editor
        const studio = document.getElementById('input-text');
        if (studio) {
          studio.scrollIntoView({ behavior: 'smooth', block: 'center' });
        }
      });
    });

    // Initial update on page load
    update();
  })();
</script>
