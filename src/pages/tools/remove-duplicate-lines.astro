---
import Layout from '../../layouts/Layout.astro';
import ToolIcon from '../../components/ToolIcon.astro';

// FAQ Data for Schema and Accordion
const faqs = [
  {
    question: "How do I remove duplicate lines from a list online?",
    answer: "Paste or type your text list into the Input Text box. FastToolVerse automatically executes client-side Set-based deduplication in real time. It removes all recurring occurrences while preserving the original order of first appearance. You can toggle case sensitivity, whitespace trimming, or alphabetical sorting instantly."
  },
  {
    question: "Does this duplicate line remover upload my confidential data or email lists to a server?",
    answer: "No. FastToolVerse processes 100% of your text locally in your web browser using modern JavaScript hash sets. Your proprietary databases, customer email lists, API keys, and internal CSV files never touch any external server, network endpoint, or analytics tracker."
  },
  {
    question: "What is the difference between case-sensitive and case-insensitive deduplication?",
    answer: "When 'Case-sensitive comparison' is enabled, 'Apple' and 'apple' are treated as two distinct unique entries. When unchecked (case-insensitive mode), both variants are recognized as duplicates, and only the first encountered casing is preserved in your cleaned list."
  },
  {
    question: "How does the 'Trim whitespace before comparing' option work?",
    answer: "Often lines contain accidental leading spaces or trailing tabs (for example, '  user@domain.com  ' vs 'user@domain.com'). When this option is enabled, FastToolVerse strips extraneous edge spaces before comparing hash keys, ensuring visually identical lines are properly identified and deduplicated."
  },
  {
    question: "Can I sort the unique list alphabetically in A-Z order?",
    answer: "Yes. Simply enable the 'Sort alphabetically (A-Z)' checkbox. FastToolVerse will deduplicate your list first and then perform an in-memory natural alphabetical sort so your catalog, keyword list, or subscriber list is instantly ordered."
  },
  {
    question: "How does this tool handle large lists with 50,000+ lines?",
    answer: "Because this tool utilizes native JavaScript Hash Sets with O(1) constant-time key lookups (yielding total O(N) linear time complexity), it can deduplicate lists containing tens of thousands of lines in mere milliseconds without crashing or freezing your browser tab."
  },
  {
    question: "How do I deduplicate email addresses or single-column CSV datasets?",
    answer: "Copy your single column from Microsoft Excel, Google Sheets, or a CSV export and paste it directly into the input box. Enable 'Trim whitespace before comparing' and disable 'Case-sensitive comparison' for emails, then click 'Copy Result' or download the sanitized list as a .txt file."
  },
  {
    question: "Does this duplicate remover work offline?",
    answer: "Yes. Once the web page is loaded, all JavaScript logic runs entirely in your local browser sandbox. You can disconnect from Wi-Fi or work in airplane mode, and the deduplication tool will continue operating without interruptions."
  }
];

// Schema.org SoftwareApplication
const jsonLdSoftwareApp = {
  "@context": "https://schema.org",
  "@type": "SoftwareApplication",
  "name": "Free Online Duplicate Line Remover & Text Cleaner",
  "applicationCategory": "UtilitiesApplication",
  "operatingSystem": "All (Web Browser)",
  "browserRequirements": "Requires JavaScript. Runs 100% client-side.",
  "offers": {
    "@type": "Offer",
    "price": "0",
    "priceCurrency": "USD"
  },
  "featureList": [
    "100% In-browser text deduplication privacy",
    "High-performance O(N) Set-based line deduplication",
    "Case-sensitive and case-insensitive comparison modes",
    "Trim leading and trailing line whitespace before deduplication",
    "Strip empty and blank lines",
    "Optional alphabetical A-Z list sorting",
    "Live line, word, character, and duplicate removal counters",
    "1-click copy to clipboard and .txt file export"
  ]
};

// Schema.org FAQPage
const jsonLdFaq = {
  "@context": "https://schema.org",
  "@type": "FAQPage",
  "mainEntity": faqs.map((f) => ({
    "@type": "Question",
    "name": f.question,
    "acceptedAnswer": {
      "@type": "Answer",
      "text": f.answer
    }
  }))
};

// Schema.org BreadcrumbList
const jsonLdBreadcrumb = {
  "@context": "https://schema.org",
  "@type": "BreadcrumbList",
  "itemListElement": [
    {
      "@type": "ListItem",
      "position": 1,
      "name": "Home",
      "item": "https://fasttoolverse.com/"
    },
    {
      "@type": "ListItem",
      "position": 2,
      "name": "Text & Formatting",
      "item": "https://fasttoolverse.com/#text-tools-section"
    },
    {
      "@type": "ListItem",
      "position": 3,
      "name": "Remove Duplicate Lines",
      "item": "https://fasttoolverse.com/tools/remove-duplicate-lines"
    }
  ]
};

const canonicalUrl = "https://fasttoolverse.com/tools/remove-duplicate-lines";
const pageTitle = "Remove Duplicate Lines Online - Fast Deduplicator";
const pageDescription = "Remove duplicate lines, repeated entries, and blank rows online with zero server uploads. 100% private client-side deduplication with live line counts.";
const pageKeywords = "remove duplicate lines, duplicate line remover, text deduplicator, delete duplicate lines, unique line extractor, deduplicate list online, clean duplicate lines, remove duplicate text, csv deduplicate, client side text tool";
const ogImage = "https://fasttoolverse.com/og-image.png";

// Programmatic target cards / presets
const presets = [
  {
    id: "preset-email-list",
    title: "Deduplicate Email List",
    tag: "Mailing Lists & CRM",
    desc: "Clean duplicate subscriber entries, sanitize customer emails, and prevent double sends with case-insensitive normalization.",
    options: { caseSensitive: false, trimLines: true, emptyLines: true, sortLines: true },
    sampleText: "contact@company.com\nMARKETING@COMPANY.COM\ncontact@company.com\nsales@enterprise.net\nmarketing@company.com\n  alex.wong@startup.io  \nalex.wong@startup.io\ninfo@domain.org\nsales@enterprise.net\nsupport@domain.org"
  },
  {
    id: "preset-keywords",
    title: "Extract Unique Keywords",
    tag: "SEO & Search Marketing",
    desc: "Filter out redundant search phrases, long-tail variations, and duplicate PPC tags for clean keyword research.",
    options: { caseSensitive: false, trimLines: true, emptyLines: true, sortLines: false },
    sampleText: "free online text cleaner\nbest duplicate line remover\nfree online text cleaner\nremove duplicate lines online\nFREE ONLINE TEXT CLEANER\ntext deduplication tool\nbest duplicate line remover\nclean duplicate lists"
  },
  {
    id: "preset-case-insensitive",
    title: "Case-Insensitive Deduplicator",
    tag: "Case Normalization",
    desc: "Treat 'Apple', 'apple', and 'APPLE' as identical entries to eliminate case-variance duplication across large records.",
    options: { caseSensitive: false, trimLines: true, emptyLines: false, sortLines: false },
    sampleText: "JavaScript\njavascript\nJAVASCRIPT\nTypeScript\ntypescript\nPython\npython\nPYTHON\nRust\nrust"
  },
  {
    id: "preset-urls",
    title: "Clean Duplicate URLs",
    tag: "Web & Sitemap Data",
    desc: "Prune repetitive sitemap links, crawl lists, backlinks, and canonical paths before indexing or audits.",
    options: { caseSensitive: true, trimLines: true, emptyLines: true, sortLines: false },
    sampleText: "https://fasttoolverse.com/tools/image-resizer\nhttps://fasttoolverse.com/tools/remove-extra-spaces\nhttps://fasttoolverse.com/tools/remove-duplicate-lines\nhttps://fasttoolverse.com/tools/image-resizer\nhttps://fasttoolverse.com/tools/remove-extra-spaces\nhttps://fasttoolverse.com/tools/text-case-converter"
  },
  {
    id: "preset-sort-dedupe",
    title: "Sort & Deduplicate List",
    tag: "Alphabetical Sorting",
    desc: "Remove all repeated records and sort the resulting unique list alphabetically in A-Z order for immediate cataloging.",
    options: { caseSensitive: false, trimLines: true, emptyLines: true, sortLines: true },
    sampleText: "Zebra\nBanana\nApple\nOrange\nBanana\nApple\nGrape\nWatermelon\nOrange\nMango"
  },
  {
    id: "preset-csv-column",
    title: "CSV Column Deduplication",
    tag: "Spreadsheets & DBs",
    desc: "Clean pasted single-column spreadsheet values, unique IDs, order numbers, or SKUs exported from Excel or SQL.",
    options: { caseSensitive: true, trimLines: true, emptyLines: true, sortLines: false },
    sampleText: "SKU-8921-XL\nSKU-4412-SM\nSKU-8921-XL\nSKU-1093-MD\nSKU-4412-SM\nSKU-7721-LG\nSKU-1093-MD\nSKU-9901-XL"
  }
];
---

<Layout
  title={pageTitle}
  description={pageDescription}
  canonicalUrl={canonicalUrl}
  image={ogImage}
>
  <!-- Injected Head Elements: Twitter & JSON-LD Schemas -->
  <Fragment slot="head">
    <meta name="keywords" content={pageKeywords} />

    <!-- Open Graph tags -->
    <meta property="og:type" content="website" />
    <meta property="og:url" content={canonicalUrl} />
    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={pageDescription} />
    <meta property="og:image" content={ogImage} />

    <!-- Twitter Card -->
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:url" content={canonicalUrl} />
    <meta name="twitter:title" content={pageTitle} />
    <meta name="twitter:description" content={pageDescription} />
    <meta name="twitter:image" content={ogImage} />

    <!-- Structured Data Schemas -->
    <script type="application/ld+json" set:html={JSON.stringify(jsonLdSoftwareApp)} />
    <script type="application/ld+json" set:html={JSON.stringify(jsonLdFaq)} />
    <script type="application/ld+json" set:html={JSON.stringify(jsonLdBreadcrumb)} />
  </Fragment>

  <!-- Hero Header Section -->
  <section class="relative pt-10 pb-6 sm:pt-14 sm:pb-8 overflow-hidden">
    <div class="hero-mesh-bg" aria-hidden="true"></div>

    <div class="relative max-w-5xl mx-auto px-4 sm:px-6 lg:px-8 text-center">
      <!-- Breadcrumbs -->
      <nav aria-label="Breadcrumb" class="mb-5 flex justify-center">
        <ol class="inline-flex items-center space-x-1.5 md:space-x-2 text-xs font-medium text-slate-500 dark:text-slate-400">
          <li class="inline-flex items-center">
            <a href="/" class="hover:text-blue-600 dark:hover:text-blue-400 transition-colors">Home</a>
          </li>
          <li>
            <div class="flex items-center">
              <svg class="w-3 h-3 text-slate-400 mx-1" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7" />
              </svg>
              <a href="/#text-tools-section" class="hover:text-purple-600 dark:hover:text-purple-400 transition-colors">Text & Formatting</a>
            </div>
          </li>
          <li aria-current="page">
            <div class="flex items-center">
              <svg class="w-3 h-3 text-slate-400 mx-1" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7" />
              </svg>
              <span class="text-slate-900 dark:text-white font-semibold">Remove Duplicate Lines</span>
            </div>
          </li>
        </ol>
      </nav>

      <!-- Privacy Status Badge -->
      <div class="inline-flex items-center gap-1.5 px-3.5 py-1 rounded-full text-xs font-semibold bg-purple-50 dark:bg-purple-950/50 text-purple-600 dark:text-purple-400 border border-purple-200 dark:border-purple-900/50 mb-3 shadow-2xs">
        <ToolIcon name="shield-check" class="w-3.5 h-3.5" />
        <span>100% In-Browser Privacy • Zero Server Uploads</span>
      </div>

      <!-- Hero Title -->
      <h1 class="text-3xl sm:text-4xl md:text-5xl font-bold tracking-tight text-slate-900 dark:text-white leading-tight">
        Free Online Duplicate Line Remover & Text Cleaner
      </h1>

      <!-- Subtitle -->
      <p class="mt-3 sm:mt-4 text-base sm:text-lg text-slate-600 dark:text-slate-400 max-w-2xl mx-auto leading-relaxed">
        Deduplicate text lists, delete repeated entries, and extract unique lines instantly with zero server uploads.
      </p>
    </div>
  </section>

  <!-- Interactive Studio Container -->
  <section class="max-w-6xl mx-auto px-4 sm:px-6 lg:px-8 pb-16 sm:pb-24">
    <div class="rounded-2xl border border-slate-200 dark:border-slate-800 bg-white dark:bg-slate-900 shadow-xl overflow-hidden transition-colors">
      
      <!-- Top Options & Controls Bar -->
      <div class="p-5 sm:p-6 border-b border-slate-200 dark:border-slate-800 bg-slate-50/70 dark:bg-slate-900/70">
        <div class="flex flex-col lg:flex-row lg:items-center justify-between gap-4">
          
          <!-- Deduplication Rules (Checkboxes) -->
          <div class="flex flex-wrap items-center gap-x-6 gap-y-3">
            <label class="inline-flex items-center gap-2 cursor-pointer text-xs sm:text-sm font-medium text-slate-700 dark:text-slate-300 hover:text-slate-900 dark:hover:text-white transition-colors">
              <input
                type="checkbox"
                id="opt-case-sensitive"
                checked
                class="w-4 h-4 rounded border-slate-300 dark:border-slate-700 text-purple-600 focus:ring-purple-500 dark:bg-slate-800 cursor-pointer"
              />
              <span>Case-sensitive comparison</span>
            </label>

            <label class="inline-flex items-center gap-2 cursor-pointer text-xs sm:text-sm font-medium text-slate-700 dark:text-slate-300 hover:text-slate-900 dark:hover:text-white transition-colors">
              <input
                type="checkbox"
                id="opt-trim-lines"
                checked
                class="w-4 h-4 rounded border-slate-300 dark:border-slate-700 text-purple-600 focus:ring-purple-500 dark:bg-slate-800 cursor-pointer"
              />
              <span>Trim whitespace before comparing</span>
            </label>

            <label class="inline-flex items-center gap-2 cursor-pointer text-xs sm:text-sm font-medium text-slate-700 dark:text-slate-300 hover:text-slate-900 dark:hover:text-white transition-colors">
              <input
                type="checkbox"
                id="opt-empty-lines"
                class="w-4 h-4 rounded border-slate-300 dark:border-slate-700 text-purple-600 focus:ring-purple-500 dark:bg-slate-800 cursor-pointer"
              />
              <span>Remove empty/blank lines</span>
            </label>

            <label class="inline-flex items-center gap-2 cursor-pointer text-xs sm:text-sm font-medium text-slate-700 dark:text-slate-300 hover:text-slate-900 dark:hover:text-white transition-colors">
              <input
                type="checkbox"
                id="opt-sort-lines"
                class="w-4 h-4 rounded border-slate-300 dark:border-slate-700 text-purple-600 focus:ring-purple-500 dark:bg-slate-800 cursor-pointer"
              />
              <span>Sort alphabetically (A-Z)</span>
            </label>
          </div>

          <!-- Action Buttons -->
          <div class="flex items-center gap-2.5 shrink-0">
            <button
              type="button"
              id="btn-sample"
              class="px-3.5 py-1.5 text-xs font-semibold rounded-lg border border-slate-200 dark:border-slate-700 text-slate-700 dark:text-slate-300 hover:bg-slate-100 dark:hover:bg-slate-800 transition-colors cursor-pointer shadow-2xs"
            >
              Load Sample
            </button>
            <button
              type="button"
              id="btn-dedupe"
              class="px-5 py-2 text-xs sm:text-sm font-semibold rounded-lg bg-purple-600 hover:bg-purple-700 text-white shadow-sm transition-all flex items-center gap-2 cursor-pointer"
            >
              <ToolIcon name="list-filter" class="w-4 h-4" />
              <span>Remove Duplicates</span>
            </button>
          </div>

        </div>
      </div>

      <!-- Dual Textarea Layout -->
      <div class="grid grid-cols-1 lg:grid-cols-2 divide-y lg:divide-y-0 lg:divide-x divide-slate-200 dark:divide-slate-800">
        
        <!-- Left: Input Area -->
        <div class="p-5 sm:p-6 flex flex-col space-y-3 bg-white dark:bg-slate-900">
          <div class="flex items-center justify-between">
            <div class="flex items-center gap-2">
              <span class="text-xs font-mono uppercase tracking-wider font-semibold text-slate-500 dark:text-slate-400">
                Input Text
              </span>
              <span id="badge-input-ready" class="text-[11px] font-medium px-2 py-0.5 rounded-full bg-slate-100 dark:bg-slate-800 text-slate-600 dark:text-slate-400">
                Live Typing
              </span>
            </div>
            
            <div class="flex items-center gap-2">
              <button
                type="button"
                id="btn-paste"
                class="px-2.5 py-1 text-xs font-medium rounded-md border border-slate-200 dark:border-slate-700/80 hover:bg-slate-100 dark:hover:bg-slate-800 text-slate-700 dark:text-slate-300 transition-colors flex items-center gap-1.5 cursor-pointer"
                title="Paste from clipboard"
              >
                <svg class="w-3.5 h-3.5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                  <path stroke-linecap="round" stroke-linejoin="round" d="M9 5H7a2 2 0 00-2 2v12a2 2 0 002 2h10a2 2 0 002-2V7a2 2 0 00-2-2h-2M9 5a2 2 0 002 2h2a2 2 0 002-2M9 5a2 2 0 012-2h2a2 2 0 012 2" />
                </svg>
                <span>Paste</span>
              </button>
              <button
                type="button"
                id="btn-clear"
                class="px-2.5 py-1 text-xs font-medium rounded-md border border-slate-200 dark:border-slate-700/80 hover:bg-rose-50 dark:hover:bg-rose-950/40 text-slate-600 hover:text-rose-600 dark:text-slate-400 dark:hover:text-rose-400 transition-colors cursor-pointer"
                title="Clear input text"
              >
                Clear
              </button>
            </div>
          </div>

          <textarea
            id="input-text"
            rows="14"
            placeholder="Paste or type your list here (emails, keywords, URLs, code lines)... Duplicates will be eliminated instantly in real time."
            class="w-full p-4 rounded-xl border border-slate-200 dark:border-slate-800 bg-slate-50/50 dark:bg-slate-950/60 text-slate-900 dark:text-slate-100 font-mono text-sm leading-relaxed placeholder:text-slate-400 dark:placeholder:text-slate-600 focus:outline-none focus:ring-2 focus:ring-purple-500/30 focus:border-purple-500 transition resize-y min-h-[320px]"
            spellcheck="false"
          ></textarea>

          <!-- Input Live Counters -->
          <div class="flex items-center justify-between text-xs text-slate-500 dark:text-slate-400 pt-1 font-mono">
            <div class="flex items-center gap-3">
              <span>Lines: <strong id="stat-input-lines" class="text-slate-800 dark:text-slate-200">0</strong></span>
              <span>Chars: <strong id="stat-input-chars" class="text-slate-800 dark:text-slate-200">0</strong></span>
              <span>Words: <strong id="stat-input-words" class="text-slate-800 dark:text-slate-200">0</strong></span>
            </div>
            <div class="text-[11px] text-slate-400 dark:text-slate-500">
              Input buffer
            </div>
          </div>
        </div>

        <!-- Right: Output Area -->
        <div class="p-5 sm:p-6 flex flex-col space-y-3 bg-white dark:bg-slate-900">
          <div class="flex items-center justify-between">
            <div class="flex items-center gap-2">
              <span class="text-xs font-mono uppercase tracking-wider font-semibold text-purple-600 dark:text-purple-400">
                Unique Result
              </span>
              <span
                id="status-duplicates-removed"
                class="text-[11px] font-medium px-2 py-0.5 rounded-full bg-emerald-50 dark:bg-emerald-950/50 text-emerald-700 dark:text-emerald-400 border border-emerald-200 dark:border-emerald-900/40"
              >
                0 duplicate lines removed
              </span>
            </div>

            <div class="flex items-center gap-2">
              <button
                type="button"
                id="btn-copy"
                class="px-3 py-1 text-xs font-semibold rounded-md bg-purple-600 hover:bg-purple-700 text-white transition-colors flex items-center gap-1.5 cursor-pointer shadow-xs"
                title="Copy unique lines to clipboard"
              >
                <svg id="copy-icon-idle" class="w-3.5 h-3.5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                  <rect x="9" y="9" width="13" height="13" rx="2" ry="2"></rect>
                  <path d="M5 15H4a2 2 0 01-2-2V4a2 2 0 012-2h9a2 2 0 012 2v1"></path>
                </svg>
                <svg id="copy-icon-success" class="w-3.5 h-3.5 hidden text-emerald-300" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                  <polyline points="20 6 9 17 4 12"></polyline>
                </svg>
                <span id="copy-btn-text">Copy Result</span>
              </button>

              <button
                type="button"
                id="btn-download"
                class="px-2.5 py-1 text-xs font-medium rounded-md border border-slate-200 dark:border-slate-700/80 hover:bg-slate-100 dark:hover:bg-slate-800 text-slate-700 dark:text-slate-300 transition-colors flex items-center gap-1.5 cursor-pointer"
                title="Download unique lines as text file"
              >
                <svg class="w-3.5 h-3.5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                  <path stroke-linecap="round" stroke-linejoin="round" d="M4 16v1a3 3 0 003 3h10a3 3 0 003-3v-1m-4-4l-4 4m0 0l-4-4m4 4V4" />
                </svg>
                <span>.txt</span>
              </button>
            </div>
          </div>

          <textarea
            id="output-text"
            rows="14"
            placeholder="Your deduplicated list will appear here automatically..."
            class="w-full p-4 rounded-xl border border-slate-200 dark:border-slate-800 bg-slate-50/50 dark:bg-slate-950/60 text-slate-900 dark:text-slate-100 font-mono text-sm leading-relaxed placeholder:text-slate-400 dark:placeholder:text-slate-600 focus:outline-none focus:ring-2 focus:ring-purple-500/30 focus:border-purple-500 transition resize-y min-h-[320px]"
            spellcheck="false"
          ></textarea>

          <!-- Output Live Counters -->
          <div class="flex items-center justify-between text-xs text-slate-500 dark:text-slate-400 pt-1 font-mono">
            <div class="flex items-center gap-3">
              <span>Lines: <strong id="stat-output-lines" class="text-slate-800 dark:text-slate-200">0</strong></span>
              <span>Chars: <strong id="stat-output-chars" class="text-slate-800 dark:text-slate-200">0</strong></span>
              <span>Duplicates: <strong id="stat-duplicates-saved" class="text-emerald-600 dark:text-emerald-400">0</strong></span>
            </div>
            <div id="stat-reduction-pct" class="text-[11px] font-semibold text-emerald-600 dark:text-emerald-400">
              0% reduction
            </div>
          </div>
        </div>

      </div>

    </div>
  </section>

  <!-- 3-Step Guide Section -->
  <section class="border-t border-slate-200 dark:border-slate-800 bg-slate-50/50 dark:bg-slate-900/40 py-16 sm:py-20">
    <div class="max-w-5xl mx-auto px-4 sm:px-6 lg:px-8">
      
      <div class="text-center max-w-2xl mx-auto mb-12">
        <h2 class="text-2xl sm:text-3xl font-bold tracking-tight text-slate-900 dark:text-white">
          How to Remove Duplicate Lines Online in 3 Simple Steps
        </h2>
        <p class="mt-2 text-sm sm:text-base text-slate-600 dark:text-slate-400">
          Clean messy data lists, purge repeated entries, and preserve unique rows in seconds.
        </p>
      </div>

      <div class="grid grid-cols-1 md:grid-cols-3 gap-6 sm:gap-8">
        
        <!-- Step 1 -->
        <div class="p-6 rounded-2xl border border-slate-200 dark:border-slate-800 bg-white dark:bg-slate-900 shadow-xs relative">
          <div class="w-10 h-10 rounded-xl bg-purple-50 dark:bg-purple-950/40 text-purple-600 dark:text-purple-400 flex items-center justify-center font-bold font-mono text-sm mb-4 border border-purple-100 dark:border-purple-900/50">
            01
          </div>
          <h3 class="text-base font-semibold text-slate-900 dark:text-white mb-2">
            Paste Your Text List
          </h3>
          <p class="text-sm text-slate-600 dark:text-slate-400 leading-relaxed">
            Copy emails, URLs, keywords, or CSV lines from spreadsheets and paste them directly into the input box using <kbd class="px-1.5 py-0.5 text-xs font-mono bg-slate-100 dark:bg-slate-800 rounded border border-slate-200 dark:border-slate-700">Ctrl+V</kbd> or the Paste button.
          </p>
