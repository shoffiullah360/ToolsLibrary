<!-- Client-Side JavaScript Logic -->
<script is:inline>
  (function () {
    const inputText = document.getElementById('input-text');
    const outputText = document.getElementById('output-text');
    const optWhitespaceOnly = document.getElementById('opt-whitespace-only');
    const optTrimEdges = document.getElementById('opt-trim-edges');
    const optCollapseBlanks = document.getElementById('opt-collapse-blanks');
    const btnStrip = document.getElementById('btn-strip');
    const btnSample = document.getElementById('btn-sample');
    const btnPaste = document.getElementById('btn-paste');
    const btnClear = document.getElementById('btn-clear');
    const btnCopy = document.getElementById('btn-copy');
    const btnDownload = document.getElementById('btn-download');

    const copyBtnText = document.getElementById('copy-btn-text');
    const copyIconIdle = document.getElementById('copy-icon-idle');
    const copyIconSuccess = document.getElementById('copy-icon-success');

    const statInputChars = document.getElementById('stat-input-chars');
    const statInputWords = document.getElementById('stat-input-words');
    const statInputLines = document.getElementById('stat-input-lines');

    const statOutputChars = document.getElementById('stat-output-chars');
    const statOutputLines = document.getElementById('stat-output-lines');
    const statLinesSaved = document.getElementById('stat-lines-saved');
    const statReductionPct = document.getElementById('stat-reduction-pct');
    const statusLinesRemoved = document.getElementById('status-lines-removed');

    const presetButtons = document.querySelectorAll('.preset-card-btn');

    // Preset Data map
    const presetMap = {
      'preset-strip-all': {
        options: { whitespaceOnly: true, trimEdges: true, collapseBlanks: false },
        sample: 'Paragraph one contains primary analysis.\n\n\n\nParagraph two follows several accidental line returns.\n\n\nParagraph three concludes the summary.'
      },
      'preset-collapse-double': {
        options: { whitespaceOnly: true, trimEdges: true, collapseBlanks: true },
        sample: 'Chapter 1: The Beginning\n\n\n\n\nIt was a crisp autumn morning in the mountains.\n\n\n\n\nLeaves drifted softly across the cobblestone pathway.\n\n\n\nThe adventure was about to start.'
      },
      'preset-whitespace-lines': {
        options: { whitespaceOnly: true, trimEdges: true, collapseBlanks: false },
        sample: 'User Data Record:\n   \nID: 9021\n\t\t\t\nStatus: Active\n     \nRole: Administrator'
      },
      'preset-source-code': {
        options: { whitespaceOnly: true, trimEdges: true, collapseBlanks: false },
        sample: 'import express from \'express\';\n\n\nconst app = express();\n\n\nconst PORT = process.env.PORT || 3000;\n\n\napp.get(\'/api\', (req, res) => {\n\n  res.json({ status: \'ok\' });\n\n});'
      },
      'preset-markdown-breaks': {
        options: { whitespaceOnly: true, trimEdges: true, collapseBlanks: true },
        sample: '# Documentation\n\n\n\n## Getting Started\n\n\n\nRun the quickstart installer:\n\n\n\n```bash\nnpm install fast-tool\n```\n\n\n\n## Configuration'
      },
      'preset-pdf-text': {
        options: { whitespaceOnly: true, trimEdges: true, collapseBlanks: false },
        sample: 'The study examined fifty participants across\n\n\nthree separate test phases.\n\n\n\nAll results confirmed statistical significance\n\n\nwith p < 0.01 across each trial run.'
      }
    };

    function countWords(str) {
      if (!str || !str.trim()) return 0;
      return str.trim().split(/\s+/).length;
    }

    function countLines(str) {
      if (!str) return 0;
      return str.split(/\r?\n/).length;
    }

    // High-performance Empty Line Stripper logic
    function cleanEmptyLines(text) {
      if (!text) {
        return {
          result: '',
          linesRemoved: 0,
          originalLines: 0,
          outputLines: 0
        };
      }

      const rawLines = text.split(/\r?\n/);
      const isWhitespaceOnly = optWhitespaceOnly ? optWhitespaceOnly.checked : true;
      const isTrimEdges = optTrimEdges ? optTrimEdges.checked : true;
      const isCollapseBlanks = optCollapseBlanks ? optCollapseBlanks.checked : false;

      function isBlank(line) {
        return isWhitespaceOnly ? /^\s*$/.test(line) : line.length === 0;
      }

      let processed = [];

      if (isCollapseBlanks) {
        let prevWasBlank = false;
        for (let i = 0; i < rawLines.length; i++) {
          const line = rawLines[i];
          if (isBlank(line)) {
            if (!prevWasBlank) {
              processed.push('');
              prevWasBlank = true;
            }
          } else {
            processed.push(line);
            prevWasBlank = false;
          }
        }
      } else {
        for (let i = 0; i < rawLines.length; i++) {
          const line = rawLines[i];
          if (!isBlank(line)) {
            processed.push(line);
          }
        }
      }

      if (isTrimEdges) {
        while (processed.length > 0 && isBlank(processed[0])) {
          processed.shift();
        }
        while (processed.length > 0 && isBlank(processed[processed.length - 1])) {
          processed.pop();
        }
      }

      const result = processed.join('\n');
      const linesRemoved = Math.max(0, rawLines.length - (result ? processed.length : 0));

      return {
        result: result,
        linesRemoved: linesRemoved,
        originalLines: rawLines.length,
        outputLines: result ? processed.length : 0
      };
    }

    function update() {
      const raw = inputText.value || '';
      const cleanResult = cleanEmptyLines(raw);
      outputText.value = cleanResult.result;

      // Input Stats
      const inChars = raw.length;
      const inWords = countWords(raw);
      const inLines = raw ? countLines(raw) : 0;

      statInputChars.textContent = inChars.toLocaleString();
      statInputWords.textContent = inWords.toLocaleString();
      statInputLines.textContent = inLines.toLocaleString();

      // Output Stats
      const outChars = cleanResult.result.length;
      const outLines = cleanResult.result ? cleanResult.outputLines : 0;

      statOutputChars.textContent = outChars.toLocaleString();
      statOutputLines.textContent = outLines.toLocaleString();

      const stripped = cleanResult.linesRemoved;
      statLinesSaved.textContent = stripped.toLocaleString();

      const pct = inLines > 0 ? Math.max(0, Math.round((stripped / inLines) * 100)) : 0;
      statReductionPct.textContent = pct + '% reduction';

      statusLinesRemoved.textContent =
        stripped.toLocaleString() + ' empty ' + (stripped === 1 ? 'line' : 'lines') + ' removed';
    }

    // Debounce helper for silky performance with large text
    let timeoutId;
    function debouncedUpdate() {
      clearTimeout(timeoutId);
      timeoutId = setTimeout(update, 50);
    }

    // Event Listeners
    inputText?.addEventListener('input', debouncedUpdate);
    optWhitespaceOnly?.addEventListener('change', update);
    optTrimEdges?.addEventListener('change', update);
    optCollapseBlanks?.addEventListener('change', update);
    btnStrip?.addEventListener('click', update);

    // Sample Text
    btnSample?.addEventListener('click', function () {
      inputText.value =
        'First paragraph with essential information.\n\n\n\nSecond paragraph following several accidental empty lines.\n   \nThird paragraph after hidden whitespace-only lines.\n\n\nFourth paragraph.\n\n\n\n';
      update();
    });

    // Clear
    btnClear?.addEventListener('click', function () {
      inputText.value = '';
      outputText.value = '';
      update();
      inputText.focus();
    });

    // Paste from Clipboard
    btnPaste?.addEventListener('click', async function () {
      try {
        if (navigator.clipboard && navigator.clipboard.readText) {
          const clipText = await navigator.clipboard.readText();
          if (clipText) {
            inputText.value = clipText;
            update();
          }
        } else {
          inputText.focus();
          inputText.select();
        }
      } catch (err) {
        inputText.focus();
      }
    });

    // Copy to Clipboard
    btnCopy?.addEventListener('click', async function () {
      const textToCopy = outputText.value;
      if (!textToCopy) return;

      try {
        if (navigator.clipboard && navigator.clipboard.writeText) {
          await navigator.clipboard.writeText(textToCopy);
        } else {
          outputText.select();
          document.execCommand('copy');
        }

        copyBtnText.textContent = 'Copied!';
        copyIconIdle.classList.add('hidden');
        copyIconSuccess.classList.remove('hidden');

        setTimeout(function () {
          copyBtnText.textContent = 'Copy Result';
          copyIconIdle.classList.remove('hidden');
          copyIconSuccess.classList.add('hidden');
        }, 2000);
      } catch (err) {
        outputText.select();
      }
    });

    // Download .txt file
    btnDownload?.addEventListener('click', function () {
      const content = outputText.value;
      if (!content) return;

      const blob = new Blob([content], { type: 'text/plain;charset=utf-8' });
      const url = URL.createObjectURL(blob);
      const a = document.createElement('a');
      a.href = url;
      a.download = 'cleaned-text.txt';
      document.body.appendChild(a);
      a.click();
      document.body.removeChild(a);
      URL.revokeObjectURL(url);
    });

    // Preset Buttons
    presetButtons.forEach(function (btn) {
      btn.addEventListener('click', function () {
        const id = btn.getAttribute('data-preset');
        const data = presetMap[id];
        if (!data) return;

        optWhitespaceOnly.checked = data.options.whitespaceOnly;
        optTrimEdges.checked = data.options.trimEdges;
        optCollapseBlanks.checked = data.options.collapseBlanks;

        if (data.sample) {
          inputText.value = data.sample;
        }

        update();

        // Scroll to editor
        const studio = document.getElementById('input-text');
        if (studio) {
          studio.scrollIntoView({ behavior: 'smooth', block: 'center' });
        }
      });
    });

    // Initial update on page load
    update();
  })();
</script>
