---
import Layout from '../../layouts/Layout.astro';
import ToolIcon from '../../components/ToolIcon.astro';

// FAQ Data for Schema and Accordion
const faqs = [
  {
    question: "How do I remove empty lines from text online?",
    answer: "Simply paste or type your text into the Input Text box. FastToolVerse automatically scans each line in real time and strips out all empty or whitespace-only lines. You can customize the behavior to collapse consecutive blank lines into single breaks, trim edge lines, or strip all blank lines completely."
  },
  {
    question: "Does this tool remove lines that look empty but contain spaces or tabs?",
    answer: "Yes. When the 'Remove whitespace-only lines' option is enabled (checked by default), FastToolVerse uses regex evaluation to detect lines consisting solely of spaces, tabs, or non-breaking spaces, ensuring invisible whitespace doesn't leave phantom gaps in your document."
  },
  {
    question: "What does 'Collapse consecutive blank lines to a single blank line' do?",
    answer: "Instead of stripping out every single blank line and joining paragraphs together, this option condenses sequences of multiple blank lines into a single, clean blank line. This preserves standard paragraph spacing while eliminating erratic double- or triple-spaced gaps."
  },
  {
    question: "Does FastToolVerse upload my text or source code to a server?",
    answer: "No. FastToolVerse operates 100% client-side in your web browser. Your text, proprietary code snippets, student essays, and confidential datasets never leave your device RAM and are never transmitted over the internet."
  },
  {
    question: "How do I fix extra blank lines in text copied from a PDF?",
    answer: "PDF documents often insert erratic line breaks and blank rows when copied. Paste your PDF text into FastToolVerse, keep 'Remove whitespace-only lines' and 'Trim leading/trailing blank lines' enabled, and toggle 'Collapse consecutive blank lines' if you wish to keep natural paragraph spacing."
  },
  {
    question: "Can I remove empty lines from source code, SQL, or Markdown files?",
    answer: "Yes. FastToolVerse preserves line indentation on non-empty rows, making it safe for programming languages (JavaScript, Python, C++), SQL queries, and Markdown files. You can copy the result directly or export it as a clean .txt file."
  },
  {
    question: "Is there a line count or document size limit?",
    answer: "Because processing runs directly on your computer's local CPU using fast string iteration, you can comfortably clean documents with tens of thousands of lines without lag or server upload quotas."
  },
  {
    question: "Does this blank line remover work offline?",
    answer: "Yes. Once the page is loaded in your browser, all JavaScript logic runs locally. You can disconnect from the internet or work in airplane mode, and FastToolVerse will continue to clean your text flawlessly."
  }
];

// Schema.org SoftwareApplication
const jsonLdSoftwareApp = {
  "@context": "https://schema.org",
  "@type": "SoftwareApplication",
  "name": "Free Online Empty Line Remover & Blank Line Stripper",
  "applicationCategory": "UtilitiesApplication",
  "operatingSystem": "All (Web Browser)",
  "browserRequirements": "Requires JavaScript. Runs 100% client-side.",
  "offers": {
    "@type": "Offer",
    "price": "0",
    "priceCurrency": "USD"
  },
  "featureList": [
    "100% In-browser text cleaning privacy",
    "Strip empty and blank lines instantly",
    "Delete lines containing invisible whitespace and tabs",
    "Collapse multiple consecutive blank lines into single blank line",
    "Trim leading and trailing blank line padding",
    "Live line, character, and empty line reduction counters",
    "1-click copy to clipboard and .txt file export"
  ]
};

// Schema.org FAQPage
const jsonLdFaq = {
  "@context": "https://schema.org",
  "@type": "FAQPage",
  "mainEntity": faqs.map((f) => ({
    "@type": "Question",
    "name": f.question,
    "acceptedAnswer": {
      "@type": "Answer",
      "text": f.answer
    }
  }))
};

// Schema.org BreadcrumbList
const jsonLdBreadcrumb = {
  "@context": "https://schema.org",
  "@type": "BreadcrumbList",
  "itemListElement": [
    {
      "@type": "ListItem",
      "position": 1,
      "name": "Home",
      "item": "https://fasttoolverse.com/"
    },
    {
      "@type": "ListItem",
      "position": 2,
      "name": "Text & Formatting",
      "item": "https://fasttoolverse.com/#text-tools-section"
    },
    {
      "@type": "ListItem",
      "position": 3,
      "name": "Remove Empty Lines",
      "item": "https://fasttoolverse.com/tools/remove-empty-lines"
    }
  ]
};

const canonicalUrl = "https://fasttoolverse.com/tools/remove-empty-lines";
const pageTitle = "Remove Empty Lines Online - Free Blank Line Stripper & Text Condenser | FastToolVerse";
const pageDescription = "Strip blank lines, remove whitespace-only breaks, and condense paragraphs online with zero server uploads. 100% private, client-side empty line remover.";
const pageKeywords = "remove empty lines, blank line stripper, delete empty lines, remove blank lines online, collapse blank lines, clean empty rows, text condenser, strip whitespace lines, client side text tool";
const ogImage = "https://fasttoolverse.com/og-image.png";

// Programmatic target cards / presets
const presets = [
  {
    id: "preset-strip-all",
    title: "Strip All Blank Lines",
    tag: "Compact Text",
    desc: "Delete every single blank line and whitespace break to create densely packed, single-spaced text.",
    options: { whitespaceOnly: true, trimEdges: true, collapseBlanks: false },
    sampleText: "Paragraph one contains primary analysis.\n\n\n\nParagraph two follows several accidental line returns.\n\n\nParagraph three concludes the summary."
  },
  {
    id: "preset-collapse-double",
    title: "Collapse Double Spacing",
    tag: "Paragraph Normalizer",
    desc: "Reduce chaotic multi-line gaps into consistent single blank lines between paragraphs.",
    options: { whitespaceOnly: true, trimEdges: true, collapseBlanks: true },
    sampleText: "Chapter 1: The Beginning\n\n\n\n\nIt was a crisp autumn morning in the mountains.\n\n\n\n\nLeaves drifted softly across the cobblestone pathway.\n\n\n\nThe adventure was about to start."
  },
  {
    id: "preset-whitespace-lines",
    title: "Clean Whitespace Lines",
    tag: "Hidden Spaces & Tabs",
    desc: "Detect and remove deceptive blank lines that appear empty but contain invisible spaces or tabs.",
    options: { whitespaceOnly: true, trimEdges: true, collapseBlanks: false },
    sampleText: "User Data Record:\n   \nID: 9021\n\t\t\t\nStatus: Active\n     \nRole: Administrator"
  },
  {
    id: "preset-source-code",
    title: "Clean Raw Source Code",
    tag: "Development & Scripts",
    desc: "Strip out unnecessary blank line breaks from minified scripts, SQL queries, or configuration manifests.",
    options: { whitespaceOnly: true, trimEdges: true, collapseBlanks: false },
    sampleText: "import express from 'express';\n\n\nconst app = express();\n\n\nconst PORT = process.env.PORT || 3000;\n\n\napp.get('/api', (req, res) => {\n\n  res.json({ status: 'ok' });\n\n});"
  },
  {
    id: "preset-markdown-breaks",
    title: "Format Markdown Line Breaks",
    tag: "Documentation & Notes",
    desc: "Standardize spacing between Markdown headings, blockquotes, and lists by collapsing excessive line breaks.",
    options: { whitespaceOnly: true, trimEdges: true, collapseBlanks: true },
    sampleText: "# Documentation\n\n\n\n## Getting Started\n\n\n\nRun the quickstart installer:\n\n\n\n```bash\nnpm install fast-tool\n```\n\n\n\n## Configuration"
  },
  {
    id: "preset-pdf-text",
    title: "Clean Copy-Pasted PDF Text",
    tag: "PDFs & OCR Scans",
    desc: "Fix disjointed text extracted from PDF columns, eBook readers, or OCR scanners with irregular blank line wraps.",
    options: { whitespaceOnly: true, trimEdges: true, collapseBlanks: false },
    sampleText: "The study examined fifty participants across\n\n\nthree separate test phases.\n\n\n\nAll results confirmed statistical significance\n\n\nwith p < 0.01 across each trial run."
  }
];
---

<Layout
  title={pageTitle}
  description={pageDescription}
  canonicalUrl={canonicalUrl}
  image={ogImage}
>
  <!-- Injected Head Elements: Twitter & JSON-LD Schemas -->
  <Fragment slot="head">
    <meta name="keywords" content={pageKeywords} />

    <!-- Open Graph tags -->
    <meta property="og:type" content="website" />
    <meta property="og:url" content={canonicalUrl} />
    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={pageDescription} />
    <meta property="og:image" content={ogImage} />

    <!-- Twitter Card -->
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:url" content={canonicalUrl} />
    <meta name="twitter:title" content={pageTitle} />
    <meta name="twitter:description" content={pageDescription} />
    <meta name="twitter:image" content={ogImage} />

    <!-- Structured Data Schemas -->
    <script type="application/ld+json" set:html={JSON.stringify(jsonLdSoftwareApp)} />
    <script type="application/ld+json" set:html={JSON.stringify(jsonLdFaq)} />
    <script type="application/ld+json" set:html={JSON.stringify(jsonLdBreadcrumb)} />
  </Fragment>

  <!-- Hero Header Section -->
  <section class="relative pt-10 pb-6 sm:pt-14 sm:pb-8 overflow-hidden">
    <div class="hero-mesh-bg" aria-hidden="true"></div>

    <div class="relative max-w-5xl mx-auto px-4 sm:px-6 lg:px-8 text-center">
      <!-- Breadcrumbs -->
      <nav aria-label="Breadcrumb" class="mb-5 flex justify-center">
        <ol class="inline-flex items-center space-x-1.5 md:space-x-2 text-xs font-medium text-slate-500 dark:text-slate-400">
          <li class="inline-flex items-center">
            <a href="/" class="hover:text-blue-600 dark:hover:text-blue-400 transition-colors">Home</a>
          </li>
          <li>
            <div class="flex items-center">
              <svg class="w-3 h-3 text-slate-400 mx-1" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7" />
              </svg>
              <a href="/#text-tools-section" class="hover:text-purple-600 dark:hover:text-purple-400 transition-colors">Text & Formatting</a>
            </div>
          </li>
          <li aria-current="page">
            <div class="flex items-center">
              <svg class="w-3 h-3 text-slate-400 mx-1" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7" />
              </svg>
              <span class="text-slate-900 dark:text-white font-semibold">Remove Empty Lines</span>
            </div>
          </li>
        </ol>
      </nav>

      <!-- Privacy Status Badge -->
      <div class="inline-flex items-center gap-1.5 px-3.5 py-1 rounded-full text-xs font-semibold bg-purple-50 dark:bg-purple-950/50 text-purple-600 dark:text-purple-400 border border-purple-200 dark:border-purple-900/50 mb-3 shadow-2xs">
        <ToolIcon name="shield-check" class="w-3.5 h-3.5" />
        <span>100% In-Browser Privacy • Zero Server Uploads</span>
      </div>

      <!-- Hero Title -->
      <h1 class="text-3xl sm:text-4xl md:text-5xl font-bold tracking-tight text-slate-900 dark:text-white leading-tight">
        Free Online Empty Line Remover & Blank Line Stripper
      </h1>

      <!-- Subtitle -->
      <p class="mt-3 sm:mt-4 text-base sm:text-lg text-slate-600 dark:text-slate-400 max-w-2xl mx-auto leading-relaxed">
        Strip blank lines, delete whitespace-only breaks, and condense paragraphs with zero latency.
      </p>
    </div>
  </section>

  <!-- Interactive Studio Container -->
  <section class="max-w-6xl mx-auto px-4 sm:px-6 lg:px-8 pb-16 sm:pb-24">
    <div class="rounded-2xl border border-slate-200 dark:border-slate-800 bg-white dark:bg-slate-900 shadow-xl overflow-hidden transition-colors">
      
      <!-- Top Options & Controls Bar -->
      <div class="p-5 sm:p-6 border-b border-slate-200 dark:border-slate-800 bg-slate-50/70 dark:bg-slate-900/70">
        <div class="flex flex-col lg:flex-row lg:items-center justify-between gap-4">
          
          <!-- Cleaning Rules (Checkboxes) -->
          <div class="flex flex-wrap items-center gap-x-6 gap-y-3">
            <label class="inline-flex items-center gap-2 cursor-pointer text-xs sm:text-sm font-medium text-slate-700 dark:text-slate-300 hover:text-slate-900 dark:hover:text-white transition-colors">
              <input
                type="checkbox"
                id="opt-whitespace-only"
                checked
                class="w-4 h-4 rounded border-slate-300 dark:border-slate-700 text-purple-600 focus:ring-purple-500 dark:bg-slate-800 cursor-pointer"
              />
              <span>Remove whitespace-only lines</span>
            </label>

            <label class="inline-flex items-center gap-2 cursor-pointer text-xs sm:text-sm font-medium text-slate-700 dark:text-slate-300 hover:text-slate-900 dark:hover:text-white transition-colors">
              <input
                type="checkbox"
                id="opt-trim-edges"
                checked
                class="w-4 h-4 rounded border-slate-300 dark:border-slate-700 text-purple-600 focus:ring-purple-500 dark:bg-slate-800 cursor-pointer"
              />
              <span>Trim leading/trailing blank lines</span>
            </label>

            <label class="inline-flex items-center gap-2 cursor-pointer text-xs sm:text-sm font-medium text-slate-700 dark:text-slate-300 hover:text-slate-900 dark:hover:text-white transition-colors">
              <input
                type="checkbox"
                id="opt-collapse-blanks"
                class="w-4 h-4 rounded border-slate-300 dark:border-slate-700 text-purple-600 focus:ring-purple-500 dark:bg-slate-800 cursor-pointer"
              />
              <span>Collapse consecutive blank lines to a single blank line</span>
            </label>
          </div>

          <!-- Action Buttons -->
          <div class="flex items-center gap-2.5 shrink-0">
            <button
              type="button"
              id="btn-sample"
              class="px-3.5 py-1.5 text-xs font-semibold rounded-lg border border-slate-200 dark:border-slate-700 text-slate-700 dark:text-slate-300 hover:bg-slate-100 dark:hover:bg-slate-800 transition-colors cursor-pointer shadow-2xs"
            >
              Load Sample
            </button>
            <button
              type="button"
              id="btn-strip"
              class="px-5 py-2 text-xs sm:text-sm font-semibold rounded-lg bg-purple-600 hover:bg-purple-700 text-white shadow-sm transition-all flex items-center gap-2 cursor-pointer"
            >
              <ToolIcon name="list-x" class="w-4 h-4" />
              <span>Strip Empty Lines</span>
            </button>
          </div>

        </div>
      </div>

      <!-- Dual Textarea Layout -->
      <div class="grid grid-cols-1 lg:grid-cols-2 divide-y lg:divide-y-0 lg:divide-x divide-slate-200 dark:divide-slate-800">
        
        <!-- Left: Input Area -->
        <div class="p-5 sm:p-6 flex flex-col space-y-3 bg-white dark:bg-slate-900">
          <div class="flex items-center justify-between">
            <div class="flex items-center gap-2">
              <span class="text-xs font-mono uppercase tracking-wider font-semibold text-slate-500 dark:text-slate-400">
                Input Text
              </span>
              <span id="badge-input-ready" class="text-[11px] font-medium px-2 py-0.5 rounded-full bg-slate-100 dark:bg-slate-800 text-slate-600 dark:text-slate-400">
                Live Typing
              </span>
            </div>
            
            <div class="flex items-center gap-2">
              <button
                type="button"
                id="btn-paste"
                class="px-2.5 py-1 text-xs font-medium rounded-md border border-slate-200 dark:border-slate-700/80 hover:bg-slate-100 dark:hover:bg-slate-800 text-slate-700 dark:text-slate-300 transition-colors flex items-center gap-1.5 cursor-pointer"
                title="Paste from clipboard"
              >
                <svg class="w-3.5 h-3.5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                  <path stroke-linecap="round" stroke-linejoin="round" d="M9 5H7a2 2 0 00-2 2v12a2 2 0 002 2h10a2 2 0 002-2V7a2 2 0 00-2-2h-2M9 5a2 2 0 002 2h2a2 2 0 002-2M9 5a2 2 0 012-2h2a2 2 0 012 2" />
                </svg>
                <span>Paste</span>
              </button>
              <button
                type="button"
                id="btn-clear"
                class="px-2.5 py-1 text-xs font-medium rounded-md border border-slate-200 dark:border-slate-700/80 hover:bg-rose-50 dark:hover:bg-rose-950/40 text-slate-600 hover:text-rose-600 dark:text-slate-400 dark:hover:text-rose-400 transition-colors cursor-pointer"
                title="Clear input text"
              >
                Clear
              </button>
            </div>
          </div>

          <textarea
            id="input-text"
            rows="14"
            placeholder="Paste or type your text here... Blank lines, empty line returns, and whitespace-only breaks will be removed instantly."
            class="w-full p-4 rounded-xl border border-slate-200 dark:border-slate-800 bg-slate-50/50 dark:bg-slate-950/60 text-slate-900 dark:text-slate-100 font-mono text-sm leading-relaxed placeholder:text-slate-400 dark:placeholder:text-slate-600 focus:outline-none focus:ring-2 focus:ring-purple-500/30 focus:border-purple-500 transition resize-y min-h-[320px]"
            spellcheck="false"
          ></textarea>

          <!-- Input Live Counters -->
          <div class="flex items-center justify-between text-xs text-slate-500 dark:text-slate-400 pt-1 font-mono">
            <div class="flex items-center gap-3">
              <span>Lines: <strong id="stat-input-lines" class="text-slate-800 dark:text-slate-200">0</strong></span>
              <span>Chars: <strong id="stat-input-chars" class="text-slate-800 dark:text-slate-200">0</strong></span>
              <span>Words: <strong id="stat-input-words" class="text-slate-800 dark:text-slate-200">0</strong></span>
            </div>
            <div class="text-[11px] text-slate-400 dark:text-slate-500">
              Input buffer
            </div>
          </div>
        </div>

        <!-- Right: Output Area -->
        <div class="p-5 sm:p-6 flex flex-col space-y-3 bg-white dark:bg-slate-900">
          <div class="flex items-center justify-between">
            <div class="flex items-center gap-2">
              <span class="text-xs font-mono uppercase tracking-wider font-semibold text-purple-600 dark:text-purple-400">
                Cleaned Result
              </span>
              <span
                id="status-lines-removed"
                class="text-[11px] font-medium px-2 py-0.5 rounded-full bg-emerald-50 dark:bg-emerald-950/50 text-emerald-700 dark:text-emerald-400 border border-emerald-200 dark:border-emerald-900/40"
              >
                0 empty lines removed
              </span>
            </div>

            <div class="flex items-center gap-2">
              <button
                type="button"
                id="btn-copy"
                class="px-3 py-1 text-xs font-semibold rounded-md bg-purple-600 hover:bg-purple-700 text-white transition-colors flex items-center gap-1.5 cursor-pointer shadow-xs"
                title="Copy cleaned text to clipboard"
              >
                <svg id="copy-icon-idle" class="w-3.5 h-3.5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                  <rect x="9" y="9" width="13" height="13" rx="2" ry="2"></rect>
                  <path d="M5 15H4a2 2 0 01-2-2V4a2 2 0 012-2h9a2 2 0 012 2v1"></path>
                </svg>
                <svg id="copy-icon-success" class="w-3.5 h-3.5 hidden text-emerald-300" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                  <polyline points="20 6 9 17 4 12"></polyline>
                </svg>
                <span id="copy-btn-text">Copy Result</span>
              </button>

              <button
                type="button"
                id="btn-download"
                class="px-2.5 py-1 text-xs font-medium rounded-md border border-slate-200 dark:border-slate-700/80 hover:bg-slate-100 dark:hover:bg-slate-800 text-slate-700 dark:text-slate-300 transition-colors flex items-center gap-1.5 cursor-pointer"
                title="Download cleaned text as .txt file"
              >
                <svg class="w-3.5 h-3.5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                  <path stroke-linecap="round" stroke-linejoin="round" d="M4 16v1a3 3 0 003 3h10a3 3 0 003-3v-1m-4-4l-4 4m0 0l-4-4m4 4V4" />
                </svg>
                <span>.txt</span>
              </button>
            </div>
          </div>

          <textarea
            id="output-text"
            rows="14"
            placeholder="Your condensed text without blank lines will appear here..."
            class="w-full p-4 rounded-xl border border-slate-200 dark:border-slate-800 bg-slate-50/50 dark:bg-slate-950/60 text-slate-900 dark:text-slate-100 font-mono text-sm leading-relaxed placeholder:text-slate-400 dark:placeholder:text-slate-600 focus:outline-none focus:ring-2 focus:ring-purple-500/30 focus:border-purple-500 transition resize-y min-h-[320px]"
            spellcheck="false"
          ></textarea>

          <!-- Output Live Counters -->
          <div class="flex items-center justify-between text-xs text-slate-500 dark:text-slate-400 pt-1 font-mono">
            <div class="flex items-center gap-3">
              <span>Lines: <strong id="stat-output-lines" class="text-slate-800 dark:text-slate-200">0</strong></span>
              <span>Chars: <strong id="stat-output-chars" class="text-slate-800 dark:text-slate-200">0</strong></span>
              <span>Stripped: <strong id="stat-lines-saved" class="text-emerald-600 dark:text-emerald-400">0</strong></span>
            </div>
            <div id="stat-reduction-pct" class="text-[11px] font-semibold text-emerald-600 dark:text-emerald-400">
              0% reduction
            </div>
          </div>
        </div>

      </div>

    </div>
  </section>

  <!-- 3-Step Guide Section -->
  <section class="border-t border-slate-200 dark:border-slate-800 bg-slate-50/50 dark:bg-slate-900/40 py-16 sm:py-20">
    <div class="max-w-5xl mx-auto px-4 sm:px-6 lg:px-8">
      
      <div class="text-center max-w-2xl mx-auto mb-12">
        <h2 class="text-2xl sm:text-3xl font-bold tracking-tight text-slate-900 dark:text-white">
          How to Remove Empty Lines Online in 3 Simple Steps
        </h2>
        <p class="mt-2 text-sm sm:text-base text-slate-600 dark:text-slate-400">
          Clean messy gaps, strip hidden whitespace breaks, and condense paragraphs in seconds.
        </p>
      </div>

      <div class="grid grid-cols-1 md:grid-cols-3 gap-6 sm:gap-8">
        
        <!-- Step 1 -->
        <div class="p-6 rounded-2xl border border-slate-200 dark:border-slate-800 bg-white dark:bg-slate-900 shadow-xs relative">
          <div class="w-10 h-10 rounded-xl bg-purple-50 dark:bg-purple-950/40 text-purple-600 dark:text-purple-400 flex items-center justify-center font-bold font-mono text-sm mb-4 border border-purple-100 dark:border-purple-900/50">
            01
          </div>
          <h3 class="text-base font-semibold text-slate-900 dark:text-white mb-2">
            Paste or Enter Text
          </h3>
          <p class="text-sm text-slate-600 dark:text-slate-400 leading-relaxed">
            Copy text from a PDF, document, script, or Markdown file and paste it directly into the input box using <kbd class="px-1.5 py-0.5 text-xs font-mono bg-slate-100 dark:bg-slate-800 rounded border border-slate-200 dark:border-slate-700">Ctrl+V</kbd> or the Paste button.
          </p>
        </div>

        <!-- Step 2 -->
        <div class="p-6 rounded-2xl border border-slate-200 dark:border-slate-800 bg-white dark:bg-slate-900 shadow-xs relative">
          <div class="w-10 h-10 rounded-xl bg-purple-50 dark:bg-purple-950/40 text-purple-600 dark:text-purple-400 flex items-center justify-center font-bold font-mono text-sm mb-4 border border-purple-100 dark:border-purple-900/50">
            02
          </div>
          <h3 class="text-base font-semibold text-slate-900 dark:text-white mb-2">
            Configure Line Rules
          </h3>
          <p class="text-sm text-slate-600 dark:text-slate-400 leading-relaxed">
            Choose whether to delete all blank lines completely or collapse consecutive breaks into single lines. Enable whitespace detection to purge invisible space characters.
          </p>
        </div>

        <!-- Step 3 -->
