---
import Layout from '../../../layouts/Layout.astro';
import ToolIcon from '../../../components/ToolIcon.astro';
import PopularRemoveEmptyLines from '../../../components/PopularRemoveEmptyLines.astro';

// FAQ Data for Schema and Accordion
const faqs = [
  {
    question: "How do I remove all blank lines online without downloading software?",
    answer: "Paste or type your text into the input workspace above. FastToolVerse automatically evaluates every row in real time and strips out blank lines instantly without uploading your data to any server. You can configure options to delete all blanks, purge whitespace-only lines, or collapse consecutive breaks, then click Copy Result or download as a clean .txt file with one click."
  },
  {
    question: "How do I delete empty lines in Excel created by Alt + Enter?",
    answer: "In Microsoft Excel, in-cell multiline breaks are generated using Alt + Enter (represented by ASCII character CHAR(10)). To delete these breaks across a column, select the cells, press Ctrl + H to open Find and Replace, click in the 'Find what' field, press Ctrl + J (which inserts the invisible line break character), and leave 'Replace with' empty or enter a single space before clicking Replace All. You can also paste the column into our tool to clean trailing breaks instantly."
  },
  {
    question: "What is the fastest way to get rid of extra blank lines in Microsoft Word?",
    answer: "In Microsoft Word, press Ctrl + H (or Cmd + H on Mac) to open Find and Replace. In the 'Find what' field, type ^p^p (which represents two consecutive paragraph breaks). In the 'Replace with' field, type ^p. Click 'Replace All' repeatedly until zero replacements remain. If lines were created using soft manual line breaks (Shift + Enter), search for ^l^l and replace with ^l."
  },
  {
    question: "How do I remove lines that contain only invisible whitespace or tabs?",
    answer: "Ensure the 'Remove whitespace-only lines' option is checked (enabled by default). Standard text utilities fail when lines contain space characters (\\u0020), tab stops (\\t), or non-breaking spaces because their character length is greater than zero. Our regex engine uses /^\\s*$/ to identify and purge any row that contains only non-printing whitespace characters."
  },
  {
    question: "How to collapse multiple consecutive blank lines into a single blank line?",
    answer: "Toggle the 'Collapse consecutive blank lines to one' option in the workspace bar. When enabled, our algorithm preserves single paragraph breaks while condensing runs of multiple consecutive empty or whitespace-only lines into exactly one clean blank line. This keeps paragraphs readable while eliminating unsightly vertical gaps."
  },
  {
    question: "Can I safely clean source code, SQL queries, or Markdown files without ruining indentation?",
    answer: "Yes. The tool only evaluates blank or whitespace-only lines. Non-empty lines retain their full leading indentation spaces and tabs, making it completely safe for Python scripts, JavaScript, SQL queries, YAML files, and Markdown lists."
  },
  {
    question: "Is my text, manuscript, or code secure when using this online tool?",
    answer: "Absolute privacy is guaranteed. All text processing operates 100% client-side inside your browser sandbox. No text is ever uploaded to a server, logged in a database, or shared over the internet. You can even use this tool completely offline."
  }
];

// Schema.org SoftwareApplication
const jsonLdSoftwareApp = {
  "@context": "https://schema.org",
  "@type": "SoftwareApplication",
  "name": "Remove Empty Lines Online - Free Text Cleaner",
  "applicationCategory": "UtilitiesApplication",
  "operatingSystem": "All (Web Browser)",
  "browserRequirements": "Requires JavaScript. Runs 100% client-side.",
  "offers": {
    "@type": "Offer",
    "price": "0",
    "priceCurrency": "USD"
  },
  "featureList": [
    "100% In-browser text cleaning privacy",
    "Strip empty and blank lines instantly",
    "Delete lines containing invisible whitespace and tabs",
    "Collapse multiple consecutive blank lines into single blank line",
    "Trim leading and trailing blank line padding",
    "Live line, character, and empty line reduction counters",
    "1-click copy to clipboard and .txt file export"
  ]
};

// Schema.org FAQPage
const jsonLdFaq = {
  "@context": "https://schema.org",
  "@type": "FAQPage",
  "mainEntity": faqs.map((f) => ({
    "@type": "Question",
    "name": f.question,
    "acceptedAnswer": {
      "@type": "Answer",
      "text": f.answer
    }
  }))
};

// Schema.org BreadcrumbList
const jsonLdBreadcrumb = {
  "@context": "https://schema.org",
  "@type": "BreadcrumbList",
  "itemListElement": [
    {
      "@type": "ListItem",
      "position": 1,
      "name": "Home",
      "item": "https://fasttoolverse.com/"
    },
    {
      "@type": "ListItem",
      "position": 2,
      "name": "Text & Formatting",
      "item": "https://fasttoolverse.com/#text-tools-section"
    },
    {
      "@type": "ListItem",
      "position": 3,
      "name": "Remove Empty Lines",
      "item": "https://fasttoolverse.com/tools/remove-empty-lines/"
    }
  ]
};

const canonicalUrl = "https://fasttoolverse.com/tools/remove-empty-lines/";
const pageTitle = "Remove Empty Lines Online - Free Text Cleaner";
const pageDescription = "Remove empty lines and blank spaces from your text online for free. Strip tabs, collapse breaks, and clean code with 100% private in-browser processing.";
const pageKeywords = "remove empty lines, blank line stripper, delete empty lines, remove blank lines online, collapse blank lines, clean empty rows, text condenser, strip whitespace lines, client side text tool";
const ogImage = "https://fasttoolverse.com/og-image.png";

---

<Layout
  title={pageTitle}
  description={pageDescription}
  canonicalUrl={canonicalUrl}
  image={ogImage}
>
  <!-- Injected Head Elements: Twitter & JSON-LD Schemas -->
  <Fragment slot="head">
    <meta name="keywords" content={pageKeywords} />

    <!-- Open Graph tags -->
    <meta property="og:type" content="website" />
    <meta property="og:url" content={canonicalUrl} />
    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={pageDescription} />
    <meta property="og:image" content={ogImage} />

    <!-- Twitter Card -->
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:url" content={canonicalUrl} />
    <meta name="twitter:title" content={pageTitle} />
    <meta name="twitter:description" content={pageDescription} />
    <meta name="twitter:image" content={ogImage} />

    <!-- Structured Data Schemas -->
    <script type="application/ld+json" set:html={JSON.stringify(jsonLdSoftwareApp)} />
    <script type="application/ld+json" set:html={JSON.stringify(jsonLdFaq)} />
    <script type="application/ld+json" set:html={JSON.stringify(jsonLdBreadcrumb)} />
  </Fragment>

  <!-- Hero Header Section -->
  <section class="relative pt-10 pb-6 sm:pt-14 sm:pb-8 overflow-hidden">
    <div class="hero-mesh-bg" aria-hidden="true"></div>

    <div class="relative max-w-5xl mx-auto px-4 sm:px-6 lg:px-8 text-center">
      <!-- Breadcrumbs -->
      <nav aria-label="Breadcrumb" class="mb-5 flex justify-center">
        <ol class="inline-flex items-center space-x-1.5 md:space-x-2 text-xs font-medium text-slate-500 dark:text-slate-400">
          <li class="inline-flex items-center">
            <a href="/" class="hover:text-blue-600 dark:hover:text-blue-400 transition-colors">Home</a>
          </li>
          <li>
            <div class="flex items-center">
              <svg class="w-3 h-3 text-slate-400 mx-1" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7" />
              </svg>
              <a href="/#text-tools-section" class="hover:text-purple-600 dark:hover:text-purple-400 transition-colors">Text & Formatting</a>
            </div>
          </li>
          <li aria-current="page">
            <div class="flex items-center">
              <svg class="w-3 h-3 text-slate-400 mx-1" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7" />
              </svg>
              <span class="text-slate-900 dark:text-white font-semibold">Remove Empty Lines</span>
            </div>
          </li>
        </ol>
      </nav>

      <!-- Hero Title -->
      <h1 class="text-3xl sm:text-4xl md:text-5xl font-bold tracking-tight text-slate-900 dark:text-white leading-tight">
        Remove Empty Lines Online - Free Text Cleaner
      </h1>

      <!-- Subtitle -->
      <p class="mt-3 sm:mt-4 text-base sm:text-lg text-slate-600 dark:text-slate-400 max-w-2xl mx-auto leading-relaxed">
        Strip blank lines, delete whitespace-only breaks, and condense paragraphs with zero server uploads.
      </p>

      <!-- Intro Copy -->
      <div class="mt-5 max-w-3xl mx-auto text-sm sm:text-base text-slate-600 dark:text-slate-300 leading-relaxed text-center sm:text-left bg-white/70 dark:bg-slate-900/60 p-5 rounded-2xl border border-slate-300 dark:border-slate-800 shadow-2xs">
        <p>
          Messy blank lines, accidental double-spacing, and phantom whitespace breaks can ruin document formatting, source code, and copy-pasted PDF texts. FastToolVerse’s online empty line remover provides a free, instant, and 100% private in-browser solution. Paste your text, source code, or manuscript to automatically detect and strip empty rows, delete lines containing only spaces or tabs, or collapse erratic multiple blank lines into consistent single paragraph breaks. Because our high-speed regex engine executes entirely in your browser’s local memory, your proprietary code, customer records, and confidential manuscripts are never transmitted across the internet.
        </p>
      </div>
    </div>
  </section>

  <!-- Interactive Studio Container -->
  <section class="max-w-6xl mx-auto px-4 sm:px-6 lg:px-8 pb-16 sm:pb-24">
    <!-- Unified Professional Options Bar -->
    <div class="bg-slate-900/60 border border-slate-800/80 rounded-xl p-3 sm:p-4 mb-4 flex flex-wrap items-center justify-between gap-3">
      <!-- Left Cluster (Clean styled checkboxes with clear human labels) -->
      <div class="flex flex-wrap items-center gap-x-5 gap-y-2.5">
        <label class="inline-flex items-center gap-2 cursor-pointer text-xs sm:text-sm font-medium text-slate-300 hover:text-white transition-colors select-none">
          <input
            type="checkbox"
            id="opt-whitespace-only"
            checked
            class="w-4 h-4 rounded border-slate-700 bg-slate-800 text-emerald-500 focus:ring-emerald-500/30 focus:ring-2 cursor-pointer accent-emerald-500"
          />
          <span>Remove whitespace-only lines</span>
        </label>

        <label class="inline-flex items-center gap-2 cursor-pointer text-xs sm:text-sm font-medium text-slate-300 hover:text-white transition-colors select-none">
          <input
            type="checkbox"
            id="opt-collapse-blanks"
            checked
            class="w-4 h-4 rounded border-slate-700 bg-slate-800 text-emerald-500 focus:ring-emerald-500/30 focus:ring-2 cursor-pointer accent-emerald-500"
          />
          <span>Collapse consecutive blank lines to one</span>
        </label>

        <label class="inline-flex items-center gap-2 cursor-pointer text-xs sm:text-sm font-medium text-slate-300 hover:text-white transition-colors select-none">
          <input
            type="checkbox"
            id="opt-trim-edges"
            class="w-4 h-4 rounded border-slate-700 bg-slate-800 text-emerald-500 focus:ring-emerald-500/30 focus:ring-2 cursor-pointer accent-emerald-500"
          />
          <span>Trim leading & trailing blanks</span>
        </label>
      </div>

      <!-- Right Cluster (Balanced Action Buttons) -->
      <div class="flex items-center gap-2.5 shrink-0">
        <button
          type="button"
          id="btn-sample"
          class="bg-slate-800 hover:bg-slate-700 text-slate-300 text-xs px-3 py-2 rounded-lg font-medium transition cursor-pointer"
        >
          Load Sample
        </button>
        <button
          type="button"
          id="btn-strip"
          class="bg-emerald-600 hover:bg-emerald-500 active:bg-emerald-700 text-white shadow-sm shadow-emerald-900/20 font-medium px-4 py-2 rounded-lg text-xs sm:text-sm transition flex items-center gap-2 cursor-pointer"
        >
          <ToolIcon name="list-x" class="w-4 h-4" />
          <span>Remove Empty Lines</span>
        </button>
      </div>
    </div>

    <!-- Dual Textarea Layout Box -->
    <div class="rounded-2xl border border-slate-800/80 bg-slate-900/60 shadow-sm overflow-hidden">
      <div class="grid grid-cols-1 lg:grid-cols-2 divide-y lg:divide-y-0 lg:divide-x divide-slate-800/80">
        
        <!-- Left: Input Area -->
        <div class="p-4 sm:p-5 flex flex-col space-y-3 bg-slate-900/40">
          <div class="flex items-center justify-between">
            <span class="text-xs font-semibold uppercase tracking-wider text-slate-400">
              Input Text
            </span>
            
            <div class="flex items-center gap-2">
              <button
                type="button"
                id="btn-paste"
                class="px-2.5 py-1 text-xs font-medium rounded-lg border border-slate-700/80 bg-slate-800/70 hover:bg-slate-700 text-slate-300 hover:text-white transition-colors flex items-center gap-1.5 cursor-pointer shadow-xs"
                title="Paste from clipboard"
              >
                <svg class="w-3.5 h-3.5 text-slate-400" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                  <path stroke-linecap="round" stroke-linejoin="round" d="M9 5H7a2 2 0 00-2 2v12a2 2 0 002 2h10a2 2 0 002-2V7a2 2 0 00-2-2h-2M9 5a2 2 0 002 2h2a2 2 0 002-2M9 5a2 2 0 012-2h2a2 2 0 012 2" />
                </svg>
                <span>Paste</span>
              </button>
              <button
                type="button"
                id="btn-clear"
                class="px-2.5 py-1 text-xs font-medium rounded-lg border border-slate-700/80 bg-slate-800/70 hover:bg-rose-950/40 hover:border-rose-800/60 text-slate-300 hover:text-rose-400 transition-colors flex items-center gap-1.5 cursor-pointer shadow-xs"
                title="Clear input text"
              >
                <svg class="w-3.5 h-3.5 text-slate-400 group-hover:text-rose-400" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                  <path stroke-linecap="round" stroke-linejoin="round" d="M19 7l-.867 12.142A2 2 0 0116.138 21H7.862a2 2 0 01-1.995-1.858L5 7m5 4v6m4-6v6m1-10V4a1 1 0 00-1-1h-4a1 1 0 00-1 1v3M4 7h16" />
                </svg>
                <span>Clear</span>
              </button>
            </div>
          </div>

          <textarea
            id="input-text"
            rows="14"
            placeholder="Paste or type your text here... Blank lines, empty line returns, and whitespace-only breaks will be removed instantly."
            class="w-full p-4 rounded-xl border border-slate-800/80 bg-slate-950/70 font-sans text-slate-200 text-sm sm:text-base leading-relaxed tracking-normal placeholder:text-slate-500 focus:outline-none focus:ring-2 focus:ring-emerald-500/30 focus:border-emerald-500 transition resize-y min-h-[340px]"
            spellcheck="false"
          ></textarea>

          <!-- Input Live Footer Strip -->
          <div class="pt-2 px-1 flex items-center justify-between text-xs text-slate-400 font-sans">
            <div class="flex items-center gap-1.5 sm:gap-2">
              <span><strong id="stat-input-lines" class="font-medium text-slate-200">0</strong> Lines</span>
              <span class="text-slate-600">·</span>
              <span><strong id="stat-input-chars" class="font-medium text-slate-200">0</strong> Chars</span>
              <span class="text-slate-600">·</span>
              <span><strong id="stat-input-words" class="font-medium text-slate-200">0</strong> Words</span>
            </div>
          </div>
        </div>

        <!-- Right: Output Area -->
        <div class="p-4 sm:p-5 flex flex-col space-y-3 bg-slate-900/40">
          <div class="flex items-center justify-between">
            <div class="flex items-center gap-2 sm:gap-2.5">
              <span class="text-xs font-semibold uppercase tracking-wider text-slate-400">
                Cleaned Result
              </span>
              <span
                id="status-lines-removed"
                class="bg-emerald-500/10 text-emerald-400 border border-emerald-500/20 text-xs px-2 py-0.5 rounded-full font-medium"
              >
                0 lines removed
              </span>
            </div>

            <div class="flex items-center gap-2">
              <button
                type="button"
                id="btn-copy"
                class="px-3 py-1 text-xs font-semibold rounded-lg bg-slate-800 hover:bg-slate-700 text-slate-200 border border-slate-700/60 transition-colors flex items-center gap-1.5 cursor-pointer shadow-xs"
                title="Copy cleaned text to clipboard"
              >
                <svg id="copy-icon-idle" class="w-3.5 h-3.5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                  <rect x="9" y="9" width="13" height="13" rx="2" ry="2"></rect>
                  <path d="M5 15H4a2 2 0 01-2-2V4a2 2 0 012-2h9a2 2 0 012 2v1"></path>
                </svg>
                <svg id="copy-icon-success" class="w-3.5 h-3.5 hidden text-emerald-300" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                  <polyline points="20 6 9 17 4 12"></polyline>
                </svg>
                <span id="copy-btn-text">Copy</span>
              </button>

              <button
                type="button"
                id="btn-download"
                class="px-2.5 py-1 text-xs font-medium rounded-lg border border-slate-700/80 bg-slate-800/70 hover:bg-slate-700 text-slate-300 hover:text-white transition-colors flex items-center gap-1.5 cursor-pointer shadow-xs"
                title="Download cleaned text as .txt file"
              >
                <svg class="w-3.5 h-3.5 text-slate-400" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                  <path stroke-linecap="round" stroke-linejoin="round" d="M4 16v1a3 3 0 003 3h10a3 3 0 003-3v-1m-4-4l-4 4m0 0l-4-4m4 4V4" />
                </svg>
                <span>Download .txt</span>
              </button>
            </div>
          </div>

          <textarea
            id="output-text"
            rows="14"
            placeholder="Your condensed text without blank lines will appear here..."
            class="w-full p-4 rounded-xl border border-slate-800/80 bg-slate-950/70 font-sans text-slate-200 text-sm sm:text-base leading-relaxed tracking-normal placeholder:text-slate-500 focus:outline-none focus:ring-2 focus:ring-emerald-500/30 focus:border-emerald-500 transition resize-y min-h-[340px]"
            spellcheck="false"
          ></textarea>

          <!-- Output Live Footer Strip -->
          <div class="pt-2 px-1 flex items-center justify-between text-xs text-slate-400 font-sans">
            <div class="flex items-center gap-1.5 sm:gap-2">
              <span><strong id="stat-output-lines" class="font-medium text-slate-200">0</strong> Lines</span>
              <span class="text-slate-600">·</span>
              <span><strong id="stat-output-chars" class="font-medium text-slate-200">0</strong> Chars</span>
              <span class="text-slate-600">·</span>
              <span><strong id="stat-output-words" class="font-medium text-slate-200">0</strong> Words</span>
            </div>
            <div class="text-emerald-400 font-medium text-xs flex items-center gap-1">
              <span>Removed:</span>
              <span id="stat-lines-saved">0</span>
              <span>Lines</span>
              <span id="stat-reduction-pct">(0% Saved)</span>
            </div>
          </div>
        </div>

      </div>

    </div>
  </section>

  <!-- 3. Intent Card -->
  <section class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8 pb-12">
    <div class="bg-white dark:bg-slate-900/60 border border-slate-200 dark:border-slate-800 rounded-xl p-5 md:p-6 text-slate-700 dark:text-slate-300 text-sm md:text-base leading-relaxed shadow-sm">
      <p>
        Remove empty lines, collapse consecutive blank rows, and strip invisible whitespace characters in seconds. FastToolVerse processes your documents, code files, and data tables entirely in-browser RAM with 100% local privacy and zero server transmission.
      </p>
    </div>
  </section>

  <!-- 4. 3-Step Practical Guide Section -->
  <section class="border-t border-slate-200/90 dark:border-slate-800 bg-slate-50/50 dark:bg-slate-900/40 py-16 sm:py-20">
    <div class="max-w-5xl mx-auto px-4 sm:px-6 lg:px-8">
      
      <div class="text-center max-w-2xl mx-auto mb-12">
        <h2 class="text-2xl sm:text-3xl font-bold tracking-tight text-slate-900 dark:text-white">
          How to Remove Empty Lines Online in 3 Simple Steps
        </h2>
        <p class="mt-2 text-sm sm:text-base text-slate-600 dark:text-slate-400">
          Clean messy gaps, strip hidden whitespace breaks, and format text in seconds.
        </p>
      </div>

      <div class="grid grid-cols-1 md:grid-cols-3 gap-6 sm:gap-8">
        
        <!-- Step 1 -->
        <div class="p-6 rounded-2xl border border-slate-300 dark:border-slate-800 bg-white dark:bg-slate-900 shadow-sm hover:shadow-md hover:border-emerald-500 transition-all duration-150 relative">
          <div class="w-10 h-10 rounded-xl bg-emerald-50 dark:bg-emerald-950/40 text-emerald-600 dark:text-emerald-400 flex items-center justify-center font-bold font-mono text-sm mb-4 border border-emerald-100 dark:border-emerald-900/50">
            01
          </div>
          <h3 class="text-base font-semibold text-slate-900 dark:text-white mb-2">
            Paste or Enter Text
          </h3>
          <p class="text-sm text-slate-600 dark:text-slate-400 leading-relaxed">
            Copy text from a PDF, document, script, or Markdown file and paste it directly into the input box using <kbd class="px-1.5 py-0.5 text-xs font-mono bg-slate-100 dark:bg-slate-800 rounded border border-slate-200 dark:border-slate-700">Ctrl+V</kbd> or the Paste button.
          </p>
        </div>

        <!-- Step 2 -->
        <div class="p-6 rounded-2xl border border-slate-300 dark:border-slate-800 bg-white dark:bg-slate-900 shadow-sm hover:shadow-md hover:border-emerald-500 transition-all duration-150 relative">
          <div class="w-10 h-10 rounded-xl bg-emerald-50 dark:bg-emerald-950/40 text-emerald-600 dark:text-emerald-400 flex items-center justify-center font-bold font-mono text-sm mb-4 border border-emerald-100 dark:border-emerald-900/50">
            02
          </div>
          <h3 class="text-base font-semibold text-slate-900 dark:text-white mb-2">
            Configure Line Rules
          </h3>
          <p class="text-sm text-slate-600 dark:text-slate-400 leading-relaxed">
            Choose whether to delete all blank lines completely or collapse consecutive breaks into single lines. Enable whitespace detection to purge invisible space characters.
          </p>
        </div>

        <!-- Step 3 -->
        <div class="p-6 rounded-2xl border border-slate-300 dark:border-slate-800 bg-white dark:bg-slate-900 shadow-sm hover:shadow-md hover:border-emerald-500 transition-all duration-150 relative">
          <div class="w-10 h-10 rounded-xl bg-emerald-50 dark:bg-emerald-950/40 text-emerald-600 dark:text-emerald-400 flex items-center justify-center font-bold font-mono text-sm mb-4 border border-emerald-100 dark:border-emerald-900/50">
            03
          </div>
          <h3 class="text-base font-semibold text-slate-900 dark:text-white mb-2">
            Copy or Download
          </h3>
          <p class="text-sm text-slate-600 dark:text-slate-400 leading-relaxed">
            Review the stripped lines counter and live metrics, then click <strong>Copy Result</strong> to copy to your clipboard or download as a clean <strong>.txt</strong> file.
          </p>
        </div>

      </div>

    </div>
  </section>

  <!-- 5. "Why Choose FastToolVerse": 6 Core Benefit Cards -->
  <section class="border-t border-slate-200/90 dark:border-slate-800 bg-white dark:bg-slate-950 py-16 sm:py-20">
    <div class="max-w-6xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="text-center max-w-2xl mx-auto mb-12">
        <h2 class="text-2xl sm:text-3xl font-bold tracking-tight text-slate-900 dark:text-white">
          Why Choose FastToolVerse
        </h2>
        <p class="mt-2 text-sm sm:text-base text-slate-600 dark:text-slate-400">
          Built for developer precision, complete data privacy, and instantaneous text processing.
        </p>
      </div>

      <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-5">
        <!-- Benefit 1 -->
