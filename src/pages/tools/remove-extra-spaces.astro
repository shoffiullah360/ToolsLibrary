---
import Layout from '../../layouts/Layout.astro';
import ToolIcon from '../../components/ToolIcon.astro';

// FAQ Data for Schema and Accordion
const faqs = [
  {
    question: "How do I remove multiple spaces between words online?",
    answer: "Simply paste or type your text into the input box, make sure the 'Remove multiple consecutive spaces' checkbox is enabled (it is on by default), and your text will be cleaned in real-time. FastToolVerse replaces repeated spaces with a single clean space across every paragraph."
  },
  {
    question: "Does this extra space remover upload my text to your server?",
    answer: "No. FastToolVerse processes 100% of your text locally in your web browser using client-side JavaScript. Your text, code snippets, confidential documents, and essays never leave your device and are never transmitted over the network."
  },
  {
    question: "How do I remove trailing spaces and leading indentation from each line?",
    answer: "Check the 'Trim leading & trailing spaces per line' option. The tool will parse each line individually and strip unwanted spaces from the beginning and end while preserving paragraph formatting."
  },
  {
    question: "Can this tool convert tabs into spaces?",
    answer: "Yes. Enable the 'Convert tabs to spaces' option to replace tab characters (\t) with 4 standard spaces. This ensures your text and code blocks display consistently across all editors, browsers, and terminal environments."
  },
  {
    question: "How do I fix extra spaces in text copied from a PDF?",
    answer: "Text copied from PDFs frequently contains unwanted double spaces, broken line wraps, and trailing tabs due to layout formatting. Paste your text directly into FastToolVerse, enable 'Remove multiple consecutive spaces' and 'Trim leading & trailing spaces', and optionally enable 'Remove empty/blank lines' to produce smooth, clean paragraphs."
  },
  {
    question: "Is there a character or document length limit?",
    answer: "Because FastToolVerse runs directly on your computer's local CPU without server upload quotas, you can clean articles, essays, code files, and CSV datasets with tens of thousands of words with zero lag."
  },
  {
    question: "Can I download the cleaned text as a .txt file?",
    answer: "Yes. Click the 'Download .txt' button above the output box to export your cleaned text directly as a plain text file without needing to manually copy and paste."
  },
  {
    question: "Does this tool work on mobile devices and tablets?",
    answer: "Yes. FastToolVerse is fully responsive and optimized for touchscreens on iOS (iPhone/iPad) and Android. You can easily paste text, adjust cleaning rules, and copy the results directly on your mobile device."
  }
];

// Schema.org SoftwareApplication
const jsonLdSoftwareApp = {
  "@context": "https://schema.org",
  "@type": "SoftwareApplication",
  "name": "Free Online Extra Space Remover & Text Cleaner",
  "applicationCategory": "UtilitiesApplication",
  "operatingSystem": "All (Web Browser)",
  "browserRequirements": "Requires JavaScript. Runs 100% client-side.",
  "offers": {
    "@type": "Offer",
    "price": "0",
    "priceCurrency": "USD"
  },
  "featureList": [
    "100% In-browser text cleaning privacy",
    "Collapse multiple consecutive spaces into single space",
    "Trim leading and trailing whitespace per line",
    "Convert tab characters to spaces",
    "Strip blank and empty lines",
    "Live word, character, and space reduction counters",
    "1-click copy to clipboard and .txt file export"
  ]
};

// Schema.org FAQPage
const jsonLdFaq = {
  "@context": "https://schema.org",
  "@type": "FAQPage",
  "mainEntity": faqs.map((f) => ({
    "@type": "Question",
    "name": f.question,
    "acceptedAnswer": {
      "@type": "Answer",
      "text": f.answer
    }
  }))
};

// Schema.org BreadcrumbList
const jsonLdBreadcrumb = {
  "@context": "https://schema.org",
  "@type": "BreadcrumbList",
  "itemListElement": [
    {
      "@type": "ListItem",
      "position": 1,
      "name": "Home",
      "item": "https://fasttoolverse.com/"
    },
    {
      "@type": "ListItem",
      "position": 2,
      "name": "Text & Formatting",
      "item": "https://fasttoolverse.com/#text-tools-section"
    },
    {
      "@type": "ListItem",
      "position": 3,
      "name": "Remove Extra Spaces",
      "item": "https://fasttoolverse.com/tools/remove-extra-spaces"
    }
  ]
};

const canonicalUrl = "https://fasttoolverse.com/tools/remove-extra-spaces";
const pageTitle = "Remove Extra Spaces Online - Free Text Cleaner & Whitespace Normalizer | FastToolVerse";
const pageDescription = "Clean extra spaces, trailing spaces, tabs, and duplicate whitespace online. 100% free, private in-browser text cleaner with instant character and word counters.";
const pageKeywords = "remove extra spaces, extra space remover, remove duplicate spaces, clean whitespace online, trim trailing spaces, delete multiple spaces, remove leading spaces, text cleaner, format text whitespace, client side text tool";
const ogImage = "https://fasttoolverse.com/og-image.png";

// Programmatic target cards / presets
const presets = [
  {
    id: "preset-single-space",
    title: "Single Space Normalizer",
    tag: "Consecutive Spaces",
    desc: "Replaces any sequence of multiple spaces between words with a clean single space.",
    options: { multipleSpaces: true, trimLines: true, tabsToSpaces: false, emptyLines: false },
    sampleText: "This   sentence    has       too   many    spaces   between words."
  },
  {
    id: "preset-trim-edges",
    title: "Trim Leading & Trailing Spaces",
    tag: "Edge Whitespace",
    desc: "Strips accidental padding from the beginning and end of every line in your text.",
    options: { multipleSpaces: false, trimLines: true, tabsToSpaces: false, emptyLines: false },
    sampleText: "   First line with leading space.   \n      Second line with indented space.   \nThird line with trailing space.      "
  },
  {
    id: "preset-clean-code",
    title: "Clean Multiple Spaces in Code",
    tag: "Code & Scripts",
    desc: "Converts tabs to 4 spaces, trims trailing line spaces, and collapses extra whitespace.",
    options: { multipleSpaces: true, trimLines: true, tabsToSpaces: true, emptyLines: false },
    sampleText: "function   calculateTotal( items )   {\n\tconst   tax   =   0.08;\n\treturn   items.reduce((a, b) => a + b)   *   (1 + tax);\n}   "
  },
  {
    id: "preset-remove-all-blank",
    title: "Strip Empty & Blank Lines",
    tag: "Compact Text",
    desc: "Removes completely empty lines and lines with only spaces to create compact text.",
    options: { multipleSpaces: true, trimLines: true, tabsToSpaces: true, emptyLines: true },
    sampleText: "First paragraph with important content.\n\n   \n\nSecond paragraph following multiple blank lines.\n\n\nThird paragraph."
  },
  {
    id: "preset-tabs-to-spaces",
    title: "Remove Tabs and Indentation",
    tag: "Tabs to Spaces",
    desc: "Replaces all tab characters with standard spaces to avoid rendering mismatches.",
    options: { multipleSpaces: false, trimLines: true, tabsToSpaces: true, emptyLines: false },
    sampleText: "\tItem 1:\tDescription for item one\n\tItem 2:\tDescription for item two\n\t\tSub-item 2.1:\tDetail notes"
  },
  {
    id: "preset-essay-cleaner",
    title: "Space Cleaner for Essays & Articles",
    tag: "Articles & PDFs",
    desc: "All-in-one cleanup for text copied from PDFs, Word docs, and web pages.",
    options: { multipleSpaces: true, trimLines: true, tabsToSpaces: true, emptyLines: false },
    sampleText: "In   scholarly   manuscripts  and   journal   drafts,\n   improper   whitespace   frequently   occurs    during   copy-pasting.\n\tThis   preset   restores    standardized   typography."
  }
];
---

<Layout
  title={pageTitle}
  description={pageDescription}
  canonicalUrl={canonicalUrl}
  image={ogImage}
>
  <!-- Injected Head Elements: Twitter & JSON-LD Schemas -->
  <Fragment slot="head">
    <meta name="keywords" content={pageKeywords} />

    <!-- Open Graph tags -->
    <meta property="og:type" content="website" />
    <meta property="og:url" content={canonicalUrl} />
    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={pageDescription} />
    <meta property="og:image" content={ogImage} />

    <!-- Twitter Card -->
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:url" content={canonicalUrl} />
    <meta name="twitter:title" content={pageTitle} />
    <meta name="twitter:description" content={pageDescription} />
    <meta name="twitter:image" content={ogImage} />

    <!-- Structured Data Schemas -->
    <script type="application/ld+json" set:html={JSON.stringify(jsonLdSoftwareApp)} />
    <script type="application/ld+json" set:html={JSON.stringify(jsonLdFaq)} />
    <script type="application/ld+json" set:html={JSON.stringify(jsonLdBreadcrumb)} />
  </Fragment>

  <!-- Hero Header Section -->
  <section class="relative pt-10 pb-6 sm:pt-14 sm:pb-8 overflow-hidden">
    <div class="hero-mesh-bg" aria-hidden="true"></div>

    <div class="relative max-w-5xl mx-auto px-4 sm:px-6 lg:px-8 text-center">
      <!-- Breadcrumbs -->
      <nav aria-label="Breadcrumb" class="mb-5 flex justify-center">
        <ol class="inline-flex items-center space-x-1.5 md:space-x-2 text-xs font-medium text-slate-500 dark:text-slate-400">
          <li class="inline-flex items-center">
            <a href="/" class="hover:text-blue-600 dark:hover:text-blue-400 transition-colors">Home</a>
          </li>
          <li>
            <div class="flex items-center">
              <svg class="w-3 h-3 text-slate-400 mx-1" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7" />
              </svg>
              <a href="/#text-tools-section" class="hover:text-purple-600 dark:hover:text-purple-400 transition-colors">Text & Formatting</a>
            </div>
          </li>
          <li aria-current="page">
            <div class="flex items-center">
              <svg class="w-3 h-3 text-slate-400 mx-1" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7" />
              </svg>
              <span class="text-slate-900 dark:text-white font-semibold">Remove Extra Spaces</span>
            </div>
          </li>
        </ol>
      </nav>

      <!-- Privacy Status Badge -->
      <div class="inline-flex items-center gap-1.5 px-3.5 py-1 rounded-full text-xs font-semibold bg-purple-50 dark:bg-purple-950/50 text-purple-600 dark:text-purple-400 border border-purple-200 dark:border-purple-900/50 mb-3 shadow-2xs">
        <ToolIcon name="shield-check" class="w-3.5 h-3.5" />
        <span>100% In-Browser Privacy • Zero Server Uploads</span>
      </div>

      <!-- Hero Title -->
      <h1 class="text-3xl sm:text-4xl md:text-5xl font-bold tracking-tight text-slate-900 dark:text-white leading-tight">
        Free Online Extra Space Remover & Text Cleaner
      </h1>

      <!-- Subtitle -->
      <p class="mt-3 sm:mt-4 text-base sm:text-lg text-slate-600 dark:text-slate-400 max-w-2xl mx-auto leading-relaxed">
        Remove duplicate spaces, trailing whitespaces, unnecessary tabs, and clean paragraphs instantly with zero server uploads.
      </p>
    </div>
  </section>

  <!-- Interactive Studio Container -->
  <section class="max-w-6xl mx-auto px-4 sm:px-6 lg:px-8 pb-16 sm:pb-24">
    <div class="rounded-2xl border border-slate-200 dark:border-slate-800 bg-white dark:bg-slate-900 shadow-xl overflow-hidden transition-colors">
      
      <!-- Top Options & Controls Bar -->
      <div class="p-5 sm:p-6 border-b border-slate-200 dark:border-slate-800 bg-slate-50/70 dark:bg-slate-900/70">
        <div class="flex flex-col lg:flex-row lg:items-center justify-between gap-4">
          
          <!-- Cleaning Rules (Checkboxes) -->
          <div class="flex flex-wrap items-center gap-x-6 gap-y-3">
            <label class="inline-flex items-center gap-2 cursor-pointer text-xs sm:text-sm font-medium text-slate-700 dark:text-slate-300 hover:text-slate-900 dark:hover:text-white transition-colors">
              <input
                type="checkbox"
                id="opt-multiple-spaces"
                checked
                class="w-4 h-4 rounded border-slate-300 dark:border-slate-700 text-purple-600 focus:ring-purple-500 dark:bg-slate-800 cursor-pointer"
              />
              <span>Collapse consecutive spaces into single space</span>
            </label>

            <label class="inline-flex items-center gap-2 cursor-pointer text-xs sm:text-sm font-medium text-slate-700 dark:text-slate-300 hover:text-slate-900 dark:hover:text-white transition-colors">
              <input
                type="checkbox"
                id="opt-trim-lines"
                checked
                class="w-4 h-4 rounded border-slate-300 dark:border-slate-700 text-purple-600 focus:ring-purple-500 dark:bg-slate-800 cursor-pointer"
              />
              <span>Trim leading & trailing spaces per line</span>
            </label>

            <label class="inline-flex items-center gap-2 cursor-pointer text-xs sm:text-sm font-medium text-slate-700 dark:text-slate-300 hover:text-slate-900 dark:hover:text-white transition-colors">
              <input
                type="checkbox"
                id="opt-tabs-to-spaces"
                checked
                class="w-4 h-4 rounded border-slate-300 dark:border-slate-700 text-purple-600 focus:ring-purple-500 dark:bg-slate-800 cursor-pointer"
              />
              <span>Convert tabs to spaces (4 spaces)</span>
            </label>

            <label class="inline-flex items-center gap-2 cursor-pointer text-xs sm:text-sm font-medium text-slate-700 dark:text-slate-300 hover:text-slate-900 dark:hover:text-white transition-colors">
              <input
                type="checkbox"
                id="opt-empty-lines"
                class="w-4 h-4 rounded border-slate-300 dark:border-slate-700 text-purple-600 focus:ring-purple-500 dark:bg-slate-800 cursor-pointer"
              />
              <span>Remove empty/blank lines</span>
            </label>
          </div>

          <!-- Action Buttons -->
          <div class="flex items-center gap-2.5 shrink-0">
            <button
              type="button"
              id="btn-sample"
              class="px-3.5 py-1.5 text-xs font-semibold rounded-lg border border-slate-200 dark:border-slate-700 text-slate-700 dark:text-slate-300 hover:bg-slate-100 dark:hover:bg-slate-800 transition-colors cursor-pointer shadow-2xs"
            >
              Load Sample
            </button>
            <button
              type="button"
              id="btn-clean"
              class="px-5 py-2 text-xs sm:text-sm font-semibold rounded-lg bg-purple-600 hover:bg-purple-700 text-white shadow-sm transition-all flex items-center gap-2 cursor-pointer"
            >
              <ToolIcon name="space" class="w-4 h-4" />
              <span>Clean Text</span>
            </button>
          </div>

        </div>
      </div>

      <!-- Dual Textarea Layout -->
      <div class="grid grid-cols-1 lg:grid-cols-2 divide-y lg:divide-y-0 lg:divide-x divide-slate-200 dark:divide-slate-800">
        
        <!-- Left: Input Area -->
        <div class="p-5 sm:p-6 flex flex-col space-y-3 bg-white dark:bg-slate-900">
          <div class="flex items-center justify-between">
            <div class="flex items-center gap-2">
              <span class="text-xs font-mono uppercase tracking-wider font-semibold text-slate-500 dark:text-slate-400">
                Input Text
              </span>
              <span id="badge-input-ready" class="text-[11px] font-medium px-2 py-0.5 rounded-full bg-slate-100 dark:bg-slate-800 text-slate-600 dark:text-slate-400">
                Live Typing
              </span>
            </div>
            
            <div class="flex items-center gap-2">
              <button
                type="button"
                id="btn-paste"
                class="px-2.5 py-1 text-xs font-medium rounded-md border border-slate-200 dark:border-slate-700/80 hover:bg-slate-100 dark:hover:bg-slate-800 text-slate-700 dark:text-slate-300 transition-colors flex items-center gap-1.5 cursor-pointer"
                title="Paste from clipboard"
              >
                <svg class="w-3.5 h-3.5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                  <path stroke-linecap="round" stroke-linejoin="round" d="M9 5H7a2 2 0 00-2 2v12a2 2 0 002 2h10a2 2 0 002-2V7a2 2 0 00-2-2h-2M9 5a2 2 0 002 2h2a2 2 0 002-2M9 5a2 2 0 012-2h2a2 2 0 012 2" />
                </svg>
                <span>Paste</span>
              </button>
              <button
                type="button"
                id="btn-clear"
                class="px-2.5 py-1 text-xs font-medium rounded-md border border-slate-200 dark:border-slate-700/80 hover:bg-rose-50 dark:hover:bg-rose-950/40 text-slate-600 hover:text-rose-600 dark:text-slate-400 dark:hover:text-rose-400 transition-colors cursor-pointer"
                title="Clear input text"
              >
                Clear
              </button>
            </div>
          </div>

          <textarea
            id="input-text"
            rows="14"
            placeholder="Paste or type your text here... It will automatically remove repeated spaces, leading/trailing whitespace, and tabs."
            class="w-full p-4 rounded-xl border border-slate-200 dark:border-slate-800 bg-slate-50/50 dark:bg-slate-950/60 text-slate-900 dark:text-slate-100 font-mono text-sm leading-relaxed placeholder:text-slate-400 dark:placeholder:text-slate-600 focus:outline-none focus:ring-2 focus:ring-purple-500/30 focus:border-purple-500 transition resize-y min-h-[320px]"
            spellcheck="false"
          ></textarea>

          <!-- Input Live Counters -->
          <div class="flex items-center justify-between text-xs text-slate-500 dark:text-slate-400 pt-1 font-mono">
            <div class="flex items-center gap-3">
              <span>Chars: <strong id="stat-input-chars" class="text-slate-800 dark:text-slate-200">0</strong></span>
              <span>Words: <strong id="stat-input-words" class="text-slate-800 dark:text-slate-200">0</strong></span>
              <span>Lines: <strong id="stat-input-lines" class="text-slate-800 dark:text-slate-200">0</strong></span>
            </div>
            <div class="text-[11px] text-slate-400 dark:text-slate-500">
              Input buffer
            </div>
          </div>
        </div>

        <!-- Right: Output Area -->
        <div class="p-5 sm:p-6 flex flex-col space-y-3 bg-white dark:bg-slate-900">
          <div class="flex items-center justify-between">
            <div class="flex items-center gap-2">
              <span class="text-xs font-mono uppercase tracking-wider font-semibold text-purple-600 dark:text-purple-400">
                Cleaned Result
              </span>
              <span
                id="status-spaces-removed"
                class="text-[11px] font-medium px-2 py-0.5 rounded-full bg-emerald-50 dark:bg-emerald-950/50 text-emerald-700 dark:text-emerald-400 border border-emerald-200 dark:border-emerald-900/40"
              >
                0 extra spaces removed
              </span>
            </div>

            <div class="flex items-center gap-2">
              <button
                type="button"
                id="btn-copy"
                class="px-3 py-1 text-xs font-semibold rounded-md bg-purple-600 hover:bg-purple-700 text-white transition-colors flex items-center gap-1.5 cursor-pointer shadow-xs"
                title="Copy cleaned text to clipboard"
              >
                <svg id="copy-icon-idle" class="w-3.5 h-3.5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                  <rect x="9" y="9" width="13" height="13" rx="2" ry="2"></rect>
                  <path d="M5 15H4a2 2 0 01-2-2V4a2 2 0 012-2h9a2 2 0 012 2v1"></path>
                </svg>
                <svg id="copy-icon-success" class="w-3.5 h-3.5 hidden text-emerald-300" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                  <polyline points="20 6 9 17 4 12"></polyline>
                </svg>
                <span id="copy-btn-text">Copy Result</span>
              </button>

              <button
                type="button"
                id="btn-download"
                class="px-2.5 py-1 text-xs font-medium rounded-md border border-slate-200 dark:border-slate-700/80 hover:bg-slate-100 dark:hover:bg-slate-800 text-slate-700 dark:text-slate-300 transition-colors flex items-center gap-1.5 cursor-pointer"
                title="Download cleaned text file"
              >
                <svg class="w-3.5 h-3.5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                  <path stroke-linecap="round" stroke-linejoin="round" d="M4 16v1a3 3 0 003 3h10a3 3 0 003-3v-1m-4-4l-4 4m0 0l-4-4m4 4V4" />
                </svg>
                <span>.txt</span>
              </button>
            </div>
          </div>

          <textarea
            id="output-text"
            rows="14"
            placeholder="Your normalized, clean text will appear here instantly..."
            class="w-full p-4 rounded-xl border border-slate-200 dark:border-slate-800 bg-slate-50/50 dark:bg-slate-950/60 text-slate-900 dark:text-slate-100 font-mono text-sm leading-relaxed placeholder:text-slate-400 dark:placeholder:text-slate-600 focus:outline-none focus:ring-2 focus:ring-purple-500/30 focus:border-purple-500 transition resize-y min-h-[320px]"
            spellcheck="false"
          ></textarea>

          <!-- Output Live Counters -->
          <div class="flex items-center justify-between text-xs text-slate-500 dark:text-slate-400 pt-1 font-mono">
            <div class="flex items-center gap-3">
              <span>Chars: <strong id="stat-output-chars" class="text-slate-800 dark:text-slate-200">0</strong></span>
              <span>Words: <strong id="stat-output-words" class="text-slate-800 dark:text-slate-200">0</strong></span>
              <span>Saved: <strong id="stat-saved-bytes" class="text-emerald-600 dark:text-emerald-400">0 B</strong></span>
            </div>
            <div id="stat-reduction-pct" class="text-[11px] font-semibold text-emerald-600 dark:text-emerald-400">
              0% reduction
            </div>
          </div>
        </div>

      </div>

    </div>
  </section>

  <!-- 3-Step Guide Section -->
  <section class="border-t border-slate-200 dark:border-slate-800 bg-slate-50/50 dark:bg-slate-900/40 py-16 sm:py-20">
    <div class="max-w-5xl mx-auto px-4 sm:px-6 lg:px-8">
      
      <div class="text-center max-w-2xl mx-auto mb-12">
        <h2 class="text-2xl sm:text-3xl font-bold tracking-tight text-slate-900 dark:text-white">
          How to Remove Extra Spaces Online in 3 Simple Steps
        </h2>
        <p class="mt-2 text-sm sm:text-base text-slate-600 dark:text-slate-400">
          Clean unwanted whitespace, normalize tabs, and fix messy paragraphs in seconds.
        </p>
      </div>

      <div class="grid grid-cols-1 md:grid-cols-3 gap-6 sm:gap-8">
        
        <!-- Step 1 -->
        <div class="p-6 rounded-2xl border border-slate-200 dark:border-slate-800 bg-white dark:bg-slate-900 shadow-xs relative">
          <div class="w-10 h-10 rounded-xl bg-purple-50 dark:bg-purple-950/40 text-purple-600 dark:text-purple-400 flex items-center justify-center font-bold font-mono text-sm mb-4 border border-purple-100 dark:border-purple-900/50">
            01
          </div>
          <h3 class="text-base font-semibold text-slate-900 dark:text-white mb-2">
            Paste or Enter Text
          </h3>
          <p class="text-sm text-slate-600 dark:text-slate-400 leading-relaxed">
            Copy text from a PDF, document, website, or code editor and paste it directly into the input box using <kbd class="px-1.5 py-0.5 text-xs font-mono bg-slate-100 dark:bg-slate-800 rounded border border-slate-200 dark:border-slate-700">Ctrl+V</kbd> or the Paste button.
          </p>
        </div>

        <!-- Step 2 -->
        <div class="p-6 rounded-2xl border border-slate-200 dark:border-slate-800 bg-white dark:bg-slate-900 shadow-xs relative">
          <div class="w-10 h-10 rounded-xl bg-purple-50 dark:bg-purple-950/40 text-purple-600 dark:text-purple-400 flex items-center justify-center font-bold font-mono text-sm mb-4 border border-purple-100 dark:border-purple-900/50">
            02
          </div>
          <h3 class="text-base font-semibold text-slate-900 dark:text-white mb-2">
            Select Cleaning Options
          </h3>
          <p class="text-sm text-slate-600 dark:text-slate-400 leading-relaxed">
            Toggle your preferences: collapse multiple spaces into one, trim line edges, convert tabs to spaces, or strip empty blank lines. The tool automatically updates in real-time.
          </p>
        </div>

        <!-- Step 3 -->
        <div class="p-6 rounded-2xl border border-slate-200 dark:border-slate-800 bg-white dark:bg-slate-900 shadow-xs relative">
