        </a>
        <a
          href="/tools/text-to-slug-converter"
          class="inline-flex items-center gap-2 px-4 py-2 rounded-xl border border-slate-200 dark:border-slate-800 bg-white dark:bg-slate-900 text-xs font-medium text-slate-700 dark:text-slate-300 hover:border-purple-500 transition shadow-2xs"
        >
          <ToolIcon name="link-2" class="w-4 h-4 text-purple-500" />
          <span>Text to Slug Converter</span>
        </a>
      </div>
    </div>
  </section>

</Layout>

<!-- Client-Side JavaScript Logic -->
<script is:inline>
  (function () {
    const inputText = document.getElementById('input-text');
    const outputText = document.getElementById('output-text');
    const optMultipleSpaces = document.getElementById('opt-multiple-spaces');
    const optTrimLines = document.getElementById('opt-trim-lines');
    const optTabsToSpaces = document.getElementById('opt-tabs-to-spaces');
    const optEmptyLines = document.getElementById('opt-empty-lines');
    const btnClean = document.getElementById('btn-clean');
    const btnSample = document.getElementById('btn-sample');
    const btnPaste = document.getElementById('btn-paste');
    const btnClear = document.getElementById('btn-clear');
    const btnCopy = document.getElementById('btn-copy');
    const btnDownload = document.getElementById('btn-download');

    const copyBtnText = document.getElementById('copy-btn-text');
    const copyIconIdle = document.getElementById('copy-icon-idle');
    const copyIconSuccess = document.getElementById('copy-icon-success');

    const statInputChars = document.getElementById('stat-input-chars');
    const statInputWords = document.getElementById('stat-input-words');
    const statInputLines = document.getElementById('stat-input-lines');

    const statOutputChars = document.getElementById('stat-output-chars');
    const statOutputWords = document.getElementById('stat-output-words');
    const statSavedBytes = document.getElementById('stat-saved-bytes');
    const statReductionPct = document.getElementById('stat-reduction-pct');
    const statusSpacesRemoved = document.getElementById('status-spaces-removed');

    const presetButtons = document.querySelectorAll('.preset-card-btn');

    // Preset Data map
    const presetMap = {
      'preset-single-space': {
        options: { multipleSpaces: true, trimLines: true, tabsToSpaces: false, emptyLines: false },
        sample: 'This   sentence    has       too   many    spaces   between words.\nHere    is   another     line   with      scattered    spaces.'
      },
      'preset-trim-edges': {
        options: { multipleSpaces: false, trimLines: true, tabsToSpaces: false, emptyLines: false },
        sample: '   First line with leading space.   \n      Second line with indented space.   \nThird line with trailing space.      '
      },
      'preset-clean-code': {
        options: { multipleSpaces: true, trimLines: true, tabsToSpaces: true, emptyLines: false },
        sample: 'function   calculateTotal( items )   {\n\tconst   tax   =   0.08;\n\treturn   items.reduce((a, b) => a + b)   *   (1 + tax);\n}   '
      },
      'preset-remove-all-blank': {
        options: { multipleSpaces: true, trimLines: true, tabsToSpaces: true, emptyLines: true },
        sample: 'First paragraph with important content.\n\n   \n\nSecond paragraph following multiple blank lines.\n\n\nThird paragraph.'
      },
      'preset-tabs-to-spaces': {
        options: { multipleSpaces: false, trimLines: true, tabsToSpaces: true, emptyLines: false },
        sample: '\tItem 1:\tDescription for item one\n\tItem 2:\tDescription for item two\n\t\tSub-item 2.1:\tDetail notes'
      },
      'preset-essay-cleaner': {
        options: { multipleSpaces: true, trimLines: true, tabsToSpaces: true, emptyLines: false },
        sample: 'In   scholarly   manuscripts  and   journal   drafts,\n   improper   whitespace   frequently   occurs    during   copy-pasting.\n\tThis   preset   restores    standardized   typography.'
      }
    };

    function countWords(str) {
      if (!str || !str.trim()) return 0;
      return str.trim().split(/\s+/).length;
    }

    function countLines(str) {
      if (!str) return 0;
      return str.split('\n').length;
    }

    function cleanString(text) {
      if (!text) return '';
      let result = text;

      // 1. Convert tabs to 4 spaces
      if (optTabsToSpaces && optTabsToSpaces.checked) {
        result = result.replace(/\t/g, '    ');
      }

      // 2. Collapse multiple consecutive horizontal spaces to a single space
      if (optMultipleSpaces && optMultipleSpaces.checked) {
        result = result.replace(/[^\S\r\n]+/g, ' ');
      }

      // 3. Trim leading & trailing spaces per line
      if (optTrimLines && optTrimLines.checked) {
        result = result
          .split('\n')
          .map(function (line) {
            return line.trim();
          })
          .join('\n');
      }

      // 4. Remove empty/blank lines
      if (optEmptyLines && optEmptyLines.checked) {
        result = result
          .split('\n')
          .filter(function (line) {
            return line.trim().length > 0;
          })
          .join('\n');
      }

      return result;
    }

    function update() {
      const raw = inputText.value || '';
      const cleaned = cleanString(raw);
      outputText.value = cleaned;

      // Input Stats
      const inChars = raw.length;
      const inWords = countWords(raw);
      const inLines = countLines(raw);

      statInputChars.textContent = inChars.toLocaleString();
      statInputWords.textContent = inWords.toLocaleString();
      statInputLines.textContent = inLines.toLocaleString();

      // Output Stats
      const outChars = cleaned.length;
      const outWords = countWords(cleaned);

      statOutputChars.textContent = outChars.toLocaleString();
      statOutputWords.textContent = outWords.toLocaleString();

      // Calculation of saved bytes and space reduction
      const charDiff = inChars - outChars;
      const savedBytes = Math.max(0, charDiff);
      statSavedBytes.textContent = savedBytes > 1024 ? (savedBytes / 1024).toFixed(1) + ' KB' : savedBytes + ' B';

      const pct = inChars > 0 ? Math.max(0, Math.round((savedBytes / inChars) * 100)) : 0;
      statReductionPct.textContent = pct + '% reduction';

      // Spaces count estimate
      const rawSpaces = (raw.match(/[ \t]/g) || []).length;
      const cleanedSpaces = (cleaned.match(/[ \t]/g) || []).length;
      const spacesRemoved = Math.max(0, rawSpaces - cleanedSpaces);

      statusSpacesRemoved.textContent = spacesRemoved.toLocaleString() + ' extra spaces removed';
    }

    // Debounce helper for silky performance with large text
    let timeoutId;
    function debouncedUpdate() {
      clearTimeout(timeoutId);
      timeoutId = setTimeout(update, 50);
    }

    // Event Listeners
    inputText?.addEventListener('input', debouncedUpdate);
    optMultipleSpaces?.addEventListener('change', update);
    optTrimLines?.addEventListener('change', update);
    optTabsToSpaces?.addEventListener('change', update);
    optEmptyLines?.addEventListener('change', update);
    btnClean?.addEventListener('click', update);

    // Sample Text
    btnSample?.addEventListener('click', function () {
      inputText.value =
        'This   is   a   sample   text    with      unnecessary     spaces.\n\n   \n\tIt    also   contains   tabs   and      leading   spaces.\nTrailing    spaces    at    the    end    of   the   line.      \n\n   \nMultiple   blank   lines   can   be   cleaned   as    well.';
      update();
    });

    // Clear
    btnClear?.addEventListener('click', function () {
      inputText.value = '';
      outputText.value = '';
      update();
      inputText.focus();
    });

    // Paste from Clipboard
    btnPaste?.addEventListener('click', async function () {
      try {
        if (navigator.clipboard && navigator.clipboard.readText) {
          const clipText = await navigator.clipboard.readText();
          if (clipText) {
            inputText.value = clipText;
            update();
          }
        } else {
          inputText.focus();
          inputText.select();
        }
      } catch (err) {
        inputText.focus();
      }
    });

    // Copy to Clipboard
    btnCopy?.addEventListener('click', async function () {
      const textToCopy = outputText.value;
      if (!textToCopy) return;

      try {
        if (navigator.clipboard && navigator.clipboard.writeText) {
          await navigator.clipboard.writeText(textToCopy);
        } else {
          outputText.select();
          document.execCommand('copy');
        }

        copyBtnText.textContent = 'Copied!';
        copyIconIdle.classList.add('hidden');
        copyIconSuccess.classList.remove('hidden');

        setTimeout(function () {
          copyBtnText.textContent = 'Copy Result';
          copyIconIdle.classList.remove('hidden');
          copyIconSuccess.classList.add('hidden');
        }, 2000);
      } catch (err) {
        outputText.select();
      }
    });

    // Download .txt file
    btnDownload?.addEventListener('click', function () {
      const content = outputText.value;
      if (!content) return;

      const blob = new Blob([content], { type: 'text/plain;charset=utf-8' });
      const url = URL.createObjectURL(blob);
      const a = document.createElement('a');
      a.href = url;
      a.download = 'cleaned-text.txt';
      document.body.appendChild(a);
      a.click();
      document.body.removeChild(a);
      URL.revokeObjectURL(url);
    });

    // Preset Buttons
    presetButtons.forEach(function (btn) {
      btn.addEventListener('click', function () {
        const id = btn.getAttribute('data-preset');
        const data = presetMap[id];
        if (!data) return;

        optMultipleSpaces.checked = data.options.multipleSpaces;
        optTrimLines.checked = data.options.trimLines;
        optTabsToSpaces.checked = data.options.tabsToSpaces;
        optEmptyLines.checked = data.options.emptyLines;

        if (data.sample) {
          inputText.value = data.sample;
        }

        update();

        // Scroll to editor
        const studio = document.getElementById('input-text');
        if (studio) {
          studio.scrollIntoView({ behavior: 'smooth', block: 'center' });
        }
      });
    });

    // Initial update on page load
    update();
  })();
</script>
