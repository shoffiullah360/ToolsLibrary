---
import Layout from '../../layouts/Layout.astro';
import ToolIcon from '../../components/ToolIcon.astro';

// FAQ Data for Schema and Accordion
const faqs = [
  {
    question: "How do I remove line breaks from text online?",
    answer: "Simply paste or type your multiline text into the Input Text box. FastToolVerse automatically strips out line breaks in real time and merges lines into a continuous string using your selected replacement mode (space, comma, no space, or a custom delimiter)."
  },
  {
    question: "Can I remove line breaks but keep paragraph breaks intact?",
    answer: "Yes. Enable the 'Preserve paragraph breaks' checkbox. FastToolVerse detects double line returns (blank lines between paragraphs) and keeps paragraphs separated with clean double breaks while unwrapping the jagged line breaks within each individual paragraph."
  },
  {
    question: "How do I convert a vertical list into a comma-separated list?",
    answer: "Select the 'Replace with comma' replacement mode. FastToolVerse will join each line with a comma and space (e.g. 'Item 1, Item 2, Item 3'), making it ideal for CSV inputs, spreadsheet copy-pasting, and SQL IN queries."
  },
  {
    question: "Does this tool upload my text or confidential documents to a server?",
    answer: "No. FastToolVerse operates 100% client-side in your web browser. Your text, proprietary code snippets, student essays, and confidential datasets never leave your device RAM and are never transmitted over the internet."
  },
  {
    question: "How does this tool handle Windows CRLF vs Unix LF line breaks?",
    answer: "FastToolVerse automatically normalizes all line-ending formats, including Windows CRLF (\\r\\n), Unix/Linux LF (\\n), and legacy Mac CR (\\r). Regardless of your source operating system, every line break is detected and handled uniformly."
  },
  {
    question: "Can I use a custom delimiter between lines?",
    answer: "Yes. Select 'Custom delimiter' in the controls bar and type your desired separator—such as a pipe character ( | ), semicolon (; ), forward slash ( / ), or tab. FastToolVerse updates the result instantly."
  },
  {
    question: "How do I fix text copied from a PDF that has unwanted line wraps?",
    answer: "Copy-pasting from PDFs often introduces hard line breaks at the end of every line. Paste your text into FastToolVerse, select 'Replace with space', and enable 'Preserve paragraph breaks' to reconstruct smooth, continuous prose."
  },
  {
    question: "Does this line break remover work offline?",
    answer: "Yes. Once the page is loaded in your browser, all JavaScript logic runs locally. You can disconnect from the internet or work in airplane mode, and FastToolVerse will continue to remove line breaks flawlessly."
  }
];

// Schema.org SoftwareApplication
const jsonLdSoftwareApp = {
  "@context": "https://schema.org",
  "@type": "SoftwareApplication",
  "name": "Free Online Line Break Remover & Paragraph Joiner",
  "applicationCategory": "UtilitiesApplication",
  "operatingSystem": "All (Web Browser)",
  "browserRequirements": "Requires JavaScript. Runs 100% client-side.",
  "offers": {
    "@type": "Offer",
    "price": "0",
    "priceCurrency": "USD"
  },
  "featureList": [
    "100% In-browser text cleaning privacy",
    "Remove line breaks and newlines instantly",
    "Replace breaks with space, comma, or custom delimiters",
    "Merge lines directly without spaces",
    "Preserve double line break paragraph structure",
    "Live character, line, and break removal counters",
    "1-click copy to clipboard and .txt file export"
  ]
};

// Schema.org FAQPage
const jsonLdFaq = {
  "@context": "https://schema.org",
  "@type": "FAQPage",
  "mainEntity": faqs.map((f) => ({
    "@type": "Question",
    "name": f.question,
    "acceptedAnswer": {
      "@type": "Answer",
      "text": f.answer
    }
  }))
};

// Schema.org BreadcrumbList
const jsonLdBreadcrumb = {
  "@context": "https://schema.org",
  "@type": "BreadcrumbList",
  "itemListElement": [
    {
      "@type": "ListItem",
      "position": 1,
      "name": "Home",
      "item": "https://fasttoolverse.com/"
    },
    {
      "@type": "ListItem",
      "position": 2,
      "name": "Text & Formatting",
      "item": "https://fasttoolverse.com/#text-tools-section"
    },
    {
      "@type": "ListItem",
      "position": 3,
      "name": "Remove Line Breaks",
      "item": "https://fasttoolverse.com/tools/remove-line-breaks"
    }
  ]
};

const canonicalUrl = "https://fasttoolverse.com/tools/remove-line-breaks";
const pageTitle = "Remove Line Breaks Online - Free Paragraph Joiner & Newline Remover | FastToolVerse";
const pageDescription = "Remove line breaks, newlines, and carriage returns online. Convert multiline text to single-line strings or join with commas. 100% private in your browser.";
const pageKeywords = "remove line breaks, line break remover, remove newlines, paragraph joiner, merge lines online, join lines with comma, text flattener, remove carriage returns, strip newlines, client side text tool";
const ogImage = "https://fasttoolverse.com/og-image.png";

// Programmatic target cards / presets
const presets = [
  {
    id: "preset-single-line",
    title: "Convert Multi-line to One Line",
    tag: "Single Line String",
    desc: "Join multiline paragraphs into a single continuous sentence separated by clean spaces.",
    options: { mode: "space", custom: "", preserveParagraphs: false },
    sampleText: "Artificial intelligence and agentic workflows\nare transforming software engineering.\nModern developers leverage intelligent automation\nto build performant web applications."
  },
  {
    id: "preset-comma-join",
    title: "Join Lines with Commas",
    tag: "Comma Separated (CSV)",
    desc: "Convert a column list of names, tags, or IDs into a comma-delimited list for spreadsheets or inputs.",
    options: { mode: "comma", custom: "", preserveParagraphs: false },
    sampleText: "San Francisco\nNew York\nLondon\nTokyo\nSingapore\nBerlin\nSydney"
  },
  {
    id: "preset-fix-pdf",
    title: "Fix Broken PDF Copy-Paste Text",
    tag: "PDFs & Scans",
    desc: "Repair jagged sentence fragments and accidental line wraps caused by multi-column PDF layouts.",
    options: { mode: "space", custom: "", preserveParagraphs: false },
    sampleText: "The primary objective of this\nclinical trial was to assess the\nefficacy of the intervention across\nmultiple independent demographic groups."
  },
  {
    id: "preset-preserve-paras",
    title: "Remove Line Breaks Preserve Paragraphs",
    tag: "Paragraph Joiner",
    desc: "Unwrap hard line returns within paragraphs while preserving double-break paragraph gaps.",
    options: { mode: "space", custom: "", preserveParagraphs: true },
    sampleText: "Early computing pioneers designed systems with\nstrict memory limitations and sequential execution.\nThese architectures laid the groundwork for today's machines.\n\nDecades later, distributed systems and parallel\nprocessing emerged to meet exponential demand.\nModern cloud networks now scale across continents."
  },
  {
    id: "preset-sql-in",
    title: "Strip Newlines for SQL IN Clause",
    tag: "Database & SQL",
    desc: "Format pasted database IDs or records with comma delimiters ready to paste into SQL queries.",
    options: { mode: "comma", custom: "", preserveParagraphs: false },
    sampleText: "10024\n10025\n10031\n10089\n10142\n10199"
  },
  {
    id: "preset-json-helper",
    title: "Single Line JSON Stringify Helper",
    tag: "JSON & Code",
    desc: "Flatten multiline descriptions or code snippets into a compact single-line string for JSON payloads.",
    options: { mode: "space", custom: "", preserveParagraphs: false },
    sampleText: "This is a detailed product description\nwritten across multiple lines\nthat must be encoded into a JSON string\nwithout illegal newline characters."
  }
];
---

<Layout
  title={pageTitle}
  description={pageDescription}
  canonicalUrl={canonicalUrl}
  image={ogImage}
>
  <!-- Injected Head Elements: Twitter & JSON-LD Schemas -->
  <Fragment slot="head">
    <meta name="keywords" content={pageKeywords} />

    <!-- Open Graph tags -->
    <meta property="og:type" content="website" />
    <meta property="og:url" content={canonicalUrl} />
    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={pageDescription} />
    <meta property="og:image" content={ogImage} />

    <!-- Twitter Card -->
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:url" content={canonicalUrl} />
    <meta name="twitter:title" content={pageTitle} />
    <meta name="twitter:description" content={pageDescription} />
    <meta name="twitter:image" content={ogImage} />

    <!-- Structured Data Schemas -->
    <script type="application/ld+json" set:html={JSON.stringify(jsonLdSoftwareApp)} />
    <script type="application/ld+json" set:html={JSON.stringify(jsonLdFaq)} />
    <script type="application/ld+json" set:html={JSON.stringify(jsonLdBreadcrumb)} />
  </Fragment>

  <!-- Hero Header Section -->
  <section class="relative pt-10 pb-6 sm:pt-14 sm:pb-8 overflow-hidden">
    <div class="hero-mesh-bg" aria-hidden="true"></div>

    <div class="relative max-w-5xl mx-auto px-4 sm:px-6 lg:px-8 text-center">
      <!-- Breadcrumbs -->
      <nav aria-label="Breadcrumb" class="mb-5 flex justify-center">
        <ol class="inline-flex items-center space-x-1.5 md:space-x-2 text-xs font-medium text-slate-500 dark:text-slate-400">
          <li class="inline-flex items-center">
            <a href="/" class="hover:text-blue-600 dark:hover:text-blue-400 transition-colors">Home</a>
          </li>
          <li>
            <div class="flex items-center">
              <svg class="w-3 h-3 text-slate-400 mx-1" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7" />
              </svg>
              <a href="/#text-tools-section" class="hover:text-purple-600 dark:hover:text-purple-400 transition-colors">Text & Formatting</a>
            </div>
          </li>
          <li aria-current="page">
            <div class="flex items-center">
              <svg class="w-3 h-3 text-slate-400 mx-1" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7" />
              </svg>
              <span class="text-slate-900 dark:text-white font-semibold">Remove Line Breaks</span>
            </div>
          </li>
        </ol>
      </nav>

      <!-- Privacy Status Badge -->
      <div class="inline-flex items-center gap-1.5 px-3.5 py-1 rounded-full text-xs font-semibold bg-purple-50 dark:bg-purple-950/50 text-purple-600 dark:text-purple-400 border border-purple-200 dark:border-purple-900/50 mb-3 shadow-2xs">
        <ToolIcon name="shield-check" class="w-3.5 h-3.5" />
        <span>100% In-Browser Privacy • Zero Server Uploads</span>
      </div>

      <!-- Hero Title -->
      <h1 class="text-3xl sm:text-4xl md:text-5xl font-bold tracking-tight text-slate-900 dark:text-white leading-tight">
        Free Online Line Break Remover & Paragraph Joiner
      </h1>

      <!-- Subtitle -->
      <p class="mt-3 sm:mt-4 text-base sm:text-lg text-slate-600 dark:text-slate-400 max-w-2xl mx-auto leading-relaxed">
        Remove line breaks, newlines, and carriage returns to convert multiline text into clean single-line strings.
      </p>
    </div>
  </section>

  <!-- Interactive Studio Container -->
  <section class="max-w-6xl mx-auto px-4 sm:px-6 lg:px-8 pb-16 sm:pb-24">
    <div class="rounded-2xl border border-slate-200 dark:border-slate-800 bg-white dark:bg-slate-900 shadow-xl overflow-hidden transition-colors">
      
      <!-- Top Options & Controls Bar -->
      <div class="p-5 sm:p-6 border-b border-slate-200 dark:border-slate-800 bg-slate-50/70 dark:bg-slate-900/70">
        <div class="flex flex-col lg:flex-row lg:items-center justify-between gap-4">
          
          <!-- Cleaning Rules (Radio Replacement Modes & Checkboxes) -->
          <div class="flex flex-col sm:flex-row sm:items-center gap-4 flex-wrap">
            
            <!-- Replacement Mode Group -->
            <div class="flex flex-wrap items-center gap-3">
              <span class="text-xs font-semibold text-slate-500 dark:text-slate-400 uppercase tracking-wider">
                Replace With:
              </span>
              
              <label class="inline-flex items-center gap-1.5 cursor-pointer text-xs sm:text-sm font-medium text-slate-700 dark:text-slate-300 hover:text-slate-900 dark:hover:text-white transition-colors">
                <input
                  type="radio"
                  name="replace-mode"
                  value="space"
                  checked
                  class="w-4 h-4 text-purple-600 focus:ring-purple-500 dark:bg-slate-800 border-slate-300 dark:border-slate-700 cursor-pointer"
                />
                <span>Space</span>
              </label>

              <label class="inline-flex items-center gap-1.5 cursor-pointer text-xs sm:text-sm font-medium text-slate-700 dark:text-slate-300 hover:text-slate-900 dark:hover:text-white transition-colors">
                <input
                  type="radio"
                  name="replace-mode"
                  value="comma"
                  class="w-4 h-4 text-purple-600 focus:ring-purple-500 dark:bg-slate-800 border-slate-300 dark:border-slate-700 cursor-pointer"
                />
                <span>Comma</span>
              </label>

              <label class="inline-flex items-center gap-1.5 cursor-pointer text-xs sm:text-sm font-medium text-slate-700 dark:text-slate-300 hover:text-slate-900 dark:hover:text-white transition-colors">
                <input
                  type="radio"
                  name="replace-mode"
                  value="none"
                  class="w-4 h-4 text-purple-600 focus:ring-purple-500 dark:bg-slate-800 border-slate-300 dark:border-slate-700 cursor-pointer"
                />
                <span>No space</span>
              </label>

              <label class="inline-flex items-center gap-1.5 cursor-pointer text-xs sm:text-sm font-medium text-slate-700 dark:text-slate-300 hover:text-slate-900 dark:hover:text-white transition-colors">
                <input
                  type="radio"
                  name="replace-mode"
                  value="custom"
                  id="mode-custom-radio"
                  class="w-4 h-4 text-purple-600 focus:ring-purple-500 dark:bg-slate-800 border-slate-300 dark:border-slate-700 cursor-pointer"
                />
                <span>Custom:</span>
              </label>

              <input
                type="text"
                id="input-custom-delimiter"
                placeholder="e.g. | or ; "
                class="w-24 px-2 py-1 text-xs font-mono rounded-lg border border-slate-300 dark:border-slate-700 bg-white dark:bg-slate-800 text-slate-900 dark:text-white focus:outline-none focus:ring-2 focus:ring-purple-500/30 focus:border-purple-500 transition"
              />
            </div>

            <!-- Paragraph Preservation Checkbox -->
            <div class="sm:border-l sm:border-slate-200 sm:dark:border-slate-800 sm:pl-4">
              <label class="inline-flex items-center gap-2 cursor-pointer text-xs sm:text-sm font-medium text-slate-700 dark:text-slate-300 hover:text-slate-900 dark:hover:text-white transition-colors">
                <input
                  type="checkbox"
                  id="opt-preserve-paragraphs"
                  class="w-4 h-4 rounded border-slate-300 dark:border-slate-700 text-purple-600 focus:ring-purple-500 dark:bg-slate-800 cursor-pointer"
                />
                <span>Preserve paragraph breaks</span>
              </label>
            </div>

          </div>

          <!-- Action Buttons -->
          <div class="flex items-center gap-2.5 shrink-0">
            <button
              type="button"
              id="btn-sample"
              class="px-3.5 py-1.5 text-xs font-semibold rounded-lg border border-slate-200 dark:border-slate-700 text-slate-700 dark:text-slate-300 hover:bg-slate-100 dark:hover:bg-slate-800 transition-colors cursor-pointer shadow-2xs"
            >
              Load Sample
            </button>
            <button
              type="button"
              id="btn-remove-breaks"
              class="px-5 py-2 text-xs sm:text-sm font-semibold rounded-lg bg-purple-600 hover:bg-purple-700 text-white shadow-sm transition-all flex items-center gap-2 cursor-pointer"
            >
              <ToolIcon name="wrap-text" class="w-4 h-4" />
              <span>Remove Line Breaks</span>
            </button>
          </div>

        </div>
      </div>

      <!-- Dual Textarea Layout -->
      <div class="grid grid-cols-1 lg:grid-cols-2 divide-y lg:divide-y-0 lg:divide-x divide-slate-200 dark:divide-slate-800">
        
        <!-- Left: Input Area -->
        <div class="p-5 sm:p-6 flex flex-col space-y-3 bg-white dark:bg-slate-900">
          <div class="flex items-center justify-between">
            <div class="flex items-center gap-2">
              <span class="text-xs font-mono uppercase tracking-wider font-semibold text-slate-500 dark:text-slate-400">
                Input Text
              </span>
              <span id="badge-input-ready" class="text-[11px] font-medium px-2 py-0.5 rounded-full bg-slate-100 dark:bg-slate-800 text-slate-600 dark:text-slate-400">
                Live Typing
              </span>
            </div>
            
            <div class="flex items-center gap-2">
              <button
                type="button"
                id="btn-paste"
                class="px-2.5 py-1 text-xs font-medium rounded-md border border-slate-200 dark:border-slate-700/80 hover:bg-slate-100 dark:hover:bg-slate-800 text-slate-700 dark:text-slate-300 transition-colors flex items-center gap-1.5 cursor-pointer"
                title="Paste from clipboard"
              >
                <svg class="w-3.5 h-3.5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                  <path stroke-linecap="round" stroke-linejoin="round" d="M9 5H7a2 2 0 00-2 2v12a2 2 0 002 2h10a2 2 0 002-2V7a2 2 0 00-2-2h-2M9 5a2 2 0 002 2h2a2 2 0 002-2M9 5a2 2 0 012-2h2a2 2 0 012 2" />
                </svg>
                <span>Paste</span>
              </button>
              <button
                type="button"
                id="btn-clear"
                class="px-2.5 py-1 text-xs font-medium rounded-md border border-slate-200 dark:border-slate-700/80 hover:bg-rose-50 dark:hover:bg-rose-950/40 text-slate-600 hover:text-rose-600 dark:text-slate-400 dark:hover:text-rose-400 transition-colors cursor-pointer"
                title="Clear input text"
              >
                Clear
              </button>
            </div>
          </div>

          <textarea
            id="input-text"
            rows="14"
            placeholder="Paste or type multiline text here... Line breaks and carriage returns will be converted instantly in real time."
            class="w-full p-4 rounded-xl border border-slate-200 dark:border-slate-800 bg-slate-50/50 dark:bg-slate-950/60 text-slate-900 dark:text-slate-100 font-mono text-sm leading-relaxed placeholder:text-slate-400 dark:placeholder:text-slate-600 focus:outline-none focus:ring-2 focus:ring-purple-500/30 focus:border-purple-500 transition resize-y min-h-[320px]"
            spellcheck="false"
          ></textarea>

          <!-- Input Live Counters -->
          <div class="flex items-center justify-between text-xs text-slate-500 dark:text-slate-400 pt-1 font-mono">
            <div class="flex items-center gap-3">
              <span>Lines: <strong id="stat-input-lines" class="text-slate-800 dark:text-slate-200">0</strong></span>
              <span>Chars: <strong id="stat-input-chars" class="text-slate-800 dark:text-slate-200">0</strong></span>
              <span>Words: <strong id="stat-input-words" class="text-slate-800 dark:text-slate-200">0</strong></span>
            </div>
            <div class="text-[11px] text-slate-400 dark:text-slate-500">
              Input buffer
            </div>
          </div>
        </div>

        <!-- Right: Output Area -->
        <div class="p-5 sm:p-6 flex flex-col space-y-3 bg-white dark:bg-slate-900">
          <div class="flex items-center justify-between">
            <div class="flex items-center gap-2">
              <span class="text-xs font-mono uppercase tracking-wider font-semibold text-purple-600 dark:text-purple-400">
                Cleaned Result
              </span>
              <span
                id="status-breaks-removed"
                class="text-[11px] font-medium px-2 py-0.5 rounded-full bg-emerald-50 dark:bg-emerald-950/50 text-emerald-700 dark:text-emerald-400 border border-emerald-200 dark:border-emerald-900/40"
              >
                0 line breaks removed
              </span>
            </div>

            <div class="flex items-center gap-2">
              <button
                type="button"
                id="btn-copy"
                class="px-3 py-1 text-xs font-semibold rounded-md bg-purple-600 hover:bg-purple-700 text-white transition-colors flex items-center gap-1.5 cursor-pointer shadow-xs"
                title="Copy cleaned text to clipboard"
              >
                <svg id="copy-icon-idle" class="w-3.5 h-3.5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                  <rect x="9" y="9" width="13" height="13" rx="2" ry="2"></rect>
                  <path d="M5 15H4a2 2 0 01-2-2V4a2 2 0 012-2h9a2 2 0 012 2v1"></path>
                </svg>
                <svg id="copy-icon-success" class="w-3.5 h-3.5 hidden text-emerald-300" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                  <polyline points="20 6 9 17 4 12"></polyline>
                </svg>
                <span id="copy-btn-text">Copy Result</span>
              </button>

              <button
                type="button"
                id="btn-download"
                class="px-2.5 py-1 text-xs font-medium rounded-md border border-slate-200 dark:border-slate-700/80 hover:bg-slate-100 dark:hover:bg-slate-800 text-slate-700 dark:text-slate-300 transition-colors flex items-center gap-1.5 cursor-pointer"
                title="Download cleaned text as .txt file"
              >
                <svg class="w-3.5 h-3.5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                  <path stroke-linecap="round" stroke-linejoin="round" d="M4 16v1a3 3 0 003 3h10a3 3 0 003-3v-1m-4-4l-4 4m0 0l-4-4m4 4V4" />
                </svg>
                <span>.txt</span>
              </button>
            </div>
          </div>

          <textarea
            id="output-text"
            rows="14"
            placeholder="Your joined, single-line text will appear here automatically..."
            class="w-full p-4 rounded-xl border border-slate-200 dark:border-slate-800 bg-slate-50/50 dark:bg-slate-950/60 text-slate-900 dark:text-slate-100 font-mono text-sm leading-relaxed placeholder:text-slate-400 dark:placeholder:text-slate-600 focus:outline-none focus:ring-2 focus:ring-purple-500/30 focus:border-purple-500 transition resize-y min-h-[320px]"
            spellcheck="false"
          ></textarea>

          <!-- Output Live Counters -->
          <div class="flex items-center justify-between text-xs text-slate-500 dark:text-slate-400 pt-1 font-mono">
            <div class="flex items-center gap-3">
              <span>Lines: <strong id="stat-output-lines" class="text-slate-800 dark:text-slate-200">0</strong></span>
              <span>Chars: <strong id="stat-output-chars" class="text-slate-800 dark:text-slate-200">0</strong></span>
              <span>Breaks: <strong id="stat-breaks-saved" class="text-emerald-600 dark:text-emerald-400">0</strong></span>
            </div>
            <div id="stat-reduction-pct" class="text-[11px] font-semibold text-emerald-600 dark:text-emerald-400">
              0% reduction
            </div>
          </div>
        </div>

      </div>

    </div>
  </section>

  <!-- 3-Step Guide Section -->
  <section class="border-t border-slate-200 dark:border-slate-800 bg-slate-50/50 dark:bg-slate-900/40 py-16 sm:py-20">
    <div class="max-w-5xl mx-auto px-4 sm:px-6 lg:px-8">
      
      <div class="text-center max-w-2xl mx-auto mb-12">
        <h2 class="text-2xl sm:text-3xl font-bold tracking-tight text-slate-900 dark:text-white">
          How to Remove Line Breaks Online in 3 Simple Steps
        </h2>
        <p class="mt-2 text-sm sm:text-base text-slate-600 dark:text-slate-400">
          Unwrap broken PDF sentences, join lists with commas, and flatten paragraphs in seconds.
        </p>
      </div>

      <div class="grid grid-cols-1 md:grid-cols-3 gap-6 sm:gap-8">
        
        <!-- Step 1 -->
        <div class="p-6 rounded-2xl border border-slate-200 dark:border-slate-800 bg-white dark:bg-slate-900 shadow-xs relative">
          <div class="w-10 h-10 rounded-xl bg-purple-50 dark:bg-purple-950/40 text-purple-600 dark:text-purple-400 flex items-center justify-center font-bold font-mono text-sm mb-4 border border-purple-100 dark:border-purple-900/50">
            01
          </div>
          <h3 class="text-base font-semibold text-slate-900 dark:text-white mb-2">
            Paste Multiline Text
          </h3>
