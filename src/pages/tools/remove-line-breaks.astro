<!-- Client-Side JavaScript Logic -->
<script is:inline>
  (function () {
    const inputText = document.getElementById('input-text');
    const outputText = document.getElementById('output-text');
    const modeRadios = document.querySelectorAll('input[name="replace-mode"]');
    const modeCustomRadio = document.getElementById('mode-custom-radio');
    const inputCustomDelimiter = document.getElementById('input-custom-delimiter');
    const optPreserveParagraphs = document.getElementById('opt-preserve-paragraphs');
    const btnRemoveBreaks = document.getElementById('btn-remove-breaks');
    const btnSample = document.getElementById('btn-sample');
    const btnPaste = document.getElementById('btn-paste');
    const btnClear = document.getElementById('btn-clear');
    const btnCopy = document.getElementById('btn-copy');
    const btnDownload = document.getElementById('btn-download');

    const copyBtnText = document.getElementById('copy-btn-text');
    const copyIconIdle = document.getElementById('copy-icon-idle');
    const copyIconSuccess = document.getElementById('copy-icon-success');

    const statInputChars = document.getElementById('stat-input-chars');
    const statInputWords = document.getElementById('stat-input-words');
    const statInputLines = document.getElementById('stat-input-lines');

    const statOutputChars = document.getElementById('stat-output-chars');
    const statOutputLines = document.getElementById('stat-output-lines');
    const statBreaksSaved = document.getElementById('stat-breaks-saved');
    const statReductionPct = document.getElementById('stat-reduction-pct');
    const statusBreaksRemoved = document.getElementById('status-breaks-removed');

    const presetButtons = document.querySelectorAll('.preset-card-btn');

    // Preset Data map
    const presetMap = {
      'preset-single-line': {
        options: { mode: 'space', custom: '', preserveParagraphs: false },
        sample: 'Artificial intelligence and agentic workflows\nare transforming software engineering.\nModern developers leverage intelligent automation\nto build performant web applications.'
      },
      'preset-comma-join': {
        options: { mode: 'comma', custom: '', preserveParagraphs: false },
        sample: 'San Francisco\nNew York\nLondon\nTokyo\nSingapore\nBerlin\nSydney'
      },
      'preset-fix-pdf': {
        options: { mode: 'space', custom: '', preserveParagraphs: false },
        sample: 'The primary objective of this\nclinical trial was to assess the\nefficacy of the intervention across\nmultiple independent demographic groups.'
      },
      'preset-preserve-paras': {
        options: { mode: 'space', custom: '', preserveParagraphs: true },
        sample: 'Early computing pioneers designed systems with\nstrict memory limitations and sequential execution.\nThese architectures laid the groundwork for today\'s machines.\n\nDecades later, distributed systems and parallel\nprocessing emerged to meet exponential demand.\nModern cloud networks now scale across continents.'
      },
      'preset-sql-in': {
        options: { mode: 'comma', custom: '', preserveParagraphs: false },
        sample: '10024\n10025\n10031\n10089\n10142\n10199'
      },
      'preset-json-helper': {
        options: { mode: 'space', custom: '', preserveParagraphs: false },
        sample: 'This is a detailed product description\nwritten across multiple lines\nthat must be encoded into a JSON string\nwithout illegal newline characters.'
      }
    };

    function countWords(str) {
      if (!str || !str.trim()) return 0;
      return str.trim().split(/\s+/).length;
    }

    function countLines(str) {
      if (!str) return 0;
      return str.split(/\r?\n/).length;
    }

    function getDelimiter() {
      let selected = 'space';
      modeRadios.forEach(function (radio) {
        if (radio.checked) selected = radio.value;
      });

      if (selected === 'comma') return ', ';
      if (selected === 'none') return '';
      if (selected === 'custom') {
        return inputCustomDelimiter ? inputCustomDelimiter.value : '';
      }
      return ' ';
    }

    // High-performance Line Break Remover logic
    function removeLineBreaks(text) {
      if (!text) {
        return {
          result: '',
          breaksRemoved: 0,
          originalLines: 0,
          outputLines: 0
        };
      }

      const delimiter = getDelimiter();
      const preserveParagraphs = optPreserveParagraphs ? optPreserveParagraphs.checked : false;

      // Count total raw line returns in input
      const totalBreaks = (text.match(/\r\n|\r|\n/g) || []).length;

      let result = '';

      if (preserveParagraphs) {
        // Split into paragraphs by 2 or more newlines (with optional whitespace in between)
        const paragraphs = text.split(/(?:\r?\n\s*){2,}/);
        const cleanedParagraphs = paragraphs.map(function (p) {
          return p
            .split(/\r?\n/)
            .map(function (line) {
              return line.trim();
            })
            .filter(function (line) {
              return line.length > 0;
            })
            .join(delimiter);
        }).filter(function (p) {
          return p.length > 0;
        });

        result = cleanedParagraphs.join('\n\n');
      } else {
        // Flatten all lines
        const lines = text.split(/\r?\n/).map(function (line) {
          return line.trim();
        });
        result = lines.filter(function (line) {
          return line.length > 0;
        }).join(delimiter);
      }

      // Calculate breaks removed
      const resultBreaks = (result.match(/\r\n|\r|\n/g) || []).length;
      const breaksRemoved = Math.max(0, totalBreaks - resultBreaks);

      const rawLinesCount = text.split(/\r?\n/).length;
      const outLinesCount = result ? result.split(/\r?\n/).length : 0;

      return {
        result: result,
        breaksRemoved: breaksRemoved,
        originalLines: rawLinesCount,
        outputLines: outLinesCount
      };
    }

    function update() {
      const raw = inputText.value || '';
      const cleanResult = removeLineBreaks(raw);
      outputText.value = cleanResult.result;

      // Input Stats
      const inChars = raw.length;
      const inWords = countWords(raw);
      const inLines = raw ? countLines(raw) : 0;

      statInputChars.textContent = inChars.toLocaleString();
      statInputWords.textContent = inWords.toLocaleString();
      statInputLines.textContent = inLines.toLocaleString();

      // Output Stats
      const outChars = cleanResult.result.length;
      const outLines = cleanResult.result ? cleanResult.outputLines : 0;

      statOutputChars.textContent = outChars.toLocaleString();
      statOutputLines.textContent = outLines.toLocaleString();

      const breaksRemoved = cleanResult.breaksRemoved;
      statBreaksSaved.textContent = breaksRemoved.toLocaleString();

      const pct = inLines > 1 ? Math.max(0, Math.round((breaksRemoved / (inLines - 1)) * 100)) : 0;
      statReductionPct.textContent = pct + '% reduction';

      statusBreaksRemoved.textContent =
        breaksRemoved.toLocaleString() + ' line ' + (breaksRemoved === 1 ? 'break' : 'breaks') + ' removed';
    }

    // Debounce helper for silky performance with large text
    let timeoutId;
    function debouncedUpdate() {
      clearTimeout(timeoutId);
      timeoutId = setTimeout(update, 50);
    }

    // Event Listeners
    inputText?.addEventListener('input', debouncedUpdate);
    modeRadios.forEach(function (radio) {
      radio.addEventListener('change', update);
    });
    inputCustomDelimiter?.addEventListener('input', function () {
      if (modeCustomRadio) modeCustomRadio.checked = true;
      debouncedUpdate();
    });
    inputCustomDelimiter?.addEventListener('focus', function () {
      if (modeCustomRadio) {
        modeCustomRadio.checked = true;
        update();
      }
    });
    optPreserveParagraphs?.addEventListener('change', update);
    btnRemoveBreaks?.addEventListener('click', update);

    // Sample Text
    btnSample?.addEventListener('click', function () {
      inputText.value =
        'This is a sample document that contains multiple line breaks\nthat cause awkward sentence wraps.\n\nWhen text is copied from a PDF or formatted email,\nit often separates thoughts onto erratic lines.\n\nThis tool joins everything into smooth, continuous sentences.';
      update();
    });

    // Clear
    btnClear?.addEventListener('click', function () {
      inputText.value = '';
      outputText.value = '';
      update();
      inputText.focus();
    });

    // Paste from Clipboard
    btnPaste?.addEventListener('click', async function () {
      try {
        if (navigator.clipboard && navigator.clipboard.readText) {
          const clipText = await navigator.clipboard.readText();
          if (clipText) {
            inputText.value = clipText;
            update();
          }
        } else {
          inputText.focus();
          inputText.select();
        }
      } catch (err) {
        inputText.focus();
      }
    });

    // Copy to Clipboard
    btnCopy?.addEventListener('click', async function () {
      const textToCopy = outputText.value;
      if (!textToCopy) return;

      try {
        if (navigator.clipboard && navigator.clipboard.writeText) {
          await navigator.clipboard.writeText(textToCopy);
        } else {
          outputText.select();
          document.execCommand('copy');
        }

        copyBtnText.textContent = 'Copied!';
        copyIconIdle.classList.add('hidden');
        copyIconSuccess.classList.remove('hidden');

        setTimeout(function () {
          copyBtnText.textContent = 'Copy Result';
          copyIconIdle.classList.remove('hidden');
          copyIconSuccess.classList.add('hidden');
        }, 2000);
      } catch (err) {
        outputText.select();
      }
    });

    // Download .txt file
    btnDownload?.addEventListener('click', function () {
      const content = outputText.value;
      if (!content) return;

      const blob = new Blob([content], { type: 'text/plain;charset=utf-8' });
      const url = URL.createObjectURL(blob);
      const a = document.createElement('a');
      a.href = url;
      a.download = 'joined-text.txt';
      document.body.appendChild(a);
      a.click();
      document.body.removeChild(a);
      URL.revokeObjectURL(url);
    });

    // Preset Buttons
    presetButtons.forEach(function (btn) {
      btn.addEventListener('click', function () {
        const id = btn.getAttribute('data-preset');
        const data = presetMap[id];
        if (!data) return;

        modeRadios.forEach(function (radio) {
          radio.checked = radio.value === data.options.mode;
        });

        if (inputCustomDelimiter) {
          inputCustomDelimiter.value = data.options.custom || '';
        }

        if (optPreserveParagraphs) {
          optPreserveParagraphs.checked = data.options.preserveParagraphs;
        }

        if (data.sample) {
          inputText.value = data.sample;
        }

        update();

        // Scroll to editor
        const studio = document.getElementById('input-text');
        if (studio) {
          studio.scrollIntoView({ behavior: 'smooth', block: 'center' });
        }
      });
    });

    // Initial update on page load
    update();
  })();
</script>
