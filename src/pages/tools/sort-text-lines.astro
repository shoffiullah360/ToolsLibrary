---
import Layout from '../../layouts/Layout.astro';
import ToolIcon from '../../components/ToolIcon.astro';

// FAQ Data for Schema and Accordion
const faqs = [
  {
    question: "How do I alphabetize a list online?",
    answer: "Paste or type your text list into the Input Text box. By default, FastToolVerse immediately sorts your lines in ascending alphabetical order (A-Z). You can switch to reverse order (Z-A), numerical sort, or sort by line length instantly."
  },
  {
    question: "What is 'Natural / Numerical Sort' and how does it differ from ASCII sort?",
    answer: "In standard computer ASCII sorting, 'Episode 10' appears before 'Episode 2' because character '1' precedes character '2'. Natural sort uses numerical collation (Intl.Collator with numeric: true), sorting multi-digit numbers by their real numeric value so 'Episode 2' correctly precedes 'Episode 10'."
  },
  {
    question: "Does this tool upload my lists or data to a server?",
    answer: "No. FastToolVerse executes 100% of its sorting algorithms locally inside your web browser using JavaScript's native Intl collation and array routines. Your proprietary data, customer names, product inventories, and passwords never leave your computer's RAM."
  },
  {
    question: "How does the 'Remove duplicates' option work during sorting?",
    answer: "When 'Remove duplicates' is enabled, FastToolVerse passes your list through a high-speed Set deduplication filter before sorting, eliminating recurring lines so your final output contains only unique entries."
  },
  {
    question: "Can I sort lines by character length?",
    answer: "Yes. Select 'Line Length (Shortest → Longest)' or 'Line Length (Longest → Shortest)'. FastToolVerse will organize your entries based on string character length, which is ideal for copywriting, code refactoring, and formatting keyword clusters."
  },
  {
    question: "How does the 'Randomize / Shuffle Lines' mode work?",
    answer: "The shuffle mode executes an unbiased Fisher-Yates (Knuth) algorithmic permutation in your browser. Every item has an equal probability of landing in any position, making it perfect for giveaways, random pairings, or study flashcards."
  },
  {
    question: "Can this tool handle massive lists with tens of thousands of lines?",
    answer: "Yes. Modern V8 JavaScript engines sort arrays of 50,000+ items in milliseconds using Timsort (O(N log N)). FastToolVerse debounces input calculations so your browser UI stays silky smooth without freezing."
  },
  {
    question: "Does this text sorter work offline?",
    answer: "Yes. Once the page is loaded in your browser, all JavaScript logic runs locally. You can disconnect from the internet or work in airplane mode, and FastToolVerse will continue to sort text lines flawlessly."
  }
];

// Schema.org SoftwareApplication
const jsonLdSoftwareApp = {
  "@context": "https://schema.org",
  "@type": "SoftwareApplication",
  "name": "Free Online Text Line Sorter & List Alphabetizer",
  "applicationCategory": "UtilitiesApplication",
  "operatingSystem": "All (Web Browser)",
  "browserRequirements": "Requires JavaScript. Runs 100% client-side.",
  "offers": {
    "@type": "Offer",
    "price": "0",
    "priceCurrency": "USD"
  },
  "featureList": [
    "100% In-browser text sorting privacy",
    "Alphabetical sorting A-Z and reverse Z-A",
    "Natural numerical sorting (handles embedded numbers correctly)",
    "Sort lines by character length (shortest and longest)",
    "Fisher-Yates unbiased line randomizer / shuffler",
    "Case-sensitive comparison toggle",
    "Integrated duplicate line removal",
    "Live line, word, and character counters",
    "1-click copy to clipboard and .txt file export"
  ]
};

// Schema.org FAQPage
const jsonLdFaq = {
  "@context": "https://schema.org",
  "@type": "FAQPage",
  "mainEntity": faqs.map((f) => ({
    "@type": "Question",
    "name": f.question,
    "acceptedAnswer": {
      "@type": "Answer",
      "text": f.answer
    }
  }))
};

// Schema.org BreadcrumbList
const jsonLdBreadcrumb = {
  "@context": "https://schema.org",
  "@type": "BreadcrumbList",
  "itemListElement": [
    {
      "@type": "ListItem",
      "position": 1,
      "name": "Home",
      "item": "https://fasttoolverse.com/"
    },
    {
      "@type": "ListItem",
      "position": 2,
      "name": "Text & Formatting",
      "item": "https://fasttoolverse.com/#text-tools-section"
    },
    {
      "@type": "ListItem",
      "position": 3,
      "name": "Sort Text Lines",
      "item": "https://fasttoolverse.com/tools/sort-text-lines"
    }
  ]
};

const canonicalUrl = "https://fasttoolverse.com/tools/sort-text-lines";
const pageTitle = "Sort Text Lines Online - Alphabetical & Length Sorter";
const pageDescription = "Sort text lists alphabetically (A-Z, Z-A), numerically, or by line length directly in your browser with zero server uploads. 100% private text sorter.";
const pageKeywords = "sort text lines, list alphabetizer, alphabetize list online, sort lines a to z, reverse alphabetical sort, natural sort, sort by length, randomize list, shuffle lines, client side text tool";
const ogImage = "https://fasttoolverse.com/og-image.png";

// Programmatic target cards / presets
const presets = [
  {
    id: "preset-az",
    title: "Alphabetize List A to Z",
    tag: "Standard Alphabetical",
    desc: "Order names, glossary terms, or items in clean ascending alphabetical order from A to Z.",
    options: { sortType: "az", caseSensitive: false, dedupe: false },
    sampleText: "Watermelon\nApple\nGrape\nBanana\nOrange\nPineapple\nMango\nCherry"
  },
  {
    id: "preset-za",
    title: "Reverse Alphabetical Sorter",
    tag: "Descending Z to A",
    desc: "Flip list hierarchy to descending alphabetical order from Z down to A.",
    options: { sortType: "za", caseSensitive: false, dedupe: false },
    sampleText: "Berlin\nAmsterdam\nTokyo\nParis\nLondon\nMadrid\nRome\nVienna"
  },
  {
    id: "preset-length",
    title: "Sort Lines by Length",
    tag: "String Length Hierarchy",
    desc: "Reorganize lines from shortest to longest to visualize density and text length.",
    options: { sortType: "length-asc", caseSensitive: false, dedupe: false },
    sampleText: "The quick brown fox jumps over the lazy dog\nYes\nHello world\nArtificial intelligence\nOk\nWeb development tools\nCode"
  },
  {
    id: "preset-natural",
    title: "Natural Number Sorter",
    tag: "Human Numerical Order",
    desc: "Sort strings containing numbers naturally so 'Episode 2' comes before 'Episode 10' instead of ASCII order.",
    options: { sortType: "natural", caseSensitive: false, dedupe: false },
    sampleText: "Episode 10\nEpisode 1\nEpisode 2\nEpisode 20\nEpisode 3\nEpisode 11\nEpisode 4"
  },
  {
    id: "preset-shuffle",
    title: "Random Line Shuffler",
    tag: "Fisher-Yates Shuffle",
    desc: "Randomize lines unpredictably for raffle drawings, flashcard reviews, or unbiased sampling.",
    options: { sortType: "shuffle", caseSensitive: false, dedupe: false },
    sampleText: "Participant 1: Alex Morgan\nParticipant 2: Brian Chen\nParticipant 3: Clara Silva\nParticipant 4: David Kim\nParticipant 5: Elena Rostova\nParticipant 6: Farhan Qureshi"
  },
  {
    id: "preset-combo",
    title: "Sort & Deduplicate Combo",
    tag: "Clean & Alphabetize",
    desc: "Purge repeated entries and simultaneously organize the unique remnants in pristine alphabetical order.",
    options: { sortType: "az", caseSensitive: false, dedupe: true },
    sampleText: "Python\nJavaScript\nTypeScript\nPython\nGo\nRust\nJavaScript\nC++\nGo\nRuby"
  }
];
---

<Layout
  title={pageTitle}
  description={pageDescription}
  canonicalUrl={canonicalUrl}
  image={ogImage}
>
  <!-- Injected Head Elements: Twitter & JSON-LD Schemas -->
  <Fragment slot="head">
    <meta name="keywords" content={pageKeywords} />

    <!-- Open Graph tags -->
    <meta property="og:type" content="website" />
    <meta property="og:url" content={canonicalUrl} />
    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={pageDescription} />
    <meta property="og:image" content={ogImage} />

    <!-- Twitter Card -->
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:url" content={canonicalUrl} />
    <meta name="twitter:title" content={pageTitle} />
    <meta name="twitter:description" content={pageDescription} />
    <meta name="twitter:image" content={ogImage} />

    <!-- Structured Data Schemas -->
    <script type="application/ld+json" set:html={JSON.stringify(jsonLdSoftwareApp)} />
    <script type="application/ld+json" set:html={JSON.stringify(jsonLdFaq)} />
    <script type="application/ld+json" set:html={JSON.stringify(jsonLdBreadcrumb)} />
  </Fragment>

  <!-- Hero Header Section -->
  <section class="relative pt-10 pb-6 sm:pt-14 sm:pb-8 overflow-hidden">
    <div class="hero-mesh-bg" aria-hidden="true"></div>

    <div class="relative max-w-5xl mx-auto px-4 sm:px-6 lg:px-8 text-center">
      <!-- Breadcrumbs -->
      <nav aria-label="Breadcrumb" class="mb-5 flex justify-center">
        <ol class="inline-flex items-center space-x-1.5 md:space-x-2 text-xs font-medium text-slate-500 dark:text-slate-400">
          <li class="inline-flex items-center">
            <a href="/" class="hover:text-blue-600 dark:hover:text-blue-400 transition-colors">Home</a>
          </li>
          <li>
            <div class="flex items-center">
              <svg class="w-3 h-3 text-slate-400 mx-1" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7" />
              </svg>
              <a href="/#text-tools-section" class="hover:text-purple-600 dark:hover:text-purple-400 transition-colors">Text & Formatting</a>
            </div>
          </li>
          <li aria-current="page">
            <div class="flex items-center">
              <svg class="w-3 h-3 text-slate-400 mx-1" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7" />
              </svg>
              <span class="text-slate-900 dark:text-white font-semibold">Sort Text Lines</span>
            </div>
          </li>
        </ol>
      </nav>

      <!-- Hero Title -->
      <h1 class="text-3xl sm:text-4xl md:text-5xl font-bold tracking-tight text-slate-900 dark:text-white leading-tight">
        Free Online Text Line Sorter & List Alphabetizer
      </h1>

      <!-- Subtitle -->
      <p class="mt-3 sm:mt-4 text-base sm:text-lg text-slate-600 dark:text-slate-400 max-w-2xl mx-auto leading-relaxed">
        Sort text lists alphabetically (A-Z, Z-A), numerically, or by line length directly in your browser.
      </p>
    </div>
  </section>

  <!-- Interactive Studio Container -->
  <section class="max-w-6xl mx-auto px-4 sm:px-6 lg:px-8 pb-16 sm:pb-24">
    <div class="rounded-2xl border border-slate-300 dark:border-slate-800 bg-white dark:bg-slate-900 shadow-sm overflow-hidden transition-colors">
      
      <!-- Top Options & Controls Bar -->
      <div class="p-5 sm:p-6 border-b border-slate-200 dark:border-slate-800 bg-slate-50/70 dark:bg-slate-900/70">
        <div class="flex flex-col lg:flex-row lg:items-center justify-between gap-4">
          
          <!-- Sorting Rules (Select & Checkboxes) -->
          <div class="flex flex-col sm:flex-row sm:items-center gap-4 flex-wrap">
            
            <!-- Sort Mode Selector -->
            <div class="flex items-center gap-2">
              <label for="select-sort-type" class="text-xs font-semibold text-slate-500 dark:text-slate-400 uppercase tracking-wider shrink-0">
                Sort Type:
              </label>
              <select
                id="select-sort-type"
                class="px-3 py-1.5 text-xs sm:text-sm font-medium rounded-lg border border-slate-300 dark:border-slate-700 bg-white dark:bg-slate-800 text-slate-900 dark:text-white focus:outline-none focus:ring-2 focus:ring-purple-500/30 focus:border-purple-500 transition cursor-pointer shadow-2xs"
              >
                <option value="az" selected>Alphabetical (A &rarr; Z)</option>
                <option value="za">Reverse Alphabetical (Z &rarr; A)</option>
                <option value="natural">Natural / Numerical (1, 2, 10...)</option>
                <option value="length-asc">Line Length (Shortest &rarr; Longest)</option>
                <option value="length-desc">Line Length (Longest &rarr; Shortest)</option>
                <option value="shuffle">Randomize / Shuffle Lines</option>
              </select>
            </div>

            <!-- Options Checkboxes -->
            <div class="flex items-center gap-4 sm:border-l sm:border-slate-200 sm:dark:border-slate-800 sm:pl-4">
              <label class="inline-flex items-center gap-2 cursor-pointer text-xs sm:text-sm font-medium text-slate-700 dark:text-slate-300 hover:text-slate-900 dark:hover:text-white transition-colors">
                <input
                  type="checkbox"
                  id="opt-case-sensitive"
                  class="w-4 h-4 rounded border-slate-300 dark:border-slate-700 text-purple-600 focus:ring-purple-500 dark:bg-slate-800 cursor-pointer"
                />
                <span>Case-sensitive</span>
              </label>

              <label class="inline-flex items-center gap-2 cursor-pointer text-xs sm:text-sm font-medium text-slate-700 dark:text-slate-300 hover:text-slate-900 dark:hover:text-white transition-colors">
                <input
                  type="checkbox"
                  id="opt-dedupe"
                  class="w-4 h-4 rounded border-slate-300 dark:border-slate-700 text-purple-600 focus:ring-purple-500 dark:bg-slate-800 cursor-pointer"
                />
                <span>Remove duplicates</span>
              </label>
            </div>

          </div>

          <!-- Action Buttons -->
          <div class="flex items-center gap-2.5 shrink-0">
            <button
              type="button"
              id="btn-sample"
              class="px-3.5 py-1.5 text-xs font-semibold rounded-lg border border-slate-200 dark:border-slate-700 text-slate-700 dark:text-slate-300 hover:bg-slate-100 dark:hover:bg-slate-800 transition-colors cursor-pointer shadow-2xs"
            >
              Load Sample
            </button>
            <button
              type="button"
              id="btn-sort"
              class="px-5 py-2 text-xs sm:text-sm font-semibold rounded-lg bg-purple-600 hover:bg-purple-700 text-white shadow-sm transition-all flex items-center gap-2 cursor-pointer"
            >
              <ToolIcon name="arrow-up-down" class="w-4 h-4" />
              <span>Sort Lines</span>
            </button>
          </div>

        </div>
      </div>

      <!-- Dual Textarea Layout -->
      <div class="grid grid-cols-1 lg:grid-cols-2 divide-y lg:divide-y-0 lg:divide-x divide-slate-200 dark:divide-slate-800">
        
        <!-- Left: Input Area -->
        <div class="p-5 sm:p-6 flex flex-col space-y-3 bg-white dark:bg-slate-900">
          <div class="flex items-center justify-between">
            <div class="flex items-center gap-2">
              <span class="text-xs font-mono uppercase tracking-wider font-semibold text-slate-500 dark:text-slate-400">
                Input Text
              </span>
              <span id="badge-input-ready" class="text-[11px] font-medium px-2 py-0.5 rounded-full bg-slate-100 dark:bg-slate-800 text-slate-600 dark:text-slate-400">
                Live Typing
              </span>
            </div>
            
            <div class="flex items-center gap-2">
              <button
                type="button"
                id="btn-paste"
                class="px-2.5 py-1 text-xs font-medium rounded-md border border-slate-200 dark:border-slate-700/80 hover:bg-slate-100 dark:hover:bg-slate-800 text-slate-700 dark:text-slate-300 transition-colors flex items-center gap-1.5 cursor-pointer"
                title="Paste from clipboard"
              >
                <svg class="w-3.5 h-3.5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                  <path stroke-linecap="round" stroke-linejoin="round" d="M9 5H7a2 2 0 00-2 2v12a2 2 0 002 2h10a2 2 0 002-2V7a2 2 0 00-2-2h-2M9 5a2 2 0 002 2h2a2 2 0 002-2M9 5a2 2 0 012-2h2a2 2 0 012 2" />
                </svg>
                <span>Paste</span>
              </button>
              <button
                type="button"
                id="btn-clear"
                class="px-2.5 py-1 text-xs font-medium rounded-md border border-slate-200 dark:border-slate-700/80 hover:bg-rose-50 dark:hover:bg-rose-950/40 text-slate-600 hover:text-rose-600 dark:text-slate-400 dark:hover:text-rose-400 transition-colors cursor-pointer"
                title="Clear input text"
              >
                Clear
              </button>
            </div>
          </div>

          <textarea
            id="input-text"
            rows="14"
            placeholder="Paste or type your list here... It will automatically be sorted in real time according to your chosen mode."
            class="w-full p-4 rounded-xl border border-slate-200 dark:border-slate-800 bg-slate-50/50 dark:bg-slate-950/60 text-slate-900 dark:text-slate-100 font-mono text-sm leading-relaxed placeholder:text-slate-400 dark:placeholder:text-slate-600 focus:outline-none focus:ring-2 focus:ring-purple-500/30 focus:border-purple-500 transition resize-y min-h-[320px]"
            spellcheck="false"
          ></textarea>

          <!-- Input Live Counters -->
          <div class="flex items-center justify-between text-xs text-slate-500 dark:text-slate-400 pt-1 font-mono">
            <div class="flex items-center gap-3">
              <span>Lines: <strong id="stat-input-lines" class="text-slate-800 dark:text-slate-200">0</strong></span>
              <span>Chars: <strong id="stat-input-chars" class="text-slate-800 dark:text-slate-200">0</strong></span>
              <span>Words: <strong id="stat-input-words" class="text-slate-800 dark:text-slate-200">0</strong></span>
            </div>
            <div class="text-[11px] text-slate-400 dark:text-slate-500">
              Input buffer
            </div>
          </div>
        </div>

        <!-- Right: Output Area -->
        <div class="p-5 sm:p-6 flex flex-col space-y-3 bg-white dark:bg-slate-900">
          <div class="flex items-center justify-between">
            <div class="flex items-center gap-2">
              <span class="text-xs font-mono uppercase tracking-wider font-semibold text-purple-600 dark:text-purple-400">
                Sorted Result
              </span>
              <span
                id="status-sort-mode"
                class="text-[11px] font-medium px-2 py-0.5 rounded-full bg-emerald-50 dark:bg-emerald-950/50 text-emerald-700 dark:text-emerald-400 border border-emerald-200 dark:border-emerald-900/40"
              >
                Alphabetical (A-Z)
              </span>
            </div>

            <div class="flex items-center gap-2">
              <button
                type="button"
                id="btn-copy"
                class="px-3 py-1 text-xs font-semibold rounded-md bg-purple-600 hover:bg-purple-700 text-white transition-colors flex items-center gap-1.5 cursor-pointer shadow-xs"
                title="Copy sorted text to clipboard"
              >
                <svg id="copy-icon-idle" class="w-3.5 h-3.5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                  <rect x="9" y="9" width="13" height="13" rx="2" ry="2"></rect>
                  <path d="M5 15H4a2 2 0 01-2-2V4a2 2 0 012-2h9a2 2 0 012 2v1"></path>
                </svg>
                <svg id="copy-icon-success" class="w-3.5 h-3.5 hidden text-emerald-300" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                  <polyline points="20 6 9 17 4 12"></polyline>
                </svg>
                <span id="copy-btn-text">Copy Result</span>
              </button>

              <button
                type="button"
                id="btn-download"
                class="px-2.5 py-1 text-xs font-medium rounded-md border border-slate-200 dark:border-slate-700/80 hover:bg-slate-100 dark:hover:bg-slate-800 text-slate-700 dark:text-slate-300 transition-colors flex items-center gap-1.5 cursor-pointer"
                title="Download sorted list as .txt file"
              >
                <svg class="w-3.5 h-3.5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                  <path stroke-linecap="round" stroke-linejoin="round" d="M4 16v1a3 3 0 003 3h10a3 3 0 003-3v-1m-4-4l-4 4m0 0l-4-4m4 4V4" />
                </svg>
                <span>.txt</span>
              </button>
            </div>
          </div>

          <textarea
            id="output-text"
            rows="14"
            placeholder="Your sorted list will appear here in real time..."
            class="w-full p-4 rounded-xl border border-slate-200 dark:border-slate-800 bg-slate-50/50 dark:bg-slate-950/60 text-slate-900 dark:text-slate-100 font-mono text-sm leading-relaxed placeholder:text-slate-400 dark:placeholder:text-slate-600 focus:outline-none focus:ring-2 focus:ring-purple-500/30 focus:border-purple-500 transition resize-y min-h-[320px]"
            spellcheck="false"
          ></textarea>

          <!-- Output Live Counters -->
          <div class="flex items-center justify-between text-xs text-slate-500 dark:text-slate-400 pt-1 font-mono">
            <div class="flex items-center gap-3">
              <span>Lines: <strong id="stat-output-lines" class="text-slate-800 dark:text-slate-200">0</strong></span>
              <span>Chars: <strong id="stat-output-chars" class="text-slate-800 dark:text-slate-200">0</strong></span>
              <span>Duplicates: <strong id="stat-dupes-removed" class="text-emerald-600 dark:text-emerald-400">0</strong></span>
            </div>
            <div id="stat-reduction-pct" class="text-[11px] font-semibold text-emerald-600 dark:text-emerald-400">
              0% duplicate reduction
            </div>
          </div>
        </div>

      </div>

    </div>
  </section>

  <!-- 3-Step Guide Section -->
  <section class="border-t border-slate-200 dark:border-slate-800 bg-slate-50/50 dark:bg-slate-900/40 py-16 sm:py-20">
    <div class="max-w-5xl mx-auto px-4 sm:px-6 lg:px-8">
      
      <div class="text-center max-w-2xl mx-auto mb-12">
        <h2 class="text-2xl sm:text-3xl font-bold tracking-tight text-slate-900 dark:text-white">
          How to Sort Text Lines Online in 3 Simple Steps
        </h2>
        <p class="mt-2 text-sm sm:text-base text-slate-600 dark:text-slate-400">
          Alphabetize customer lists, sort numeric logs, or randomize items in seconds.
        </p>
      </div>

      <div class="grid grid-cols-1 md:grid-cols-3 gap-6 sm:gap-8">
        
        <!-- Step 1 -->
        <div class="p-6 rounded-2xl border border-slate-300 dark:border-slate-800 bg-white dark:bg-slate-900 shadow-sm hover:shadow-md hover:border-purple-600 transition-all duration-150 relative">
          <div class="w-10 h-10 rounded-xl bg-purple-50 dark:bg-purple-950/40 text-purple-600 dark:text-purple-400 flex items-center justify-center font-bold font-mono text-sm mb-4 border border-purple-100 dark:border-purple-900/50">
            01
          </div>
          <h3 class="text-base font-semibold text-slate-900 dark:text-white mb-2">
            Paste or Enter List
          </h3>
          <p class="text-sm text-slate-600 dark:text-slate-400 leading-relaxed">
            Copy names, keywords, items, or numbers from a spreadsheet or document and paste them directly into the input box using <kbd class="px-1.5 py-0.5 text-xs font-mono bg-slate-100 dark:bg-slate-800 rounded border border-slate-200 dark:border-slate-700">Ctrl+V</kbd> or the Paste button.
          </p>
        </div>

        <!-- Step 2 -->
        <div class="p-6 rounded-2xl border border-slate-300 dark:border-slate-800 bg-white dark:bg-slate-900 shadow-sm hover:shadow-md hover:border-purple-600 transition-all duration-150 relative">
          <div class="w-10 h-10 rounded-xl bg-purple-50 dark:bg-purple-950/40 text-purple-600 dark:text-purple-400 flex items-center justify-center font-bold font-mono text-sm mb-4 border border-purple-100 dark:border-purple-900/50">
            02
          </div>
          <h3 class="text-base font-semibold text-slate-900 dark:text-white mb-2">
            Select Sorting Mode
          </h3>
          <p class="text-sm text-slate-600 dark:text-slate-400 leading-relaxed">
            Choose your desired ordering: alphabetical (A-Z, Z-A), natural numeric sort, line length, or random shuffle. Optionally toggle case-sensitivity or automatic deduplication.
          </p>
        </div>

        <!-- Step 3 -->
        <div class="p-6 rounded-2xl border border-slate-300 dark:border-slate-800 bg-white dark:bg-slate-900 shadow-sm hover:shadow-md hover:border-purple-600 transition-all duration-150 relative">
