    </div>
  </section>

  <!-- Related Tools Row -->
  <section class="border-t border-slate-200 dark:border-slate-800 bg-slate-50/50 dark:bg-slate-900/40 py-12 sm:py-16">
    <div class="max-w-5xl mx-auto px-4 sm:px-6 lg:px-8 text-center">
      <h3 class="text-lg font-semibold text-slate-900 dark:text-white mb-6">
        Explore Related Text &amp; Formatting Tools
      </h3>
      <div class="flex flex-wrap justify-center gap-3">
        <a
          href="/tools/remove-extra-spaces"
          class="inline-flex items-center gap-2 px-4 py-2 rounded-xl border border-slate-300 dark:border-slate-800 bg-white dark:bg-slate-900 text-xs font-medium text-slate-700 dark:text-slate-300 shadow-sm hover:shadow-md hover:border-purple-600 dark:hover:border-purple-500 transition-all duration-150"
        >
          <ToolIcon name="space" class="w-4 h-4 text-purple-500" />
          <span>Remove Extra Spaces</span>
        </a>
        <a
          href="/tools/remove-duplicate-lines"
          class="inline-flex items-center gap-2 px-4 py-2 rounded-xl border border-slate-300 dark:border-slate-800 bg-white dark:bg-slate-900 text-xs font-medium text-slate-700 dark:text-slate-300 shadow-sm hover:shadow-md hover:border-purple-600 dark:hover:border-purple-500 transition-all duration-150"
        >
          <ToolIcon name="list-filter" class="w-4 h-4 text-purple-500" />
          <span>Remove Duplicate Lines</span>
        </a>
        <a
          href="/tools/remove-empty-lines"
          class="inline-flex items-center gap-2 px-4 py-2 rounded-xl border border-slate-300 dark:border-slate-800 bg-white dark:bg-slate-900 text-xs font-medium text-slate-700 dark:text-slate-300 shadow-sm hover:shadow-md hover:border-purple-600 dark:hover:border-purple-500 transition-all duration-150"
        >
          <ToolIcon name="list-x" class="w-4 h-4 text-purple-500" />
          <span>Remove Empty Lines</span>
        </a>
        <a
          href="/tools/remove-line-breaks"
          class="inline-flex items-center gap-2 px-4 py-2 rounded-xl border border-slate-300 dark:border-slate-800 bg-white dark:bg-slate-900 text-xs font-medium text-slate-700 dark:text-slate-300 shadow-sm hover:shadow-md hover:border-purple-600 dark:hover:border-purple-500 transition-all duration-150"
        >
          <ToolIcon name="wrap-text" class="w-4 h-4 text-purple-500" />
          <span>Remove Line Breaks</span>
        </a>
        <a
          href="/tools/text-case-converter"
          class="inline-flex items-center gap-2 px-4 py-2 rounded-xl border border-slate-300 dark:border-slate-800 bg-white dark:bg-slate-900 text-xs font-medium text-slate-700 dark:text-slate-300 shadow-sm hover:shadow-md hover:border-purple-600 dark:hover:border-purple-500 transition-all duration-150"
        >
          <ToolIcon name="case-upper" class="w-4 h-4 text-purple-500" />
          <span>Text Case Converter</span>
        </a>
        <a
          href="/tools/text-to-slug-converter"
          class="inline-flex items-center gap-2 px-4 py-2 rounded-xl border border-slate-300 dark:border-slate-800 bg-white dark:bg-slate-900 text-xs font-medium text-slate-700 dark:text-slate-300 shadow-sm hover:shadow-md hover:border-purple-600 dark:hover:border-purple-500 transition-all duration-150"
        >
          <ToolIcon name="link-2" class="w-4 h-4 text-purple-500" />
          <span>Text to Slug Converter</span>
        </a>
      </div>
    </div>
  </section>

</Layout>

<!-- Client-Side JavaScript Logic -->
<script is:inline>
  (function () {
    const inputText = document.getElementById('input-text');
    const outputText = document.getElementById('output-text');
    const selectSortType = document.getElementById('select-sort-type');
    const optCaseSensitive = document.getElementById('opt-case-sensitive');
    const optDedupe = document.getElementById('opt-dedupe');
    const btnSort = document.getElementById('btn-sort');
    const btnSample = document.getElementById('btn-sample');
    const btnPaste = document.getElementById('btn-paste');
    const btnClear = document.getElementById('btn-clear');
    const btnCopy = document.getElementById('btn-copy');
    const btnDownload = document.getElementById('btn-download');

    const copyBtnText = document.getElementById('copy-btn-text');
    const copyIconIdle = document.getElementById('copy-icon-idle');
    const copyIconSuccess = document.getElementById('copy-icon-success');

    const statInputChars = document.getElementById('stat-input-chars');
    const statInputWords = document.getElementById('stat-input-words');
    const statInputLines = document.getElementById('stat-input-lines');

    const statOutputChars = document.getElementById('stat-output-chars');
    const statOutputLines = document.getElementById('stat-output-lines');
    const statDupesRemoved = document.getElementById('stat-dupes-removed');
    const statReductionPct = document.getElementById('stat-reduction-pct');
    const statusSortMode = document.getElementById('status-sort-mode');

    const presetButtons = document.querySelectorAll('.preset-card-btn');

    // Preset Data map
    const presetMap = {
      'preset-az': {
        options: { sortType: 'az', caseSensitive: false, dedupe: false },
        sample: 'Watermelon\nApple\nGrape\nBanana\nOrange\nPineapple\nMango\nCherry'
      },
      'preset-za': {
        options: { sortType: 'za', caseSensitive: false, dedupe: false },
        sample: 'Berlin\nAmsterdam\nTokyo\nParis\nLondon\nMadrid\nRome\nVienna'
      },
      'preset-length': {
        options: { sortType: 'length-asc', caseSensitive: false, dedupe: false },
        sample: 'The quick brown fox jumps over the lazy dog\nYes\nHello world\nArtificial intelligence\nOk\nWeb development tools\nCode'
      },
      'preset-natural': {
        options: { sortType: 'natural', caseSensitive: false, dedupe: false },
        sample: 'Episode 10\nEpisode 1\nEpisode 2\nEpisode 20\nEpisode 3\nEpisode 11\nEpisode 4'
      },
      'preset-shuffle': {
        options: { sortType: 'shuffle', caseSensitive: false, dedupe: false },
        sample: 'Participant 1: Alex Morgan\nParticipant 2: Brian Chen\nParticipant 3: Clara Silva\nParticipant 4: David Kim\nParticipant 5: Elena Rostova\nParticipant 6: Farhan Qureshi'
      },
      'preset-combo': {
        options: { sortType: 'az', caseSensitive: false, dedupe: true },
        sample: 'Python\nJavaScript\nTypeScript\nPython\nGo\nRust\nJavaScript\nC++\nGo\nRuby'
      }
    };

    function countWords(str) {
      if (!str || !str.trim()) return 0;
      return str.trim().split(/\s+/).length;
    }

    function countLines(str) {
      if (!str) return 0;
      return str.split(/\r?\n/).length;
    }

    // High-performance Text Sorter logic
    function sortLines(text) {
      if (!text) {
        return {
          result: '',
          linesCount: 0,
          dupesRemoved: 0
        };
      }

      let lines = text.split(/\r?\n/);
      const sortType = selectSortType ? selectSortType.value : 'az';
      const isCaseSensitive = optCaseSensitive ? optCaseSensitive.checked : false;
      const isDedupe = optDedupe ? optDedupe.checked : false;

      let dupesRemoved = 0;
      if (isDedupe) {
        const seen = new Set();
        const unique = [];
        for (let i = 0; i < lines.length; i++) {
          const line = lines[i];
          const key = isCaseSensitive ? line : line.toLowerCase();
          if (!seen.has(key)) {
            seen.add(key);
            unique.push(line);
          } else {
            dupesRemoved++;
          }
        }
        lines = unique;
      }

      // Execute sorting algorithm
      if (sortType === 'az') {
        lines.sort(function (a, b) {
          return a.localeCompare(b, undefined, {
            sensitivity: isCaseSensitive ? 'case' : 'base'
          });
        });
      } else if (sortType === 'za') {
        lines.sort(function (a, b) {
          return b.localeCompare(a, undefined, {
            sensitivity: isCaseSensitive ? 'case' : 'base'
          });
        });
      } else if (sortType === 'natural') {
        lines.sort(function (a, b) {
          return a.localeCompare(b, undefined, {
            numeric: true,
            sensitivity: isCaseSensitive ? 'case' : 'base'
          });
        });
      } else if (sortType === 'length-asc') {
        lines.sort(function (a, b) {
          if (a.length !== b.length) return a.length - b.length;
          return a.localeCompare(b, undefined, {
            sensitivity: isCaseSensitive ? 'case' : 'base'
          });
        });
      } else if (sortType === 'length-desc') {
        lines.sort(function (a, b) {
          if (a.length !== b.length) return b.length - a.length;
          return a.localeCompare(b, undefined, {
            sensitivity: isCaseSensitive ? 'case' : 'base'
          });
        });
      } else if (sortType === 'shuffle') {
        // Fisher-Yates unbiased shuffle
        for (let i = lines.length - 1; i > 0; i--) {
          const j = Math.floor(Math.random() * (i + 1));
          const temp = lines[i];
          lines[i] = lines[j];
          lines[j] = temp;
        }
      }

      const result = lines.join('\n');
      return {
        result: result,
        linesCount: lines.length,
        dupesRemoved: dupesRemoved
      };
    }

    function update() {
      const raw = inputText.value || '';
      const cleanResult = sortLines(raw);
      outputText.value = cleanResult.result;

      // Input Stats
      const inChars = raw.length;
      const inWords = countWords(raw);
      const inLines = raw ? countLines(raw) : 0;

      statInputChars.textContent = inChars.toLocaleString();
      statInputWords.textContent = inWords.toLocaleString();
      statInputLines.textContent = inLines.toLocaleString();

      // Output Stats
      const outChars = cleanResult.result.length;
      const outLines = cleanResult.result ? cleanResult.linesCount : 0;

      statOutputChars.textContent = outChars.toLocaleString();
      statOutputLines.textContent = outLines.toLocaleString();

      const dupes = cleanResult.dupesRemoved;
      statDupesRemoved.textContent = dupes.toLocaleString();

      const pct = inLines > 0 ? Math.max(0, Math.round((dupes / inLines) * 100)) : 0;
      statReductionPct.textContent = pct + '% duplicate reduction';

      // Status label description
      const sortType = selectSortType ? selectSortType.value : 'az';
      let modeText = 'Alphabetical (A-Z)';
      if (sortType === 'za') modeText = 'Reverse (Z-A)';
      if (sortType === 'natural') modeText = 'Natural Numeric';
      if (sortType === 'length-asc') modeText = 'Length (Shortest First)';
      if (sortType === 'length-desc') modeText = 'Length (Longest First)';
      if (sortType === 'shuffle') modeText = 'Randomized';

      if (dupes > 0) {
        statusSortMode.textContent = modeText + ' • ' + dupes + ' dupes removed';
      } else {
        statusSortMode.textContent = modeText;
      }
    }

    // Debounce helper for silky performance with large text
    let timeoutId;
    function debouncedUpdate() {
      clearTimeout(timeoutId);
      timeoutId = setTimeout(update, 50);
    }

    // Event Listeners
    inputText?.addEventListener('input', debouncedUpdate);
    selectSortType?.addEventListener('change', update);
    optCaseSensitive?.addEventListener('change', update);
    optDedupe?.addEventListener('change', update);
    btnSort?.addEventListener('click', update);

    // Sample Text
    btnSample?.addEventListener('click', function () {
      inputText.value =
        'Orange\nApple\nGrape\nBanana\nApple\nMango\nPineapple\nBanana\nWatermelon\nCherry';
      update();
    });

    // Clear
    btnClear?.addEventListener('click', function () {
      inputText.value = '';
      outputText.value = '';
      update();
      inputText.focus();
    });

    // Paste from Clipboard
    btnPaste?.addEventListener('click', async function () {
      try {
        if (navigator.clipboard && navigator.clipboard.readText) {
          const clipText = await navigator.clipboard.readText();
          if (clipText) {
            inputText.value = clipText;
            update();
          }
        } else {
          inputText.focus();
          inputText.select();
        }
      } catch (err) {
        inputText.focus();
      }
    });

    // Copy to Clipboard
    btnCopy?.addEventListener('click', async function () {
      const textToCopy = outputText.value;
      if (!textToCopy) return;

      try {
        if (navigator.clipboard && navigator.clipboard.writeText) {
          await navigator.clipboard.writeText(textToCopy);
        } else {
          outputText.select();
          document.execCommand('copy');
        }

        copyBtnText.textContent = 'Copied!';
        copyIconIdle.classList.add('hidden');
        copyIconSuccess.classList.remove('hidden');

        setTimeout(function () {
          copyBtnText.textContent = 'Copy Result';
          copyIconIdle.classList.remove('hidden');
          copyIconSuccess.classList.add('hidden');
        }, 2000);
      } catch (err) {
        outputText.select();
      }
    });

    // Download .txt file
    btnDownload?.addEventListener('click', function () {
      const content = outputText.value;
      if (!content) return;

      const blob = new Blob([content], { type: 'text/plain;charset=utf-8' });
      const url = URL.createObjectURL(blob);
      const a = document.createElement('a');
      a.href = url;
      a.download = 'sorted-list.txt';
      document.body.appendChild(a);
      a.click();
      document.body.removeChild(a);
      URL.revokeObjectURL(url);
    });

    // Preset Buttons
    presetButtons.forEach(function (btn) {
      btn.addEventListener('click', function () {
        const id = btn.getAttribute('data-preset');
        const data = presetMap[id];
        if (!data) return;

        if (selectSortType) {
          selectSortType.value = data.options.sortType;
        }

        if (optCaseSensitive) {
          optCaseSensitive.checked = data.options.caseSensitive;
        }

        if (optDedupe) {
          optDedupe.checked = data.options.dedupe;
        }

        if (data.sample) {
          inputText.value = data.sample;
        }

        update();

        // Scroll to editor
        const studio = document.getElementById('input-text');
        if (studio) {
          studio.scrollIntoView({ behavior: 'smooth', block: 'center' });
        }
      });
    });

    // Initial update on page load
    update();
  })();
</script>
